--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,122 @@
+#include <cuda_runtime.h>
+#include <stdint.h>
+
+// Element-wise negation: y = -x
+__global__ void neg_kernel(const float* __restrict__ x, float* __restrict__ out, int64_t numel) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        out[i] = -x[i];
+    }
+}
+
+// Adaptive average pooling 1D: average over windows defined by start=floor(i*T/O), end=ceil((i+1)*T/O)
+// Input: x of shape [B, C, T] with strides (stride_b, stride_c, stride_t)
+// Output: y of shape [B, C, O], contiguous
+template<int BLOCK_SIZE>
+__global__ void adaptive_avg_pool1d_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int64_t B, int64_t C, int64_t T, int64_t O,
+    int64_t stride_b, int64_t stride_c, int64_t stride_t)
+{
+    int64_t total_windows = B * C * O;
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t grid_stride = blockDim.x * gridDim.x;
+    for (int64_t window_idx = idx; window_idx < total_windows; window_idx += grid_stride) {
+        int64_t o = window_idx % O;
+        int64_t tmp = window_idx / O;
+        int64_t c = tmp % C;
+        int64_t b = tmp / C;
+        
+        int64_t start = (o * T) / O;
+        int64_t end = ((o + 1) * T + O - 1) / O; // ceil division
+        if (end > T) end = T;
+        if (start >= end) {
+            output[window_idx] = 0.0f;
+            continue;
+        }
+        
+        float sum = 0.0f;
+        const float* base = input + b * stride_b + c * stride_c;
+        for (int64_t t = start; t < end; ++t) {
+            sum += base[t * stride_t];
+        }
+        output[window_idx] = sum / (float)(end - start);
+    }
+}
+
+// addcmul with broadcasting: out[b,c,o] = bias[c] + t1[b,c,o] * t2[b,c,o]
+// t1 and t2 have shape [B, C, O] with strides (t1_stride_b, t1_stride_c, t1_stride_o) etc.
+// bias has length C, contiguous.
+__global__ void addcmul_tt_kernel(
+    const float* __restrict__ bias,
+    const float* __restrict__ t1,
+    const float* __restrict__ t2,
+    float* __restrict__ out,
+    int64_t B, int64_t C, int64_t O,
+    int64_t t1_stride_b, int64_t t1_stride_c, int64_t t1_stride_o,
+    int64_t t2_stride_b, int64_t t2_stride_c, int64_t t2_stride_o)
+{
+    int64_t total = B * C * O;
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < total; i += stride) {
+        int64_t o = i % O;
+        int64_t tmp = i / O;
+        int64_t c = tmp % C;
+        int64_t b = tmp / C;
+        int64_t t1_idx = b * t1_stride_b + c * t1_stride_c + o * t1_stride_o;
+        int64_t t2_idx = b * t2_stride_b + c * t2_stride_c + o * t2_stride_o;
+        out[i] = bias[c] + t1[t1_idx] * t2[t2_idx];
+    }
+}
+
+// Launcher functions (C linkage)
+
+extern "C" void custom_neg_launcher(
+    const float* x,
+    float* out,
+    int64_t numel,
+    cudaStream_t stream)
+{
+    const int block_size = 256;
+    int64_t blocks = (numel + block_size - 1) / block_size;
+    if (blocks > 65535) blocks = 65535; // cap grid; grid-stride loop handles rest
+    neg_kernel<<<blocks, block_size, 0, stream>>>(x, out, numel);
+}
+
+extern "C" void custom_adaptive_avg_pool1d_launcher(
+    const float* input,
+    float* output,
+    int64_t B, int64_t C, int64_t T, int64_t O,
+    int64_t stride_b, int64_t stride_c, int64_t stride_t,
+    cudaStream_t stream)
+{
+    const int block_size = 256;
+    int64_t total_windows = B * C * O;
+    int64_t blocks = (total_windows + block_size - 1) / block_size;
+    if (blocks > 65535) blocks = 65535;
+    adaptive_avg_pool1d_kernel<block_size><<<blocks, block_size, 0, stream>>>(
+        input, output, B, C, T, O, stride_b, stride_c, stride_t);
+}
+
+extern "C" void custom_addcmul_tt_launcher(
+    const float* bias,
+    const float* t1,
+    const float* t2,
+    float* out,
+    int64_t B, int64_t C, int64_t O,
+    int64_t t1_stride_b, int64_t t1_stride_c, int64_t t1_stride_o,
+    int64_t t2_stride_b, int64_t t2_stride_c, int64_t t2_stride_o,
+    cudaStream_t stream)
+{
+    const int block_size = 256;
+    int64_t total = B * C * O;
+    int64_t blocks = (total + block_size - 1) / block_size;
+    if (blocks > 65535) blocks = 65535;
+    addcmul_tt_kernel<<<blocks, block_size, 0, stream>>>(
+        bias, t1, t2, out, B, C, O,
+        t1_stride_b, t1_stride_c, t1_stride_o,
+        t2_stride_b, t2_stride_c, t2_stride_o);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,153 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void custom_neg_launcher(
+    const float* x,
+    float* out,
+    int64_t numel,
+    cudaStream_t stream);
+
+extern "C" void custom_adaptive_avg_pool1d_launcher(
+    const float* input,
+    float* output,
+    int64_t B, int64_t C, int64_t T, int64_t O,
+    int64_t stride_b, int64_t stride_c, int64_t stride_t,
+    cudaStream_t stream);
+
+extern "C" void custom_addcmul_tt_launcher(
+    const float* bias,
+    const float* t1,
+    const float* t2,
+    float* out,
+    int64_t B, int64_t C, int64_t O,
+    int64_t t1_stride_b, int64_t t1_stride_c, int64_t t1_stride_o,
+    int64_t t2_stride_b, int64_t t2_stride_c, int64_t t2_stride_o,
+    cudaStream_t stream);
+
+// ============ PyTorch wrappers ============
+
+torch::Tensor custom_neg(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "custom_neg: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "custom_neg: input must be float32");
+    TORCH_CHECK(x.dim() >= 1, "custom_neg: input must have at least one dimension");
+
+    auto out = torch::empty_like(x);
+    if (x.numel() == 0) {
+        return out;
+    }
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    custom_neg_launcher(
+        x.data_ptr<float>(),
+        out.data_ptr<float>(),
+        x.numel(),
+        stream
+    );
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "custom_neg: CUDA kernel launch failed: ", cudaGetErrorString(err));
+    return out;
+}
+
+torch::Tensor custom_adaptive_avg_pool1d(torch::Tensor x, int64_t output_size) {
+    TORCH_CHECK(x.is_cuda(), "custom_adaptive_avg_pool1d: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "custom_adaptive_avg_pool1d: input must be float32");
+    TORCH_CHECK(x.dim() == 3, "custom_adaptive_avg_pool1d: input must be 3D [B, C, T]");
+    TORCH_CHECK(output_size > 0, "custom_adaptive_avg_pool1d: output_size must be positive");
+
+    auto B = x.size(0);
+    auto C = x.size(1);
+    auto T = x.size(2);
+
+    auto out = torch::empty({B, C, output_size}, x.options());
+    if (out.numel() == 0) {
+        return out;
+    }
+
+    // Use strides of input (supports non-contiguous)
+    auto stride_b = x.stride(0);
+    auto stride_c = x.stride(1);
+    auto stride_t = x.stride(2);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    custom_adaptive_avg_pool1d_launcher(
+        x.data_ptr<float>(),
+        out.data_ptr<float>(),
+        B, C, T, output_size,
+        stride_b, stride_c, stride_t,
+        stream
+    );
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "custom_adaptive_avg_pool1d: CUDA kernel launch failed: ", cudaGetErrorString(err));
+    return out;
+}
+
+torch::Tensor custom_addcmul_tt(torch::Tensor bias, torch::Tensor t1, torch::Tensor t2) {
+    TORCH_CHECK(bias.is_cuda(), "custom_addcmul_tt: bias must be a CUDA tensor");
+    TORCH_CHECK(t1.is_cuda(), "custom_addcmul_tt: t1 must be a CUDA tensor");
+    TORCH_CHECK(t2.is_cuda(), "custom_addcmul_tt: t2 must be a CUDA tensor");
+    TORCH_CHECK(bias.dtype() == torch::kFloat32, "custom_addcmul_tt: bias must be float32");
+    TORCH_CHECK(t1.dtype() == torch::kFloat32, "custom_addcmul_tt: t1 must be float32");
+    TORCH_CHECK(t2.dtype() == torch::kFloat32, "custom_addcmul_tt: t2 must be float32");
+    TORCH_CHECK(t1.dim() == 3, "custom_addcmul_tt: t1 must be 3D [B, C, O]");
+    TORCH_CHECK(t2.dim() == 3, "custom_addcmul_tt: t2 must be 3D [B, C, O]");
+    TORCH_CHECK(t1.size(0) == t2.size(0) && t1.size(1) == t2.size(1) && t1.size(2) == t2.size(2),
+                "custom_addcmul_tt: t1 and t2 must have the same shape");
+    TORCH_CHECK(bias.numel() == t1.size(1), "custom_addcmul_tt: bias must have length equal to channels (dim 1)");
+
+    auto B = t1.size(0);
+    auto C = t1.size(1);
+    auto O = t1.size(2);
+
+    auto out = torch::empty_like(t1);
+    if (out.numel() == 0) {
+        return out;
+    }
+
+    // Bias must be contiguous (usually is, but ensure)
+    auto bias_contig = bias.contiguous();
+
+    // T1 and T2 can have arbitrary strides; pass them directly
+    auto t1_stride_b = t1.stride(0);
+    auto t1_stride_c = t1.stride(1);
+    auto t1_stride_o = t1.stride(2);
+    auto t2_stride_b = t2.stride(0);
+    auto t2_stride_c = t2.stride(1);
+    auto t2_stride_o = t2.stride(2);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    custom_addcmul_tt_launcher(
+        bias_contig.data_ptr<float>(),
+        t1.data_ptr<float>(),
+        t2.data_ptr<float>(),
+        out.data_ptr<float>(),
+        B, C, O,
+        t1_stride_b, t1_stride_c, t1_stride_o,
+        t2_stride_b, t2_stride_c, t2_stride_o,
+        stream
+    );
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "custom_addcmul_tt: CUDA kernel launch failed: ", cudaGetErrorString(err));
+    return out;
+}
+
+// ============ Registration ============
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_neg", &custom_neg, "Element-wise negation (CUDA)",
+          py::arg("x"));
+    m.def("custom_adaptive_avg_pool1d", &custom_adaptive_avg_pool1d,
+          "Adaptive average pooling 1D (CUDA)",
+          py::arg("x"), py::arg("output_size"));
+    m.def("custom_addcmul_tt", &custom_addcmul_tt,
+          "Addcmul with bias broadcasting over channels (CUDA)",
+          py::arg("bias"), py::arg("t1"), py::arg("t2"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,25 @@
+import torch
+import torch.nn as nn
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_features, out_features, bias_shape):
+        super().__init__()
+        self.pool = nn.AdaptiveAvgPool1d(out_features)
+        self.bias = nn.Parameter(torch.randn(bias_shape))
+
+    def forward(self, x):
+        x = torch.neg(x)
+        x = self.pool(x)
+        x = torch.addcmul(self.bias, x, x)
+        return x
+
+    def debug_forward(self, x):
+        x = torch.neg(x)
+        yield 'step_001', x
+        x = self.pool(x)
+        yield 'step_002', x
+        x = torch.addcmul(self.bias, x, x)
+        yield 'step_003', x
+        yield 'step_004', x
+        return x
