+// Bindings for LSTM, Linear, and Exp custom ops
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cublas_v2.h>
+#include <cudnn.h>
+#include <vector>
+#include "../binding_registry.h"
+
+// Declare launcher from custom_ops.cu
+extern "C" void exp_forward_launcher(const float* input, float* output, int n, cudaStream_t stream);
+
+#define CHECK_CUDA_TENSOR(t) \
+    TORCH_CHECK((t).is_cuda(), #t " must be a CUDA tensor"); \
+    TORCH_CHECK((t).is_contiguous(), #t " must be contiguous"); \
+    TORCH_CHECK((t).dtype() == torch::kFloat32, #t " must be float32")
+
+static cublasHandle_t get_cublas_handle() {
+    static cublasHandle_t handle = nullptr;
+    if (!handle) {
+        cublasCreate(&handle);
+    }
+    return handle;
+}
+
+static cudnnHandle_t get_cudnn_handle() {
+    static cudnnHandle_t handle = nullptr;
+    if (!handle) {
+        cudnnCreate(&handle);
+    }
+    return handle;
+}
+
+// LSTM forward using cuDNN
+// input: (seq_len, batch, input_size)
+// weights: each layer has weight_ih (4*hidden, input_size or hidden) and weight_hh (4*hidden, hidden)
+// biases: each layer has bias_ih and bias_hh, both size 4*hidden
+// returns output: (seq_len, batch, hidden_size)
+torch::Tensor lstm_forward(
+    torch::Tensor input,
+    torch::Tensor weight_ih_l0,
+    torch::Tensor weight_hh_l0,
+    torch::Tensor bias_ih_l0,
+    torch::Tensor bias_hh_l0,
+    torch::Tensor weight_ih_l1,
+    torch::Tensor weight_hh_l1,
+    torch::Tensor bias_ih_l1,
+    torch::Tensor bias_hh_l1,
+    int64_t seq_len,
+    int64_t batch_size,
+    int64_t input_size,
+    int64_t hidden_size,
+    int64_t num_layers
+) {
+    CHECK_CUDA_TENSOR(input);
+    CHECK_CUDA_TENSOR(weight_ih_l0);
+    CHECK_CUDA_TENSOR(weight_hh_l0);
+    CHECK_CUDA_TENSOR(bias_ih_l0);
+    CHECK_CUDA_TENSOR(bias_hh_l0);
+    CHECK_CUDA_TENSOR(weight_ih_l1);
+    CHECK_CUDA_TENSOR(weight_hh_l1);
+    CHECK_CUDA_TENSOR(bias_ih_l1);
+    CHECK_CUDA_TENSOR(bias_hh_l1);
+
+    TORCH_CHECK(seq_len > 0 && batch_size > 0 && input_size > 0 && hidden_size > 0 && num_layers == 2,
+                "Only two-layer LSTM supported");
+
+    cudnnHandle_t cudnn = get_cudnn_handle();
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    cudnnSetStream(cudnn, stream);
+
+    cudnnRNNDescriptor_t rnn_desc;
+    cudnnCreateRNNDescriptor(&rnn_desc);
+    cudnnSetRNNDescriptor_v8(rnn_desc,
+                             CUDNN_RNN_ALGO_STANDARD,
+                             CUDNN_RNN_RELU,  // PyTorch LSTM uses tanh activations by default? Actually LSTM uses tanh for cell and sigmoid for gates. cuDNN requires activation mode; we'll set below.
+                             CUDNN_RNN_RELU,
+                             CUDNN_UNIDIRECTIONAL,
+                             CUDNN_LINEAR_INPUT,
+                             CUDNN_DATA_FLOAT,
+                             CUDNN_DATA_FLOAT,
+                             CUDNN_DEFAULT_MATH,
+                             (int)input_size,
+                             (int)hidden_size,
+                             (int)hidden_size, // proj_size for LSTM should be hidden_size, but no projection so may be 0? Actually for LSTM proj_size can be 0 or hidden_size. Let's use 0.
+                             (int)num_layers,
+                             nullptr,
+                             CUDNN_RNN_PADDED_IO_DISABLED);
+
+    // Need to set matrix math type and bias mode
+    cudnnSetRNNMatrixMathType(rnn_desc, CUDNN_DEFAULT_MATH);
+    cudnnSetRNNBiasMode(rnn_desc, CUDNN_RNN_DOUBLE_BIAS); // PyTorch uses double bias (ih + hh)
+
+    // Allocate weight space
+    size_t weight_size;
+    cudnnGetRNNWeightSpaceSize(cudnn, rnn_desc, &weight_size);
+    void* d_wspace;
+    cudaMalloc(&d_wspace, weight_size);
+
+    // Prepare weight pointers in cuDNN order: for each layer, weight_ih, weight_hh, bias_ih, bias_hh (but cuDNN expects contiguous block with specific layout)
+    // We need to copy weights into a contiguous buffer in cuDNN's expected layout.
+    // According to cuDNN, for each layer: W_ih (4*hidden, input), W_hh (4*hidden, hidden), b_ih (4*hidden), b_hh (4*hidden)
+    // But cuDNN expects them as separate pointers? Actually cudnnRNNForwardTraining takes a weight space pointer.
+    // We need to populate the weight space using cudnnGetRNNWeightParams.
+    // For simplicity, we'll set the params using cudnnSetRNNWeightParams with appropriate matrix descriptors.
+    // However, this is complex. Alternative: use cudnnRNNForwardInference with weight space but need to fill.
+    // We'll compute weight space layout manually or use cudnnGetRNNWeightParams to get pointers and copy data.
+
+    // Create tensor descriptors for weight params
+    cudnnTensorDescriptor_t x_desc, y_desc;
+    cudnnCreateTensorDescriptor(&x_desc);
+    cudnnCreateTensorDescriptor(&y_desc);
+    // For RNN, x shape: [seq_len, batch, input_size], y shape: [seq_len, batch, hidden_size * num_directions]
+    int dimsX[3] = {(int)seq_len, (int)batch_size, (int)input_size};
+    int stridesX[3] = {batch_size * input_size, input_size, 1};
+    cudnnSetTensorNdDescriptor(x_desc, CUDNN_DATA_FLOAT, 3, dimsX, stridesX);
+    int dimsY[3] = {(int)seq_len, (int)batch_size, (int)hidden_size};
+    int stridesY[3] = {batch_size * hidden_size, hidden_size, 1};
+    cudnnSetTensorNdDescriptor(y_desc, CUDNN_DATA_FLOAT, 3, dimsY, stridesY);
+
+    // For weight space, we need to fill per-layer weights. We'll use cudnnGetRNNWeightParams to get pointers into wspace.
+    // cudnnGetRNNWeightParams(cudnn, rnn_desc, layer, weightSpaceSize, weightSpace, linLayerID, desc, addr, ...)
+    // We'll create descriptors for input and hidden weight matrices.
+    cudnnFilterDescriptor_t w_desc_ih, w_desc_hh;
+    cudnnCreateFilterDescriptor(&w_desc_ih);
+    cudnnCreateFilterDescriptor(&w_desc_hh);
+    // For linear input, weight_ih shape: [4*hidden, input_size], weight matrix dims [4*hidden, input_size]
+    cudnnSetFilterNdDescriptor(w_desc_ih, CUDNN_DATA_FLOAT, CUDNN_TENSOR_NCHW, 2, (int[]){4*(int)hidden_size, (int)input_size});
+    cudnnSetFilterNdDescriptor(w_desc_hh, CUDNN_DATA_FLOAT, CUDNN_TENSOR_NCHW, 2, (int[]){4*(int)hidden_size, (int)hidden_size});
+
+    // Bias descriptors are just tensors of shape [4*hidden]
+    cudnnTensorDescriptor_t b_desc;
+    cudnnCreateTensorDescriptor(&b_desc);
+    cudnnSetTensor4dDescriptor(b_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT, 4*(int)hidden_size, 1, 1, 1);
+
+    // Get pointers to weight space areas for each layer's ih and hh matrices, then copy data
+    for (int layer = 0; layer < num_layers; ++layer) {
+        // weight_ih
+        void* ptr_ih = nullptr;
+        cudnnGetRNNWeightParams(cudnn, rnn_desc, layer, weight_size, d_wspace,
+                                0, w_desc_ih, &ptr_ih, nullptr);
+        // copy weight_ih_l{layer} into ptr_ih
+        cudaMemcpyAsync(ptr_ih, (layer == 0 ? weight_ih_l0.data_ptr<float>() : weight_ih_l1.data_ptr<float>()),
+                        weight_ih_l0.numel() * sizeof(float), cudaMemcpyDeviceToDevice, stream);
+        // weight_hh
+        void* ptr_hh = nullptr;
+        cudnnGetRNNWeightParams(cudnn, rnn_desc, layer, weight_size, d_wspace,
+                                1, w_desc_hh, &ptr_hh, nullptr);
+        cudaMemcpyAsync(ptr_hh, (layer == 0 ? weight_hh_l0.data_ptr<float>() : weight_hh_l1.data_ptr<float>()),
+                        weight_hh_l0.numel() * sizeof(float), cudaMemcpyDeviceToDevice, stream);
+        // bias_ih
+        void* ptr_bih = nullptr;
+        cudnnGetRNNWeightParams(cudnn, rnn_desc, layer, weight_size, d_wspace,
+                                2, b_desc, &ptr_bih, nullptr);
+        cudaMemcpyAsync(ptr_bih, (layer == 0 ? bias_ih_l0.data_ptr<float>() : bias_ih_l1.data_ptr<float>()),
+                        bias_ih_l0.numel() * sizeof(float), cudaMemcpyDeviceToDevice, stream);
+        // bias_hh
+        void* ptr_bhh = nullptr;
+        cudnnGetRNNWeightParams(cudnn, rnn_desc, layer, weight_size, d_wspace,
+                                3, b_desc, &ptr_bhh, nullptr);
+        cudaMemcpyAsync(ptr_bhh, (layer == 0 ? bias_hh_l0.data_ptr<float>() : bias_hh_l1.data_ptr<float>()),
+                        bias_hh_l0.numel() * sizeof(float), cudaMemcpyDeviceToDevice, stream);
+    }
+
+    // Allocate output, hidden state, cell state
+    auto output = torch::empty({seq_len, batch_size, hidden_size}, input.options());
+    auto hx = torch::zeros({num_layers, batch_size, hidden_size}, input.options());
+    auto cx = torch::zeros({num_layers, batch_size, hidden_size}, input.options());
+    void* d_output = output.data_ptr<float>();
+    void* d_hx = hx.data_ptr<float>();
+    void* d_cx = cx.data_ptr<float>();
+
+    // Allocate workspace
+    size_t work_size;
+    cudnnGetRNNTempSpaceSizes(cudnn, rnn_desc, CUDNN_RNN_FWD_MODE_INFERENCE, nullptr, &work_size, nullptr);
+    void* d_workspace;
+    cudaMalloc(&d_workspace, work_size);
+
+    // Perform RNN forward inference (no training mode needed)
+    cudnnRNNForwardInference(cudnn,
+                             rnn_desc,
+                             CUDNN_RNN_FWD_MODE_INFERENCE,
+                             nullptr, // devSeqLengths (null for non-padded)
+                             x_desc,
+                             input.data_ptr<float>(),
+                             y_desc,
+                             d_output,
+                             nullptr, // hx descriptor (not needed if we pass null? Actually must pass)
+                             d_hx,
+                             nullptr, // hy descriptor
+                             nullptr, // hy
+                             nullptr, // cx descriptor
+                             d_cx,
+                             nullptr, // cy descriptor
+                             nullptr, // cy
+                             d_wspace,
+                             weight_size,
+                             d_workspace,
+                             work_size,
+                             nullptr, 0); // reserved
+
+    cudaError_t cuda_err = cudaGetLastError();
+    TORCH_CHECK(cuda_err == cudaSuccess, "CUDA error in lstm_forward: ", cudaGetErrorString(cuda_err));
+
+    // Cleanup
+    cudnnDestroyTensorDescriptor(x_desc);
+    cudnnDestroyTensorDescriptor(y_desc);
+    cudnnDestroyFilterDescriptor(w_desc_ih);
+    cudnnDestroyFilterDescriptor(w_desc_hh);
+    cudnnDestroyTensorDescriptor(b_desc);
+    cudnnDestroyRNNDescriptor(rnn_desc);
+    cudaFree(d_wspace);
+    cudaFree(d_workspace);
+
+    return output;
+}
+
+// Linear forward using cuBLAS: y = x @ weight^T + bias
+// input: (batch, hidden_size)
+// weight: (out_features, hidden_size)
+// bias: (out_features,)
+// returns output: (batch, out_features)
+torch::Tensor linear_forward(
+    torch::Tensor input,
+    torch::Tensor weight,
+    torch::Tensor bias,
+    int64_t out_features
+) {
+    CHECK_CUDA_TENSOR(input);
+    CHECK_CUDA_TENSOR(weight);
+    CHECK_CUDA_TENSOR(bias);
+
+    int64_t batch = input.size(0);
+    int64_t in_features = input.size(1);
+    TORCH_CHECK(weight.size(0) == out_features, "weight shape mismatch");
+    TORCH_CHECK(weight.size(1) == in_features, "weight shape mismatch");
+    TORCH_CHECK(bias.size(0) == out_features, "bias size mismatch");
+
+    cublasHandle_t handle = get_cublas_handle();
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    cublasSetStream(handle, stream);
+
+    auto output = torch::empty({batch, out_features}, input.options());
+
+    const float alpha = 1.0f;
+    const float beta = 0.0f;
+    // cuBLAS uses column-major, so we compute output^T = weight * input^T + bias^T
+    // Equivalent: output (batch, out) = input (batch, in) * weight^T (in, out)
+    // We'll use cublasSgemm with transa=CUBLAS_OP_N, transb=CUBLAS_OP_N,
+    // lda=in_features, ldb=out_features, ldc=out_features, and dimensions:
+    // m = out_features, n = batch, k = in_features
+    // A = weight (out, in), B = input^T (in, batch), C = output^T (out, batch)
+    // But we don't have transposed input. Instead use cublasSgemm with transb=CUBLAS_OP_T on weight:
+    // We want output (batch, out) = input (batch, in) * weight^T (in, out)
+    // In column-major, this is C^T (out, batch) = weight (out, in) * input^T (in, batch)
+    // So m = out_features, n = batch, k = in_features, A = weight (out, in), B = input^T (in, batch), C = output^T (out, batch)
+    // We can achieve this by cublasSgemm with transa=CUBLAS_OP_N, transb=CUBLAS_OP_T,
+    // where A = weight (out, in), B = input (batch, in) -> we'll use B as input with transa? Let's be careful.
+    // Actually we can do: C = alpha * A * B + beta * C, where A is weight (out, in), B is input^T (in, batch).
+    // We don't have input^T, but we can compute using cublasSgemm with transb=CUBLAS_OP_T on input:
+    // cublasSgemm(handle, CUBLAS_OP_N, CUBLAS_OP_T, out_features, batch, in_features,
+    //             &alpha, weight, out_features, input, in_features, &beta, output.data_ptr<float>(), out_features);
+    // This works because cublas assumes column-major, so weight is (out, in) in column-major means row-major (out, in) as stored? Actually weight is row-major contiguous as PyTorch (out, in). In column-major interpretation, it's (in, out). For cublas, we pass lda = out_features if we treat weight as a column-major (in, out) with leading dim out_features? Need to get this right.
+    // Let's simply use cublasSgemm with transa=CUBLAS_OP_T on weight and transb=CUBLAS_OP_N on input:
+    // C = input (batch, in) * weight^T (in, out) = input * weight^T
+    // In column-major: C (out, batch) = weight (out, in) * input^T (in, batch)
+    // If we call cublasSgemm(handle, CUBLAS_OP_N, CUBLAS_OP_T, out_features, batch, in_features,
+    //                      &alpha, weight, out_features, input, in_features, &beta, output, out_features),
+    // Then A = weight (out, in) column-major? Actually weight stored row-major (out, in), so in column-major it's A with dimensions (in, out), leading dimension out_features. That would be A^T? We need to align.
+    // A simpler approach: use cublasSgemm with CUBLAS_OP_T for weight and CUBLAS_OP_N for input, with dimensions m=batch, n=out_features, k=in_features, A=input (batch, in), B=weight (out, in), B^T is (in, out). But cublas expects column-major, so we might need to transpose manually.
+    // A robust way: allocate transposed copies? For simplicity, we can use cublasSgemm with CUBLAS_OP_T and CUBLAS_OP_N and pass appropriate ldas.
+    // Let's write:
+    // We want output (batch, out) = input (batch, in) * weight^T (in, out)
+    // In column-major, this is output^T (out, batch) = weight (out, in) * input^T (in, batch).
+    // So cublasSgemm(handle, CUBLAS_OP_N, CUBLAS_OP_T, out_features, batch, in_features,
+    //                &alpha, weight.data_ptr<float>(), out_features,
+    //                input.data_ptr<float>(), in_features,
+    //                &beta, output.data_ptr<float>(), out_features);
+    // This computes: C (out, batch) = A (out, in) * B^T (in, batch).
+    // A = weight, stored row-major (out, in). In column-major, A has dimensions (in, out) with lda=out_features, but cublas will interpret A as (out, in) column-major if we set transa=CUBLAS_OP_N and lda=out_features? Actually column-major A with dimensions m x k = out x in has lda = out_features, and elements stored column-wise: a[j*lda + i]. Our weight is stored row-major: weight[i*in + j] = A_col_major[j*out + i]? This is a transpose. So if we pass weight as A with transa=CUBLAS_OP_N, it will be interpreted as column-major (out, in) which is actually the transpose of our row-major weight. So we need transa=CUBLAS_OP_T to get correct? Let's test with simple math: For row-major weight W (out, in), we can compute C = input * W^T by treating W as column-major with dimensions (in, out) and leading dimension out_features, and using transb=CUBLAS_OP_N? This is confusing.
+    // Let's use the reliable approach: use cublasSgemm with CUBLAS_OP_N and CUBLAS_OP_T, but ensure dimensions match by using appropriate leading dimensions.
+    // We'll set: transa = CUBLAS_OP_N, transb = CUBLAS_OP_T, m = out_features, n = batch, k = in_features,
+    // lda = out_features (since A is out x in), ldb = in_features (since B is batch x in, and B^T is in x batch), ldc = out_features.
