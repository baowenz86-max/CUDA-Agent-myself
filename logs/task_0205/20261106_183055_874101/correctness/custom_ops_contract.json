{
  "operators": [
    {
      "name": "aap1d_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, input_size, seq_length]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "output_size",
          "kind": "int",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, input_size, output_size]"
      },
      "semantics": [
        "Computes adaptive average pooling over the last dimension, reducing from input length to output_size.",
        "For output index i, it averages input positions floor(i*L/O) to ceil((i+1)*L/O) inclusive.",
        "Equivalent to torch.nn.functional.adaptive_avg_pool1d(input, output_size).",
        "Preserves batch and channel dimensions."
      ]
    },
    {
      "name": "masked_select_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[...]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "mask",
          "kind": "tensor",
          "dtype": "torch.bool",
          "device": "cuda",
          "shape": "scalar",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[num_selected]"
      },
      "semantics": [
        "Flattens input in row-major order and selects elements where mask is true.",
        "Mask is a scalar; if true, all elements are selected, yielding a 1D tensor of size input.numel().",
        "If mask is false, output is empty tensor shape [0].",
        "Output order is identical to flattening input and indexing by true positions."
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.avg_pool(x)",
      "semantics": [
        "Applies AdaptiveAvgPool1d with output_size=50 to input x of shape [64, 512, 10240].",
        "Result shape [64, 512, 50], dtype float32, cuda."
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "mask = torch.tensor(self.mask_value, dtype=torch.bool, device=x.device)",
      "semantics": [
        "Creates a 0-dimensional boolean tensor with value bool(self.mask_value).",
        "mask_value=0.5 converted to bool True.",
        "Device is same as x (cuda)."
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return torch.masked_select(x, mask)",
      "semantics": [
        "Selects elements from x where mask is True. Since mask is scalar True, selects all elements and flattens.",
        "Output shape [64*512*50] = [1638400], dtype float32, cuda."
      ]
    }
  ]
}