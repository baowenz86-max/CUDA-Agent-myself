--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,73 @@
+#include <cuda_runtime.h>
+#include <cmath>
+
+// GELU activation (exact erf-based, matching PyTorch F.gelu default)
+__global__ void gelu_kernel(const float* __restrict__ input,
+                            float* __restrict__ output,
+                            long long numel,
+                            int dim0, int dim1, int dim2,
+                            long long stride0, long long stride1, long long stride2) {
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    const float inv_sqrt2 = 0.70710678118654752440f;
+    for (; idx < numel; idx += stride) {
+        long long i0 = idx / ((long long)dim1 * dim2);
+        long long rem = idx - i0 * ((long long)dim1 * dim2);
+        long long i1 = rem / dim2;
+        long long i2 = rem - i1 * dim2;
+        long long offset = i0 * stride0 + i1 * stride1 + i2 * stride2;
+        float x = input[offset];
+        float y = 0.5f * x * (1.0f + erff(x * inv_sqrt2));
+        output[offset] = y;
+    }
+}
+
+// Tanh activation
+template <int BLOCK_SIZE>
+__global__ void tanh_kernel(const float* __restrict__ input,
+                            float* __restrict__ output,
+                            long long numel,
+                            int dim0, int dim1, int dim2,
+                            long long stride0, long long stride1, long long stride2) {
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (; idx < numel; idx += stride) {
+        long long i0 = idx / ((long long)dim1 * dim2);
+        long long rem = idx - i0 * ((long long)dim1 * dim2);
+        long long i1 = rem / dim2;
+        long long i2 = rem - i1 * dim2;
+        long long offset = i0 * stride0 + i1 * stride1 + i2 * stride2;
+        float x = input[offset];
+        output[offset] = tanhf(x);
+    }
+}
+
+// Launcher: GELU
+extern "C" void gelu_forward_launcher(const float* input,
+                                     float* output,
+                                     long long numel,
+                                     int dim0, int dim1, int dim2,
+                                     long long stride0, long long stride1, long long stride2,
+                                     cudaStream_t stream) {
+    const int block_size = 256;
+    // Calculate grid size: number of blocks needed to cover numel with one element per thread initially
+    long long needed = (numel + block_size - 1) / block_size;
+    // Cap grid to max grid size (avoid exceeding 2^31-1)
+    int max_blocks = 2147483647;
+    int grid = (int)min(needed, (long long)max_blocks);
+    gelu_kernel<<<grid, block_size, 0, stream>>>(input, output, numel, dim0, dim1, dim2, stride0, stride1, stride2);
+}
+
+// Launcher: Tanh
+extern "C" void tanh_forward_launcher(const float* input,
+                                     float* output,
+                                     long long numel,
+                                     int dim0, int dim1, int dim2,
+                                     long long stride0, long long stride1, long long stride2,
+                                     cudaStream_t stream) {
+    const int block_size = 256;
+    long long needed = (numel + block_size - 1) / block_size;
+    int max_blocks = 2147483647;
+    int grid = (int)min(needed, (long long)max_blocks);
+    tanh_kernel<256><<<grid, block_size, 0, stream>>>(input, output, numel, dim0, dim1, dim2, stride0, stride1, stride2);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,89 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void gelu_forward_launcher(const float* input,
+                                     float* output,
+                                     long long numel,
+                                     int dim0, int dim1, int dim2,
+                                     long long stride0, long long stride1, long long stride2,
+                                     cudaStream_t stream);
+
+extern "C" void tanh_forward_launcher(const float* input,
+                                      float* output,
+                                      long long numel,
+                                      int dim0, int dim1, int dim2,
+                                      long long stride0, long long stride1, long long stride2,
+                                      cudaStream_t stream);
+
+torch::Tensor gelu_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "gelu_forward: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "gelu_forward: input must be float32");
+    TORCH_CHECK(x.dim() == 3, "gelu_forward: input must be 3D");
+
+    // Ensure contiguous for simplicity while the launcher supports arbitrary strides
+    auto x_contig = x.contiguous();
+    auto output = torch::empty_like(x_contig);
+
+    int dim0 = x_contig.size(0);
+    int dim1 = x_contig.size(1);
+    int dim2 = x_contig.size(2);
+    long long stride0 = x_contig.stride(0);
+    long long stride1 = x_contig.stride(1);
+    long long stride2 = x_contig.stride(2);
+    long long numel = x_contig.numel();
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    gelu_forward_launcher(
+        x_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        numel,
+        dim0, dim1, dim2,
+        stride0, stride1, stride2,
+        stream
+    );
+
+    return output;
+}
+
+torch::Tensor tanh_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "tanh_forward: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "tanh_forward: input must be float32");
+    TORCH_CHECK(x.dim() == 3, "tanh_forward: input must be 3D");
+
+    // Ensure contiguous for simplicity while the launcher supports arbitrary strides
+    auto x_contig = x.contiguous();
+    auto output = torch::empty_like(x_contig);
+
+    int dim0 = x_contig.size(0);
+    int dim1 = x_contig.size(1);
+    int dim2 = x_contig.size(2);
+    long long stride0 = x_contig.stride(0);
+    long long stride1 = x_contig.stride(1);
+    long long stride2 = x_contig.stride(2);
+    long long numel = x_contig.numel();
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    tanh_forward_launcher(
+        x_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        numel,
+        dim0, dim1, dim2,
+        stride0, stride1, stride2,
+        stream
+    );
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("gelu_forward", &gelu_forward, "Exact GELU activation (erf-based)",
+          pybind11::arg("x"));
+    m.def("tanh_forward", &tanh_forward, "Hyperbolic tangent activation",
+          pybind11::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,20 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x):
+        x = cuda_extension.gelu_forward(x)
+        x = cuda_extension.tanh_forward(x)
+        return x
+
+    def debug_forward(self, x):
+        gelu_out = cuda_extension.gelu_forward(x)
+        yield 'step_001', gelu_out
+        tanh_out = cuda_extension.tanh_forward(gelu_out)
+        yield 'step_002', tanh_out
+        yield 'step_003', tanh_out
