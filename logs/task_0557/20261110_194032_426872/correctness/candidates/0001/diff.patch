--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,29 @@
+#include <cuda_runtime.h>
+#include <math.h>
+
+// Elementwise Mish activation: y = x * tanh(softplus(x))
+// softplus(x) = log(1 + exp(x)), computed stably as log1p(exp(-abs(x))) + max(x,0)
+__global__ void mish_kernel(const float* __restrict__ input,
+                            float* __restrict__ output,
+                            int64_t numel) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        float x = input[i];
+        float sp = (x >= 0.0f) ? x + log1pf(expf(-x)) : log1pf(expf(x));
+        output[i] = x * tanhf(sp);
+    }
+}
+
+// C-interface launcher for mish_forward. Assumes input and output are contiguous float32 CUDA tensors with same numel.
+extern "C" void mish_forward_launcher(const float* input,
+                                      float* output,
+                                      int64_t numel,
+                                      cudaStream_t stream) {
+    if (numel <= 0) return;
+    int threads = 256;
+    int blocks = (int)((numel + threads - 1) / threads);
+    // Grid cap (2^31-1) is far above needed for this size, but keep grid-stride loop anyway for safety.
+    if (blocks > 2147483647) blocks = 2147483647;
+    mish_kernel<<<blocks, threads, 0, stream>>>(input, output, numel);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,48 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launcher from custom_ops.cu
+extern "C" void mish_forward_launcher(
+    const float* input,
+    float* output,
+    int64_t numel,
+    cudaStream_t stream
+);
+
+// PyTorch tensor wrapper
+torch::Tensor mish_forward(torch::Tensor x) {
+    // Input validation
+    TORCH_CHECK(x.is_cuda(), "Input tensor must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input tensor must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input tensor must be contiguous");
+
+    // Allocate output with same shape/device/dtype
+    auto output = torch::empty_like(x);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    mish_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        x.numel(),
+        stream
+    );
+
+    return output;
+}
+
+// Registration function
+void register_mish_forward(pybind11::module& m) {
+    m.def("mish_forward", &mish_forward,
+          "Mish activation forward",
+          py::arg("x"));
+}
+
+// Auto-register
+REGISTER_BINDING(mish_forward, register_mish_forward);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,15 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return cuda_extension.mish_forward(x)
+
+    def debug_forward(self, x: torch.Tensor):
+        y = cuda_extension.mish_forward(x)
+        yield 'step_001', y
