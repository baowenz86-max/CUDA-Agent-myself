--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,103 @@
+// custom_ops.cu - CUDA kernels and launchers for the custom extension.
+// This file contains only raw CUDA kernels and C-linkage launchers.
+// No PyTorch/ATen/c10 headers or Tensor wrappers.
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// Constant padding kernel for a 4D tensor (N,C,H,W) to (N,C,H_pad,W_pad).
+// Input may have arbitrary strides; output is assumed contiguous (row-major).
+// Each thread handles one output (oh, ow) position for a given (n, c).
+// Grid-stride loop covers all H_pad*W_pad output elements per plane.
+__global__ void constant_pad4d_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int64_t N,
+    int64_t C,
+    int64_t H_in,
+    int64_t W_in,
+    int64_t H_out,
+    int64_t W_out,
+    int64_t pad_left,
+    int64_t pad_top,
+    int64_t in_stride_n,
+    int64_t in_stride_c,
+    int64_t in_stride_h,
+    int64_t in_stride_w,
+    float fill_value,
+    int64_t total_hw_out)
+{
+    // Total output height*width per (n,c) plane.
+    // Use 64-bit indexing to avoid overflow for large tensors.
+    for (int64_t linear_idx = blockIdx.x * blockDim.x + threadIdx.x;
+         linear_idx < total_hw_out;
+         linear_idx += (int64_t)gridDim.x * blockDim.x)
+    {
+        int64_t oh = linear_idx / W_out;
+        int64_t ow = linear_idx % W_out;
+
+        int64_t ih = oh - pad_top;
+        int64_t iw = ow - pad_left;
+
+        float val = fill_value;
+        if (ih >= 0 && ih < H_in && iw >= 0 && iw < W_in) {
+            int64_t n = blockIdx.y / C;
+            int64_t c = blockIdx.y - n * C;
+            int64_t src_idx = n * in_stride_n + c * in_stride_c + ih * in_stride_h + iw * in_stride_w;
+            val = input[src_idx];
+        }
+
+        int64_t n = blockIdx.y / C;
+        int64_t c = blockIdx.y - n * C;
+        int64_t out_idx = ((n * C + c) * H_out + oh) * W_out + ow;
+        output[out_idx] = val;
+    }
+}
+
+extern "C" void custom_pad3d_launcher(
+    const float* input,
+    float* output,
+    int64_t N,
+    int64_t C,
+    int64_t H_in,
+    int64_t W_in,
+    int64_t H_out,
+    int64_t W_out,
+    int64_t pad_left,
+    int64_t pad_right,
+    int64_t pad_top,
+    int64_t pad_bottom,
+    double value,
+    int64_t in_stride_n,
+    int64_t in_stride_c,
+    int64_t in_stride_h,
+    int64_t in_stride_w,
+    cudaStream_t stream)
+{
+    // Launch configuration: each block handles a block of output hw positions,
+    // grid.y = N*C to cover all planes, grid.x covers H_out*W_out chunks.
+    const int block_size = 256;
+    int64_t total_hw_out = H_out * W_out;
+    int64_t grid_x = (total_hw_out + block_size - 1) / block_size;
+    // Cap grid_x to reasonable maximum (e.g., 2^31-1) while using grid-stride loop.
+    if (grid_x > 2147483647LL) grid_x = 2147483647LL;
+    dim3 grid((unsigned int)grid_x, (unsigned int)(N * C));
+    dim3 block(block_size);
+
+    constant_pad4d_kernel<<<grid, block, 0, stream>>>(
+        input,
+        output,
+        N,
+        C,
+        H_in,
+        W_in,
+        H_out,
+        W_out,
+        pad_left,
+        pad_top,
+        in_stride_n,
+        in_stride_c,
+        in_stride_h,
+        in_stride_w,
+        (float)value,
+        total_hw_out);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,96 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declaration from custom_ops.cu
+extern "C" void custom_pad3d_launcher(
+    const float* input,
+    float* output,
+    int64_t N,
+    int64_t C,
+    int64_t H_in,
+    int64_t W_in,
+    int64_t H_out,
+    int64_t W_out,
+    int64_t pad_left,
+    int64_t pad_right,
+    int64_t pad_top,
+    int64_t pad_bottom,
+    double value,
+    int64_t in_stride_n,
+    int64_t in_stride_c,
+    int64_t in_stride_h,
+    int64_t in_stride_w,
+    cudaStream_t stream);
+
+static torch::Tensor custom_pad3d(
+    torch::Tensor x,
+    int64_t pad_left,
+    int64_t pad_right,
+    int64_t pad_top,
+    int64_t pad_bottom,
+    double value) {
+    // Basic checks
+    TORCH_CHECK(x.is_cuda(), "Input tensor must be on CUDA");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input tensor must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input tensor must be 4D (N,C,H,W)");
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H_in = x.size(2);
+    int64_t W_in = x.size(3);
+
+    int64_t H_out = H_in + pad_top + pad_bottom;
+    int64_t W_out = W_in + pad_left + pad_right;
+
+    // Output contiguous tensor, same dtype and device as input.
+    auto output = torch::empty({N, C, H_out, W_out}, x.options());
+
+    // Get current CUDA stream.
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Strides for input (in elements).
+    int64_t in_stride_n = x.stride(0);
+    int64_t in_stride_c = x.stride(1);
+    int64_t in_stride_h = x.stride(2);
+    int64_t in_stride_w = x.stride(3);
+
+    custom_pad3d_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N,
+        C,
+        H_in,
+        W_in,
+        H_out,
+        W_out,
+        pad_left,
+        pad_right,
+        pad_top,
+        pad_bottom,
+        value,
+        in_stride_n,
+        in_stride_c,
+        in_stride_h,
+        in_stride_w,
+        stream);
+
+    return output;
+}
+
+void register_custom_pad3d(pybind11::module& m) {
+    m.def(
+        "custom_pad3d",
+        &custom_pad3d,
+        "Constant padding for 4D tensor",
+        py::arg("x"),
+        py::arg("pad_left"),
+        py::arg("pad_right"),
+        py::arg("pad_top"),
+        py::arg("pad_bottom"),
+        py::arg("value"));
+}
+
+REGISTER_BINDING(custom_pad3d, register_custom_pad3d);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,34 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, start_range, end_range, pad_dims, pad_width, pad_mode, pad_value):
+        super(ModelNew, self).__init__()
+        self.pad_width = pad_width
+        self.pad_mode = pad_mode
+        self.pad_value = pad_value
+
+    def forward(self, x):
+        x = cuda_extension.custom_pad3d(
+            x,
+            self.pad_width[0],
+            self.pad_width[1],
+            self.pad_width[2],
+            self.pad_width[3],
+            self.pad_value,
+        )
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.custom_pad3d(
+            x,
+            self.pad_width[0],
+            self.pad_width[1],
+            self.pad_width[2],
+            self.pad_width[3],
+            self.pad_value,
+        )
+        yield "step_001", x
+        yield "step_002", x
