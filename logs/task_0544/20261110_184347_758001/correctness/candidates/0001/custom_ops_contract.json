{
  "operators": [
    {
      "name": "relu_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[1024, 256, 512]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[1024, 256, 512]"
      },
      "semantics": [
        "对应参考 F.relu(x)，逐元素计算 max(x, 0)。",
        "输入为 float32 CUDA 张量，保持 shape 和 stride 不变。",
        "输出与输入同 shape、dtype、device，且为连续张量。"
      ]
    },
    {
      "name": "batch_norm1d_eval_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[1024, 256, 512]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[256]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[256]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[256]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[256]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[1024, 256, 512]"
      },
      "semantics": [
        "对应参考 self.batch_norm(x)，在 eval 模式下使用全局统计量 running_mean 和 running_var 进行归一化。",
        "归一化轴为通道维（dim=1），对每个通道 c 计算 (x[:, c, :] - running_mean[c]) / sqrt(running_var[c] + eps) * weight[c] + bias[c]。",
        "输入 x 形状 [N, C, L]，权重、偏置、均值、方差形状均为 [C]。",
        "所有输入均为 float32 CUDA 张量，eps 为浮点标量。",
        "输出与 x 同 shape、dtype、device，且为连续张量。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = F.relu(x)",
      "semantics": [
        "对输入张量 x（shape [1024,256,512]）逐元素应用 ReLU 激活函数，输出非负值。",
        "输入和输出均为 float32 CUDA 连续张量。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.batch_norm(x)",
      "semantics": [
        "对 ReLU 输出应用 BatchNorm1d（eval 模式），使用 running_mean 和 running_var 进行归一化，并应用可学习 weight 和 bias。",
        "输出 shape 仍为 [1024,256,512]，float32 CUDA 连续张量。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回 BatchNorm1d 的输出张量。",
        "与 step_002 的值完全相同。"
      ]
    }
  ]
}