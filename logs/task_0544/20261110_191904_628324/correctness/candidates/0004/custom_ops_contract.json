{
  "operators": [
    {
      "name": "relu_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference step [1024, 256, 512]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "Corresponds to reference statement x = F.relu(x)",
        "Elementwise max(input, 0) with no broadcasting",
        "Preserves input shape, dtype, device, and layout",
        "Output is a newly allocated tensor with same shape as input"
      ]
    },
    {
      "name": "batch_norm_eval_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference step [1024, 256, 512]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[256]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[256]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[256]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[256]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "Corresponds to reference statement x = self.batch_norm(x) in eval mode (training=false, track_running_stats=True)",
        "Normalizes each channel c: (x[:, c, :] - running_mean[c]) / sqrt(running_var[c] + eps) * weight[c] + bias[c]",
        "Channel axis is dimension 1; all other dimensions are treated as batch elements",
        "Input and all parameter tensors are on CUDA, float32",
        "Output is a newly allocated tensor with same shape as input"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = F.relu(x)",
      "semantics": [
        "Elementwise ReLU activation on input tensor x",
        "Input and output shapes [1024, 256, 512], float32, CUDA",
        "Output equals max(input, 0) elementwise"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.batch_norm(x)",
      "semantics": [
        "BatchNorm1d applied to ReLU output",
        "Since model.training is false and track_running_stats is true, uses running_mean and running_var",
        "Per-channel affine transform: (input - running_mean[c]) / sqrt(running_var[c] + eps) * weight[c] + bias[c]",
        "Channel axis is dimension 1; output shape [1024, 256, 512], float32, CUDA"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "Returns the result of batch normalization, same tensor as step_002"
      ]
    }
  ]
}