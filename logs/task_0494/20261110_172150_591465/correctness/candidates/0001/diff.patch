--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,34 @@
+#include <cuda_runtime.h>
+
+// Fused softplus + leaky_relu (negative_slope=0.01)
+// input: float tensor, numel elements
+// output: float tensor with same shape
+__global__ void softplus_leaky_relu_kernel(const float* __restrict__ input,
+                                           float* __restrict__ output,
+                                           int64_t numel) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    const float neg_slope = 0.01f;
+    for (int64_t i = idx; i < numel; i += stride) {
+        // softplus: log(1 + exp(x)) = log1p(exp(x))
+        float sp = log1pf(expf(input[i]));
+        // leaky relu
+        output[i] = sp >= 0.0f ? sp : neg_slope * sp;
+    }
+}
+
+// C interface launcher; binding.cpp will allocate output and pass raw pointers + stream.
+extern "C" void softplus_leaky_relu_launcher(const float* input,
+                                              float* output,
+                                              int64_t numel,
+                                              cudaStream_t stream) {
+    if (numel <= 0) return;
+    const int block_size = 256;
+    int64_t blocks = (numel + block_size - 1) / block_size;
+    // grid cap to avoid too many blocks (max grid size typically 2^31-1); use grid-stride loop
+    const int64_t max_blocks = 65535; // safe cap
+    if (blocks > max_blocks) {
+        blocks = max_blocks;
+    }
+    softplus_leaky_relu_kernel<<<(int)blocks, block_size, 0, stream>>>(input, output, numel);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,50 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Launcher declaration from custom_ops.cu
+extern "C" void softplus_leaky_relu_launcher(const float* input,
+                                              float* output,
+                                              int64_t numel,
+                                              cudaStream_t stream);
+
+// PyTorch binding: fused softplus + leaky_relu
+torch::Tensor softplus_leaky_relu(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input tensor must be on CUDA device");
+    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "Input tensor must be float32");
+    TORCH_CHECK(x.numel() > 0, "Input tensor must not be empty");
+
+    // Ensure contiguous for optimized kernel; launcher assumes contiguity
+    torch::Tensor x_contig = x.contiguous();
+    
+    // Allocate output tensor with same shape and options
+    torch::Tensor output = torch::empty_like(x_contig);
+    
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    
+    // Call launcher
+    softplus_leaky_relu_launcher(
+        x_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        x_contig.numel(),
+        stream
+    );
+    
+    // Check for kernel launch errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA kernel launch failed: ", cudaGetErrorString(err));
+    
+    return output;
+}
+
+// Registration
+void register_softplus_leaky_relu(pybind11::module& m) {
+    m.def("softplus_leaky_relu", &softplus_leaky_relu,
+          "Fused softplus + leaky_relu forward",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(softplus_leaky_relu, register_softplus_leaky_relu);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,19 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x):
+        return cuda_extension.softplus_leaky_relu(x)
+
+    def debug_forward(self, x):
+        softplus_out = cuda_extension.softplus_leaky_relu(x)
+        leaky_relu_out = cuda_extension.softplus_leaky_relu(x)
+        final_out = cuda_extension.softplus_leaky_relu(x)
+        yield 'step_001', softplus_out
+        yield 'step_002', leaky_relu_out
+        yield 'step_003', final_out
