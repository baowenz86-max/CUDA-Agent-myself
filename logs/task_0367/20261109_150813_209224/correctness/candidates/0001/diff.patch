--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,66 @@
+#include <cuda_runtime.h>
+
+// CUDA kernel for adaptive average pooling 2D
+// Each thread computes one output element
+__global__ void adaptive_avg_pool2d_kernel(const float* __restrict__ input,
+                                           float* __restrict__ output,
+                                           int N, int C, int H, int W,
+                                           int out_h, int out_w) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = N * C * out_h * out_w;
+    if (idx >= total) return;
+
+    // Decode output indices: n, c, oh, ow
+    int ow = idx % out_w;
+    int tmp = idx / out_w;
+    int oh = tmp % out_h;
+    tmp = tmp / out_h;
+    int c = tmp % C;
+    int n = tmp / C;
+
+    // Compute pooling region boundaries for this output position
+    int start_h = (int)floorf((float)oh * H / out_h);
+    int end_h   = (int)ceilf((float)(oh + 1) * H / out_h);
+    int start_w = (int)floorf((float)ow * W / out_w);
+    int end_w   = (int)ceilf((float)(ow + 1) * W / out_w);
+
+    // Clamp to valid range (should be within bounds by formula, but safe)
+    if (start_h < 0) start_h = 0;
+    if (end_h > H) end_h = H;
+    if (start_w < 0) start_w = 0;
+    if (end_w > W) end_w = W;
+
+    float sum = 0.0f;
+    int count = 0;
+
+    // Base pointer for this (n, c) slice
+    const float* slice = input + ((long long)n * C + c) * H * W; // long long for large sizes
+
+    for (int h = start_h; h < end_h; ++h) {
+        for (int w = start_w; w < end_w; ++w) {
+            sum += slice[h * W + w];
+            ++count;
+        }
+    }
+
+    // Output index: ((n * C + c) * out_h + oh) * out_w + ow
+    int out_idx = ((n * C + c) * out_h + oh) * out_w + ow;
+    output[out_idx] = sum / (float)count;
+}
+
+// Launcher function with C linkage for binding
+extern "C" void custom_adaptive_avg_pool2d_forward_launcher(const float* input,
+                                                               float* output,
+                                                               int N, int C, int H, int W,
+                                                               int out_h, int out_w,
+                                                               cudaStream_t stream) {
+    int total = N * C * out_h * out_w;
+    if (total <= 0) return;
+
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+
+    adaptive_avg_pool2d_kernel<<<blocks, threads, 0, stream>>>(
+        input, output, N, C, H, W, out_h, out_w
+    );
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,56 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+extern "C" void custom_adaptive_avg_pool2d_forward_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    int out_h, int out_w,
+    cudaStream_t stream);
+
+torch::Tensor custom_adaptive_avg_pool2d_forward(
+    torch::Tensor x,
+    int64_t output_size_h,
+    int64_t output_size_w) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D (N, C, H, W)");
+    TORCH_CHECK(output_size_h > 0 && output_size_w > 0, "Output size must be positive");
+
+    auto x_contig = x.contiguous();
+
+    int N = x_contig.size(0);
+    int C = x_contig.size(1);
+    int H = x_contig.size(2);
+    int W = x_contig.size(3);
+    int out_h = static_cast<int>(output_size_h);
+    int out_w = static_cast<int>(output_size_w);
+
+    auto output = torch::empty({N, C, out_h, out_w}, x_contig.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_adaptive_avg_pool2d_forward_launcher(
+        x_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C, H, W,
+        out_h, out_w,
+        stream);
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA kernel failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+void register_custom_adaptive_avg_pool2d(pybind11::module& m) {
+    m.def("custom_adaptive_avg_pool2d_forward",
+          &custom_adaptive_avg_pool2d_forward,
+          "Adaptive avg pool2d forward",
+          py::arg("x"), py::arg("output_size_h"), py::arg("output_size_w"));
+}
+
+REGISTER_BINDING(custom_adaptive_avg_pool2d, register_custom_adaptive_avg_pool2d);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,22 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, pooling_kernel):
+        super().__init__()
+        self.output_size_h = pooling_kernel[0]
+        self.output_size_w = pooling_kernel[1]
+
+    def forward(self, x):
+        x = cuda_extension.custom_adaptive_avg_pool2d_forward(x, self.output_size_h, self.output_size_w)
+        return x
+
+    def debug_forward(self, *inputs):
+        if len(inputs) != 1:
+            raise TypeError("debug_forward expected 1 input tensor")
+        x = inputs[0]
+        x = cuda_extension.custom_adaptive_avg_pool2d_forward(x, self.output_size_h, self.output_size_w)
+        yield "step_001", x
+        yield "step_002", x
