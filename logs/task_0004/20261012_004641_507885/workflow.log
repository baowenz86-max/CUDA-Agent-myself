#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>

#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

// Declare launcher from .cu file
extern "C" void repeat_interleave_launcher(
    void* output,
    const void* input,
    int B, int S, int E, int repeats,
    int dtype_size,
    cudaStream_t stream
);

torch::Tensor repeat_interleave_forward(
    torch::Tensor input,
    int64_t repeats,
    int64_t dim) {
    // Input validation
    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(dim == 1, "Only dim=1 is supported");
    TORCH_CHECK(repeats > 0, "repeats must be positive");
    TORCH_CHECK(input.dim() == 3, "Input must be 3D (B, S, E)");
    
    const auto dtype = input.scalar_type();
    TORCH_CHECK(
        dtype == torch::kFloat32 || dtype == torch::kFloat16 ||
        dtype == torch::kBFloat16 || dtype == torch::kFloat64,
        "Unsupported dtype: ", dtype
    );
    
    auto B = input.size(0);
    auto S = input.size(1);
    auto E = input.size(2);
    
    // Allocate output
    auto output = torch::empty(
        {B, S * repeats, E},
        input.options());
    
    // Get current CUDA stream
    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
    
    // Determine dtype size in bytes
    int dtype_size = static_cast<int>(input.element_size());
    
    // Call launcher
    repeat_interleave_launcher(
        output.data_ptr(),
        input.data_ptr(),
        static_cast<int>(B),
        static_cast<int>(S),
        static_cast<int>(E),
        static_cast<int>(repeats),
        dtype_size,
        stream
    );
    
    return output;
}

void register_repeat_interleave(pybind11::module& m) {
    m.def("repeat_interleave_forward", &repeat_interleave_forward,
          "Repeat interleave along dim=1",
          py::arg("input"),
          py::arg("repeats"),
          py::arg("dim"));
}

REGISTER_BINDING(repeat_interleave, register_repeat_interleave);

===== kernels/repeat_interleave_forward.cu =====
#include <cuda_runtime.h>
#include <cuda_fp16.h>
#include <cuda_bf16.h>
#include <cstdint>

// Kernel to repeat interleave along dimension 1 (sequence dimension).
// Input tensor is assumed to be of shape [B, S, E] contiguous,
// with elements of type T (float, half, bfloat16, double).
// Output is [B, S * repeats, E].
// Each thread handles one output element.
template <typename T>
__global__ void repeat_interleave_kernel(
    T* __restrict__ output,
    const T* __restrict__ input,
    int B, int S, int E, int repeats)
{
    int out_idx = blockIdx.x * blockDim.x + threadIdx.x;
    int total_out = B * S * repeats * E;
    if (out_idx >= total_out) return;

    // Decompose output index
    int e = out_idx % E;
    int tmp = out_idx / E;            // [0, B * S * repeats)
    int s_rep = tmp % (S * repeats);
    int b = tmp / (S * repeats);
    int s = s_rep / repeats;

    int in_idx = ((b * S) + s) * E + e;
    output[out_idx] = input[in_idx];
}

// Host launcher for repeat_interleave along dim=1.
// Accepts raw pointers, dimensions, repeats, dtype size, and stream.
extern "C" void repeat_interleave_launcher(
    void* output,
    const void* input,
    int B, int S, int E, int repeats,
    int dtype_size,
    cudaStream_t stream)
{
    int total_out = B * S * repeats * E;
    int threads = 256;
    int blocks = (total_out + threads - 1) / threads;

    // Dispatch based on dtype_size (bytes per element)
    switch (dtype_size) {
        case 2: // half or bfloat16
            repeat_interleave_kernel<__half><<<blocks, threads, 0, stream>>>(
                reinterpret_cast<__half*>(output),
                reinterpret_cast<const __half*>(input),
                B, S, E, repeats);
            break;
        case 4: // float
            repeat_interleave_kernel<float><<<blocks, threads, 0, stream>>>(
                reinterpret_cast<float*>(output),
                reinterpret_cast<const float*>(input),
                B, S, E, repeats);
            break;
        case 8: // double
            repeat_interleave_kernel<double><<<blocks, threads, 0, stream>>>(
                reinterpret_cast<double*>(output),
                reinterpret_cast<const double*>(input),
                B, S, E, repeats);
            break;
        default:
            // Should not happen if binding checks dtype.
            break;
    }
}
