import torch
import torch.nn as nn
import cuda_extension


class ModelNew(nn.Module):
    def __init__(self, embed_dim, num_heads, batch_first, repeat_interleave_times, scaling_factor):
        super().__init__()
        self.repeat_interleave_times = repeat_interleave_times
        self.scaling_factor = scaling_factor
        self.multihead_attn = nn.MultiheadAttention(embed_dim, num_heads, batch_first=batch_first)

    def forward(self, x, y):
        x = cuda_extension.repeat_interleave_forward(x, self.repeat_interleave_times, dim=1)
        y = cuda_extension.repeat_interleave_forward(y, self.repeat_interleave_times, dim=1)

        attn_output = cuda_extension.multihead_attention_forward(
            x, y, y,
            self.multihead_attn.in_proj_weight,
            self.multihead_attn.in_proj_bias,
            self.multihead_attn.out_proj.weight,
            self.multihead_attn.out_proj.bias,
            self.multihead_attn.embed_dim,
            self.multihead_attn.num_heads,
            True,
            self.multihead_attn.dropout
        )

        attn_output = cuda_extension.tanh_scale_forward(attn_output, self.scaling_factor)

        return attn_output


