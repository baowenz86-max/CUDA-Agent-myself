===== kernels/multihead_attention_forward.cu =====
#include <cuda_runtime.h>
#include <cublas_v2.h>
#include <cuda_fp16.h>
#include <cuda_bf16.h>
#include <cmath>
#include <cstdint>
#include <cfloat>

// Bias addition kernel
__global__ void add_bias_kernel(
    float* __restrict__ data,
    const float* __restrict__ bias,
    int total,
    int E,
    int offset)
{
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx < total) {
        int e = idx % E;
        data[idx] += bias[offset + e];
    }
}

// Attention kernel
__global__ void attention_forward_kernel(
    float* __restrict__ attn_out,
    const float* __restrict__ Q_full,
    const float* __restrict__ K_full,
    const float* __restrict__ V_full,
    int B, int H, int S, int D,
    float scale)
{
    int b = blockIdx.y;
    int h = blockIdx.x;
    int q = threadIdx.x;
    if (q >= S) return;

    const float* Q_ptr = Q_full + b * S * H * D + q * H * D + h * D;
    float* O_ptr = attn_out + b * S * H * D + q * H * D + h * D;

    float max_val = -FLT_MAX;
    for (int s = 0; s < S; ++s) {
        const float* K_ptr = K_full + b * S * H * D + s * H * D + h * D;
        float dot = 0.0f;
        for (int d = 0; d < D; ++d) {
            dot += Q_ptr[d] * K_ptr[d];
        }
        dot *= scale;
        if (dot > max_val) max_val = dot;
    }

    float sum_exp = 0.0f;
    for (int s = 0; s < S; ++s) {
        const float* K_ptr = K_full + b * S * H * D + s * H * D + h * D;
        float dot = 0.0f;
        for (int d = 0; d < D; ++d) {
            dot += Q_ptr[d] * K_ptr[d];
        }
        dot *= scale;
        sum_exp += __expf(dot - max_val);
    }
    float inv_sum = 1.0f / sum_exp;

    for (int d = 0; d < D; ++d) {
        float acc = 0.0f;
        for (int s = 0; s < S; ++s) {
            const float* K_ptr = K_full + b * S * H * D + s * H * D + h * D;
            const float* V_ptr = V_full + b * S * H * D + s * H * D + h * D;
            float dot = 0.0f;
            for (int dd = 0; dd < D; ++dd) {
                dot += Q_ptr[dd] * K_ptr[dd];
            }
            dot *= scale;
            float weight = __expf(dot - max_val) * inv_sum;
            acc += weight * V_ptr[d];
        }
        O_ptr[d] = acc;
    }
}

// Host launcher
extern "C" void multihead_attention_launcher(
    const float* x,
    const float* y,
    const float* in_proj_weight,
    const float* in_proj_bias,
    const float* out_proj_weight,
    const float* out_proj_bias,
    float* output,
    int B, int S, int E, int H,
    float dropout_prob,
    cudaStream_t stream)
{
    const int D = E / H;
    const float scale = 1.0f / sqrtf((float)D);

    cublasHandle_t handle;
    cublasCreate(&handle);
    cublasSetStream(handle, stream);

    float *Q_full, *K_full, *V_full, *attn_full;
    size_t full_size = B * S * E * sizeof(float);
    cudaMalloc(&Q_full, full_size);
    cudaMalloc(&K_full, full_size);
    cudaMalloc(&V_full, full_size);
    cudaMalloc(&attn_full, full_size);

    float alpha = 1.0f, beta = 0.0f;
    // Q = x * Wq^T
    cublasSgemm(handle, CUBLAS_OP_N, CUBLAS_OP_T,
                B * S, E, E,
                &alpha,
                x, B * S,
                in_proj_weight, E,
                &beta,
                Q_full, B * S);
    // K = y * Wk^T
    cublasSgemm(handle, CUBLAS_OP_N, CUBLAS_OP_T,
                B * S, E, E,
                &alpha,
                y, B * S,
                in_proj_weight + E * E, E,
                &beta,
                K_full, B * S);
    // V = y * Wv^T
    cublasSgemm(handle, CUBLAS_OP_N, CUBLAS_OP_T,
                B * S, E, E,
                &alpha,
                y, B * S,
                in_proj_weight + 2 * E * E, E,
                &beta,
                V_full, B * S);

    // Add biases
    int total_elements = B * S * E;
    int threads = 256;
    int blocks = (total_elements + threads - 1) / threads;
    add_bias_kernel<<<blocks, threads, 0, stream>>>(
        Q_full, in_proj_bias, total_elements, E, 0);
    add_bias_kernel<<<blocks, threads, 0, stream>>>(
        K_full, in_proj_bias, total_elements, E, E);
    add_bias_kernel<<<blocks, threads, 0, stream>>>(
        V_full, in_proj_bias, total_elements, E, 2 * E);

    // Attention kernel
    dim3 grid(H, B);
    attention_forward_kernel<<<grid, 256, 0, stream>>>(
        attn_full, Q_full, K_full, V_full, B, H, S, D, scale);

    // Output projection
    cublasSgemm(handle, CUBLAS_OP_N, CUBLAS_OP_T,
                B * S, E, E,
                &alpha,
                attn_full, B * S,
                out_proj_weight, E,
                &beta,
                output, B * S);
    // Add output bias
    add_bias_kernel<<<blocks, threads, 0, stream>>>(
        output, out_proj_bias, total_elements, E, 0);

    cudaFree(Q_full);
    cudaFree(K_full);
    cudaFree(V_full);
    cudaFree(attn_full);
    cublasDestroy(handle);
}

