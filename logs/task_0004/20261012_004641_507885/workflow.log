            self.multihead_attn.embed_dim,
            self.multihead_attn.num_heads,
            True,  # batch_first
            self.multihead_attn.dropout,
        )
        attn_output = cuda_extension.tanh_scale_forward(attn_output, self.scaling_factor)
        return attn_output


