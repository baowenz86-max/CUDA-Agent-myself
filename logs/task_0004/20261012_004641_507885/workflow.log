import torch
import torch.nn as nn


class Model(nn.Module):
    def __init__(self, embed_dim, num_heads, batch_first, repeat_interleave_times, scaling_factor):
        super().__init__()
        self.multihead_attn = nn.MultiheadAttention(embed_dim, num_heads, batch_first=batch_first)
        self.repeat_interleave_times = repeat_interleave_times
        self.scaling_factor = scaling_factor

    def forward(self, x, y):
        x = torch.repeat_interleave(x, repeats=self.repeat_interleave_times, dim=1)
        y = torch.repeat_interleave(y, repeats=self.repeat_interleave_times, dim=1)
        attn_output, attn_output_weights = self.multihead_attn(x, y, y)
        attn_output = torch.tan(attn_output * self.scaling_factor)
        return attn_output


batch_size = 128
embed_dim = 512
num_heads = 8
sequence_length = 50  # Increased from 10 to increase computation
repeat_interleave_times = 2
scaling_factor = 0.5


def get_inputs():
    x = torch.randn(batch_size, sequence_length, embed_dim)
    y = torch.randn(batch_size, sequence_length, embed_dim)
    return [x, y]


def get_init_inputs():
    return [embed_dim, num_heads, True, repeat_interleave_times, scaling_factor]

===== model_new.py =====
import torch
import torch.nn as nn
import cuda_extension


class ModelNew(nn.Module):
    def __init__(self, embed_dim, num_heads, batch_first, repeat_interleave_times, scaling_factor):
        super().__init__()
        self.repeat_interleave_times = repeat_interleave_times
        self.scaling_factor = scaling_factor
        # Keep the original MultiheadAttention module to preserve parameters and state_dict compatibility.
        # We will not call its forward, but use its parameters in custom kernels.
        self.multihead_attn = nn.MultiheadAttention(embed_dim, num_heads, batch_first=batch_first)

    def forward(self, x, y):
        # 1. Repeat interleave along sequence dimension (dim=1), as in original model.
        #    The custom kernel `repeat_interleave_forward` supports 3D tensors and float32/float64.
        #    It returns a tensor of shape (B, S*repeats, E).
        x = cuda_extension.repeat_interleave_forward(x, self.repeat_interleave_times, dim=1)
        y = cuda_extension.repeat_interleave_forward(y, self.repeat_interleave_times, dim=1)

        # 2. Multihead attention (batch_first=True).
        #    Define a custom op `multihead_attention_forward` that exactly replicates
        #    torch.nn.MultiheadAttention.forward with need_weights=False.
        #    It receives query, key, value (all shape B, S, E), plus the internal weights/biases,
        #    embedding dimension, number of heads, batch_first flag, and dropout probability.
        #    The kernel will compute the full attention and output projection.
        attn_output = cuda_extension.multihead_attention_forward(
            x, y, y,
            self.multihead_attn.in_proj_weight,
            self.multihead_attn.in_proj_bias,
            self.multihead_attn.out_proj.weight,
            self.multihead_attn.out_proj.bias,
            self.multihead_attn.embed_dim,
            self.multihead_attn.num_heads,
            True,  # batch_first
            self.multihead_attn.dropout
        )

        # 3. Apply tanh scaling: tanh(attn_output * scaling_factor)
        attn_output = cuda_extension.tanh_scale_forward(attn_output, self.scaling_factor)

        return attn_output


