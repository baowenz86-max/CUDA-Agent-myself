// Simplified kernel: repeat interleave, compute QKV, multi-head attention, output projection, tanh scaling
// Assumptions: batch_first=True, inputs are float32, contiguous, on CUDA.
// All dimensions are passed explicitly by the host launcher.
// For simplicity, we use one CUDA block per (batch, head) pair, with a fixed number of threads per block (256).
// The kernel processes one query position per warp, but for simplicity each thread handles one output element sequentially
// (not optimized for maximum performance, but correct).

// Per (batch, head) block: compute attention for a given head
// Each block processes all query positions for one head (across the entire sequence length).
// We'll use shared memory to store Q, K, V, and attention scores.
// Since embed_dim may be large, we need to dynamically allocate shared memory.

template <int BLOCK_SIZE>
__global__ void fused_attention_kernel(
    const float* __restrict__ x,        // [B, S, E]
    const float* __restrict__ y,        // [B, S, E]
    const float* __restrict__ in_proj_weight, // [3E, E]
    const float* __restrict__ in_proj_bias,   // [3E]
    const float* __restrict__ out_proj_weight,// [E, E]
    const float* __restrict__ out_proj_bias,  // [E]
