    // In this file, we'll implement both kernels and the launcher will allocate temporary memory and launch them sequentially.

    // For now, we are inside kernel1 logic, but we'll move to separate kernels.
}

// Actually, we'll restructure: we'll implement two separate __global__ functions and a launcher that calls both.

// Kernel 1: compute multi-head attention output (before output projection) into attn_pre_proj [B, S_rep, E].
// Each block handles one (batch, head) pair, computes the head's output and writes it to the corresponding slice of attn_pre_proj.
__global__ void attention_kernel(
    const float* __restrict__ x,
    const float* __restrict__ y,
    const float* __restrict__ in_proj_weight,
    const float* __restrict__ in_proj_bias,
    float* __restrict__ attn_pre_proj, // [B, S_rep, E]
    int B, int S_orig, int S_rep, int E, int H, int repeat_times
) {
    const int batch_idx = blockIdx.x;
    const int head_idx = blockIdx.y;
    const int head_dim = E / H;
    const int tid = threadIdx.x;
    const int num_threads = blockDim.x;

    // Shared memory for Q,K,V and scores
    extern __shared__ float smem[];
    float* Q = smem; // [S_rep, head_dim]
    float* K = Q + S_rep * head_dim;
    float* V = K + S_rep * head_dim;
    float* scores = V + S_rep * head_dim; // [S_rep, S_rep]

    // Load Q, K, V into shared memory
    int total_q = S_rep * head_dim;
    for (int idx = tid; idx < total_q; idx += num_threads) {
        int r = idx / head_dim;
        int d = idx % head_dim;
        int orig_i = r / repeat_times;
        const float* x_row = x + (batch_idx * S_orig + orig_i) * E;
        float sum = in_proj_bias[head_idx * head_dim + d];
        for (int e = 0; e < E; ++e) {
            sum += x_row[e] * in_proj_weight[(head_idx * head_dim + d) * E + e];
        }
        Q[idx] = sum;
    }

    int total_kv = S_rep * head_dim;
    for (int idx = tid; idx < total_kv; idx += num_threads) {
        int r = idx / head_dim;
        int d = idx % head_dim;
        int orig_i = r / repeat_times;
        const float* y_row = y + (batch_idx * S_orig + orig_i) * E;
        // K
        float sum_k = in_proj_bias[E + head_idx * head_dim + d];
        for (int e = 0; e < E; ++e) {
            sum_k += y_row[e] * in_proj_weight[(E + head_idx * head_dim + d) * E + e];
        }
        K[idx] = sum_k;
        // V
        float sum_v = in_proj_bias[2*E + head_idx * head_dim + d];
        for (int e = 0; e < E; ++e) {
            sum_v += y_row[e] * in_proj_weight[(2*E + head_idx * head_dim + d) * E + e];
        }
        V[idx] = sum_v;
    }
    __syncthreads();

    // Compute attention scores
    int total_scores = S_rep * S_rep;
    for (int idx = tid; idx < total_scores; idx += num_threads) {
        int rq = idx / S_rep;
        int rk = idx % S_rep;
        float dot = 0.0f;
        for (int d = 0; d < head_dim; ++d) {
            dot += Q[rq * head_dim + d] * K[rk * head_dim + d];
        }
        scores[idx] = dot / sqrtf((float)head_dim);
    }
    __syncthreads();

    // Softmax per row: use one thread per row if S_rep <= num_threads, else grid-stride over rows.
    for (int r = tid; r < S_rep; r += num_threads) {
        float* row = &scores[r * S_rep];
        float max_val = row[0];
        for (int j = 1; j < S_rep; ++j) {
            max_val = fmaxf(max_val, row[j]);
        }
        float sum = 0.0f;
        for (int j = 0; j < S_rep; ++j) {
            row[j] = expf(row[j] - max_val);
            sum += row[j];
        }
        for (int j = 0; j < S_rep; ++j) {
            row[j] /= sum;
        }
    }
    __syncthreads();

    // Compute output for this head and write to attn_pre_proj at [batch_idx, r, head_idx*head_dim + d]
    int total_out = S_rep * head_dim;
    for (int idx = tid; idx < total_out; idx += num_threads) {
        int r = idx / head_dim;
        int d = idx % head_dim;
        float sum = 0.0f;
        for (int k = 0; k < S_rep; ++k) {
            sum += scores[r * S_rep + k] * V[k * head_dim + d];
        }
        int global_idx = (batch_idx * S_rep + r) * E + head_idx * head_dim + d;
        attn_pre_proj[global_idx] = sum;
    }
}

// Kernel 2: apply output projection and tan(scaling_factor * projected)
__global__ void output_proj_tan_kernel(
    const float* __restrict__ attn_pre_proj, // [B, S_rep, E]
    const float* __restrict__ out_proj_weight, // [E, E]
    const float* __restrict__ out_proj_bias,   // [E]
    float* __restrict__ output,                // [B, S_rep, E]
    int B, int S_rep, int E,
    float scaling_factor
) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int total = B * S_rep * E;
    if (idx >= total) return;

    int b = idx / (S_rep * E);
    int rem = idx % (S_rep * E);
    int s = rem / E;
    int e = rem % E;

    const float* in_row = attn_pre_proj + (b * S_rep + s) * E;
    float sum = out_proj_bias[e];
    for (int j = 0; j < E; ++j) {
        sum += in_row[j] * out_proj_weight[e * E + j]; // note: out_proj_weight is [E, E], transposed use as weight^T
    }
    output[idx] = tanf(sum * scaling_factor);
}

// Host launcher: allocates temporary buffer, launches both kernels, frees buffer.
extern "C" void fused_attention_forward_launcher(
    const float* x, const float* y,
    const float* in_proj_weight, const float* in_proj_bias,
    const float* out_proj_weight, const float* out_proj_bias,
    float* output,
    int B, int S_orig, int repeat_times,
    int E, int H,
    float scaling_factor,
    cudaStream_t stream
) {
    int S_rep = S_orig * repeat_times;
    int head_dim = E / H;

    // Validate dimensions
    if (E % H != 0) {
        printf("Error: embed_dim must be divisible by num_heads\n");
        return;
    }

    // Allocate temporary buffer for pre-projection attention output
    int attn_pre_proj_size = B * S_rep * E * sizeof(float);
    float* attn_pre_proj;
    CUDA_CHECK(cudaMalloc(&attn_pre_proj, attn_pre_proj_size));

    // Configure kernel launches
    dim3 grid1(B, H); // one block per (batch, head)
    int block_size = 256;
    int smem_size = (S_rep * head_dim * 3 + S_rep * S_rep) * sizeof(float);
    if (smem_size > 48 * 1024) {
        // If too large, reduce block size or handle differently. For now, assume fits.
        printf("Warning: shared memory size %d may exceed limit\n", smem_size);
    }

    attention_kernel<<<grid1, block_size, smem_size, stream>>>(
        x, y, in_proj_weight, in_proj_bias,
        attn_pre_proj,
        B, S_orig, S_rep, E, H, repeat_times
    );

    // Launch output projection kernel
    int total_out = B * S_rep * E;
    int block_size2 = 256;
    int grid2 = (total_out + block_size2 - 1) / block_size2;
    output_proj_tan_kernel<<<grid2, block_size2, 0, stream>>>(
        attn_pre_proj, out_proj_weight, out_proj_bias, output,
        B, S_rep, E, scaling_factor
    );

    // Free temporary buffer after kernel completion (we can use stream callback or just free after sync)
    // Since we don't want to synchronize, we can use cudaFree after launching, but need to ensure kernel finished.
    // We can use cudaFreeAsync if available, but to be safe, we can synchronize the stream before freeing.
    // Alternatively, we can rely on CUDA's default stream ordering: cudaFree after kernel launches on same stream may be safe?
    // Typically, cudaFree may block until all kernels complete. It's fine.
    CUDA_CHECK(cudaFree(attn_pre_proj));

    // Optionally check for kernel errors asynchronously
    CUDA_CHECK(cudaGetLastError());
}
