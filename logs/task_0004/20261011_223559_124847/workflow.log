===== kernels/fused_attention.cu =====
#include <cuda_runtime.h>
#include <cstdint>
#include <cstdio>

#define CUDA_CHECK(condition) \
  do { \
    cudaError_t error = condition; \
    if (error != cudaSuccess) { \
      printf("CUDA error: %s at line %d\n", cudaGetErrorString(error), __LINE__); \
      return; \
    } \
  } while (0)

__global__ void attention_kernel(
    const float* __restrict__ x,
    const float* __restrict__ y,
    const float* __restrict__ in_proj_weight,
    const float* __restrict__ in_proj_bias,
    float* __restrict__ attn_pre_proj,
    int B, int S_orig, int S_rep, int E, int H, int repeat_times
) {
    const int batch_idx = blockIdx.x;
    const int head_idx = blockIdx.y;
    const int head_dim = E / H;
    const int tid = threadIdx.x;
    const int num_threads = blockDim.x;

    extern __shared__ float smem[];
    float* Q = smem;
    float* K = Q + S_rep * head_dim;
    float* V = K + S_rep * head_dim;
    float* scores = V + S_rep * head_dim;

    int total_q = S_rep * head_dim;
    for (int idx = tid; idx < total_q; idx += num_threads) {
        int r = idx / head_dim;
        int d = idx % head_dim;
        int orig_i = r / repeat_times;
        const float* x_row = x + (batch_idx * S_orig + orig_i) * E;
        float sum = in_proj_bias[head_idx * head_dim + d];
        for (int e = 0; e < E; ++e) {
            sum += x_row[e] * in_proj_weight[(head_idx * head_dim + d) * E + e];
        }
        Q[idx] = sum;
    }

    int total_kv = S_rep * head_dim;
    for (int idx = tid; idx < total_kv; idx += num_threads) {
        int r = idx / head_dim;
        int d = idx % head_dim;
        int orig_i = r / repeat_times;
        const float* y_row = y + (batch_idx * S_orig + orig_i) * E;
        float sum_k = in_proj_bias[E + head_idx * head_dim + d];
        for (int e = 0; e < E; ++e) {
            sum_k += y_row[e] * in_proj_weight[(E + head_idx * head_dim + d) * E + e];
        }
        K[idx] = sum_k;
        float sum_v = in_proj_bias[2*E + head_idx * head_dim + d];
        for (int e = 0; e < E; ++e) {
            sum_v += y_row[e] * in_proj_weight[(2*E + head_idx * head_dim + d) * E + e];
        }
        V[idx] = sum_v;
    }
    __syncthreads();

    int total_scores = S_rep * S_rep;
    for (int idx = tid; idx < total_scores; idx += num_threads) {
        int rq = idx / S_rep;
        int rk = idx % S_rep;
        float dot = 0.0f;
        for (int d = 0; d < head_dim; ++d) {
            dot += Q[rq * head_dim + d] * K[rk * head_dim + d];
        }
        scores[idx] = dot / sqrtf((float)head_dim);
    }
    __syncthreads();

    for (int r = tid; r < S_rep; r += num_threads) {
        float* row = &scores[r * S_rep];
        float max_val = row[0];
        for (int j = 1; j < S_rep; ++j) {
            max_val = fmaxf(max_val, row[j]);
        }
        float sum = 0.0f;
        for (int j = 0; j < S_rep; ++j) {
            row[j] = expf(row[j] - max_val);
            sum += row[j];
        }
        for (int j = 0; j < S_rep; ++j) {
            row[j] /= sum;
        }
    }
    __syncthreads();

    int total_out = S_rep * head_dim;
    for (int idx = tid; idx < total_out; idx += num_threads) {
        int r = idx / head_dim;
        int d = idx % head_dim;
        float sum = 0.0f;
        for (int k = 0; k < S_rep; ++k) {
            sum += scores[r * S_rep + k] * V[k * head_dim + d];
        }
        int global_idx = (batch_idx * S_rep + r) * E + head_idx * head_dim + d;
        attn_pre_proj[global_idx] = sum;
    }
}

__global__ void output_proj_tan_kernel(
    const float* __restrict__ attn_pre_proj,
    const float* __restrict__ out_proj_weight,
    const float* __restrict__ out_proj_bias,
    float* __restrict__ output,
    int B, int S_rep, int E,
    float scaling_factor
) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int total = B * S_rep * E;
    if (idx >= total) return;

    int b = idx / (S_rep * E);
    int rem = idx % (S_rep * E);
    int s = rem / E;
    int e = rem % E;

    const float* in_row = attn_pre_proj + (b * S_rep + s) * E;
    float sum = out_proj_bias[e];
    for (int j = 0; j < E; ++j) {
        sum += in_row[j] * out_proj_weight[e * E + j];
    }
    output[idx] = tanf(sum * scaling_factor);
}

extern "C" void fused_attention_forward_launcher(
    const float* x, const float* y,
    const float* in_proj_weight, const float* in_proj_bias,
    const float* out_proj_weight, const float* out_proj_bias,
    float* output,
    int B, int S_orig, int repeat_times,
    int E, int H,
    float scaling_factor,
    cudaStream_t stream
) {
    int S_rep = S_orig * repeat_times;
    int head_dim = E / H;

    if (E % H != 0) {
        printf("Error: embed_dim must be divisible by num_heads\n");
        return;
    }

    int attn_pre_proj_size = B * S_rep * E * sizeof(float);
    float* attn_pre_proj;
    CUDA_CHECK(cudaMalloc(&attn_pre_proj, attn_pre_proj_size));

    dim3 grid1(B, H);
    int block_size = 256;
    int smem_size = (S_rep * head_dim * 3 + S_rep * S_rep) * sizeof(float);
    if (smem_size > 48 * 1024) {
        printf("Warning: shared memory size %d may exceed limit\n", smem_size);
    }

    attention_kernel<<<grid1, block_size, smem_size, stream>>>(
        x, y, in_proj_weight, in_proj_bias,
        attn_pre_proj,
        B, S_orig, S_rep, E, H, repeat_times
    );

    int total_out = B * S_rep * E;
    int block_size2 = 256;
    int grid2 = (total_out + block_size2 - 1) / block_size2;
    output_proj_tan_kernel<<<grid2, block_size2, 0, stream>>>(
        attn_pre_proj, out_proj_weight, out_proj_bias, output,
        B, S_rep, E, scaling_factor
    );

    CUDA_CHECK(cudaFree(attn_pre_proj));
    CUDA_CHECK(cudaGetLastError());
}

===== kernels/fused_attention_binding.cpp =====
#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>
#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

// Declare the launcher from fused_attention.cu
extern "C" void fused_attention_forward_launcher(
    const float* x, const float* y,
    const float* in_proj_weight, const float* in_proj_bias,
    const float* out_proj_weight, const float* out_proj_bias,
    float* output,
    int B, int S_orig, int repeat_times,
    int E, int H,
    float scaling_factor,
    cudaStream_t stream
);

torch::Tensor fused_attention_forward(
    torch::Tensor x,
    torch::Tensor y,
    torch::Tensor in_proj_weight,
    torch::Tensor in_proj_bias,
    torch::Tensor out_proj_weight,
    torch::Tensor out_proj_bias,
    int64_t embed_dim,
    int64_t num_heads,
    int64_t repeat_interleave_times,
    double scaling_factor
) {
    // Input validation
    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
    TORCH_CHECK(y.is_cuda(), "y must be a CUDA tensor");
    TORCH_CHECK(in_proj_weight.is_cuda(), "in_proj_weight must be a CUDA tensor");
    TORCH_CHECK(in_proj_bias.is_cuda(), "in_proj_bias must be a CUDA tensor");
    TORCH_CHECK(out_proj_weight.is_cuda(), "out_proj_weight must be a CUDA tensor");
    TORCH_CHECK(out_proj_bias.is_cuda(), "out_proj_bias must be a CUDA tensor");

    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
    TORCH_CHECK(y.is_contiguous(), "y must be contiguous");
    TORCH_CHECK(in_proj_weight.is_contiguous(), "in_proj_weight must be contiguous");
    TORCH_CHECK(in_proj_bias.is_contiguous(), "in_proj_bias must be contiguous");
    TORCH_CHECK(out_proj_weight.is_contiguous(), "out_proj_weight must be contiguous");
    TORCH_CHECK(out_proj_bias.is_contiguous(), "out_proj_bias must be contiguous");

    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
    TORCH_CHECK(y.dtype() == torch::kFloat32, "y must be float32");
    TORCH_CHECK(in_proj_weight.dtype() == torch::kFloat32, "in_proj_weight must be float32");
    TORCH_CHECK(in_proj_bias.dtype() == torch::kFloat32, "in_proj_bias must be float32");
    TORCH_CHECK(out_proj_weight.dtype() == torch::kFloat32, "out_proj_weight must be float32");
    TORCH_CHECK(out_proj_bias.dtype() == torch::kFloat32, "out_proj_bias must be float32");

    // Check dimensions
    TORCH_CHECK(x.dim() == 3, "x must be 3D [B, S, E]");
    TORCH_CHECK(y.dim() == 3, "y must be 3D [B, S, E]");
    int64_t B = x.size(0);
    int64_t S_orig = x.size(1);
    int64_t E = x.size(2);
    TORCH_CHECK(y.size(0) == B && y.size(1) == S_orig && y.size(2) == E, "y shape mismatch");
    TORCH_CHECK(E == embed_dim, "embed_dim mismatch");
    TORCH_CHECK(in_proj_weight.size(0) == 3 * embed_dim && in_proj_weight.size(1) == embed_dim, "in_proj_weight shape must be [3E, E]");
    TORCH_CHECK(in_proj_bias.numel() == 3 * embed_dim, "in_proj_bias must have 3E elements");
    TORCH_CHECK(out_proj_weight.size(0) == embed_dim && out_proj_weight.size(1) == embed_dim, "out_proj_weight shape must be [E, E]");
    TORCH_CHECK(out_proj_bias.numel() == embed_dim, "out_proj_bias must have E elements");
    TORCH_CHECK(embed_dim % num_heads == 0, "embed_dim must be divisible by num_heads");

    // Compute output size: S_rep = S_orig * repeat_interleave_times
    int64_t S_rep = S_orig * repeat_interleave_times;
    auto options = torch::TensorOptions().dtype(torch::kFloat32).device(x.device());
    torch::Tensor output = torch::empty({B, S_rep, E}, options);

    // Get CUDA stream
    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    // Call launcher
    fused_attention_forward_launcher(
        x.data_ptr<float>(),
        y.data_ptr<float>(),
        in_proj_weight.data_ptr<float>(),
        in_proj_bias.data_ptr<float>(),
        out_proj_weight.data_ptr<float>(),
        out_proj_bias.data_ptr<float>(),
        output.data_ptr<float>(),
        static_cast<int>(B),
        static_cast<int>(S_orig),
        static_cast<int>(repeat_interleave_times),
        static_cast<int>(E),
        static_cast<int>(num_heads),
        static_cast<float>(scaling_factor),
        stream
    );

    return output;
}

void register_fused_attention(pybind11::module& m) {
    m.def(
        "fused_attention_forward",
        &fused_attention_forward,
        "Fused repeat interleave + multihead attention + tan scaling",
        pybind11::arg("x"),
        pybind11::arg("y"),
        pybind11::arg("in_proj_weight"),
        pybind11::arg("in_proj_bias"),
        pybind11::arg("out_proj_weight"),
        pybind11::arg("out_proj_bias"),
        pybind11::arg("embed_dim"),
        pybind11::arg("num_heads"),
        pybind11::arg("repeat_interleave_times"),
        pybind11::arg("scaling_factor")
    );
}

REGISTER_BINDING(fused_attention, register_fused_attention);
