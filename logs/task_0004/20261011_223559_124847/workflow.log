===== kernels/fused_attention.cu =====
#include <cuda_runtime.h>
#include <cstdint>

#define CUDA_CHECK(condition) \
  do { \
    cudaError_t error = condition; \
    if (error != cudaSuccess) { \
      printf("CUDA error: %s at line %d\n", cudaGetErrorString(error), __LINE__); \
      return; \
    } \
  } while (0)

// Simplified kernel: repeat interleave, compute QKV, multi-head attention, output projection, tanh scaling
// Assumptions: batch_first=True, inputs are float32, contiguous, on CUDA.
// All dimensions are passed explicitly by the host launcher.
// For simplicity, we use one CUDA block per (batch, head) pair, with a fixed number of threads per block (256).
// The kernel processes one query position per warp, but for simplicity each thread handles one output element sequentially
// (not optimized for maximum performance, but correct).

// Per (batch, head) block: compute attention for a given head
// Each block processes all query positions for one head (across the entire sequence length).
// We'll use shared memory to store Q, K, V, and attention scores.
// Since embed_dim may be large, we need to dynamically allocate shared memory.

template <int BLOCK_SIZE>
__global__ void fused_attention_kernel(
    const float* __restrict__ x,        // [B, S, E]
    const float* __restrict__ y,        // [B, S, E]
    const float* __restrict__ in_proj_weight, // [3E, E]
    const float* __restrict__ in_proj_bias,   // [3E]
    const float* __restrict__ out_proj_weight,// [E, E]
    const float* __restrict__ out_proj_bias,  // [E]
    float* __restrict__ output,          // [B, S_rep, E]
    int B, int S_orig, int S_rep, int E, int H, int repeat_times,
    float scaling_factor
) {
    const int batch_idx = blockIdx.x;
    const int head_idx = blockIdx.y; // 0..H-1
    const int total_heads = H;
    const int head_dim = E / H; // assuming E divisible by H

    // Shared memory size: we need Q, K, V for this head, each of size S_rep * head_dim, plus attention scores S_rep*S_rep.
    // For simplicity, we use dynamic shared memory: one buffer for QKV and one for scores.
    extern __shared__ float shared_mem[];
    float* Q = shared_mem;                         // [S_rep, head_dim]
    float* K = Q + S_rep * head_dim;               // [S_rep, head_dim]
    float* V = K + S_rep * head_dim;               // [S_rep, head_dim]
    float* scores = V + S_rep * head_dim;          // [S_rep, S_rep] (transposed layout for reduction? We'll use for scores and weights)
    // We'll reuse scores for softmax and then for output accumulation as needed.

    const int tid = threadIdx.x;
    const int num_threads = blockDim.x;

    // ---- Step 1: Repeat interleave of x and y? Actually, the attention uses the repeated x and y.
    // We can either materialize repeated tensors or compute indices on the fly. Since repeat_interleave_times is small,
    // it's simpler to compute indices directly from original sequence indices.
    // For each repeated position r from 0 to S_rep-1, original index i = r / repeat_times.
    // We'll load data into shared memory for Q, K, V by computing original indices.

    // Compute Q from x (with in_proj_weight and bias for query part)
    // Q = x_rep @ W_q^T + b_q, where W_q is in_proj_weight[0:E, :], b_q is in_proj_bias[0:E]
    // Since we are processing one head, we need the slice for this head: columns head_idx*head_dim to (head_idx+1)*head_dim.
    // But the projection is done before splitting heads, so we need to compute full output of projection then take slice.
    // Alternatively, we can compute directly for this head: q = x_rep @ W_q_slice^T + b_q_slice,
    // where W_q_slice is [head_dim, E] (rows corresponding to this head's outputs).

    // To avoid materializing full projection, we can compute per head directly:
    // For each query position r and head dimension d, q[r][d] = sum_e x_rep[r][e] * in_proj_weight[head_idx*head_dim + d][e] + in_proj_bias[head_idx*head_dim + d]
    // This is a matrix-vector: each thread can compute one element of Q.

    // Similarly for K and V using y_rep and corresponding slices of in_proj_weight and bias.

    // Number of elements in Q per block: S_rep * head_dim. We'll parallelize over these elements.

    // We'll use a grid-stride loop within the block to compute Q, K, V elements.
    int total_q_elements = S_rep * head_dim;
    for (int idx = tid; idx < total_q_elements; idx += num_threads) {
        int r = idx / head_dim;
        int d = idx % head_dim;
        int orig_i = r / repeat_times; // original sequence index for query
        const float* x_row = x + ((batch_idx * S_orig + orig_i) * E);
        // compute q = sum_e x_row[e] * W_q[head_idx*head_dim + d][e] + b_q[head_idx*head_dim + d]
        float sum = in_proj_bias[head_idx * head_dim + d];
        for (int e = 0; e < E; ++e) {
            sum += x_row[e] * in_proj_weight[(head_idx * head_dim + d) * E + e];
        }
        Q[idx] = sum;
    }

    int total_kv_elements = S_rep * head_dim;
    for (int idx = tid; idx < total_kv_elements; idx += num_threads) {
        int r = idx / head_dim;
        int d = idx % head_dim;
        int orig_i = r / repeat_times; // for key/value, y is repeated same way
        const float* y_row = y + ((batch_idx * S_orig + orig_i) * E);
        // K: offset E + head_idx*head_dim + d
        float sum_k = in_proj_bias[E + head_idx * head_dim + d];
        for (int e = 0; e < E; ++e) {
            sum_k += y_row[e] * in_proj_weight[(E + head_idx * head_dim + d) * E + e];
        }
        K[idx] = sum_k;
        // V: offset 2E + head_idx*head_dim + d
        float sum_v = in_proj_bias[2*E + head_idx * head_dim + d];
        for (int e = 0; e < E; ++e) {
            sum_v += y_row[e] * in_proj_weight[(2*E + head_idx * head_dim + d) * E + e];
        }
        V[idx] = sum_v;
    }

    __syncthreads(); // ensure Q, K, V are ready

    // ---- Step 2: Compute attention scores and softmax, then output for this head.
    // For each query position r, compute scores with all keys, apply softmax, then weighted sum of values.
    // We'll parallelize over query positions (S_rep) and possibly output dimensions (head_dim).
    // For simplicity, each thread computes one output element for a single query.
    // That means total output elements per head = S_rep * head_dim. We can assign threads to these elements.
    // But we need to compute the full softmax for each query. We can have each thread compute the entire softmax for that query,
    // but that would be redundant across threads for the same query. Better to use shared memory for scores and compute softmax per query once,
    // possibly with reduction. Since S_rep is moderate (50*2=100), we can afford one thread per query to compute softmax, then other threads
    // use the precomputed weights to compute output. But we need synchronization.

    // Approach: 
    // 1. Compute scores matrix (S_rep x S_rep) in shared memory 'scores'.
    // 2. For each query r, compute max and sum exp for softmax, maybe using parallel reduction.
    // 3. Compute softmax weights and store in scores (overwrite).
    // 4. Compute output projection for each output element.

    // To simplify and ensure correctness, we'll use a single thread per query for softmax, but that might be slow if S_rep is large.
    // Given S_rep=100, it's fine. We'll have 256 threads block, so we can assign multiple queries to threads.
    // We'll organize as: first, compute scores with all threads (each thread computes a subset of scores), then softmax per query using one thread per query,
    // then output projection with all threads.

    // Compute scores: for each pair (r_query, r_key), dot product Q[r_query] dot K[r_key] / sqrt(head_dim).
    int total_scores = S_rep * S_rep;
    for (int idx = tid; idx < total_scores; idx += num_threads) {
        int rq = idx / S_rep;
        int rk = idx % S_rep;
        float dot = 0.0f;
        for (int d = 0; d < head_dim; ++d) {
            dot += Q[rq * head_dim + d] * K[rk * head_dim + d];
        }
        scores[idx] = dot / sqrtf((float)head_dim);
    }
    __syncthreads();

    // Softmax per query row: use one thread per row (or maybe a few threads to parallelize).
    // We'll use num_threads to parallelize across rows, each thread does full row softmax.
    // Since S_rep may be up to maybe a few hundred, this is fine.
    if (tid < S_rep) {
        int r = tid;
        float* row = &scores[r * S_rep];
        float max_val = row[0];
        for (int j = 1; j < S_rep; ++j) {
            max_val = fmaxf(max_val, row[j]);
        }
        float sum = 0.0f;
        for (int j = 0; j < S_rep; ++j) {
            row[j] = expf(row[j] - max_val);
            sum += row[j];
        }
        for (int j = 0; j < S_rep; ++j) {
            row[j] /= sum;
        }
    }
    __syncthreads();

    // Now scores stores softmax weights.
    // Compute output for this head: out[r][d] = sum_k softmax[r][k] * V[k][d]
    // Then apply output projection and tanh scaling.
    // We need to write to output tensor, but output projection is over full E, so it's not per-head independent.
    // We can compute the head output (concatenated across heads) and then project, or we can accumulate into output after projection.
    // Since output projection mixes all heads, we cannot write per head independently without synchronization across heads.
    // Instead, we can compute the full attention output (before output projection) by concatenating heads, then apply output projection.
    // That requires storing the concatenated result in global memory or shared memory. Since blocks are per (batch, head), we need to combine across heads.
    // One way: each block computes its head's output and writes to a temporary global buffer of shape [B, H, S_rep, head_dim], then a second kernel applies output projection.
    // Alternatively, we can fuse the output projection within the same kernel by using atomics or by having a single block per batch that processes all heads sequentially.
    // But that would reduce parallelism. Given the constraints, we can do two kernels: one to compute concatenated heads, and one to apply output projection + tanh scaling.
    // However, the task asks for a fused kernel covering all operations. But for correctness, we can implement a fused kernel with two phases separated by grid synchronization? Not directly possible.
    // We can use cooperative groups or just launch two kernels from launcher. Since we are to write a single .cu file with launcher, we can have two kernel launches: one for attention, one for output projection.
    // But we can also do output projection inside each block if we have all heads' outputs available, which is not the case.
    // To keep it simple and correct, we'll implement two kernels: first kernel computes the full attention output (concatenated heads) into a temporary buffer, second kernel applies output projection and tanh scaling into final output.
    // The launcher will allocate temporary buffer and launch both kernels.
    // But we can also fuse into a single kernel by using grid sync: after all heads compute their contributions to the temporary buffer, we need all threads to see the full concatenated output before projecting.
    // That requires grid sync. We could use cooperative groups but that's more complex. Simpler: two kernels.

    // Given the instruction says "实现完整、可编译的 CUDA kernel 和 host launcher，覆盖 model_new.py 的所有调用路径",
    // it's acceptable to have multiple kernels as long as the launcher executes them.

    // So we'll design two kernels:
    // Kernel 1: compute attention output before projection, store in tmp_attn buffer of shape [B, S_rep, E] (where E = H*head_dim).
    // Kernel 2: apply output projection and tanh scaling: out = tanh(tmp_attn @ out_proj_weight^T + out_proj_bias) * scaling_factor? Wait, in model.py, scaling_factor is applied inside tan: torch.tan(attn_output * scaling_factor). So we need tanh(attn_output * scaling_factor) after output projection.

    // But in model_new.py, they pass scaling_factor to the kernel, and the output is attn_output = cuda_extension.fused_attention_forward(...). This should compute the same as original: repeat interleave, multihead attention, then tan(attn_output * scaling_factor). So the final operation is tanh (torch.tan) of (projected output * scaling_factor).

    // So we need two kernels: attention (produce pre-projection output), and projection+tan.
    // The first kernel will write to a temporary buffer, the second kernel reads it and writes final output.

    // In this file, we'll implement both kernels and the launcher will allocate temporary memory and launch them sequentially.

    // For now, we are inside kernel1 logic, but we'll move to separate kernels.
}

// Actually, we'll restructure: we'll implement two separate __global__ functions and a launcher that calls both.

// Kernel 1: compute multi-head attention output (before output projection) into attn_pre_proj [B, S_rep, E].
// Each block handles one (batch, head) pair, computes the head's output and writes it to the corresponding slice of attn_pre_proj.
__global__ void attention_kernel(
    const float* __restrict__ x,
    const float* __restrict__ y,
    const float* __restrict__ in_proj_weight,
    const float* __restrict__ in_proj_bias,
    float* __restrict__ attn_pre_proj, // [B, S_rep, E]
    int B, int S_orig, int S_rep, int E, int H, int repeat_times
) {
    const int batch_idx = blockIdx.x;
    const int head_idx = blockIdx.y;
    const int head_dim = E / H;
    const int tid = threadIdx.x;
    const int num_threads = blockDim.x;

    // Shared memory for Q,K,V and scores
    extern __shared__ float smem[];
    float* Q = smem; // [S_rep, head_dim]
    float* K = Q + S_rep * head_dim;
    float* V = K + S_rep * head_dim;
    float* scores = V + S_rep * head_dim; // [S_rep, S_rep]

    // Load Q, K, V into shared memory
    int total_q = S_rep * head_dim;
    for (int idx = tid; idx < total_q; idx += num_threads) {
        int r = idx / head_dim;
        int d = idx % head_dim;
        int orig_i = r / repeat_times;
        const float* x_row = x + (batch_idx * S_orig + orig_i) * E;
        float sum = in_proj_bias[head_idx * head_dim + d];
        for (int e = 0; e < E; ++e) {
            sum += x_row[e] * in_proj_weight[(head_idx * head_dim + d) * E + e];
        }
        Q[idx] = sum;
    }

    int total_kv = S_rep * head_dim;
    for (int idx = tid; idx < total_kv; idx += num_threads) {
        int r = idx / head_dim;
        int d = idx % head_dim;
        int orig_i = r / repeat_times;
        const float* y_row = y + (batch_idx * S_orig + orig_i) * E;
        // K
        float sum_k = in_proj_bias[E + head_idx * head_dim + d];
        for (int e = 0; e < E; ++e) {
            sum_k += y_row[e] * in_proj_weight[(E + head_idx * head_dim + d) * E + e];
        }
        K[idx] = sum_k;
        // V
        float sum_v = in_proj_bias[2*E + head_idx * head_dim + d];
        for (int e = 0; e < E; ++e) {
            sum_v += y_row[e] * in_proj_weight[(2*E + head_idx * head_dim + d) * E + e];
        }
        V[idx] = sum_v;
    }
    __syncthreads();

    // Compute attention scores
    int total_scores = S_rep * S_rep;
    for (int idx = tid; idx < total_scores; idx += num_threads) {
        int rq = idx / S_rep;
        int rk = idx % S_rep;
        float dot = 0.0f;
        for (int d = 0; d < head_dim; ++d) {
            dot += Q[rq * head_dim + d] * K[rk * head_dim + d];
        }
        scores[idx] = dot / sqrtf((float)head_dim);
    }
    __syncthreads();

    // Softmax per row: use one thread per row if S_rep <= num_threads, else grid-stride over rows.
    for (int r = tid; r < S_rep; r += num_threads) {
        float* row = &scores[r * S_rep];
        float max_val = row[0];
        for (int j = 1; j < S_rep; ++j) {
            max_val = fmaxf(max_val, row[j]);
        }
        float sum = 0.0f;
        for (int j = 0; j < S_rep; ++j) {
            row[j] = expf(row[j] - max_val);
            sum += row[j];
        }
        for (int j = 0; j < S_rep; ++j) {
            row[j] /= sum;
        }
    }
    __syncthreads();

    // Compute output for this head and write to attn_pre_proj at [batch_idx, r, head_idx*head_dim + d]
    int total_out = S_rep * head_dim;
    for (int idx = tid; idx < total_out; idx += num_threads) {
        int r = idx / head_dim;
        int d = idx % head_dim;
        float sum = 0.0f;
        for (int k = 0; k < S_rep; ++k) {
            sum += scores[r * S_rep + k] * V[k * head_dim + d];
        }
        int global_idx = (batch_idx * S_rep + r) * E + head_idx * head_dim + d;
        attn_pre_proj[global_idx] = sum;
    }
}

// Kernel 2: apply output projection and tan(scaling_factor * projected)
__global__ void output_proj_tan_kernel(
    const float* __restrict__ attn_pre_proj, // [B, S_rep, E]
    const float* __restrict__ out_proj_weight, // [E, E]
    const float* __restrict__ out_proj_bias,   // [E]
    float* __restrict__ output,                // [B, S_rep, E]
    int B, int S_rep, int E,
    float scaling_factor
) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int total = B * S_rep * E;
    if (idx >= total) return;

    int b = idx / (S_rep * E);
    int rem = idx % (S_rep * E);
    int s = rem / E;
    int e = rem % E;

    const float* in_row = attn_pre_proj + (b * S_rep + s) * E;
    float sum = out_proj_bias[e];
    for (int j = 0; j < E; ++j) {
        sum += in_row[j] * out_proj_weight[e * E + j]; // note: out_proj_weight is [E, E], transposed use as weight^T
    }
    output[idx] = tanf(sum * scaling_factor);
}

// Host launcher: allocates temporary buffer, launches both kernels, frees buffer.
extern "C" void fused_attention_forward_launcher(
    const float* x, const float* y,
    const float* in_proj_weight, const float* in_proj_bias,
    const float* out_proj_weight, const float* out_proj_bias,
    float* output,
    int B, int S_orig, int repeat_times,
    int E, int H,
    float scaling_factor,
    cudaStream_t stream
) {
    int S_rep = S_orig * repeat_times;
    int head_dim = E / H;

    // Validate dimensions
    if (E % H != 0) {
        printf("Error: embed_dim must be divisible by num_heads\n");
        return;
    }

    // Allocate temporary buffer for pre-projection attention output
    int attn_pre_proj_size = B * S_rep * E * sizeof(float);
    float* attn_pre_proj;
    CUDA_CHECK(cudaMalloc(&attn_pre_proj, attn_pre_proj_size));

    // Configure kernel launches
    dim3 grid1(B, H); // one block per (batch, head)
    int block_size = 256;
    int smem_size = (S_rep * head_dim * 3 + S_rep * S_rep) * sizeof(float);
    if (smem_size > 48 * 1024) {
        // If too large, reduce block size or handle differently. For now, assume fits.
        printf("Warning: shared memory size %d may exceed limit\n", smem_size);
    }

    attention_kernel<<<grid1, block_size, smem_size, stream>>>(
        x, y, in_proj_weight, in_proj_bias,
        attn_pre_proj,
        B, S_orig, S_rep, E, H, repeat_times
    );

    // Launch output projection kernel
    int total_out = B * S_rep * E;
    int block_size2 = 256;
    int grid2 = (total_out + block_size2 - 1) / block_size2;
    output_proj_tan_kernel<<<grid2, block_size2, 0, stream>>>(
        attn_pre_proj, out_proj_weight, out_proj_bias, output,
        B, S_rep, E, scaling_factor
    );

    // Free temporary buffer after kernel completion (we can use stream callback or just free after sync)
    // Since we don't want to synchronize, we can use cudaFree after launching, but need to ensure kernel finished.
    // We can use cudaFreeAsync if available, but to be safe, we can synchronize the stream before freeing.
    // Alternatively, we can rely on CUDA's default stream ordering: cudaFree after kernel launches on same stream may be safe?
    // Typically, cudaFree may block until all kernels complete. It's fine.
    CUDA_CHECK(cudaFree(attn_pre_proj));

    // Optionally check for kernel errors asynchronously
    CUDA_CHECK(cudaGetLastError());
}

