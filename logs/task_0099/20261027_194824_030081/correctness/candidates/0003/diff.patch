 #include <cuda_runtime.h>
+
+// Custom round half to even for float
+device__ inline float round_half_to_even(float x) {
+    float t = truncf(x);
+    float diff = x - t;
+    if (diff > 0.5f) return t + 1.0f;
+    if (diff < 0.5f) return t;
+    // diff == 0.5f: round to even integer
+    float t_rounded = roundf(t);
+    if (fmodf(t_rounded, 2.0f) == 0.0f) {
+        return t_rounded;
+    } else {
+        return t_rounded + 1.0f;
+    }
+}
 
