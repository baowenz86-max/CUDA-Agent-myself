        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, embedding_dim, height]"
      },
      "semantics": [
        "Returns a view with swapped dimensions dim0 and dim1; no data movement",
        "Maintains the same underlying storage, output stride is computed accordingly",
        "Equivalent to torch.Tensor.transpose(dim0, dim1)"
