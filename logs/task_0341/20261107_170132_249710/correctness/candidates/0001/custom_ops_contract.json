        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, channels, output_length]"
      },
      "semantics": [
        "Performs 1D average pooling over last dimension",
        "output_length = floor((length + 2*padding - kernel_size) / stride) + 1",
        "For each output position, averages values within kernel window",
        "If count_include_pad is true (default), includes padding zeros in average; here padding=0",
        "Matches nn.AvgPool1d with kernel_size, stride, padding (no dilation, ceil_mode=False)"
      ]
    }
  ],
