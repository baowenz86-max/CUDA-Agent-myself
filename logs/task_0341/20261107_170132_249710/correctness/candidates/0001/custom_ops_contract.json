        "No padding_idx, max_norm, or scale_grad_by_freq; exactly nn.Embedding forward",
        "Output layout is contiguous with shape [batch_size, height, embedding_dim]"
      ]
    },
    {
      "name": "transpose_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, height, embedding_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
