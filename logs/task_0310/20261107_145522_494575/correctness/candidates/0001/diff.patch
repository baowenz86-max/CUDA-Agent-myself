+++ after/kernels/custom_ops.cu
@@ -0,0 +1,136 @@
+#include <cuda_runtime.h>
+#include <math.h>
+
+// SELU constants
+#define SELU_SCALE 1.0507009873554804934193349852946
+#define SELU_ALPHA 1.6732632423543772848170429916717
+
+// InstanceNorm kernel: one block per (n,c), threads reduce over H*W
+// x: input tensor with strides sN, sC, sH, sW (elements, not bytes)
+// weight, bias: per-channel affine parameters length C
+// output: same shape as input, with same strides
+__global__ void instance_norm_kernel(
+    const float* __restrict__ x,
+    const float* __restrict__ weight,
+    const float* __restrict__ bias,
+    float* __restrict__ out,
+    int N, int C, int H, int W,
+    long long sN, long long sC, long long sH, long long sW,
+    float eps)
+{
+    int nc = blockIdx.x;
+    int total = N * C;
+    if (nc >= total) return;
+
+    int n = nc / C;
+    int c = nc - n * C;
+
+    const float* x_base = x + (long long)n * sN + (long long)c * sC;
+    float* out_base = out + (long long)n * sN + (long long)c * sC;
+    int HW = H * W;
+
+    // Compute mean and variance using shared memory reduction within block
+    extern __shared__ float smem[];
+    float* s_mean = smem;
+    float* s_var = smem + blockDim.x;
+
+    float local_sum = 0.0f;
+    float local_sq_sum = 0.0f;
+    for (int idx = threadIdx.x; idx < HW; idx += blockDim.x) {
+        int h = idx / W;
+        int w = idx - h * W;
+        float val = x_base[(long long)h * sH + (long long)w * sW];
+        local_sum += val;
+        local_sq_sum += val * val;
+    }
+
+    // Warp reduce
+    for (int offset = 16; offset > 0; offset >>= 1) {
+        local_sum += __shfl_down_sync(0xffffffff, local_sum, offset);
+        local_sq_sum += __shfl_down_sync(0xffffffff, local_sq_sum, offset);
+    }
+
+    if ((threadIdx.x & 31) == 0) {
+        s_mean[threadIdx.x >> 5] = local_sum;
+        s_var[threadIdx.x >> 5] = local_sq_sum;
+    }
+    __syncthreads();
+
+    // Now reduce partials from warps (only first few threads)
+    int num_warps = blockDim.x / 32;
+    if (threadIdx.x < num_warps) {
+        local_sum = s_mean[threadIdx.x];
+        local_sq_sum = s_var[threadIdx.x];
+        for (int offset = num_warps / 2; offset > 0; offset >>= 1) {
+            if (threadIdx.x < offset && threadIdx.x + offset < num_warps) {
+                local_sum += s_mean[threadIdx.x + offset];
+                local_sq_sum += s_var[threadIdx.x + offset];
+                s_mean[threadIdx.x] = local_sum;
+                s_var[threadIdx.x] = local_sq_sum;
+            }
+            __syncthreads();
+        }
+    }
+    __syncthreads();
+
+    float mean = s_mean[0] / HW;
+    float var = s_var[0] / HW - mean * mean;
+    float inv_std = rsqrtf(var + eps);
+    float w = weight[c];
+    float b = bias[c];
+
+    // Normalize and apply affine
+    for (int idx = threadIdx.x; idx < HW; idx += blockDim.x) {
+        int h = idx / W;
+        int w = idx - h * W;
+        float val = x_base[(long long)h * sH + (long long)w * sW];
+        out_base[(long long)h * sH + (long long)w * sW] = (val - mean) * inv_std * w + b;
+    }
+}
+
+// SELU kernel: one element per thread, grid-stride
+__global__ void selu_kernel(const float* __restrict__ x, float* __restrict__ y, long long numel)
+{
+    long long idx = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (; idx < numel; idx += stride) {
+        float val = x[idx];
+        y[idx] = val > 0.0f ? SELU_SCALE * val : SELU_SCALE * SELU_ALPHA * (expf(val) - 1.0f);
+    }
+}
+
+// Launcher for instance_norm_forward
+// Input tensors must be float32 on CUDA with strides provided. Handles contiguous or NHWC (strided) via strides.
+extern "C" void instance_norm_forward_cuda_launcher(
+    const float* x,
+    const float* weight,
+    const float* bias,
+    float* out,
+    int N, int C, int H, int W,
+    long long sN, long long sC, long long sH, long long sW,
+    float eps,
+    cudaStream_t stream)
+{
+    if (N <= 0 || C <= 0 || H <= 0 || W <= 0) return;
+    int total = N * C;
+    int threads = 256;
+    int blocks = total; // one block per (n,c)
+    size_t smem_size = 2 * threads * sizeof(float);
+
+    instance_norm_kernel<<<blocks, threads, smem_size, stream>>>(
+        x, weight, bias, out, N, C, H, W, sN, sC, sH, sW, eps);
+}
+
+// Launcher for selu_forward
+extern "C" void selu_forward_cuda_launcher(
+    const float* x,
+    float* y,
+    long long numel,
+    cudaStream_t stream)
+{
+    if (numel <= 0) return;
+    int threads = 256;
+    int blocks = (int)((numel + threads - 1) / threads);
+    if (blocks > 65535) blocks = 65535; // grid-stride loop handles larger
+    selu_kernel<<<blocks, threads, 0, stream>>>(x, y, numel);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,107 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void instance_norm_forward_cuda_launcher(
+    const float* x,
+    const float* weight,
+    const float* bias,
+    float* out,
+    int N, int C, int H, int W,
+    long long sN, long long sC, long long sH, long long sW,
+    float eps,
+    cudaStream_t stream);
+
+extern "C" void selu_forward_cuda_launcher(
+    const float* x,
+    float* y,
+    long long numel,
+    cudaStream_t stream);
+
+torch::Tensor instance_norm_forward(
+    torch::Tensor x,
+    torch::Tensor weight,
+    torch::Tensor bias,
+    double eps) {
+    // Input validation
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(weight.is_cuda(), "weight must be a CUDA tensor");
+    TORCH_CHECK(bias.is_cuda(), "bias must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(weight.dtype() == torch::kFloat32, "weight must be float32");
+    TORCH_CHECK(bias.dtype() == torch::kFloat32, "bias must be float32");
+    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
+    TORCH_CHECK(weight.is_contiguous(), "weight must be contiguous");
+    TORCH_CHECK(bias.is_contiguous(), "bias must be contiguous");
+
+    // Ensure 4D input [N, C, H, W]
+    TORCH_CHECK(x.dim() == 4, "x must be 4D (N, C, H, W)");
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+    TORCH_CHECK(N > 0 && C > 0 && H > 0 && W > 0, "dimensions must be positive");
+    TORCH_CHECK(weight.numel() == C, "weight must have C elements");
+    TORCH_CHECK(bias.numel() == C, "bias must have C elements");
+
+    // Allocate output tensor with same shape as x
+    auto out = torch::empty_like(x);
+
+    // Get strides for x (contiguous, but still compute)
+    long long sN = x.stride(0);
+    long long sC = x.stride(1);
+    long long sH = x.stride(2);
+    long long sW = x.stride(3);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    instance_norm_forward_cuda_launcher(
+        x.data_ptr<float>(),
+        weight.data_ptr<float>(),
+        bias.data_ptr<float>(),
+        out.data_ptr<float>(),
+        N, C, H, W,
+        sN, sC, sH, sW,
+        static_cast<float>(eps),
+        stream
+    );
+
+    return out;
+}
+
+torch::Tensor selu_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
+
+    auto out = torch::empty_like(x);
+    long long numel = x.numel();
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    selu_forward_cuda_launcher(
+        x.data_ptr<float>(),
+        out.data_ptr<float>(),
+        numel,
+        stream
+    );
+
+    return out;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("instance_norm_forward", &instance_norm_forward,
+          "InstanceNorm forward",
+          pybind11::arg("x"),
+          pybind11::arg("weight"),
+          pybind11::arg("bias"),
+          pybind11::arg("eps"));
+    m.def("selu_forward", &selu_forward,
+          "SELU forward",
+          pybind11::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,35 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, num_features, eps=1e-5, momentum=0.1, affine=True):
+        super().__init__()
+        # 参数命名与参考模型保持一致：instance_norm.weight / instance_norm.bias
+        self.instance_norm = nn.Module()
+        self.instance_norm.weight = nn.Parameter(torch.ones(num_features))
+        self.instance_norm.bias = nn.Parameter(torch.zeros(num_features))
+        self.eps = eps
+        self.momentum = momentum
+        self.affine = affine
+
+    def forward(self, x):
+        # 第一步：InstanceNorm2d(affine=True, track_running_stats=False)
+        # 参考调用：self.instance_norm(x)，内部使用当前 weight 和 bias
+        x = cuda_extension.instance_norm_forward(
+            x, self.instance_norm.weight, self.instance_norm.bias, self.eps
+        )
+        # 第二步：SELU 激活函数
+        x = cuda_extension.selu_forward(x)
+        return x
+
+    def debug_forward(self, x):
+        # 按检查点顺序 yield (checkpoint_id, value)
+        x = cuda_extension.instance_norm_forward(
+            x, self.instance_norm.weight, self.instance_norm.bias, self.eps
+        )
+        yield 'step_001', x
+        x = cuda_extension.selu_forward(x)
+        yield 'step_002', x
+        yield 'step_003', x
