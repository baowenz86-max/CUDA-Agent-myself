--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,94 @@
+#include <cuda_runtime.h>
+
+// Sum reduction over arbitrary-strided float32 tensor, output scalar.
+// The launcher signature is designed for binding to call.
+
+#define BLOCK_SIZE 256
+
+__global__ void sum_reduce_kernel(const float* __restrict__ input,
+                                  const int64_t* __restrict__ dims,
+                                  const int64_t* __restrict__ strides,
+                                  int64_t ndim,
+                                  int64_t numel,
+                                  float* __restrict__ partial_sums) {
+    extern __shared__ float sdata[];
+    int tid = threadIdx.x;
+    int64_t idx = blockIdx.x * blockDim.x + tid;
+    float local_sum = 0.0f;
+    
+    // grid-stride loop for large numel, but each block sums a contiguous chunk of linear indices
+    while (idx < numel) {
+        // compute the multi-dimensional offset from linear index idx
+        int64_t offset = 0;
+        int64_t remaining = idx;
+        for (int d = 0; d < ndim; ++d) {
+            int64_t dim_size = dims[d];
+            if (dim_size > 1) {
+                int64_t coord = remaining % dim_size;
+                offset += coord * strides[d];
+                remaining /= dim_size;
+            } else {
+                // skip dimension of size 1
+                offset += 0;
+            }
+        }
+        local_sum += input[offset];
+        idx += gridDim.x * blockDim.x;
+    }
+
+    // block-level reduction
+    sdata[tid] = local_sum;
+    __syncthreads();
+
+    for (int s = blockDim.x / 2; s > 0; s >>= 1) {
+        if (tid < s) {
+            sdata[tid] += sdata[tid + s];
+        }
+        __syncthreads();
+    }
+
+    if (tid == 0) {
+        atomicAdd(partial_sums, sdata[0]);
+    }
+}
+
+extern "C" void sum_launcher(const float* input,
+                             const int64_t* dims,
+                             const int64_t* strides,
+                             int64_t ndim,
+                             int64_t numel,
+                             float* output,
+                             cudaStream_t stream) {
+    if (numel <= 0) {
+        // zero elements -> sum = 0
+        cudaMemsetAsync(output, 0, sizeof(float), stream);
+        return;
+    }
+
+    // Allocate temporary partial sums buffer (1 float)
+    float* d_partial = nullptr;
+    cudaMalloc(&d_partial, sizeof(float));
+    cudaMemsetAsync(d_partial, 0, sizeof(float), stream);
+
+    int blocks = (numel + BLOCK_SIZE - 1) / BLOCK_SIZE;
+    // Cap blocks to avoid excessive launch overhead? but grid-stride handles.
+    // We can set blocks to min(blocks, some max like 1024) but for large numel use grid-stride with enough blocks.
+    // Actually we use gridDim.x * blockDim.x in stride, so need to set blocks appropriately.
+    // For simplicity, use as many blocks as needed up to a reasonable max (e.g., 32k).
+    // but if numel is huge, we want enough parallelism. We'll use min(blocks, 1024) to keep grid size reasonable;
+    // grid-stride loop will cover all elements.
+    int max_blocks = 1024;
+    blocks = min(blocks, max_blocks);
+
+    dim3 grid(blocks);
+    dim3 block(BLOCK_SIZE);
+    int shared_mem_size = BLOCK_SIZE * sizeof(float);
+
+    sum_reduce_kernel<<<grid, block, shared_mem_size, stream>>>(
+        input, dims, strides, ndim, numel, d_partial);
+
+    // Copy partial sum to output (single value); output assumed allocated
+    cudaMemcpyAsync(output, d_partial, sizeof(float), cudaMemcpyDeviceToDevice, stream);
+
+    cudaFree(d_partial);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,100 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launcher from custom_ops.cu
+extern "C" void sum_launcher(const float* input,
+                             const int64_t* dims,
+                             const int64_t* strides,
+                             int64_t ndim,
+                             int64_t numel,
+                             float* output,
+                             cudaStream_t stream);
+
+// PyTorch wrapper for split: returns tuple of tensors (views)
+py::tuple split_forward(torch::Tensor x, int64_t split_size, int64_t axis) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(split_size > 0, "split_size must be positive");
+
+    // Use torch.split to create views; this does not perform computation.
+    auto splits = x.split(split_size, axis);
+
+    // Convert std::vector<torch::Tensor> to py::tuple
+    py::tuple result(splits.size());
+    for (size_t i = 0; i < splits.size(); ++i) {
+        result[i] = splits[i];
+    }
+    return result;
+}
+
+// PyTorch wrapper for sum: returns scalar tensor
+torch::Tensor sum_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+
+    // Allocate output scalar tensor on same device
+    auto output = torch::empty({}, x.options());
+
+    // If tensor is empty, return zero
+    if (x.numel() == 0) {
+        output.zero_();
+        return output;
+    }
+
+    // Gather dims and strides as int64_t arrays on CPU
+    int64_t ndim = x.dim();
+    std::vector<int64_t> dims(ndim);
+    std::vector<int64_t> strides(ndim);
+    for (int64_t i = 0; i < ndim; ++i) {
+        dims[i] = x.size(i);
+        strides[i] = x.stride(i);
+    }
+
+    // Copy dims and strides to GPU memory (launcher expects device pointers)
+    // We can allocate temporary device buffers using torch::empty and copy from CPU,
+    // or use cudaMalloc/cudaMemcpy. Since we must avoid torch ops for computation,
+    // using cudaMalloc is fine (memory allocation is allowed).
+    int64_t* d_dims = nullptr;
+    int64_t* d_strides = nullptr;
+    cudaMalloc(&d_dims, ndim * sizeof(int64_t));
+    cudaMalloc(&d_strides, ndim * sizeof(int64_t));
+    cudaMemcpy(d_dims, dims.data(), ndim * sizeof(int64_t), cudaMemcpyHostToDevice);
+    cudaMemcpy(d_strides, strides.data(), ndim * sizeof(int64_t), cudaMemcpyHostToDevice);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    sum_launcher(
+        x.data_ptr<float>(),
+        d_dims,
+        d_strides,
+        ndim,
+        x.numel(),
+        output.data_ptr<float>(),
+        stream
+    );
+
+    // Free temporary device buffers (asynchronously, but launcher uses them before completion)
+    cudaFree(d_dims);
+    cudaFree(d_strides);
+
+    // Synchronize? Not necessary; launcher copies output async within same stream.
+    // Check for kernel errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+void register_custom_ops(py::module& m) {
+    m.def("split", &split_forward, "Split tensor along axis (views)",
+          py::arg("x"), py::arg("split_size"), py::arg("axis"));
+    m.def("sum", &sum_forward, "Sum all elements",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
