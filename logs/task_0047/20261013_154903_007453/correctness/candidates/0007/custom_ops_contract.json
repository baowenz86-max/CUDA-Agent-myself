  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.linear(input)",
      "semantics": [
        "linear transformation with bias: x = input @ linear.weight.T + linear.bias",
        "output shape [batch_size, out_features]"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "kldiv_loss = nn.KLDivLoss(reduction='batchmean')(F.log_softmax(x, dim=1), F.softmax(target, dim=1))",
      "semantics": [
        "log_softmax of x over dim=1",
        "softmax of target over dim=1",
        "KLDivLoss with reduction='batchmean'; scalar output"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "l1_loss = sum((F.l1_loss(x[:, i], self.params[i].expand_as(x[:, i])) for i in range(len(self.params))))",
      "semantics": [
        "for each i in 0..num_params-1, compute mean absolute difference between x[:, i] and params[i] broadcast to that column",
        "sum the scalar losses; result is a scalar tensor"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return (kldiv_loss, l1_loss)",
      "semantics": [
        "return tuple containing two scalar tensors (kldiv_loss, l1_loss)"
      ]
    }
  ]
