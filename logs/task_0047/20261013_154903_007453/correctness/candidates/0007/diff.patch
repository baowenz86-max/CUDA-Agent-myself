+    m.def("kl_div_loss_forward", &kl_div_loss_forward,
+          "KL divergence loss with batchmean reduction",
+          pybind11::arg("input"), pybind11::arg("target"));
+    m.def("l1_loss_forward", &l1_loss_forward,
+          "L1 loss (mean absolute difference)",
+          pybind11::arg("input"), pybind11::arg("target"));
+}
