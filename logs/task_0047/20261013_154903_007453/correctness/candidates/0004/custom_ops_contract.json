{
  "operators": [
    {
      "name": "linear_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, in_features]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_features, in_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_features]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, out_features]"
      },
      "semantics": [
        "对应参考语句 x = self.linear(input) / x = input @ weight.T + bias",
        "matmul 使用 cuBLAS，权重转置后乘",
        "bias 可为 None，为 None 时不加 bias",
        "输入支持 strides，但实现会按需连续化",
        "输出新张量 shape [batch_size, out_features]"
      ]
    },
    {
      "name": "log_softmax",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, num_classes]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "nullable": false,
          "optional": false,
          "default": 1
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, num_classes]"
      },
      "semantics": [
        "对应参考语句 F.log_softmax(x, dim=1)",
        "沿 dim=1 计算 log_softmax，保持 shape 不变",
        "实现使用稳定数值：减去行最大值",
        "输出 dtype/device 与输入相同"
      ]
    },
    {
      "name": "softmax",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, num_classes]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "nullable": false,
          "optional": false,
          "default": 1
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, num_classes]"
      },
      "semantics": [
        "对应参考语句 F.softmax(target, dim=1)",
        "沿 dim=1 计算 softmax，保持 shape 不变",
        "实现使用稳定数值：减去行最大值",
        "输出 dtype/device 与输入相同"
      ]
    },
    {
      "name": "kl_div_batchmean",
      "parameters": [
        {
          "name": "log_probs",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, num_classes]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "target_probs",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, num_classes]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[]"
      },
      "semantics": [
        "对应参考语句 nn.KLDivLoss(reduction='batchmean')(log_probs, target_probs)",
        "计算逐元素 target * (log(target) - log_probs)，其中 target 已为概率且 softmax 后非负",
        "reduction='batchmean'：所有元素求和后除以 batch_size（注意 PyTorch 行为，尽管文档有误）",
        "先按行求和再求和，输出标量张量"
      ]
    },
    {
      "name": "l1_loss_sum_params",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, num_params]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "params",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[num_params]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[]"
      },
      "semantics": [
        "对应参考语句 sum(F.l1_loss(x[:, i], self.params[i].expand_as(x[:, i])) for i in range(len(self.params)))",
        "对每列 i，计算 mean(|x[:,i] - params[i]|)（默认 reduction='mean'）",
        "将所有 num_params 列的 L1 loss 求和得到标量",
        "params 是每个标量参数的向量，按列索引对应",
        "输出标量张量"
      ]
    },
    {
      "name": "get_params_vector",
      "parameters": [],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[num_params]"
      },
      "semantics": [
        "将 ParameterList 中的 num_params 个标量参数拼接成向量",
        "用于后续自定义 op l1_loss_sum_params",
        "在 __init__ 中创建并维护与 params 参数共享存储的视图"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.linear(input)",
      "semantics": [
        "x = input @ weight.T + bias，权重形状 [200,768]，输入形状 [128,768]",
        "输出 shape [128,200]，dtype float32，cuda",
        "bias 非 None 且形状 [200]"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "kldiv_loss = nn.KLDivLoss(reduction='batchmean')(F.log_softmax(x, dim=1), F.softmax(target, dim=1))",
      "semantics": [
        "先对 x 沿 dim=1 计算 log_softmax",
        "再对 target 沿 dim=1 计算 softmax",
        "然后 KLDivLoss batchmean：对每个元素 target * (log(target) - log_softmax(x))，求和后除以 batch_size",
        "输出标量张量 shape []"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "l1_loss = sum((F.l1_loss(x[:, i], self.params[i].expand_as(x[:, i])) for i in range(len(self.params))))",
      "semantics": [
        "对每个 i=0..num_params-1，取 x 的列 i 形状 [batch_size] 与标量参数 params[i] 广播成 [batch_size]",
        "计算 F.l1_loss 默认 reduction='mean'，即平均绝对误差",
        "对所有列求和得到标量"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return (kldiv_loss, l1_loss)",
      "semantics": [
        "返回包含两个标量张量的元组 (kldiv_loss, l1_loss)"
      ]
    }
  ]
}