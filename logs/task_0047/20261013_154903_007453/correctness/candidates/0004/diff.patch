+    dim3 block(32, 32);
+    dim3 grid((out_features + 31) / 32, (batch_size + 31) / 32);
+    linear_kernel<<<grid, block, 0, stream>>>(input, weight, bias, output,
+                                              batch_size, in_features, out_features, has_bias);
+    CUDA_CHECK(cudaGetLastError());
+}
