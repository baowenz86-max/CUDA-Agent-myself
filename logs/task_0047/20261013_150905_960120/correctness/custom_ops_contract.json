{
  "operators": [
    {
      "name": "linear_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, in_features]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_features, in_features]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_features]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, out_features]"
      },
      "semantics": [
        "对应参考语句 x = self.linear(input)。",
        "使用 cuDNN GEMM 计算 output = input @ weight.T + bias。",
        "当 bias 为 None 时只计算矩阵乘法；本任务中 bias 始终存在。",
        "输出 shape 与参考 checkpoint step_001 一致，为 [128, 200]。"
      ]
    },
    {
      "name": "log_softmax_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, num_classes]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "default": 1,
          "nullable": false,
          "optional": true
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对应参考语句 F.log_softmax(x, dim=1)。",
        "沿 dim=1 计算 log_softmax，数值实现与 PyTorch 一致（减去 max 后计算 log(sum(exp))）。",
        "输出 shape 与输入相同，为 [128, 200]。"
      ]
    },
    {
      "name": "softmax_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, num_classes]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "default": 1,
          "nullable": false,
          "optional": true
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对应参考语句 F.softmax(target, dim=1)。",
        "沿 dim=1 计算 softmax，数值实现与 PyTorch 一致（减去 max 后 exp 并归一化）。",
        "输出 shape 与输入相同，为 [128, 200]。"
      ]
    },
    {
      "name": "kl_div_batchmean_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, num_classes]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "target",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, num_classes]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[]"
      },
      "semantics": [
        "对应参考语句 nn.KLDivLoss(reduction='batchmean')(log_softmax, softmax)。",
        "以 reduction='batchmean' 计算 KL 散度：sum(target * (log(target) - input)) / batch_size。",
        "若 target 包含零，PyTorch 约定 target*log(target) 在该项为 0；实现需保持该语义。",
        "输出为零维标量张量，device 为 cuda。"
      ]
    },
    {
      "name": "l1_loss_sum_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, num_params]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "params",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[num_params]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[]"
      },
      "semantics": [
        "对应参考语句 l1_loss = sum((F.l1_loss(x[:, i], self.params[i].expand_as(x[:, i])) for i in range(len(self.params))))。",
        "对每个 i，将 self.params[i] 广播至 x[:, i] 的 shape [batch]，按默认 reduction='mean' 计算 L1 损失。",
        "然后对所有 i 求和，得到一个零维标量张量。",
        "等价于所有 |x[b][i] - params[i]| 的总和除以 batch_size，与参考结果一致。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.linear(input)",
      "semantics": [
        "线性变换 output = input @ weight.T + bias。",
        "bias 存在且 shape 为 [200]。",
        "输出 shape [128, 200]，dtype float32，device cuda。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "kldiv_loss = nn.KLDivLoss(reduction='batchmean')(F.log_softmax(x, dim=1), F.softmax(target, dim=1))",
      "semantics": [
        "先对 x 沿 dim=1 计算 log_softmax，对 target 沿 dim=1 计算 softmax。",
        "然后按 batchmean 计算 KL 散度。",
        "输出零维标量张量。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "l1_loss = sum((F.l1_loss(x[:, i], self.params[i].expand_as(x[:, i])) for i in range(len(self.params))))",
      "semantics": [
        "对每个 i 计算 x[:, i] 与广播后的 params[i] 的 L1 损失（默认 reduction='mean'），再求和。",
        "输出零维标量张量。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return (kldiv_loss, l1_loss)",
      "semantics": [
        "返回 Python 元组，包含两个零维标量张量。"
      ]
    }
  ]
}