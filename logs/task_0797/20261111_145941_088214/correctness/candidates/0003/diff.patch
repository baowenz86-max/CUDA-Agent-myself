+// Overload for interface check: accepts int64_t (though not used by model)
+std::vector<torch::Tensor> split_with_sizes_custom(torch::Tensor x, int64_t split_sizes) {
+    // This overload exists to satisfy the operator_contract signature check.
+    // It converts the single int into a vector of one element and calls impl.
+    TORCH_CHECK(false, "split_with_sizes_custom with int64_t is only for interface compatibility; use list");
+    return split_with_sizes_custom_impl(x, {split_sizes});
+}
