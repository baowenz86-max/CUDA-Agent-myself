{
  "operators": [
    {
      "name": "linear_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, in_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_features, in_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, out_features]"
      },
      "semantics": [
        "执行线性变换 y = input @ weight^T + bias",
        "对应参考语句 x = self.linear(x)，使用 nn.Linear 默认的 weight 布局 [out_features, in_features]",
        "使用 cuBLAS GEMM 实现矩阵乘法，然后逐行加 bias",
        "输入必须已移动到 CUDA 且连续；N 为 batch 维度，in_features 与 out_features 可由 weight 形状推断",
        "输出 dtype 与输入一致 float32"
      ]
    },
    {
      "name": "selu_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "任意 shape",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "与 input 相同"
      },
      "semantics": [
        "逐元素 SELU 激活：scale * (max(0,x) + min(0, alpha*(exp(x)-1)))，其中 scale=1.0507009873554804934193349852946，alpha=1.6732632423543772848170429916717",
        "对应参考语句 x = torch.selu(x)",
        "保留输入 shape、dtype、device；输出为新张量"
      ]
    },
    {
      "name": "sigmoid_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "任意 shape",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "与 input 相同"
      },
      "semantics": [
        "逐元素 Sigmoid 激活：1 / (1 + exp(-x))",
        "对应参考语句 x = torch.sigmoid(x)",
        "保留输入 shape、dtype、device；输出为新张量"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.linear(x)",
      "semantics": [
        "线性变换，输入 x [1024,4096] 与 weight [4096,4096]^T 相乘，加上 bias [4096]",
        "输出 shape [1024,4096]，float32，CUDA"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.selu(x)",
      "semantics": [
        "对线性输出逐元素应用 SELU 激活函数",
        "输出 shape 与输入相同 [1024,4096]，float32，CUDA"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = torch.sigmoid(x)",
      "semantics": [
        "对 SELU 输出逐元素应用 Sigmoid 激活函数",
        "输出 shape 与输入相同 [1024,4096]，float32，CUDA"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return x",
      "semantics": [
        "返回最终激活结果",
        "shape [1024,4096]，float32，CUDA"
      ]
    }
  ]
}