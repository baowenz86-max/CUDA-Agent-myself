--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,227 @@
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// BatchNorm2d inference: y = (x - mean) / sqrt(var + eps) * weight + bias
+__global__ void batch_norm_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    const float* __restrict__ weight,
+    const float* __restrict__ bias,
+    const float* __restrict__ running_mean,
+    const float* __restrict__ running_var,
+    float eps,
+    int64_t N,
+    int64_t C,
+    int64_t HW)
+{
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= N * C * HW) return;
+    int64_t c = (idx / HW) % C;
+    float inv_std = rsqrtf(running_var[c] + eps);
+    float scale = weight[c] * inv_std;
+    float shift = bias[c] - running_mean[c] * scale;
+    output[idx] = input[idx] * scale + shift;
+}
+
+// GroupNorm without affine: normalize each group in each sample
+__global__ void group_norm_kernel_two_pass(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int64_t N,
+    int64_t C,
+    int64_t HW,
+    int64_t groups,
+    float eps,
+    float* __restrict__ group_mean,
+    float* __restrict__ group_var)
+{
+    int64_t group_id = blockIdx.x;
+    int64_t group_size = (C / groups) * HW;
+    int64_t sample_id = blockIdx.y;
+    if (group_id >= groups || sample_id >= N) return;
+
+    // First pass: compute mean and variance within group
+    float sum = 0.0f;
+    float sq_sum = 0.0f;
+    int64_t base = sample_id * C * HW + group_id * group_size;
+    for (int64_t i = 0; i < group_size; ++i) {
+        float val = input[base + i];
+        sum += val;
+        sq_sum += val * val;
+    }
+    float mean = sum / group_size;
+    float var = sq_sum / group_size - mean * mean;
+    group_mean[group_id * N + sample_id] = mean;
+    group_var[group_id * N + sample_id] = var;
+
+    __syncthreads();
+
+    // Second pass: normalize
+    float inv_std = rsqrtf(var + eps);
+    for (int64_t i = threadIdx.x; i < group_size; i += blockDim.x) {
+        output[base + i] = (input[base + i] - mean) * inv_std;
+    }
+}
+
+__global__ void group_norm_kernel_single_pass(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int64_t N,
+    int64_t C,
+    int64_t HW,
+    int64_t groups,
+    float eps)
+{
+    extern __shared__ float sdata[];
+    float* s_mean = sdata;
+    float* s_var = sdata + blockDim.x;
+
+    int64_t group_id = blockIdx.x;
+    int64_t sample_id = blockIdx.y;
+    int64_t group_size = (C / groups) * HW;
+    int64_t base = sample_id * C * HW + group_id * group_size;
+
+    // Compute partial sums per thread
+    float sum = 0.0f;
+    float sq_sum = 0.0f;
+    for (int64_t i = threadIdx.x; i < group_size; i += blockDim.x) {
+        float val = input[base + i];
+        sum += val;
+        sq_sum += val * val;
+    }
+
+    // Block reduction
+    s_mean[threadIdx.x] = sum;
+    s_var[threadIdx.x] = sq_sum;
+    __syncthreads();
+
+    for (int stride = blockDim.x / 2; stride > 0; stride >>= 1) {
+        if (threadIdx.x < stride) {
+            s_mean[threadIdx.x] += s_mean[threadIdx.x + stride];
+            s_var[threadIdx.x] += s_var[threadIdx.x + stride];
+        }
+        __syncthreads();
+    }
+
+    float mean = s_mean[0] / group_size;
+    float var = s_var[0] / group_size - mean * mean;
+    float inv_std = rsqrtf(var + eps);
+
+    for (int64_t i = threadIdx.x; i < group_size; i += blockDim.x) {
+        output[base + i] = (input[base + i] - mean) * inv_std;
+    }
+}
+
+__global__ void histc_kernel(
+    const float* __restrict__ input,
+    int64_t numel,
+    float min,
+    float max,
+    int64_t bins,
+    float* __restrict__ output)
+{
+    __shared__ int local_hist[256];
+    int tid = threadIdx.x;
+    if (tid < bins) {
+        local_hist[tid] = 0;
+    }
+    __syncthreads();
+
+    int64_t idx = blockIdx.x * blockDim.x + tid;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        float val = input[i];
+        if (val >= min && val <= max) {
+            int64_t bin = (int64_t)((val - min) * bins / (max - min));
+            if (bin >= bins) bin = bins - 1;
+            atomicAdd(&local_hist[bin], 1);
+        }
+    }
+    __syncthreads();
+
+    if (tid < bins) {
+        atomicAdd(&output[tid], (float)local_hist[tid]);
+    }
+}
+
+// Launchers
+void batch_norm_launcher(
+    const float* input,
+    float* output,
+    const float* weight,
+    const float* bias,
+    const float* running_mean,
+    const float* running_var,
+    float eps,
+    int64_t N,
+    int64_t C,
+    int64_t HW,
+    cudaStream_t stream)
+{
+    int64_t total = N * C * HW;
+    int threads = 256;
+    int blocks = (int)((total + threads - 1) / threads);
+    batch_norm_kernel<<<blocks, threads, 0, stream>>>(
+        input, output, weight, bias, running_mean, running_var, eps, N, C, HW);
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // error handling; binding will check after launch
+    }
+}
+
+void group_norm_launcher(
+    const float* input,
+    float* output,
+    int64_t N,
+    int64_t C,
+    int64_t HW,
+    int64_t groups,
+    float eps,
+    cudaStream_t stream)
+{
+    int64_t group_size = (C / groups) * HW;
+    int threads = 256;
+    if (group_size <= threads) {
+        // single pass with shared memory reduction
+        dim3 grid((unsigned int)groups, (unsigned int)N);
+        size_t shmem = 2 * threads * sizeof(float);
+        group_norm_kernel_single_pass<<<grid, threads, shmem, stream>>>(
+            input, output, N, C, HW, groups, eps);
+    } else {
+        // two pass, no shared memory arrays needed for reduction
+        float* group_mean;
+        float* group_var;
+        cudaMalloc(&group_mean, groups * N * sizeof(float));
+        cudaMalloc(&group_var, groups * N * sizeof(float));
+        dim3 grid((unsigned int)groups, (unsigned int)N);
+        group_norm_kernel_two_pass<<<grid, threads, 0, stream>>>(
+            input, output, N, C, HW, groups, eps, group_mean, group_var);
+        cudaFree(group_mean);
+        cudaFree(group_var);
+    }
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // error handling; binding will check after launch
+    }
+}
+
+void histc_launcher(
+    const float* input,
+    int64_t numel,
+    float min,
+    float max,
+    int64_t bins,
+    float* output,
+    cudaStream_t stream)
+{
+    // reset output
+    cudaMemsetAsync(output, 0, bins * sizeof(float), stream);
+    int threads = 256;
+    int blocks = 32;
+    histc_kernel<<<blocks, threads, 0, stream>>>(
+        input, numel, min, max, bins, output);
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // error handling; binding will check after launch
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,164 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void batch_norm_launcher(
+    const float* input,
+    float* output,
+    const float* weight,
+    const float* bias,
+    const float* running_mean,
+    const float* running_var,
+    float eps,
+    int64_t N,
+    int64_t C,
+    int64_t HW,
+    cudaStream_t stream);
+
+extern "C" void group_norm_launcher(
+    const float* input,
+    float* output,
+    int64_t N,
+    int64_t C,
+    int64_t HW,
+    int64_t groups,
+    float eps,
+    cudaStream_t stream);
+
+extern "C" void histc_launcher(
+    const float* input,
+    int64_t numel,
+    float min,
+    float max,
+    int64_t bins,
+    float* output,
+    cudaStream_t stream);
+
+// Helper to check common tensor requirements
+void check_cuda_float_contiguous(const torch::Tensor& t, const char* name) {
+    TORCH_CHECK(t.is_cuda(), name, " must be a CUDA tensor");
+    TORCH_CHECK(t.is_contiguous(), name, " must be contiguous");
+    TORCH_CHECK(t.dtype() == torch::kFloat32, name, " must be float32");
+}
+
+torch::Tensor batch_norm_forward(
+    torch::Tensor input,
+    torch::Tensor weight,
+    torch::Tensor bias,
+    torch::Tensor running_mean,
+    torch::Tensor running_var,
+    double eps) {
+
+    check_cuda_float_contiguous(input, "input");
+    check_cuda_float_contiguous(weight, "weight");
+    check_cuda_float_contiguous(bias, "bias");
+    check_cuda_float_contiguous(running_mean, "running_mean");
+    check_cuda_float_contiguous(running_var, "running_var");
+
+    TORCH_CHECK(input.dim() == 4, "input must be 4D (N,C,H,W)");
+    int64_t N = input.size(0);
+    int64_t C = input.size(1);
+    int64_t H = input.size(2);
+    int64_t W = input.size(3);
+    int64_t HW = H * W;
+
+    TORCH_CHECK(weight.numel() == C, "weight size must equal channels");
+    TORCH_CHECK(bias.numel() == C, "bias size must equal channels");
+    TORCH_CHECK(running_mean.numel() == C, "running_mean size must equal channels");
+    TORCH_CHECK(running_var.numel() == C, "running_var size must equal channels");
+
+    auto output = torch::empty_like(input);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    batch_norm_launcher(
+        input.data_ptr<float>(),
+        output.data_ptr<float>(),
+        weight.data_ptr<float>(),
+        bias.data_ptr<float>(),
+        running_mean.data_ptr<float>(),
+        running_var.data_ptr<float>(),
+        static_cast<float>(eps),
+        N, C, HW,
+        stream);
+
+    return output;
+}
+
+torch::Tensor group_norm_forward(
+    torch::Tensor input,
+    int64_t num_groups,
+    double eps) {
+
+    check_cuda_float_contiguous(input, "input");
+    TORCH_CHECK(input.dim() == 4, "input must be 4D (N,C,H,W)");
+    int64_t N = input.size(0);
+    int64_t C = input.size(1);
+    int64_t H = input.size(2);
+    int64_t W = input.size(3);
+    int64_t HW = H * W;
+
+    TORCH_CHECK(C % num_groups == 0, "channels must be divisible by num_groups");
+
+    auto output = torch::empty_like(input);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    group_norm_launcher(
+        input.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C, HW, num_groups,
+        static_cast<float>(eps),
+        stream);
+
+    return output;
+}
+
+torch::Tensor histc_forward(
+    torch::Tensor input,
+    int64_t bins,
+    double min,
+    double max) {
+
+    check_cuda_float_contiguous(input, "input");
+    TORCH_CHECK(bins > 0, "bins must be positive");
+
+    auto output = torch::empty({bins}, input.options());
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    histc_launcher(
+        input.data_ptr<float>(),
+        input.numel(),
+        static_cast<float>(min),
+        static_cast<float>(max),
+        bins,
+        output.data_ptr<float>(),
+        stream);
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("batch_norm_forward", &batch_norm_forward,
+          "BatchNorm2d inference forward",
+          py::arg("input"),
+          py::arg("weight"),
+          py::arg("bias"),
+          py::arg("running_mean"),
+          py::arg("running_var"),
+          py::arg("eps"));
+    m.def("group_norm_forward", &group_norm_forward,
+          "GroupNorm forward without affine",
+          py::arg("input"),
+          py::arg("num_groups"),
+          py::arg("eps"));
+    m.def("histc_forward", &histc_forward,
+          "Histogram forward",
+          py::arg("input"),
+          py::arg("bins"),
+          py::arg("min"),
+          py::arg("max"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,75 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, num_channels, num_bins, group_num, eps, mean_shape, var_shape):
+        super().__init__()
+        # Match original Model structure and state_dict keys
+        self.batch_norm = nn.BatchNorm2d(num_channels, eps=eps)
+        self.bins = nn.Parameter(torch.histc(torch.randn(1, num_channels, 32, 32), bins=num_bins, min=0, max=1))
+        self.group_num = group_num
+        self.mean_shape = mean_shape
+        self.var_shape = var_shape
+        self.eps = eps
+
+    def forward(self, x):
+        # Step 1: BatchNorm2d inference
+        x = cuda_extension.batch_norm_forward(
+            x,
+            self.batch_norm.weight,
+            self.batch_norm.bias,
+            self.batch_norm.running_mean,
+            self.batch_norm.running_var,
+            self.batch_norm.eps
+        )
+        # Step 2: GroupNorm without affine
+        x = cuda_extension.group_norm_forward(
+            x,
+            self.group_num,
+            self.eps
+        )
+        # Step 3: Histogram, bins from self.bins.shape[0]
+        x = cuda_extension.histc_forward(
+            x,
+            self.bins.shape[0],
+            0.0,
+            1.0
+        )
+        return x
+
+    def debug_forward(self, *inputs):
+        x = inputs[0]
+
+        # Step 1
+        x = cuda_extension.batch_norm_forward(
+            x,
+            self.batch_norm.weight,
+            self.batch_norm.bias,
+            self.batch_norm.running_mean,
+            self.batch_norm.running_var,
+            self.batch_norm.eps
+        )
+        yield "step_001", x
+
+        # Step 2
+        x = cuda_extension.group_norm_forward(
+            x,
+            self.group_num,
+            self.eps
+        )
+        yield "step_002", x
+
+        # Step 3
+        x = cuda_extension.histc_forward(
+            x,
+            self.bins.shape[0],
+            0.0,
+            1.0
+        )
+        yield "step_003", x
+
+        # Final return
+        yield "step_004", x
+        return
