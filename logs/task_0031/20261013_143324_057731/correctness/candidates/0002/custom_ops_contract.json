{
  "operators": [
    {
      "name": "batch_norm_inference",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "contiguous or channels-last",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C, H, W]"
      },
      "semantics": [
        "对应参考语句 x = self.batch_norm(x)。",
        "使用 BatchNorm2d 的 inference 模式：y = (x - running_mean) / sqrt(running_var + eps) * weight + bias。",
        "对每个通道独立进行 affine 变换，无 momentum 更新。",
        "输入和输出 shape 一致，保持原布局（如果输入非连续，可内部处理）。",
        "实际 eps 来自 batch_norm.eps，即构造器传入的 eps 参数。"
      ]
    },
    {
      "name": "group_norm",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "contiguous or channels-last",
          "nullable": false,
          "optional": false
        },
        {
          "name": "num_groups",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": true,
          "optional": true,
          "default": null
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": true,
          "optional": true,
          "default": null
        },
        {
          "name": "eps",
          "kind": "float",
          "nullable": false,
          "optional": true,
          "default": 1e-05
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C, H, W]"
      },
      "semantics": [
        "对应参考语句 x = self.group_norm(x, self.group_num)。",
        "将通道分为 num_groups 组，每组内计算均值和方差，标准化：y = (x - mean_group) / sqrt(var_group + eps) * weight + bias。",
        "weight 和 bias 为 None 时等效于 1 和 0。",
        "eps 使用 1e-05（参考中未显式传递，使用 F.group_norm 默认值）。",
        "输入和输出 shape 一致。"
      ]
    },
    {
      "name": "histc",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "任意",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bins",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "min",
          "kind": "float",
          "nullable": false,
          "optional": false
        },
        {
          "name": "max",
          "kind": "float",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[bins]"
      },
      "semantics": [
        "对应参考语句 x = torch.histc(x, bins=self.bins.shape[0], min=0, max=1)。",
        "计算输入张量中元素落在 min 和 max 之间均匀划分的 bins 个区间内的频数。",
        "实现必须保持原张量遍历顺序，使用稳定压缩（如扫描）以保证元素顺序与参考一致。",
        "输出 dtype 为 torch.float32，尽管 torch.histc 通常返回 float32。",
        "min=0.0, max=1.0 为固定值。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.batch_norm(x)",
      "semantics": [
        "对输入 x 执行 BatchNorm2d 的前向推理，使用 running_mean/running_var 和 weight/bias。",
        "输出 shape [512, 3, 64, 64]，dtype float32，device cuda:0。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.group_norm(x, self.group_num)",
      "semantics": [
        "对 batch_norm 输出执行 GroupNorm，num_groups=3，无 weight/bias，eps=1e-05。",
        "输出 shape 不变。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = torch.histc(x, bins=self.bins.shape[0], min=0, max=1)",
      "semantics": [
        "计算 group_norm 输出张量的直方图，bins=10，范围 [0,1]。",
        "输出 shape [10]，dtype float32，device cuda:0。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return x",
      "semantics": [
        "返回直方图张量。"
      ]
    }
  ]
}