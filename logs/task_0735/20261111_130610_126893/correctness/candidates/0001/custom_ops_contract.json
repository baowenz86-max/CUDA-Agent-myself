{
  "operators": [
    {
      "name": "custom_elu",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[512, 3, 256, 512]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "alpha",
          "kind": "float",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[512, 3, 256, 512]"
      },
      "semantics": [
        "计算 x > 0 时返回 x，x <= 0 时返回 alpha * (exp(x) - 1)，alpha 为 1.0",
        "逐元素操作，无广播或归约",
        "与参考 F.elu(x) 等价"
      ]
    },
    {
      "name": "custom_relu",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[512, 3, 256, 512]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[512, 3, 256, 512]"
      },
      "semantics": [
        "计算 max(x, 0)",
        "逐元素操作，无广播或归约",
        "与参考 torch.relu(x) 等价"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = F.elu(x)",
      "semantics": [
        "对输入张量逐元素执行 ELU（Exponential Linear Unit）：x > 0 输出 x，否则输出 exp(x)-1",
        "alpha 默认为 1.0",
        "输入输出形状 [512, 3, 256, 512]，dtype float32，执行设备 CUDA"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.relu(x)",
      "semantics": [
        "对 ELU 输出逐元素执行 ReLU：max(x, 0)",
        "输入输出形状 [512, 3, 256, 512]，dtype float32，执行设备 CUDA"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回经过 ELU 和 ReLU 连续处理的张量",
        "形状 [512, 3, 256, 512]，dtype float32，设备 cuda:0"
      ]
    }
  ]
}