--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,60 @@
+#include <cuda_runtime.h>
+
+// Leaky ReLU kernel: output = input if input >= 0 else negative_slope * input
+__global__ void leaky_relu_kernel(const float* input, float* output, int64_t numel, float negative_slope) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)blockDim.x * gridDim.x;
+    for (; idx < numel; idx += stride) {
+        float val = input[idx];
+        output[idx] = val >= 0.0f ? val : negative_slope * val;
+    }
+}
+
+// SELU kernel: output = scale * (max(0, input) + min(0, alpha * (exp(input) - 1)))
+__global__ void selu_kernel(const float* input, float* output, int64_t numel) {
+    const float alpha = 1.6732632423543772848170429916717f;
+    const float scale = 1.0507009873554804934193349852946f;
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)blockDim.x * gridDim.x;
+    for (; idx < numel; idx += stride) {
+        float val = input[idx];
+        float result;
+        if (val > 0.0f) {
+            result = scale * val;
+        } else {
+            result = scale * (alpha * (expf(val) - 1.0f));
+        }
+        output[idx] = result;
+    }
+}
+
+// Launcher for leaky_relu_forward. Assumes input and output are contiguous float32 arrays.
+extern "C" void leaky_relu_forward_launcher(
+    const float* input,
+    float* output,
+    int64_t numel,
+    float negative_slope,
+    cudaStream_t stream) {
+    
+    const int threads = 256;
+    int blocks = (int)((numel + threads - 1) / threads);
+    if (blocks > 65535) {
+        blocks = 65535;
+    }
+    leaky_relu_kernel<<<blocks, threads, 0, stream>>>(input, output, numel, negative_slope);
+}
+
+// Launcher for selu_forward. Assumes input and output are contiguous float32 arrays.
+extern "C" void selu_forward_launcher(
+    const float* input,
+    float* output,
+    int64_t numel,
+    cudaStream_t stream) {
+    
+    const int threads = 256;
+    int blocks = (int)((numel + threads - 1) / threads);
+    if (blocks > 65535) {
+        blocks = 65535;
+    }
+    selu_kernel<<<blocks, threads, 0, stream>>>(input, output, numel);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,83 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void leaky_relu_forward_launcher(
+    const float* input,
+    float* output,
+    int64_t numel,
+    float negative_slope,
+    cudaStream_t stream);
+
+extern "C" void selu_forward_launcher(
+    const float* input,
+    float* output,
+    int64_t numel,
+    cudaStream_t stream);
+
+namespace {
+
+// Helper: returns a contiguous float32 CUDA tensor copy if input is not suitable,
+// otherwise returns the input tensor itself (increments reference count).
+torch::Tensor ensure_contiguous_float32_cuda(const torch::Tensor& input) {
+    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(input.scalar_type() == at::kFloat, "Input must be float32");
+    if (input.is_contiguous()) {
+        return input;
+    }
+    return input.contiguous();
+}
+
+}  // namespace
+
+// Python-callable wrapper for leaky_relu_forward
+torch::Tensor leaky_relu_forward(torch::Tensor input, double negative_slope = 0.01) {
+    auto x = ensure_contiguous_float32_cuda(input);
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    leaky_relu_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        x.numel(),
+        static_cast<float>(negative_slope),
+        stream);
+
+    // If input was non-contiguous, output has same shape but contiguous layout;
+    // that's acceptable since reference returns contiguous tensor with same shape.
+    return output;
+}
+
+// Python-callable wrapper for selu_forward
+torch::Tensor selu_forward(torch::Tensor input) {
+    auto x = ensure_contiguous_float32_cuda(input);
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    selu_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        x.numel(),
+        stream);
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("leaky_relu_forward", &leaky_relu_forward,
+          "Leaky ReLU forward",
+          pybind11::arg("input"),
+          pybind11::arg("negative_slope") = 0.01);
+    m.def("selu_forward", &selu_forward,
+          "SELU forward",
+          pybind11::arg("input"));
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,20 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x):
+        x = cuda_extension.leaky_relu_forward(x)
+        x = cuda_extension.selu_forward(x)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.leaky_relu_forward(x)
+        yield 'step_001', x
+        x = cuda_extension.selu_forward(x)
+        yield 'step_002', x
+        yield 'step_003', x
