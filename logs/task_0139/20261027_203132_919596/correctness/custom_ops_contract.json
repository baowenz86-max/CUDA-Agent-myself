          "optional": false
        },
        {
          "name": "negative_slope",
          "kind": "float",
          "dtype": "python float",
          "device": "cpu",
          "shape": "scalar",
          "layout": "n/a",
          "nullable": false,
          "optional": true,
          "default": 0.01
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对应参考语句 x = F.leaky_relu(x)，使用默认 negative_slope=0.01, inplace=False。",
        "逐元素计算：output = input if input >= 0 else negative_slope * input。",
        "输出形状、dtype、device 与输入相同，支持任意 stride 布局（实现可显式连续化或按 stride 索引）。"
      ]
    },
    {
      "name": "selu_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference input [512,16,160,160]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对应参考语句 x = torch.selu(x)，无额外参数。",
        "逐元素计算：output = scale * (max(0, input) + min(0, alpha * (exp(input) - 1)))，其中 alpha=1.6732632423543772848170429916717，scale=1.0507009873554804934193349852946。",
        "输出形状、dtype、device 与输入相同，支持任意 stride 布局。"
      ]
    }
  ],
