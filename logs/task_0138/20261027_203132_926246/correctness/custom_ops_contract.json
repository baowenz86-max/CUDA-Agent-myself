          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as reference step_002 output: [512, 1500]"
      },
      "semantics": [
        "对应torch.norm(x, p=1, dim=1)，输入x形状[512,1500,1500]，沿dim=1计算L1范数，即对每个(b,j)计算sum_{i} |x[b,i,j]|，输出形状[512,1500]。",
        "输入为diag_embed的结果，因此实际计算为对每个b,j取|x[b,j,j]|（对角线元素绝对值），即output[b,j] = |x[b,j,j]|。",
        "不修改输入，返回新张量；输出连续。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = torch.diag_embed(x)",
      "semantics": [
        "输入x形状[512,1500]，输出x形状[512,1500,1500]，其中对角线元素来自输入，非对角线为零。",
        "输出dtype float32，device cuda，连续。"
