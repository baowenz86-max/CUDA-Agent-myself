@@ -0,0 +1,143 @@
+#include <cuda_runtime.h>
+
+// Non-convolution CUDA kernels for the model.
+// Conv2d is handled by cuDNN in a separate .cpp binding file.
+// This file contains only CUDA kernels and launchers using raw pointers/scalars/cudaStream_t.
+
+// Kernel for fused bias add + ELU: y = ELU(x + bias)
+// Input: 4D tensor with shape [N, C, H, W], possibly non-contiguous.
+// Bias: shape [C, 1, 1], broadcast along H and W.
+// Output: same shape as input.
+__global__ void elu_add_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    const float* __restrict__ bias,
+    int64_t total_elements,
+    int C,
+    int H,
+    int W,
+    int input_stride_n,
+    int input_stride_c,
+    int input_stride_h,
+    int output_stride_n,
+    int output_stride_c,
+    int output_stride_h,
+    float alpha
+) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < total_elements; i += stride) {
+        // Compute n, c, h, w from linear index
+        int w = i % W;
+        int64_t tmp = i / W;
+        int h = tmp % H;
+        tmp = tmp / H;
+        int c = tmp % C;
+        int n = tmp / C;
+
+        int64_t input_idx = (int64_t)n * input_stride_n +
+                            (int64_t)c * input_stride_c +
+                            (int64_t)h * input_stride_h +
+                            w;  // w stride assumed 1 for contiguous last dim (but we use general strides)
+        // Actually we should use input_stride_w as well, but for typical tensors it's 1.
+        // To be fully general, we need input_stride_w. We'll add it.
+        // Note: we don't have input_stride_w in the signature, so modify.
+        // We'll rewrite kernel with full strides.
+    }
+}
+
+// Corrected kernel with all strides.
+__global__ void elu_add_kernel_full(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    const float* __restrict__ bias,
+    int64_t total_elements,
+    int C,
+    int H,
+    int W,
+    int input_stride_n,
+    int input_stride_c,
+    int input_stride_h,
+    int input_stride_w,
+    int output_stride_n,
+    int output_stride_c,
+    int output_stride_h,
+    int output_stride_w,
+    float alpha
+) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < total_elements; i += stride) {
+        int w = (int)(i % W);
+        int64_t tmp = i / W;
+        int h = (int)(tmp % H);
+        tmp = tmp / H;
+        int c = (int)(tmp % C);
+        int n = (int)(tmp / C);
+
+        int64_t input_idx = (int64_t)n * input_stride_n +
+                            (int64_t)c * input_stride_c +
+                            (int64_t)h * input_stride_h +
+                            (int64_t)w * input_stride_w;
+        int64_t output_idx = (int64_t)n * output_stride_n +
+                             (int64_t)c * output_stride_c +
+                             (int64_t)h * output_stride_h +
+                             (int64_t)w * output_stride_w;
+
+        float val = input[input_idx] + bias[c];
+        // ELU: alpha * (exp(val) - 1) if val < 0 else val
+        output[output_idx] = (val > 0.0f) ? val : alpha * (expf(val) - 1.0f);
+    }
+}
+
+// Launcher for fused bias add + ELU.
+// All tensors are float32 CUDA tensors. The function takes raw pointers and strides.
+// It is callable from .cpp binding code.
+extern "C" void elu_add_forward_launcher(
+    float* output,
+    const float* input,
+    const float* bias,
+    int64_t total_elements,
+    int C,
+    int H,
+    int W,
+    int input_stride_n,
+    int input_stride_c,
+    int input_stride_h,
+    int input_stride_w,
+    int output_stride_n,
+    int output_stride_c,
+    int output_stride_h,
+    int output_stride_w,
+    float alpha,
+    cudaStream_t stream
+) {
+    if (total_elements <= 0) return;
+
+    const int block_size = 256;
+    int64_t grid_size = (total_elements + block_size - 1) / block_size;
+    if (grid_size > 2147483647) {
+        grid_size = 2147483647; // max grid dim
+    }
+
+    elu_add_kernel_full<<<(unsigned int)grid_size, block_size, 0, stream>>>(
+        output, input, bias,
+        total_elements,
+        C, H, W,
+        input_stride_n, input_stride_c, input_stride_h, input_stride_w,
+        output_stride_n, output_stride_c, output_stride_h, output_stride_w,
+        alpha
+    );
+
+    // Check for kernel launch errors
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // In a binding, we cannot throw, but we can print error and maybe abort.
+        // Since this is raw launcher, we'll just return; the caller should check cudaGetLastError.
+        // But we can also use printf for debugging. We'll leave a comment.
+        printf("elu_add_forward_launcher: kernel launch failed: %s\n", cudaGetErrorString(err));
+    }
+}
+
+// Note: Conv2d forward is implemented using cuDNN in a separate .cpp file.
+// No CUDA kernel for conv here.
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,328 @@
+#include <torch/types.h>
+#include <pybind11/pybind11.h>
+#include <cuda_runtime.h>
+#include <cudnn.h>
+#include <c10/cuda/CUDAStream.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <ATen/cuda/Exceptions.h>
+#include "../binding_registry.h"
+
+namespace py = pybind11;
+
+// Declare launcher from custom_ops.cu
+extern "C" void elu_add_forward_launcher(
+    float* output,
+    const float* input,
+    const float* bias,
+    int64_t total_elements,
+    int C,
+    int H,
+    int W,
+    int input_stride_n,
+    int input_stride_c,
+    int input_stride_h,
+    int input_stride_w,
+    int output_stride_n,
+    int output_stride_c,
+    int output_stride_h,
+    int output_stride_w,
+    float alpha,
+    cudaStream_t stream
+);
+
+// Helper to check cuDNN status
+#define CHECK_CUDNN(status) \
+    if (status != CUDNN_STATUS_SUCCESS) { \
+        throw std::runtime_error(std::string("cuDNN error: ") + cudnnGetErrorString(status)); \
+    }
+
+// cuDNN convolution forward with bias
+torch::Tensor conv2d_forward(
+    torch::Tensor input,
+    torch::Tensor weight,
+    torch::Tensor bias,
+    int64_t stride,
+    int64_t padding,
+    int64_t dilation,
+    int64_t groups) {
+
+    // Input checks
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(weight.is_cuda(), "weight must be a CUDA tensor");
+    TORCH_CHECK(!bias.defined() || bias.is_cuda(), "bias must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(weight.dtype() == torch::kFloat32, "weight must be float32");
+    TORCH_CHECK(!bias.defined() || bias.dtype() == torch::kFloat32, "bias must be float32");
+    TORCH_CHECK(input.dim() == 4, "input must be 4D (N, C, H, W)");
+    TORCH_CHECK(weight.dim() == 4, "weight must be 4D");
+
+    // Get dimensions
+    int64_t N = input.size(0);       // batch size
+    int64_t C = input.size(1);       // input channels
+    int64_t H = input.size(2);       // input height
+    int64_t W = input.size(3);       // input width
+    int64_t K = weight.size(0);      // output channels
+    int64_t R = weight.size(2);      // kernel height
+    int64_t S = weight.size(3);      // kernel width
+
+    TORCH_CHECK(weight.size(1) == C / groups, "weight input channels must match input channels / groups");
+    TORCH_CHECK(groups > 0 && C % groups == 0 && K % groups == 0, "invalid groups");
+
+    // Compute output dimensions
+    int64_t H_out = (H + 2 * padding - dilation * (R - 1) - 1) / stride + 1;
+    int64_t W_out = (W + 2 * padding - dilation * (S - 1) - 1) / stride + 1;
+
+    // Allocate output tensor with same dtype/device, but ensure contiguous
+    auto output = torch::empty({N, K, H_out, W_out}, input.options());
+
+    // Make tensors contiguous if needed (cuDNN requires contiguous or specific strides, but we can handle non-contiguous via descriptors)
+    // For simplicity, use contiguous versions. This does not affect correctness.
+    auto input_contig = input.contiguous();
+    auto weight_contig = weight.contiguous();
+    auto output_contig = output.contiguous();
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Create cuDNN handle
+    cudnnHandle_t handle;
+    CHECK_CUDNN(cudnnCreate(&handle));
+    CHECK_CUDNN(cudnnSetStream(handle, stream));
+
+    // Set up tensor descriptors
+    cudnnTensorDescriptor_t input_desc, output_desc, bias_desc;
+    cudnnFilterDescriptor_t filter_desc;
+    cudnnConvolutionDescriptor_t conv_desc;
+
+    CHECK_CUDNN(cudnnCreateTensorDescriptor(&input_desc));
+    CHECK_CUDNN(cudnnCreateTensorDescriptor(&output_desc));
+    CHECK_CUDNN(cudnnCreateTensorDescriptor(&bias_desc));
+    CHECK_CUDNN(cudnnCreateFilterDescriptor(&filter_desc));
+    CHECK_CUDNN(cudnnCreateConvolutionDescriptor(&conv_desc));
+
+    // Set input/output tensor descriptors (NCHW format)
+    CHECK_CUDNN(cudnnSetTensor4dDescriptor(
+        input_desc,
+        CUDNN_TENSOR_NCHW,
+        CUDNN_DATA_FLOAT,
+        (int)N,
+        (int)C,
+        (int)H,
+        (int)W
+    ));
+    CHECK_CUDNN(cudnnSetTensor4dDescriptor(
+        output_desc,
+        CUDNN_TENSOR_NCHW,
+        CUDNN_DATA_FLOAT,
+        (int)N,
+        (int)K,
+        (int)H_out,
+        (int)W_out
+    ));
+
+    // Set filter descriptor: K, C/groups, R, S
+    CHECK_CUDNN(cudnnSetFilter4dDescriptor(
+        filter_desc,
+        CUDNN_DATA_FLOAT,
+        CUDNN_TENSOR_NCHW,
+        (int)K,
+        (int)(C / groups),
+        (int)R,
+        (int)S
+    ));
+
+    // Set convolution descriptor
+    CHECK_CUDNN(cudnnSetConvolution2dDescriptor(
+        conv_desc,
+        (int)padding,
+        (int)padding,
+        (int)stride,
+        (int)stride,
+        (int)dilation,
+        (int)dilation,
+        CUDNN_CROSS_CORRELATION,
+        CUDNN_DATA_FLOAT
+    ));
+
+    CHECK_CUDNN(cudnnSetConvolutionGroupCount(conv_desc, (int)groups));
+
+    // Find best convolution algorithm
+    cudnnConvolutionFwdAlgo_t algo;
+    CHECK_CUDNN(cudnnGetConvolutionForwardAlgorithm(
+        handle,
+        input_desc,
+        filter_desc,
+        conv_desc,
+        output_desc,
+        CUDNN_CONVOLUTION_FWD_PREFER_FASTEST,
+        0,
+        &algo
+    ));
+
+    // Determine workspace size
+    size_t workspace_size = 0;
+    CHECK_CUDNN(cudnnGetConvolutionForwardWorkspaceSize(
+        handle,
+        input_desc,
+        filter_desc,
+        conv_desc,
+        output_desc,
+        algo,
+        &workspace_size
+    ));
+
+    // Allocate workspace
+    void* workspace = nullptr;
+    if (workspace_size > 0) {
+        cudaError_t err = cudaMalloc(&workspace, workspace_size);
+        if (err != cudaSuccess) {
+            throw std::runtime_error("cudaMalloc failed for cuDNN workspace");
+        }
+    }
+
+    // Perform convolution
+    float alpha = 1.0f;
+    float beta = 0.0f;
+    CHECK_CUDNN(cudnnConvolutionForward(
+        handle,
+        &alpha,
+        input_desc,
+        input_contig.data_ptr<float>(),
+        filter_desc,
+        weight_contig.data_ptr<float>(),
+        conv_desc,
+        algo,
+        workspace,
+        workspace_size,
+        &beta,
+        output_desc,
+        output_contig.data_ptr<float>()
+    ));
+
+    // Add bias if defined
+    if (bias.defined()) {
+        TORCH_CHECK(bias.numel() == K, "bias size must match output channels");
+        // Bias descriptor: N=1, C=K, H=1, W=1
+        CHECK_CUDNN(cudnnSetTensor4dDescriptor(
+            bias_desc,
+            CUDNN_TENSOR_NCHW,
+            CUDNN_DATA_FLOAT,
+            1,
+            (int)K,
+            1,
+            1
+        ));
+
+        alpha = 1.0f;
+        beta = 1.0f;
+        CHECK_CUDNN(cudnnAddTensor(
+            handle,
+            &alpha,
+            bias_desc,
+            bias.contiguous().data_ptr<float>(),
+            &beta,
+            output_desc,
+            output_contig.data_ptr<float>()
+        ));
+    }
+
+    // Cleanup
+    cudnnDestroyTensorDescriptor(input_desc);
+    cudnnDestroyTensorDescriptor(output_desc);
+    cudnnDestroyTensorDescriptor(bias_desc);
+    cudnnDestroyFilterDescriptor(filter_desc);
+    cudnnDestroyConvolutionDescriptor(conv_desc);
+    cudnnDestroy(handle);
+    if (workspace) cudaFree(workspace);
+
+    // Return output (contiguous tensor)
+    return output_contig;
+}
+
+// Fused ELU + bias add forward
+torch::Tensor elu_add_forward(
+    torch::Tensor input,
+    torch::Tensor bias,
+    double alpha) {
+
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(bias.is_cuda(), "bias must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(bias.dtype() == torch::kFloat32, "bias must be float32");
+    TORCH_CHECK(input.dim() == 4, "input must be 4D");
+    TORCH_CHECK(bias.dim() == 3, "bias must be 3D [C,1,1]");
+
+    int64_t N = input.size(0);
+    int64_t C = input.size(1);
+    int64_t H = input.size(2);
+    int64_t W = input.size(3);
+    TORCH_CHECK(bias.size(0) == C, "bias first dimension must match input channels");
+    TORCH_CHECK(bias.size(1) == 1 && bias.size(2) == 1, "bias must have shape [C,1,1]");
+
+    // Get strides (may be negative? typically positive). Handle as int64_t, cast to int for kernel signature.
+    int input_stride_n = (int)input.stride(0);
+    int input_stride_c = (int)input.stride(1);
+    int input_stride_h = (int)input.stride(2);
+    int input_stride_w = (int)input.stride(3);
+
+    // Allocate output with same shape and strides as input, contiguous by default
+    auto output = torch::empty_like(input);
+
+    int output_stride_n = (int)output.stride(0);
+    int output_stride_c = (int)output.stride(1);
+    int output_stride_h = (int)output.stride(2);
+    int output_stride_w = (int)output.stride(3);
+
+    int64_t total_elements = input.numel();
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    elu_add_forward_launcher(
+        output.data_ptr<float>(),
+        input.data_ptr<float>(),
+        bias.data_ptr<float>(),
+        total_elements,
+        (int)C,
+        (int)H,
+        (int)W,
+        input_stride_n,
+        input_stride_c,
+        input_stride_h,
+        input_stride_w,
+        output_stride_n,
+        output_stride_c,
+        output_stride_h,
+        output_stride_w,
+        (float)alpha,
+        stream
+    );
+
+    // Check for CUDA errors after kernel launch
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        throw std::runtime_error("CUDA kernel launch failed: " + std::string(cudaGetErrorString(err)));
+    }
+
+    return output;
+}
+
+// Register bindings
+void register_custom_ops(pybind11::module& m) {
+    m.def("conv2d_forward", &conv2d_forward,
+          "2D convolution forward using cuDNN",
+          py::arg("input"),
+          py::arg("weight"),
+          py::arg("bias"),
+          py::arg("stride") = 1,
+          py::arg("padding") = 0,
+          py::arg("dilation") = 1,
+          py::arg("groups") = 1);
+
+    m.def("elu_add_forward", &elu_add_forward,
+          "Fused bias add + ELU",
+          py::arg("input"),
+          py::arg("bias"),
+          py::arg("alpha") = 1.0);
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,28 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, out_channels, kernel_size, bias_shape):
+        super().__init__()
+        self.conv = nn.Conv2d(in_channels, out_channels, kernel_size)
+        self.bias = nn.Parameter(torch.randn(bias_shape))
+
+    def forward(self, x):
+        x = cuda_extension.conv2d_forward(
+            x, self.conv.weight, self.conv.bias,
+            stride=1, padding=0, dilation=1, groups=1
+        )
+        x = cuda_extension.elu_add_forward(x, self.bias, alpha=1.0)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.conv2d_forward(
+            x, self.conv.weight, self.conv.bias,
+            stride=1, padding=0, dilation=1, groups=1
+        )
+        yield 'step_001', x
+        x = cuda_extension.elu_add_forward(x, self.bias, alpha=1.0)
+        yield 'step_002', x
+        yield 'step_003', x
