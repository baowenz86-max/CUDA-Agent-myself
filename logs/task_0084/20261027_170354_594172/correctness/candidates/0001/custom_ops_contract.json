          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels, in_channels, kH, kW]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels]",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        },
        {
          "name": "stride",
          "kind": "int",
          "default": 1,
          "optional": true,
          "nullable": false
        },
        {
          "name": "padding",
          "kind": "int",
          "default": 0,
          "optional": true,
          "nullable": false
        },
        {
          "name": "dilation",
          "kind": "int",
          "default": 1,
          "optional": true,
          "nullable": false
        },
        {
          "name": "groups",
          "kind": "int",
          "default": 1,
          "optional": true,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, out_channels, H_out, W_out]"
      },
      "semantics": [
        "对应参考语句 x = self.conv(x)。self.conv 是 nn.Conv2d(3, 16, kernel_size=3)。",
        "实际 bias 来自 self.conv.bias (shape [16])，必须传入，不能因模块有 bias 就省略。",
        "stride=1, padding=0, dilation=1, groups=1。",
        "权重 shape [16,3,3,3]，输入 shape [128,3,1024,32]，输出 shape [128,16,1022,30]。",
        "使用 cuDNN 卷积，允许输入/权重非连续 strides。",
        "输出 dtype/device 与输入一致。"
      ]
    },
    {
      "name": "elu_add_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C, 1, 1]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "alpha",
          "kind": "float",
          "default": 1.0,
          "optional": true,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对应参考语句 x = F.elu(x + self.bias)。",
        "先计算 x + self.bias，广播规则：bias shape [C,1,1] 沿 H,W 维度广播到输入 shape [N,C,H,W]。",
        "然后对和逐元素应用 ELU：y = x if x > 0 else alpha * (exp(x) - 1)。",
        "alpha 默认 1.0。",
        "输出 dtype/device 与输入一致。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.conv(x)",
      "semantics": [
        "self.conv 为 nn.Conv2d(3, 16, kernel_size=3)，stride=1, padding=0, dilation=1, groups=1。",
        "输入 x shape [128,3,1024,32]，权重 shape [16,3,3,3]，偏置 shape [16]。",
        "输出 shape [128,16,1022,30]，dtype float32，device cuda。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = F.elu(x + self.bias)",
      "semantics": [
        "x 是 conv 输出 shape [128,16,1022,30]，self.bias shape [16,1,1]。",
        "加法广播：bias 沿 H,W 维度广播。",
        "ELU alpha=1.0，逐元素计算。",
        "输出 shape 与输入相同，dtype float32，device cuda。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回 ELU 输出张量，shape [128,16,1022,30]，dtype float32，device cuda。"
      ]
    }
  ]
}