      "semantics": [
        "对应 torch.sum(x, dim=1)，对输入维度 1 执行归约求和。",
        "输出形状与参考一致 [B, H, W]。",
        "输入为 CUDA float32 张量，支持任意 strides。"
      ]
    },
    {
      "name": "custom_fmod",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "divisor",
          "kind": "float",
          "dtype": null,
          "device": null,
          "shape": null,
          "layout": null,
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[B, H, W]"
      },
      "semantics": [
        "对应 torch.fmod(x, self.fmod_divisor)，对每个元素执行浮点取模。",
        "divisor 是 Python 标量，在 C++ 中作为 double 传递。",
        "输出形状同输入。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = torch.sum(x, dim=1)",
      "semantics": [
        "对输入 x 在 dim=1 上求和，输入形状 [512, 2048, 32, 32]，输出形状 [512, 32, 32]。",
        "保持 float32。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.fmod(x, self.fmod_divisor)",
      "semantics": [
        "对 step_001 的结果执行逐元素 fmod，除数 self.fmod_divisor。",
        "输出形状不变。"
      ]
    },
    {
      "checkpoint": "step_003",
