--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,65 @@
+#include <cuda_runtime.h>
+#include <math.h>
+
+// Elementwise acos kernel: output[i] = acosf(input[i])
+__global__ void acos_elementwise_kernel(const float* __restrict__ input,
+                                        float* __restrict__ output,
+                                        long long total) {
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (long long i = idx; i < total; i += stride) {
+        output[i] = acosf(input[i]);
+    }
+}
+
+// Dimension permutation kernel: input [B,C,H,W] -> output [B,H,C,W], flattened.
+// Output indexing: b*H*C*W + h*C*W + c*W + w
+// Input indexing:  b*C*H*W + c*H*W + h*W + w
+__global__ void cat_unbind_channels_kernel(const float* __restrict__ input,
+                                            float* __restrict__ output,
+                                            int B, int C, int H, int W,
+                                            long long total) {
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (long long linear = idx; linear < total; linear += stride) {
+        int w = linear % W;
+        long long tmp1 = linear / W;
+        int c = tmp1 % C;
+        long long tmp2 = tmp1 / C;
+        int h = tmp2 % H;
+        int b = tmp2 / H;
+        // Input offset for [b,c,h,w]
+        long long in_idx = ((long long)b * C * H * W) + ((long long)c * H * W) + ((long long)h * W) + w;
+        output[linear] = input[in_idx];
+    }
+}
+
+extern "C" void acos_stack_forward_launcher(const float* input,
+                                             float* output,
+                                             long long total,
+                                             cudaStream_t stream) {
+    const int threads = 256;
+    int blocks = (int)((total + threads - 1) / threads);
+    if (blocks > 65535) blocks = 65535; // grid cap, grid-stride handles rest
+    acos_elementwise_kernel<<<blocks, threads, 0, stream>>>(input, output, total);
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // Binding layer should check and throw, but we leave this as a no-op here
+        // because .cu cannot use TORCH_CHECK. We simply ignore.
+    }
+}
+
+extern "C" void cat_unbind_channels_forward_launcher(const float* input,
+                                                      float* output,
+                                                      int B, int C, int H, int W,
+                                                      cudaStream_t stream) {
+    long long total = (long long)B * H * C * W;
+    const int threads = 256;
+    int blocks = (int)((total + threads - 1) / threads);
+    if (blocks > 65535) blocks = 65535;
+    cat_unbind_channels_kernel<<<blocks, threads, 0, stream>>>(input, output, B, C, H, W, total);
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // ignore; binding layer will check
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,92 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void acos_stack_forward_launcher(const float* input,
+                                             float* output,
+                                             long long total,
+                                             cudaStream_t stream);
+
+extern "C" void cat_unbind_channels_forward_launcher(const float* input,
+                                                      float* output,
+                                                      int B, int C, int H, int W,
+                                                      cudaStream_t stream);
+
+// Wrapper for acos_stack: elementwise acos, output shape same as input
+torch::Tensor acos_stack(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D [B,C,H,W]");
+
+    long long total = x.numel();
+    TORCH_CHECK(total > 0, "Input tensor must have at least one element");
+
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    acos_stack_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        total,
+        stream
+    );
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "acos_stack kernel failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// Wrapper for cat_unbind_channels: [B,C,H,W] -> [B,H,C*W]
+torch::Tensor cat_unbind_channels(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D [B,C,H,W]");
+
+    int64_t B = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+
+    TORCH_CHECK(B > 0 && C > 0 && H > 0 && W > 0, "All dimensions must be positive");
+    TORCH_CHECK(B <= INT_MAX && C <= INT_MAX && H <= INT_MAX && W <= INT_MAX,
+                "Dimension exceeds int range");
+
+    // Output shape [B, H, C*W]
+    auto output = torch::empty({B, H, C * W}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    cat_unbind_channels_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int>(B),
+        static_cast<int>(C),
+        static_cast<int>(H),
+        static_cast<int>(W),
+        stream
+    );
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "cat_unbind_channels kernel failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// Registration
+void register_custom_ops(pybind11::module& m) {
+    m.def("acos_stack", &acos_stack,
+          "Elementwise acos, output shape same as input",
+          py::arg("x"));
+    m.def("cat_unbind_channels", &cat_unbind_channels,
+          "Permute [B,C,H,W] to [B,H,C*W]",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,37 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, input_dim, mid_dim):
+        super().__init__()
+        self.mid_dim = mid_dim
+
+    def forward(self, x):
+        x = cuda_extension.acos_stack(x)
+        x = cuda_extension.cat_unbind_channels(x)
+        return x
+
+    def debug_forward(self, x):
+        x1 = cuda_extension.acos_stack(x)
+        yield "step_001", x1
+        x2 = cuda_extension.cat_unbind_channels(x1)
+        yield "step_002", x2
+        yield "step_003", x2
+
+
+batch_size = 16
+in_channels = 64
+height = 512
+width = 256
+mid_dim = 64
+
+
+def get_inputs():
+    x = torch.randn(batch_size, in_channels, height, width).clamp(-1, 1)
+    return [x]
+
+
+def get_init_inputs():
+    return [in_channels, mid_dim]
