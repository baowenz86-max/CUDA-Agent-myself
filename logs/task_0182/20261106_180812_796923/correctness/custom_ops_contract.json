{
  "operators": [
    {
      "name": "custom_instance_norm_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "nullable": false,
          "optional": false,
          "default": null
        },
        {
          "name": "momentum",
          "kind": "float",
          "nullable": false,
          "optional": false,
          "default": null
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "对应 reference 语句 x = self.instance_norm(x)；InstanceNorm2d 配置为 num_features=64, eps=1e-05, momentum=0.1, affine=False, bias=False, track_running_stats=False，且模型处于 eval 模式。",
        "对输入 x shape [N,C,H,W]，对每个 (n,c) 沿 H,W 维度计算 mean 和 var（有偏方差，除以 H*W）。",
        "归一化输出为 (x - mean) / sqrt(var + eps)，无 affine 变换。",
        "输出 shape、dtype、device 与输入相同。"
      ]
    },
    {
      "name": "custom_hardsigmoid_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "对应 reference 语句 x = self.hardsigmoid(x)；nn.Hardsigmoid(inplace=False) 公式为 clamp(x/6 + 0.5, 0, 1)。",
        "逐元素计算，输出与输入同 shape。"
      ]
    },
    {
      "name": "custom_scale_bias_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "scale",
          "kind": "float",
          "nullable": false,
          "optional": false,
          "default": null
        },
        {
          "name": "bias",
          "kind": "float",
          "nullable": false,
          "optional": false,
          "default": null
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "对应 reference 语句 x = x * self.scale + self.bias；scale=0.5, bias=0.5。",
        "逐元素 affine 变换，输出与输入同 shape。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.instance_norm(x)",
      "semantics": [
        "InstanceNorm2d，无 affine，无 running stats；eval 模式下对每个样本每个通道独立计算 H,W 上的有偏 mean 和 var，输出 (x - mean) / sqrt(var + eps)。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.hardsigmoid(x)",
      "semantics": [
        "Hardsigmoid：clamp(x/6 + 0.5, 0, 1)。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = x * self.scale + self.bias",
      "semantics": [
        "逐元素乘 scale 加 bias。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return x",
      "semantics": [
        "返回最终张量。"
      ]
    }
  ]
}