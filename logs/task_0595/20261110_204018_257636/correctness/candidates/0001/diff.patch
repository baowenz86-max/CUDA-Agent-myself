--- before/kernels/adaptive_avg_pool1d_binding.cpp
+++ after/kernels/adaptive_avg_pool1d_binding.cpp
@@ -0,0 +1,67 @@
+#include <torch/types.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_runtime.h>
+#include <pybind11/pybind11.h>
+#include "../binding_registry.h"
+
+namespace py = pybind11;
+
+// Declare the CUDA launcher from custom_ops.cu
+extern "C" void adaptive_avg_pool1d_launcher(
+    const float* input,
+    float* output,
+    long long batch,
+    long long channels,
+    long long seq_len,
+    long long output_size,
+    cudaStream_t stream);
+
+torch::Tensor adaptive_avg_pool1d_forward(torch::Tensor input, int64_t output_size) {
+    // Input validation
+    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(input.dim() == 3, "Input must be 3D (batch, channels, seq_len)");
+    TORCH_CHECK(output_size > 0, "output_size must be positive");
+
+    // Make input contiguous for the kernel (the kernel expects row-major per (b,c))
+    auto input_contig = input.contiguous();
+
+    int64_t batch = input_contig.size(0);
+    int64_t channels = input_contig.size(1);
+    int64_t seq_len = input_contig.size(2);
+
+    // Allocate output tensor with shape [batch, channels, output_size]
+    auto output = torch::empty({batch, channels, output_size}, input_contig.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    adaptive_avg_pool1d_launcher(
+        input_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<long long>(batch),
+        static_cast<long long>(channels),
+        static_cast<long long>(seq_len),
+        static_cast<long long>(output_size),
+        stream
+    );
+
+    // Check for kernel launch errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "adaptive_avg_pool1d kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+void register_adaptive_avg_pool1d(py::module& m) {
+    m.def(
+        "adaptive_avg_pool1d",
+        &adaptive_avg_pool1d_forward,
+        "Adaptive average pooling over last dimension",
+        py::arg("input"),
+        py::arg("output_size")
+    );
+}
+
+REGISTER_BINDING(adaptive_avg_pool1d, register_adaptive_avg_pool1d);
--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,57 @@
+#include <cuda_runtime.h>
+
+// Adaptive average pooling over the last dimension.
+// Each thread computes one output element.
+// Window indices follow PyTorch: start = floor(i*L/O), end = ceil((i+1)*L/O)
+__global__ void adaptive_avg_pool1d_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    long long batch,
+    long long channels,
+    long long seq_len,
+    long long output_size) {
+
+    long long total_outputs = batch * channels * output_size;
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = blockDim.x * gridDim.x;
+
+    for (; idx < total_outputs; idx += stride) {
+        long long out_idx = idx % output_size;
+        long long ch = (idx / output_size) % channels;
+        long long b = idx / (channels * output_size);
+
+        long long start = (out_idx * seq_len) / output_size;
+        long long end = ((out_idx + 1) * seq_len + output_size - 1) / output_size; // ceil
+        if (end > seq_len) end = seq_len;
+
+        float sum = 0.0f;
+        const float* in_base = input + (b * channels + ch) * seq_len;
+        for (long long i = start; i < end; ++i) {
+            sum += in_base[i];
+        }
+        long long count = end - start;
+        if (count > 0) {
+            output[idx] = sum / static_cast<float>(count);
+        } else {
+            output[idx] = 0.0f;
+        }
+    }
+}
+
+extern "C" void adaptive_avg_pool1d_launcher(
+    const float* input,
+    float* output,
+    long long batch,
+    long long channels,
+    long long seq_len,
+    long long output_size,
+    cudaStream_t stream) {
+
+    long long total_outputs = batch * channels * output_size;
+    const int block_size = 256;
+    long long blocks = (total_outputs + block_size - 1) / block_size;
+    if (blocks < 1) blocks = 1;
+
+    adaptive_avg_pool1d_kernel<<<(unsigned int)blocks, block_size, 0, stream>>>(
+        input, output, batch, channels, seq_len, output_size);
+}
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,19 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_features, out_features):
+        super().__init__()
+        self.in_features = in_features
+        self.out_features = out_features
+
+    def forward(self, x):
+        x = cuda_extension.adaptive_avg_pool1d(x, self.out_features)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.adaptive_avg_pool1d(x, self.out_features)
+        yield 'step_001', x
+        yield 'step_002', x
