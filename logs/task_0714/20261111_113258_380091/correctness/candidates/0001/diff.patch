--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,54 @@
+#include <cuda_runtime.h>
+#include <math.h>
+
+// Elementwise absolute value: y = |x|
+__global__ void abs_kernel(const float* __restrict__ input,
+                           float* __restrict__ output,
+                           int64_t numel) {
+    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)gridDim.x * blockDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        output[i] = fabsf(input[i]);
+    }
+}
+
+// Elementwise softplus with beta=1, threshold=20
+__global__ void softplus_kernel(const float* __restrict__ input,
+                                float* __restrict__ output,
+                                int64_t numel) {
+    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)gridDim.x * blockDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        float x = input[i];
+        output[i] = (x > 20.0f) ? x : log1pf(expf(x));
+    }
+}
+
+// Launcher for abs_forward
+extern "C" void abs_forward_launcher(const float* input,
+                                     float* output,
+                                     int64_t numel,
+                                     cudaStream_t stream) {
+    const int block_size = 256;
+    int64_t num_blocks = (numel + block_size - 1) / block_size;
+    if (num_blocks > 0) {
+        // Limit grid size to avoid exceeding device limits
+        int max_blocks = 65535;
+        int grid = (int)min((int64_t)max_blocks, num_blocks);
+        abs_kernel<<<grid, block_size, 0, stream>>>(input, output, numel);
+    }
+}
+
+// Launcher for softplus_forward
+extern "C" void softplus_forward_launcher(const float* input,
+                                          float* output,
+                                          int64_t numel,
+                                          cudaStream_t stream) {
+    const int block_size = 256;
+    int64_t num_blocks = (numel + block_size - 1) / block_size;
+    if (num_blocks > 0) {
+        int max_blocks = 65535;
+        int grid = (int)min((int64_t)max_blocks, num_blocks);
+        softplus_kernel<<<grid, block_size, 0, stream>>>(input, output, numel);
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,49 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+extern "C" void abs_forward_launcher(const float* input, float* output, int64_t numel, cudaStream_t stream);
+extern "C" void softplus_forward_launcher(const float* input, float* output, int64_t numel, cudaStream_t stream);
+
+torch::Tensor abs_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+
+    auto output = torch::empty_like(x);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    abs_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        x.numel(),
+        stream
+    );
+    return output;
+}
+
+torch::Tensor softplus_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+
+    auto output = torch::empty_like(x);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    softplus_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        x.numel(),
+        stream
+    );
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("abs_forward", &abs_forward, "Elementwise absolute value",
+          py::arg("x"));
+    m.def("softplus_forward", &softplus_forward, "Elementwise softplus",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,21 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, input_size):
+        super().__init__()
+        self.input_size = input_size
+
+    def forward(self, x):
+        x = cuda_extension.abs_forward(x)
+        x = cuda_extension.softplus_forward(x)
+        return x
+
+    def debug_forward(self, x):
+        x_abs = cuda_extension.abs_forward(x)
+        yield 'step_001', x_abs
+        x_softplus = cuda_extension.softplus_forward(x_abs)
+        yield 'step_002', x_softplus
+        yield 'step_003', x_softplus
