      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, out_features]"
      },
      "semantics": [
        "Computes output = input @ weight.T + bias (if bias is not None).",
        "Equivalent to torch.nn.functional.linear(input, weight, bias).",
        "Input shape [B, I], weight [O, I], output [B, O]."
      ]
    },
    {
      "name": "sigmoid_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as input to reference step",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "Applies sigmoid element-wise: 1 / (1 + exp(-input)).",
        "Equivalent to torch.sigmoid(input).",
        "Output shape identical to input shape."
      ]
    },
    {
      "name": "batch_norm1d_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, num_features]",
          "layout": "contiguous or supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[num_features]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[num_features]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[num_features]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[num_features]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "default": 1e-05,
          "optional": true,
          "nullable": false
        },
        {
          "name": "momentum",
          "kind": "float",
          "default": 0.1,
          "optional": true,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, num_features]"
      },
      "semantics": [
        "Computes batch normalization for inference (training=False in reference): output = (input - running_mean) / sqrt(running_var + eps) * weight + bias.",
        "If weight is None, use 1; if bias is None, use 0.",
        "Equivalent to torch.nn.functional.batch_norm(input, running_mean, running_var, weight, bias, training=False, momentum=momentum, eps=eps).",
        "Output shape identical to input shape."
      ]
    }
  ],
  "reference_steps": [
