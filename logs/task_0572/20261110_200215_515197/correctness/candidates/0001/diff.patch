--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,92 @@
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// custom_abs kernel: element-wise absolute value
+template <typename T>
+__global__ void custom_abs_kernel(const T* __restrict__ input, T* __restrict__ output, int64_t numel) {
+    int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    int64_t stride = static_cast<int64_t>(blockDim.x) * gridDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        output[i] = fabsf(input[i]);  // only float version is used
+    }
+}
+
+// adaptive_avg_pool2d kernel: each thread computes one output element
+// input is assumed contiguous float tensor with shape [N, C, H, W]
+// output shape [N, C, out_h, out_w]
+__global__ void adaptive_avg_pool2d_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int64_t N, int64_t C, int64_t H, int64_t W,
+    int64_t out_h, int64_t out_w)
+{
+    int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    int64_t total_out = N * C * out_h * out_w;
+    if (idx >= total_out) return;
+
+    // decompose idx into n, c, oh, ow
+    int64_t ow = idx % out_w;
+    int64_t tmp = idx / out_w;
+    int64_t oh = tmp % out_h;
+    tmp /= out_h;
+    int64_t c = tmp % C;
+    int64_t n = tmp / C;
+
+    // compute start and end indices using floor/ceil formula
+    int64_t h_start = (oh * H) / out_h;
+    int64_t h_end = ((oh + 1) * H + out_h - 1) / out_h;  // ceil division
+    int64_t w_start = (ow * W) / out_w;
+    int64_t w_end = ((ow + 1) * W + out_w - 1) / out_w;
+
+    // ensure valid range
+    if (h_start < 0) h_start = 0;
+    if (h_end > H) h_end = H;
+    if (w_start < 0) w_start = 0;
+    if (w_end > W) w_end = W;
+
+    float sum = 0.0f;
+    int64_t count = 0;
+    const float* base = input + (n * C + c) * H * W;
+    for (int64_t h = h_start; h < h_end; ++h) {
+        const float* row = base + h * W;
+        for (int64_t w = w_start; w < w_end; ++w) {
+            sum += row[w];
+            ++count;
+        }
+    }
+
+    // if count == 0 (should not happen), avoid division by zero
+    output[idx] = (count > 0) ? (sum / count) : 0.0f;
+}
+
+// launcher for custom_abs
+extern "C" void custom_abs_launcher(
+    const float* input,
+    float* output,
+    int64_t numel,
+    cudaStream_t stream)
+{
+    const int block_size = 256;
+    int64_t blocks = (numel + block_size - 1) / block_size;
+    // cap grid to 2^31-1 blocks (GPU limit) and use grid-stride loop in kernel
+    if (blocks > 2147483647) blocks = 2147483647;
+    custom_abs_kernel<float><<<static_cast<unsigned int>(blocks), block_size, 0, stream>>>(
+        input, output, numel);
+}
+
+// launcher for adaptive_avg_pool2d
+extern "C" void adaptive_avg_pool2d_launcher(
+    const float* input,
+    float* output,
+    int64_t N, int64_t C, int64_t H, int64_t W,
+    int64_t out_h, int64_t out_w,
+    cudaStream_t stream)
+{
+    int64_t total_out = N * C * out_h * out_w;
+    if (total_out == 0) return;
+    const int block_size = 256;
+    int64_t blocks = (total_out + block_size - 1) / block_size;
+    if (blocks > 2147483647) blocks = 2147483647;
+    adaptive_avg_pool2d_kernel<<<static_cast<unsigned int>(blocks), block_size, 0, stream>>>(
+        input, output, N, C, H, W, out_h, out_w);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,74 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void custom_abs_launcher(
+    const float* input,
+    float* output,
+    int64_t numel,
+    cudaStream_t stream);
+
+extern "C" void adaptive_avg_pool2d_launcher(
+    const float* input,
+    float* output,
+    int64_t N, int64_t C, int64_t H, int64_t W,
+    int64_t out_h, int64_t out_w,
+    cudaStream_t stream);
+
+// Wrapper for custom_abs_forward
+torch::Tensor custom_abs_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "custom_abs_forward: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "custom_abs_forward: input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "custom_abs_forward: input must be contiguous");
+
+    auto output = torch::empty_like(x);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_abs_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        x.numel(),
+        stream
+    );
+
+    return output;
+}
+
+// Wrapper for adaptive_avg_pool2d_forward
+torch::Tensor adaptive_avg_pool2d_forward(torch::Tensor x, int64_t out_h, int64_t out_w) {
+    TORCH_CHECK(x.is_cuda(), "adaptive_avg_pool2d_forward: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "adaptive_avg_pool2d_forward: input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "adaptive_avg_pool2d_forward: input must be contiguous");
+    TORCH_CHECK(x.dim() == 4, "adaptive_avg_pool2d_forward: input must be 4D (N,C,H,W)");
+    TORCH_CHECK(out_h > 0 && out_w > 0, "adaptive_avg_pool2d_forward: output dimensions must be positive");
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+
+    auto output = torch::empty({N, C, out_h, out_w}, x.options());
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    adaptive_avg_pool2d_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C, H, W,
+        out_h, out_w,
+        stream
+    );
+
+    return output;
+}
+
+// Registration
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_abs_forward", &custom_abs_forward, "Element-wise absolute value", py::arg("x"));
+    m.def("adaptive_avg_pool2d_forward", &adaptive_avg_pool2d_forward, "2D adaptive average pooling",
+          py::arg("x"), py::arg("out_h"), py::arg("out_w"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,27 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, pool_size):
+        super().__init__()
+        # 参考模型不注册任何参数，state_dict 为空
+        self.pool_size = pool_size
+
+    def forward(self, x):
+        x = cuda_extension.custom_abs_forward(x)
+        x = cuda_extension.adaptive_avg_pool2d_forward(
+            x, self.pool_size[0], self.pool_size[1]
+        )
+        return x
+
+    def debug_forward(self, x):
+        # 按 task_contract 检查点顺序 yield (id, value)
+        x = cuda_extension.custom_abs_forward(x)
+        yield "step_001", x
+        x = cuda_extension.adaptive_avg_pool2d_forward(
+            x, self.pool_size[0], self.pool_size[1]
+        )
+        yield "step_002", x
+        yield "step_003", x
