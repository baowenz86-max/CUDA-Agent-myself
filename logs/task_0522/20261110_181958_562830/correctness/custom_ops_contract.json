{
  "operators": [
    {
      "name": "batch_norm_eval",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[512,3,128,128]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[3]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[3]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[3]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[3]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[512,3,128,128]"
      },
      "semantics": [
        "对应参考语句 x = self.batch_norm(x)，在 eval 模式下执行 y = (x - running_mean[c]) / sqrt(running_var[c] + eps) * weight[c] + bias[c]",
        "axis 为通道维度 C=1，保持 N,H,W 不变",
        "weight 或 bias 可为 None，表示省略对应仿射项",
        "数值计算按 float32 执行，eps 为标量浮点数",
        "输出张量与输入 x 形状相同，dtype float32，device cuda"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x1 = torch.equal(x, x)",
      "semantics": [
        "比较输入张量与其自身是否完全相同，因是同一张量必为 True",
        "结果不参与后续计算，仅作为调试检查点"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.batch_norm(x)",
      "semantics": [
        "以 eval 模式执行 BatchNorm2d 前向：按通道标准化后应用仿射变换",
        "具体公式为 (x - running_mean) / sqrt(running_var + eps) * weight + bias",
        "axis=1，输出形状与输入相同"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回归一化后的张量，形状 [512,3,128,128]，dtype float32，device cuda"
      ]
    }
  ]
}