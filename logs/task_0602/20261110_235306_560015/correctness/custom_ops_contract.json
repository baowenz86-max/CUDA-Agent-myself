{
  "operators": [
    {
      "name": "custom_softplus",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference step",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对应参考语句 x1 = self.softplus(x1) 和 x2 = self.softplus(x2)。",
        "使用 PyTorch Softplus 的默认参数 beta=1.0, threshold=20.0。",
        "公式: output = (1/beta) * log(1 + exp(beta * input))，当 input * beta > threshold 时 output = input。",
        "逐元素计算，保持输入形状、dtype 和设备。"
      ]
    },
    {
      "name": "custom_cat",
      "parameters": [
        {
          "name": "x1",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[64, 3, 1024, 512]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "x2",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[64, 3, 1024, 512]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "dtype": null,
          "device": null,
          "shape": null,
          "layout": null,
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[64, 6, 1024, 512]"
      },
      "semantics": [
        "对应参考语句 x = torch.cat((x1, x2), dim=self.dim)。",
        "沿指定维度 dim 拼接两个张量，本任务中 dim=1。",
        "输出形状为 [64, 6, 1024, 512]，dtype 和 device 与输入一致。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x1 = self.softplus(x1)",
      "semantics": [
        "对输入 x1 应用 softplus 激活，beta=1.0, threshold=20.0，输出形状与输入相同。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x2 = self.softplus(x2)",
      "semantics": [
        "对输入 x2 应用 softplus 激活，beta=1.0, threshold=20.0，输出形状与输入相同。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = torch.cat((x1, x2), dim=self.dim)",
      "semantics": [
        "将 x1 和 x2 沿维度 dim=1 拼接，输出形状为 [64, 6, 1024, 512]。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return x",
      "semantics": [
        "返回拼接后的张量。"
      ]
    }
  ]
}