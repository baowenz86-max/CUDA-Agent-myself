    "kernels/multihead_attention.cu": "#include <cuda_runtime.h>\n#include <stdint.h>\n#include <math.h>\n\n// CUDA kernel for elementwise multiplication of two tensors.\n__global__ void multiply_kernel(const float* __restrict__ a,\n                                const float* __restrict__ b,\n                                float* __restrict__ out,\n                                int64_t total_elements) {\n    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;\n    if (idx < total_elements) {\n        out[idx] = a[idx] * b[idx];\n    }\n}\n\n// CUDA kernel for stacking two tensors along a specified dimension.\n// Assumes all tensors are contiguous in memory; output is contiguous.\n// The copy is done in a grid-stride loop over the output elements.\n__global__ void stack_kernel(const float* __restrict__ a,\n                             const float* __restrict__ b,\n                             float* __restrict__ out,\n                             int64_t total_out,\n                             int64_t single_tensor_numel,\n                             int stack_dim,\n                             int64_t out_dim0,\n                             int64_t out_dim1,\n                             int64_t out_dim2,\n                             int64_t out_dim3) {\n    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;\n    if (idx >= total_out) return;\n\n    int64_t remaining = idx;\n    int64_t out_stride[4] = {out_dim1 * out_dim2 * out_dim3, out_dim2 * out_dim3, out_dim3, 1};\n    int coords[4];\n    for (int d = 0; d < 4; ++d) {\n        coords[d] = remaining / out_stride[d];\n        remaining = remaining % out_stride[d];\n    }\n\n    const float* src;\n    if (coords[stack_dim] == 0) {\n        src = a;\n    } else {\n        src = b;\n    }\n\n    int64_t in_idx = 0;\n    int in_d = 0;\n    for (int d = 0; d < 4; ++d) {\n        if (d == stack_dim) continue;\n        // compute stride for input dimension in_d\n        // Input is 3D with shape (out_dim0, out_dim1, out_dim2) if stack_dim not in those, but need general.\n        // Since output dims include the stacked dimension, input dims are output dims with stack dim removed.\n        // We'll compute stride as product of remaining dims after in_d.\n        int64_t stride = 1;\n        for (int j = in_d + 1; j < 3; ++j) {\n            // get the size of dimension j, which corresponds to output dimension after removing stack dim\n            int64_t dim_size;\n            int out_d = 0;\n            for (int k = 0; k < 4; ++k) {\n                if (k == stack_dim) continue;\n                if (out_d == j) {\n                    dim_size = (k == 0) ? out_dim0 : (k == 1 ? out_dim1 : (k == 2 ? out_dim2 : out_dim3));\n                    break;\n                }\n                out_d++;\n            }\n            stride *= dim_size;\n        }\n        in_idx += coords[d] * stride;\n        in_d++;\n    }\n\n    out[idx] = src[in_idx];\n}\n\n// Launcher for elementwise multiplication.\nextern \"C\" void multiply_forward_launcher(const float* a,\n                                          const float* b,\n                                          float* out,\n                                          int64_t total_elements,\n                                          cudaStream_t stream) {\n    int threads = 256;\n    int64_t blocks = (total_elements + threads - 1) / threads;\n    multiply_kernel<<<(unsigned int)blocks, threads, 0, stream>>>(a, b, out, total_elements);\n}\n\n// Launcher for stack operation.\nextern \"C\" void stack_forward_launcher(const float* a,\n                                       const float* b,\n                                       float* out,\n                                       int64_t total_out,\n                                       int64_t single_tensor_numel,\n                                       int stack_dim,\n                                       int64_t out_dim0,\n                                       int64_t out_dim1,\n                                       int64_t out_dim2,\n                                       int64_t out_dim3,\n                                       cudaStream_t stream) {\n    int threads = 256;\n    int64_t blocks = (total_out + threads - 1) / threads;\n    stack_kernel<<<(unsigned int)blocks, threads, 0, stream>>>(\n        a, b, out, total_out, single_tensor_numel, stack_dim,\n        out_dim0, out_dim1, out_dim2, out_dim3);\n}\n\n// ---------------------------------------------------------------------\n// Helper kernels for multihead attention\n// ---------------------------------------------------------------------\n\n// Add bias to each row of a matrix (data: rows x cols, bias length cols)\n__global__ void add_bias_kernel(float* __restrict__ data,\n                                const float* __restrict__ bias,\n                                int rows, int cols) {\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    if (idx >= rows * cols) return;\n    int col = idx % cols;\n    data[idx] += bias[col];\n}\n\n// Transpose a square matrix (size x size) stored row-major\n__global__ void transpose_square_kernel(const float* __restrict__ input,\n                                        float* __restrict__ output,\n                                        int size) {\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    if (idx >= size * size) return;\n    int row = idx / size;\n    int col = idx % size;\n    output[col * size + row] = input[idx];\n}\n\n// Softmax kernel for attention scores with optional key padding mask.\n// scores shape: (batch_size, num_heads, seq_len, seq_len)\n// key_padding_mask shape: (batch_size, seq_len), bool as uint8_t (1 = masked)\n__global__ void softmax_mask_kernel(float* __restrict__ scores,\n                                    const uint8_t* __restrict__ key_padding_mask,\n                                    int batch_size,\n                                    int num_heads,\n                                    int seq_len,\n                                    float scale) {\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int total = batch_size * num_heads * seq_len;\n    if (idx >= total) return;\n\n    int s = idx % seq_len;\n    int h = (idx / seq_len) % num_heads;\n    int b = idx / (seq_len * num_heads);\n\n    float* row = scores + ((b * num_heads + h) * seq_len + s) * seq_len;\n\n    // First pass: apply mask and find max\n    float max_val = -1e30f;\n    for (int k = 0; k < seq_len; ++k) {\n        float val = row[k];\n        if (key_padding_mask && key_padding_mask[b * seq_len + k]) {\n            val = -1e30f;\n            row[k] = val;\n        }\n        val *= scale;\n        row[k] = val;\n        if (val > max_val) max_val = val;\n    }\n\n    // Second pass: exp and sum\n    float sum = 0.0f;\n    for (int k = 0; k < seq_len; ++k) {\n        float val = __expf(row[k] - max_val);\n        row[k] = val;\n        sum += val;\n    }\n\n    // Third pass: normalize\n    float inv_sum = 1.0f / sum;\n    for (int k = 0; k < seq_len; ++k) {\n        row[k] *= inv_sum;\n    }\n}\n\n// Permute kernel: (batch, seq_len, embed_dim) -> (batch, num_heads, seq_len, head_dim)\n// input is contiguous with shape (batch, seq_len, num_heads, head_dim) but we want heads as separate dimension.\n// Actually, PyTorch's linear output for each batch is (seq_len, embed_dim) where embed_dim = num_heads * head_dim,\n// and heads are interleaved: for each seq position, there are num_heads blocks of head_dim contiguous.\n// This kernel reorders to (batch, num_heads, seq_len, head_dim).\n__global__ void permute_to_heads_kernel(const float* __restrict__ input,\n                                       float* __restrict__ output,\n                                       int batch_size, int seq_len, int num_heads, int head_dim) {\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int total = batch_size * seq_len * num_heads * head_dim;\n    if (idx >= total) return;\n\n    int d = idx % head_dim;\n    int h = (idx / head_dim) % num_heads;\n    int s = (idx / (head_dim * num_heads)) % seq_len;\n    int b = idx / (head_dim * num_heads * seq_len);\n\n    // Input index: (b * seq_len + s) * (num_heads * head_dim) + h * head_dim + d\n    int in_idx = ((b * seq_len + s) * num_heads + h) * head_dim + d;\n    output[idx] = input[in_idx];\n}\n\n// Inverse permute: (batch, num_heads, seq_len, head_dim) -> (batch, seq_len, embed_dim)\n// where embed_dim = num_heads * head_dim, with heads interleaved.\n__global__ void permute_to_seq_kernel(const float* __restrict__ input,\n                                      float* __restrict__ output,\n                                      int batch_size, int seq_len, int num_heads, int head_dim) {\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int total = batch_size * num_heads * seq_len * head_dim;\n    if (idx >= total) return;\n\n    int d = idx % head_dim;\n    int s = (idx / head_dim) % seq_len;\n    int h = (idx / (head_dim * seq_len)) % num_heads;\n    int b = idx / (head_dim * seq_len * num_heads);\n\n    int out_idx = ((b * seq_len + s) * num_heads + h) * head_dim + d;\n    output[out_idx] = input[idx];\n}\n\n// Tiled GEMM kernel for row-major matrices: C = alpha * A * B + beta * C\n// A: M x K, B: K x N, C: M x N\n// Block dimensions are compile-time constants for tile sizes\n#define TILE_M 32\n#define TILE_N 32\n#define TILE_K 32\n\ntemplate<int BLOCK_M, int BLOCK_N, int BLOCK_K>\n__global__ void gemm_kernel(const float* __restrict__ A,\n                            const float* __restrict__ B,\n                            float* __restrict__ C,\n                            int M, int N, int K,\n                            float alpha, float beta,\n                            int lda, int ldb, int ldc) {\n    __shared__ float As[BLOCK_M][BLOCK_K];\n    __shared__ float Bs[BLOCK_K][BLOCK_N];\n\n    int bx = blockIdx.x * BLOCK_N;\n    int by = blockIdx.y * BLOCK_M;\n    int tx = threadIdx.x;\n    int ty = threadIdx.y;\n\n    int row = by + ty;\n    int col = bx + tx;\n\n    float c_val = 0.0f;\n\n    for (int kk = 0; kk < K; kk += BLOCK_K) {\n        // Load A tile\n        if (row < M && kk + tx < K) {\n            As[ty][tx] = A[row * lda + kk + tx];\n        } else {\n            As[ty][tx] = 0.0f;\n        }\n        // Load B tile\n        if (kk + ty < K && col < N) {\n            Bs[ty][tx] = B[(kk + ty) * ldb + col];\n        } else {\n            Bs[ty][tx] = 0.0f;\n        }\n        __syncthreads();\n\n        #pragma unroll\n        for (int k = 0; k < BLOCK_K; ++k) {\n            c_val += As[ty][k] * Bs[k][tx];\n        }\n        __syncthreads();\n    }\n\n    if (row < M && col < N) {\n        C[row * ldc + col] = alpha * c_val + beta * C[row * ldc + col];\n    }\n}\n\n// Batched GEMM kernel for row-major matrices: C = alpha * A * B + beta * C\n// A: M x K, B: K x N, C: M x N, with batch dimension batch_count.\n// Strides: A stride between batches is strideA, etc. Pointers point to the first batch element.\n// Grid: (ceil(N/TILE_N), ceil(M/TILE_M), batch_count)\ntemplate<int BLOCK_M, int BLOCK_N, int BLOCK_K>\n__global__ void batched_gemm_kernel(const float* __restrict__ A,\n                                    const float* __restrict__ B,\n                                    float* __restrict__ C,\n                                    int M, int N, int K,\n                                    float alpha, float beta,\n                                    int lda, int ldb, int ldc,\n                                    int64_t strideA, int64_t strideB, int64_t strideC) {\n    __shared__ float As[BLOCK_M][BLOCK_K];\n    __shared__ float Bs[BLOCK_K][BLOCK_N];\n\n    int batch_idx = blockIdx.z;\n    const float* A_batch = A + batch_idx * strideA;\n    const float* B_batch = B + batch_idx * strideB;\n    float* C_batch = C + batch_idx * strideC;\n\n    int bx = blockIdx.x * BLOCK_N;\n    int by = blockIdx.y * BLOCK_M;\n    int tx = threadIdx.x;\n    int ty = threadIdx.y;\n\n    int row = by + ty;\n    int col = bx + tx;\n\n    float c_val = 0.0f;\n\n    for (int kk = 0; kk < K; kk += BLOCK_K) {\n        if (row < M && kk + tx < K) {\n            As[ty][tx] = A_batch[row * lda + kk + tx];\n        } else {\n            As[ty][tx] = 0.0f;\n        }\n        if (kk + ty < K && col < N) {\n            Bs[ty][tx] = B_batch[(kk + ty) * ldb + col];\n        } else {\n            Bs[ty][tx] = 0.0f;\n        }\n        __syncthreads();\n\n        #pragma unroll\n        for (int k = 0; k < BLOCK_K; ++k) {\n            c_val += As[ty][k] * Bs[k][tx];\n        }\n        __syncthreads();\n    }\n\n    if (row < M && col < N) {\n        C_batch[row * ldc + col] = alpha * c_val + beta * C_batch[row * ldc + col];\n    }\n}\n\n// Launcher for non-batched GEMM\nvoid launch_gemm(const float* A, const float* B, float* C,\n                 int M, int N, int K,\n                 float alpha, float beta,\n                 int lda, int ldb, int ldc,\n                 cudaStream_t stream) {\n    dim3 block(TILE_N, TILE_M);\n    dim3 grid((N + TILE_N - 1) / TILE_N, (M + TILE_M - 1) / TILE_M);\n    gemm_kernel<TILE_M, TILE_N, TILE_K><<<grid, block, 0, stream>>>(\n        A, B, C, M, N, K, alpha, beta, lda, ldb, ldc);\n}\n\n// Launcher for batched GEMM\nvoid launch_batched_gemm(const float* A, const float* B, float* C,\n                         int M, int N, int K,\n                         float alpha, float beta,\n                         int lda, int ldb, int ldc,\n                         int64_t strideA, int64_t strideB, int64_t strideC,\n                         int batch_count,\n                         cudaStream_t stream) {\n    dim3 block(TILE_N, TILE_M);\n    dim3 grid((N + TILE_N - 1) / TILE_N, (M + TILE_M - 1) / TILE_M, batch_count);\n    batched_gemm_kernel<TILE_M, TILE_N, TILE_K><<<grid, block, 0, stream>>>(\n        A, B, C, M, N, K, alpha, beta, lda, ldb, ldc, strideA, strideB, strideC);\n}\n\n// Main laun