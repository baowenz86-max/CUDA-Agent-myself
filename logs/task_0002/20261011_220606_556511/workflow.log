import torch
import torch.nn as nn
import cuda_extension

class ModelNew(nn.Module):
    def __init__(self, in_channels, num_groups, num_features):
        super().__init__()
        self.num_groups = num_groups
        self.num_features = num_features

    def forward(self, x):
        # x: (N, C, H, W) float32, contiguous, CUDA
        # Step 1: Ceil
        x = cuda_extension.ceil_forward(x)
        # Step 2: Transpose 1,2 -> (N, H, C, W)
        x = cuda_extension.transpose_1_2_forward(x)
        # Step 3: GroupNorm
        x = cuda_extension.group_norm_forward(x, self.num_groups)
        return x


===== 现有 CUDA/C++ kernel 文件 =====

===== kernels/fused_ops.cu =====
// Fused operations: ceil, transpose, group_norm
#include <cuda_runtime.h>
#include <torch/types.h>
#include <c10/cuda/CUDAStream.h>
#include <torch/csrc/utils/pybind.h>
#include <cuda.h>
#include <cuda_fp16.h>

// CUDA error check macro
#define CUDA_CHECK(condition) \
  do { \
    cudaError_t error = condition; \
    if (error != cudaSuccess) { \
      throw std::runtime_error(cudaGetErrorString(error)); \
    } \
  } while (0)

// ceil kernel: element-wise ceil on float tensor
__global__ void ceil_kernel(float* output, const float* input, int total_elements) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx < total_elements) {
        output[idx] = ceilf(input[idx]);
    }
}

// transpose kernel: transposes dims 1 and 2 for float tensor
__global__ void transpose_1_2_kernel(float* output, const float* input,
                                     int dim1, int dim2, int dim3, int total_elements) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx < total_elements) {
        // Compute source index for transpose of axes 1 and 2
        // input shape: (dim1, dim2, dim3) e.g., (C, H, W)
        // output shape: (dim2, dim1, dim3) e.g., (H, C, W)
        // idx in output: ((i2 * dim1 + i1) * dim3 + i3)
        // corresponding input index: ((i1 * dim2 + i2) * dim3 + i3)
        int i3 = idx % dim3;
        int tmp = idx / dim3;
        int i2 = tmp % dim1;  // careful: output dim1 corresponds to input dim2? Actually need careful mapping
        int i1 = tmp / dim1;
        int input_idx = (i1 * dim2 + i2) * dim3 + i3;
        output[idx] = input[input_idx];
    }
}

// group norm kernel: computes mean and variance, then normalizes
// We'll use two-pass approach: first compute mean and variance per group per sample,
// then normalize.
// For simplicity and correctness, we'll use atomic operations or separate kernels.
// Better: use warp/block reductions, but we need per (batch, group) statistics.
// Here we implement a straightforward kernel that computes per-element normalization
// using a hierarchical reduction.

// To avoid complexities, we'll implement group_norm as a single kernel with shared memory,
// assuming each block handles one (sample, group) pair. But dimensions may be large,
// so we need to split.
// Let's compute statistics using a custom reduction kernel and then apply.

// Step 1: Compute mean and variance per (N, G) using reduction.
// We'll output mean and rstd (reciprocal std) arrays of size N*G.

// Helper: atomic addition for float global memory not available, so we need a separate reduction.
// Actually, we can use a two-kernel approach: first kernel does partial sums per block into temporary buffer,
// second kernel completes reduction per (N,G), then third kernel normalizes.

// But for simplicity, we can use a single kernel that processes each group using one block per group,
// with gridDim = N*G. The block iterates over the C/G * H * W elements, using shared memory reduction.

#define MAX_GROUP_ELEMS 4096  // we'll handle up to 4096 elems in shared? Actually number of elements per group is (C/G)*H*W.
// For given dims: N=512, C=32, G=4, H=128, W=128 => elems per group = (32/4)*128*128 = 8*16384=131072, too large for shared memory.
// So we need to split the reduction across multiple blocks using atomic or multi-pass.

// Better approach: use a grid of blocks, each block handles a chunk of elements, performs partial sum and sum of squares,
// then atomically adds to global accumulators. After that, a second kernel divides by total count to get mean and variance,
// then a third kernel normalizes using those statistics.

// For performance, we can fuse some operations. Since the requirement is 5% faster than torch.compile, we should aim for efficiency.
// We'll implement a fused kernel that computes mean/var using two-pass within block reduction with grid-level reduction via atomicAdd on float (supported on sm_60+).

// We'll create three kernels:
// 1. group_norm_stats_kernel: computes partial sums and sumsq per (n,g) into global buffers using atomicAdd
// 2. finalize_stats_kernel: computes mean and rstd from accumulated sums
// 3. group_norm_apply_kernel: applies normalization using mean and rstd

// But we can combine ceil and transpose into group_norm? Not easily because transpose changes layout.
