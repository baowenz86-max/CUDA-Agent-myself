// Binding for multihead attention, multiply, and stack kernels
#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>
#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

// Declaration of launchers from .cu file
extern "C" void multiply_forward_launcher(const float* a, const float* b, float* out, int64_t total_elements, cudaStream_t stream);
extern "C" void stack_forward_launcher(const float* a, const float* b, float* out, int64_t total_out, int64_t single_tensor_numel, int stack_dim, int64_t out_dim0, int64_t out_dim1, int64_t out_dim2, int64_t out_dim3, cudaStream_t stream);
extern "C" void multihead_attention_forward_launcher(
    const float* query, const float* key, const float* value,
    const float* in_proj_weight, const float* in_proj_bias,
    const float* out_proj_weight, const float* out_proj_bias,
    const uint8_t* key_padding_mask, float* out,
    int batch_size, int seq_len, int embed_dim, int num_heads,
    cudaStream_t stream);

// Wrapper for elementwise multiplication
torch::Tensor multiply_forward(torch::Tensor a, torch::Tensor b) {
    TORCH_CHECK(a.is_cuda(), "Input a must be CUDA");
    TORCH_CHECK(b.is_cuda(), "Input b must be CUDA");
    TORCH_CHECK(a.dtype() == torch::kFloat32, "Input a must be float32");
    TORCH_CHECK(b.dtype() == torch::kFloat32, "Input b must be float32");
    TORCH_CHECK(a.is_contiguous(), "Input a must be contiguous");
    TORCH_CHECK(b.is_contiguous(), "Input b must be contiguous");
    TORCH_CHECK(a.numel() == b.numel(), "Inputs must have same number of elements");

    auto out = torch::empty_like(a);
    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
    multiply_forward_launcher(
        a.data_ptr<float>(),
        b.data_ptr<float>(),
        out.data_ptr<float>(),
        a.numel(),
        stream
    );
    return out;
}

// Wrapper for stacking two tensors along a dimension
torch::Tensor stack_forward(torch::Tensor a, torch::Tensor b, int64_t dim) {
    TORCH_CHECK(a.is_cuda(), "Input a must be CUDA");
    TORCH_CHECK(b.is_cuda(), "Input b must be CUDA");
    TORCH_CHECK(a.dtype() == torch::kFloat32, "Input a must be float32");
    TORCH_CHECK(b.dtype() == torch::kFloat32, "Input b must be float32");
    TORCH_CHECK(a.is_contiguous(), "Input a must be contiguous");
    TORCH_CHECK(b.is_contiguous(), "Input b must be contiguous");
    TORCH_CHECK(a.sizes() == b.sizes(), "Inputs must have same shape");
    TORCH_CHECK(dim >= 0 && dim <= a.dim(), "Invalid stack dimension");

    auto out_sizes = a.sizes().vec();
    out_sizes.insert(out_sizes.begin() + dim, 2);
    auto out = torch::empty(out_sizes, a.options());

    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
    int64_t total_out = out.numel();
    int64_t single_numel = a.numel();
    // Since a.dim() is at most 3 (from model), we pass dimensions as if 4D with inserted dim.
    // If a is 3D, output is 4D. If a is 2D, output is 3D, etc. We'll pad with 1s.
    int64_t d0 = 1, d1 = 1, d2 = 1, d3 = 1;
    auto sizes = out.sizes();
    int rank = out.dim();
    // Fill from the end: d3 is last dimension, etc.
    int idx = 0;
    if (rank >= 1) d0 = sizes[0];
    if (rank >= 2) d1 = sizes[1];
    if (rank >= 3) d2 = sizes[2];
    if (rank >= 4) d3 = sizes[3];
    // For our model, a is 3D, so out is 4D. stack_dim is 1. So d0=batch, d1=2, d2=seq_len, d3=embed_dim.
    // The kernel expects out_dim0..out_dim3 as the full output dimensions.
    stack_forward_launcher(
        a.data_ptr<float>(),
        b.data_ptr<float>(),
        out.data_ptr<float>(),
        total_out,
        single_numel,
        (int)dim,
        d0, d1, d2, d3,
        stream
    );
    return out;
}

// Wrapper for multihead attention forward
torch::Tensor multihead_attention_forward(
    torch::Tensor query, torch::Tensor key, torch::Tensor value,
    torch::Tensor in_proj_weight, torch::Tensor in_proj_bias,
    torch::Tensor out_proj_weight, torch::Tensor out_proj_bias,
    torch::Tensor key_padding_mask,
    int64_t embed_dim, int64_t num_heads, bool batch_first)
{
    TORCH_CHECK(batch_first, "Only batch_first=True is supported");
    TORCH_CHECK(query.is_cuda() && key.is_cuda() && value.is_cuda(), "Inputs must be CUDA");
    TORCH_CHECK(in_proj_weight.is_cuda() && out_proj_weight.is_cuda(), "Weights must be CUDA");
    if (in_proj_bias.defined()) TORCH_CHECK(in_proj_bias.is_cuda(), "in_proj_bias must be CUDA");
    if (out_proj_bias.defined()) TORCH_CHECK(out_proj_bias.is_cuda(), "out_proj_bias must be CUDA");
    TORCH_CHECK(key_padding_mask.is_cuda(), "key_padding_mask must be CUDA");
    TORCH_CHECK(query.dtype() == torch::kFloat32, "All tensors must be float32");
    TORCH_CHECK(key_padding_mask.dtype() == torch::kBool, "key_padding_mask must be bool");
    TORCH_CHECK(query.is_contiguous() && key.is_contiguous() && value.is_contiguous(), "Inputs must be contiguous");
    TORCH_CHECK(in_proj_weight.is_contiguous() && out_proj_weight.is_contiguous(), "Weights must be contiguous");
    if (in_proj_bias.defined()) TORCH_CHECK(in_proj_bias.is_contiguous(), "Biases must be contiguous");
    if (out_proj_bias.defined()) TORCH_CHECK(out_proj_bias.is_contiguous(), "Biases must be contiguous");
    TORCH_CHECK(key_padding_mask.is_contiguous(), "Mask must be contiguous");

    TORCH_CHECK(query.dim() == 3, "Query must be 3D (batch, seq, embed)");
    TORCH_CHECK(key.dim() == 3 && value.dim() == 3, "Key/Value must be 3D");
    int64_t batch_size = query.size(0);
    int64_t seq_len = query.size(1);
    TORCH_CHECK(query.size(2) == embed_dim, "Query last dim must equal embed_dim");
    TORCH_CHECK(key.size(0) == batch_size && key.size(1) == seq_len, "Key shape mismatch");
    TORCH_CHECK(value.size(0) == batch_size && value.size(1) == seq_len, "Value shape mismatch");
    TORCH_CHECK(in_proj_weight.size(0) == 3 * embed_dim && in_proj_weight.size(1) == embed_dim, "in_proj_weight shape must be (3*embed_dim, embed_dim)");
    TORCH_CHECK(out_proj_weight.size(0) == embed_dim && out_proj_weight.size(1) == embed_dim, "out_proj_weight shape must be (embed_dim, embed_dim)");
    TORCH_CHECK(key_padding_mask.size(0) == batch_size && key_padding_mask.size(1) == seq_len, "Mask shape must be (batch, seq)");
    if (in_proj_bias.defined()) TORCH_CHECK(in_proj_bias.numel() == 3 * embed_dim, "in_proj_bias size mismatch");
    if (out_proj_bias.defined()) TORCH_CHECK(out_proj_bias.numel() == embed_dim, "out_proj_bias size mismatch");

    auto out = torch::empty_like(query);
    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    const float* in_bias_ptr = in_proj_bias.defined() ? in_proj_bias.data_ptr<float>() : nullptr;
    const float* out_bias_ptr = out_proj_bias.defined() ? out_proj_bias.data_ptr<float>() : nullptr;
    const uint8_t* mask_ptr = key_padding_mask.data_ptr<uint8_t>(); // bool is stored as uint8_t in CUDA

    multihead_attention_forward_launcher(
        query.data_ptr<float>(),
        key.data_ptr<float>(),
        value.data_ptr<float>(),
        in_proj_weight.data_ptr<float>(),
        in_bias_ptr,
        out_proj_weight.data_ptr<float>(),
        out_bias_ptr,
        mask_ptr,
        out.data_ptr<float>(),
        (int)batch_size,
        (int)seq_len,
        (int)embed_dim,
        (int)num_heads,
        stream
    );
    return out;
}

// Register all functions
void register_multihead_attention_binding(pybind11::module& m) {
    m.def("multiply_forward", &multiply_forward, "Elementwise multiplication");
    m.def("stack_forward", &stack_forward, "Stack two tensors along dim");
    m.def("multihead_attention_forward", &multihead_attention_forward,
          "Multihead attention forward",
          py::arg("query"), py::arg("key"), py::arg("value"),
          py::arg("in_proj_weight"), py::arg("in_proj_bias"),
          py::arg("out_proj_weight"), py::arg("out_proj_bias"),
          py::arg("key_padding_mask"),
          py::arg("embed_dim"), py::arg("num_heads"), py::arg("batch_first"));
}

REGISTER_BINDING(multihead_attention, register_multihead_attention_binding);
