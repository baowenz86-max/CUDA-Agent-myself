to produce K_T_heads.\n    // We'll write a kernel to produce K_T_heads from K_heads.\n    // We'll define a global kernel below.\n\n    // Forward declaration? We'll define the kernel before use.\n    // Actually, we'll define it now.\n    // (Since this is a single file, we can define it above this function. But we are inside function, so we need to have defined it earlier.\n    // We'll move the kernel definition up after the other kernels.\n    // For now, we'll assume it exists: transpose_heads_kernel\n    // We'll call it.\n    // To avoid missing, we'll define it later in this file before use. Since this function is defined after all kernel definitions, it's fine.\n\n    // Placeholder: we will call the kernel here, but it's defined above this function.\n    {\n        int total_elements = batch_count * seq_len * head_dim;\n        int threads = 256;\n        int blocks = (total_elements + threads - 1) / threads;\n        transpose_heads_kernel<<<blocks, threads, 0, stream>>>(K_heads, K_T_heads, batch_count, seq_len, head_dim);\n    }\n\n    // Allocate scores: batch_count * seq_len * seq_len\n    cudaMalloc(&scores, batch_count * seq_len * seq_len * sizeof(float));\n\n    // Compute scores = Q_heads * K_T_heads, scaled by 1/sqrt(head_dim)\n    // Q_heads is (batch_count, seq_len, head_dim) row-major, stride = seq_len * head_dim\n    // K_T_heads is (batch_count, head_dim, seq_len) row-major, stride = head_dim * seq_len\n    // scores is (batch_count, seq_len, seq_len) row-major, stride = seq_len * seq_len\n    // The GEMM per batch: C = A * B, where A is seq_len x head_dim, B is head_dim x seq_len.\n    // So M = seq_len, N = seq_len, K = head_dim.\n    float scale = 1.0f / sqrtf((float)head_dim);\n    launch_batched_gemm(Q_heads, K_T_heads, scores,\n                        seq_len, seq_len, head_dim,\n                        scale, beta_zero,\n                        head_dim, seq_len, seq_len,\n                        seq_len * head_dim, head_dim * seq_len