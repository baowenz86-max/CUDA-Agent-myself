  do { \
    cudaError_t error = condition; \
    if (error != cudaSuccess) { \
      throw std::runtime_error(cudaGetErrorString(error)); \
    } \
  } while (0)

// ceil kernel: element-wise ceil on float tensor
__global__ void ceil_kernel(float* output, const float* input, int total_elements) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx < total_elements) {
        output[idx] = ceilf(input[idx]);
    }
}

// transpose kernel: transposes dims 1 and 2 for float tensor
__global__ void transpose_1_2_kernel(float* output, const float* input,
                                     int dim1, int dim2, int dim3, int total_elements) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx < total_elements) {
        // Compute source index for transpose of axes 1 and 2
        // input shape: (dim1, dim2, dim3) e.g., (C, H, W)
        // output shape: (dim2, dim1, dim3) e.g., (H, C, W)
        // idx in output: ((i2 * dim1 + i1) * dim3 + i3)
        // corresponding input index: ((i1 * dim2 + i2) * dim3 + i3)
        int i3 = idx % dim3;
        int tmp = idx / dim3;
        int i2 = tmp % dim1;  // careful: output dim1 corresponds to input dim2? Actually need careful mapping
        int i1 = tmp / dim1;
        int input_idx = (i1 * dim2 + i2) * dim3 + i3;
        output[idx] = input[input_idx];
    }
}

