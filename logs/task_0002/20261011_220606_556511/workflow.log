v, Wv_T, embed_dim);\n    }\n\n    // Allocate Q, K, V: each M x embed_dim\n    cudaMalloc(&Q, M * embed_dim * sizeof(float));\n    cudaMalloc(&K, M * embed_dim * sizeof(float));\n    cudaMalloc(&V, M * embed_dim * sizeof(float));\n\n    // Compute Q = query * Wq_T + bq, etc.\n    // query, key, value are M x embed_dim row-major, lda=embed_dim\n    launch_gemm(query, Wq_T, Q, M, embed_dim, embed_dim, alpha, beta_zero, embed_dim, embed_dim, embed_dim, stream);\n    launch_gemm(key, Wk_T, K, M, embed_dim, embed_dim, alpha, beta_zero, embed_dim, embed_dim, embed_dim, stream);\n    launch_gemm(value, Wv_T, V, M, embed_dim, embed_dim, alpha, beta_zero, embed_dim, embed_dim, embed_dim, stream);\n\n    // Add bias if provided\n    if (in_proj_bias) {\n        const float* bq = in_proj_bias;\n        const float* bk = in_proj_bias + embed_dim;\n        const float* bv = in_proj_bias + 2 * embed_dim;\n        int bias_threads = 256;\n        int bias_blocks = (M * embed_dim + bias_threads - 1) / bias_threads;\n        add_bias_kernel<<<bias_blocks, bias_threads, 0, stream>>>(Q, bq, M, embed_dim);\n        add_bias_kernel<<<bias_blocks, bias_threads, 0, stream>>>(K, bk, M, embed_dim);\n        add_bias_kernel<<<bias_blocks, bias_threads, 0, stream>>>(V, bv, M, embed_dim);\n    }\n\n    // Allocate Q_heads, K_heads, V_heads: each batch * num_heads * seq_len * head_dim\n    cudaMalloc(&Q_heads, batch_count * seq_len * head_dim * sizeof(float));\n    cudaMalloc(&K_heads, batch_count * seq_len * head_dim * sizeof(float));\n    cudaMalloc(&V_heads, batch_count * seq_len * head_dim * sizeof(float));\n\n    // Permute Q, K, V from (batch, seq_len, embed_dim) to (batch, num_heads, seq_len, head_dim)\n    {\n        int perm_threads = 256;\n        int perm_blocks = (M * embed_dim + perm_threads - 1) / perm_threads;\n        permute_to_heads_kernel<<<perm_blocks, perm_threads, 0, stream>>>(Q, Q_heads, batch_size, seq_len, num_heads, head_dim);\n        permute_to_heads_kernel<<<perm_b