#include <cuda_runtime.h>
#include <stdint.h>
#include <math.h>

// CUDA kernel for elementwise multiplication of two tensors.
__global__ void multiply_kernel(const float* __restrict__ a,
                                const float* __restrict__ b,
                                float* __restrict__ out,
                                int64_t total_elements) {
    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
    if (idx < total_elements) {
        out[idx] = a[idx] * b[idx];
    }
}

// CUDA kernel for stacking two tensors along a specified dimension.
// Assumes all tensors are contiguous in memory; output is contiguous.
// The copy is done in a grid-stride loop over the output elements.
__global__ void stack_kernel(const float* __restrict__ a,
                             const float* __restrict__ b,
                             float* __restrict__ out,
                             int64_t total_out,
                             int64_t single_tensor_numel,
                             int stack_dim,
                             int64_t out_dim0,
                             int64_t out_dim1,
                             int64_t out_dim2,
                             int64_t out_dim3) {
    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
    if (idx >= total_out) return;

    int64_t remaining = idx;
    int64_t out_stride[4] = {out_dim1 * out_dim2 * out_dim3, out_dim2 * out_dim3, out_dim3, 1};
    int coords[4];
    for (int d = 0; d < 4; ++d) {
        coords[d] = remaining / out_stride[d];
        remaining = remaining % out_stride[d];
    }

    const float* src;
    if (coords[stack_dim] == 0) {
        src = a;
    } else {
        src = b;
    }

    int64_t in_idx = 0;
    int in_d = 0;
    for (int d = 0; d < 4; ++d) {
        if (d == stack_dim) continue;
        // compute stride for input dimension in_d
        // Input is 3D with shape (out_dim0, out_dim1, out_dim2) if stack_dim not in those, but need general.
        // Since output dims include the stacked dimension, input dims are output dims with stack dim removed.
        // We'll compute stride as product of remaining dims after in_d.
        int64_t stride = 1;
        for (int j = in_d + 1; j < 3; ++j) {
            // get the size of dimension j, which corresponds to output dimension after removing stack dim
            int64_t dim_size;
            int out_d = 0;
            for (int k = 0; k < 4; ++k) {
                if (k == stack_dim) continue;
                if (out_d == j) {
                    dim_size = (k == 0) ? out_dim0 : (k == 1 ? out_dim1 : (k == 2 ? out_dim2 : out_dim3));
                    break;
                }
                out_d++;
            }
            stride *= dim_size;
        }
        in_idx += coords[d] * stride;
        in_d++;
    }

    out[idx] = src[in_idx];
}

// Launcher for elementwise multiplication.
extern "C" void multiply_forward_launcher(const float* a,
                                          const float* b,
                                          float* out,
                                          int64_t total_elements,
                                          cudaStream_t stream) {
    int threads = 256;
    int64_t blocks = (total_elements + threads - 1) / threads;
    multiply_kernel<<<(unsigned int)blocks, threads, 0, stream>>>(a, b, out, total_elements);
}

// Launcher for stack operation.
extern "C" void stack_forward_launcher(const float* a,
                                       const float* b,
                                       float* out,
                                       int64_t total_out,
                                       int64_t single_tensor_numel,
                                       int stack_dim,
                                       int64_t out_dim0,
                                       int64_t out_dim1,
                                       int64_t out_dim2,
                                       int64_t out_dim3,
                                       cudaStream_t stream) {
    int threads = 256;
    int64_t blocks = (total_out + threads - 1) / threads;
    stack_kernel<<<(unsigned int)blocks, threads, 0, stream>>>(
        a, b, out, total_out, single_tensor_numel, stack_dim,
        out_dim0, out_dim1, out_dim2, out_dim3);
}

// ---------------------------------------------------------------------
// Helper kernels for multihead attention
// ---------------------------------------------------------------------

// Add bias to each row of a matrix (data: rows x cols, bias length cols)
__global__ void add_bias_kernel(float* __restrict__ data,
                                const float* __restrict__ bias,
                                int rows, int cols) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= rows * cols) return;
    int col = idx % cols;
    data[idx] += bias[col];
}

// Transpose a square matrix (size x size) stored row-major
__global__ void transpose_square_kernel(const float* __restrict__ input,
                                        float* __restrict__ output,
                                        int size) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= size * size) return;
    int row = idx / size;
    int col = idx % size;
    output[col * size + row] = input[idx];
}

// Softmax kernel for attention scores with optional key padding mask.
// scores shape: (batch_size, num_heads, seq_len, seq_len)
// key_padding_mask shape: (batch_size, seq_len), bool as uint8_t (1 = masked)
__global__ void softmax_mask_kernel(float* __restrict__ scores,
                                    const uint8_t* __restrict__ key_padding_mask,
                                    int batch_size,
                                    int num_heads,
                                    int seq_len,
                                    float scale) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int total = batch_size * num_heads * seq_len;
    if (idx >= total) return;

    int s = idx % seq_len;
    int h = (idx / seq_len) % num_heads;
    int b = idx / (seq_len * num_heads);

    float* row = scores + ((b * num_heads + h) * seq_len + s) * seq_len;

    // First pass: apply mask and find max
    float max_val = -1e30f;
    for (int k = 0; k < seq_len; ++k) {
        float val = row[k];
        if (key_padding_mask && key_padding_mask[b * seq_len + k]) {
            val = -1e30f;
            row[k] = val;
        }
        val *= scale;
        row[k] = val;
        if (val > max_val) max_val = val;
    }

    // Second pass: exp and sum
    float sum = 0.0f;
    for (int k = 0; k < seq_len; ++k) {
        float val = __expf(row[k] - max_val);
        row[k] = val;
        sum += val;
    }

    // Third pass: normalize
    float inv_sum = 1.0f / sum;
    for (int k = 0; k < seq_len; ++k) {
        row[k] *= inv_sum;
    }
}

// Permute kernel: (batch, seq_len, embed_dim) -> (batch, num_heads, seq_len, head_dim)
// input is contiguous with shape (batch, seq_len, num_heads, head_dim) but we want heads as separate dimension.
// Actually, PyTorch's linear output for each batch is (seq_len, embed_dim) where embed_dim = num_heads * head_dim,
// and heads are interleaved: for each seq position, there are num_heads blocks of head_dim contiguous.
// This kernel reorders to (batch, num_heads, seq_len, head_dim).
__global__ void permute_to_heads_kernel(const float* __restrict__ input,
                                       float* __restrict__ output,
                                       int batch_size, int seq_len, int num_heads, int head_dim) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int total = batch_size * seq_len * num_heads * head_dim;
    if (idx >= total) return;

    int d = idx % head_dim;
    int h = (idx / head_dim) % num_heads;
    int s = (idx / (head_dim * num_heads)) % seq_len;
    int b = idx / (head_dim * num_heads * seq_len);

    // Input index: (b * seq_len + s) * (num_heads * head_dim) + h * head_dim + d
    int in_idx = ((b * seq_len + s) * num_heads + h) * head_dim + d;
    output[idx] = input[in_idx];
}

// Inverse permute: (batch, num_heads, seq_len, head_dim) -> (batch, seq_len, embed_dim)
// where embed_dim = num_heads * head_dim, with heads interleaved.
__global__ void permute_to_seq_kernel(const float* __restrict__ input,
                                      float* __restrict__ output,
                                      int batch_size, int seq_len, int num_heads, int head_dim) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int total = batch_size * num_heads * seq_len * head_dim;
    if (idx >= total) return;

    int d = idx % head_dim;
    int s = (idx / head_dim) % seq_len;
    int h = (idx / (head_dim * seq_len)) % num_heads;
    int b = idx / (head_dim * seq_len * num_heads);

    int out_idx = ((b * seq_len + s) * num_heads + h) * head_dim + d;
    output[out_idx] = input[idx];
}

// Tiled GEMM kernel for row-major matrices: C = alpha * A * B + beta * C
// A: M x K, B: K x N, C: M x N
// Block dimensions are compile-time constants for tile sizes
#define TILE_M 32
#define TILE_N 32
#define TILE_K 32

template<int BLOCK_M, int BLOCK_N, int BLOCK_K>
__global__ void gemm_kernel(const float* __restrict__ A,
                            const float* __restrict__ B,
                            float* __restrict__ C,
                            int M, int N, int K,
                            float alpha, float beta,
                            int lda, int ldb, int ldc) {
    __shared__ float As[BLOCK_M][BLOCK_K];
    __shared__ float Bs[BLOCK_K][BLOCK_N];

    int bx = blockIdx.x * BLOCK_N;
    int by = blockIdx.y * BLOCK_M;
    int tx = threadIdx.x;
    int ty = threadIdx.y;

    int row = by + ty;
    int col = bx + tx;

    float c_val = 0.0f;

    for (int kk = 0; kk < K; kk += BLOCK_K) {
        // Load A tile
        if (row < M && kk + tx < K) {
            As[ty][tx] = A[row * lda + kk + tx];
        } else {
            As[ty][tx] = 0.0f;
        }
        // Load B tile
        if (kk + ty < K && col < N) {
            Bs[ty][tx] = B[(kk + ty) * ldb + col];
        } else {
            Bs[ty][tx] = 0.0f;
        }
        __syncthreads();

        #pragma unroll
        for (int k = 0; k < BLOCK_K; ++k) {
            c_val += As[ty][k] * Bs[k][tx];
        }
        __syncthreads();
    }

    if (row < M && col < N) {
        C[row * ldc + col] = alpha * c_val + beta * C[row * ldc + col];
    }
}

// Batched GEMM kernel for row-major matrices: C = alpha * A * B + beta * C
// A: M x K, B: K x N, C: M x N, with batch dimension batch_count.
// Strides: A stride between batches is strideA, etc. Pointers point to the first batch element.
// Grid: (ceil(N/TILE_N), ceil(M/TILE_M), batch_count)
template<int BLOCK_M, int BLOCK_N, int BLOCK_K>
__global__ void batched_gemm_kernel(const float* __restrict__ A,
                                    const float* __restrict__ B,
                                    float* __restrict__ C,
                                    int M, int N, int K,
                                    float alpha, float beta,
                                    int lda, int ldb, int ldc,
                                    int64_t strideA, int64_t strideB, int64_t strideC) {
    __shared__ float As[BLOCK_M][BLOCK_K];
    __shared__ float Bs[BLOCK_K][BLOCK_N];

    int batch_idx = blockIdx.z;
    const float* A_batch = A + batch_idx * strideA;
    const float* B_batch = B + batch_idx * strideB;
    float* C_batch = C + batch_idx * strideC;

    int bx = blockIdx.x * BLOCK_N;
    int by = blockIdx.y * BLOCK_M;
    int tx = threadIdx.x;
    int ty = threadIdx.y;

    int row = by + ty;
    int col = bx + tx;

    float c_val = 0.0f;

    for (int kk = 0; kk < K; kk += BLOCK_K) {
        if (row < M && kk + tx < K) {
            As[ty][tx] = A_batch[row * lda + kk + tx];
        } else {
            As[ty][tx] = 0.0f;
        }
        if (kk + ty < K && col < N) {
            Bs[ty][tx] = B_batch[(kk + ty) * ldb + col];
        } else {
            Bs[ty][tx] = 0.0f;
        }
        __syncthreads();

        #pragma unroll
        for (int k = 0; k < BLOCK_K; ++k) {
            c_val += As[ty][k] * Bs[k][tx];
        }
        __syncthreads();
    }

    if (row < M && col < N) {
        C_batch[row * ldc + col] = alpha * c_val + beta * C_batch[row * ldc + col];
    }
}

// Launcher for non-batched GEMM
void launch_gemm(const float* A, const float* B, float* C,
                 int M, int N, int K,
                 float alpha, float beta,
                 int lda, int ldb, int ldc,
                 cudaStream_t stream) {
    dim3 block(TILE_N, TILE_M);
    dim3 grid((N + TILE_N - 1) / TILE_N, (M + TILE_M - 1) / TILE_M);
    gemm_kernel<TILE_M, TILE_N, TILE_K><<<grid, block, 0, stream>>>(
        A, B, C, M, N, K, alpha, beta, lda, ldb, ldc);
}

// Launcher for batched GEMM
void launch_batched_gemm(const float* A, const float* B, float* C,
                         int M, int N, int K,
                         float alpha, float beta,
                         int lda, int ldb, int ldc,
                         int64_t strideA, int64_t strideB, int64_t strideC,
                         int batch_count,
                         cudaStream_t stream) {
    dim3 block(TILE_N, TILE_M);
    dim3 grid((N + TILE_N - 1) / TILE_N, (M + TILE_M - 1) / TILE_M, batch_count);
    batched_gemm_kernel<TILE_M, TILE_N, TILE_K><<<grid, block, 0, stream>>>(
        A, B, C, M, N, K, alpha, beta, lda, ldb, ldc, strideA, strideB, strideC);
}

// Main launcher for multihead attention forward
// This function assumes batch_first=True, all tensors contiguous, float32.
// key_padding_mask may be null.
extern "C" void multihead_attention_forward_launcher(
    const float* query, const float* key, const float* value,
    const float* in_proj_weight, const float* in_proj_bias,
    const float* out_proj_weight, const float* out_proj_bias,
    const uint8_t* key_padding_mask, float* out,
    int batch_size, int seq_len, int embed_dim, int num_heads,
    cudaStream_t stream)
{
    const int head_dim = embed_dim / num_heads;
    const int M = batch_size * seq_len;
    const int batch_count = batch_size * num_heads;
    const float alpha = 1.0f;
    const float beta_zero = 0.0f;
    const float beta_one = 1.0f;

    // Temporary buffers
    float *Wq_T, *Wk_T, *Wv_T;
    float *Q, *K, *V;
    float *Q_heads, *K_heads, *V_heads;
    float *K_T_heads;
    float *scores;
    float *attn_out_heads;
    float *pre_out;

    // Allocate Wq_T, Wk_T, Wv_T: each embed_dim x embed_dim
    cudaMalloc(&Wq_T, embed_dim * embed_dim * sizeof(float));
    cudaMalloc(&Wk_T, embed_dim * embed_dim * sizeof(float));
    cudaMalloc(&Wv_T, embed_dim * embed_dim * sizeof(float));

    // Transpose in_proj_weight slices
    // in_proj_weight layout: [Wq; Wk; Wv] each embed_dim x embed_dim, row-major
    {
        const float* Wq = in_proj_weight;
        const float* Wk = in_proj_weight + embed_dim * embed_dim;
        const float* Wv = in_proj_weight + 2 * embed_dim * embed_dim;

        int threads_transpose = 256;
        int blocks_transpose = (embed_dim * embed_dim + threads_transpose - 1) / threads_transpose;
        transpose_square_kernel<<<blocks_transpose, threads_transpose, 0, stream>>>(Wq, Wq_T, embed_dim);
        transpose_square_kernel<<<blocks_transpose, threads_transpose, 0, stream>>>(Wk, Wk_T, embed_dim);
        transpose_square_kernel<<<blocks_transpose, threads_transpose, 0, stream>>>(Wv, Wv_T, embed_dim);
    }

    // Allocate Q, K, V: each M x embed_dim
    cudaMalloc(&Q, M * embed_dim * sizeof(float));
    cudaMalloc(&K, M * embed_dim * sizeof(float));
    cudaMalloc(&V, M * embed_dim * sizeof(float));

    // Compute Q = query * Wq_T + bq, etc.
    // query, key, value are M x embed_dim row-major, lda=embed_dim
    launch_gemm(query, Wq_T, Q, M, embed_dim, embed_dim, alpha, beta_zero, embed_dim, embed_dim, embed_dim, stream);
    launch_gemm(key, Wk_T, K, M, embed_dim, embed_dim, alpha, beta_zero, embed_dim, embed_dim, embed_dim, stream);
    launch_gemm(value, Wv_T, V, M, embed_dim, embed_dim, alpha, beta_zero, embed_dim, embed_dim, embed_dim, stream);

    // Add bias if provided
    if (in_proj_bias) {
        const float* bq = in_proj_bias;
        const float* bk = in_proj_bias + embed_dim;
        const float* bv = in_proj_bias + 2 * embed_dim;
        int bias_threads = 256;
        int bias_blocks = (M * embed_dim + bias_threads - 1) / bias_threads;
        add_bias_kernel<<<bias_blocks, bias_threads, 0, stream>>>(Q, bq, M, embed_dim);
        add_bias_kernel<<<bias_blocks, bias_threads, 0, stream>>>(K, bk, M, embed_dim);
        add_bias_kernel<<<bias_blocks, bias_threads, 0, stream>>>(V, bv, M, embed_dim);
    }

    // Allocate Q_heads, K_heads, V_heads: each batch * num_heads * seq_len * head_dim
    cudaMalloc(&Q_heads, batch_count * seq_len * head_dim * sizeof(float));
    cudaMalloc(&K_heads, batch_count * seq_len * head_dim * sizeof(float));
    cudaMalloc(&V_heads, batch_count * seq_len * head_dim * sizeof(float));

    // Permute Q, K, V from (batch, seq_len, embed_dim) to (batch, num_heads, seq_len, head_dim)
    {
        int perm_threads = 256;
        int perm_blocks = (M * embed_dim + perm_threads - 1) / perm_threads;
        permute_to_heads_kernel<<<perm_blocks, perm_threads, 0, stream>>>(Q, Q_heads, batch_size, seq_len, num_heads, head_dim);
        permute_to_heads_kernel<<<perm_blocks, perm_threads, 0, stream>>>(K, K_heads, batch_size, seq_len, num_heads, head_dim);
        permute_to_heads_kernel<<<perm_blocks, perm_threads, 0, stream>>>(V, V_heads, batch_size, seq_len, num_heads, head_dim);
    }

    // Transpose K_heads to K_T_heads: shape (batch, num_heads, head_dim, seq_len)
    cudaMalloc(&K_T_heads, batch_count * seq_len * head_dim * sizeof(float));
    // We can use a kernel to transpose each head's (seq_len x head_dim) matrix.
    // Since each head is small, we can write a kernel that does all heads.
    {
        // We'll implement a kernel that transposes each (seq_len x head_dim) matrix within the batch.
        // But for simplicity, we can use a custom kernel that treats each head independently.
        // We'll write a kernel that takes K_heads (batch_count * seq_len * head_dim) and outputs K_T_heads.
        // The mapping: for each batch/head, K_T_heads[((b*num_heads+h)*head_dim + d)*seq_len + s] = K_heads[((b*num_heads+h)*seq_len + s)*head_dim + d].
        // So we can use a kernel similar to transpose but with batch dimension.
        // We'll implement a separate kernel for this.
    }
    // Temporary: implement transpose for K_heads via a kernel
    {
        int total_elements = batch_count * seq_len * head_dim;
        int threads = 256;
        int blocks = (total_elements + threads - 1) / threads;
        // Use a generic kernel: each thread handles one element of output (head_dim x seq_len per head)
        // We'll write a kernel named transpose_heads_kernel
        // For now, inline it.
        // Actually, we can use a simple loop in a kernel.
    }
    // Instead of writing a separate kernel, we can avoid transposing K_heads by modifying the batched GEMM to compute A * B^T.
    // Since we are writing our own batched GEMM, we can add a parameter to indicate transpose of B.
    // But that complicates. Simpler: use the existing batched_gemm_kernel with B = K_T_heads, but we need to produce K_T_heads.
    // We'll write a kernel to produce K_T_heads from K_heads.
    // We'll define a global kernel below.

    // Forward declaration? We'll define the kernel before use.
    // Actually, we'll define it now.
    // (Since this is a single file, we can define it above this function. But we are inside function, so we need to have defined it earlier.
    // We'll move the kernel definition up after the other kernels.
    // For now, we'll assume it exists: transpose_heads_kernel
    // We'll call it.
    // To avoid missing, we'll define it later in this file before use. Since this function is defined after all kernel definitions, it's fine.

    // Placeholder: we will call the kernel here, but it's defined above this function.
    {
        int total_elements = batch_count * seq_len * head_dim;
        int threads = 256;
        int blocks = (total_elements + threads - 1) / threads;
        transpose_heads_kernel<<<blocks, threads, 0, stream>>>(K_heads, K_T_heads, batch_count, seq_len, head_dim);
    }

    // Allocate scores: batch_count * seq_len * seq_len
    cudaMalloc(&scores, batch_count * seq_len * seq_len * sizeof(float));

    // Compute scores = Q_heads * K_T_heads, scaled by 1/sqrt(head_dim)
    // Q_heads is (batch_count, seq_len, head_dim) row-major, stride = seq_len * head_dim
    // K_T_heads is (batch_count, head_dim, seq_len) row-major, stride = head_dim * seq_len
    // scores is (batch_count, seq_len, seq_len) row-major, stride = seq_len * seq_len
    // The GEMM per batch: C = A * B, where A is seq_len x head_dim, B is head_dim x seq_len.
    // So M = seq_len, N = seq_len, K = head_dim.
    float scale = 1.0f / sqrtf((float)head_dim);
    launch_batched_gemm(Q_heads, K_T_heads, scores,
                        seq_len, seq_len, head_dim,
                        scale, beta_zero,
                        head_dim, seq_len, seq_len,
                        seq_len * head_dim, head_dim * seq_len, seq_len * seq_len,
                        batch_count, stream);

    // Apply softmax with mask
    {
        int total_rows = batch_size * num_heads * seq_len;
        int threads = 256;
        int blocks = (total_rows + threads - 1) / threads;
        softmax_mask_kernel<<<blocks, threads, 0, stream>>>(scores, key_padding_mask, batch_size, num_heads, seq_len, scale);
    }

    // Allocate attn_out_heads: batch_count * seq_len * head_dim
    cudaMalloc(&attn_out_heads, batch_count * seq_len * head_dim * sizeof(float));

    // Compute attn_out_heads = scores * V_heads
    // scores is (batch_count, seq_len, seq_len), V_heads is (batch_count, seq_len, head_dim)
    // M = seq_len, N = head_dim, K = seq_len
    launch_batched_gemm(scores, V_heads, attn_out_heads,
                        seq_len, head_dim, seq_len,
                        alpha, beta_zero,
                        seq_len, head_dim, head_dim,
                        seq_len * seq_len, seq_len * head_dim, seq_len * head_dim,
                        batch_count, stream);

    // Allocate pre_out: M x embed_dim
    cudaMalloc(&pre_out, M * embed_dim * sizeof(float));

    // Permute attn_out_heads from (batch, num_heads, seq_len, head_dim) to (batch, seq_len, embed_dim)
    {
        int total_elements = M * embed_dim;
        int threads = 256;
        int blocks = (total_elements + threads - 1) / threads;
        permute_to_seq_kernel<<<blocks, threads, 0, stream>>>(attn_out_heads, pre_out, batch_size, seq_len, num_heads, head_dim);
    }

    // Final out_proj: out = pre_out * out_proj_weight + out_proj_bias
    // pre_out is M x embed_dim, out_proj_weight is embed_dim x embed_dim.
    // We compute out = pre_out * out_proj_weight (since weight is already correct orientation)
    launch_gemm(pre_out, out_proj_weight, out, M, embed_dim, embed_dim, alpha, beta_zero, embed_dim, embed_dim, embed_dim, stream);

    if (out_proj_bias) {
        int total_elements = M * embed_dim;
        int threads = 256;
        int blocks = (total_elements + threads - 1) / threads;
        add_bias_kernel<<<blocks, threads, 0, stream>>>(out, out_proj_bias, M, embed_dim);
    }

    // Free all temporary buffers
    cudaFree(Wq_T);
    cudaFree(Wk_T);
    cudaFree(Wv_T);
    cudaFree(Q);
    cudaFree(K);
    cudaFree(V);
    cudaFree(Q_heads);
    cudaFree(K_heads);
    cudaFree(V_heads);
    cudaFree(K_T_heads);
    cudaFree(scores);
    cudaFree(attn_out_heads);
    cudaFree(pre_out);
}

// Define transpose_heads_kernel after the launcher? No, it must be defined before use.
// We'll move it above the launcher. We'll add it here before the launcher definition.
__global__ void transpose_heads_kernel(const float* __restrict__ input,
                                       float* __restrict__ output,
                                       int batch_count, int seq_len, int head_dim) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int total = batch_count * seq_len * head_dim;
    if (idx >= total) return;
    int d = idx % head_dim;
    int s = (idx / head_dim) % seq_len;
    int bh = idx / (head_dim * seq_len);
    int out_idx = (bh * head_dim + d) * seq_len + s;
    output[out_idx] = input[idx];
}

