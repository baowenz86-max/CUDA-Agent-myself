===== kernels/fused_activation.cu =====
#include <cuda_runtime.h>
#include <cmath>

// Fused activation kernel: LeakyReLU -> Pow -> Abs -> Mish -> ReLU -> Clamp
// Parameters:
//   x: input tensor (any shape, contiguous)
//   negative_slope: leakyrelu negative slope
//   pow_exponent: exponent for pow
//   mish_alpha: alpha for mish (x * tanh(softplus(alpha*x)))
//   relu_threshold: threshold for relu (max(0, x - threshold))
//   abs_max: clamp maximum
// Output: tensor same shape and dtype as input

__device__ float mish_forward(float x, float alpha) {
    // Generalized Mish: x * tanh(softplus(alpha*x))
    // softplus(y) = log(1 + exp(y))
    float sp = log1pf(expf(alpha * x));
    return x * tanhf(sp);
}

__global__ void fused_activation_kernel(
    float* __restrict__ output,
    const float* __restrict__ input,
    int64_t n,
    float negative_slope,
    float pow_exponent,
    float mish_alpha,
    float relu_threshold,
    float abs_max)
{
    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    int64_t stride = (int64_t)blockDim.x * gridDim.x;
    for (int64_t i = idx; i < n; i += stride) {
        float x = input[i];
        // LeakyReLU
        x = (x >= 0.0f) ? x : negative_slope * x;
        // Pow
        x = powf(x, pow_exponent);
        // Abs
        x = fabsf(x);
        // Mish
        x = mish_forward(x, mish_alpha);
        // ReLU with threshold: max(0, x - threshold)
        x = fmaxf(x - relu_threshold, 0.0f);
        // Clamp to [0, abs_max]
        x = fminf(x, abs_max);
        output[i] = x;
    }
}

extern "C" void fused_activation_launcher(
    float* output,
    const float* input,
    int64_t n,
    float negative_slope,
    float pow_exponent,
    float mish_alpha,
    float relu_threshold,
    float abs_max,
    cudaStream_t stream)
{
    if (n == 0) return;
    const int block_size = 256;
    int64_t blocks = (n + block_size - 1) / block_size;
    // Limit grid to avoid excessive blocks for huge tensors (grid-stride loop handles rest)
    if (blocks > 65535) blocks = 65535;
    fused_activation_kernel<<<blocks, block_size, 0, stream>>>(
        output, input, n,
        negative_slope, pow_exponent, mish_alpha, relu_threshold, abs_max
    );
}

===== kernels/fused_activation_binding.cpp =====
#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>

#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

// Declare launcher from fused_activation.cu
extern "C" void fused_activation_launcher(
    float* output,
    const float* input,
    int64_t n,
    float negative_slope,
    float pow_exponent,
    float mish_alpha,
    float relu_threshold,
    float abs_max,
    cudaStream_t stream
);

// PyTorch wrapper for fused activation
torch::Tensor fused_activation_forward(
    torch::Tensor input,
    double negative_slope,
    double pow_exponent,
    double mish_alpha,
    double relu_threshold,
    double abs_max
) {
    // Input validation
    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
    TORCH_CHECK(input.numel() > 0, "Input tensor cannot be empty");

    // Allocate output tensor with same shape and dtype as input
    auto output = torch::empty_like(input);

    // Get current CUDA stream
    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    // Call CUDA launcher
    fused_activation_launcher(
        output.data_ptr<float>(),
        input.data_ptr<float>(),
        input.numel(),
        static_cast<float>(negative_slope),
        static_cast<float>(pow_exponent),
        static_cast<float>(mish_alpha),
        static_cast<float>(relu_threshold),
        static_cast<float>(abs_max),
        stream
    );

    return output;
}

// Registration function
void register_fused_activation(pybind11::module& m) {
    m.def(
        "fused_activation_forward",
        &fused_activation_forward,
        "Fused activation forward (LeakyReLU -> Pow -> Abs -> Mish -> ReLU -> Clamp)",
        py::arg("input"),
        py::arg("negative_slope"),
        py::arg("pow_exponent"),
        py::arg("mish_alpha"),
        py::arg("relu_threshold"),
        py::arg("abs_max")
    );
}

// Auto-register
REGISTER_BINDING(fused_activation, register_fused_activation);
