\n\nvoid ceil_launcher(const float* input, float* output, int total_elements, cudaStream_t stream) {\n    int threads = 256;\n    int blocks = (total_elements + threads - 1) / threads;\n    ceil_kernel<<<blocks, threads, 0, stream>>>(output, input, total_elements);\n}\n\nvoid transpose_1_2_launcher(const float* input, float* output,\n                            int dim1, int dim2, int dim3, int total_elements, cudaStream_t stream) {\n    int threads = 256;\n    int blocks = (total_elements + threads - 1) / threads;\n    transpose_1_2_kernel<<<blocks, threads, 0, stream>>>(output, input, dim1, dim2, dim3, total_elements);\n}\n\nvoid group_norm_launcher(const float* input, float* output,\n                         int N, int H, int C, int W, int num_groups,\n                         cudaStream_t stream) {\n    // Ensure C divisible by num_groups\n    int group_size = C / num_groups;\n    int elems_per_group = group_size * H * W;\n    int num_stats = N * num_groups;\n\n    // Allocate temporary buffers for sum and sumsq\n    float *sum, *sumsq, *mean, *rstd;\n    cudaMalloc(&sum, num_stats * sizeof(float));\n    cudaMalloc(&sumsq, num_stats * sizeof(float));\n    cudaMalloc(&mean, num_stats * sizeof(float));\n    cudaMalloc(&rstd, num_stats * sizeof(float));\n\n    // Initialize sum and sumsq to zero\n    cudaMemsetAsync(sum, 0, num_stats * sizeof(float), stream);\n    cudaMemsetAsync(sumsq, 0, num_stats * sizeof(float), stream);\n\n    // Kernel 1: compute stats\n    int threads = 256;\n    dim3 grid(num_stats);\n    // Shared memory size for reduction: 2 * threads * sizeof(float), but we declared fixed arrays of 256 in kernel, so no dynamic needed.\n    group_norm_stats_kernel<<<grid, threads, 0, stream>>>(\n        input, sum, sumsq, N, H, C, W, num_groups);\n\n    // Kernel 2: finalize stats (compute mean and rstd)\n    int final_blocks = (num_stats + threads - 1) / threads;\n    finalize_stats_kernel<<<final_blocks, threads, 0, stream>>>(\n        mean, rstd, sum, sumsq, elems_per_group, 1e-5f);\n\n    // Kernel 3: apply normalization\n    int total_elements = N * H * C * W;\n    int apply_blocks = (total_elements + threads - 1) / threads;\n    group_norm_apply_kernel<<<apply_blocks, threads, 0, stream>>>(\n        output, input, mean, rstd, total_elements, C, num_groups);\n\n    // Free temporary buffers (after stream sync? we can't synchronize here; use cudaFree after kernels are done.\n    // We can use cudaFree asynchronously? Actually cudaFree is synchronous with respect to stream? It may not be safe.\n    // Better to allocate persistent buffers? For simplicity, we can allocate each call and free after launching; cudaFree will wait until stream completes? Not necessarily.\n    // To avoid memory leaks and synchronization issues, we can use cudaMallocAsync and cudaFreeAsync, but that's more complex.\n    // Since this is called once per forward, we can allocate and free per call with cudaMalloc/cudaFree; cudaFree will not return until all preceding work in the stream is done? Actually cudaFree is synchronous with device, so it will block until all kernels complete, which is okay but may hurt performance due to sync.\n    // For performance, we should use a memory pool or allocate once and reuse. But since we are not allowed to modify .cpp or model_new.py to pass buffers, we have to either allocate each call or use static/global allocations.\n    // We'll use static buffers of fixed maximum size? But N and num_groups can vary? They are fixed in model: N=512, num_groups=4, so num_stats=2048. We can allocate a static buffer once using cudaMalloc in a global initialization, but that would require a global constructor. Simpler: use cudaMalloc per call and accept the overhead. Since the model is single forward per iteration, overhead may be small relative to the big kernels. But we can optimize by using a static pointer and reallocating if size changes.\n    // We'll implement a simple caching mechanism: static variables to hold buffers and their size; if size matches, reuse; else free and realloc.\n    // This avoids repeated allocations.\n    // We'll implement that inside group_norm_launcher.\n\n    // Static variables\n    static float* static_sum = nullptr;\n    static float* static_sumsq = nullptr;\n    static float* static_mean = nullptr;\n    static float* static_rstd = nullptr;\n    static int static_num_stats = 0;\n\n    if (num_stats != static_num_stats) {\n        if (static_sum) cudaFree(static_sum);\n        if (static_sumsq) cudaFree(static_sumsq);\n        if (static_mean) cudaFree(static_mean);\n        if (static_rstd) cudaFree(static_rstd);\n        cudaMalloc(&static_sum, num_stats * sizeof(float));\n        cudaMalloc(&static_sumsq, num_stats * sizeof(float));\n        cudaMalloc(&static_mean, num_stats * sizeof(float));\n        cudaMalloc(&static_rstd, num_stats * sizeof(float));\n        static_num_stats = num_stats;\n    }\n    sum = static_sum;\n    sumsq = static_sumsq;\n    mean = static_mean;\n    rstd = static_rstd;\n\n    // Initialize sum and sumsq to zero\n    cudaMemsetAsync(sum, 0, num_stats * sizeof(float), stream);\n    cudaMemsetAsync(sumsq, 0, num_stats * sizeof(float), stream);\n\n    // Launch kernels\n    group_norm_stats_kernel<<<grid, threads, 0, stream>>>(\n        input, sum, sumsq, N, H, C, W, num_groups);\n    finalize_stats_kernel<<<final_blocks, threads, 0, stream>>>(\n        mean, rstd, sum, sumsq, elems_per_group, 1e-5f);\n    group_norm_apply_kernel<<<apply_blocks, threads, 0, stream>>>(\n        output, input, mean, rstd, total_elements, C, num_groups);\n}\n\n} // extern \"C\"\n"
