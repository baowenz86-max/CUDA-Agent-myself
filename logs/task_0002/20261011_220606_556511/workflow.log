===== kernels/fused_ops.cu =====
#include <cuda_runtime.h>
#include <math.h>

// ceil kernel: element-wise ceil on float tensor
__global__ void ceil_kernel(float* output, const float* input, int total_elements) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx < total_elements) {
        output[idx] = ceilf(input[idx]);
    }
}

// transpose kernel: transposes dims 1 and 2 for float tensor
// Input shape: (dim1, dim2, dim3) = (C, H, W)
// Output shape: (dim2, dim1, dim3) = (H, C, W)
__global__ void transpose_1_2_kernel(float* output, const float* input,
                                     int dim1, int dim2, int dim3, int total_elements) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx < total_elements) {
        // output index: (i1_out, i2_out, i3) where output shape is (dim2, dim1, dim3)
        int i3 = idx % dim3;
        int tmp = idx / dim3;
        int i2_out = tmp % dim1;  // index along dim1 in output is the original dim2 index
        int i1_out = tmp / dim1;  // index along dim2 in output is the original dim1 index
        // input index: (i1_in, i2_in, i3) = (i2_out, i1_out, i3)
        int input_idx = (i1_out * dim2 + i2_out) * dim3 + i3;
        output[idx] = input[input_idx];
    }
}

// group_norm stats kernel: each block handles one (n,g), loops over elements,
// reduces using shared memory, then atomically adds to global sum, sumsq.
__global__ void group_norm_stats_kernel(
    const float* __restrict__ input,
    float* __restrict__ sum,
    float* __restrict__ sumsq,
    int N, int H, int C, int W, int num_groups) {
    
    int block_id = blockIdx.x;
    int n = block_id / num_groups;
    int g = block_id % num_groups;
    int group_size = C / num_groups;
    int start_c = g * group_size;
    int elems_per_group = group_size * H * W;

    int tid = threadIdx.x;
    int stride = blockDim.x;
    float local_sum = 0.0f;
    float local_sumsq = 0.0f;

    for (int i = tid; i < elems_per_group; i += stride) {
        int w = i % W;
        int tmp = i / W;
        int c_local = tmp % group_size;
        int h = tmp / group_size;
        int c = start_c + c_local;
        int idx = ((n * H + h) * C + c) * W + w;
        float val = input[idx];
        local_sum += val;
        local_sumsq += val * val;
    }

    __shared__ float s_sum[256];
    __shared__ float s_sumsq[256];
    s_sum[tid] = local_sum;
    s_sumsq[tid] = local_sumsq;
    __syncthreads();

    for (int stride_red = blockDim.x / 2; stride_red > 0; stride_red >>= 1) {
        if (tid < stride_red) {
            s_sum[tid] += s_sum[tid + stride_red];
            s_sumsq[tid] += s_sumsq[tid + stride_red];
        }
        __syncthreads();
    }

    if (tid == 0) {
        // warp-level reduction to avoid atomic on single thread may be better,
        // but for simplicity keep as is; performance may be acceptable.
        // Actually, since block reduction already reduces to one value, atomic is not needed.
        // We can store directly without atomic because each block handles one (n,g).
        sum[block_id] = s_sum[0];
        sumsq[block_id] = s_sumsq[0];
    }
}

// finalize_stats_kernel: compute mean and rstd from sum and sumsq
__global__ void finalize_stats_kernel(
    float* __restrict__ mean,
    float* __restrict__ rstd,
    const float* __restrict__ sum,
    const float* __restrict__ sumsq,
    int count, float eps) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx < count) {
        float s = sum[idx];
        float ss = sumsq[idx];
        float mean_val = s / count;
        float var = ss / count - mean_val * mean_val;
        var = fmaxf(var, 0.0f);
        mean[idx] = mean_val;
        rstd[idx] = rsqrtf(var + eps);
    }
}

// group_norm_apply_kernel: normalize input using mean and rstd
__global__ void group_norm_apply_kernel(
    float* __restrict__ output,
    const float* __restrict__ input,
    const float* __restrict__ mean,
    const float* __restrict__ rstd,
    int N, int H, int C, int W, int num_groups) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int total = N * H * C * W;
    if (idx < total) {
        // Decode indices: input layout (N, H, C, W)
        int w = idx % W;
        int tmp = idx / W;
        int c = tmp % C;
        int tmp2 = tmp / C;
        int h = tmp2 % H;
        int n = tmp2 / H;
        int group_size = C / num_groups;
        int g = c / group_size;
        int stat_idx = n * num_groups + g;
        float mu = mean[stat_idx];
        float rstd_val = rstd[stat_idx];
        output[idx] = (input[idx] - mu) * rstd_val;
    }
}

// Host launchers with extern "C"
extern "C" {

void ceil_launcher(const float* input, float* output, int total_elements, cudaStream_t stream) {
    int threads = 256;
    int blocks = (total_elements + threads - 1) / threads;
    ceil_kernel<<<blocks, threads, 0, stream>>>(output, input, total_elements);
}

void transpose_1_2_launcher(const float* input, float* output,
                            int dim1, int dim2, int dim3, int total_elements, cudaStream_t stream) {
    int threads = 256;
    int blocks = (total_elements + threads - 1) / threads;
    transpose_1_2_kernel<<<blocks, threads, 0, stream>>>(output, input, dim1, dim2, dim3, total_elements);
}

void group_norm_launcher(const float* input, float* output,
                         int N, int H, int C, int W, int num_groups,
                         cudaStream_t stream) {
    int group_size = C / num_groups;
    int elems_per_group = group_size * H * W;
    int num_stats = N * num_groups;

    // Static caches for intermediate arrays to avoid repeated cudaMalloc/cudaFree
    // These are not thread-safe but okay for single-threaded use.
    static float* static_sum = nullptr;
    static float* static_sumsq = nullptr;
    static float* static_mean = nullptr;
    static float* static_rstd = nullptr;
    static int static_num_stats = 0;

    if (num_stats != static_num_stats) {
        if (static_sum) cudaFree(static_sum);
        if (static_sumsq) cudaFree(static_sumsq);
        if (static_mean) cudaFree(static_mean);
        if (static_rstd) cudaFree(static_rstd);
        cudaMalloc(&static_sum, num_stats * sizeof(float));
        cudaMalloc(&static_sumsq, num_stats * sizeof(float));
        cudaMalloc(&static_mean, num_stats * sizeof(float));
        cudaMalloc(&static_rstd, num_stats * sizeof(float));
        static_num_stats = num_stats;
    }
    float* sum = static_sum;
    float* sumsq = static_sumsq;
    float* mean = static_mean;
    float* rstd = static_rstd;

    // No need to zero sum/sumsq because stats kernel writes directly to them.
    // cudaMemsetAsync removed for efficiency.

    int threads = 256;
    dim3 grid(num_stats);
    group_norm_stats_kernel<<<grid, threads, 0, stream>>>(
        input, sum, sumsq, N, H, C, W, num_groups);

    int final_blocks = (num_stats + threads - 1) / threads;
    finalize_stats_kernel<<<final_blocks, threads, 0, stream>>>(
        mean, rstd, sum, sumsq, elems_per_group, 1e-5f);

    int total_elements = N * H * C * W;
    int apply_blocks = (total_elements + threads - 1) / threads;
    group_norm_apply_kernel<<<apply_blocks, threads, 0, stream>>>(
        output, input, mean, rstd, N, H, C, W, num_groups);
}

} // extern "C"

===== kernels/fused_ops_binding.cpp =====
#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>

#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

// Launcher declarations from fused_ops.cu
extern "C" {
void ceil_launcher(const float* input, float* output, int total_elements, cudaStream_t stream);
void transpose_1_2_launcher(const float* input, float* output,
                            int dim1, int dim2, int dim3, int total_elements, cudaStream_t stream);
void group_norm_launcher(const float* input, float* output,
                         int N, int H, int C, int W, int num_groups,
                         cudaStream_t stream);
}

// ceil_forward binding
torch::Tensor ceil_forward(torch::Tensor input) {
    TORCH_CHECK(input.is_cuda(), "Input tensor must be CUDA");
    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input tensor must be float32");
    TORCH_CHECK(input.is_contiguous(), "Input tensor must be contiguous");

    auto output = torch::empty_like(input);
    int total_elements = input.numel();
    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    ceil_launcher(input.data_ptr<float>(), output.data_ptr<float>(), total_elements, stream);

    return output;
}

// transpose_1_2_forward binding
torch::Tensor transpose_1_2_forward(torch::Tensor input) {
    TORCH_CHECK(input.is_cuda(), "Input tensor must be CUDA");
    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input tensor must be float32");
    TORCH_CHECK(input.is_contiguous(), "Input tensor must be contiguous");
    TORCH_CHECK(input.dim() == 4, "Input tensor must be 4D (N, C, H, W)");

    int N = input.size(0);
    int C = input.size(1);
    int H = input.size(2);
    int W = input.size(3);

    // Output shape: (N, H, C, W)
    auto output = torch::empty({N, H, C, W}, input.options());

    int total_elements = input.numel();
    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    transpose_1_2_launcher(input.data_ptr<float>(), output.data_ptr<float>(),
                           C, H, W, total_elements, stream);

    return output;
}

// group_norm_forward binding
torch::Tensor group_norm_forward(torch::Tensor input, int64_t num_groups) {
    TORCH_CHECK(input.is_cuda(), "Input tensor must be CUDA");
    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input tensor must be float32");
    TORCH_CHECK(input.is_contiguous(), "Input tensor must be contiguous");
    TORCH_CHECK(input.dim() == 4, "Input tensor must be 4D (N, H, C, W)");

    int N = input.size(0);
    int H = input.size(1);
    int C = input.size(2);
    int W = input.size(3);

    TORCH_CHECK(num_groups > 0, "num_groups must be positive");
    TORCH_CHECK(C % num_groups == 0, "C must be divisible by num_groups");

    auto output = torch::empty_like(input);
    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    group_norm_launcher(input.data_ptr<float>(), output.data_ptr<float>(),
                        N, H, C, W, static_cast<int>(num_groups), stream);

    return output;
}

// Registration function
void register_fused_ops(pybind11::module& m) {
    m.def("ceil_forward", &ceil_forward, "Element-wise ceil forward",
          py::arg("input"));
    m.def("transpose_1_2_forward", &transpose_1_2_forward, "Transpose dimensions 1 and 2 forward",
          py::arg("input"));
    m.def("group_norm_forward", &group_norm_forward, "Group normalization forward (input layout: N,H,C,W)",
          py::arg("input"), py::arg("num_groups"));
}

REGISTER_BINDING(fused_ops, register_fused_ops);
