 cuBLAS GEMM for the projection step (Q= XWq^T, K= XWk^T, V= XWv^T) done as one GEMM with in_proj_weight (3*embed_dim x embed_dim) to get QKV concatenated, then split.\n// Then for each head, we compute Q @ K^T / sqrt(head_dim), apply mask, softmax, then @ V.\n// These per-head GEMMs can also be batched using cuBLAS strided batched GEMM.\n// After that, we concatenate heads and apply out_proj GEMM.\n// This is a standard approach and can be efficient.\n\n// We'll implement the launcher using cuBLAS for all GEMMs and custom kernels for softmax with masking and for scaling/adding bias.\n\n// Include cuBLAS header.\n#include <cublas_v2.h>\n\n// Custom kernel for applying bias and scaling to QKV before splitting.\n// Actually, we can use cublasGemmEx with bias, but simpler to use a custom kernel for bias addition if needed.\n// We'll assume bias is present for in_proj and out_proj (as in model, bias=True).\n\n// Softmax kernel for attention scores with optional key padding mask.\n// The mask is a boolean tensor of shape (batch_size, seq_len) where True indicates positions to be masked (set to -inf before softmax).\n// We'll pass the mask pointer as bool (uint8_t) array.\n// The scores are of shape (batch, num_heads, seq_len_q, seq_len_k). Here seq_len_q == seq_len_k = seq_len.\n// We'll compute softmax over the last dimension.\n__global__ void softmax_mask_kernel(float* __restrict__ scores,\n                                    const uint8_t* __restrict__ key_padding_mask,\n                                    int batch_size,\n                                    int num_heads,\n                                    int seq_len,\n                                    float scale) {\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int total = batch_size * num_heads * seq_len;\n    if (idx >= total) return;\n\n    int s = idx % seq_len;\n    int h = (idx / seq_len) % num_heads;\n    int b = idx / (seq_len * num_heads);\n\n    // Each thread processes one row of the scores matrix for a given (batch, head, query position).\n    // We'll loop over key positions.\n    float max_val = -1e30f;\n    // First pass: find max, considering mask.\n    for (int k = 0; k < seq_len; ++k) {\n        float val = scores[((b * num_heads + h) * seq_len + s) * seq_len + k];\n        if (key_padding_mask && key_padding_mask[b * seq_len + k]) {\n            val = -1e30f;\n            scores[((b * num_heads + h) * seq_len + s) * seq_len + k] = val;\n        }\n        if (val > max_val) max_val = val;\n    }\n    // Second pass: compute exp and sum.\n    float sum = 0.0f;\n    for (int k = 0; k < seq_len; ++k) {\n        float val = scores[((b * num_heads + h) * seq_len + s) * seq_len + k];\n        val = __expf(val - max_val);\n        scores[((b * num_heads + h) * seq_len + s) * seq_len + k] = val;\n        sum += val;\n    }\n    // Third pass: normalize.\n    float inv_sum = 1.0f / sum;\n    for (int k = 0; k < seq_len; ++k) {\n        scores[((b * num_heads + h) * seq_len + s) * seq_len + k] *= inv_sum;\n    }\n}\n\n// Launcher for multihead attention forward.\n// This function assumes all input tensors are contiguous and on CUDA.\n// Parameters:\n// - query, key, value: pointers to input tensors (batch_first = True: (batch, seq_len, embed_dim) contiguous)\n// - in_proj_weight: shape (3*embed_dim, embed_dim) stored row-major, as PyTorch linear weight (out_features, in_features)\n// - in_proj_bias: shape (3*embed_dim) or nullptr if no bias\n// - out_proj_weight: shape (embed_dim, embed_dim)\n// - out_proj_bias: shape (embed_dim)\n// - key_padding_mask: shape (batch, seq_len) of bool (uint8_t) or nullptr if not provided\n// - embed_dim, num_heads, batch_first (must be true)\n// - out: pointer to output tensor (batch, seq_len, embed_dim) contiguous\n// - stream: CUDA stream\n// We assume batch_first = True as in model_new.py; we will not handle batch_first=False for now.\nvoid multihead_attention_forward_launcher(const float* query,\n                                         const float* key,\n                                         const float* value,\n                                         const float* in_proj_weight,\n                                         const float* in_proj_bias,\n                                         const float* out_proj_weight,\n                                         const float* out_proj_bias,\n                                         const uint8_t* key_padding_mask,\n                                         float* out,\n                                         int embed_dim,\n                                         int num_heads,\n                                         int batch_first,\n                                         cudaStream_t stream) {\n    // We expect batch_first = True.\n    const int batch_size = 128; // This should be derived from query dimensions, but we don't have them as arguments.\n    // The binding layer must provide batch_size and seq_len as separate arguments.\n    // However, the function signature in model_new.py passes only the tensors and hyperparameters, not batch_size/seq_len.\n    // The binding layer will need to infer them from tensor shapes.\n    // For this .cu file, we will add parameters for batch_size and seq_len.\n    // Since this is a launcher, we can modify the signature to include batch_size and seq_len.\n    // We'll adjust the signature to include batch_size and seq_len, but note that the Python call does not pass them; the binding wrapper will compute and pass them.\n    // So we need to define a launcher that accepts batch_size and seq_len as additional int parameters.\n    // We'll define a separate launcher function with explicit batch_size and seq_len, and the binding will call that.\n    // For now, we'll define the function as follows (this needs to be consistent with the binding).\n}\n\n// We need a complete implementation. I'll write the launcher with explicit batch_size and seq_len as arguments.\n// The binding will