eduction via atomicAdd on float (supported on sm_60+).\n\n// We'll create three kernels:\n// 1. group_norm_stats_kernel: computes partial sums and sumsq per (n,g) into global buffers using atomicAdd\n// 2. finalize_stats_kernel: computes mean and rstd from accumulated sums\n// 3. group_norm_apply_kernel: applies normalization using mean and rstd\n\n// But we can combine ceil and transpose into group_norm? Not easily because transpose changes layout.\n// Since we have separate ops in model_new.py, we'll implement separate kernels but ensure they work together.\n\n// For transpose, we need to handle non-contiguous after transpose? The output is contiguous, so fine.\n\n// For group_norm, input is (N, H, C, W) after transpose. So we need to compute stats over H*C*W? Wait, group_norm operates on channels grouped, but after transpose, the channel dimension moved to dim=2. Original F.group_norm(x, num_groups) operates on x with shape (N, C, H, W) using channels dimension 1. In model.py, after transpose, x shape becomes (N, H, C, W). Then F.group_norm(x, num_groups) is called. Note: group_norm normalizes over (C, H, W) for each sample, grouping channels. But after transpose, the shape is (N, H, C, W), so channels are now dim=2, and spatial dims are H (dim=1) and W (dim=3). So group_norm should normalize over (C, H, W) i.e., dimensions 2, 1, 3. The implementation must handle this layout.\n\n// In model_new.py, after transpose_1_2, x has shape (N, H, C, W). Then group_norm_forward(x, num_groups) is called. So group_norm must assume input is (N, H, C, W) and normalize over dims (1,2,3) grouped by channels (dim=2). That is consistent.\n\n// So group_norm kernel will take input shape: N, H, C, W, num_groups.\n// For each sample n, we have G groups of channels, each group covering C/G channels. The set of elements for a group is: all H positions, all W positions, and channels in that group. So number of elements per group = (C/G) * H * W.\n\n// We'll implement a robust group_norm using efficient reduction.\n\n// We'll create launchers for each op: ceil_launcher, transpose_1_2_launcher, group_norm_launcher.\n\nextern \"C\" {\n\nvoid ceil_launcher(const float* input, float* output, int total_elements, cudaStream_t stream) {\n    int threads = 256;\n    int blocks = (total_elements + threads - 1) / threads;\n    ceil_kernel<<<blocks, threads, 0, stream>>>(output, input, total_elements);\n}\n\nvoid transpose_1_2_launcher(const float* input, float* output,\n                            int dim1, int dim2, int dim3, int total_elements, cudaStream_t stream) {\n    // input shape: (dim1, dim2, dim3) -> output (dim2, dim1, dim3)\n    // total_elements = dim1*dim2*dim3\n    int threads = 256;\n    int blocks = (total_elements + threads - 1) / threads;\n    transpose_1_2_kernel<<<blocks, threads, 0, stream>>>(output, input, dim1, dim2, dim3, total_elements);\n}\n\n// group_norm launcher: computes group_norm on input of shape (N, H, C, W) with num_groups.\n// We'll use a two-pass approach with temporary buffers for sums.\nvoid group_norm_launcher(const float* input, float* output,\n                         int N, int H, int C, int W, int num_groups,\n                         cudaStream_t stream) {\n    // Allocate temporary memory for sums and sumsq per (n,g). We'll do it inside using cudaMalloc, but better to allocate outside? Since we don't have a persistent buffer, we can allocate each call. Overhead may be high but for single call in model, okay.\n    // We'll compute stats using a kernel that uses atomicAdd on global memory.\n    // First, allocate global buffers for accumulators: size N*num_groups for sum and sumsq.\n    float *mean, *rstd, *buf_sum, *buf_sumsq;\n    int num_stats = N * num_groups;\n    cudaMalloc(&buf_sum, num_stats * sizeof(float));\n    cudaMalloc(&buf_sumsq, num_stats * sizeof(float));\n    // Initialize to zero\n    cudaMemsetAsync(buf_sum, 0, num_stats * sizeof(float), stream);\n    cudaMemsetAsync(buf_sumsq, 0, num_stats * sizeof(float), stream);\n\n    // Kernel 1: compute partial sums atomically\n    int group_size = C / num_groups;  // channels per group\n    int elems_per_group = group_size * H * W;  // number of elements per group\n    // Launch kernel with grid such that each block computes reduction over a chunk of elems_per_group for a particular (n,g)\n    // To reduce atomic contention, we can have each block compute a partial sum for one (n,g) and do atomicAdd once.\n    // But elems_per_group may be large (131072), so we need to split inside block using loop.\n    // We can assign each block to one (n,g) and loop over elems_per_group in chunks with block reduction.\n    // Grid size = N * num_groups blocks, each block handles its (n,g) fully, using shared memory reduction.\n    // But if elems_per_group is huge, a single block may be slow and may not utilize GPU fully? Still, number of blocks is N*num_groups = 512*4=2048 blocks, which is good.\n    // Each block will iterate over all elements in its group, computing sum and sumsq sequentially per thread, then reduce via shared memory and atomicAdd to global buffers.\n    // That's simpler and avoids multiple passes.\n\n    int threads = 256;\n    int blocks = num_stats; // N*num_groups\n    // Need to ensure blocks <= max grid size (2^31-1), yes.\n    // We'll implement kernel: each block handles one (n,g).\n    // Kernel will use shared memory for reduction of sum and sumsq.\n    // Shared memory required: 2 * threads * sizeof(float) for sum and sumsq reduction.\n    int shared_mem_size = 2 * threads * sizeof(float);\n\n    // Kernel to compute stats\n    dim3 grid(blocks);\n    dim3 block(threads);\n    // Call kernel\n    // Need to declare kernel before launcher or put kernel above launcher.\n    // We'll define the kernel above.\n\n    // After stats, kernel to finalize mean and rstd: mean = sum/count, rstd = rsqrt(sumsq/count - mean^2 + eps). eps=1e-5.\n    // We can compute mean and rstd in a separate kernel or incorporate into apply kernel by reading sum and sumsq directly.\n    // Simplest: after computing sum and sumsq, launch a kernel to compute mean and rstd arrays, then apply kernel.\n    // Or we can combine finalization into apply kernel: each element computation reads sum and sumsq, but that would be inefficient (recompute per element). Better to have a small kernel to compute mean and rstd per (n,g).\n\n    // So three kernels total for group_norm: stats, finalize, apply.\n\n    // We'll implement all kernels above.\n\n    // For now, we'll declare the kernels and implement them after launcher? Actually we need to define them before use. So we'll define all kernels before launchers.\n\n    // We'll restructure: put all kernels first, then launchers.\n\n    // We'll write the full kernel implementations below, then the launcher will call them.\n    // This placeholder will be replaced with actual code.\n}\n\n} // extern \"C\"\n\n// Actually we need to define the kernels before using them. We'll write the complete file now.\n\n// group_norm_stats_kernel: each block handles one (n,g), loops over elements, reduces using shared memory, then atomically adds to global sum, sumsq.\n__global__ void group_norm_stats_kernel(\n    const float* __restrict__ input,\n    float* __restrict__ sum,\n    float* __restrict__ sumsq,\n    int N, int H, int C, int W, int num_groups) {\n    int block_id = blockIdx.x;\n    int n = block_id / num_groups;\n    int g = block_id % num_groups;\n    int group_size = C / num_groups; // channels per group\n    int start_c = g * group_size;\n    int end_c = start_c + group_size;\n    int elems_per_group = group_size * H * W;\n\n    // Initialize local accumulators\n    float local_sum = 0.0f;\n    float local_sumsq = 0.0f;\n\n    int tid = threadIdx.x;\n    int stride = blockDim.x;\n\n    // Loop over all elements belonging to this (n,g)\n    // Input layout: (N, H, C, W) so input[n][h][c][w] = input[((n*H + h)*C + c)*W + w]\n    // We need to iterate over h in [0,H), c in [start_c, end_c), w in [0,W)\n    // To coalesce, we can linearize within the group as (h, c_local, w) and map to global index.\n    // For better memory access, we want consecutive threads to access consecutive w, then c_local, then h.\n    // So we iterate over linear index i from tid to elems_per_group-1 step stride.\n    // Decompose i: w = i % W; tmp = i / W; c_local = tmp % group_size; h = tmp / group_size;\n    // Then c = start_c + c_local;\n    // global index = ((n*H + h)*C + c)*W + w;\n    for (int i = tid; i < elems_per_group; i += stride) {\n        int w = i % W;\n        int tmp = i / W;\n        int c_local = tmp % group_size;\n        int h = tmp / group_size;\n        int c = start_c + c_local;\n        int idx = ((n * H + h) * C + c) * W + w;\n        float val = input[idx];\n        local_sum += val;\n        local_sumsq += val * val;\n    }\n\n    // Block-level reduction of local_sum and local_sumsq using shared memory\n    __shared__ float s_sum[256];\n    __shared__ float s_sumsq[256];\n    s_sum[tid] = local_sum;\n    s_sumsq[tid] = local_sumsq;\n    __syncthreads();\n\n    for (int stride_red = blockDim.x / 2; stride_red > 0; stride_red >>= 1) {\n        if (tid < stride_red) {\n            s_sum[tid] += s_sum[tid + stride_red];\n            s_sumsq[tid] += s_sumsq[tid + stride_red];\n        }\n        __syncthreads();\n    }\n\n    // Thread 0 atomically adds to global buffers\n    if (tid == 0) {\n        atomicAdd(&sum[block_id], s_sum[0]);\n        atomicAdd(&sumsq[block_id], s_sumsq[0]);\n    }\n}\n\n// finalize_stats_kernel: compute mean and rstd from sum and sumsq\n__global__ void finalize_stats_kernel(\n    float* __restrict__ mean,\n    float* __restrict__ rstd,\n    const float* __restrict__ sum,\n    const float* __restrict__ sumsq,\n    int count, float eps) {\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    if (idx < count) {\n        float s = sum[idx];\n        float ss = sumsq[idx];\n        float mean_val = s / count;\n        float var = ss / count - mean_val * mean_val;\n        if (var < 0.0f) var = 0.0f;\n        mean[idx] = mean_val;\n        rstd[idx] = rsqrtf(var + eps);\n    }\n}\n\n// group_norm_apply_kernel: normalize input using mean and rstd\n__global__ void group_norm_apply_kernel(\n    float* __restrict__ output,\n    const float* __restrict__ input,\n    const float* __restrict__ mean,\n    const float* __restrict__ rstd,\n    int N, int H, int C, int W, int num_groups) {\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int total = N * H * C * W;\n    if (idx < total) {\n        // Decompose idx into n,h,c,w\n        int w = idx % W;\n        int tmp = idx / W;\n        int c = tmp % C;\n        tmp = tmp / C;\n        int h = tmp % H;\n        int n = tmp / H;\n        int g = c / (C / num_groups);\n        int stat_idx = n * num_groups + g;\n        output[idx] = (input[idx] - mean[stat_idx]) * rstd[stat_idx];\n    }\n}\n\n// Launchers\nvoid ceil_launcher(const float* input, float* output, int total_elements, cudaStream_t stream);\nvoid transpose_1_2_launcher(const float* input, float* output,\n                            int dim1, int dim2, int dim3, int total_elements, cudaStream_t stream);\nvoid group_norm_launcher(const float* input, float* output,\n                         int N, int H, int C, int W, int num_groups,\n                         cudaStream_t stream);\n\n} // extern \"C\"\n\n// Wait, we need to have the kernels defined before launchers. The above ordering is wrong: we have extern \"C\" opening before kernel definitions. We should define kernels outside extern \"C\" (since they are __global__ and don't need C linkage), then have extern \"C\" for launchers.\n\n// Let's reorder the file.\n\n// We'll write the entire file cleanly:\n\n#include <cuda_runtime.h>\n#include <math.h>\n\n// Kernel definitions\n__global__ void ceil_kernel(float* output, const float* input, int total_elements) {\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    if (idx < total_elements) {\n        output[idx] = ceilf(input[idx]);\n    }\n}\n\n__global__ void transpose_1_2_kernel(float* output, const float* input,\n                                     int dim1, int dim2, int dim3, int total_elements) {\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    if (idx < total_elements) {\n        int i3 = idx % dim3;\n        int tmp = idx / dim3;\n        int i2 = tmp % dim1;\n        int i1 = tmp / dim1;\n        int input_idx = (i1 * dim2 + i2) * dim3 + i3;\n        output[idx] = input[input_idx];\n    }\n}\n\n__global__ void group_norm_stats_kernel(\n    const float* __restrict__ input,\n    float* __restrict__ sum,\n    float* __restrict__ sumsq,\n    int N, int H, int C, int W, int num_groups) {\n    extern __shared__ float s_reduction[]; // will contain sum[256] and sumsq[256]? We'll declare two separate arrays.\n    // Actually we declared fixed size 256 for thread count 256. To be safe, use dynamic shared memory with size 2*blockDim.x.\n    // We'll assume blockDim.x is 256 for simplicity, but we can make it dynamic.\n    int block_id = blockIdx.x;\n    int n = block_id / num_groups;\n    int g = block_id % num_groups;\n    int group_size = C / num_groups;\n    int start_c = g * group_size;\n    int elems_per_group = group_size * H * W;\n\n    int tid = threadIdx.x;\n    int stride = blockDim.x;\n    float local_sum = 0.0f;\n    float local_sumsq = 0.0f;\n\n    for (int i = tid; i < elems_per_group; i += stride) {\n        int w = i % W;\n        int tmp = i / W;\n        int c_local = tmp % group_size;\n        int h = tmp / group_size;\n        int c = start_c + c_local;\n        int idx = ((n * H + h) * C + c) * W + w;\n        float val = input[idx];\n        local_sum += val;\n        local_sumsq += val * val;\n    }\n\n    // Use shared memory for block reduction\n    __shared__ float s_sum[256];\n    __shared__ float s_sumsq[256];\n    // Assume blockDim.x <= 256; if larger