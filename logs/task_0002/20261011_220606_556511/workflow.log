#include <cuda_runtime.h>
#include <stdint.h>

// CUDA kernel for elementwise multiplication of two tensors.
__global__ void multiply_kernel(const float* __restrict__ a,
                                const float* __restrict__ b,
                                float* __restrict__ out,
                                int64_t total_elements) {
    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
    if (idx < total_elements) {
        out[idx] = a[idx] * b[idx];
    }
}

// CUDA kernel for stacking two tensors along a specified dimension.
// Assumes all tensors are contiguous in memory; output is contiguous.
// The copy is done in a grid-stride loop over the output elements.
__global__ void stack_kernel(const float* __restrict__ a,
                             const float* __restrict__ b,
                             float* __restrict__ out,
                             int64_t total_out,
                             int64_t single_tensor_numel,
                             int stack_dim,
                             int64_t out_dim0,  // not used but for clarity
                             int64_t out_dim1,
                             int64_t out_dim2,
                             int64_t out_dim3) {
    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
    if (idx >= total_out) return;

    // Assume input tensors are 3D (and contiguous). Output rank = 4.
    // We compute the output index and then map back to the corresponding input element.
    // This is a generic mapping, but we will use specialized dimension calculations for 3D inputs.
    int64_t remaining = idx;
    int64_t out_stride[4] = {out_dim1 * out_dim2 * out_dim3, out_dim2 * out_dim3, out_dim3, 1};
    int coords[4];
    for (int d = 0; d < 4; ++d) {
        coords[d] = remaining / out_stride[d];
        remaining = remaining % out_stride[d];
    }

    // For stack_dim in [0,3], the input tensor index is obtained by removing the stack dimension.
    // Stack dimension size is 2 (since we stack two tensors).
    const float* src;
    if (coords[stack_dim] == 0) {
        src = a;
    } else {
        src = b;
    }

    // Compute input index (3D) by removing the stack_dim coordinate.
    int64_t in_idx = 0;
    int in_d = 0;
    // Input stride: assume contiguous, shape (dim0, dim1, dim2) -> strides (dim1*dim2, dim2, 1)
    // We need to know input dimensions. We can infer from output dims: remove stack dimension.
    int64_t in_shape[3];
    int srcd = 0;
    for (int d = 0; d < 4; ++d) {
        if (d == stack_dim) continue;
        in_shape[srcd++] = (d == 0) ? out_dim0 : (d == 1 ? out_dim1 : (d == 2 ? out_dim2 : out_dim3));
    }
    int64_t in_strides[3] = {in_shape[1] * in_shape[2], in_shape[2], 1};
    srcd = 0;
    for (int d = 0; d < 4; ++d) {
        if (d == stack_dim) continue;
        in_idx += coords[d] * in_strides[srcd++];
    }

    out[idx] = src[in_idx];
}

// Launcher for elementwise multiplication.
extern "C" void multiply_forward_launcher(const float* a,
                                          const float* b,
                                          float* out,
                                          int64_t total_elements,
                                          cudaStream_t stream) {
    int threads = 256;
    int64_t blocks = (total_elements + threads - 1) / threads;
    multiply_kernel<<<(unsigned int)blocks, threads, 0, stream>>>(a, b, out, total_elements);
}

// Launcher for stack operation.
extern "C" void stack_forward_launcher(const float* a,
                                       const float* b,
                                       float* out,
                                       int64_t total_out,
                                       int64_t single_tensor_numel,
                                       int stack_dim,
                                       int64_t out_dim0,
                                       int64_t out_dim1,
                                       int64_t out_dim2,
                                       int64_t out_dim3,
                                       cudaStream_t stream) {
    int threads = 256;
    int64_t blocks = (total_out + threads - 1) / threads;
    stack_kernel<<<(unsigned int)blocks, threads, 0, stream>>>(
        a, b, out, total_out, single_tensor_numel, stack_dim,
        out_dim0, out_dim1, out_dim2, out_dim3);
}

