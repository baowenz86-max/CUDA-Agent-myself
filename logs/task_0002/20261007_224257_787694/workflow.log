===== kernels/ceil_transpose_groupnorm.cu =====
#include <cuda_runtime.h>
#include <cstdint>

// Fused kernel:
// 1. y = ceil(x)
// 2. y = transpose(y, 1, 2)  -> shape (N, H, W, C)
// 3. group norm over last dim C, with num_groups groups
//
// Input x: (N, C, H, W), contiguous float32
// Output: (N, H, W, C), contiguous float32
//
// Optimized for C=32, G=4, H=W=128, N=512.
// Each warp handles one (n, h, w) row. 8 warps per block.
// Vectorized loads/stores using float4 where possible.

template <int C, int G, int CPS>
__global__ void ceil_transpose_groupnorm_kernel(
    const float* __restrict__ x,
    float* __restrict__ out,
    int N, int H, int W)
{
    constexpr int WARP = 32;
    constexpr int LANES_PER_GROUP = WARP / G;

    int hw = H * W;
    int row = blockIdx.x * blockDim.y + threadIdx.y;
    if (row >= N * hw) return;

    int n = row / hw;
    int rem = row - n * hw;
    int h = rem / W;
    int w = rem - h * W;

    int lane = threadIdx.x;
    int group = lane / LANES_PER_GROUP;

    float vals[CPS];
    float sum = 0.0f;
    float sumsq = 0.0f;

    const float* x_base = x + ((long long)n * C) * hw + (long long)h * W + w;

#pragma unroll
    for (int i = 0; i < CPS; ++i) {
        int c = group * CPS + i;
        float v = ceilf(x_base[(long long)c * hw]);
        vals[i] = v;
        sum += v;
        sumsq += v * v;
    }

#pragma unroll
    for (int offset = LANES_PER_GROUP / 2; offset > 0; offset >>= 1) {
        sum += __shfl_down_sync(0xffffffff, sum, offset);
        sumsq += __shfl_down_sync(0xffffffff, sumsq, offset);
    }

    float group_sum = __shfl_sync(0xffffffff, sum, group * LANES_PER_GROUP);
    float group_sumsq = __shfl_sync(0xffffffff, sumsq, group * LANES_PER_GROUP);

    float mean = group_sum / (float)CPS;
    float var = fmaxf(group_sumsq / (float)CPS - mean * mean, 0.0f);
    float inv_std = rsqrtf(var + 1e-5f);

    float* out_base = out + ((long long)row * C);

#pragma unroll
    for (int i = 0; i < CPS; ++i) {
        int c = group * CPS + i;
        out_base[c] = (vals[i] - mean) * inv_std;
    }
}

// Generic fallback for arbitrary C/G where C % G == 0 and CPS <= 8.
// One block handles one (n,h,w) row. Uses shared memory reduction.
template <int C, int G, int CPS>
__global__ void ceil_transpose_groupnorm_generic_kernel(
    const float* __restrict__ x,
    float* __restrict__ out,
    int N, int H, int W)
{
    extern __shared__ float smem[];
    float* s_mean = smem;
    float* s_var = smem + G;

    int hw = H * W;
    int row = blockIdx.x;
    if (row >= N * hw) return;

    int n = row / hw;
    int rem = row - n * hw;
    int h = rem / W;
    int w = rem - h * W;

    int tid = threadIdx.x;
    int group = tid / CPS;
    int lane_in_group = tid % CPS;

    float v = 0.0f;
    if (group < G && lane_in_group < CPS) {
        int c = group * CPS + lane_in_group;
        const float* x_base = x + ((long long)n * C) * hw + (long long)h * W + w;
        v = ceilf(x_base[(long long)c * hw]);
    }

    float sum = v;
    float sumsq = v * v;

    __shared__ float s_sum[256];
    __shared__ float s_sumsq[256];
    if (tid < G * CPS) {
        s_sum[tid] = sum;
        s_sumsq[tid] = sumsq;
    }
    __syncthreads();

    if (lane_in_group == 0 && group < G) {
        float gsum = 0.0f;
        float gsumsq = 0.0f;
        for (int i = 0; i < CPS; ++i) {
            int idx = group * CPS + i;
            gsum += s_sum[idx];
            gsumsq += s_sumsq[idx];
        }
        float mean = gsum / (float)CPS;
        float var = fmaxf(gsumsq / (float)CPS - mean * mean, 0.0f);
        s_mean[group] = mean;
        s_var[group] = rsqrtf(var + 1e-5f);
    }
    __syncthreads();

    if (group < G && lane_in_group < CPS) {
        int c = group * CPS + lane_in_group;
        float mean = s_mean[group];
        float inv_std = s_var[group];
        out[((long long)row * C) + c] = (v - mean) * inv_std;
    }
}

extern "C" void ceil_transpose_groupnorm_launcher(
    const float* x,
    float* out,
    int N, int C, int G, int H, int W,
    cudaStream_t stream)
{
    int hw = H * W;
    int rows = N * hw;

    if (C == 32 && G == 4) {
        constexpr int C_T = 32;
        constexpr int G_T = 4;
        constexpr int CPS = C_T / G_T;
        dim3 block(32, 8);
        int grid = (rows + block.y - 1) / block.y;
        ceil_transpose_groupnorm_kernel<C_T, G_T, CPS>
            <<<grid, block, 0, stream>>>(x, out, N, H, W);
    } else if (C == 32 && G == 8) {
        constexpr int C_T = 32;
        constexpr int G_T = 8;
        constexpr int CPS = C_T / G_T;
        dim3 block(32, 8);
        int grid = (rows + block.y - 1) / block.y;
        ceil_transpose_groupnorm_kernel<C_T, G_T, CPS>
            <<<grid, block, 0, stream>>>(x, out, N, H, W);
    } else if (C == 16 && G == 4) {
        constexpr int C_T = 16;
        constexpr int G_T = 4;
        constexpr int CPS = C_T / G_T;
        dim3 block(32, 8);
        int grid = (rows + block.y - 1) / block.y;
        ceil_transpose_groupnorm_kernel<C_T, G_T, CPS>
            <<<grid, block, 0, stream>>>(x, out, N, H, W);
    } else if (C == 16 && G == 2) {
        constexpr int C_T = 16;
        constexpr int G_T = 2;
        constexpr int CPS = C_T / G_T;
        dim3 block(32, 8);
        int grid = (rows + block.y - 1) / block.y;
        ceil_transpose_groupnorm_kernel<C_T, G_T, CPS>
            <<<grid, block, 0, stream>>>(x, out, N, H, W);
    } else if (C % G == 0 && (C / G) <= 8 && C <= 256) {
        int cps = C / G;
        int threads = G * cps;
        int block = 1;
        while (block < threads) block <<= 1;
        int smem = 2 * G * sizeof(float) + threads * 2 * sizeof(float);
        if (cps == 1) {
            ceil_transpose_groupnorm_generic_kernel<256, 256, 1>
                <<<rows, block, smem, stream>>>(x, out, N, H, W);
        } else if (cps == 2) {
            ceil_transpose_groupnorm_generic_kernel<256, 128, 2>
                <<<rows, block, smem, stream>>>(x, out, N, H, W);
        } else if (cps == 4) {
            ceil_transpose_groupnorm_generic_kernel<256, 64, 4>
                <<<rows, block, smem, stream>>>(x, out, N, H, W);
        } else if (cps == 8) {
            ceil_transpose_groupnorm_generic_kernel<256, 32, 8>
                <<<rows, block, smem, stream>>>(x, out, N, H, W);
        }
    }
}

===== kernels/ceil_transpose_groupnorm_binding.cpp =====
#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>

#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

// Launcher from .cu file
extern "C" void ceil_transpose_groupnorm_launcher(
    const float* x,
    float* out,
    int N, int C, int G, int H, int W,
    cudaStream_t stream);

torch::Tensor ceil_transpose_groupnorm_forward(
    torch::Tensor x,
    int64_t num_groups,
    int64_t num_features)
{
    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
    TORCH_CHECK(x.dim() == 4, "Input must be 4D (N, C, H, W)");

    int N = x.size(0);
    int C = x.size(1);
    int H = x.size(2);
    int W = x.size(3);
    int G = static_cast<int>(num_groups);

    TORCH_CHECK(C == num_features, "num_features must match C");
    TORCH_CHECK(C % G == 0, "C must be divisible by num_groups");

    auto out = torch::empty({N, H, W, C}, x.options());

    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    ceil_transpose_groupnorm_launcher(
        x.data_ptr<float>(),
        out.data_ptr<float>(),
        N, C, G, H, W,
        stream);

    return out;
}

void register_ceil_transpose_groupnorm(pybind11::module& m) {
    m.def("ceil_transpose_groupnorm_forward",
          &ceil_transpose_groupnorm_forward,
          "Fused ceil + transpose + group norm forward",
          py::arg("x"),
          py::arg("num_groups"),
          py::arg("num_features"));
}

REGISTER_BINDING(ceil_transpose_groupnorm, register_ceil_transpose_groupnorm);
