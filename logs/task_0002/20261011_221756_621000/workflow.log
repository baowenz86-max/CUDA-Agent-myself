#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>

#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

// Declare launcher from group_norm_kernel.cu
extern "C" void group_norm_launcher(
    const float* input,
    float* output,
    int N, int G, int Cg, int H, int W, int C,
    float eps,
    cudaStream_t stream);

// PyTorch wrapper for group_norm
torch::Tensor group_norm_forward(torch::Tensor input, int64_t num_groups) {
    // Input validation
    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
    TORCH_CHECK(input.dim() == 4, "Input must be 4D (N, H, C, W) from transpose");

    // Get dimensions
    int N = input.size(0);
    int H = input.size(1);
    int C = input.size(2);
    int W = input.size(3);

    TORCH_CHECK(num_groups > 0, "num_groups must be positive");
    TORCH_CHECK(C % num_groups == 0, "C must be divisible by num_groups");

    int G = static_cast<int>(num_groups);
    int Cg = C / G;

    // Fixed epsilon as used in PyTorch GroupNorm
    const float eps = 1e-5f;

    auto output = torch::empty_like(input);

    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    group_norm_launcher(
        input.data_ptr<float>(),
        output.data_ptr<float>(),
        N, G, Cg, H, W, C,
        eps,
        stream);

    return output;
}

// Registration function
void register_group_norm(pybind11::module& m) {
    m.def("group_norm_forward", &group_norm_forward, "GroupNorm forward",
          py::arg("input"), py::arg("num_groups"));
}

REGISTER_BINDING(group_norm, register_group_norm);

===== kernels/group_norm_kernel.cu =====
#include <cuda_runtime.h>

// GroupNorm forward kernel for (N, G*Cg, H, W) input with C = G * Cg.
// Assumes input is contiguous and already transposed to (N, H, C, W) by previous op.
// Output is same layout (N, H, C, W) with normalized values.
// Each block handles one (n, g) group slice of shape (H, Cg, W) total HW*Cg elements.
// Uses one warp per row? No, block uses all threads and shared memory reduction.
//
// Grid dimensions: (G, N) where x = group index, y = batch index.
// Block dimensions: blockSize.
// Each block computes mean and variance over the group's elements, then normalizes each element.
// Memory access: input pointer points to start of tensor, we compute offsets for group slice.
// Since input layout is (N, H, C, W), group elements are H * Cg * W contiguous? Let's check:
// Fixed n and g: Group g consists of channels g*Cg to (g+1)*Cg-1. But because we transposed to (N,H,C,W),
// channels are not contiguous; for a fixed n and g, elements are strided by W*C? Actually layout:
// index = (((n * H + h) * C + c) * W + w). For fixed n, g, channels c in [g*Cg, (g+1)*Cg-1].
// So elements for group are not contiguous unless Cg==C.
// For efficient access we'll use grid-stride loop over the group's elements considering layout.

template <int BLOCK_SIZE>
__global__ void group_norm_kernel(
    const float* __restrict__ input,
    float* __restrict__ output,
    int N, int G, int Cg, int H, int W, int C,
    float eps)
{
    // blockIdx.x = group index (0..G-1)
    // blockIdx.y = batch index n (0..N-1)
    int n = blockIdx.y;
    int g = blockIdx.x;

    int tid = threadIdx.x;

    // Total number of elements in this group = H * Cg * W
    int group_size = H * Cg * W;

    // Step 1: Compute sum and sum of squares using parallel reduction within block.
    // We'll use grid-stride loop over group elements, but since block covers entire group, use loop.
    float sum = 0.0f;
    float sum_sq = 0.0f;

    // Iterate over all elements in group using block-strided pattern
    for (int i = tid; i < group_size; i += BLOCK_SIZE) {
        // Since group elements are not contiguous in memory, need to compute local indices:
        // group element index j = h*Cg*W + cg*W + w where h in [0,H), cg in [0,Cg), w in [0,W)
        // Map to input linear index with C channels: ((n*H + h)*C + (g*Cg + cg))*W + w
        int h = i / (Cg * W);
        int rem = i - h * (Cg * W);
        int cg = rem / W;
        int w = rem - cg * W;
        int c = g * Cg + cg;
        int src_idx = (((n * H + h) * C + c) * W) + w;

        float val = input[src_idx];
        sum += val;
        sum_sq += val * val;
    }

    // Block reduction using shared memory
    __shared__ float s_sum[BLOCK_SIZE];
    __shared__ float s_sumsq[BLOCK_SIZE];
    s_sum[tid] = sum;
    s_sumsq[tid] = sum_sq;
    __syncthreads();

    // Reduce within block (power of 2 block size assumed; if not, handle with loop)
    #pragma unroll
    for (int stride = BLOCK_SIZE / 2; stride > 0; stride >>= 1) {
        if (tid < stride) {
            s_sum[tid] += s_sum[tid + stride];
            s_sumsq[tid] += s_sumsq[tid + stride];
        }
        __syncthreads();
    }

    float total_sum = s_sum[0];
    float total_sumsq = s_sumsq[0];
    float mean = total_sum / group_size;
    // Variance: E[x^2] - E[x]^2, use fmaxf to avoid negative due to precision
    float variance = fmaxf(total_sumsq / group_size - mean * mean, 0.0f);
    float inv_std = rsqrtf(variance + eps);

    // Step 2: Normalize each element using computed mean and inv_std
    for (int i = tid; i < group_size; i += BLOCK_SIZE) {
        int h = i / (Cg * W);
        int rem = i - h * (Cg * W);
        int cg = rem / W;
        int w = rem - cg * W;
        int c = g * Cg + cg;
        int idx = (((n * H + h) * C + c) * W) + w;
        output[idx] = (input[idx] - mean) * inv_std;
    }
}

// Host launcher for group_norm
extern "C" void group_norm_launcher(
    const float* input,
    float* output,
    int N, int G, int Cg, int H, int W, int C,
    float eps,
    cudaStream_t stream)
{
    const int blockSize = 256;
    dim3 grid(G, N); // group index x, batch index y
    group_norm_kernel<256><<<grid, blockSize, 0, stream>>>(
        input, output, N, G, Cg, H, W, C, eps);
}

