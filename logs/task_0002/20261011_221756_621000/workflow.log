#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>

#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

// Declare launcher from group_norm_kernel.cu
extern "C" void group_norm_launcher(
    const float* input,
    float* output,
    int N, int G, int Cg, int H, int W, int C,
    float eps,
    cudaStream_t stream);

// PyTorch wrapper for group_norm
torch::Tensor group_norm_forward(torch::Tensor input, int64_t num_groups) {
    // Input validation
    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
    TORCH_CHECK(input.dim() == 4, "Input must be 4D (N, H, C, W) from transpose");

    // Get dimensions
    int N = input.size(0);
    int H = input.size(1);
    int C = input.size(2);
    int W = input.size(3);

    TORCH_CHECK(num_groups > 0, "num_groups must be positive");
    TORCH_CHECK(C % num_groups == 0, "C must be divisible by num_groups");

    int G = static_cast<int>(num_groups);
    int Cg = C / G;

    // Fixed epsilon as used in PyTorch GroupNorm
    const float eps = 1e-5f;

    auto output = torch::empty_like(input);

    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    group_norm_launcher(
        input.data_ptr<float>(),
        output.data_ptr<float>(),
        N, G, Cg, H, W, C,
        eps,
        stream);

    return output;
}

// Registration function
void register_group_norm(pybind11::module& m) {
    m.def("group_norm_forward", &group_norm_forward, "GroupNorm forward",
          py::arg("input"), py::arg("num_groups"));
}

REGISTER_BINDING(group_norm, register_group_norm);

===== kernels/group_norm_kernel.cu =====
#include <cuda_runtime.h>

// GroupNorm forward kernel for (N, H, C, W) input layout.
// Each block handles one (n, g) group slice of shape (H, Cg, W).
// The elements of a group are not contiguous in memory, so we compute
// mean and variance via a two-pass approach using float accumulation.
// For numerical stability, use Welford's algorithm for variance.
// This version improves performance by computing each thread's partial
// sums over contiguous chunks instead of strided elements, leading to
// coalesced memory access for the majority of the group.

template <int BLOCK_SIZE>
__global__ void group_norm_kernel(
    const float* __restrict__ input,
    float* __restrict__ output,
    int N, int G, int Cg, int H, int W, int C,
    float eps)
{
    int n = blockIdx.y;
    int g = blockIdx.x;
    int tid = threadIdx.x;

    int group_size = H * Cg * W;

    // First pass: compute mean and M2 using Welford's incremental algorithm.
    // Each thread processes a contiguous chunk of elements for coalesced access.
    // Chunk size is chosen to cover the entire group with the block's threads.
    int chunk_size = (group_size + BLOCK_SIZE - 1) / BLOCK_SIZE;
    int start = tid * chunk_size;
    int end = min(start + chunk_size, group_size);

    float count = 0.0f;
    float mean = 0.0f;
    float M2 = 0.0f;

    for (int i = start; i < end; ++i) {
        // Convert linear index within group to (h, cg, w)
        int h = i / (Cg * W);
        int rem = i - h * (Cg * W);
        int cg = rem / W;
        int w = rem - cg * W;
        int c = g * Cg + cg;
        int src_idx = (((n * H + h) * C + c) * W) + w;

        float val = input[src_idx];
        count += 1.0f;
        float delta = val - mean;
        mean += delta / count;
        float delta2 = val - mean;
        M2 += delta * delta2;
    }

    // Block reduction for count, mean, M2
    // Use shared memory for reduction. Since count will be the same for all threads
    // after processing equal chunks (except possibly the last), we can reduce
    // using a tree-based approach.
    __shared__ float s_count[BLOCK_SIZE];
    __shared__ float s_mean[BLOCK_SIZE];
    __shared__ float s_M2[BLOCK_SIZE];
    s_count[tid] = count;
    s_mean[tid] = mean;
    s_M2[tid] = M2;
    __syncthreads();

    // Reduce count (all counts should be equal to chunk_size except possibly last thread)
    // However, we still reduce to get total count.
    for (int stride = BLOCK_SIZE / 2; stride > 0; stride >>= 1) {
        if (tid < stride) {
            s_count[tid] += s_count[tid + stride];
        }
        __syncthreads();
    }

    // Combined reduction of mean and M2 using Chan et al. parallel algorithm
    // We need to combine partial statistics from each thread. Since we have counts,
    // we can combine them in the same tree reduction.
    for (int stride = BLOCK_SIZE / 2; stride > 0; stride >>= 1) {
        if (tid < stride) {
            float count_a = s_count[tid];
            float count_b = s_count[tid + stride];
            float mean_a = s_mean[tid];
            float mean_b = s_mean[tid + stride];
            float M2_a = s_M2[tid];
            float M2_b = s_M2[tid + stride];

            float delta = mean_b - mean_a;
            float new_count = count_a + count_b;
            float new_mean = mean_a + delta * (count_b / new_count);
            float new_M2 = M2_a + M2_b + delta * delta * (count_a * count_b / new_count);

            s_count[tid] = new_count;
            s_mean[tid] = new_mean;
            s_M2[tid] = new_M2;
        }
        __syncthreads();
    }

    float total_count = s_count[0];
    float total_mean = s_mean[0];
    float variance = s_M2[0] / total_count;
    float inv_std = rsqrtf(variance + eps);

    // Second pass: normalize each element, again with coalesced access.
    for (int i = start; i < end; ++i) {
        int h = i / (Cg * W);
        int rem = i - h * (Cg * W);
        int cg = rem / W;
        int w = rem - cg * W;
        int c = g * Cg + cg;
        int idx = (((n * H + h) * C + c) * W) + w;
        output[idx] = (input[idx] - total_mean) * inv_std;
    }
}

// Host launcher for group_norm
extern "C" void group_norm_launcher(
    const float* input,
    float* output,
    int N, int G, int Cg, int H, int W, int C,
    float eps,
    cudaStream_t stream)
{
    const int blockSize = 256;
    dim3 grid(G, N); // group index x, batch index y
    group_norm_kernel<256><<<grid, blockSize, 0, stream>>>(
        input, output, N, G, Cg, H, W, C, eps);
}

