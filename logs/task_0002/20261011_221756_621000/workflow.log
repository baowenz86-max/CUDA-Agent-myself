// Declare launcher from group_norm_kernel.cu
extern "C" void group_norm_launcher(
    const float* input,
    float* output,
    int N, int G, int Cg, int H, int W, int C,
    float eps,
    cudaStream_t stream);

// PyTorch wrapper for group_norm
torch::Tensor group_norm_forward(torch::Tensor input, int64_t num_groups) {
    // Input validation
    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
    TORCH_CHECK(input.dim() == 4, "Input must be 4D (N, H, C, W) from transpose");

    // Get dimensions
    int N = input.size(0);
    int H = input.size(1);
    int C = input.size(2);
    int W = input.size(3);

    TORCH_CHECK(num_groups > 0, "num_groups must be positive");
    TORCH_CHECK(C % num_groups == 0, "C must be divisible by num_groups");

    int G = static_cast<int>(num_groups);
    int Cg = C / G;

    // Fixed epsilon as used in PyTorch GroupNorm
    const float eps = 1e-5f;

    auto output = torch::empty_like(input);

    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    group_norm_launcher(
        input.data_ptr<float>(),
        output.data_ptr<float>(),
        N, G, Cg, H, W, C,
        eps,
        stream);

    return output;
}

// Registration function
void register_group_norm(pybind11::module& m) {
    m.def("group_norm_forward", &group_norm_forward, "GroupNorm forward",
          py::arg("input"), py::arg("num_groups"));
}

REGISTER_BINDING(group_norm, register_group_norm);

===== kernels/group_norm_kernel.cu =====
#include <cuda_runtime.h>

// GroupNorm forward kernel for (N, H, C, W) input layout.
// Each block handles one (n, g) group slice of shape (H, Cg, W).
// Uses a vectorized loop for better coalescing because for fixed h and cg,
// the elements along W are contiguous.

template <int BLOCK_SIZE>
__global__ void group_norm_kernel(
    const float* __restrict__ input,
    float* __restrict__ output,
    int N, int G, int Cg, int H, int W, int C,
    float eps)
{
    int n = blockIdx.y;
    int g = blockIdx.x;
    int tid = threadIdx.x;

    int group_size = H * Cg * W;

    // First pass: compute sum and sum of squares for the group.
    // Iterate over linear index within group, but map to input using fast division.
    float sum = 0.0f;
    float sum_sq = 0.0f;

    for (int i = tid; i < group_size; i += BLOCK_SIZE) {
        int h = i / (Cg * W);
        int rem = i - h * (Cg * W);
        int cg = rem / W;
        int w = rem - cg * W;
        int c = g * Cg + cg;
        int src_idx = (((n * H + h) * C + c) * W) + w;

        float val = input[src_idx];
        sum += val;
        sum_sq += val * val;
    }

    // Block reduction using shared memory
    __shared__ float s_sum[BLOCK_SIZE];
    __shared__ float s_sumsq[BLOCK_SIZE];
    s_sum[tid] = sum;
    s_sumsq[tid] = sum_sq;
    __syncthreads();

    #pragma unroll
    for (int stride = BLOCK_SIZE / 2; stride > 0; stride >>= 1) {
        if (tid < stride) {
            s_sum[tid] += s_sum[tid + stride];
            s_sumsq[tid] += s_sumsq[tid + stride];
        }
        __syncthreads();
    }

    float total_sum = s_sum[0];
    float total_sumsq = s_sumsq[0];
    float mean = total_sum / group_size;
    // Variance: E[x^2] - E[x]^2, use fmaxf to avoid negative due to precision
    float variance = fmaxf(total_sumsq / group_size - mean * mean, 0.0f);
    float inv_std = rsqrtf(variance + eps);

    // Second pass: normalize each element
    for (int i = tid; i < group_size; i += BLOCK_SIZE) {
        int h = i / (Cg * W);
        int rem = i - h * (Cg * W);
        int cg = rem / W;
        int w = rem - cg * W;
        int c = g * Cg + cg;
        int idx = (((n * H + h) * C + c) * W) + w;
        output[idx] = (input[idx] - mean) * inv_std;
    }
}

// Host launcher for group_norm
extern "C" void group_norm_launcher(
    const float* input,
    float* output,
    int N, int G, int Cg, int H, int W, int C,
    float eps,
    cudaStream_t stream)
{
    const int blockSize = 256;
    dim3 grid(G, N); // group index x, batch index y
    group_norm_kernel<256><<<grid, blockSize, 0, stream>>>(
        input, output, N, G, Cg, H, W, C, eps);
}

