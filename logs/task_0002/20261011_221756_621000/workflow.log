#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>

#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

// Declare launcher from ceil_kernel.cu
extern "C" void ceil_launcher(
    const float* input,
    float* output,
    int N,
    cudaStream_t stream);

// PyTorch wrapper for ceil
torch::Tensor ceil_forward(torch::Tensor input) {
    // Input validation
    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");

    auto output = torch::empty_like(input);

    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    ceil_launcher(
        input.data_ptr<float>(),
        output.data_ptr<float>(),
        input.numel(),
        stream);

    return output;
}

// Registration function
void register_ceil(pybind11::module& m) {
    m.def("ceil_forward", &ceil_forward, "Ceil forward",
          py::arg("input"));
}

REGISTER_BINDING(ceil, register_ceil);

===== kernels/ceil_kernel.cu =====
#include <cuda_runtime.h>

// Unary ceil kernel for float tensors
extern "C" __global__ void ceil_kernel(
    const float* __restrict__ input,
    float* __restrict__ output,
    int N)
{
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx < N) {
        output[idx] = ceilf(input[idx]);
    }
}

// Host launcher for ceil
extern "C" void ceil_launcher(
    const float* input,
    float* output,
    int N,
    cudaStream_t stream)
{
    const int blockSize = 256;
    int gridSize = (N + blockSize - 1) / blockSize;
    ceil_kernel<<<gridSize, blockSize, 0, stream>>>(input, output, N);
}

