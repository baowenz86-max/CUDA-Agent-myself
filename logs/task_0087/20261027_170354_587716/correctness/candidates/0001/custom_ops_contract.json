      "source": "x, _ = self.lstm(x, (h0, c0))",
      "semantics": [
        "LSTM(64,128,2,batch_first=True) processes [512,20,64] with initial states [2,512,128].",
        "Returns tuple (output [512,20,128], (h_n [2,512,128], c_n [2,512,128]))."
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "x = x.permute(0, 2, 1)",
      "semantics": [
        "Permutes dimensions [512,20,128] to [512,128,20].",
        "Output stride becomes [128,1,65536]."
      ]
    },
    {
      "checkpoint": "step_005",
      "source": "x = torch.div(x, 2.0)",
      "semantics": [
        "Elementwise division by scalar 2.0."
      ]
    },
    {
      "checkpoint": "step_006",
      "source": "return x",
      "semantics": [
        "Final output tensor [512,128,20]."
      ]
    }
  ]
