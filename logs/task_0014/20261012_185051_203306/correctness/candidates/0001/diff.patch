+// kernels/custom_ops.cu
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// Kernel 1: ConvTranspose1d (no bias)
+// x: (N, C_in, L_in) contiguous
+// weight: (C_in, C_out, K) contiguous
+// out: (N, C_out, L_out) contiguous
+// L_out = (L_in - 1) * stride - 2*padding + kernel_size + output_padding
+// output_padding only affects the last output position? Actually PyTorch ConvTranspose1d formula:
+// L_out = (L_in - 1) * stride - 2*padding + dilation*(kernel_size-1) + output_padding + 1
+// With dilation=1: L_out = (L_in - 1)*stride - 2*padding + kernel_size + output_padding.
+// Reference: L_in=4096, stride=2, padding=1, kernel_size=3, output_padding=1 => L_out = 8192.
+__global__ void conv_transpose1d_kernel(
+    const float* __restrict__ x,
+    const float* __restrict__ weight,
+    float* __restrict__ out,
+    int N, int C_in, int C_out, int L_in, int L_out,
+    int kernel_size, int stride, int padding, int output_padding)
+{
+    int total = N * C_out * L_out;
+    for (int idx = blockIdx.x * blockDim.x + threadIdx.x; idx < total; idx += blockDim.x * gridDim.x) {
+        int n = idx / (C_out * L_out);
+        int rem = idx % (C_out * L_out);
+        int co = rem / L_out;
+        int lo = rem % L_out;
+        float sum = 0.0f;
+        for (int ci = 0; ci < C_in; ++ci) {
+            const float* x_ptr = x + n * C_in * L_in + ci * L_in;
+            const float* w_ptr = weight + ci * C_out * kernel_size + co * kernel_size;
+            for (int k = 0; k < kernel_size; ++k) {
+                // Input index for output position lo and kernel offset k:
+                // lo = i * stride - padding + k, where i is input index.
+                // So i = (lo + padding - k).
+                int lin = lo + padding - k;
+                if (lin >= 0 && lin < L_in) {
+                    // Check integer divisibility by stride: lin should be divisible by stride for valid input positions.
+                    if (lin % stride == 0) {
+                        int i = lin / stride;
+                        sum += x_ptr[i] * w_ptr[k];
+                    }
+                }
+            }
+        }
+        out[idx] = sum;
+    }
+}
+
+// Kernel 2: Clamp (min, max)
+__global__ void clamp_kernel(const float* __restrict__ in, float* __restrict__ out, int total, float min_val, float max_val) {
+    for (int idx = blockIdx.x * blockDim.x + threadIdx.x; idx < total; idx += blockDim.x * gridDim.x) {
+        float v = in[idx];
+        out[idx] = v < min_val ? min_val : (v > max_val ? max_val : v);
+    }
+}
+
+// Kernel 3: mask_not_equal (x != mask_val)
+__global__ void mask_not_equal_kernel(const float* __restrict__ in, bool* __restrict__ mask, int total, float mask_val) {
+    for (int idx = blockIdx.x * blockDim.x + threadIdx.x; idx < total; idx += blockDim.x * gridDim.x) {
+        mask[idx] = (in[idx] != mask_val);
+    }
+}
+
+// Kernel 4: masked_select
+// input: float array of size total
+// mask: bool array of size total
+// out: output float array of size at least total (allocated by binding as empty with total elements)
+// count: pointer to int in device memory (we will allocate one int, but binding will allocate a tensor? We can use a cudaMemset to zero.
+__global__ void masked_select_kernel(const float* __restrict__ in, const bool* __restrict__ mask, float* __restrict__ out, int total, int* __restrict__ count) {
+    for (int idx = blockIdx.x * blockDim.x + threadIdx.x; idx < total; idx += blockDim.x * gridDim.x) {
+        if (mask[idx]) {
+            int pos = atomicAdd(count, 1);
+            out[pos] = in[idx];
+        }
+    }
+}
+
+// Launchers: extern "C" so binding.cpp can link.
+extern "C" void conv_transpose1d_bias_free_launcher(
+    const float* x,
+    const float* weight,
+    float* out,
+    int N, int C_in, int C_out, int L_in, int L_out,
+    int kernel_size, int stride, int padding, int output_padding,
+    cudaStream_t stream)
+{
+    int total = N * C_out * L_out;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    conv_transpose1d_kernel<<<blocks, threads, 0, stream>>>(
+        x, weight, out, N, C_in, C_out, L_in, L_out, kernel_size, stride, padding, output_padding);
+}
+
+extern "C" void clamp_launcher(
+    const float* in,
+    float* out,
+    int total,
+    float min_val,
+    float max_val,
+    cudaStream_t stream)
+{
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    clamp_kernel<<<blocks, threads, 0, stream>>>(in, out, total, min_val, max_val);
+}
+
+extern "C" void mask_not_equal_launcher(
+    const float* in,
+    bool* mask,
+    int total,
+    float mask_val,
+    cudaStream_t stream)
+{
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    mask_not_equal_kernel<<<blocks, threads, 0, stream>>>(in, mask, total, mask_val);
+}
+
+extern "C" void masked_select_launcher(
+    const float* in,
+    const bool* mask,
+    float* out,
+    int total,
+    int* count,  // device pointer to int, initialized to 0 by binding
+    cudaStream_t stream)
+{
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    masked_select_kernel<<<blocks, threads, 0, stream>>>(in, mask, out, total, count);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,167 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void conv_transpose1d_bias_free_launcher(
+    const float* x,
+    const float* weight,
+    float* out,
+    int N, int C_in, int C_out, int L_in, int L_out,
+    int kernel_size, int stride, int padding, int output_padding,
+    cudaStream_t stream);
+
+extern "C" void clamp_launcher(
+    const float* in,
+    float* out,
+    int total,
+    float min_val,
+    float max_val,
+    cudaStream_t stream);
+
+extern "C" void mask_not_equal_launcher(
+    const float* in,
+    bool* mask,
+    int total,
+    float mask_val,
+    cudaStream_t stream);
+
+extern "C" void masked_select_launcher(
+    const float* in,
+    const bool* mask,
+    float* out,
+    int total,
+    int* count,
+    cudaStream_t stream);
+
+// Wrapper for conv_transpose1d without bias
+torch::Tensor conv_transpose1d_bias_free_forward(torch::Tensor x, torch::Tensor weight) {
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(weight.is_cuda(), "weight must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(weight.dtype() == torch::kFloat32, "weight must be float32");
+    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
+    TORCH_CHECK(weight.is_contiguous(), "weight must be contiguous");
+    TORCH_CHECK(x.dim() == 3, "x must be 3D (N, C_in, L_in)");
+    TORCH_CHECK(weight.dim() == 3, "weight must be 3D (C_in, C_out, kernel_size)");
+
+    int N = x.size(0);
+    int C_in = x.size(1);
+    int L_in = x.size(2);
+    int C_out = weight.size(1);
+    int kernel_size = weight.size(2);
+    // Hardcoded stride, padding, output_padding as in model_new.py usage
+    int stride = 2;
+    int padding = 1;
+    int output_padding = 1;
+    int L_out = (L_in - 1) * stride - 2 * padding + kernel_size + output_padding;
+
+    TORCH_CHECK(weight.size(0) == C_in, "weight first dimension must match input channels");
+
+    auto out = torch::empty({N, C_out, L_out}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    conv_transpose1d_bias_free_launcher(
+        x.data_ptr<float>(),
+        weight.data_ptr<float>(),
+        out.data_ptr<float>(),
+        N, C_in, C_out, L_in, L_out,
+        kernel_size, stride, padding, output_padding,
+        stream);
+    return out;
+}
+
+// Wrapper for clamp (torch.clamp)
+torch::Tensor clamp_forward(torch::Tensor x, double min_val, double max_val) {
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
+
+    auto out = torch::empty_like(x);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    clamp_launcher(
+        x.data_ptr<float>(),
+        out.data_ptr<float>(),
+        x.numel(),
+        static_cast<float>(min_val),
+        static_cast<float>(max_val),
+        stream);
+    return out;
+}
+
+// Wrapper for mask_not_equal (debug only)
+torch::Tensor mask_not_equal_forward(torch::Tensor x, double mask_val) {
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
+
+    auto mask = torch::empty(x.sizes(), x.options().dtype(torch::kBool));
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    mask_not_equal_launcher(
+        x.data_ptr<float>(),
+        mask.data_ptr<bool>(),
+        x.numel(),
+        static_cast<float>(mask_val),
+        stream);
+    return mask;
+}
+
+// Helper to perform masked_select given a precomputed mask (debug only)
+torch::Tensor masked_select_from_mask_forward(torch::Tensor x, torch::Tensor mask) {
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(mask.is_cuda(), "mask must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(mask.dtype() == torch::kBool, "mask must be bool");
+    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
+    TORCH_CHECK(mask.is_contiguous(), "mask must be contiguous");
+    TORCH_CHECK(x.numel() == mask.numel(), "x and mask must have same number of elements");
+
+    int total = x.numel();
+    // Allocate maximum possible output size (total elements)
+    auto out = torch::empty({total}, x.options());
+    // Allocate device count tensor with one element initialized to 0
+    auto count = torch::zeros({1}, x.options().dtype(torch::kInt));
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    masked_select_launcher(
+        x.data_ptr<float>(),
+        mask.data_ptr<bool>(),
+        out.data_ptr<float>(),
+        total,
+        count.data_ptr<int>(),
+        stream);
+
+    // Copy count to CPU to get actual number of selected elements
+    int actual_count = count.cpu().item<int>();
+    return out.narrow(0, 0, actual_count);
+}
+
+// Wrapper for masked_select that combines mask creation and selection
+torch::Tensor masked_select_forward(torch::Tensor x, double mask_val) {
+    // Create mask on GPU
+    torch::Tensor mask = mask_not_equal_forward(x, mask_val);
+    return masked_select_from_mask_forward(x, mask);
+}
+
+// Registration
+void register_custom_ops(pybind11::module& m) {
+    m.def("conv_transpose1d_bias_free_forward", &conv_transpose1d_bias_free_forward,
+          "ConvTranspose1d without bias",
+          py::arg("x"), py::arg("weight"));
+    m.def("clamp_forward", &clamp_forward,
+          "Clamp forward",
+          py::arg("x"), py::arg("min_val"), py::arg("max_val"));
+    m.def("mask_not_equal_forward", &mask_not_equal_forward,
+          "Mask not equal (debug)",
+          py::arg("x"), py::arg("mask_val"));
+    m.def("masked_select_from_mask_forward", &masked_select_from_mask_forward,
+          "Masked select from mask (debug)",
+          py::arg("x"), py::arg("mask"));
+    m.def("masked_select_forward", &masked_select_forward,
+          "Masked select combined",
+          py::arg("x"), py::arg("mask_val"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,52 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+class ModelNew(nn.Module):
+    def __init__(
+        self,
+        in_channels,
+        out_channels,
+        kernel_size,
+        stride,
+        padding,
+        output_padding,
+        bias,
+        clamp_min,
+        clamp_max,
+        mask_val,
+    ):
+        super().__init__()
+        # Must match state_dict key: conv_transpose.weight
+        self.conv_transpose = nn.ConvTranspose1d(
+            in_channels,
+            out_channels,
+            kernel_size,
+            stride=stride,
+            padding=padding,
+            output_padding=output_padding,
+            bias=bias,
+        )
+        self.clamp_min = clamp_min
+        self.clamp_max = clamp_max
+        self.mask_val = mask_val
+
+    def forward(self, x):
+        # Step 1: conv transpose with no bias (bias=False)
+        x = cuda_extension.conv_transpose1d_bias_free_forward(x, self.conv_transpose.weight)
+        # Step 2: clamp
+        x = cuda_extension.clamp_forward(x, self.clamp_min, self.clamp_max)
+        # Step 3+4: mask and masked_select
+        x = cuda_extension.masked_select_forward(x, self.mask_val)
+        return x
+
+    def debug_forward(self, x):
+        x1 = cuda_extension.conv_transpose1d_bias_free_forward(x, self.conv_transpose.weight)
+        yield ("step_001", x1)
+        x2 = cuda_extension.clamp_forward(x1, self.clamp_min, self.clamp_max)
+        yield ("step_002", x2)
+        mask = cuda_extension.mask_not_equal_forward(x2, self.mask_val)
+        yield ("step_003", mask)
+        x3 = cuda_extension.masked_select_from_mask_forward(x2, mask)
+        yield ("step_004", x3)
+        yield ("step_005", x3)
