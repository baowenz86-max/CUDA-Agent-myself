@@ -0,0 +1,167 @@
+#include <cuda_runtime.h>
+
+// Pad a 4D tensor (N, C, H, W) with constant value on height and width dimensions.
+// input: contiguous float32 tensor of shape [N, C, H_in, W_in]
+// output: contiguous float32 tensor of shape [N, C, H_in + 2*pad, W_in + 2*pad]
+// pad: integer padding amount on each side (top, bottom, left, right)
+// value: constant fill value
+__global__ void pad2d_constant_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int N, int C, int H_in, int W_in,
+    int pad,
+    float value)
+{
+    // Total number of output elements
+    long long total = (long long)N * C * (H_in + 2 * pad) * (W_in + 2 * pad);
+    // Grid-stride loop for arbitrary size
+    for (long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+         idx < total;
+         idx += (long long)gridDim.x * blockDim.x)
+    {
+        // Decode linear index to (n, c, h_out, w_out)
+        int w_out = idx % (W_in + 2 * pad);
+        long long tmp = idx / (W_in + 2 * pad);
+        int h_out = tmp % (H_in + 2 * pad);
+        tmp = tmp / (H_in + 2 * pad);
+        int c = tmp % C;
+        int n = tmp / C;
+
+        // Determine input coordinates
+        int h_in = h_out - pad;
+        int w_in = w_out - pad;
+
+        if (h_in >= 0 && h_in < H_in && w_in >= 0 && w_in < W_in) {
+            // Inside original region: copy from input
+            long long input_idx = (((long long)n * C + c) * H_in + h_in) * W_in + w_in;
+            output[idx] = input[input_idx];
+        } else {
+            // Outside: fill with constant value
+            output[idx] = value;
+        }
+    }
+}
+
+extern "C" void pad2d_constant_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H_in, int W_in,
+    int pad,
+    float value,
+    cudaStream_t stream)
+{
+    int H_out = H_in + 2 * pad;
+    int W_out = W_in + 2 * pad;
+    long long total = (long long)N * C * H_out * W_out;
+
+    // Choose block size and grid size (capped to reasonable maximum)
+    int block = 256;
+    int grid = (int)min((total + block - 1) / block, (long long)65535 * 32); // grid-stride handles more
+    if (grid < 1) grid = 1;
+
+    pad2d_constant_kernel<<<grid, block, 0, stream>>>(
+        input, output, N, C, H_in, W_in, pad, value);
+
+    // Error check (no sync)
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // Cannot throw from extern "C" launcher; caller will handle via error check on stream
+        // Optionally print error, but no PyTorch dependency. We assume binding will check.
+    }
+}
+
+// Sum all elements of a contiguous float32 tensor.
+// input: contiguous float32 tensor of arbitrary shape, total number of elements = numel
+// output: pointer to a scalar float32 value (device memory)
+__global__ void sum_all_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    long long numel)
+{
+    // Each thread accumulates a local sum using grid-stride loop
+    float local_sum = 0.0f;
+    for (long long i = blockIdx.x * blockDim.x + threadIdx.x;
+         i < numel;
+         i += (long long)gridDim.x * blockDim.x)
+    {
+        local_sum += input[i];
+    }
+
+    // Warp-level reduction
+    for (int offset = 16; offset > 0; offset >>= 1) {
+        local_sum += __shfl_down_sync(0xffffffff, local_sum, offset);
+    }
+
+    // First thread in each warp writes to shared memory (optional)
+    // Simpler: use atomicAdd on output from each warp leader, then kernel 2 reduces block sums
+    // To avoid atomics on many threads, we can reduce within block using shared memory,
+    // but for simplicity and correctness, we use a two-kernel approach:
+    // Kernel 1: block-level reduction and atomicAdd to global output (risking non-determinism?)
+    // But sum is deterministic if additions are done in any order? Floating point addition is not associative,
+    // but we accept small differences within tolerance. AtomicAdd is allowed.
+    // However, we can do a two-stage reduction to improve performance and determinism.
+    // We'll implement a single-kernel with atomicAdd, then a second kernel to copy scalar.
+    // Actually, we can directly return scalar by using atomicAdd in one kernel.
+    // But the contract expects a 0-dimensional tensor output, so binding will allocate a scalar.
+    // We'll provide a launcher that assumes output points to a single float.
+    // Inside the kernel, each block computes partial sum and uses atomicAdd to accumulate.
+    // This doesn't preserve exact order but acceptable for float sum with atol/rtol 1e-2.
+    // To improve accuracy, we can use double atomic? But output is float32. We'll stick with float.
+
+    // We'll do block-level reduction using shared memory if needed; but simpler:
+    __shared__ float block_sum;
+    if (threadIdx.x == 0) block_sum = 0.0f;
+    __syncthreads();
+
+    // Warp reduce as above
+    // After warp reduce, each warp leader has sum of all threads in warp
+    // Write to shared memory per warp, then reduce across warps
+    int warpId = threadIdx.x / 32;
+    int laneId = threadIdx.x % 32;
+    if (laneId == 0) {
+        // store warp sum in shared array (number of warps = blockDim.x/32)
+        extern __shared__ float warp_sums[];
+        warp_sums[warpId] = local_sum;
+    }
+    __syncthreads();
+
+    // Now, first warp reduces warp_sums (number of warps)
+    int numWarps = blockDim.x / 32;
+    if (warpId == 0) {
+        float val = (laneId < numWarps) ? warp_sums[laneId] : 0.0f;
+        // reduce within first warp
+        for (int offset = 16; offset > 0; offset >>= 1) {
+            val += __shfl_down_sync(0xffffffff, val, offset);
+        }
+        if (laneId == 0) {
+            // add block sum to global output using atomicAdd
+            atomicAdd(output, val);
+        }
+    }
+}
+
+extern "C" void sum_all_launcher(
+    const float* input,
+    float* output,
+    long long numel,
+    cudaStream_t stream)
+{
+    // Ensure output is initialized to zero before kernel launch
+    cudaMemsetAsync(output, 0, sizeof(float), stream);
+
+    int block = 256;
+    int grid = (int)min((numel + block - 1) / block, (long long)65535 * 32);
+    if (grid < 1) grid = 1;
+
+    // Shared memory size for warp_sums: number of warps * float
+    int warps_per_block = block / 32; // 8
+    size_t shared_mem_size = warps_per_block * sizeof(float);
+
+    sum_all_kernel<<<grid, block, shared_mem_size, stream>>>(
+        input, output, numel);
+
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // error handling left to binding
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,104 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void pad2d_constant_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H_in, int W_in,
+    int pad,
+    float value,
+    cudaStream_t stream);
+
+extern "C" void sum_all_launcher(
+    const float* input,
+    float* output,
+    long long numel,
+    cudaStream_t stream);
+
+// PyTorch wrapper for constant padding on 4D tensor
+torch::Tensor pad2d_constant_forward(
+    torch::Tensor input,
+    int64_t pad,
+    double value)
+{
+    // Input checks
+    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(input.dim() == 4, "Input must be 4D (N, C, H, W)");
+
+    // Extract dimensions and validate pad
+    int N = input.size(0);
+    int C = input.size(1);
+    int H_in = input.size(2);
+    int W_in = input.size(3);
+    TORCH_CHECK(pad >= 0, "pad must be non-negative");
+    int H_out = H_in + 2 * static_cast<int>(pad);
+    int W_out = W_in + 2 * static_cast<int>(pad);
+
+    // Allocate output
+    auto output = torch::empty({N, C, H_out, W_out}, input.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    pad2d_constant_launcher(
+        input.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C, H_in, W_in,
+        static_cast<int>(pad),
+        static_cast<float>(value),
+        stream);
+
+    // Check for kernel launch errors
+    TORCH_CHECK(cudaGetLastError() == cudaSuccess, "pad2d_constant kernel launch failed");
+
+    return output;
+}
+
+// PyTorch wrapper for sum of all elements
+torch::Tensor sum_all_forward(torch::Tensor input)
+{
+    // Input checks
+    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
+
+    // Allocate scalar output (0-dimensional)
+    auto output = torch::empty({}, input.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher (numel as long long)
+    sum_all_launcher(
+        input.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<long long>(input.numel()),
+        stream);
+
+    // Check for kernel launch errors
+    TORCH_CHECK(cudaGetLastError() == cudaSuccess, "sum_all kernel launch failed");
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("pad2d_constant", &pad2d_constant_forward,
+          "Constant padding for 4D tensor",
+          py::arg("input"),
+          py::arg("pad"),
+          py::arg("value"));
+    m.def("sum_all", &sum_all_forward,
+          "Sum all elements",
+          py::arg("input"));
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);
