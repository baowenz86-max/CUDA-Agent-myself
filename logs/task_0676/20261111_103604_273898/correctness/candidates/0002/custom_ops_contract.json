{
  "operators": [
    {
      "name": "max_reduce_div_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N,C,H,W]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "keepdim",
          "kind": "bool",
          "optional": false,
          "nullable": false
        },
        {
          "name": "divisor",
          "kind": "float",
          "optional": false,
          "nullable": false
        }
