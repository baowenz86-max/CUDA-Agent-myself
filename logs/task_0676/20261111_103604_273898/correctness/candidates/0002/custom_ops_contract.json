      "returns": {
        "type": "tuple",
        "elements": [
          {
            "type": "tensor",
            "dtype": "torch.float32",
            "device": "cuda",
            "shape": "same as reference max values with keepdim=True"
          },
          {
            "type": "tensor",
            "dtype": "torch.int64",
            "device": "cuda",
            "shape": "same as reference max indices with keepdim=True"
