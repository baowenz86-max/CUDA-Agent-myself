--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,160 @@
+#include <cuda_runtime.h>
+#include <math.h>
+
+// Kernel: fused log_softmax along dim=1 followed by sum along dim=1
+// Input: x shape (B, H, W), strides: sx_b, sx_h, sx_w
+// Output: out shape (B, W), contiguous, strides: so_b = W, so_w = 1
+// Each thread block processes one (b,w) pair and reduces over H.
+__global__ void log_softmax_sum_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ out,
+    int B, int H, int W,
+    long long sx_b, long long sx_h, long long sx_w,
+    int so_b, int so_w) {
+    // Use 2D grid: (B, ceil(W/blockDim.x)) or use 1D grid with total = B*W
+    // We'll use 1D grid with one thread per (b,w), grid-stride loop if needed.
+    int total = B * W;
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+
+    for (int i = idx; i < total; i += stride) {
+        int b = i / W;
+        int w = i % W;
+
+        // Compute pointer to first element of this (b,w) column
+        const float* base = x + b * sx_b + w * sx_w;
+
+        // Find max along H (using H stride sx_h)
+        float max_val = base[0];
+        for (int h = 1; h < H; ++h) {
+            float val = base[h * sx_h];
+            if (val > max_val) max_val = val;
+        }
+
+        // Compute sum exp(x - max)
+        float sum_exp = 0.0f;
+        for (int h = 0; h < H; ++h) {
+            sum_exp += expf(base[h * sx_h] - max_val);
+        }
+
+        float log_sum_exp = logf(sum_exp);
+        // log_softmax_i = x_i - max - log_sum_exp
+        // sum over i of log_softmax_i = sum(x_i) - H*max - H*log_sum_exp
+        float sum_x = 0.0f;
+        for (int h = 0; h < H; ++h) {
+            sum_x += base[h * sx_h];
+        }
+
+        float result = sum_x - H * max_val - H * log_sum_exp;
+        out[b * so_b + w * so_w] = result;
+    }
+}
+
+// Kernel: log_softmax only, output same shape as input (B,H,W), with strides.
+// We assume output strides same as input strides for simplicity, but binding may allocate contiguous.
+// We'll take output strides as parameters.
+__global__ void log_softmax_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ y,
+    int B, int H, int W,
+    long long sx_b, long long sx_h, long long sx_w,
+    long long sy_b, long long sy_h, long long sy_w) {
+    int total = B * H * W;
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+
+    for (int i = idx; i < total; i += stride) {
+        int b = i / (H * W);
+        int rem = i % (H * W);
+        int h = rem / W;
+        int w = rem % W;
+
+        // Compute max in (b,w) column
+        const float* col_base = x + b * sx_b + w * sx_w;
+        float max_val = col_base[0];
+        for (int hh = 1; hh < H; ++hh) {
+            float val = col_base[hh * sx_h];
+            if (val > max_val) max_val = val;
+        }
+
+        // sum exp(x - max)
+        float sum_exp = 0.0f;
+        for (int hh = 0; hh < H; ++hh) {
+            sum_exp += expf(col_base[hh * sx_h] - max_val);
+        }
+        float log_sum_exp = logf(sum_exp);
+
+        // compute current value
+        float x_val = col_base[h * sx_h];
+        y[b * sy_b + h * sy_h + w * sy_w] = x_val - max_val - log_sum_exp;
+    }
+}
+
+// Kernel: sum along dim=1, output shape (B,W).
+__global__ void sum_dim_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ out,
+    int B, int H, int W,
+    long long sx_b, long long sx_h, long long sx_w,
+    int so_b, int so_w) {
+    int total = B * W;
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+
+    for (int i = idx; i < total; i += stride) {
+        int b = i / W;
+        int w = i % W;
+
+        const float* base = x + b * sx_b + w * sx_w;
+        float sum = 0.0f;
+        for (int h = 0; h < H; ++h) {
+            sum += base[h * sx_h];
+        }
+        out[b * so_b + w * so_w] = sum;
+    }
+}
+
+extern "C" void log_softmax_sum_launcher(
+    const float* x,
+    float* out,
+    int B, int H, int W,
+    long long sx_b, long long sx_h, long long sx_w,
+    int so_b, int so_w,
+    cudaStream_t stream) {
+    int total = B * W;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535; // grid cap, grid-stride loop handles rest
+    log_softmax_sum_kernel<<<blocks, threads, 0, stream>>>(
+        x, out, B, H, W, sx_b, sx_h, sx_w, so_b, so_w);
+}
+
+extern "C" void log_softmax_launcher(
+    const float* x,
+    float* y,
+    int B, int H, int W,
+    long long sx_b, long long sx_h, long long sx_w,
+    long long sy_b, long long sy_h, long long sy_w,
+    cudaStream_t stream) {
+    int total = B * H * W;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535;
+    log_softmax_kernel<<<blocks, threads, 0, stream>>>(
+        x, y, B, H, W, sx_b, sx_h, sx_w, sy_b, sy_h, sy_w);
+}
+
+extern "C" void sum_dim_launcher(
+    const float* x,
+    float* out,
+    int B, int H, int W,
+    long long sx_b, long long sx_h, long long sx_w,
+    int so_b, int so_w,
+    cudaStream_t stream) {
+    int total = B * W;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535;
+    sum_dim_kernel<<<blocks, threads, 0, stream>>>(
+        x, out, B, H, W, sx_b, sx_h, sx_w, so_b, so_w);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,131 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void log_softmax_sum_launcher(
+    const float* x,
+    float* out,
+    int B, int H, int W,
+    long long sx_b, long long sx_h, long long sx_w,
+    int so_b, int so_w,
+    cudaStream_t stream);
+
+extern "C" void log_softmax_launcher(
+    const float* x,
+    float* y,
+    int B, int H, int W,
+    long long sx_b, long long sx_h, long long sx_w,
+    long long sy_b, long long sy_h, long long sy_w,
+    cudaStream_t stream);
+
+extern "C" void sum_dim_launcher(
+    const float* x,
+    float* out,
+    int B, int H, int W,
+    long long sx_b, long long sx_h, long long sx_w,
+    int so_b, int so_w,
+    cudaStream_t stream);
+
+// Helper to get strides as long long for negative or large strides
+static inline long long stride_value(torch::Tensor t, int dim) {
+    return static_cast<long long>(t.stride(dim));
+}
+
+// Fused log_softmax (dim=1) then sum(dim=1)
+torch::Tensor log_softmax_sum_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 3, "Input must be 3D (B, H, W)");
+
+    int B = x.size(0);
+    int H = x.size(1);
+    int W = x.size(2);
+    TORCH_CHECK(H > 0, "H must be > 0");
+
+    auto out = torch::empty({B, W}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    log_softmax_sum_launcher(
+        x.data_ptr<float>(),
+        out.data_ptr<float>(),
+        B, H, W,
+        stride_value(x, 0), stride_value(x, 1), stride_value(x, 2),
+        out.stride(0), out.stride(1),
+        stream
+    );
+
+    return out;
+}
+
+// log_softmax along dim=1, output same shape as input
+torch::Tensor log_softmax_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 3, "Input must be 3D (B, H, W)");
+
+    int B = x.size(0);
+    int H = x.size(1);
+    int W = x.size(2);
+    TORCH_CHECK(H > 0, "H must be > 0");
+
+    auto y = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    log_softmax_launcher(
+        x.data_ptr<float>(),
+        y.data_ptr<float>(),
+        B, H, W,
+        stride_value(x, 0), stride_value(x, 1), stride_value(x, 2),
+        stride_value(y, 0), stride_value(y, 1), stride_value(y, 2),
+        stream
+    );
+
+    return y;
+}
+
+// sum along dim=1, output shape (B, W)
+torch::Tensor sum_dim_forward(torch::Tensor x, int64_t dim) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 3, "Input must be 3D (B, H, W)");
+    TORCH_CHECK(dim == 1, "Only dim=1 is supported for 3D input");
+
+    int B = x.size(0);
+    int H = x.size(1);
+    int W = x.size(2);
+
+    auto out = torch::empty({B, W}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    sum_dim_launcher(
+        x.data_ptr<float>(),
+        out.data_ptr<float>(),
+        B, H, W,
+        stride_value(x, 0), stride_value(x, 1), stride_value(x, 2),
+        out.stride(0), out.stride(1),
+        stream
+    );
+
+    return out;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("log_softmax_sum_forward", &log_softmax_sum_forward,
+          "Fused log_softmax(dim=1) + sum(dim=1)",
+          pybind11::arg("x"));
+    m.def("log_softmax_forward", &log_softmax_forward,
+          "log_softmax along dim=1",
+          pybind11::arg("x"));
+    m.def("sum_dim_forward", &sum_dim_forward,
+          "sum along dim=1",
+          pybind11::arg("x"),
+          pybind11::arg("dim"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,19 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x):
+        x = cuda_extension.log_softmax_sum_forward(x)
+        return x
+
+    def debug_forward(self, x):
+        x_log_softmax = cuda_extension.log_softmax_forward(x)
+        yield ('step_001', x_log_softmax)
+        x_sum = cuda_extension.sum_dim_forward(x_log_softmax, dim=1)
+        yield ('step_002', x_sum)
+        yield ('step_003', x_sum)
