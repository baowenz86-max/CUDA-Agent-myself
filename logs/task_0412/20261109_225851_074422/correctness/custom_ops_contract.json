{
  "operators": [
    {
      "name": "batch_norm_eval",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C, H, W]"
      },
      "semantics": [
        "等价于参考语句 x = self.batch_norm(x)，模型处于 eval 模式，使用 running_mean 和 running_var。",
        "对于每个通道 c，输出 y[n,c,h,w] = ((x[n,c,h,w] - running_mean[c]) / sqrt(running_var[c] + eps)) * weight[c] + bias[c]，如果 weight 或 bias 为 None 则省略对应项。",
        "eps 来自 BatchNorm2d 默认值 1e-05，由调用方作为标量参数传入。",
        "输入和权重/bias/统计量必须在同一个 CUDA 设备上，输出与输入形状相同。",
        "不修改 running_mean 和 running_var，不更新 num_batches_tracked。"
      ]
    },
    {
      "name": "avg_pool2d",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "kernel_size",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "stride",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "padding",
          "kind": "int",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C, H_out, W_out]"
      },
      "semantics": [
        "等价于参考语句 x = self.avg_pool(x)，使用 kernel_size=3, stride=2, padding=0，count_include_pad 为默认 True。",
        "输出尺寸 H_out = floor((H + 2*padding - kernel_size) / stride) + 1，W_out 同理。",
        "对于每个输出位置 (n, c, oh, ow)，对输入窗口 [oh*stride : oh*stride+kernel_size, ow*stride : ow*stride+kernel_size] 的所有元素求平均值，包括 padding 元素（如果 padding > 0，但本任务 padding=0）。",
        "输入和输出都在 CUDA 设备上，输出 shape 由公式决定。",
        "kernel_size、stride、padding 均为整数标量，由调用方指定，与本模型配置一致。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.batch_norm(x)",
      "semantics": [
        "BatchNorm2d 在 eval 模式下使用 running_mean 和 running_var 进行归一化，epsilon=1e-05，affine=True，使用 weight 和 bias。",
        "输入 shape [512,3,128,128]，输出 shape 相同，stride 不变，dtype float32，device cuda:0。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.avg_pool(x)",
      "semantics": [
        "AvgPool2d kernel_size=3, stride=2, padding=0，count_include_pad=True（但 padding=0 所以无影响）。",
        "输入 shape [512,3,128,128]，输出 shape [512,3,63,63]，stride [11907,3969,63,1]，dtype float32，device cuda:0。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "直接返回 avg_pool 的输出张量，无额外计算。"
      ]
    }
  ]
}