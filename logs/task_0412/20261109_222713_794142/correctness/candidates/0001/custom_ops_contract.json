{
  "operators": [
    {
      "name": "custom_batch_norm2d",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        },
        {
          "name": "training",
          "kind": "bool",
          "optional": false,
          "nullable": false
        },
        {
          "name": "momentum",
          "kind": "float",
          "optional": true,
          "nullable": false,
          "default": 0.1
        },
        {
          "name": "eps",
          "kind": "float",
          "optional": true,
          "nullable": false,
          "default": 1e-05
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "对应参考语句 x = self.batch_norm(x)，BatchNorm2d 在训练/评估模式下的前向。",
        "评估模式 (training=False) 使用 running_mean 和 running_var 进行归一化：y = weight * (x - running_mean) / sqrt(running_var + eps) + bias。",
        "训练模式 (training=True) 时按批量统计归一化并更新 running_mean/running_var，但本任务执行设备为 cuda 且参考模型处于训练模式需保持一致（根据 model.py 构造，默认 training=True？注意 task_contract 中 modules.batch_norm.training 为 false，但执行设备 cuda，因此以实际验证为准；此处契约实现评估模式，但绑定中需处理训练模式，然而模型不使用训练模式，所以仅需评估模式）。",
        "本任务中模型被实例化后直接 forward，不调用 .eval()，因此 BatchNorm2d 默认 training=True，但参考检查点值显示为评估后的结果？实际上参考执行可能已将模型设为 eval 模式。契约按参考实际输出为准：使用 running_mean 和 running_var。",
        "广播：per-channel，weight/bias/running_mean/running_var 形状 [C] 广播到 [N,C,H,W]。",
        "返回相同 shape、dtype、device 的张量。"
      ]
    },
    {
      "name": "custom_avg_pool2d",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "kernel_size",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "stride",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "padding",
          "kind": "int",
          "optional": true,
          "nullable": false,
          "default": 0
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C, floor((H + 2*padding - kernel_size)/stride + 1), floor((W + 2*padding - kernel_size)/stride + 1)]"
      },
      "semantics": [
        "对应参考语句 x = self.avg_pool(x)，AvgPool2d 前向。",
        "kernel_size=3, stride=2, padding=0，ceil_mode=False, count_include_pad=True（默认）。",
        "输出形状 [512,3,63,63]，计算式 floor((128-3)/2+1)=63。",
        "对每个输出位置，取输入窗口内元素平均值，无 padding 时窗口全有效。",
        "返回新的 CUDA 张量。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.batch_norm(x)",
      "semantics": [
        "输入 x 形状 [512,3,128,128] float32 CUDA。",
        "BatchNorm2d 评估模式：使用 running_mean/running_var 归一化，应用 weight/bias。",
        "输出形状相同 [512,3,128,128]。"
      ]
    },
    {
      "checkpoint": "step_002",
