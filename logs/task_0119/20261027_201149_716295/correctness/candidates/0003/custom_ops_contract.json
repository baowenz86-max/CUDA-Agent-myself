{
  "operators": [
    {
      "name": "batch_norm2d_inference",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference step (N, C, H, W)",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference weight (C,)",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference bias (C,)",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference running_mean (C,)",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference running_var (C,)",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对应参考语句 self.batch_norm(x) 在推理模式下的计算。",
        "BatchNorm2d 推理模式使用 running_mean 和 running_var 进行归一化：y = (x - running_mean) / sqrt(running_var + eps)，然后如果 weight 和 bias 不为 None，则应用 y = weight * y + bias。",
        "normalization 沿通道维度 C 进行，广播 weight、bias、running_mean、running_var 到 (N, C, H, W)。",
        "input 可以为非连续 stride，算子应正确处理 strides 或显式连续化。",
        "返回形状与 input 相同的张量。"
      ]
    },
    {
      "name": "leaky_relu_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference step",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "negative_slope",
          "kind": "float",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对应参考语句 F.leaky_relu(x, negative_slope=0.01)。",
        "逐元素计算：if input >= 0: output = input; else: output = negative_slope * input。",
        "不修改输入，返回新张量。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.batch_norm(x)",
      "semantics": [
        "BatchNorm2d 推理模式：使用 running_mean 和 running_var 进行归一化，然后应用 affine 变换（如果 affine=True）。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = F.leaky_relu(x, negative_slope=0.01)",
      "semantics": [
        "逐元素 leaky ReLU 激活，负斜率 0.01。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回最终张量。"
      ]
    }
  ]
}