    {
      "name": "histc_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "任意一维或多维张量，底层所有元素参与统计",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
