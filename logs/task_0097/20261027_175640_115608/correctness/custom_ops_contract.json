      "semantics": [
        "对应参考语句 x = self.conv_transpose(x)",
        "执行 ConvTranspose1d，输入形状 [N, C_in, L_in]，权重形状 [C_in, C_out, K]",
        "输出长度 L_out = (L_in - 1) * stride - 2 * padding + kernel_size + output_padding",
