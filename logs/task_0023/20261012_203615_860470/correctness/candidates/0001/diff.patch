--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,101 @@
+#include <cuda_runtime.h>
+#include <device_launch_parameters.h>
+
+// Helper: bitonic sort for 128 elements in registers
+__device__ void bitonic_sort_128(float* arr) {
+    // Stage 1: sort pairs
+    for (int k = 2; k <= 128; k <<= 1) {
+        for (int j = k >> 1; j > 0; j >>= 1) {
+            #pragma unroll
+            for (int i = 0; i < 128; ++i) {
+                int ixj = i ^ j;
+                if (ixj > i) {
+                    bool ascending = ((i & k) == 0);
+                    float a = arr[i];
+                    float b = arr[ixj];
+                    if ((ascending && a > b) || (!ascending && a < b)) {
+                        arr[i] = b;
+                        arr[ixj] = a;
+                    }
+                }
+            }
+        }
+    }
+}
+
+// Kernel: median along dim0 for float32, shape [N,C,H,W]
+// Output shape [C,H,W], lower median for even N
+__global__ void median_dim0_kernel(const float* input, float* output,
+                                   int N, int C, int H, int W) {
+    int spatial = H * W;
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= C * spatial) return;
+
+    int c = idx / spatial;
+    int hw = idx % spatial;
+
+    float vals[128];
+    // Load values along N dimension; input is contiguous with shape [N,C,H,W]
+    const float* base = input + c * spatial + hw;
+    #pragma unroll
+    for (int n = 0; n < 128; ++n) {
+        vals[n] = base[n * C * spatial]; // stride between n is C*spatial
+    }
+
+    bitonic_sort_128(vals);
+
+    // Lower median: index (N-1)/2 for even N, N/2 for odd (but N=128 even)
+    output[idx] = vals[(N - 1) / 2];
+}
+
+// Kernel: reflection padding 2D for each channel slice
+// input shape [C,H,W], output shape [C, H+2*pad, W+2*pad]
+__global__ void reflection_pad2d_kernel(const float* input, float* output,
+                                        int C, int H, int W, int pad) {
+    int outH = H + 2 * pad;
+    int outW = W + 2 * pad;
+    int total = C * outH * outW;
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= total) return;
+
+    int ow = idx % outW;
+    int tmp = idx / outW;
+    int oh = tmp % outH;
+    int c = tmp / outH;
+
+    // Compute reflected coordinates
+    int ih = oh - pad;
+    if (ih < 0) ih = -ih;
+    if (ih >= H) ih = 2 * (H - 1) - ih;
+
+    int iw = ow - pad;
+    if (iw < 0) iw = -iw;
+    if (iw >= W) iw = 2 * (W - 1) - iw;
+
+    output[idx] = input[(c * H + ih) * W + iw];
+}
+
+extern "C" void median_dim0_forward_launcher(
+    const float* input, float* output,
+    int N, int C, int H, int W,
+    cudaStream_t stream) {
+
+    int spatial = H * W;
+    int total = C * spatial;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    median_dim0_kernel<<<blocks, threads, 0, stream>>>(input, output, N, C, H, W);
+}
+
+extern "C" void reflection_pad2d_forward_launcher(
+    const float* input, float* output,
+    int C, int H, int W, int pad,
+    cudaStream_t stream) {
+
+    int outH = H + 2 * pad;
+    int outW = W + 2 * pad;
+    int total = C * outH * outW;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    reflection_pad2d_kernel<<<blocks, threads, 0, stream>>>(input, output, C, H, W, pad);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,88 @@
+// Binding for median_dim0_forward and reflection_pad2d_forward custom kernels
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void median_dim0_forward_launcher(
+    const float* input, float* output,
+    int N, int C, int H, int W,
+    cudaStream_t stream);
+
+extern "C" void reflection_pad2d_forward_launcher(
+    const float* input, float* output,
+    int C, int H, int W, int pad,
+    cudaStream_t stream);
+
+// Wrapper for median along dim0
+torch::Tensor median_dim0_forward(torch::Tensor input) {
+    // Input validation
+    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(input.dim() == 4, "Input must be 4D [N, C, H, W]");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
+
+    int N = input.size(0);
+    int C = input.size(1);
+    int H = input.size(2);
+    int W = input.size(3);
+
+    // Output tensor shape [C, H, W]
+    auto output = torch::empty({C, H, W}, input.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    median_dim0_forward_launcher(
+        input.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C, H, W,
+        stream
+    );
+
+    return output;
+}
+
+// Wrapper for reflection padding 2D
+torch::Tensor reflection_pad2d_forward(torch::Tensor input, int64_t pad_size) {
+    // Input validation
+    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(input.dim() == 3, "Input must be 3D [C, H, W]");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(pad_size >= 0, "pad_size must be non-negative");
+
+    int C = input.size(0);
+    int H = input.size(1);
+    int W = input.size(2);
+    int pad = static_cast<int>(pad_size);
+
+    int outH = H + 2 * pad;
+    int outW = W + 2 * pad;
+
+    // Output tensor shape [C, outH, outW]
+    auto output = torch::empty({C, outH, outW}, input.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    reflection_pad2d_forward_launcher(
+        input.data_ptr<float>(),
+        output.data_ptr<float>(),
+        C, H, W, pad,
+        stream
+    );
+
+    return output;
+}
+
+// Register bindings
+void register_custom_ops(pybind11::module& m) {
+    m.def("median_dim0_forward", &median_dim0_forward,
+          "Median along dim=0 for float32 tensor [N, C, H, W] -> [C, H, W]",
+          pybind11::arg("input"));
+    m.def("reflection_pad2d_forward", &reflection_pad2d_forward,
+          "Reflection pad 2D for float32 tensor [C, H, W] -> [C, H+2*pad, W+2*pad]",
+          pybind11::arg("input"),
+          pybind11::arg("pad_size"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);--- before/model_new.py
+++ after/model_new.py
