--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,28 @@
+#include <cuda_runtime.h>
+#include <cmath>
+
+// GELU approximate tanh formula: 0.5 * x * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))
+__global__ void gelu_forward_kernel(const float* __restrict__ input, float* __restrict__ output, int64_t numel) {
+    int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    int64_t stride = static_cast<int64_t>(blockDim.x) * gridDim.x;
+    const float sqrt_2_over_pi = 0.7978845608028654f; // sqrt(2/pi)
+    const float coeff = 0.044715f;
+    for (int64_t i = idx; i < numel; i += stride) {
+        float x = input[i];
+        float x_cube = x * x * x;
+        float inner = sqrt_2_over_pi * (x + coeff * x_cube);
+        float tanh_val = tanhf(inner);
+        output[i] = 0.5f * x * (1.0f + tanh_val);
+    }
+}
+
+extern "C" void gelu_forward_launcher(float* output, const float* input, int64_t numel, cudaStream_t stream) {
+    if (numel <= 0) return;
+    const int block_size = 256;
+    // Cap grid to avoid exceeding max grid dimension (2^31-1) for large tensors; grid-stride loop handles rest.
+    int64_t max_blocks_per_dim = 2147483647LL; // practical max for x dimension
+    int64_t blocks = (numel + block_size - 1) / block_size;
+    if (blocks > max_blocks_per_dim) blocks = max_blocks_per_dim;
+    int grid = static_cast<int>(blocks);
+    gelu_forward_kernel<<<grid, block_size, 0, stream>>>(input, output, numel);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,47 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// 声明来自 custom_ops.cu 的 launcher
+extern "C" void gelu_forward_launcher(
+    float* output,
+    const float* input,
+    int64_t numel,
+    cudaStream_t stream
+);
+
+// PyTorch 包装函数
+torch::Tensor gelu_forward(torch::Tensor x) {
+    // 输入检查
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+
+    int64_t numel = x.numel();
+    auto output = torch::empty_like(x);
+
+    // 获取当前 CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // 调用 CUDA launcher
+    gelu_forward_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        numel,
+        stream
+    );
+
+    return output;
+}
+
+// 注册函数
+void register_custom_ops(pybind11::module& m) {
+    m.def("gelu_forward", &gelu_forward, "GELU activation forward (approximate)",
+          py::arg("x"));
+}
+
+// 自动注册
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,31 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x):
+        x = cuda_extension.gelu_forward(x)
+        return x
+
+    def debug_forward(self, *inputs):
+        x = inputs[0]
+        x = cuda_extension.gelu_forward(x)
+        yield 'step_001', x
+        yield 'step_002', x
+
+
+batch_size = 16
+height, width = 512, 256
+
+
+def get_inputs():
+    x = torch.randn(batch_size, 256, height, width)
+    return [x]
+
+
+def get_init_inputs():
+    return []
