{
  "operators": [
    {
      "name": "bitwise_xor_fp32_custom",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[512, 320, 320]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "y",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[512, 320, 320]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[512, 320, 320]"
      },
      "semantics": [
        "计算 x_abs = torch.abs(x)，保持 float32",
        "将 x_abs 和 y 分别转换为 int64：使用 C++ static_cast<int64_t>(float_value) 截断小数部分，与 PyTorch .type(torch.int64) 行为一致（Tensor.to）",
        "对转换后的 int64 值执行按位异或",
        "将异或结果转换为 float32 返回",
        "输出形状与输入相同，设备为 CUDA"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = torch.abs(x)",
      "semantics": [
        "对输入 x 逐元素取绝对值，保持 float32 类型和形状"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.bitwise_xor(x.type(torch.int64), y.type(torch.int64)).type(torch.float32)",
      "semantics": [
        "将 x 绝对值转换为 int64（截断小数）",
        "将 y 转换为 int64（截断小数）",
        "对两个 int64 张量执行按位异或",
        "将异或结果转换回 float32"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回最终结果张量，形状 [512, 320, 320]，dtype float32，device cuda:0"
      ]
    }
  ]
}