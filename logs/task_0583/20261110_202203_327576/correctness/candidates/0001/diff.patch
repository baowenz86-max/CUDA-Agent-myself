--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,170 @@
+// kernels/custom_ops.cu
+// CUDA kernels for isinf_like, where_inf_replace, logsoftmax_dim1
+// All launchers are extern "C" for binding from C++.
+
+#include <cuda_runtime.h>
+#include <float.h>
+#include <stdint.h>
+
+// Helper: check for inf (either sign)
+__device__ __forceinline__ bool is_inf_f32(float x) {
+    // IEEE 754: inf has exponent all ones and mantissa zero
+    // Use C99 isinf-like bit check
+    union { float f; uint32_t u; } conv;
+    conv.f = x;
+    return (conv.u & 0x7FFFFFFF) == 0x7F800000;
+}
+
+// ------------------------- isinf_like -------------------------
+// Kernel: elementwise isinf on float input, output bool tensor
+__global__ void isinf_like_kernel(
+    const float* __restrict__ input,
+    bool* __restrict__ output,
+    int64_t numel
+) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx < numel) {
+        // The model uses contiguous tensors; strides are handled by binding layer
+        // by ensuring contiguity or providing data_ptr. Here we assume contiguous,
+        // but the launcher can be extended with strides if needed.
+        output[idx] = is_inf_f32(input[idx]);
+    }
+}
+
+extern "C" void isinf_like_launcher(
+    const float* input,
+    bool* output,
+    int64_t numel,
+    cudaStream_t stream
+) {
+    if (numel <= 0) return;
+    const int block_size = 256;
+    // Grid-stride not needed here because grid is sized to cover numel
+    int64_t grid = (numel + block_size - 1) / block_size;
+    // Cap grid to avoid overflow (grid can be large but within int range for practical sizes)
+    // For numel up to 134M, grid is about 524288, fine.
+    isinf_like_kernel<<<(unsigned int)grid, block_size, 0, stream>>>(
+        input, output, numel
+    );
+    // Error check done by binding layer after call (optional)
+    // cudaError_t err = cudaGetLastError();
+}
+
+// ------------------------- where_inf_replace -------------------------
+// Kernel: if mask true, set output to -inf; else copy input
+__global__ void where_inf_replace_kernel(
+    const bool* __restrict__ mask,
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int64_t numel
+) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx < numel) {
+        output[idx] = mask[idx] ? -CUDART_INF_F : input[idx];
+    }
+}
+
+extern "C" void where_inf_replace_launcher(
+    const bool* mask,
+    const float* input,
+    float* output,
+    int64_t numel,
+    cudaStream_t stream
+) {
+    if (numel <= 0) return;
+    const int block_size = 256;
+    int64_t grid = (numel + block_size - 1) / block_size;
+    where_inf_replace_kernel<<<(unsigned int)grid, block_size, 0, stream>>>(
+        mask, input, output, numel
+    );
+}
+
+// ------------------------- logsoftmax_dim1 -------------------------
+// Compute log_softmax along dim=1 of a 4D tensor [N, C, H, W]
+// The reduction dimension C is contiguous in original layout, but the input
+// may be non-contiguous. Binding layer will ensure contiguity or pass strides.
+// For simplicity and performance, we assume contiguous input and output, which
+// is valid for the given model where x is created by randn and remains contiguous
+// through the previous ops (isinf_like and where_inf_replace both output contiguous).
+// However, to be robust, we pass strides to launcher. In this kernel, we handle
+// arbitrary strides by computing indices. Since the dimension order is fixed as
+// [N, C, H, W] and dim=1, we can use the actual strides.
+// We'll implement a kernel with one thread per spatial location (H*W) per batch,
+// and each thread loops over channels to compute max and sum exp, then writes output.
+// This avoids shared memory and handles arbitrary strides elegantly.
+
+// Kernel grid: blockDim.x threads handle consecutive spatial positions (H*W),
+// blockIdx.x handles batch index N.
+__global__ void logsoftmax_dim1_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int64_t N,
+    int64_t C,
+    int64_t H,
+    int64_t W,
+    int64_t strideN,
+    int64_t strideC,
+    int64_t strideH,
+    int64_t strideW
+) {
+    int64_t hw = H * W;
+    int64_t spatial_idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (spatial_idx >= hw) return;
+    int64_t h = spatial_idx / W;
+    int64_t w = spatial_idx - h * W;
+    // offset to base of this batch's (h,w) location
+    int64_t base_offset = blockIdx.y * strideN + h * strideH + w * strideW;
+    
+    // Find max over channels
+    float max_val = -CUDART_INF_F;
+    for (int64_t c = 0; c < C; ++c) {
+        float val = input[base_offset + c * strideC];
+        if (val > max_val) max_val = val;
+    }
+    
+    // Compute sum of exp(x - max)
+    float sum_exp = 0.0f;
+    for (int64_t c = 0; c < C; ++c) {
+        float val = input[base_offset + c * strideC];
+        sum_exp += __expf(val - max_val);
+    }
+    
+    float log_sum_exp = __logf(sum_exp);
+    
+    // Write output: input - max - log_sum_exp
+    for (int64_t c = 0; c < C; ++c) {
+        float val = input[base_offset + c * strideC];
+        output[base_offset + c * strideC] = val - max_val - log_sum_exp;
+    }
+}
+
+extern "C" void logsoftmax_dim1_launcher(
+    const float* input,
+    float* output,
+    int64_t N,
+    int64_t C,
+    int64_t H,
+    int64_t W,
+    int64_t strideN,
+    int64_t strideC,
+    int64_t strideH,
+    int64_t strideW,
+    cudaStream_t stream
+) {
+    if (N <= 0 || C <= 0 || H <= 0 || W <= 0) return;
+    int64_t hw = H * W;
+    const int block_size = 256; // threads per block for spatial dimension
+    int64_t grid_x = (hw + block_size - 1) / block_size;
+    int64_t grid_y = N; // one block row per batch element
+    dim3 grid((unsigned int)grid_x, (unsigned int)grid_y);
+    dim3 block(block_size);
+    logsoftmax_dim1_kernel<<<grid, block, 0, stream>>>(
+        input, output, N, C, H, W,
+        strideN, strideC, strideH, strideW
+    );
+}
+
+// Note: The binding layer must ensure input is float32 CUDA tensor, and allocate
+// output with same shape and dtype. The strides passed to launcher are the actual
+// strides of the tensor, which may not be contiguous. This implementation handles
+// arbitrary strides correctly.
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,131 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_runtime.h>
+#include <vector>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void isinf_like_launcher(
+    const float* input,
+    bool* output,
+    int64_t numel,
+    cudaStream_t stream);
+
+extern "C" void where_inf_replace_launcher(
+    const bool* mask,
+    const float* input,
+    float* output,
+    int64_t numel,
+    cudaStream_t stream);
+
+extern "C" void logsoftmax_dim1_launcher(
+    const float* input,
+    float* output,
+    int64_t N,
+    int64_t C,
+    int64_t H,
+    int64_t W,
+    int64_t strideN,
+    int64_t strideC,
+    int64_t strideH,
+    int64_t strideW,
+    cudaStream_t stream);
+
+// Helper to check CUDA tensor and dtype
+void check_cuda_float(torch::Tensor& t, const char* name) {
+    TORCH_CHECK(t.is_cuda(), name, " must be a CUDA tensor");
+    TORCH_CHECK(t.dtype() == torch::kFloat32, name, " must be float32");
+}
+
+void check_cuda_bool(torch::Tensor& t, const char* name) {
+    TORCH_CHECK(t.is_cuda(), name, " must be a CUDA tensor");
+    TORCH_CHECK(t.dtype() == torch::kBool, name, " must be bool");
+}
+
+// isinf_like wrapper
+torch::Tensor isinf_like(torch::Tensor x) {
+    check_cuda_float(x, "x");
+    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
+
+    auto output = torch::empty(x.sizes(), x.options().dtype(torch::kBool));
+    int64_t numel = x.numel();
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    isinf_like_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<bool>(),
+        numel,
+        stream
+    );
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "isinf_like kernel failed: ", cudaGetErrorString(err));
+    return output;
+}
+
+// where_inf_replace wrapper
+torch::Tensor where_inf_replace(torch::Tensor inf_mask, torch::Tensor x) {
+    check_cuda_bool(inf_mask, "inf_mask");
+    check_cuda_float(x, "x");
+    TORCH_CHECK(inf_mask.sizes() == x.sizes(), "inf_mask and x must have the same shape");
+    TORCH_CHECK(inf_mask.is_contiguous(), "inf_mask must be contiguous");
+    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
+
+    auto output = torch::empty_like(x);
+    int64_t numel = x.numel();
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    where_inf_replace_launcher(
+        inf_mask.data_ptr<bool>(),
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        numel,
+        stream
+    );
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "where_inf_replace kernel failed: ", cudaGetErrorString(err));
+    return output;
+}
+
+// logsoftmax_dim1 wrapper
+torch::Tensor logsoftmax_dim1(torch::Tensor x) {
+    check_cuda_float(x, "x");
+    TORCH_CHECK(x.dim() == 4, "x must be 4D");
+    // Require contiguous? The launcher handles arbitrary strides; we just need
+    // to pass the strides to the kernel. We allocate output with same strides as input.
+    // The kernel uses input strides to index both input and output, so output must have
+    // identical strides for correct memory layout. We allocate with empty_strided.
+    auto output = torch::empty_strided(x.sizes(), x.strides(), x.options());
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+    int64_t strideN = x.stride(0);
+    int64_t strideC = x.stride(1);
+    int64_t strideH = x.stride(2);
+    int64_t strideW = x.stride(3);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    logsoftmax_dim1_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C, H, W,
+        strideN, strideC, strideH, strideW,
+        stream
+    );
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "logsoftmax_dim1 kernel failed: ", cudaGetErrorString(err));
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("isinf_like", &isinf_like, "Elementwise isinf detection",
+          py::arg("x"));
+    m.def("where_inf_replace", &where_inf_replace, "Replace inf with -inf based on mask",
+          py::arg("inf_mask"), py::arg("x"));
+    m.def("logsoftmax_dim1", &logsoftmax_dim1, "Log softmax along dim=1",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,30 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, input_channels, num_classes):
+        super().__init__()
+        # 参考模型没有可训练参数，保持 state_dict 为空
+        self.input_channels = input_channels
+        self.num_classes = num_classes
+
+    def forward(self, x):
+        # 检测 inf 元素
+        inf_mask = cuda_extension.isinf_like(x)
+        # 将 inf 替换为 -inf
+        x = cuda_extension.where_inf_replace(inf_mask, x)
+        # 沿 dim=1 执行 log_softmax
+        x = cuda_extension.logsoftmax_dim1(x)
+        return x
+
+    def debug_forward(self, *inputs):
+        (x,) = inputs
+        inf_mask = cuda_extension.isinf_like(x)
+        yield "step_001", inf_mask
+        x = cuda_extension.where_inf_replace(inf_mask, x)
+        yield "step_002", x
+        x = cuda_extension.logsoftmax_dim1(x)
+        yield "step_003", x
+        yield "step_004", x
