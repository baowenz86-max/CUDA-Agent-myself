--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,74 @@
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// Average pooling 3D forward kernel.
+// Compute each output element as the mean of the corresponding input window.
+// Supports arbitrary input strides by using provided pitch values.
+__global__ void avg_pool3d_forward_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int out_depth, int out_height, int out_width,
+    int kernel_depth, int kernel_height, int kernel_width,
+    int stride_depth, int stride_height, int stride_width,
+    int padding_depth, int padding_height, int padding_width,
+    int64_t in_stride_batch, int64_t in_stride_channel, int64_t in_stride_depth,
+    int64_t in_stride_height, int64_t in_stride_width,
+    int64_t out_stride_batch, int64_t out_stride_channel, int64_t out_stride_depth,
+    int64_t out_stride_height, int64_t out_stride_width)
+{
+    int64_t idx = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t total = (int64_t)out_depth * out_height * out_width * gridDim.x * blockDim.x;
+    int64_t stride = (int64_t)gridDim.x * blockDim.x;
+    // The grid is 1D over all output elements across batch, channel, and spatial dims.
+    // We use grid-stride loop with total as the product of all output dimensions
+    // and the batch/channel offsets computed from the flattened index.
+
+    int out_spatial_size = out_depth * out_height * out_width;
+    int batch_size = (int)(total / (int64_t)out_spatial_size / (int64_t)(in_stride_channel / in_stride_width)); // not reliable, compute batch and channels separately
+    // Actually we need batch and channel counts. We assume caller passes them via launcher and kernel parameters.
+    // Since we cannot redefine constants here, we receive total and infer from strides:
+    // batch = total / (channels * out_spatial_size). channels = ?
+    // Better: we include batch and channel as parameters or compute from strides.
+    // The launcher knows them, so we pass them as additional kernel parameters.
+    // To keep kernel signature manageable, we'll pass batch and channel as int parameters.
+    // They are added by the launcher.
+}
+
+// Host launcher for avg_pool3d_forward.
+// Signature must be used by the C++ binding (not provided here).
+extern "C" void avg_pool3d_forward_launcher(
+    const float* input,
+    float* output,
+    int batch,
+    int channels,
+    int in_depth, int in_height, int in_width,
+    int out_depth, int out_height, int out_width,
+    int kernel_depth, int kernel_height, int kernel_width,
+    int stride_depth, int stride_height, int stride_width,
+    int padding_depth, int padding_height, int padding_width,
+    int64_t in_stride_batch, int64_t in_stride_channel, int64_t in_stride_depth,
+    int64_t in_stride_height, int64_t in_stride_width,
+    int64_t out_stride_batch, int64_t out_stride_channel, int64_t out_stride_depth,
+    int64_t out_stride_height, int64_t out_stride_width,
+    cudaStream_t stream)
+{
+    // Determine total number of output elements.
+    int64_t total_out = (int64_t)batch * channels * out_depth * out_height * out_width;
+    if (total_out <= 0) return;
+
+    const int block_size = 256;
+    int64_t grid_size = (total_out + block_size - 1) / block_size;
+    if (grid_size > 2147483647LL) grid_size = 2147483647LL; // grid dimension limit
+
+    avg_pool3d_forward_kernel<<<(int)grid_size, block_size, 0, stream>>>(
+        input, output,
+        out_depth, out_height, out_width,
+        kernel_depth, kernel_height, kernel_width,
+        stride_depth, stride_height, stride_width,
+        padding_depth, padding_height, padding_width,
+        in_stride_batch, in_stride_channel, in_stride_depth,
+        in_stride_height, in_stride_width,
+        out_stride_batch, out_stride_channel, out_stride_depth,
+        out_stride_height, out_stride_width,
+        batch, channels);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,114 @@
+// custom_ops_binding.cpp
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// launcher declaration from custom_ops.cu
+extern "C" void avg_pool3d_forward_launcher(
+    const float* input,
+    float* output,
+    int batch,
+    int channels,
+    int in_depth, int in_height, int in_width,
+    int out_depth, int out_height, int out_width,
+    int kernel_depth, int kernel_height, int kernel_width,
+    int stride_depth, int stride_height, int stride_width,
+    int padding_depth, int padding_height, int padding_width,
+    int64_t in_stride_batch, int64_t in_stride_channel, int64_t in_stride_depth,
+    int64_t in_stride_height, int64_t in_stride_width,
+    int64_t out_stride_batch, int64_t out_stride_channel, int64_t out_stride_depth,
+    int64_t out_stride_height, int64_t out_stride_width,
+    cudaStream_t stream);
+
+static torch::Tensor avg_pool3d_forward(
+    torch::Tensor x,
+    int64_t kernel_depth,
+    int64_t kernel_height,
+    int64_t kernel_width,
+    int64_t stride_depth,
+    int64_t stride_height,
+    int64_t stride_width,
+    int64_t padding_depth,
+    int64_t padding_height,
+    int64_t padding_width)
+{
+    // Input checks
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(x.dim() == 5, "x must be 5D (batch, channels, depth, height, width)");
+
+    int batch = x.size(0);
+    int channels = x.size(1);
+    int in_depth = x.size(2);
+    int in_height = x.size(3);
+    int in_width = x.size(4);
+
+    int out_depth = (in_depth + 2 * padding_depth - kernel_depth) / stride_depth + 1;
+    int out_height = (in_height + 2 * padding_height - kernel_height) / stride_height + 1;
+    int out_width = (in_width + 2 * padding_width - kernel_width) / stride_width + 1;
+    TORCH_CHECK(out_depth > 0 && out_height > 0 && out_width > 0, "Invalid output dimensions");
+
+    // Get input strides (in elements)
+    int64_t in_stride_batch = x.stride(0);
+    int64_t in_stride_channel = x.stride(1);
+    int64_t in_stride_depth = x.stride(2);
+    int64_t in_stride_height = x.stride(3);
+    int64_t in_stride_width = x.stride(4);
+
+    // Create output tensor with contiguous strides
+    auto output_options = torch::TensorOptions().dtype(torch::kFloat32).device(x.device());
+    torch::Tensor output = torch::empty({batch, channels, out_depth, out_height, out_width}, output_options);
+
+    // Output strides (contiguous, in elements)
+    int64_t out_stride_batch = output.stride(0);
+    int64_t out_stride_channel = output.stride(1);
+    int64_t out_stride_depth = output.stride(2);
+    int64_t out_stride_height = output.stride(3);
+    int64_t out_stride_width = output.stride(4);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    avg_pool3d_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        batch,
+        channels,
+        in_depth, in_height, in_width,
+        out_depth, out_height, out_width,
+        (int)kernel_depth, (int)kernel_height, (int)kernel_width,
+        (int)stride_depth, (int)stride_height, (int)stride_width,
+        (int)padding_depth, (int)padding_height, (int)padding_width,
+        in_stride_batch, in_stride_channel, in_stride_depth,
+        in_stride_height, in_stride_width,
+        out_stride_batch, out_stride_channel, out_stride_depth,
+        out_stride_height, out_stride_width,
+        stream
+    );
+
+    // Check for kernel launch errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "avg_pool3d_forward_launcher failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+static void register_avg_pool3d_forward(pybind11::module& m) {
+    m.def("avg_pool3d_forward", &avg_pool3d_forward,
+          "AvgPool3d forward (CUDA)",
+          py::arg("x"),
+          py::arg("kernel_depth"),
+          py::arg("kernel_height"),
+          py::arg("kernel_width"),
+          py::arg("stride_depth"),
+          py::arg("stride_height"),
+          py::arg("stride_width"),
+          py::arg("padding_depth"),
+          py::arg("padding_height"),
+          py::arg("padding_width"));
+}
+
+REGISTER_BINDING(avg_pool3d_forward, register_avg_pool3d_forward);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,26 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, kernel_size):
+        super().__init__()
+        self.in_channels = in_channels
+        self.kernel_size = kernel_size
+
+    def forward(self, x):
+        kd, kh, kw = self.kernel_size
+        # AvgPool3d 的 stride 默认等于 kernel_size，padding 默认为 0
+        return cuda_extension.avg_pool3d_forward(
+            x, kd, kh, kw, kd, kh, kw, 0, 0, 0
+        )
+
+    def debug_forward(self, *inputs):
+        x = inputs[0]
+        kd, kh, kw = self.kernel_size
+        result = cuda_extension.avg_pool3d_forward(
+            x, kd, kh, kw, kd, kh, kw, 0, 0, 0
+        )
+        yield "step_001", result
+        yield "step_002", result
