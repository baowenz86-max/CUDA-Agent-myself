--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,64 @@
+#include <cuda_runtime.h>
+#include <device_launch_parameters.h>
+
+// Fused concatenation along dim=1 followed by erf.
+// Inputs: two tensors with same shape except dim=1.
+// in0: [N, C0, H, W], in1: [N, C1, H, W]
+// output: [N, C0+C1, H, W] = erf(cat(in0, in1, dim=1))
+// All tensors are contiguous (reference inputs are contiguous, output allocated contiguous).
+// Boundary checks included for safety.
+
+template <typename T>
+__global__ void cat_erf_kernel(
+    T* __restrict__ out,
+    const T* __restrict__ in0,
+    const T* __restrict__ in1,
+    int N, int C0, int C1, int H, int W)
+{
+    int total = N * (C0 + C1) * H * W;
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+
+    for (int i = idx; i < total; i += stride) {
+        // decompose i -> n, c, hw
+        int hw = H * W;
+        int plane = i / hw;
+        int hw_idx = i - plane * hw;
+        int n = plane / (C0 + C1);
+        int c = plane - n * (C0 + C1);
+
+        const T* src;
+        int src_idx;
+        if (c < C0) {
+            src = in0;
+            src_idx = (n * C0 + c) * hw + hw_idx;
+        } else {
+            src = in1;
+            int c1 = c - C0;
+            src_idx = (n * C1 + c1) * hw + hw_idx;
+        }
+        out[i] = erff(src[src_idx]);
+    }
+}
+
+// Launcher: assumes out, in0, in1 are valid CUDA float pointers.
+// All sizes > 0. If any size is zero, does nothing (not expected in this task).
+extern "C" void custom_cat_erf_launcher(
+    float* out,
+    const float* in0,
+    const float* in1,
+    int N, int C0, int C1, int H, int W,
+    cudaStream_t stream)
+{
+    if (N <= 0 || C0 <= 0 || C1 <= 0 || H <= 0 || W <= 0) return;
+
+    int total = N * (C0 + C1) * H * W;
+    const int block_size = 256;
+    int grid_size = (total + block_size - 1) / block_size;
+    // Cap grid to avoid too many blocks for very large tensors, use grid-stride loop.
+    // For total ~209M, grid_size would be ~819k; cap to 65535.
+    if (grid_size > 65535) grid_size = 65535;
+
+    cat_erf_kernel<float><<<grid_size, block_size, 0, stream>>>(
+        out, in0, in1, N, C0, C1, H, W);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,77 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include <vector>
+#include "../binding_registry.h"
+
+// Declaration of CUDA launcher from custom_ops.cu
+extern "C" void custom_cat_erf_launcher(
+    float* out,
+    const float* in0,
+    const float* in1,
+    int N, int C0, int C1, int H, int W,
+    cudaStream_t stream);
+
+// Binding implementation: concatenates two tensors along dim=1 and applies erf.
+// The contract expects a single argument 'inputs' which is a list of tensors.
+// Since the launcher handles exactly two 4D contiguous tensors, we enforce that.
+static torch::Tensor custom_cat_erf(std::vector<torch::Tensor> inputs) {
+    TORCH_CHECK(inputs.size() == 2, "custom_cat_erf expects exactly 2 input tensors");
+    
+    torch::Tensor a = inputs[0];
+    torch::Tensor b = inputs[1];
+    
+    // Validate device, dtype, and contiguity (make contiguous if needed)
+    TORCH_CHECK(a.is_cuda() && b.is_cuda(), "Input tensors must be CUDA tensors");
+    TORCH_CHECK(a.dtype() == torch::kFloat32 && b.dtype() == torch::kFloat32,
+                "Input tensors must be float32");
+    TORCH_CHECK(a.dim() == 4 && b.dim() == 4, "Input tensors must be 4D");
+    
+    // Make contiguous (the reference inputs are contiguous, but we should handle non-contiguous safely)
+    if (!a.is_contiguous()) a = a.contiguous();
+    if (!b.is_contiguous()) b = b.contiguous();
+    
+    // Extract dimensions: assume [N, C, H, W]
+    int N = a.size(0);
+    int C0 = a.size(1);
+    int H = a.size(2);
+    int W = a.size(3);
+    
+    int N1 = b.size(0);
+    int C1 = b.size(1);
+    int H1 = b.size(2);
+    int W1 = b.size(3);
+    
+    TORCH_CHECK(N == N1 && H == H1 && W == W1,
+                "Input tensors must have same N, H, W dimensions for concatenation along dim=1");
+    
+    // Allocate output tensor with concatenated channels
+    auto output = torch::empty({N, C0 + C1, H, W}, a.options());
+    
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    
+    // Call CUDA launcher
+    custom_cat_erf_launcher(
+        output.data_ptr<float>(),
+        a.data_ptr<float>(),
+        b.data_ptr<float>(),
+        N, C0, C1, H, W,
+        stream
+    );
+    
+    // Check for kernel launch errors (optional but good practice)
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA kernel launch failed: ", cudaGetErrorString(err));
+    
+    return output;
+}
+
+// Registration function
+static void register_custom_cat_erf(pybind11::module& m) {
+    m.def("custom_cat_erf", &custom_cat_erf, py::arg("inputs"));
+}
+
+// Auto-register
+REGISTER_BINDING(custom_cat_erf, register_custom_cat_erf);
