--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,101 @@
+#include <cuda_runtime.h>
+#include <cmath>
+
+// Sigmoid kernel: output[i] = 1 / (1 + exp(-input[i]))
+// Supports arbitrary strides via provided input/output strides (in elements).
+__global__ void sigmoid_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    long long numel)
+{
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (long long i = idx; i < numel; i += stride) {
+        output[i] = 1.0f / (1.0f + expf(-input[i]));
+    }
+}
+
+// Cosine similarity kernel along dim=1 (channel dimension of size C).
+// Input shape: [B, C, H*W] flattened, output shape [B, H*W].
+// Each thread computes one output element: sum(x1*x2) / (sqrt(sum(x1^2)) * sqrt(sum(x2^2)))
+// If denominator is zero, output 0 (matching PyTorch behavior).
+__global__ void cosine_similarity_kernel(
+    const float* __restrict__ x1,
+    const float* __restrict__ x2,
+    float* __restrict__ output,
+    int B,
+    int C,
+    int HW,
+    long long stride_b1,   // stride of batch dimension in x1 (in elements)
+    long long stride_c1,   // stride of channel dimension in x1
+    long long stride_b2,   // stride of batch dimension in x2
+    long long stride_c2,   // stride of channel dimension in x2
+    long long out_numel)
+{
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (long long i = idx; i < out_numel; i += stride) {
+        int b = i / HW;
+        int hw = i % HW;
+        float dot = 0.0f;
+        float norm1 = 0.0f;
+        float norm2 = 0.0f;
+        for (int c = 0; c < C; ++c) {
+            long long idx1 = (long long)b * stride_b1 + (long long)c * stride_c1 + hw;
+            long long idx2 = (long long)b * stride_b2 + (long long)c * stride_c2 + hw;
+            float v1 = x1[idx1];
+            float v2 = x2[idx2];
+            dot += v1 * v2;
+            norm1 += v1 * v1;
+            norm2 += v2 * v2;
+        }
+        float denom = sqrtf(norm1) * sqrtf(norm2);
+        output[i] = (denom == 0.0f) ? 0.0f : (dot / denom);
+    }
+}
+
+// Launcher for sigmoid_forward.
+// Inputs: raw pointers, num elements, CUDA stream.
+extern "C" void sigmoid_forward_launcher(
+    const float* input,
+    float* output,
+    long long numel,
+    cudaStream_t stream)
+{
+    if (numel == 0) return;
+    int threads = 256;
+    // Cap grid to avoid exceeding limits, grid-stride loop handles rest.
+    long long blocks_ll = (numel + threads - 1) / threads;
+    int max_blocks = 65535; // arbitrary high but safe for all current GPUs
+    if (blocks_ll > max_blocks) blocks_ll = max_blocks;
+    int blocks = (int)blocks_ll;
+    sigmoid_kernel<<<blocks, threads, 0, stream>>>(input, output, numel);
+}
+
+// Launcher for cosine_similarity_forward.
+// Inputs: raw pointers, dimensions, strides (in elements), CUDA stream.
+extern "C" void cosine_similarity_forward_launcher(
+    const float* x1,
+    const float* x2,
+    float* output,
+    int B,
+    int C,
+    int HW,
+    long long stride_b1,
+    long long stride_c1,
+    long long stride_b2,
+    long long stride_c2,
+    long long out_numel,
+    cudaStream_t stream)
+{
+    if (out_numel == 0) return;
+    int threads = 256;
+    long long blocks_ll = (out_numel + threads - 1) / threads;
+    int max_blocks = 65535;
+    if (blocks_ll > max_blocks) blocks_ll = max_blocks;
+    int blocks = (int)blocks_ll;
+    cosine_similarity_kernel<<<blocks, threads, 0, stream>>>(
+        x1, x2, output, B, C, HW,
+        stride_b1, stride_c1, stride_b2, stride_c2,
+        out_numel);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,107 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_runtime.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void sigmoid_forward_launcher(
+    const float* input,
+    float* output,
+    long long numel,
+    cudaStream_t stream);
+
+extern "C" void cosine_similarity_forward_launcher(
+    const float* x1,
+    const float* x2,
+    float* output,
+    int B,
+    int C,
+    int HW,
+    long long stride_b1,
+    long long stride_c1,
+    long long stride_b2,
+    long long stride_c2,
+    long long out_numel,
+    cudaStream_t stream);
+
+torch::Tensor sigmoid_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "sigmoid_forward: input must be a CUDA tensor");
+    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "sigmoid_forward: input must be float32");
+
+    // Make contiguous if needed; launcher assumes contiguous data
+    auto x_contig = x.contiguous();
+    auto output = torch::empty_like(x_contig);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    sigmoid_forward_launcher(
+        x_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<long long>(x_contig.numel()),
+        stream
+    );
+
+    // Check for kernel launch errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "sigmoid_forward kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+torch::Tensor cosine_similarity_forward(torch::Tensor x1, torch::Tensor x2) {
+    TORCH_CHECK(x1.is_cuda() && x2.is_cuda(), "cosine_similarity_forward: inputs must be CUDA tensors");
+    TORCH_CHECK(x1.scalar_type() == torch::kFloat32 && x2.scalar_type() == torch::kFloat32,
+                "cosine_similarity_forward: inputs must be float32");
+    TORCH_CHECK(x1.dim() >= 3 && x2.dim() >= 3, "cosine_similarity_forward: inputs must have at least 3 dimensions");
+    TORCH_CHECK(x1.sizes() == x2.sizes(), "cosine_similarity_forward: input shapes must match");
+
+    // Make contiguous
+    auto x1_contig = x1.contiguous();
+    auto x2_contig = x2.contiguous();
+
+    int B = static_cast<int>(x1_contig.size(0));
+    int C = static_cast<int>(x1_contig.size(1));
+    int HW = 1;
+    for (int i = 2; i < x1_contig.dim(); ++i) {
+        HW *= static_cast<int>(x1_contig.size(i));
+    }
+
+    // Output shape [B, HW] (all dims from 2 onward flattened)
+    std::vector<int64_t> out_sizes;
+    out_sizes.push_back(B);
+    for (int i = 2; i < x1_contig.dim(); ++i) {
+        out_sizes.push_back(x1_contig.size(i));
+    }
+    auto output = torch::empty(out_sizes, x1_contig.options());
+
+    long long stride_b = static_cast<long long>(C) * HW;
+    long long stride_c = HW;
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    cosine_similarity_forward_launcher(
+        x1_contig.data_ptr<float>(),
+        x2_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        B, C, HW,
+        stride_b, stride_c,
+        stride_b, stride_c,
+        static_cast<long long>(B) * HW,
+        stream
+    );
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "cosine_similarity_forward kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("sigmoid_forward", &sigmoid_forward,
+          "Sigmoid forward (CUDA)",
+          pybind11::arg("x"));
+    m.def("cosine_similarity_forward", &cosine_similarity_forward,
+          "Cosine similarity forward (CUDA)",
+          pybind11::arg("x1"), pybind11::arg("x2"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,34 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+        # No trainable parameters, same as reference
+
+    def forward(self, x: torch.Tensor, y: torch.Tensor) -> torch.Tensor:
+        x = cuda_extension.sigmoid_forward(x)
+        x = cuda_extension.cosine_similarity_forward(x, y)
+        return x
+
+    def debug_forward(self, x: torch.Tensor, y: torch.Tensor):
+        x_sigmoid = cuda_extension.sigmoid_forward(x)
+        yield 'step_001', x_sigmoid
+        x_cos = cuda_extension.cosine_similarity_forward(x_sigmoid, y)
+        yield 'step_002', x_cos
+        yield 'step_003', x_cos
+
+
+batch_size = 512
+
+
+def get_inputs():
+    x = torch.randn(batch_size, 3, 256, 256)
+    y = torch.randn(batch_size, 3, 256, 256)
+    return [x, y]
+
+
+def get_init_inputs():
+    return []  # No parameters to initialize