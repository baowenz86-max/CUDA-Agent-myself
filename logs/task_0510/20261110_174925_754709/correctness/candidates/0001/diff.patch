--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,118 @@
+// CUDA kernels for average pooling and tanh
+#include <cuda_runtime.h>
+#include <math.h>
+
+// AvgPool2d kernel: count_include_pad=True (padding zeros included in average)
+// Input: NCHW float32, contiguous
+// Output: NCHW float32, same layout
+__global__ void avgpool2d_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int batch,
+    int channels,
+    int in_height,
+    int in_width,
+    int out_height,
+    int out_width,
+    int kernel_size,
+    int stride,
+    int padding)
+{
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = batch * channels * out_height * out_width;
+    int stride_grid = blockDim.x * gridDim.x;
+
+    for (int linear = idx; linear < total; linear += stride_grid) {
+        // Decompose linear index to (n, c, oh, ow)
+        int ow = linear % out_width;
+        int tmp = linear / out_width;
+        int oh = tmp % out_height;
+        tmp /= out_height;
+        int c = tmp % channels;
+        int n = tmp / channels;
+
+        // Compute input window start (including padding)
+        int h_start = oh * stride - padding;
+        int w_start = ow * stride - padding;
+
+        float sum = 0.0f;
+        int count = 0;
+
+        for (int kh = 0; kh < kernel_size; ++kh) {
+            int ih = h_start + kh;
+            if (ih < 0 || ih >= in_height) {
+                // padding zero contributes 0 to sum, but count_include_pad=True counts it
+                count++;
+                continue;
+            }
+            for (int kw = 0; kw < kernel_size; ++kw) {
+                int iw = w_start + kw;
+                if (iw < 0 || iw >= in_width) {
+                    count++;
+                    continue;
+                }
+                int input_idx = ((n * channels + c) * in_height + ih) * in_width + iw;
+                sum += input[input_idx];
+                count++;
+            }
+        }
+
+        // Average including padding
+        output[linear] = sum / static_cast<float>(count);
+    }
+}
+
+// Tanh elementwise kernel
+__global__ void tanh_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int total)
+{
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride_grid = blockDim.x * gridDim.x;
+
+    for (int i = idx; i < total; i += stride_grid) {
+        output[i] = tanhf(input[i]);
+    }
+}
+
+// Launcher for avgpool2d_forward
+extern "C" void avgpool2d_forward_launcher(
+    const float* input,
+    float* output,
+    int batch,
+    int channels,
+    int in_height,
+    int in_width,
+    int kernel_size,
+    int stride,
+    int padding,
+    cudaStream_t stream)
+{
+    int out_height = (in_height + 2 * padding - kernel_size) / stride + 1;
+    int out_width = (in_width + 2 * padding - kernel_size) / stride + 1;
+    int total = batch * channels * out_height * out_width;
+
+    // Launch configuration: use enough blocks to cover all elements, with grid-stride loop
+    int block_size = 256;
+    int grid_size = (total + block_size - 1) / block_size;
+    // Cap grid size to avoid excessive blocks (limit to 65535 for older GPUs)
+    if (grid_size > 65535) grid_size = 65535;
+
+    avgpool2d_kernel<<<grid_size, block_size, 0, stream>>>(
+        input, output, batch, channels, in_height, in_width, out_height, out_width,
+        kernel_size, stride, padding);
+}
+
+// Launcher for tanh_forward
+extern "C" void tanh_forward_launcher(
+    const float* input,
+    float* output,
+    int total,
+    cudaStream_t stream)
+{
+    int block_size = 256;
+    int grid_size = (total + block_size - 1) / block_size;
+    if (grid_size > 65535) grid_size = 65535;
+    tanh_kernel<<<grid_size, block_size, 0, stream>>>(input, output, total);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,97 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void avgpool2d_forward_launcher(
+    const float* input,
+    float* output,
+    int batch,
+    int channels,
+    int in_height,
+    int in_width,
+    int kernel_size,
+    int stride,
+    int padding,
+    cudaStream_t stream
+);
+
+extern "C" void tanh_forward_launcher(
+    const float* input,
+    float* output,
+    int total,
+    cudaStream_t stream
+);
+
+// Average pooling forward binding
+torch::Tensor avgpool2d_forward(torch::Tensor input, int64_t kernel_size, int64_t stride, int64_t padding) {
+    // Input validation
+    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(input.dim() == 4, "Input must be 4D (NCHW)");
+
+    int batch = input.size(0);
+    int channels = input.size(1);
+    int in_height = input.size(2);
+    int in_width = input.size(3);
+
+    int out_height = (in_height + 2 * static_cast<int>(padding) - static_cast<int>(kernel_size)) / static_cast<int>(stride) + 1;
+    int out_width = (in_width + 2 * static_cast<int>(padding) - static_cast<int>(kernel_size)) / static_cast<int>(stride) + 1;
+
+    auto output = torch::empty({batch, channels, out_height, out_width}, input.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    avgpool2d_forward_launcher(
+        input.data_ptr<float>(),
+        output.data_ptr<float>(),
+        batch,
+        channels,
+        in_height,
+        in_width,
+        static_cast<int>(kernel_size),
+        static_cast<int>(stride),
+        static_cast<int>(padding),
+        stream
+    );
+
+    return output;
+}
+
+// Tanh forward binding
+torch::Tensor tanh_forward(torch::Tensor input) {
+    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
+
+    auto output = torch::empty_like(input);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    tanh_forward_launcher(
+        input.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int>(input.numel()),
+        stream
+    );
+
+    return output;
+}
+
+// Registration
+void register_custom_ops(pybind11::module& m) {
+    m.def("avgpool2d_forward", &avgpool2d_forward,
+          "Average pooling 2D forward",
+          py::arg("input"),
+          py::arg("kernel_size"),
+          py::arg("stride"),
+          py::arg("padding"));
+    m.def("tanh_forward", &tanh_forward,
+          "Tanh activation forward",
+          py::arg("input"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,23 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, out_channels, kernel_size, stride, padding):
+        super().__init__()
+        self.kernel_size = kernel_size
+        self.stride = stride
+        self.padding = padding
+
+    def forward(self, x):
+        x = cuda_extension.avgpool2d_forward(x, self.kernel_size, self.stride, self.padding)
+        x = cuda_extension.tanh_forward(x)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.avgpool2d_forward(x, self.kernel_size, self.stride, self.padding)
+        yield "step_001", x
+        x = cuda_extension.tanh_forward(x)
+        yield "step_002", x
+        yield "step_003", x
