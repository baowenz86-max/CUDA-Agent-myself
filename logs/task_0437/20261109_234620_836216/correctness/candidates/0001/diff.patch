--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,60 @@
+#include <cuda_runtime.h>
+
+// relu_add_div6: y = max(x + 3, 0) / 6
+__global__ void relu_add_div6_kernel(const float* __restrict__ input,
+                                     float* __restrict__ output,
+                                     int64_t numel) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        float val = input[i] + 3.0f;
+        val = val > 0.0f ? val : 0.0f;
+        output[i] = val * (1.0f / 6.0f);
+    }
+}
+
+// hardswish: y = x * min(max(x + 3, 0), 6) / 6
+__global__ void hardswish_kernel(const float* __restrict__ input,
+                                 float* __restrict__ output,
+                                 int64_t numel) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        float val = input[i] + 3.0f;
+        val = val > 0.0f ? val : 0.0f;
+        val = val < 6.0f ? val : 6.0f;
+        output[i] = input[i] * val * (1.0f / 6.0f);
+    }
+}
+
+extern "C" void relu_add_div6_launcher(float* output,
+                                        const float* input,
+                                        int64_t numel,
+                                        cudaStream_t stream) {
+    const int block_size = 256;
+    int64_t grid_size = (numel + block_size - 1) / block_size;
+    if (grid_size > 65535) {
+        grid_size = 65535;
+    }
+    relu_add_div6_kernel<<<grid_size, block_size, 0, stream>>>(input, output, numel);
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // Error will be checked by binding after launch; we could print but avoid dependencies.
+    }
+}
+
+extern "C" void hardswish_launcher(float* output,
+                                    const float* input,
+                                    int64_t numel,
+                                    cudaStream_t stream) {
+    const int block_size = 256;
+    int64_t grid_size = (numel + block_size - 1) / block_size;
+    if (grid_size > 65535) {
+        grid_size = 65535;
+    }
+    hardswish_kernel<<<grid_size, block_size, 0, stream>>>(input, output, numel);
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // Error will be checked by binding after launch; we could print but avoid dependencies.
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,76 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// External launcher declarations from custom_ops.cu
+extern "C" void relu_add_div6_launcher(float* output,
+                                        const float* input,
+                                        int64_t numel,
+                                        cudaStream_t stream);
+
+extern "C" void hardswish_launcher(float* output,
+                                    const float* input,
+                                    int64_t numel,
+                                    cudaStream_t stream);
+
+namespace {
+
+torch::Tensor relu_add_div6(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "relu_add_div6: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "relu_add_div6: input must be float32");
+    TORCH_CHECK(x.defined(), "relu_add_div6: input tensor is undefined");
+
+    // The kernel handles arbitrary strides via raw pointer and linear index, so no contiguity check is needed.
+    auto output = torch::empty_like(x);
+    int64_t numel = x.numel();
+    if (numel == 0) {
+        return output;
+    }
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    relu_add_div6_launcher(output.data_ptr<float>(),
+                           x.data_ptr<float>(),
+                           numel,
+                           stream);
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "relu_add_div6: CUDA error: ", cudaGetErrorString(err));
+    return output;
+}
+
+torch::Tensor hardswish(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "hardswish: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "hardswish: input must be float32");
+    TORCH_CHECK(x.defined(), "hardswish: input tensor is undefined");
+
+    auto output = torch::empty_like(x);
+    int64_t numel = x.numel();
+    if (numel == 0) {
+        return output;
+    }
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    hardswish_launcher(output.data_ptr<float>(),
+                       x.data_ptr<float>(),
+                       numel,
+                       stream);
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "hardswish: CUDA error: ", cudaGetErrorString(err));
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("relu_add_div6", &relu_add_div6,
+          "relu_add_div6(x) -> Tensor\n"
+          "Equivalent to F.relu(x + 3) / 6.",
+          py::arg("x"));
+    m.def("hardswish", &hardswish,
+          "hardswish(x) -> Tensor\n"
+          "Hardswish activation: x * relu6(x + 3) / 6.",
+          py::arg("x"));
+}
+
+} // anonymous namespace
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,21 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.hardswish = nn.Hardswish()
+
+    def forward(self, x):
+        x = cuda_extension.relu_add_div6(x)
+        x = cuda_extension.hardswish(x)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.relu_add_div6(x)
+        yield 'step_001', x
+        x = cuda_extension.hardswish(x)
+        yield 'step_002', x
+        yield 'step_003', x
