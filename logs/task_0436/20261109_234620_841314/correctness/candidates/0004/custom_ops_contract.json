        "这是纯数据重排，不改变数值。返回 tensor 的 stride 与参考一致（[B*C*H*W*D, H*W*D, W*D, D, 1]对应的紧凑连续布局）。"
      ]
    },
    {
      "name": "bn3d_eval_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, embedding_dim, height, width, depth]",
