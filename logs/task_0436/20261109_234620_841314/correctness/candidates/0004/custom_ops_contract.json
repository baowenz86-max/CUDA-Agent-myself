      ]
    },
    {
      "checkpoint": "step_004",
      "source": "x = x.permute(0, 2, 3, 4, 1)",
      "semantics": [
        "置换维度顺序，恢复为 [B, H, W, D, C]。"
      ]
    },
    {
      "checkpoint": "step_005",
