        "device": "cuda",
        "shape": "[batch_size, height, width, depth, embedding_dim]"
      },
      "semantics": [
        "对应参考语句 x = self.embedding(x)，输入 int64 索引，输出 float32 embedding 向量。",
        "使用 nn.Embedding 在 eval 模式下的行为：对于每个索引，取 weight[index]，无 padding_idx。",
        "输入必须在 CUDA 上，weight 也移动到 CUDA，返回张量 layout 连续。"
      ]
    },
    {
      "name": "permute_4d_to_bn3d",
      "parameters": [
        {
          "name": "input",
