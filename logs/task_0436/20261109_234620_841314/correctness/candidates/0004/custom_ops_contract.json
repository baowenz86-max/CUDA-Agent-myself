      "semantics": [
        "对应参考语句 x = x.permute(0, 2, 3, 4, 1)，将维度顺序从 [B, C, H, W, D] 转换为 [B, H, W, D, C]。",
        "这是纯数据重排，不改变数值。返回 tensor 的 stride 与参考一致（紧凑连续布局）。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.embedding(x)",
      "semantics": [
        "输入 x 是 int64 索引张量，调用 nn.Embedding 得到 float32 输出，形状由 [B, H, W, D] 变为 [B, H, W, D, C]。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = x.permute(0, 4, 1, 2, 3)",
      "semantics": [
        "置换维度顺序，不改变数据，形状变为 [B, C, H, W, D]。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = self.bn(x)",
      "semantics": [
