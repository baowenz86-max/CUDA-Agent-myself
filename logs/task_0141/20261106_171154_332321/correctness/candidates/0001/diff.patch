@@ -0,0 +1,219 @@
+#include <cuda_runtime.h>
+
+// ============================================================================
+// Leaky ReLU kernel
+// ============================================================================
+// Computes y = x >= 0 ? x : negative_slope * x for each element.
+// Input can be non-contiguous; kernel uses strides to compute linear index.
+// Output tensor is assumed to have same strides as input (or contiguous, but
+// we write using output strides as well). For simplicity, we require both
+// input and output to have the same strides, which is guaranteed by the
+// binding layer if it creates output with same shape and strides as input.
+// However, to be safe we pass both input and output pointers and their
+// respective strides. Launcher assumes output was allocated with same strides
+// as input.
+// Kernel signature: template<int BLOCK_SIZE> __global__ void leaky_relu_kernel(
+//   float* out, const float* in, int numel, int ndim,
+//   const long long* in_strides, const long long* out_strides, float negative_slope)
+// We'll use grid-stride loop for large sizes.
+
+template<int BLOCK_SIZE>
+__global__ void leaky_relu_kernel(
+    float* __restrict__ out,
+    const float* __restrict__ in,
+    long long numel,
+    int ndim,
+    const long long* __restrict__ in_strides,
+    const long long* __restrict__ out_strides,
+    float negative_slope)
+{
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (; idx < numel; idx += stride) {
+        // Convert linear index to multi-dimensional index using in_strides
+        long long rem = idx;
+        long long in_offset = 0;
+        long long out_offset = 0;
+        #pragma unroll
+        for (int d = 0; d < ndim; ++d) {
+            long long coord = rem % out_strides[d] ? rem % out_strides[d] : 0; // not correct; better compute coordinate from shape
+        }
+        // Instead of computing coordinate from strides directly, we need shape.
+        // Since we only have strides, we cannot recover shape for arbitrary dims.
+        // Therefore, we require the binding layer to pass the shape as well.
+        // For now, we will assume that the input and output are contiguous or
+        // have the same shape and we can compute coordinate using the output shape
+        // that will be passed separately. Since contract says "layout: supports strides",
+        // we need to handle non-contiguous. So we must include shape parameter.
+        // We'll adjust launcher to pass shape array.
+        // For this implementation, we'll keep a simpler version that assumes
+        // contiguous tensors, as the binding layer can make tensors contiguous if
+        // needed. But contract explicitly says supports strides, so we should
+        // support non-contiguous. We'll add shape array.
+        // We'll skip the fully generic non-contiguous implementation for now,
+        // but provide a working contiguous path plus a note to binding layer
+        // to ensure contiguous? The instructions say "Tensor 检查、分配、当前 stream 获取与 pybind 注册统一放在 kernels/*_binding.cpp",
+        // and that .cu should only contain kernels and launchers. It doesn't
+        // forbid the binding layer from making tensors contiguous, but contract
+        // says layout supports strides, implying we should support non-contiguous
+        // without copying. We'll attempt full stride support.
+        // For stride support, we need shape. We'll pass shape along.
+        out[idx] = (in[idx] >= 0.0f) ? in[idx] : negative_slope * in[idx];
+    }
+}
+
+// Actually, the above comment and code are messy. Let's rewrite properly.
+// We'll implement two versions: one for contiguous (fast), one for general strides.
+// But to keep it simple and correct, we'll use a single kernel that takes shape
+// and strides, computes offset via manual loop.
+
+__global__ void leaky_relu_generic_kernel(
+    float* __restrict__ out,
+    const float* __restrict__ in,
+    long long numel,
+    int ndim,
+    const long long* __restrict__ shape,
+    const long long* __restrict__ in_strides,
+    const long long* __restrict__ out_strides,
+    float negative_slope)
+{
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (; idx < numel; idx += stride) {
+        long long rem = idx;
+        long long in_offset = 0;
+        long long out_offset = 0;
+        for (int d = ndim - 1; d >= 0; --d) {
+            long long coord = rem % shape[d];
+            rem /= shape[d];
+            in_offset += coord * in_strides[d];
+            out_offset += coord * out_strides[d];
+        }
+        float val = in[in_offset];
+        out[out_offset] = (val >= 0.0f) ? val : negative_slope * val;
+    }
+}
+
+// ============================================================================
+// MaxPool2d kernel (kernel_size=2, stride=2, no padding, dilation=1)
+// ============================================================================
+// Contract: input shape [N, C, H, W], output shape [N, C, H/2, W/2]
+// with kernel_size=2, stride=2. We'll support arbitrary H, W, but kernel_size
+// and stride fixed to 2? Since parameters are optional and default to 2, we
+// can assume kernel_size=2, stride=2 for this task. We'll hardcode for
+// performance, but launcher will check and only call for 2x2/2.
+// Input can be non-contiguous. We'll use a generic kernel with strides.
+// We'll compute output coordinate (n,c,oh,ow) and then input start (n,c,oh*2,ow*2)
+// and take max of 4 elements.
+
+__global__ void max_pool2d_2x2_stride2_kernel(
+    float* __restrict__ out,
+    const float* __restrict__ in,
+    int N, int C, int H, int W,
+    int outH, int outW,
+    const long long* __restrict__ in_strides, // length 4: [N,C,H,W]
+    const long long* __restrict__ out_strides)
+{
+    // Use linear index over output elements: index = n*C*outH*outW + c*outH*outW + oh*outW + ow
+    long long total_out = (long long)N * C * outH * outW;
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (; idx < total_out; idx += stride) {
+        int ow = idx % outW;
+        long long tmp = idx / outW;
+        int oh = tmp % outH;
+        tmp /= outH;
+        int c = tmp % C;
+        int n = tmp / C;
+
+        int ih = oh * 2;
+        int iw = ow * 2;
+
+        // Compute base offset for (n,c,ih,iw)
+        long long in_base = (long long)n * in_strides[0] + (long long)c * in_strides[1]
+                         + (long long)ih * in_strides[2] + (long long)iw * in_strides[3];
+
+        float v0 = in[in_base];
+        float v1 = in[in_base + in_strides[3]]; // iw+1
+        float v2 = in[in_base + in_strides[2]]; // ih+1, iw
+        float v3 = in[in_base + in_strides[2] + in_strides[3]]; // ih+1, iw+1
+
+        float max_val = v0;
+        if (v1 > max_val) max_val = v1;
+        if (v2 > max_val) max_val = v2;
+        if (v3 > max_val) max_val = v3;
+
+        long long out_offset = (long long)n * out_strides[0] + (long long)c * out_strides[1]
+                            + (long long)oh * out_strides[2] + (long long)ow * out_strides[3];
+        out[out_offset] = max_val;
+    }
+}
+
+// ============================================================================
+// Launcher functions (extern "C" for binding layer)
+// ============================================================================
+
+extern "C" void leaky_relu_launcher(
+    float* out,
+    const float* in,
+    long long numel,
+    int ndim,
+    const long long* shape,
+    const long long* in_strides,
+    const long long* out_strides,
+    float negative_slope,
+    cudaStream_t stream)
+{
+    // Configure kernel launch
+    const int block_size = 256;
+    long long blocks = (numel + block_size - 1) / block_size;
+    if (blocks > 0) {
+        leaky_relu_generic_kernel<<<(unsigned int)blocks, block_size, 0, stream>>>(
+            out, in, numel, ndim, shape, in_strides, out_strides, negative_slope);
+    }
+}
+
+extern "C" void max_pool2d_2x2_stride2_launcher(
+    float* out,
+    const float* in,
+    int N, int C, int H, int W,
+    int outH, int outW,
+    const long long* in_strides,
+    const long long* out_strides,
+    cudaStream_t stream)
+{
+    long long total_out = (long long)N * C * outH * outW;
+    const int block_size = 256;
+    long long blocks = (total_out + block_size - 1) / block_size;
+    if (blocks > 0) {
+        max_pool2d_2x2_stride2_kernel<<<(unsigned int)blocks, block_size, 0, stream>>>(
+            out, in, N, C, H, W, outH, outW, in_strides, out_strides);
+    }
+}
+
+// ============================================================================
+// Conv2d placeholder: actual cuDNN implementation will be added in phase 3.
+// We declare a launcher that will be defined elsewhere, but since this file
+// must compile, we provide a stub that does nothing (not used).
+// However, the binding layer may call conv2d_launcher, so we need to provide a
+// definition. The instruction says Conv must use cuDNN by third stage, but
+// we can stub it here. We'll define a dummy that just returns, assuming
+// binding layer will not be compiled until phase 3 includes the real one.
+// But to be safe, we provide an empty function.
+
+extern "C" void conv2d_launcher(
+    float* /*out*/,
+    const float* /*input*/,
+    const float* /*weight*/,
+    const float* /*bias*/,
+    int /*N*/, int /*C*/, int /*H*/, int /*W*/,
+    int /*K*/, int /*R*/, int /*S*/,
+    int /*stride_h*/, int /*stride_w*/,
+    int /*pad_h*/, int /*pad_w*/,
+    int /*dilation_h*/, int /*dilation_w*/,
+    int /*use_bias*/,
+    cudaStream_t /*stream*/)
+{
+    // Placeholder: to be replaced with cuDNN call in phase 3.
+    // This function should not be called until then.
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,311 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_runtime.h>
+#include <cudnn.h>
+#include <vector>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void leaky_relu_launcher(
+    float* out,
+    const float* in,
+    long long numel,
+    int ndim,
+    const long long* shape,
+    const long long* in_strides,
+    const long long* out_strides,
+    float negative_slope,
+    cudaStream_t stream);
+
+extern "C" void max_pool2d_2x2_stride2_launcher(
+    float* out,
+    const float* in,
+    int N, int C, int H, int W,
+    int outH, int outW,
+    const long long* in_strides,
+    const long long* out_strides,
+    cudaStream_t stream);
+
+// Helper to convert torch::Tensor to vector of int64_t for shape/strides
+static std::vector<long long> get_strides(const torch::Tensor& t) {
+    std::vector<long long> strides(t.dim());
+    for (int i = 0; i < t.dim(); ++i) {
+        strides[i] = t.stride(i);
+    }
+    return strides;
+}
+
+static std::vector<long long> get_shape(const torch::Tensor& t) {
+    std::vector<long long> shape(t.dim());
+    for (int i = 0; i < t.dim(); ++i) {
+        shape[i] = t.size(i);
+    }
+    return shape;
+}
+
+// Leaky ReLU wrapper
+torch::Tensor leaky_relu_forward(torch::Tensor x, double negative_slope = 0.01) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.numel() > 0, "Input tensor must not be empty");
+
+    // Create output with same sizes and strides as input
+    auto out = torch::empty_strided(x.sizes(), x.strides(), x.options());
+
+    std::vector<long long> shape = get_shape(x);
+    std::vector<long long> in_strides = get_strides(x);
+    std::vector<long long> out_strides = get_strides(out);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    leaky_relu_launcher(
+        out.data_ptr<float>(),
+        x.data_ptr<float>(),
+        x.numel(),
+        x.dim(),
+        shape.data(),
+        in_strides.data(),
+        out_strides.data(),
+        static_cast<float>(negative_slope),
+        stream
+    );
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA error after leaky_relu_launcher: ", cudaGetErrorString(err));
+
+    return out;
+}
+
+// MaxPool2d wrapper (fixed kernel_size=2, stride=2, padding=0, dilation=1)
+torch::Tensor max_pool2d_forward(torch::Tensor x, int64_t kernel_size = 2, int64_t stride = 2) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D (N, C, H, W)");
+    TORCH_CHECK(kernel_size == 2 && stride == 2, "Only kernel_size=2, stride=2 supported");
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+    int outH = (H - kernel_size) / stride + 1;
+    int outW = (W - kernel_size) / stride + 1;
+
+    // Output is contiguous with standard layout [N, C, outH, outW]
+    auto out = torch::empty({N, C, outH, outW}, x.options());
+
+    std::vector<long long> in_strides = get_strides(x);
+    std::vector<long long> out_strides = get_strides(out);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    max_pool2d_2x2_stride2_launcher(
+        out.data_ptr<float>(),
+        x.data_ptr<float>(),
+        N, C, H, W,
+        outH, outW,
+        in_strides.data(),
+        out_strides.data(),
+        stream
+    );
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA error after max_pool2d_2x2_stride2_launcher: ", cudaGetErrorString(err));
+
+    return out;
+}
+
+// Conv2d wrapper using cuDNN
+torch::Tensor conv2d_forward(
+    torch::Tensor x,
+    torch::Tensor weight,
+    torch::Tensor bias,
+    int64_t stride = 1,
+    int64_t dilation = 1)
+{
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(weight.is_cuda(), "Weight must be a CUDA tensor");
+    if (bias.defined()) {
+        TORCH_CHECK(bias.is_cuda(), "Bias must be a CUDA tensor if defined");
+    }
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(weight.dtype() == torch::kFloat32, "Weight must be float32");
+    if (bias.defined()) {
+        TORCH_CHECK(bias.dtype() == torch::kFloat32, "Bias must be float32");
+    }
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D (N, C, H, W)");
+    TORCH_CHECK(weight.dim() == 4, "Weight must be 4D (K, C, R, S)");
+    TORCH_CHECK(weight.size(1) == x.size(1), "Input channels must match weight");
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+    int K = weight.size(0);
+    int R = weight.size(2);
+    int S = weight.size(3);
+
+    int pad_h = 0;
+    int pad_w = 0;
+    int stride_h = static_cast<int>(stride);
+    int stride_w = static_cast<int>(stride);
+    int dilation_h = static_cast<int>(dilation);
+    int dilation_w = static_cast<int>(dilation);
+
+    int outH = (H + 2 * pad_h - dilation_h * (R - 1) - 1) / stride_h + 1;
+    int outW = (W + 2 * pad_w - dilation_w * (S - 1) - 1) / stride_w + 1;
+
+    auto out = torch::empty({N, K, outH, outW}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // cuDNN handle (per-thread or global? create once maybe better, but for simplicity create per call)
+    cudnnHandle_t cudnn_handle;
+    cudnnStatus_t status = cudnnCreate(&cudnn_handle);
+    TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cudnnCreate failed");
+    cudnnSetStream(cudnn_handle, stream);
+
+    cudnnTensorDescriptor_t x_desc, y_desc, b_desc;
+    cudnnFilterDescriptor_t w_desc;
+    cudnnConvolutionDescriptor_t conv_desc;
+
+    status = cudnnCreateTensorDescriptor(&x_desc);
+    TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cudnnCreateTensorDescriptor failed");
+    status = cudnnCreateTensorDescriptor(&y_desc);
+    TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cudnnCreateTensorDescriptor failed");
+    status = cudnnCreateTensorDescriptor(&b_desc);
+    TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cudnnCreateTensorDescriptor failed");
+    status = cudnnCreateFilterDescriptor(&w_desc);
+    TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cudnnCreateFilterDescriptor failed");
+    status = cudnnCreateConvolutionDescriptor(&conv_desc);
+    TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cudnnCreateConvolutionDescriptor failed");
+
+    // Set tensor descriptors (NCHW format)
+    status = cudnnSetTensor4dDescriptor(x_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT, N, C, H, W);
+    TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cudnnSetTensor4dDescriptor for x failed");
+    status = cudnnSetTensor4dDescriptor(y_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT, N, K, outH, outW);
+    TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cudnnSetTensor4dDescriptor for y failed");
+    status = cudnnSetTensor4dDescriptor(b_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT, 1, K, 1, 1);
+    TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cudnnSetTensor4dDescriptor for bias failed");
+
+    // Set filter descriptor (K, C, R, S)
+    status = cudnnSetFilter4dDescriptor(w_desc, CUDNN_DATA_FLOAT, CUDNN_TENSOR_NCHW, K, C, R, S);
+    TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cudnnSetFilter4dDescriptor failed");
+
+    // Set convolution descriptor
+    status = cudnnSetConvolution2dDescriptor(
+        conv_desc,
+        pad_h, pad_w,
+        stride_h, stride_w,
+        dilation_h, dilation_w,
+        CUDNN_CROSS_CORRELATION,  // PyTorch uses cross-correlation
+        CUDNN_DATA_FLOAT
+    );
+    TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cudnnSetConvolution2dDescriptor failed");
+
+    // Find algorithm (use a simple heuristic; for performance, maybe use cudnnFindConvolutionForwardAlgorithm)
+    cudnnConvolutionFwdAlgo_t algo = CUDNN_CONVOLUTION_FWD_ALGO_IMPLICIT_GEMM; // fallback
+    // Try to find best algorithm; but to avoid excessive cost, we can use a fixed algorithm or query.
+    // For small conv (3->16, 3x3) implicit GEMM is fine. We'll set to IMPLICIT_GEMM.
+
+    // Allocate workspace if needed (size query)
+    size_t workspace_size = 0;
+    status = cudnnGetConvolutionForwardWorkspaceSize(
+        cudnn_handle,
+        x_desc,
+        w_desc,
+        conv_desc,
+        y_desc,
+        algo,
+        &workspace_size
+    );
+    TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cudnnGetConvolutionForwardWorkspaceSize failed");
+
+    void* workspace = nullptr;
+    if (workspace_size > 0) {
+        cudaError_t cuda_err = cudaMalloc(&workspace, workspace_size);
+        TORCH_CHECK(cuda_err == cudaSuccess, "cudaMalloc workspace failed");
+    }
+
+    float alpha = 1.0f;
+    float beta = 0.0f;
+
+    if (bias.defined()) {
+        // Use cudnnConvolutionForward with bias (add bias after conv)
+        status = cudnnConvolutionForward(
+            cudnn_handle,
+            &alpha,
+            x_desc, x.data_ptr<float>(),
+            w_desc, weight.data_ptr<float>(),
+            conv_desc,
+            algo,
+            workspace, workspace_size,
+            &beta,
+            y_desc, out.data_ptr<float>()
+        );
+        TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cudnnConvolutionForward failed");
+
+        // Add bias using cudnnAddTensor
+        status = cudnnAddTensor(
+            cudnn_handle,
+            &alpha,
+            b_desc, bias.data_ptr<float>(),
+            &alpha,  // beta=1 to accumulate on out
+            y_desc, out.data_ptr<float>()
+        );
+        TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cudnnAddTensor failed");
+    } else {
+        status = cudnnConvolutionForward(
+            cudnn_handle,
+            &alpha,
+            x_desc, x.data_ptr<float>(),
+            w_desc, weight.data_ptr<float>(),
+            conv_desc,
+            algo,
+            workspace, workspace_size,
+            &beta,
+            y_desc, out.data_ptr<float>()
+        );
+        TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cudnnConvolutionForward failed");
+    }
+
+    if (workspace) {
+        cudaFree(workspace);
+    }
+
+    // Destroy descriptors and handle
+    cudnnDestroyTensorDescriptor(x_desc);
+    cudnnDestroyTensorDescriptor(y_desc);
+    cudnnDestroyTensorDescriptor(b_desc);
+    cudnnDestroyFilterDescriptor(w_desc);
+    cudnnDestroyConvolutionDescriptor(conv_desc);
+    cudnnDestroy(cudnn_handle);
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA error after conv2d_forward: ", cudaGetErrorString(err));
+
+    return out;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("leaky_relu_forward", &leaky_relu_forward,
+          "Leaky ReLU forward",
+          py::arg("x"),
+          py::arg("negative_slope") = 0.01);
+
+    m.def("max_pool2d_forward", &max_pool2d_forward,
+          "MaxPool2d forward (kernel=2, stride=2)",
+          py::arg("x"),
+          py::arg("kernel_size") = 2,
+          py::arg("stride") = 2);
+
+    m.def("conv2d_forward", &conv2d_forward,
+          "Conv2d forward (cuDNN)",
+          py::arg("x"),
+          py::arg("weight"),
+          py::arg("bias"),
+          py::arg("stride") = 1,
+          py::arg("dilation") = 1);
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,26 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, out_channels, kernel_size, stride, dilation, bias):
+        super().__init__()
+        self.conv2d = nn.Conv2d(in_channels, out_channels, kernel_size, stride=stride, dilation=dilation, bias=bias)
+
+    def forward(self, x):
+        x = x.to('cuda')
