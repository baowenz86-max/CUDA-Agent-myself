        )
        yield 'step_001', x
        x = cuda_extension.clamp_forward(x, 0.0, 1.0)
        yield 'step_002', x
        x = cuda_extension.leaky_relu_forward(x, 0.01)
        yield 'step_003', x
        x = cuda_extension.triu_forward(x, 0)
        yield 'step_004', x
        x = cuda_extension.add_forward(x, self.bias)
        yield 'step_005', x
        yield 'step_006', x


