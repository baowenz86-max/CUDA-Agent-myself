    "model_new.py": "import torch\nimport torch.nn as nn\nimport cuda_extension\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_channels, out_channels, kernel_size, stride, padding, output_padding, bias_shape):\n        super().__init__()\n        self.conv_transpose = nn.ConvTranspose2d(\n            in_channels, out_channels, kernel_size, stride=stride, padding=padding, output_padding=output_padding\n        )\n        self.bias = nn.Parameter(torch.randn(bias_shape))\n\n    def forward(self, x):\n        x = torch.ops.cuda_extension.conv_transpose2d_forward(\n            x,\n            self.conv_transpose.weight,\n            self.conv_transpose.bias,\n            self.conv_transpose.stride[0],\n            self.conv_transpose.padding[0],\n            self.conv_transpose.output_padding[0],\n        )\n        x = torch.ops.cuda_extension.clamp_forward(x, 0.0, 1.0)\n        x = torch.ops.cuda_extension.leaky_relu_forward(x, 0.01)\n        x = torch.ops.cuda_extension.triu_forward(x, 0)\n        x = torch.ops.cuda_extension.add_forward(x, self.bias)\n        return x\n\n    def debug_forward(self, x):\n        x = torch.ops.cuda_extension.conv_transpose2d_forward(\n            x,\n            self.conv_transpose.weight,\n            self.conv_transpose.bias,\n            self.conv_transpose.stride[0],\n            self.conv_transpose.padding[0],\n            self.conv_transpose.output_padding[0],\n        )\n        yield 'step_001', x\n        x = torch.ops.cuda_extension.clamp_forward(x, 0.0, 1.0)\n        yield 'step_002', x\n        x = torch.ops.cuda_extension.leaky_relu_forward(x, 0.01)\n        yield 'step_003', x\n        x = torch.ops.cuda_extension.triu_forward(x, 0)\n        yield 'step_004', x\n        x = torch.ops.cuda_extension.add_forward(x, self.bias)\n        yield 'step_005', x\n        yield 'step_006', x\n",
    "kernels/custom_ops.cu": "#include <cuda_runtime.h>\n\n// Helper device functions\n__device__ __forceinline__ float clamp_scalar(float x, float lo, float hi) {\n    return fminf(fmaxf(x, lo), hi);\n}\n\n__device__ __forceinline__ float leaky_relu_scalar(float x, float slope) {\n    return (x >= 0.0f) ? x : slope * x;\n}\n\n// ===================== ConvTranspose2d =====================\n// Parameters fixed from model.py: kernel_size=3, stride=2, padding=1, output_padding=1\n// General kernel supports arbitrary parameters via launcher args.\n__global__ void conv_transpose2d_kernel(\n    const float* __restrict__ input,\n    const float* __restrict__ weight,\n    const float* __restrict__ bias,\n    float* __restrict__ output,\n    int N, int C_in, int H_in, int W_in,\n    int C_out, int H_out, int W_out,\n    int kernel_h, int kernel_w,\n    int stride_h, int stride_w,\n    int padding_h, int padding_w,\n    int output_padding_h, int output_padding_w\n) {\n    int total = N * C_out * H_out * W_out;\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int stride = blockDim.x * gridDim.x;\n    for (int i = idx; i < total; i += stride) {\n        int w = i % W_out;\n        int h = (i / W_out) % H_out;\n        int c_out = (i / (W_out * H_out)) % C_out;\n        int n = i / (W_out * H_out * C_out);\n\n        float acc = 0.0f;\n        for (int c_in = 0; c_in < C_in; ++c_in) {\n            for (int kh = 0; kh < kernel_h; ++kh) {\n                for (int kw = 0; kw < kernel_w; ++kw) {\n                    int h_in = h + padding_h - kh;\n                    int w_in = w + padding_w - kw;\n                    if (h_in % stride_h != 0 || w_in % stride_w != 0) continue;\n                    h_in /= stride_h;\n                    w_in /= stride_w;\n                    if (h_in >= 0 && h_in < H_in && w_in >= 0 && w_in < W_in) {\n                        // weight is stored as [C_in][C_out][kh][kw] for ConvTranspose2d\n                        int w_idx = ((c_in * C_out + c_out) * kernel_h + kh) * kernel_w + kw;\n                        int in_idx = ((n * C_in + c_in) * H_in + h_in) * W_in + w_in;\n                        acc += input[in_idx] * weight[w_idx];\n                    }\n                }\n            }\n        }\n        if (bias != nullptr) {\n            acc += bias[c_out];\n        }\n        output[i] = acc;\n    }\n}\n\nextern \"C\" void conv_transpose2d_forward_launcher(\n    const float* input,\n    const float* weight,\n    const float* bias,\n    float* output,\n    int N, int C_in, int H_in, int W_in,\n    int C_out, int H_out, int W_out,\n    int kernel_h, int kernel_w,\n    int stride_h, int stride_w,\n    int padding_h, int padding_w,\n    int output_padding_h, int output_padding_w,\n    cudaStream_t stream\n) {\n    int total = N * C_out * H_out * W_out;\n    const int threads = 256;\n    int blocks = (total + threads - 1) / threads;\n    // Cap grids to avoid exceeding max grid size, use grid-stride loop inside kernel\n    if (blocks > 65535) blocks = 65535;\n    conv_transpose2d_kernel<<<blocks, threads, 0, stream>>>(\n        input, weight, bias, output,\n        N, C_in, H_in, W_in,\n        C_out, H_out, W_out,\n        kernel_h, kernel_w,\n        stride_h, stride_w,\n        padding_h, padding_w,\n        output_padding_h, output_padding_w\n    );\n}\n\n// ===================== Clamp =====================\n__global__ void clamp_kernel(\n    const float* __restrict__ input,\n    float* __restrict__ output,\n    float min_val, float max_val,\n    int total\n) {\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int stride = blockDim.x * gridDim.x;\n    for (int i = idx; i < total; i += stride) {\n        output[i] = clamp_scalar(input[i], min_val, max_val);\n    }\n}\n\nextern \"C\" void clamp_forward_launcher(\n    const float* input,\n    float* output,\n    float min_val, float max_val,\n    int total,\n    cudaStream_t stream\n) {\n    const int threads = 256;\n    int blocks = (total + threads - 1) / threads;\n    if (blocks > 65535) blocks = 65535;\n    clamp_kernel<<<blocks, threads, 0, stream>>>(\n        input, output, min_val, max_val, total\n    );\n}\n\n// ===================== Leaky ReLU =====================\n__global__ void leaky_relu_kernel(\n    const float* __restrict__ input,\n    float* __restrict__ output,\n    float slope,\n    int total\n) {\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int stride = blockDim.x * gridDim.x;\n    for (int i = idx; i < total; i += stride) {\n        output[i] = leaky_relu_scalar(input[i], slope);\n    }\n}\n\nextern \"C\" void leaky_relu_forward_launcher(\n    const float* input,\n    float* output,\n    float slope,\n    int total,\n    cudaStream_t stream\n) {\n    const int threads = 256;\n    int blocks = (total + threads - 1) / threads;\n    if (blocks > 65535) blocks = 65535;\n    leaky_relu_kernel<<<blocks, threads, 0, stream>>>(\n        input, output, slope, total\n    );\n}\n\n// ===================== Triu =====================\n// triu with diagonal=0; zero elements below main diagonal in last two dims (H, W)\n__global__ void triu_kernel(\n    const float* __restrict__ input,\n    float* __restrict__ output,\n    int N, int C, int H, int W,\n    int diagonal\n) {\n    int total = N * C * H * W;\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int stride = blockDim.x * gridDim.x;\n    for (int i = idx; i < total; i += stride) {\n        int w = i % W;\n        int h = (i / W) % H;\n        // batch and channel indices not needed for decision\n        if (w - h < diagonal) {\n            output[i] = 0.0f;\n        } else {\n            output[i] = input[i];\n        }\n    }\n}\n\nextern \"C\" void triu_forward_launcher(\n    const float* input,\n    float* output,\n    int N, int C, int H, int W,\n    int diagonal,\n    cudaStream_t stream\n) {\n    int total = N * C * H * W;\n    const int threads = 256;\n    int blocks = (total + threads - 1) / threads;\n    if (blocks > 65535) blocks = 65535;\n    triu_kernel<<<blocks, threads, 0, stream>>>(\n        input, output, N, C, H, W, diagonal\n    );\n}\n\n// ===================== Add (bias shape [C,1,1]) =====================\n__global__ void add_bias_kernel(\n    const float* __restrict__ input,\n    const float* __restrict__ bias,\n    float* __restrict__ output,\n    int N, int C, int H, int W\n) {\n    int total = N * C * H * W;\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int stride = blockDim.x * gridDim.x;\n    for (int i = idx; i < total; i += stride) {\n        int w = i % W;\n        int h = (i / W) % H;\n        int c = (i / (W * H)) % C;\n        output[i] = input[i] + bias[c];\n    }\n}\n\nextern \"C\" void add_forward_launcher(\n    const float* input,\n    const float* bias,\n    float* output,\n    int N, int C, int H, int W,\n    cudaStream_t stream\n) {\n    int total = N * C * H * W;\n    const int threads = 256;\n    int blocks = (total + threads - 1) / threads;\n    if (blocks > 65535) blocks = 65535;\n    add_bias_kernel<<<blocks, threads, 0, stream>>>(\n        input, bias, output, N, C, H, W\n    );\n}\n",
    "kernels/custom_ops_binding.cpp": "#include <torch/types.h>\n#include <torch/library.h>\n#include <c10/cuda/CUDAStream.h>\n#include <cuda_runtime.h>\n#include <ATen/cuda/CUDAContext.h>\n#include \"../binding_registry.h\"\n\n// Declare launchers from custom_ops.cu\nextern \"C\" void conv_transpose2d_forward_launcher(\n    const float* input,\n    const float* weight,\n    const float* bias,\n    float* output,\n    int N, int C_in, int H_in, int W_in,\n    int C_out, int H_out, int W_out,\n    int kernel_h, int kernel_w,\n    int stride_h, int stride_w,\n    int padding_h, int padding_w,\n    int output_padding_h, int output_padding_w,\n    cudaStream_t stream\n);\n\nextern \"C\" void clamp_forward_launcher(\n    const float* input,\n    float* output,\n    float min_val, float max_val,\n    int total,\n    cudaStream_t stream\n);\n\nextern \"C\" void leaky_relu_forward_launcher(\n    const float* input,\n    float* output,\n    float slope,\n    int total,\n    cudaStream_t stream\n);\n\nextern \"C\" void triu_forward_launcher(\n    const float* input,\n    float* output,\n    int N, int C, int H, int W,\n    int diagonal,\n    cudaStream_t stream\n);\n\nextern \"C\" void add_forward_launcher(\n    const float* input,\n    const float* bias,\n    float* output,\n    int N, int C, int H, int W,\n    cudaStream_t stream\n);\n\n// Helper to get current CUDA stream as cudaStream_t\nstatic inline cudaStream_t get_stream() {\n    return c10::cuda::getCurrentCUDAStream().stream();\n}\n\n// Wrapper functions\nstatic torch::Tensor conv_transpose2d_forward(\n    torch::Tensor input,\n    torch::Tensor weight,\n    torch::Tensor bias,\n    int64_t stride_h,\n    int64_t padding_h,\n    int64_t output_padding_h\n) {\n    TORCH_CHECK(input.is_cuda(), \"input must be a CUDA tensor\");\n    TORCH_CHECK(weight.is_cuda(), \"weight must be a CUDA tensor\");\n    TORCH_CHECK(bias.is_cuda(), \"bias must be a CUDA tensor\");\n    TORCH_CHECK(input.is_contiguous(), \"input must be contiguous\");\n    TORCH_CHECK(weight.is_contiguous(), \"weight must be contiguous\");\n    TORCH_CHECK(bias.is_contiguous(), \"bias must be contiguous\");\n    TORCH_CHECK(input.dtype() == torch::kFloat32, \"input must be float32\");\n    TORCH_CHECK(weight.dtype() == torch::kFloat32, \"weight must be float32\");\n    TORCH_CHECK(bias.dtype() == torch::kFloat32, \"bias must be float32\");\n\n    TORCH_CHECK(input.dim() == 4, \"input must be 4D (N, C, H, W)\");\n    TORCH_CHECK(weight.dim() == 4, \"weight must be 4D (C_in, C_out, kH, kW)\");\n    TORCH_CHECK(bias.dim() == 1, \"bias must be 1D (C_out)\");\n\n    int N = input.size(0);\n    int C_in = input.size(1);\n    int H_in = input.size(2);\n    int W_in = input.size(3);\n    int C_out = weight.size(1);\n    int kernel_h = weight.size(2);\n    int kernel_w = weight.size(3);\n\n    // Assuming stride_w = stride_h, padding_w = padding_h, output_padding_w = output_padding_h\n    int stride_w = stride_h;\n    int padding_w = padding_h;\n    int output_padding_w = output_padding_h;\n\n    // Compute output spatial dimensions using PyTorch formula\n    int H_out = (H_in - 1) * stride_h - 2 * padding_h + kernel_h + output_padding_h;\n    int W_out = (W_in - 1) * stride_w - 2 * padding_w + kernel_w + output_padding_w;\n\n    TORCH_CHECK(bias.size(0) == C_out, \"bias size must match C_out\");\n\n    auto output = torch::empty({N, C_out, H_out, W_out}, input.options());\n\n    conv_transpose2d_forward_launcher(\n        input.data_ptr<float>(),\n        weight.data_ptr<float>(),\n        bias.data_ptr<float>(),\n        output.data_ptr<float>(),\n        N, C_in, H_in, W_in,\n        C_out, H_out, W_out,\n        kernel_h, kernel_w,\n        stride_h, stride_w,\n        padding_h, padding_w,\n        output_padding_h, output_padding_w,\n        get_stream()\n    );\n\n    return output;\n}\n\nstatic torch::Tensor clamp_forward(\n    torch::Tensor input,\n    double min_val,\n    double max_val\n) {\n    TORCH_CHECK(input.is_cuda(), \"input must be a CUDA tensor\");\n    TORCH_CHECK(input.is_contiguous(), \"input must be contiguous\");\n    TORCH_CHECK(input.dtype() == torch::kFloat32, \"input must be float32\");\n\n    auto output = torch::empty_like(input);\n    int total = input.numel();\n\n    clamp_forward_launcher(\n        input.data_ptr<float>(),\n        output.data_ptr<float>(),\n        static_cast<float>(min_val),\n        static_cast<float>(max_val),\n        total,\n        get_stream()\n    );\n\n    return output;\n}\n\nstatic torch::Tensor leaky_relu_forward(\n    torch::Tensor input,\n    double negative_slope\n) {\n    TORCH_CHECK(input.is_cuda(), \"input must be a CUDA tensor\");\n    TORCH_CHECK(input.is_contiguous(), \"input must be contiguous\");\n    TORCH_CHECK(input.dtype() == torch::kFloat32, \"input must be float32\");\n\n    auto output = torch::empty_like(input);\n    int total = input.numel();\n\n    leaky_relu_forward_launcher(\n        input.data_ptr<float>(),\n        output.data_ptr<float>(),\n        static_cast<float>(negative_slope),\n        total,\n        get_stream()\n    );\n\n    return output;\n}\n\nstatic torch::Tensor triu_forward(\n    torch::Tensor input,\n    int64_t diagonal\n) {\n    TORCH_CHECK(input.is_cuda(), \"input must be a CUDA tensor\");\n    TORCH_CHECK(input.is_contiguous(), \"input must be contiguous\");\n    TORCH_CHECK(input.dtype() == torch::kFloat32, \"input must be float32\");\n    TORCH_CHECK(input.dim() >= 2, \"input must have at least 2 dimensions\");\n\n    int N = 1;\n    int C = 1;\n    if (input.dim() == 4) {\n        N = input.size(0);\n        C = input.size(1);\n        int H = input.size(2);\n        int W = input.size(3);\n        auto output = torch::empty_like(input);\n        triu_forward_launcher(\n            input.data_ptr<float>(),\n            output.data_ptr<float>(),\n            N, C, H, W,\n            static_cast<int>(diagonal),\n            get_stream()\n        );\n        return output;\n    } else {\n        TORCH_CHECK(false, \"triu_forward currently supports only 4D tensors\");\n    }\n}\n\nstatic torch::Tensor add_forward(\n    torch::Tensor input,\n    torch::Tensor bias\n) {\n    TORCH_CHECK(input.is_cuda(), \"input must be a CUDA tensor\");\n    TORCH_CHECK(bias.is_cuda(), \"bias must be a CUDA tensor\");\n    TORCH_CHECK(input.is_contiguous(), \"input must be contiguous\");\n    TORCH_CHECK(bias.is_contiguous(), \"bias must be contiguous\");\n    TORCH_CHECK(input.dtype() == torch::kFloat32, \"input must be float32\");\n    TORCH_CHECK(bias.dtype() == torch::kFloat32, \"bias must be float32\");\n    TORCH_CHECK(input.dim() == 4, \"input must be 4D (N, C, H, W)\");\n    TORCH_CHECK(bias.dim() == 3, \"bias must be 3D (C, 1, 1)\");\n\n    int N = input.size(0);\n    int C = input.size(1);\n    int H = input.size(2);\n    int W = input.size(3);\n\n    TORCH_CHECK(bias.size(0) == C, \"bias size must match channels\");\n    TORCH_CHECK(bias.size(1) == 1 && bias.size(2) == 1, \"bias must have shape (C, 1, 1)\");\n\n    auto output = torch::empty_like(input);\n\n    add_forward_launcher(\n        input.data_ptr<float>(),\n        bias.data_ptr<float>(),\n        output.data_ptr<float>(),\n        N, C, H, W,\n        get_stream()\n    );\n\n    return output;\n}\n\n// Register with torch.ops.cuda_extension\nTORCH_LIBRARY(cuda_extension, m) {\n    m.def(\"conv_transpose2d_forward(Tensor input, Tensor weight, Tensor bias, int stride_h, int padding_h, int output_padding_h) -> Tensor\",\n          &conv_transpose2d_forward);\n    m.def(\"clamp_forward(Tensor input, float min_val, float max_val) -> Tensor\",\n          &clamp_forward);\n    m.def(\"leaky_relu_forward(Tensor input, float negative_slope) -> Tensor\",\n          &leaky_relu_forward);\n    m.def(\"triu_forward(Tensor input, int diagonal) -> Tensor\",\n          &triu_forward);\n    m.def(\"add_forward(Tensor input, Tensor bias) -> Tensor\",\n          &add_forward);\n}\n\n// Also register pybind functions for direct module access\nstatic void register_custom_ops(pybind11::module& m) {\n    m.def(\"conv_transpose2d_forward\", &conv_transpose2d_forward, \"ConvTranspose2d forward\");\n    m.def(\"clamp_forward\", &clamp_forward, \"Clamp forward\");\n    m.def(\"leaky_relu_forward\", &leaky_relu_forward, \"LeakyReLU forward\");\n    m.def(\"triu_forward\", &triu_forward, \"Triu forward\");\n    m.def(\"add_forward\", &add_forward, \"Add bias forward\");\n}\n\nREGISTER_BINDING(custom_ops, register_custom_ops);\n"
