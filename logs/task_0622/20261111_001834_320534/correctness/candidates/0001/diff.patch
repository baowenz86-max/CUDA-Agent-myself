--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,59 @@
+#include <cuda_runtime.h>
+#include <stdint.h>
+
+// Element-wise absolute value kernel for float32 input
+__global__ void abs_kernel(const float* __restrict__ input,
+                           float* __restrict__ output,
+                           int64_t numel) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        output[i] = fabsf(input[i]);
+    }
+}
+
+// Unsqueeze kernel: simply copies input to output assuming output is contiguous
+// and the new dimension size is 1 (so element order is unchanged)
+__global__ void unsqueeze_copy_kernel(const float* __restrict__ input,
+                                      float* __restrict__ output,
+                                      int64_t numel) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        output[i] = input[i];
+    }
+}
+
+// Launcher for abs_forward
+extern "C" void abs_forward_launcher(const float* input,
+                                     float* output,
+                                     int64_t numel,
+                                     cudaStream_t stream) {
+    int threads = 256;
+    int blocks = (int)((numel + threads - 1) / threads);
+    if (blocks > 65535) blocks = 65535; // grid limit for simple kernel; grid-stride handles rest
+    abs_kernel<<<blocks, threads, 0, stream>>>(input, output, numel);
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // Handle error in binding layer; here just ignore but could record
+    }
+}
+
+// Launcher for unsqueeze_forward
+extern "C" void unsqueeze_forward_launcher(const float* input,
+                                           float* output,
+                                           int64_t numel,
+                                           int64_t dim,
+                                           cudaStream_t stream) {
+    // dim is not used in kernel because the unsqueeze operation is just a view
+    // but we need to copy data. For dim between 0 and 3, output shape [512,1,1024,1024].
+    // Since output is contiguous, we can copy as flat array.
+    int threads = 256;
+    int blocks = (int)((numel + threads - 1) / threads);
+    if (blocks > 65535) blocks = 65535;
+    unsqueeze_copy_kernel<<<blocks, threads, 0, stream>>>(input, output, numel);
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // ignore for now
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,79 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void abs_forward_launcher(const float* input,
+                                     float* output,
+                                     int64_t numel,
+                                     cudaStream_t stream);
+
+extern "C" void unsqueeze_forward_launcher(const float* input,
+                                           float* output,
+                                           int64_t numel,
+                                           int64_t dim,
+                                           cudaStream_t stream);
+
+// PyTorch wrapper for abs
+torch::Tensor abs_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    abs_forward_launcher(x.data_ptr<float>(),
+                         output.data_ptr<float>(),
+                         x.numel(),
+                         stream);
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA kernel failed: ", cudaGetErrorString(err));
+    return output;
+}
+
+// PyTorch wrapper for unsqueeze
+torch::Tensor unsqueeze_forward(torch::Tensor x, int64_t dim) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+
+    int64_t input_dim = x.dim();
+    TORCH_CHECK(dim >= 0 && dim <= input_dim, "dim out of range");
+
+    // Compute output shape: insert 1 at dim
+    std::vector<int64_t> output_shape;
+    output_shape.reserve(input_dim + 1);
+    for (int64_t i = 0; i < input_dim; ++i) {
+        if (i == dim) output_shape.push_back(1);
+        output_shape.push_back(x.size(i));
+    }
+    if (dim == input_dim) output_shape.push_back(1);
+
+    auto output = torch::empty(output_shape, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    unsqueeze_forward_launcher(x.data_ptr<float>(),
+                               output.data_ptr<float>(),
+                               x.numel(),
+                               dim,
+                               stream);
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA kernel failed: ", cudaGetErrorString(err));
+    return output;
+}
+
+// Registration
+void register_custom_ops(pybind11::module& m) {
+    m.def("abs_forward", &abs_forward, "Element-wise absolute value",
+          py::arg("x"));
+    m.def("unsqueeze_forward", &unsqueeze_forward, "Unsqueeze operation",
+          py::arg("x"), py::arg("dim"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
