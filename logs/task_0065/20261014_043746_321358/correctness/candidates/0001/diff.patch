--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,64 @@
+#include <cuda_runtime.h>
+
+// channel_mean_forward: compute mean over dims 1,2,3 for each batch element.
+// Input: x float32 shape [N,C,H,W] contiguous; Output: mean float32 shape [N,1,1,1]
+__global__ void channel_mean_kernel(const float* __restrict__ x, float* __restrict__ mean, int N, int inner) {
+    int n = blockIdx.x;
+    float sum = 0.0f;
+    for (int idx = threadIdx.x; idx < inner; idx += blockDim.x) {
+        sum += x[(long long)n * inner + idx];
+    }
+    // block reduce
+    __shared__ float sdata[256];
+    int tid = threadIdx.x;
+    sdata[tid] = sum;
+    __syncthreads();
+
+    for (int s = blockDim.x / 2; s > 0; s >>= 1) {
+        if (tid < s) {
+            sdata[tid] += sdata[tid + s];
+        }
+        __syncthreads();
+    }
+
+    if (tid == 0) {
+        mean[n] = sdata[0] / (float)inner;
+    }
+}
+
+extern "C" void channel_mean_launcher(const float* x, float* mean, int N, int C, int H, int W, cudaStream_t stream) {
+    int inner = C * H * W;
+    int threads = 256;
+    dim3 grid(N);
+    channel_mean_kernel<<<grid, threads, 0, stream>>>(x, mean, N, inner);
+}
+
+// subtract_mean_forward: output = x - mean - scalar
+// Input: x [N,C,H,W], mean [N,1,1,1], scalar float
+__global__ void subtract_mean_kernel(const float* __restrict__ x, const float* __restrict__ mean, float subtract_value, float* __restrict__ out, long long total) {
+    long long idx = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+    for (; idx < total; idx += stride) {
+        int n = (int)(idx / (((long long)C) * H * W)); // wait C,H,W not captured; recalc or pass inner
+        // Pass inner as parameter instead for efficiency; but kernel defined with inner maybe better.
+        // Since inner = C*H*W, we can pass inner explicitly.
+    }
+}
+
+// Redefine subtract kernel with inner parameter to avoid code duplication
+__global__ void subtract_mean_kernel_v2(const float* __restrict__ x, const float* __restrict__ mean, float subtract_value, float* __restrict__ out, long long total, int inner) {
+    long long idx = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+    for (; idx < total; idx += stride) {
+        int n = (int)(idx / inner);
+        out[idx] = x[idx] - mean[n] - subtract_value;
+    }
+}
+
+extern "C" void subtract_mean_launcher(const float* x, const float* mean, float subtract_value, float* out, int N, int C, int H, int W, cudaStream_t stream) {
+    long long total = (long long)N * C * H * W;
+    int inner = C * H * W;
+    int threads = 256;
+    dim3 grid((total + threads - 1) / threads);
+    subtract_mean_kernel_v2<<<grid, threads, 0, stream>>>(x, mean, subtract_value, out, total, inner);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,78 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void channel_mean_launcher(const float* x, float* mean, int N, int C, int H, int W, cudaStream_t stream);
+extern "C" void subtract_mean_launcher(const float* x, const float* mean, float subtract_value, float* out, int N, int C, int H, int W, cudaStream_t stream);
+
+// Compute mean over dimensions 1,2,3 for each batch element, output shape [N,1,1,1]
+torch::Tensor channel_mean_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D (N,C,H,W)");
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+
+    auto mean = torch::empty({N, 1, 1, 1}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    channel_mean_launcher(
+        x.data_ptr<float>(),
+        mean.data_ptr<float>(),
+        N, C, H, W,
+        stream
+    );
+
+    return mean;
+}
+
+// output = x - mean - subtract_value, broadcasting mean over C,H,W
+torch::Tensor subtract_mean_forward(torch::Tensor x, torch::Tensor mean, double subtract_value) {
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(mean.is_cuda(), "mean must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
+    TORCH_CHECK(mean.is_contiguous(), "mean must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(mean.dtype() == torch::kFloat32, "mean must be float32");
+    TORCH_CHECK(x.dim() == 4, "x must be 4D (N,C,H,W)");
+    TORCH_CHECK(mean.dim() == 4, "mean must be 4D");
+    TORCH_CHECK(mean.size(0) == x.size(0), "mean batch size must match x");
+    TORCH_CHECK(mean.size(1) == 1 && mean.size(2) == 1 && mean.size(3) == 1, "mean shape must be [N,1,1,1]");
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+
+    auto out = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    subtract_mean_launcher(
+        x.data_ptr<float>(),
+        mean.data_ptr<float>(),
+        static_cast<float>(subtract_value),
+        out.data_ptr<float>(),
+        N, C, H, W,
+        stream
+    );
+
+    return out;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("channel_mean_forward", &channel_mean_forward,
+          "Compute mean over dims (1,2,3) keeping dims",
+          py::arg("x"));
+    m.def("subtract_mean_forward", &subtract_mean_forward,
+          "Subtract mean and scalar from input",
+          py::arg("x"), py::arg("mean"), py::arg("subtract_value"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,19 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super(ModelNew, self).__init__()
+        self.subtract_mean = nn.Parameter(torch.tensor(0.0))
+
+    def forward(self, x):
+        mean = cuda_extension.channel_mean_forward(x)
+        return cuda_extension.subtract_mean_forward(x, mean, self.subtract_mean.item())
+
+    def debug_forward(self, x):
+        mean = cuda_extension.channel_mean_forward(x)
+        yield "step_001", mean
+        out = cuda_extension.subtract_mean_forward(x, mean, self.subtract_mean.item())
+        yield "step_002", out
