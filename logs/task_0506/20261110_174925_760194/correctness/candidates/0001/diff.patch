--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,77 @@
+#include <cuda_runtime.h>
+
+// Elementwise ReLU: output = max(input, 0)
+__global__ void relu_forward_kernel(const float* __restrict__ input,
+                                   float* __restrict__ output,
+                                   int64_t total_elements) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < total_elements; i += stride) {
+        float val = input[i];
+        output[i] = val > 0.0f ? val : 0.0f;
+    }
+}
+
+// MaxPool1d along last dimension with non-overlapping windows
+// Input shape: [batch, channels, length], output shape: [batch, channels, out_length]
+// Each output element = max over window of size pool_size
+__global__ void max_pool1d_forward_kernel(const float* __restrict__ input,
+                                          float* __restrict__ output,
+                                          int64_t batch_size,
+                                          int64_t channels,
+                                          int64_t in_length,
+                                          int64_t out_length,
+                                          int64_t pool_size) {
+    int64_t total_outputs = batch_size * channels * out_length;
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t out_idx = idx; out_idx < total_outputs; out_idx += stride) {
+        // Decompose output linear index into (b, c, o)
+        int64_t o = out_idx % out_length;
+        int64_t bc = out_idx / out_length;
+        int64_t c = bc % channels;
+        int64_t b = bc / channels;
+
+        // Input start offset for this output position
+        int64_t in_start = ((b * channels + c) * in_length) + o * pool_size;
+        float max_val = -3.402823466e+38f; // -FLT_MAX
+        // Pool window may be partially empty if pool_size does not divide in_length,
+        // but contract says trailing elements are ignored, so we only consider full window.
+        // However, to be safe, loop over all pool_size (window should be fully within bounds
+        // when out_length = floor(in_length / pool_size) and o < out_length).
+        #pragma unroll 8
+        for (int64_t k = 0; k < pool_size; ++k) {
+            float val = input[in_start + k];
+            if (val > max_val) max_val = val;
+        }
+        output[out_idx] = max_val;
+    }
+}
+
+// Launcher for ReLU
+extern "C" void relu_forward_launcher(const float* input,
+                                     float* output,
+                                     int64_t total_elements,
+                                     cudaStream_t stream) {
+    int threads = 256;
+    int blocks = (int)((total_elements + threads - 1) / threads);
+    if (blocks > 65535) blocks = 65535; // grid limit for large tensors
+    relu_forward_kernel<<<blocks, threads, 0, stream>>>(input, output, total_elements);
+}
+
+// Launcher for MaxPool1d
+extern "C" void max_pool1d_forward_launcher(const float* input,
+                                            float* output,
+                                            int64_t batch_size,
+                                            int64_t channels,
+                                            int64_t in_length,
+                                            int64_t out_length,
+                                            int64_t pool_size,
+                                            cudaStream_t stream) {
+    int threads = 256;
+    int64_t total_outputs = batch_size * channels * out_length;
+    int blocks = (int)((total_outputs + threads - 1) / threads);
+    if (blocks > 65535) blocks = 65535;
+    max_pool1d_forward_kernel<<<blocks, threads, 0, stream>>>(
+        input, output, batch_size, channels, in_length, out_length, pool_size);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,85 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void relu_forward_launcher(
+    const float* input,
+    float* output,
+    int64_t total_elements,
+    cudaStream_t stream);
+
+extern "C" void max_pool1d_forward_launcher(
+    const float* input,
+    float* output,
+    int64_t batch_size,
+    int64_t channels,
+    int64_t in_length,
+    int64_t out_length,
+    int64_t pool_size,
+    cudaStream_t stream);
+
+// ReLU forward binding
+torch::Tensor relu_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "relu_forward: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "relu_forward: input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "relu_forward: input must be contiguous");
+
+    auto output = torch::empty_like(x);
+    int64_t total_elements = x.numel();
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    relu_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        total_elements,
+        stream);
+
+    return output;
+}
+
+// MaxPool1d forward binding
+torch::Tensor max_pool1d_forward(torch::Tensor x, int64_t pool_size) {
+    TORCH_CHECK(x.is_cuda(), "max_pool1d_forward: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "max_pool1d_forward: input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "max_pool1d_forward: input must be contiguous");
+    TORCH_CHECK(x.dim() == 3, "max_pool1d_forward: input must have 3 dimensions (batch, channels, length)");
+    TORCH_CHECK(pool_size > 0, "max_pool1d_forward: pool_size must be positive");
+
+    int64_t batch_size = x.size(0);
+    int64_t channels = x.size(1);
+    int64_t in_length = x.size(2);
+    int64_t out_length = in_length / pool_size;  // floor division, trailing elements ignored
+    TORCH_CHECK(out_length > 0, "max_pool1d_forward: output length must be positive");
+
+    auto output = torch::empty({batch_size, channels, out_length}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    max_pool1d_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        batch_size,
+        channels,
+        in_length,
+        out_length,
+        pool_size,
+        stream);
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("relu_forward", &relu_forward,
+          "Apply ReLU elementwise: output = max(input, 0)",
+          py::arg("x"));
+    m.def("max_pool1d_forward", &max_pool1d_forward,
+          "Apply MaxPool1d along last dimension with non-overlapping windows",
+          py::arg("x"),
+          py::arg("pool_size"));
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,22 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, pool_size):
+        super().__init__()
+        self.in_channels = in_channels
+        self.pool_size = pool_size
+
+    def forward(self, x):
+        x = cuda_extension.relu_forward(x)
+        x = cuda_extension.max_pool1d_forward(x, self.pool_size)
+        return x
+
+    def debug_forward(self, x):
+        relu_out = cuda_extension.relu_forward(x)
+        yield 'step_001', relu_out
+        max_pool_out = cuda_extension.max_pool1d_forward(relu_out, self.pool_size)
+        yield 'step_002', max_pool_out
+        yield 'step_003', max_pool_out
