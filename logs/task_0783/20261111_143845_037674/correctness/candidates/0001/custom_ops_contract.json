{
  "operators": [
    {
      "name": "custom_masked_fill",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as input",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "mask_value",
          "kind": "float",
          "default": 0.5,
          "optional": true,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "Performs torch.masked_fill(x, x < mask_value, 0): computes boolean mask x < mask_value, then sets elements where mask is True to 0",
        "The input and output tensors have identical shape, dtype, device, and stride",
        "The mask_value parameter must be the same scalar as reference self.mask_value"
      ]
    },
    {
      "name": "custom_cat",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as input",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "y",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as x",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "default": 1,
          "optional": true,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "concatenated shape along dim"
      },
      "semantics": [
        "Concatenates tensors x and y along dimension dim (dim=1)",
        "For the reference model, x and y are the same tensor, resulting in shape [B, 2*C, H, W]",
        "The output is a new tensor with contiguous memory; no alias to inputs"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = torch.masked_fill(x, x < self.mask_value, 0)",
      "semantics": [
        "Computes mask = x < mask_value, then sets x[mask] = 0",
        "Input shape [16,32,512,256], output same shape",
        "dtype float32, device cuda, stride unchanged"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.cat([x, x], dim=1)",
      "semantics": [
        "Concatenates x with itself along channel dim, doubling channels from 32 to 64",
        "Output shape [16,64,512,256], contiguous",
        "dtype float32, device cuda"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "Returns the concatenated tensor",
        "Shape [16,64,512,256], dtype float32, device cuda"
      ]
    }
  ]
