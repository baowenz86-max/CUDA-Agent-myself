--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,159 @@
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// Kernel: masked fill with threshold
+// output(i) = (input(i) < mask_value) ? 0 : input(i)
+// Element indexing based on flat contiguous output index, but need to map to input using strides.
+// We assume output has same strides as input for masked_fill (but output may be allocated as empty_like which preserves strides).
+// To support arbitrary strides, we compute 4D indices from flat index assuming a fixed shape, then use strides.
+// Since shape is 4D [B, C, H, W], we can compute indices using division/modulo.
+__global__ void masked_fill_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    int64_t total_elements,
+    float mask_value,
+    int64_t B, int64_t C, int64_t H, int64_t W,
+    int64_t stride_b, int64_t stride_c, int64_t stride_h, int64_t stride_w
+) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= total_elements) return;
+
+    // Compute multi-dimensional index from flat idx in row-major (B,C,H,W)
+    int64_t tmp = idx;
+    int64_t w = tmp % W;
+    tmp /= W;
+    int64_t h = tmp % H;
+    tmp /= H;
+    int64_t c = tmp % C;
+    tmp /= C;
+    int64_t b = tmp;
+
+    int64_t offset = b * stride_b + c * stride_c + h * stride_h + w * stride_w;
+    float val = input[offset];
+    output[offset] = (val < mask_value) ? 0.0f : val;
+}
+
+// Kernel: concatenate two tensors along dimension 1 (channels)
+// Output is contiguous with shape [B, C1+C2, H, W].
+// Inputs x and y may have their own strides, but output is contiguous.
+// We copy element from x into first C1 channels, y into next C2 channels.
+__global__ void cat_dim1_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ x,
+    const float* __restrict__ y,
+    int64_t total_output_elements,
+    int64_t B, int64_t C1, int64_t C2, int64_t H, int64_t W,
+    int64_t x_stride_b, int64_t x_stride_c, int64_t x_stride_h, int64_t x_stride_w,
+    int64_t y_stride_b, int64_t y_stride_c, int64_t y_stride_h, int64_t y_stride_w
+) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= total_output_elements) return;
+
+    // Output contiguous layout
+    int64_t tmp = idx;
+    int64_t w = tmp % W;
+    tmp /= W;
+    int64_t h = tmp % H;
+    tmp /= H;
+    int64_t c_out = tmp % (C1 + C2);
+    tmp /= (C1 + C2);
+    int64_t b = tmp;
+
+    int64_t output_offset = idx; // already contiguous flat index
+
+    if (c_out < C1) {
+        // from x
+        int64_t c = c_out;
+        int64_t input_offset = b * x_stride_b + c * x_stride_c + h * x_stride_h + w * x_stride_w;
+        output[output_offset] = x[input_offset];
+    } else {
+        // from y
+        int64_t c = c_out - C1;
+        int64_t input_offset = b * y_stride_b + c * y_stride_c + h * y_stride_h + w * y_stride_w;
+        output[output_offset] = y[input_offset];
+    }
+}
+
+// Host launcher for custom_masked_fill
+// Parameters:
+//   output: pointer to output float tensor (same shape/strides as input)
+//   input: pointer to input float tensor
+//   total_elements: number of elements
+//   mask_value: scalar threshold
+//   shapes and strides
+//   stream: cudaStream_t
+void launch_masked_fill(
+    float* output,
+    const float* input,
+    int64_t total_elements,
+    float mask_value,
+    int64_t B, int64_t C, int64_t H, int64_t W,
+    int64_t stride_b, int64_t stride_c, int64_t stride_h, int64_t stride_w,
+    cudaStream_t stream
+) {
+    const int block_size = 256;
+    int64_t grid_size = (total_elements + block_size - 1) / block_size;
+    if (grid_size > 2147483647) {
+        // Handle very large grids by iterative grid-stride loop; but here total_elements limited.
+        // For safety, we can use a grid-stride loop in kernel and set grid to min(needed, max).
+        // However, Simpler: use 1D grid with <= 2^31-1; assume not exceeded.
+    }
+    masked_fill_kernel<<<(unsigned int)grid_size, block_size, 0, stream>>>(
+        output, input, total_elements, mask_value, B, C, H, W, stride_b, stride_c, stride_h, stride_w
+    );
+}
+
+// Host launcher for custom_cat along dim 1
+// output: contiguous float tensor with shape [B, C1+C2, H, W]
+// x, y: input tensors with their shapes/strides. C1 = x channel dim, C2 = y channel dim (both same H,W,B)
+void launch_cat_dim1(
+    float* output,
+    const float* x,
+    const float* y,
+    int64_t B, int64_t C1, int64_t C2, int64_t H, int64_t W,
+    int64_t x_stride_b, int64_t x_stride_c, int64_t x_stride_h, int64_t x_stride_w,
+    int64_t y_stride_b, int64_t y_stride_c, int64_t y_stride_h, int64_t y_stride_w,
+    cudaStream_t stream
+) {
+    int64_t total_output_elements = B * (C1 + C2) * H * W;
+    const int block_size = 256;
+    int64_t grid_size = (total_output_elements + block_size - 1) / block_size;
+    cat_dim1_kernel<<<(unsigned int)grid_size, block_size, 0, stream>>>(
+        output, x, y, total_output_elements, B, C1, C2, H, W,
+        x_stride_b, x_stride_c, x_stride_h, x_stride_w,
+        y_stride_b, y_stride_c, y_stride_h, y_stride_w
+    );
+}
+
+// Export C functions for binding layer
+// Use extern "C" to avoid name mangling
+extern "C" {
+
+void custom_masked_fill_launcher(
+    float* output,
+    const float* input,
+    int64_t total_elements,
+    float mask_value,
+    int64_t B, int64_t C, int64_t H, int64_t W,
+    int64_t stride_b, int64_t stride_c, int64_t stride_h, int64_t stride_w,
+    cudaStream_t stream
+) {
+    launch_masked_fill(output, input, total_elements, mask_value, B, C, H, W,
+                       stride_b, stride_c, stride_h, stride_w, stream);
+}
+
+void custom_cat_launcher(
+    float* output,
+    const float* x,
+    const float* y,
+    int64_t B, int64_t C1, int64_t C2, int64_t H, int64_t W,
+    int64_t x_stride_b, int64_t x_stride_c, int64_t x_stride_h, int64_t x_stride_w,
+    int64_t y_stride_b, int64_t y_stride_c, int64_t y_stride_h, int64_t y_stride_w,
+    cudaStream_t stream
+) {
+    launch_cat_dim1(output, x, y, B, C1, C2, H, W,
+                    x_stride_b, x_stride_c, x_stride_h, x_stride_w,
+                    y_stride_b, y_stride_c, y_stride_h, y_stride_w, stream);
+}
+
+} // extern "C"
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,112 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" {
+void custom_masked_fill_launcher(
+    float* output,
+    const float* input,
+    int64_t total_elements,
+    float mask_value,
+    int64_t B, int64_t C, int64_t H, int64_t W,
+    int64_t stride_b, int64_t stride_c, int64_t stride_h, int64_t stride_w,
+    cudaStream_t stream
+);
+
+void custom_cat_launcher(
+    float* output,
+    const float* x,
+    const float* y,
+    int64_t B, int64_t C1, int64_t C2, int64_t H, int64_t W,
+    int64_t x_stride_b, int64_t x_stride_c, int64_t x_stride_h, int64_t x_stride_w,
+    int64_t y_stride_b, int64_t y_stride_c, int64_t y_stride_h, int64_t y_stride_w,
+    cudaStream_t stream
+);
+}
+
+// Wrapper for custom_masked_fill
+// Input: x (float32 CUDA tensor), mask_value (double)
+// Output: tensor with same shape and strides as x, filled with 0 where x < mask_value
+static torch::Tensor custom_masked_fill(torch::Tensor x, double mask_value) {
+    TORCH_CHECK(x.is_cuda(), "custom_masked_fill: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "custom_masked_fill: input must be float32");
+    TORCH_CHECK(x.dim() == 4, "custom_masked_fill: input must be 4D (B, C, H, W)");
+
+    auto output = torch::empty_like(x);
+
+    int64_t B = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+    int64_t stride_b = x.stride(0);
+    int64_t stride_c = x.stride(1);
+    int64_t stride_h = x.stride(2);
+    int64_t stride_w = x.stride(3);
+    int64_t total_elements = x.numel();
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_masked_fill_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        total_elements,
+        static_cast<float>(mask_value),
+        B, C, H, W,
+        stride_b, stride_c, stride_h, stride_w,
+        stream
+    );
+
+    TORCH_CHECK(cudaGetLastError() == cudaSuccess, "custom_masked_fill: kernel launch failed");
+    return output;
+}
+
+// Wrapper for custom_cat
+// Inputs: x, y (float32 CUDA tensors), dim (int64, only dim=1 supported)
+// Output: new contiguous tensor with concatenation along dim
+static torch::Tensor custom_cat(torch::Tensor x, torch::Tensor y, int64_t dim) {
+    TORCH_CHECK(x.is_cuda() && y.is_cuda(), "custom_cat: inputs must be CUDA tensors");
+    TORCH_CHECK(x.dtype() == torch::kFloat32 && y.dtype() == torch::kFloat32, "custom_cat: inputs must be float32");
+    TORCH_CHECK(x.dim() == 4 && y.dim() == 4, "custom_cat: inputs must be 4D");
+    TORCH_CHECK(dim == 1, "custom_cat: only dim=1 is supported");
+    TORCH_CHECK(x.size(0) == y.size(0) && x.size(2) == y.size(2) && x.size(3) == y.size(3),
+                "custom_cat: input shapes must match except in channel dimension");
+
+    int64_t B = x.size(0);
+    int64_t C1 = x.size(1);
+    int64_t C2 = y.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+
+    // Allocate output as contiguous tensor with shape [B, C1+C2, H, W]
+    auto output = torch::empty({B, C1 + C2, H, W}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_cat_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        y.data_ptr<float>(),
+        B, C1, C2, H, W,
+        x.stride(0), x.stride(1), x.stride(2), x.stride(3),
+        y.stride(0), y.stride(1), y.stride(2), y.stride(3),
+        stream
+    );
+
+    TORCH_CHECK(cudaGetLastError() == cudaSuccess, "custom_cat: kernel launch failed");
+    return output;
+}
+
+// Register bindings
+static void register_custom_ops(pybind11::module& m) {
+    m.def("custom_masked_fill", &custom_masked_fill,
+          "Custom masked_fill (x < mask_value -> 0)",
+          py::arg("x"), py::arg("mask_value") = 0.5);
+    m.def("custom_cat", &custom_cat,
+          "Custom concatenate along dim=1",
+          py::arg("x"), py::arg("y"), py::arg("dim") = 1);
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,21 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, out_channels, mask_value):
+        super().__init__()
+        self.mask_value = mask_value
+
+    def forward(self, x):
+        x = cuda_extension.custom_masked_fill(x, self.mask_value)
+        x = cuda_extension.custom_cat(x, x, 1)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.custom_masked_fill(x, self.mask_value)
+        yield 'step_001', x
+        x = cuda_extension.custom_cat(x, x, 1)
+        yield 'step_002', x
+        yield 'step_003', x
