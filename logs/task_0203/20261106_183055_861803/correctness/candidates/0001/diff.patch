--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,123 @@
+#include <cuda_runtime.h>
+#include <cmath>
+
+// GELU activation: 0.5 * x * (1 + erf(x / sqrt(2)))
+__global__ void gelu_kernel(const float* __restrict__ input,
+                            float* __restrict__ output,
+                            long long total_elements,
+                            int rank,
+                            const long long* __restrict__ input_strides,
+                            const long long* __restrict__ output_strides,
+                            const long long* __restrict__ shape) {
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+
+    for (long long linear = idx; linear < total_elements; linear += stride) {
+        // 将线性索引映射到多维坐标，考虑任意 stride
+        long long remaining = linear;
+        long long input_offset = 0;
+        long long output_offset = 0;
+        for (int d = 0; d < rank; ++d) {
+            long long coord = remaining % shape[d];
+            remaining /= shape[d];
+            input_offset += coord * input_strides[d];
+            output_offset += coord * output_strides[d];
+        }
+
+        float x = input[input_offset];
+        float gelu_val = 0.5f * x * (1.0f + erff(x * 0.70710678118654752440f));
+        output[output_offset] = gelu_val;
+    }
+}
+
+// Truncation toward zero
+__global__ void trunc_kernel(const float* __restrict__ input,
+                             float* __restrict__ output,
+                             long long total_elements,
+                             int rank,
+                             const long long* __restrict__ input_strides,
+                             const long long* __restrict__ output_strides,
+                             const long long* __restrict__ shape) {
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+
+    for (long long linear = idx; linear < total_elements; linear += stride) {
+        long long remaining = linear;
+        long long input_offset = 0;
+        long long output_offset = 0;
+        for (int d = 0; d < rank; ++d) {
+            long long coord = remaining % shape[d];
+            remaining /= shape[d];
+            input_offset += coord * input_strides[d];
+            output_offset += coord * output_strides[d];
+        }
+
+        float x = input[input_offset];
+        output[output_offset] = truncf(x);
+    }
+}
+
+// Helper: 将连续输出步幅写入 output_strides
+__global__ void compute_contiguous_strides_kernel(long long* output_strides,
+                                                  const long long* shape,
+                                                  int rank) {
+    // 只需要一个线程执行
+    if (threadIdx.x != 0 || blockIdx.x != 0) return;
+    long long stride = 1;
+    for (int d = rank - 1; d >= 0; --d) {
+        output_strides[d] = stride;
+        stride *= shape[d];
+    }
+}
+
+extern "C" void gelu_forward_launcher(const float* input,
+                                       float* output,
+                                       const long long* shape,
+                                       const long long* input_strides,
+                                       int rank,
+                                       long long total_elements,
+                                       cudaStream_t stream) {
+    // 先计算连续输出 strides
+    long long* d_output_strides;
+    cudaMalloc(&d_output_strides, rank * sizeof(long long));
+    cudaMemsetAsync(d_output_strides, 0, rank * sizeof(long long), stream);
+
+    cudaMemcpyAsync(d_output_strides, shape, rank * sizeof(long long), cudaMemcpyDeviceToDevice, stream); // 临时占位，实际在 kernel 中计算
+    // 更安全：直接调用 kernel 计算 strides，再传入 gelu kernel
+    compute_contiguous_strides_kernel<<<1, 1, 0, stream>>>(d_output_strides, shape, rank);
+
+    int threads = 256;
+    long long blocks_ll = (total_elements + threads - 1) / threads;
+    if (blocks_ll > 2147483647LL) blocks_ll = 2147483647LL; // 32位 int 上限
+    int blocks = (int)blocks_ll;
+
+    gelu_kernel<<<blocks, threads, 0, stream>>>(
+        input, output, total_elements, rank, input_strides, d_output_strides, shape);
+
+    cudaFree(d_output_strides);
+}
+
+extern "C" void trunc_forward_launcher(const float* input,
+                                       float* output,
+                                       const long long* shape,
+                                       const long long* input_strides,
+                                       int rank,
+                                       long long total_elements,
+                                       cudaStream_t stream) {
+    long long* d_output_strides;
+    cudaMalloc(&d_output_strides, rank * sizeof(long long));
+    cudaMemsetAsync(d_output_strides, 0, rank * sizeof(long long), stream);
+
+    cudaMemcpyAsync(d_output_strides, shape, rank * sizeof(long long), cudaMemcpyDeviceToDevice, stream);
+    compute_contiguous_strides_kernel<<<1, 1, 0, stream>>>(d_output_strides, shape, rank);
+
+    int threads = 256;
+    long long blocks_ll = (total_elements + threads - 1) / threads;
+    if (blocks_ll > 2147483647LL) blocks_ll = 2147483647LL;
+    int blocks = (int)blocks_ll;
+
+    trunc_kernel<<<blocks, threads, 0, stream>>>(
+        input, output, total_elements, rank, input_strides, d_output_strides, shape);
+
+    cudaFree(d_output_strides);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,105 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <vector>
+#include "../binding_registry.h"
+
+extern "C" void gelu_forward_launcher(const float* input,
+                                       float* output,
+                                       const long long* shape,
+                                       const long long* input_strides,
+                                       int rank,
+                                       long long total_elements,
+                                       cudaStream_t stream);
+
+extern "C" void trunc_forward_launcher(const float* input,
+                                       float* output,
+                                       const long long* shape,
+                                       const long long* input_strides,
+                                       int rank,
+                                       long long total_elements,
+                                       cudaStream_t stream);
+
+namespace {
+
+torch::Tensor validate_and_prepare(const torch::Tensor& x, const std::string& op_name) {
+    TORCH_CHECK(x.is_cuda(), op_name, ": input must be a CUDA tensor");
+    TORCH_CHECK(x.scalar_type() == torch::kFloat32, op_name, ": input must be float32");
+    TORCH_CHECK(x.numel() > 0, op_name, ": input must be non-empty");
+    return x.contiguous();
+}
+
+std::vector<long long> get_shape(const torch::Tensor& t) {
+    std::vector<long long> shape(t.dim());
+    for (int i = 0; i < t.dim(); ++i) {
+        shape[i] = t.size(i);
+    }
+    return shape;
+}
+
+std::vector<long long> get_strides(const torch::Tensor& t) {
+    std::vector<long long> strides(t.dim());
+    for (int i = 0; i < t.dim(); ++i) {
+        strides[i] = t.stride(i);
+    }
+    return strides;
+}
+
+torch::Tensor launch_forward(
+    const torch::Tensor& x_original,
+    const std::string& op_name,
+    void (*launcher)(const float*, float*, const long long*, const long long*, int, long long, cudaStream_t)) {
+    torch::Tensor x = validate_and_prepare(x_original, op_name);
+    auto shape_vec = get_shape(x);
+    auto strides_vec = get_strides(x);
+    int rank = x.dim();
+    long long total = x.numel();
+
+    auto output = torch::empty_like(x);
+
+    // Copy shape and strides to device
+    long long* d_shape;
+    long long* d_strides;
+    cudaMalloc(&d_shape, rank * sizeof(long long));
+    cudaMalloc(&d_strides, rank * sizeof(long long));
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    cudaMemcpyAsync(d_shape, shape_vec.data(), rank * sizeof(long long), cudaMemcpyHostToDevice, stream);
+    cudaMemcpyAsync(d_strides, strides_vec.data(), rank * sizeof(long long), cudaMemcpyHostToDevice, stream);
+
+    launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        d_shape,
+        d_strides,
+        rank,
+        total,
+        stream
+    );
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, op_name, ": CUDA error: ", cudaGetErrorString(err));
+
+    cudaFree(d_shape);
+    cudaFree(d_strides);
+
+    return output;
+}
+
+torch::Tensor gelu_forward(torch::Tensor x) {
+    return launch_forward(x, "gelu_forward", gelu_forward_launcher);
+}
+
+torch::Tensor trunc_forward(torch::Tensor x) {
+    return launch_forward(x, "trunc_forward", trunc_forward_launcher);
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("gelu_forward", &gelu_forward, "GELU activation forward", py::arg("x"));
+    m.def("trunc_forward", &trunc_forward, "Truncation forward", py::arg("x"));
+}
+
+} // anonymous namespace
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
