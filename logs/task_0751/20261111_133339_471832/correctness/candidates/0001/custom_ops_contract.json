{
  "operators": [
    {
      "name": "linear_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, in_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_features, in_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "in_features",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "out_features",
          "kind": "int",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, out_features]"
      },
      "semantics": [
        "计算 y = input @ weight^T + bias",
        "等价于 torch.nn.functional.linear(input, weight, bias)",
        "输入和权重必须为 CUDA float32 张量，支持任意 batch_size",
        "输出维度为 [batch_size, out_features]"
      ]
    },
    {
      "name": "minimum_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, out_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "other",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, out_features]"
      },
      "semantics": [
        "计算逐元素最小值 torch.minimum(input, other)",
        "other 沿着最后一维广播",
        "输出形状与 input 相同"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.linear(x)",
      "semantics": [
        "使用 nn.Linear 计算 y = x @ weight.T + bias",
        "weight 形状 [1024, 2048]，bias 形状 [1024]",
        "输出形状 [8192, 1024]，dtype float32"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.minimum(x, self.bias)",
      "semantics": [
        "逐元素最小值，self.bias 形状 [1024] 广播到 [8192, 1024]",
        "输出形状 [8192, 1024]，dtype float32"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回最终结果，形状 [8192, 1024]，dtype float32"
      ]
    }
  ]
}