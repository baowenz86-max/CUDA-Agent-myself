--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,52 @@
+#include <cuda_runtime.h>
+
+// ELU activation: y = x > 0 ? x : exp(x) - 1
+__global__ void elu_kernel_forward(const float* __restrict__ x, float* __restrict__ y, int64_t n) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (; idx < n; idx += stride) {
+        float v = x[idx];
+        y[idx] = (v > 0.0f) ? v : (expf(v) - 1.0f);
+    }
+}
+
+// Absolute value: y = fabsf(x)
+__global__ void abs_kernel_forward(const float* __restrict__ x, float* __restrict__ y, int64_t n) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (; idx < n; idx += stride) {
+        y[idx] = fabsf(x[idx]);
+    }
+}
+
+// Fused abs(ELU(x)): y = x > 0 ? x : 1 - exp(x)
+__global__ void elu_abs_kernel_forward(const float* __restrict__ x, float* __restrict__ y, int64_t n) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (; idx < n; idx += stride) {
+        float v = x[idx];
+        y[idx] = (v > 0.0f) ? v : (1.0f - expf(v));
+    }
+}
+
+extern "C" void elu_forward_launcher(const float* x, float* y, int64_t n, cudaStream_t stream) {
+    const int block_size = 256;
+    int64_t grid_size = (n + block_size - 1) / block_size;
+    // 限制 grid 大小避免超出硬件限制（虽然通常不会，但安全）
+    if (grid_size > 2147483647LL) grid_size = 2147483647LL;
+    elu_kernel_forward<<<(unsigned int)grid_size, block_size, 0, stream>>>(x, y, n);
+}
+
+extern "C" void abs_forward_launcher(const float* x, float* y, int64_t n, cudaStream_t stream) {
+    const int block_size = 256;
+    int64_t grid_size = (n + block_size - 1) / block_size;
+    if (grid_size > 2147483647LL) grid_size = 2147483647LL;
+    abs_kernel_forward<<<(unsigned int)grid_size, block_size, 0, stream>>>(x, y, n);
+}
+
+extern "C" void elu_abs_forward_launcher(const float* x, float* y, int64_t n, cudaStream_t stream) {
+    const int block_size = 256;
+    int64_t grid_size = (n + block_size - 1) / block_size;
+    if (grid_size > 2147483647LL) grid_size = 2147483647LL;
+    elu_abs_kernel_forward<<<(unsigned int)grid_size, block_size, 0, stream>>>(x, y, n);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,56 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void elu_forward_launcher(const float* x, float* y, int64_t n, cudaStream_t stream);
+extern "C" void abs_forward_launcher(const float* x, float* y, int64_t n, cudaStream_t stream);
+extern "C" void elu_abs_forward_launcher(const float* x, float* y, int64_t n, cudaStream_t stream);
+
+// Helper to validate and get contiguous float32 CUDA tensor
+static void validate_input(const torch::Tensor& x, const char* op_name) {
+    TORCH_CHECK(x.is_cuda(), op_name, ": input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, op_name, ": input must be float32");
+    TORCH_CHECK(x.is_contiguous(), op_name, ": input must be contiguous");
+}
+
+// Wrapper for elu_forward
+torch::Tensor elu_forward(torch::Tensor x) {
+    validate_input(x, "elu_forward");
+    auto out = torch::empty_like(x);
+    int64_t n = x.numel();
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    elu_forward_launcher(x.data_ptr<float>(), out.data_ptr<float>(), n, stream);
+    return out;
+}
+
+// Wrapper for abs_forward
+torch::Tensor abs_forward(torch::Tensor x) {
+    validate_input(x, "abs_forward");
+    auto out = torch::empty_like(x);
+    int64_t n = x.numel();
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    abs_forward_launcher(x.data_ptr<float>(), out.data_ptr<float>(), n, stream);
+    return out;
+}
+
+// Wrapper for elu_abs_forward
+torch::Tensor elu_abs_forward(torch::Tensor x) {
+    validate_input(x, "elu_abs_forward");
+    auto out = torch::empty_like(x);
+    int64_t n = x.numel();
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    elu_abs_forward_launcher(x.data_ptr<float>(), out.data_ptr<float>(), n, stream);
+    return out;
+}
+
+// Register bindings
+void register_custom_ops(pybind11::module& m) {
+    m.def("elu_forward", &elu_forward, "ELU activation forward", py::arg("x"));
+    m.def("abs_forward", &abs_forward, "Absolute value forward", py::arg("x"));
+    m.def("elu_abs_forward", &elu_abs_forward, "Fused ELU + absolute value forward", py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,18 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+class ModelNew(nn.Module):
+    def __init__(self, reduction_factor):
+        super().__init__()
+        self.reduction_factor = reduction_factor
+
+    def forward(self, x):
+        return cuda_extension.elu_abs_forward(x)
+
+    def debug_forward(self, x):
+        intermediate = cuda_extension.elu_forward(x)
+        output = cuda_extension.abs_forward(intermediate)
+        yield 'step_001', intermediate
+        yield 'step_002', output
+        yield 'step_003', output
