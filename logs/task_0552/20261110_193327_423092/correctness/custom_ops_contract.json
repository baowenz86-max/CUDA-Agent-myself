          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[512, 16, 320, 320]"
      },
      "semantics": [
        "对应参考语句 x = F.elu(x); x = torch.abs(x) 的融合版本",
        "等价于 abs(elu(x))：对于每个元素 v，若 v > 0 则输出 v，否则输出 |alpha * (exp(v) - 1)|",
        "保持输入 shape、dtype、device 不变，输出连续张量"
      ]
    }
  ],
