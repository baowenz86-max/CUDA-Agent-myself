      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[512, 16, 320, 320]"
      },
      "semantics": [
        "对应参考语句 x = torch.abs(x)，input=x",
        "逐元素计算绝对值，即 |v|",
        "保持输入 shape、dtype、device 不变，输出连续张量"
      ]
    },
    {
