--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,125 @@
+#include <cuda_runtime.h>
+#include <cmath>
+
+// Reduce last dimension (width) to mean, keepdim=True.
+// Input: x with shape [B, C, H, W], arbitrary strides.
+// Output: out with shape [B, C, H, 1], arbitrary strides.
+// Kernel launch: one thread per output mean? Actually one block per output row could be inefficient for H large.
+// Use one thread per output row, each thread sums along W sequentially. This is simple and works for any W.
+// Grid size: total_rows = B*C*H. Block size 256. Grid-stride loop over rows.
+// For W=1024, each thread does 1024 additions, okay.
+__global__ void mean_dim_last_kernel(
+    float* __restrict__ out,
+    const float* __restrict__ x,
+    int B, int C, int H, int W,
+    long long x_stride_b, long long x_stride_c, long long x_stride_h, long long x_stride_w,
+    long long out_stride_b, long long out_stride_c, long long out_stride_h, long long out_stride_w
+) {
+    int total_rows = B * C * H;
+    int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+    for (int row = tid; row < total_rows; row += stride) {
+        int b = row / (C * H);
+        int rem = row - b * (C * H);
+        int c = rem / H;
+        int h = rem - c * H;
+        const float* x_row = x + b * x_stride_b + c * x_stride_c + h * x_stride_h;
+        float sum = 0.0f;
+        for (int w = 0; w < W; ++w) {
+            sum += x_row[w * x_stride_w];
+        }
+        float* out_ptr = out + b * out_stride_b + c * out_stride_c + h * out_stride_h;
+        *out_ptr = sum / W;
+    }
+}
+
+__global__ void softplus_kernel(
+    float* __restrict__ out,
+    const float* __restrict__ x,
+    long long numel,
+    long long x_stride0, long long x_stride1, long long x_stride2, long long x_stride3,
+    long long out_stride0, long long out_stride1, long long out_stride2, long long out_stride3,
+    int ndim
+) {
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+    // Softplus threshold as in PyTorch (20.0)
+    const float threshold = 20.0f;
+    for (; idx < numel; idx += stride) {
+        // Compute linear indices for arbitrary ndim up to 4
+        long long rem = idx;
+        long long i3 = 0, i2 = 0, i1 = 0, i0 = 0;
+        if (ndim == 4) {
+            i3 = rem / x_stride3; rem %= x_stride3;
+            i2 = rem / x_stride2; rem %= x_stride2;
+            i1 = rem / x_stride1; rem %= x_stride1;
+            i0 = rem;
+        } else if (ndim == 3) {
+            i2 = rem / x_stride2; rem %= x_stride2;
+            i1 = rem / x_stride1; rem %= x_stride1;
+            i0 = rem;
+        } else if (ndim == 2) {
+            i1 = rem / x_stride1; rem %= x_stride1;
+            i0 = rem;
+        } else { // ndim == 1
+            i0 = rem;
+        }
+        const float* x_ptr = x + i3 * x_stride3 + i2 * x_stride2 + i1 * x_stride1 + i0 * x_stride0;
+        float val = *x_ptr;
+        float result = (val > threshold) ? val : log1pf(expf(val));
+        float* out_ptr = out + i3 * out_stride3 + i2 * out_stride2 + i1 * out_stride1 + i0 * out_stride0;
+        *out_ptr = result;
+    }
+}
+
+extern "C" void mean_dim_last_launcher(
+    float* out,
+    const float* x,
+    int B, int C, int H, int W,
+    long long x_stride_b, long long x_stride_c, long long x_stride_h, long long x_stride_w,
+    long long out_stride_b, long long out_stride_c, long long out_stride_h, long long out_stride_w,
+    cudaStream_t stream
+) {
+    int total_rows = B * C * H;
+    if (total_rows <= 0 || W <= 0) return;
+    int block = 256;
+    int grid = (total_rows + block - 1) / block;
+    // Cap grid to reasonable size; grid-stride loop handles rest
+    if (grid > 65535) grid = 65535;
+    mean_dim_last_kernel<<<grid, block, 0, stream>>>(
+        out, x, B, C, H, W,
+        x_stride_b, x_stride_c, x_stride_h, x_stride_w,
+        out_stride_b, out_stride_c, out_stride_h, out_stride_w
+    );
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // Cannot throw from .cu without torch dependency. We could print, but better to let binding handle? We'll ignore here.
+        // The binding will check stream sync for errors. We'll just do a printf for debugging.
+        // printf("mean_dim_last kernel launch error: %s\n", cudaGetErrorString(err));
+    }
+}
+
+extern "C" void softplus_launcher(
+    float* out,
+    const float* x,
+    long long numel,
+    long long x_stride0, long long x_stride1, long long x_stride2, long long x_stride3,
+    long long out_stride0, long long out_stride1, long long out_stride2, long long out_stride3,
+    int ndim,
+    cudaStream_t stream
+) {
+    if (numel <= 0) return;
+    int block = 256;
+    long long grid_ll = (numel + block - 1) / block;
+    int grid = (grid_ll > 65535) ? 65535 : (int)grid_ll;
+    softplus_kernel<<<grid, block, 0, stream>>>(
+        out, x, numel,
+        x_stride0, x_stride1, x_stride2, x_stride3,
+        out_stride0, out_stride1, out_stride2, out_stride3,
+        ndim
+    );
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // Ignore or debug print
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,126 @@
+// Binding for mean_dim_last and softplus custom CUDA kernels
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Forward declarations of launchers from custom_ops.cu
+extern "C" void mean_dim_last_launcher(
+    float* out,
+    const float* x,
+    int B,
+    int C,
+    int H,
+    int W,
+    long long x_stride_b,
+    long long x_stride_c,
+    long long x_stride_h,
+    long long x_stride_w,
+    long long out_stride_b,
+    long long out_stride_c,
+    long long out_stride_h,
+    long long out_stride_w,
+    cudaStream_t stream
+);
+
+extern "C" void softplus_launcher(
+    float* out,
+    const float* x,
+    long long numel,
+    long long x_stride0,
+    long long x_stride1,
+    long long x_stride2,
+    long long x_stride3,
+    long long out_stride0,
+    long long out_stride1,
+    long long out_stride2,
+    long long out_stride3,
+    int ndim,
+    cudaStream_t stream
+);
+
+// Helper to check for CUDA errors after kernel launch
+static void check_cuda_error(const char* op_name) {
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, op_name, " kernel launch failed: ", cudaGetErrorString(err));
+}
+
+// PyTorch wrapper for mean_dim_last
+torch::Tensor mean_dim_last(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "mean_dim_last: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "mean_dim_last: input must be float32");
+    TORCH_CHECK(x.dim() >= 1, "mean_dim_last: input must have at least 1 dimension");
+
+    // Treat input as 4D: [B, C, H, W] with implicit leading singleton dims if needed
+    int extra_dims = (x.dim() < 4) ? (4 - x.dim()) : 0;
+    int B = extra_dims > 0 ? 1 : x.size(0);
+    int C = extra_dims > 2 ? 1 : x.size(1);
+    int H = extra_dims > 1 ? 1 : x.size(2);
+    int W = x.size(-1);
+
+    // For dim < 4, adjust strides: missing dimensions have stride 0 or same as W? For broadcasting, we only use valid strides.
+    // To simplify, we use actual strides if dims exist, 0 otherwise; but launcher would add zero offset, which is fine.
+    long long x_stride_b = (extra_dims > 0) ? 0 : x.stride(0);
+    long long x_stride_c = (extra_dims > 2) ? 0 : x.stride(1);
+    long long x_stride_h = (extra_dims > 1) ? 0 : x.stride(2);
+    long long x_stride_w = x.stride(-1);
+
+    // Output shape: [B, C, H, 1]
+    auto out = torch::empty({B, C, H, 1}, x.options());
+    long long out_stride_b = (extra_dims > 0) ? 0 : out.stride(0);
+    long long out_stride_c = (extra_dims > 2) ? 0 : out.stride(1);
+    long long out_stride_h = (extra_dims > 1) ? 0 : out.stride(2);
+    long long out_stride_w = out.stride(-1);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    mean_dim_last_launcher(
+        out.data_ptr<float>(),
+        x.data_ptr<float>(),
+        B, C, H, W,
+        x_stride_b, x_stride_c, x_stride_h, x_stride_w,
+        out_stride_b, out_stride_c, out_stride_h, out_stride_w,
+        stream
+    );
+    check_cuda_error("mean_dim_last");
+    return out;
+}
+
+// PyTorch wrapper for softplus
+torch::Tensor softplus(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "softplus: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "softplus: input must be float32");
+
+    auto out = torch::empty_like(x);
+    long long numel = x.numel();
+    int ndim = x.dim();
+
+    // Prepare strides for up to 4 dimensions; for fewer, use 0 for unused dims
+    long long x_stride[4] = {0, 0, 0, 0};
+    long long out_stride[4] = {0, 0, 0, 0};
+    for (int d = 0; d < ndim && d < 4; ++d) {
+        x_stride[d] = x.stride(d);
+        out_stride[d] = out.stride(d);
+    }
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    softplus_launcher(
+        out.data_ptr<float>(),
+        x.data_ptr<float>(),
+        numel,
+        x_stride[0], x_stride[1], x_stride[2], x_stride[3],
+        out_stride[0], out_stride[1], out_stride[2], out_stride[3],
+        ndim,
+        stream
+    );
+    check_cuda_error("softplus");
+    return out;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("mean_dim_last", &mean_dim_last, "Compute mean along the last dimension, keeping dimension (float32 CUDA)");
+    m.def("softplus", &softplus, "Apply softplus element-wise (float32 CUDA)");
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,21 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels):
+        super().__init__()
+        self.in_channels = in_channels
+
+    def forward(self, x):
+        x = cuda_extension.mean_dim_last(x)
+        x = cuda_extension.softplus(x)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.mean_dim_last(x)
+        yield 'step_001', x
+        x = cuda_extension.softplus(x)
+        yield 'step_002', x
+        yield 'step_003', x
