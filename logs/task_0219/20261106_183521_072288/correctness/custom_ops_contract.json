{
  "operators": [
    {
      "name": "mean_dim_last",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, channels, height, width]",
          "layout": "contiguous or supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, channels, height, 1]"
      },
      "semantics": [
        "计算输入最后一维的均值，keepdim=True，输出 shape 为 [..., 1]",
        "等价于 torch.mean(x, dim=-1, keepdim=True)，但固定为最后一维",
        "不修改输入的 dtype/device，输出为 float32 CUDA tensor",
        "支持任意 batch/channels/height/width，宽度可能不是 1024"
      ]
    },
    {
      "name": "softplus",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference step",
          "layout": "contiguous or supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "逐元素计算 softplus: log(1 + exp(x))，使用数值稳定公式 threshold=20，当 x > threshold 时返回 x，否则返回 log1p(exp(x))",
        "不修改输入的 dtype/device，输出为 float32 CUDA tensor"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = torch.mean(x, dim=self.in_channels, keepdim=True)",
      "semantics": [
        "沿 dim=3（最后一维）求均值，keepdim=True，输出 shape [256,3,1024,1]",
        "实际为对宽度维度求平均，不涉及通道维",
        "输入为 float32 CUDA，输出 float32 CUDA"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = F.softplus(x)",
      "semantics": [
        "逐元素 softplus，输出与输入同 shape [256,3,1024,1]",
        "float32 CUDA"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回 step_002 的输出张量，即 softplus 结果"
      ]
    }
  ]
}