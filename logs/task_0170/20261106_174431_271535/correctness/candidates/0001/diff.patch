--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,130 @@
+#include <cuda_runtime.h>
+#include <device_launch_parameters.h>
+
+// AvgPool2d kernel: computes average over kernel_h x kernel_w window
+// x: input tensor [N, C, H, W] contiguous float32
+// out: output tensor [N, C, outH, outW] contiguous float32
+// kernel_h, kernel_w, stride_h, stride_w, padding_h, padding_w
+// outH = floor((H + 2*padding_h - kernel_h)/stride_h + 1)
+// outW = floor((W + 2*padding_w - kernel_w)/stride_w + 1)
+__global__ void avgpool2d_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ out,
+    int N, int C, int H, int W,
+    int outH, int outW,
+    int kernel_h, int kernel_w,
+    int stride_h, int stride_w,
+    int padding_h, int padding_w)
+{
+    int total = N * C * outH * outW;
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+
+    for (int linear_idx = idx; linear_idx < total; linear_idx += stride) {
+        int ow = linear_idx % outW;
+        int oh = (linear_idx / outW) % outH;
+        int c = (linear_idx / (outW * outH)) % C;
+        int n = linear_idx / (outW * outH * C);
+
+        float sum = 0.0f;
+        int count = 0;
+        for (int kh = 0; kh < kernel_h; ++kh) {
+            int ih = oh * stride_h - padding_h + kh;
+            if (ih < 0 || ih >= H) continue;
+            for (int kw = 0; kw < kernel_w; ++kw) {
+                int iw = ow * stride_w - padding_w + kw;
+                if (iw < 0 || iw >= W) continue;
+                int input_idx = ((n * C + c) * H + ih) * W + iw;
+                sum += x[input_idx];
+                ++count;
+            }
+        }
+        // count should be > 0 for valid output positions
+        if (count > 0) {
+            out[linear_idx] = sum / static_cast<float>(count);
+        } else {
+            out[linear_idx] = 0.0f;
+        }
+    }
+}
+
+// Hardtanh kernel: clip elementwise to [min_val, max_val]
+__global__ void hardtanh_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ out,
+    int total,
+    float min_val,
+    float max_val)
+{
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+
+    for (int i = idx; i < total; i += stride) {
+        float val = x[i];
+        val = val < min_val ? min_val : val;
+        val = val > max_val ? max_val : val;
+        out[i] = val;
+    }
+}
+
+// Launcher for avgpool2d_forward
+// Arguments:
+//   x: input pointer (float*)
+//   out: output pointer (float*)
+//   N, C, H, W: input dimensions
+//   kernel_h, kernel_w, stride_h, stride_w, padding_h, padding_w: pooling parameters
+//   stream: CUDA stream
+// Returns output dimensions via outH, outW (must be preallocated by caller?)
+// Actually, we compute outH, outW internally, but launcher only takes pointers and dims,
+// and does not allocate. The binding will allocate output of correct shape.
+// For simplicity, we pass output dimensions as arguments.
+// The binding code will compute outH, outW and allocate output accordingly.
+// Thus launcher signature: (x, out, N, C, H, W, outH, outW, kernel_h, kernel_w, stride_h, stride_w, padding_h, padding_w, stream)
+extern "C" void avgpool2d_launcher(
+    const float* x,
+    float* out,
+    int N, int C, int H, int W,
+    int outH, int outW,
+    int kernel_h, int kernel_w,
+    int stride_h, int stride_w,
+    int padding_h, int padding_w,
+    cudaStream_t stream)
+{
+    int total = N * C * outH * outW;
+    const int block_size = 256;
+    int grid_size = (total + block_size - 1) / block_size;
+    // Cap grid size to avoid excessive blocks (max grid dimension is 2^31-1)
+    const int max_grid_size = 65535; // safe for all GPUs
+    if (grid_size > max_grid_size) grid_size = max_grid_size;
+
+    avgpool2d_kernel<<<grid_size, block_size, 0, stream>>>(
+        x, out, N, C, H, W, outH, outW,
+        kernel_h, kernel_w, stride_h, stride_w, padding_h, padding_w);
+}
+
+// Launcher for hardtanh_forward
+// Arguments:
+//   x: input pointer (float*)
+//   out: output pointer (float*)
+//   total: number of elements
+//   min_val, max_val: clip bounds
+//   stream: CUDA stream
+extern "C" void hardtanh_launcher(
+    const float* x,
+    float* out,
+    int total,
+    float min_val,
+    float max_val,
+    cudaStream_t stream)
+{
+    const int block_size = 256;
+    int grid_size = (total + block_size - 1) / block_size;
+    const int max_grid_size = 65535;
+    if (grid_size > max_grid_size) grid_size = max_grid_size;
+
+    hardtanh_kernel<<<grid_size, block_size, 0, stream>>>(
+        x, out, total, min_val, max_val);
+}
+
+// Optional: we can add error checking after kernel launch, but launcher should return void.
+// The binding can call cudaGetLastError to check.
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,144 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_runtime.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void avgpool2d_launcher(
+    const float* x,
+    float* out,
+    int N, int C, int H, int W,
+    int outH, int outW,
+    int kernel_h, int kernel_w,
+    int stride_h, int stride_w,
+    int padding_h, int padding_w,
+    cudaStream_t stream);
+
+extern "C" void hardtanh_launcher(
+    const float* x,
+    float* out,
+    int total,
+    float min_val,
+    float max_val,
+    cudaStream_t stream);
+
+// Wrapper for avgpool2d_forward
+// Parameters:
+//   x: input tensor [N, C, H, W] contiguous float32 CUDA
+//   kernel_h, kernel_w, stride_h, stride_w, padding_h, padding_w: int
+// Returns output tensor [N, C, outH, outW] contiguous float32 CUDA
+torch::Tensor avgpool2d_forward(
+    torch::Tensor x,
+    int64_t kernel_h,
+    int64_t kernel_w,
+    int64_t stride_h,
+    int64_t stride_w,
+    int64_t padding_h,
+    int64_t padding_w) {
+    // Validate input tensor
+    TORCH_CHECK(x.is_cuda(), "avgpool2d_forward: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "avgpool2d_forward: input must be float32");
+    TORCH_CHECK(x.dim() == 4, "avgpool2d_forward: input must be 4D (N, C, H, W)");
+    TORCH_CHECK(x.is_contiguous(), "avgpool2d_forward: input must be contiguous");
+
+    // Validate pooling parameters
+    TORCH_CHECK(kernel_h > 0 && kernel_w > 0, "avgpool2d_forward: kernel sizes must be positive");
+    TORCH_CHECK(stride_h > 0 && stride_w > 0, "avgpool2d_forward: strides must be positive");
+    TORCH_CHECK(padding_h >= 0 && padding_w >= 0, "avgpool2d_forward: padding must be non-negative");
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+
+    // Compute output dimensions following floor formula
+    int64_t outH = (H + 2 * padding_h - kernel_h) / stride_h + 1;
+    int64_t outW = (W + 2 * padding_w - kernel_w) / stride_w + 1;
+    TORCH_CHECK(outH > 0 && outW > 0, "avgpool2d_forward: computed output dimensions are non-positive");
+
+    // Allocate output tensor of same dtype and device, contiguous
+    auto out = torch::empty({N, C, outH, outW}, x.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher with raw pointers and int dimensions
+    avgpool2d_launcher(
+        x.data_ptr<float>(),
+        out.data_ptr<float>(),
+        static_cast<int>(N),
+        static_cast<int>(C),
+        static_cast<int>(H),
+        static_cast<int>(W),
+        static_cast<int>(outH),
+        static_cast<int>(outW),
+        static_cast<int>(kernel_h),
+        static_cast<int>(kernel_w),
+        static_cast<int>(stride_h),
+        static_cast<int>(stride_w),
+        static_cast<int>(padding_h),
+        static_cast<int>(padding_w),
+        stream);
+
+    // Check for kernel launch errors
+    TORCH_CHECK(cudaGetLastError() == cudaSuccess, "avgpool2d_forward: CUDA kernel launch failed");
+
+    return out;
+}
+
+// Wrapper for hardtanh_forward
+// Parameters:
+//   x: input tensor contiguous float32 CUDA
+//   min_val, max_val: float scalars
+// Returns output tensor shape same as x, clipped elementwise
+torch::Tensor hardtanh_forward(
+    torch::Tensor x,
+    double min_val,
+    double max_val) {
+    // Validate input tensor
+    TORCH_CHECK(x.is_cuda(), "hardtanh_forward: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "hardtanh_forward: input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "hardtanh_forward: input must be contiguous");
+
+    // Allocate output tensor of same shape and options
+    auto out = torch::empty_like(x);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher with raw pointer, total elements, float min/max
+    hardtanh_launcher(
+        x.data_ptr<float>(),
+        out.data_ptr<float>(),
+        static_cast<int>(x.numel()),
+        static_cast<float>(min_val),
+        static_cast<float>(max_val),
+        stream);
+
+    // Check for kernel launch errors
+    TORCH_CHECK(cudaGetLastError() == cudaSuccess, "hardtanh_forward: CUDA kernel launch failed");
+
+    return out;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("avgpool2d_forward", &avgpool2d_forward,
+          "AvgPool2d forward (CUDA)",
+          pybind11::arg("x"),
+          pybind11::arg("kernel_h"),
+          pybind11::arg("kernel_w"),
+          pybind11::arg("stride_h"),
+          pybind11::arg("stride_w"),
+          pybind11::arg("padding_h"),
+          pybind11::arg("padding_w"));
+    m.def("hardtanh_forward", &hardtanh_forward,
+          "Hardtanh forward (CUDA)",
+          pybind11::arg("x"),
+          pybind11::arg("min_val"),
+          pybind11::arg("max_val"));
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,43 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels: int, pool_size: tuple, min_val: float, max_val: float):
+        super().__init__()
+        # Store configuration for custom ops; no learnable parameters to keep state_dict empty
+        self.pool_size = pool_size
+        self.min_val = min_val
+        self.max_val = max_val
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        # Step 1: AvgPool2d with kernel=pool_size, stride=pool_size, padding=0
+        x = cuda_extension.avgpool2d_forward(
+            x,
+            self.pool_size[0],
+            self.pool_size[1],
+            self.pool_size[0],
+            self.pool_size[1],
+            0,
+            0
+        )
+        # Step 2: Hardtanh with min_val and max_val
+        x = cuda_extension.hardtanh_forward(x, self.min_val, self.max_val)
+        return x
+
+    def debug_forward(self, x: torch.Tensor):
+        # Yield each intermediate checkpoint just like reference trace
+        x = cuda_extension.avgpool2d_forward(
+            x,
+            self.pool_size[0],
+            self.pool_size[1],
+            self.pool_size[0],
+            self.pool_size[1],
+            0,
+            0
+        )
+        yield "step_001", x
+        x = cuda_extension.hardtanh_forward(x, self.min_val, self.max_val)
+        yield "step_002", x
+        yield "step_003", x
