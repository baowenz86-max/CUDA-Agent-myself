--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,25 @@
+#include <cuda_runtime.h>
+
+// Elementwise ReLU kernel
+__global__ void relu_kernel(float* data, long long numel) {
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (long long i = idx; i < numel; i += stride) {
+        if (data[i] < 0.0f) data[i] = 0.0f;
+    }
+}
+
+// Launcher for fused Conv+ReLU, called from C++ binding after cuDNN convolution.
+// The binding is responsible for performing the convolution with cuDNN and
+// then calling this function to apply ReLU on the output.
+extern "C" void conv2d_relu_launcher(
+    float* conv_output,
+    long long numel,
+    cudaStream_t stream) {
+    int threads = 256;
+    long long blocks_ll = (numel + threads - 1) / threads;
+    if (blocks_ll > 0) {
+        int blocks = (int)blocks_ll;
+        relu_kernel<<<blocks, threads, 0, stream>>>(conv_output, numel);
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,280 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_runtime.h>
+#include <cudnn.h>
+#include <vector>
+#include <stdexcept>
+#include "../binding_registry.h"
+
+// Declare launcher from custom_ops.cu
+extern "C" void conv2d_relu_launcher(
+    float* conv_output,
+    long long numel,
+    cudaStream_t stream);
+
+// Helper to check CUDA errors
+static void checkCuda(cudaError_t err, const char* msg) {
+    if (err != cudaSuccess) {
+        throw std::runtime_error(std::string(msg) + ": " + cudaGetErrorString(err));
+    }
+}
+
+// Helper to check cuDNN errors
+static void checkCudnn(cudnnStatus_t status, const char* msg) {
+    if (status != CUDNN_STATUS_SUCCESS) {
+        throw std::runtime_error(std::string(msg) + ": " + cudnnGetErrorString(status));
+    }
+}
+
+torch::Tensor conv2d_relu(
+    torch::Tensor input,
+    torch::Tensor weight,
+    c10::optional<torch::Tensor> bias,
+    int64_t stride,
+    int64_t padding,
+    int64_t dilation,
+    int64_t groups) {
+
+    // 输入检查
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(weight.is_cuda(), "weight must be a CUDA tensor");
+    if (bias.has_value() && bias->defined()) {
+        TORCH_CHECK(bias->is_cuda(), "bias must be a CUDA tensor");
+    }
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(weight.dtype() == torch::kFloat32, "weight must be float32");
+    if (bias.has_value() && bias->defined()) {
+        TORCH_CHECK(bias->dtype() == torch::kFloat32, "bias must be float32");
+    }
+    TORCH_CHECK(input.dim() == 4, "input must be 4D (N, C, H, W)");
+    TORCH_CHECK(weight.dim() == 4, "weight must be 4D (out_channels, in_channels/groups, kh, kw)");
+    if (bias.has_value() && bias->defined()) {
+        TORCH_CHECK(bias->dim() == 1, "bias must be 1D");
+    }
+
+    // 确保输入是连续的
+    auto input_contig = input.contiguous();
+    auto weight_contig = weight.contiguous();
+    c10::optional<torch::Tensor> bias_contig;
+    if (bias.has_value() && bias->defined()) {
+        bias_contig = bias->contiguous();
+    }
+
+    int64_t N = input_contig.size(0);
+    int64_t C = input_contig.size(1);
+    int64_t H = input_contig.size(2);
+    int64_t W = input_contig.size(3);
+    int64_t K = weight_contig.size(0); // out_channels
+    int64_t C_per_group = weight_contig.size(1);
+    int64_t R = weight_contig.size(2);
+    int64_t S = weight_contig.size(3);
+
+    TORCH_CHECK(groups > 0, "groups must be positive");
+    TORCH_CHECK(C == groups * C_per_group, "input channels must equal groups * weight in_channels");
+    if (bias.has_value() && bias->defined()) {
+        TORCH_CHECK(bias->numel() == K, "bias size must equal out_channels");
+    }
+
+    // 计算输出尺寸
+    int64_t out_h = (H + 2 * padding - dilation * (R - 1) - 1) / stride + 1;
+    int64_t out_w = (W + 2 * padding - dilation * (S - 1) - 1) / stride + 1;
+    TORCH_CHECK(out_h > 0 && out_w > 0, "invalid output size");
+
+    auto output = torch::empty({N, K, out_h, out_w}, input_contig.options());
+
+    // 获取当前 CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // cuDNN 句柄
+    cudnnHandle_t cudnn_handle;
+    checkCudnn(cudnnCreate(&cudnn_handle), "cudnnCreate failed");
+    checkCudnn(cudnnSetStream(cudnn_handle, stream), "cudnnSetStream failed");
+
+    // 张量描述符
+    cudnnTensorDescriptor_t input_desc, output_desc, bias_desc;
+    cudnnFilterDescriptor_t filter_desc;
+    cudnnConvolutionDescriptor_t conv_desc;
+
+    checkCudnn(cudnnCreateTensorDescriptor(&input_desc), "cudnnCreateTensorDescriptor failed");
+    checkCudnn(cudnnCreateTensorDescriptor(&output_desc), "cudnnCreateTensorDescriptor failed");
+    checkCudnn(cudnnCreateTensorDescriptor(&bias_desc), "cudnnCreateTensorDescriptor failed");
+    checkCudnn(cudnnCreateFilterDescriptor(&filter_desc), "cudnnCreateFilterDescriptor failed");
+    checkCudnn(cudnnCreateConvolutionDescriptor(&conv_desc), "cudnnCreateConvolutionDescriptor failed");
+
+    // 设置张量描述符为 NCHW float32
+    checkCudnn(cudnnSetTensor4dDescriptor(
+        input_desc,
+        CUDNN_TENSOR_NCHW,
+        CUDNN_DATA_FLOAT,
+        static_cast<int>(N),
+        static_cast<int>(C),
+        static_cast<int>(H),
+        static_cast<int>(W)),
+        "cudnnSetTensor4dDescriptor input failed");
+
+    checkCudnn(cudnnSetTensor4dDescriptor(
+        output_desc,
+        CUDNN_TENSOR_NCHW,
+        CUDNN_DATA_FLOAT,
+        static_cast<int>(N),
+        static_cast<int>(K),
+        static_cast<int>(out_h),
+        static_cast<int>(out_w)),
+        "cudnnSetTensor4dDescriptor output failed");
+
+    // 滤波器描述符
+    checkCudnn(cudnnSetFilter4dDescriptor(
+        filter_desc,
+        CUDNN_DATA_FLOAT,
+        CUDNN_TENSOR_NCHW,
+        static_cast<int>(K),
+        static_cast<int>(C_per_group),
+        static_cast<int>(R),
+        static_cast<int>(S)),
+        "cudnnSetFilter4dDescriptor failed");
+
+    // 卷积描述符
+    checkCudnn(cudnnSetConvolution2dDescriptor(
+        conv_desc,
+        static_cast<int>(padding),
+        static_cast<int>(padding),
+        static_cast<int>(stride),
+        static_cast<int>(stride),
+        static_cast<int>(dilation),
+        static_cast<int>(dilation),
+        CUDNN_CROSS_CORRELATION,
+        CUDNN_DATA_FLOAT),
+        "cudnnSetConvolution2dDescriptor failed");
+
+    if (groups > 1) {
+        checkCudnn(cudnnSetConvolutionGroupCount(conv_desc, static_cast<int>(groups)), "cudnnSetConvolutionGroupCount failed");
+    }
+
+    // 选择前向算法
+    cudnnConvolutionFwdAlgo_t algo;
+    constexpr int requested_algo_count = 1;
+    int returned_algo_count = 0;
+    cudnnConvolutionFwdAlgoPerf_t perf_results[requested_algo_count];
+    checkCudnn(cudnnFindConvolutionForwardAlgorithm(
+        cudnn_handle,
+        input_desc,
+        filter_desc,
+        conv_desc,
+        output_desc,
+        requested_algo_count,
+        &returned_algo_count,
+        perf_results),
+        "cudnnFindConvolutionForwardAlgorithm failed");
+    if (returned_algo_count == 0) {
+        throw std::runtime_error("No convolution algorithm found");
+    }
+    algo = perf_results[0].algo;
+
+    // 计算 workspace 大小
+    size_t workspace_size = 0;
+    checkCudnn(cudnnGetConvolutionForwardWorkspaceSize(
+        cudnn_handle,
+        input_desc,
+        filter_desc,
+        conv_desc,
+        output_desc,
+        algo,
+        &workspace_size),
+        "cudnnGetConvolutionForwardWorkspaceSize failed");
+
+    // 分配 workspace
+    void* workspace = nullptr;
+    if (workspace_size > 0) {
+        checkCuda(cudaMalloc(&workspace, workspace_size), "cudaMalloc workspace failed");
+    }
+
+    float alpha = 1.0f, beta = 0.0f;
+
+    // 执行卷积
+    if (bias_contig.has_value() && bias_contig->defined()) {
+        // 带 bias
+        checkCudnn(cudnnSetTensor4dDescriptor(
+            bias_desc,
+            CUDNN_TENSOR_NCHW,
+            CUDNN_DATA_FLOAT,
+            1,
+            static_cast<int>(K),
+            1,
+            1),
+            "cudnnSetTensor4dDescriptor bias failed");
+        checkCudnn(cudnnConvolutionForward(
+            cudnn_handle,
+            &alpha,
+            input_desc,
+            input_contig.data_ptr<float>(),
+            filter_desc,
+            weight_contig.data_ptr<float>(),
+            conv_desc,
+            algo,
+            workspace,
+            workspace_size,
+            &beta,
+            output_desc,
+            output.data_ptr<float>()),
+            "cudnnConvolutionForward (with bias) failed");
+        // 添加 bias（beta=1 或使用 cudnnAddTensor）
+        float bias_alpha = 1.0f, bias_beta = 1.0f;
+        checkCudnn(cudnnAddTensor(
+            cudnn_handle,
+            &bias_alpha,
+            bias_desc,
+            bias_contig->data_ptr<float>(),
+            &bias_beta,
+            output_desc,
+            output.data_ptr<float>()),
+            "cudnnAddTensor bias failed");
+    } else {
+        // 无 bias
+        checkCudnn(cudnnConvolutionForward(
+            cudnn_handle,
+            &alpha,
+            input_desc,
+            input_contig.data_ptr<float>(),
+            filter_desc,
+            weight_contig.data_ptr<float>(),
+            conv_desc,
+            algo,
+            workspace,
+            workspace_size,
+            &beta,
+            output_desc,
+            output.data_ptr<float>()),
+            "cudnnConvolutionForward failed");
+    }
+
+    // 应用 ReLU（调用 .cu 中的 launcher）
+    conv2d_relu_launcher(output.data_ptr<float>(), output.numel(), stream);
+
+    // 清理
+    if (workspace != nullptr) {
+        checkCuda(cudaFree(workspace), "cudaFree workspace failed");
+    }
+    checkCudnn(cudnnDestroyTensorDescriptor(input_desc), "cudnnDestroyTensorDescriptor failed");
+    checkCudnn(cudnnDestroyTensorDescriptor(output_desc), "cudnnDestroyTensorDescriptor failed");
+    checkCudnn(cudnnDestroyTensorDescriptor(bias_desc), "cudnnDestroyTensorDescriptor failed");
+    checkCudnn(cudnnDestroyFilterDescriptor(filter_desc), "cudnnDestroyFilterDescriptor failed");
+    checkCudnn(cudnnDestroyConvolutionDescriptor(conv_desc), "cudnnDestroyConvolutionDescriptor failed");
+    checkCudnn(cudnnDestroy(cudnn_handle), "cudnnDestroy failed");
+
+    return output;
+}
+
+void register_conv2d_relu(pybind11::module& m) {
+    m.def("conv2d_relu", &conv2d_relu,
+          "Conv2d + ReLU using cuDNN",
+          py::arg("input"),
+          py::arg("weight"),
+          py::arg("bias"),
+          py::arg("stride"),
+          py::arg("padding"),
+          py::arg("dilation"),
+          py::arg("groups"));
+}
+
+REGISTER_BINDING(conv2d_relu, register_conv2d_relu);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,27 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, out_channels, kernel_size, stride, padding, dilation, bias, input_dim):
+        super().__init__()
+        self.conv2d = nn.Conv2d(
+            in_channels, out_channels, kernel_size, stride=stride, padding=padding, dilation=dilation, bias=bias
+        )
+        self.input_dim = input_dim
+
+    def forward(self, x):
+        assert x.dim() == self.input_dim, f"Expected input dim to be {self.input_dim}, but got {x.dim()}"
+        return cuda_extension.conv2d_relu(
+            x,
+            self.conv2d.weight,
+            self.conv2d.bias,
+            self.conv2d.stride[0],
+            self.conv2d.padding[0],
+            self.conv2d.dilation[0],
+            self.conv2d.groups,
+        )
+
+    def debug_forward(self, x):
+        out = self.forward(x)
+        return [(None, out)]
