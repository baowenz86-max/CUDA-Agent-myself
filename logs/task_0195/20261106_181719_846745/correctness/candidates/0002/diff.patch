+// 直接卷积的 CUDA kernel，支持分组卷积、bias 和 ReLU
+// 每个线程计算一个输出元素
+__global__ void conv2d_relu_kernel(
+    float* output,
+    const float* input,
+    const float* weight,
+    const float* bias,
+    int64_t N, int64_t C, int64_t H, int64_t W,
+    int64_t K, int64_t R, int64_t S,
