--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,47 @@
+#include <cuda_runtime.h>
+#include <math.h>
+
+// Element-wise absolute value kernel
+__global__ void abs_kernel(const float* __restrict__ input, float* __restrict__ output, long long numel) {
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (; idx < numel; idx += stride) {
+        output[idx] = fabsf(input[idx]);
+    }
+}
+
+// Element-wise power with integer exponent kernel
+__global__ void pow_scalar_int_kernel(const float* __restrict__ input, float* __restrict__ output, long long numel, int exponent) {
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (; idx < numel; idx += stride) {
+        float val = input[idx];
+        float result = 1.0f;
+        int exp = exponent;
+        // handle negative exponent by reciprocal at end if needed, but contract exponent is positive
+        bool neg_exp = exp < 0;
+        if (neg_exp) exp = -exp;
+        for (int i = 0; i < exp; ++i) {
+            result *= val;
+        }
+        if (neg_exp) result = 1.0f / result;
+        output[idx] = result;
+    }
+}
+
+// Launcher for abs_forward
+extern "C" void abs_forward_launcher(const float* input, float* output, long long numel, cudaStream_t stream) {
+    const int block_size = 256;
+    // ensure grid not exceed max, but for numel up to 268M, grid ~1M blocks, which is okay (< 2^31-1)
+    long long grid_size = (numel + block_size - 1) / block_size;
+    if (grid_size > 2147483647LL) grid_size = 2147483647LL; // clamp to int max
+    abs_kernel<<<(int)grid_size, block_size, 0, stream>>>(input, output, numel);
+}
+
+// Launcher for pow_scalar_forward
+extern "C" void pow_scalar_int_launcher(const float* input, float* output, long long numel, int exponent, cudaStream_t stream) {
+    const int block_size = 256;
+    long long grid_size = (numel + block_size - 1) / block_size;
+    if (grid_size > 2147483647LL) grid_size = 2147483647LL;
+    pow_scalar_int_kernel<<<(int)grid_size, block_size, 0, stream>>>(input, output, numel, exponent);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,69 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launcher functions from custom_ops.cu
+extern "C" void abs_forward_launcher(const float* input, float* output, long long numel, cudaStream_t stream);
+extern "C" void pow_scalar_int_launcher(const float* input, float* output, long long numel, int exponent, cudaStream_t stream);
+
+// Wrapper for abs_forward
+torch::Tensor abs_forward(torch::Tensor x) {
+    // Input validation
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+
+    // Allocate output tensor
+    auto output = torch::empty_like(x);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    abs_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        x.numel(),
+        stream
+    );
+
+    return output;
+}
+
+// Wrapper for pow_scalar_forward
+torch::Tensor pow_scalar_forward(torch::Tensor x, int64_t exponent) {
+    // Input validation
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+
+    // Allocate output tensor
+    auto output = torch::empty_like(x);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher (exponent is int, contract expects int64_t but launcher uses int)
+    pow_scalar_int_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        x.numel(),
+        static_cast<int>(exponent),
+        stream
+    );
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("abs_forward", &abs_forward, "Elementwise absolute value",
+          py::arg("x"));
+    m.def("pow_scalar_forward", &pow_scalar_forward, "Elementwise power with scalar exponent",
+          py::arg("x"), py::arg("exponent") = 3);
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,28 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, power_factor: int):
+        super().__init__()
+        self.power_factor = power_factor
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        # Step 1: x = torch.abs(x)
+        x = cuda_extension.abs_forward(x)
+        # Step 2: x = torch.pow(x, self.power_factor)
+        x = cuda_extension.pow_scalar_forward(x, self.power_factor)
+        return x
+
+    def debug_forward(self, *inputs):
+        # inputs is expected to be a single tensor x
+        x = inputs[0]
+        # Step 1
+        abs_x = cuda_extension.abs_forward(x)
+        yield "step_001", abs_x
+        # Step 2
+        pow_x = cuda_extension.pow_scalar_forward(abs_x, self.power_factor)
+        yield "step_002", pow_x
+        # Step 3: final return
+        yield "step_003", pow_x
