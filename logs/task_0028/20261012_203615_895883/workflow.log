height = 512
width = 256
kernel_size = (3, 5)
dilation = (2, 1)
padding = (1, 2)


def get_inputs():
    x = torch.randn(batch_size, in_channels, height, width)
    return [x]


def get_init_inputs():
    return [kernel_size, dilation, padding, in_channels * kernel_size[0] * kernel_size[1]]

