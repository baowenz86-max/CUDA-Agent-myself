+        cudaStreamSynchronize(stream);
+    } else if (x.device().is_cpu()) {
+        std::memcpy(output.data_ptr<float>(), x.data_ptr<float>(), x.numel() * sizeof(float));
+    } else {
+        TORCH_CHECK(false, "Unsupported input device");
+    }
+
     return output;
