{
  "operators": [
    {
      "name": "custom_abs",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference step",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "对应参考语句 torch.abs(x)，逐元素计算绝对值，保持输入 shape、dtype、device、layout 不变。",
        "无额外 bias、广播或轴操作。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = x.to(self.device)",
      "semantics": [
        "将输入张量移动到 self.device；参考中 device 为 'cpu'，不变形，不改 dtype。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.abs(x)",
      "semantics": [
        "逐元素计算绝对值，保持 shape、dtype、device 不变。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回最终的绝对值张量。"
      ]
    }
  ]
}