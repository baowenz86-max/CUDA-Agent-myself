        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[]"
      },
      "semantics": [
        "对应参考语句：loss = F.smooth_l1_loss(cat_output, self.loss_target)。",
        "计算 smooth L1 loss，reduction='mean'（默认）。",
        "公式：如果 |x-y| < beta，则 0.5 * (x-y)^2 / beta，否则 |x-y| - 0.5 * beta；对所有元素求平均，返回标量张量。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "attn_output, attn_output_weights = self.multihead_attn(query, key, value)",
      "semantics": [
        "实际计算语义：输入投影 (query, key, value) -> q, k, v；reshape 为 [batch, num_heads, seq_len, head_dim]；计算注意力分数并 softmax；加权 value；reshape 回 [batch, seq_len, embed_dim]；输出投影；返回 attn_output 和平均注意力权重 attn_output_weights。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "cat_output = torch.cat([attn_output, query], dim=2)",
      "semantics": [
        "实际计算语义：在最后一维拼接 attn_output 和原始 query，形状 [batch, seq_len, 2*embed_dim]。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "loss = F.smooth_l1_loss(cat_output, self.loss_target)",
      "semantics": [
        "实际计算语义：对 cat_output 和 loss_target 计算 smooth L1 loss，reduction='mean'，返回标量。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return (cat_output, attn_output_weights, loss)",
      "semantics": [
        "实际计算语义：返回元组 (cat_output, attn_output_weights, loss)。"
      ]
    }
