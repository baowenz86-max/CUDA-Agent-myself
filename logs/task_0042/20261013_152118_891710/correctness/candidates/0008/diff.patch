+// Helper: softmax over a row of length L, with max subtraction for stability
+__device__ void softmax_row(float* row, int L) {
+    float max_val = -FLT_MAX;
+    for (int i = 0; i < L; ++i) {
+        if (row[i] > max_val) max_val = row[i];
+    }
+    float sum = 0.0f;
+    for (int i = 0; i < L; ++i) {
+        row[i] = __expf(row[i] - max_val);
+        sum += row[i];
+    }
+    for (int i = 0; i < L; ++i) {
+        row[i] /= sum;
+    }
