{
  "operators": [
    {
      "name": "mha_forward",
      "parameters": [
        {
          "name": "query",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, L, E]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "key",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, L, E]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "value",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, L, E]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "in_proj_weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[3*E, E]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "in_proj_bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[3*E]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "out_proj_weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[E, E]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "out_proj_bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[E]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "num_heads",
          "kind": "int",
          "default": 8,
          "optional": false,
          "nullable": false
        },
        {
          "name": "batch_first",
          "kind": "bool",
          "default": true,
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tuple",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "attn_output: [B, L, E], attn_output_weights: [B, L, L]"
      },
      "semantics": [
        "Implements forward pass of torch.nn.MultiheadAttention with batch_first=True and default arguments (need_weights=True, average_attn_weights=True, no masks, no causal).",
        "Computes input projection: q = query @ in_proj_weight[:E].T + in_proj_bias[:E], k = key @ in_proj_weight[E:2E].T + in_proj_bias[E:2E], v = value @ in_proj_weight[2E:].T + in_proj_bias[2E:].",
        "Reshapes q,k,v to [B, num_heads, L, head_dim] and performs scaled dot-product attention: attn = softmax(q @ k.T / sqrt(head_dim)) @ v.",
        "Concatenates heads and applies output projection: attn_output = attention_output @ out_proj_weight.T + out_proj_bias.",
        "Computes average attention weights across heads, shape [B, L, L].",
        "Returns (attn_output, attn_output_weights)."
      ]
    },
    {
      "name": "concat_dim2",
      "parameters": [
        {
          "name": "tensor1",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, L, D1]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "tensor2",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, L, D2]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[B, L, D1+D2]"
      },
      "semantics": [
        "Concatenates two tensors along dimension 2 (the last dimension).",
        "Preserves order: elements from tensor1 followed by tensor2.",
        "Returns a new contiguous tensor."
      ]
    },
    {
      "name": "smooth_l1_loss",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, L, D]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "target",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, L, D]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "scalar (0-dim)"
      },
      "semantics": [
        "Computes F.smooth_l1_loss with default reduction='mean' and beta=1.0.",
        "For each element: if |input-target| < beta, loss = 0.5*(input-target)^2 / beta, else loss = |input-target| - 0.5*beta.",
        "Returns the mean over all elements."
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "attn_output, attn_output_weights = self.multihead_attn(query, key, value)",
      "semantics": [
        "Computes multihead attention and returns output tensor [16,1024,256] and average attention weights [16,1024,1024]."
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "cat_output = torch.cat([attn_output, query], dim=2)",
      "semantics": [
        "Concatenates attn_output and query along dimension 2 to produce [16,1024,512]."
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "loss = F.smooth_l1_loss(cat_output, self.loss_target)",
      "semantics": [
        "Computes mean smooth L1 loss between cat_output and loss_target, returns scalar loss."
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return (cat_output, attn_output_weights, loss)",
      "semantics": [
        "Returns tuple containing cat_output, attn_output_weights, loss."
      ]
    }
  ]
}