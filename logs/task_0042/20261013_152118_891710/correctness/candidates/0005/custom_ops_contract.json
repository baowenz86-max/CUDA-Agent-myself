        "shape": "[batch_size, seq_len, 2 * embed_dim]"
      },
      "semantics": [
        "实现参考 torch.cat([attn_output, query], dim=2)，沿维度2拼接两个形状相同的张量。",
        "输出张量的第2维为输入第2维的两倍。",
        "拼接顺序：前半部分为 a (attn_output)，后半部分为 b (query)。",
        "支持任意 strides，kernel 需按实际 strides 读取输入并写入输出。"
      ]
    },
    {
      "name": "smooth_l1_loss_forward",
      "parameters": [
        {
          "name": "input",
