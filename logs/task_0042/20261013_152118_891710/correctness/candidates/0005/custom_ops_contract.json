          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[]",
        "scalar": true
      },
      "semantics": [
        "实现参考 F.smooth_l1_loss(cat_output, self.loss_target) 的计算。",
        "默认 reduction='mean'，计算所有元素的 smooth L1 loss 的平均值。",
        "smooth L1 loss 公式：if |x - y| < 1, 0.5*(x-y)^2, else |x-y| - 0.5。",
        "输出为标量张量，形状为 []。",
        "支持任意 strides。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "attn_output, attn_output_weights = self.multihead_attn(query, key, value)",
      "semantics": [
        "完整执行 MultiheadAttention 前向计算，返回 attn_output [16, 1024, 256] 和 attn_output_weights [16, 1024, 1024]。",
        "注意参考代码未显式指定 need_weights，默认 True，因此返回权重。",
        "batch_first=True，输入输出布局为 [batch, seq, embed]。"
