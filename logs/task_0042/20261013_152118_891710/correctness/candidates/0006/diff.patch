+// Cat kernel: concatenate along dim=2
+__global__ void cat_kernel(
+    const float* __restrict__ a,
+    const float* __restrict__ b,
+    float* __restrict__ out,
+    int batch_size,
+    int seq_len,
+    int embed_dim
+) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = batch_size * seq_len * (2 * embed_dim);
+    if (idx >= total) return;
+    int col = idx % (2 * embed_dim);
+    int s = (idx / (2 * embed_dim)) % seq_len;
+    int b = idx / (seq_len * (2 * embed_dim));
+    if (col < embed_dim) {
+        // from a
+        int a_idx = b * seq_len * embed_dim + s * embed_dim + col;
+        out[idx] = a[a_idx];
+    } else {
+        // from b
+        int b_idx = b * seq_len * embed_dim + s * embed_dim + (col - embed_dim);
+        out[idx] = b[b_idx];
+    }
 }
 
