+// Smooth L1 loss kernel: compute mean over all elements
+__global__ void smooth_l1_loss_kernel(
+    const float* __restrict__ input,
+    const float* __restrict__ target,
+    float* __restrict__ out,
+    int64_t numel
+) {
+    // One thread computes partial sum, then reduce? We can use atomicAdd on a zero-initialized scalar.
+    // But out is scalar; we'll use atomicAdd to accumulate per-element losses.
+    // Each thread handles a strided loop.
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+    float sum = 0.0f;
+    for (int64_t i = idx; i < numel; i += stride) {
+        float diff = input[i] - target[i];
+        float abs_diff = fabsf(diff);
+        float loss;
+        if (abs_diff < 1.0f) {
+            loss = 0.5f * diff * diff;
+        } else {
+            loss = abs_diff - 0.5f;
+        }
+        sum += loss;
+    }
+    // Atomic add to global scalar (out should be zero-initialized)
+    if (sum != 0.0f) {
+        atomicAdd(out, sum);
+    }
 }
 
