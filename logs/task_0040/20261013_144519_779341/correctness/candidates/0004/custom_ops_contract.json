  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.conv_transpose1d(x)",
      "semantics": [
        "ConvTranspose1d forward with stride=2, padding=1, output_padding=1, kernel_size=3",
        "Input shape [512, 8, 2048] -> Output shape [512, 16, 4096]",
        "Bias is included from conv_transpose1d.bias"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = x + self.bias",
      "semantics": [
        "Add bias of shape [16, 1] broadcast over length dimension",
        "Result shape remains [512, 16, 4096]"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = torch.roll(x, shifts=1, dims=2)",
      "semantics": [
        "Roll along the last dimension by 1: last element moves to front",
        "Shape unchanged"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "x = x.view(x.size(0), -1)",
      "semantics": [
        "Flatten to [batch, 16*4096=65536]",
        "Shape [512, 65536]"
      ]
    },
    {
      "checkpoint": "step_005",
      "source": "x = F.linear(x, self.linear.weight, self.linear.bias)",
      "semantics": [
        "Linear transformation: x @ weight.T + bias",
        "Shape [512, 10]"
      ]
    },
    {
      "checkpoint": "step_006",
      "source": "return x",
      "semantics": [
        "Return final output tensor [512, 10]"
      ]
    }
  ]
