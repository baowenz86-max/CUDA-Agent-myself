      "semantics": [
        "Performs linear transformation y = x * W^T + b using cuBLAS GEMM.",
        "Matches F.linear exactly: input [batch, in_features], weight [out_features, in_features], bias [out_features].",
        "If bias is None, no bias added.",
        "Output is float32 CUDA tensor of shape [batch, out_features], contiguous."
      ]
    }
