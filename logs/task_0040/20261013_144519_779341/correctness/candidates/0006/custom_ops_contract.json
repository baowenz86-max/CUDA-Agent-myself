        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, out_channels * Lout]"
      },
      "semantics": [
        "Flattens input to shape [batch, out_channels * Lout] exactly as x.view(x.size(0), -1).",
        "This is a view operation; in practice we return a tensor with same data and new shape.",
        "Output is contiguous float32 tensor of shape [batch, num_features] where num_features = out_channels * Lout."
      ]
    },
    {
      "name": "linear_cublas",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
