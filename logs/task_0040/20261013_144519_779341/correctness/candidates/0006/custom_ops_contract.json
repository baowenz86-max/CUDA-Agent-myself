      "semantics": [
        "Performs 1D transposed convolution (deconvolution) using cuDNN.",
        "Matches nn.ConvTranspose1d forward exactly: uses weight of shape [in_channels, out_channels, kernel_size], bias of shape [out_channels] (may be None).",
        "Output length Lout = (length - 1)*stride - 2*padding + kernel_size + output_padding.",
        "Stride, padding, output_padding are integers; here stride=2, padding=1, output_padding=1, kernel_size=3.",
        "Input and output are float32 CUDA tensors; output contiguous with default stride."
      ]
    },
    {
      "name": "add_bias_broadcast",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, out_channels, Lout]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels, 1]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "Adds bias of shape [out_channels, 1] to input of shape [batch, out_channels, Lout].",
        "Broadcasting follows PyTorch semantics: bias is expanded along dim 1 (channels) and dim 2 (length).",
        "Output is a new tensor with same shape as input, float32, contiguous."
      ]
    },
    {
      "name": "roll_dim2",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, out_channels, Lout]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "shift",
          "kind": "int",
          "dtype": null,
          "device": null,
          "shape": null,
          "layout": null,
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "Performs torch.roll(input, shifts=shift, dims=2) along the last dimension.",
        "Elements are shifted circularly: new[i,j,k] = old[i,j,(k-shift) mod Lout] for positive shift.",
        "Here shift=1, so element at index k moves to index k+1 (mod Lout).",
        "Output is a new tensor with same shape, float32, contiguous."
      ]
    },
    {
      "name": "view_flatten",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, out_channels, Lout]",
          "layout": "supports strides",
          "nullable": false,
