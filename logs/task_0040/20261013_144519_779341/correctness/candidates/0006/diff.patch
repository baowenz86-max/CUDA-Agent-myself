+        for (int64_t i = 0; i < batch; ++i) {
+            float* row = output.data_ptr<float>() + i * out_features;
+            CUBLAS_CHECK(cublasSaxpy(handle, out_features, &alpha, bias.data_ptr<float>(), 1, row, 1));
