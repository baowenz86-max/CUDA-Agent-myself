{
  "operators": [
    {
      "name": "conv_transpose1d_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference input [N, C_in, L]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C_in, C_out, kernel_size]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C_out]",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        },
        {
          "name": "stride",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "padding",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "output_padding",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "groups",
          "kind": "int",
          "default": 1,
          "optional": true,
          "nullable": false
        },
        {
          "name": "dilation",
          "kind": "int",
          "default": 1,
          "optional": true,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C_out, L_out]"
      },
      "semantics": [
        "执行与 nn.ConvTranspose1d 相同的转置卷积：先对输入时间维做 stride 和 padding 的隐式插值，再与翻转后的权重做普通卷积；bias 若不为 None 则按通道加。",
        "对应参考语句 `x = self.conv_transpose1d(x)`，输出长度 L_out = (L_in - 1)*stride - 2*padding + kernel_size + output_padding。",
        "权重形状 [in_channels, out_channels, kernel_size]，内部按 cuDNN 或等价实现，保持参考数值结果。"
      ]
    },
    {
      "name": "channel_add",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, ...]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C, 1] 或可广播到通道维的形状",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "执行 `x = x + self.bias`，其中 self.bias 形状为 [out_channels, 1]，沿通道维广播到 x 的 [N,C,L]。",
        "仅做 element-wise 加法，不改变 shape 和 stride。"
      ]
    },
    {
      "name": "roll_last_dim",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, L]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "shift",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "执行 `torch.roll(x, shifts=shift, dims=2)`：沿最后一维循环移位。",
        "元素索引 i 的新值取自原索引 (i - shift) mod L。"
      ]
    },
    {
      "name": "flatten_to_2d",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, L]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C*L]"
      },
      "semantics": [
        "执行 `x.view(x.size(0), -1)`，保持底层数据顺序不变，仅改变形状为 [N, C*L]。",
        "不复制数据，返回视图或等价的连续张量。"
      ]
    },
    {
      "name": "linear_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, in_features]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_features, in_features]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_features]",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, out_features]"
      },
      "semantics": [
        "执行 `F.linear(x, self.linear.weight, self.linear.bias)`：y = x @ weight.T + bias。",
        "bias 若为 None 则不加。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.conv_transpose1d(x)",
      "semantics": [
        "ConvTranspose1d 前向，包含卷积 bias；输出形状 [512,16,4096]，dtype float32。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = x + self.bias",
      "semantics": [
        "与形状 [16,1] 的额外 bias 广播相加，保持 [512,16,4096]。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = torch.roll(x, shifts=1, dims=2)",
      "semantics": [
        "沿最后一维循环右移 1 位。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "x = x.view(x.size(0), -1)",
      "semantics": [
        "展平为 [512, 65536]。"
      ]
    },
    {
      "checkpoint": "step_005",
      "source": "x = F.linear(x, self.linear.weight, self.linear.bias)",
      "semantics": [
        "线性变换得到 [512, 10]。"
      ]
    },
    {
      "checkpoint": "step_006",
      "source": "return x",
      "semantics": [
        "最终返回线性输出。"
      ]
    }
  ]
}