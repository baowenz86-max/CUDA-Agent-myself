{
  "operators": [
    {
      "name": "conv_transpose1d_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, in_channels, length]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[in_channels, out_channels, kernel_size]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "stride",
          "kind": "int",
          "default": 2,
          "optional": false
        },
        {
          "name": "padding",
          "kind": "int",
          "default": 1,
          "optional": false
        },
        {
          "name": "output_padding",
          "kind": "int",
          "default": 1,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, out_channels, length_output]"
      },
      "semantics": [
        "执行 ConvTranspose1d，与参考 nn.ConvTranspose1d 一致，使用 cuDNN，参数 stride、padding、output_padding 由调用传入。",
        "输入与权重必须为 CUDA float32 张量；支持任意 stride 布局，实现时按需连续化。",
        "输出 shape 按 ConvTranspose1d 公式计算：(length - 1) * stride - 2 * padding + kernel_size + output_padding。",
        "bias 为可空张量，存在时加到每个输出通道。"
      ]
    },
    {
      "name": "bias_add_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, out_channels, length_output]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels, 1]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对输入张量的每个 (batch, channel, spatial) 位置加上 bias[channel, 0]，实现参考 x + self.bias 的广播语义。"
      ]
    },
    {
      "name": "roll_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, out_channels, length_output]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "shifts",
          "kind": "int",
          "default": 1,
          "optional": false
        },
        {
          "name": "dims",
          "kind": "int",
          "default": 2,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "执行 torch.roll(x, shifts=1, dims=2)，沿维度 2 循环右移 1 位。"
      ]
    },
    {
      "name": "linear_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, num_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_features, num_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_features]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, out_features]"
      },
      "semantics": [
        "执行 F.linear(x, weight, bias)，即 x @ weight.T + bias（使用 cuBLAS GEMM）。",
        "输入 x 形状 [batch_size, num_features]，权重形状 [out_features, num_features]，输出 [batch_size, out_features]。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.conv_transpose1d(x)",
      "semantics": [
        "ConvTranspose1d 前向，输出 shape 为 [512, 16, 4096]，dtype float32，device cuda:0。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = x + self.bias",
      "semantics": [
        "加上可广播 bias [16,1]，对每个 batch 和空间位置按通道加偏置。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = torch.roll(x, shifts=1, dims=2)",
      "semantics": [
        "沿最后一个维度循环右移 1 位。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "x = x.view(x.size(0), -1)",
      "semantics": [
        "将 [512,16,4096] 展平为 [512,65536]，不复制数据。"
      ]
    },
    {
      "checkpoint": "step_005",
      "source": "x = F.linear(x, self.linear.weight, self.linear.bias)",
      "semantics": [
        "线性变换，输出 [512,10]，带偏置。"
      ]
    },
    {
      "checkpoint": "step_006",
      "source": "return x",
      "semantics": [
        "返回最终输出 [512,10]。"
      ]
    }
  ]
}