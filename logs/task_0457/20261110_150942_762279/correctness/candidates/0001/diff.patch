+// Kernel to copy x[:, t, :] to column-major x_col (shape input_dim x batch)
+__global__ void copy_x_to_col(const float* __restrict__ x, float* __restrict__ x_col,
+                             int batch, int seq_len, int input_dim, int t) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = batch * input_dim;
+    if (idx >= total) return;
+    int b = idx / input_dim;
+    int j = idx % input_dim;
+    x_col[j * batch + b] = x[(size_t)b * seq_len * input_dim + (size_t)t * input_dim + j];
+}
+
+// Kernel to copy output[:, t, :] (row-major) to x_col column-major (for layer >0)
+__global__ void copy_output_to_col(const float* __restrict__ output, float* __restrict__ x_col,
+                                  int batch, int seq_len, int hidden, int t) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = batch * hidden;
+    if (idx >= total) return;
+    int b = idx / hidden;
+    int j = idx % hidden;
+    x_col[j * batch + b] = output[(size_t)b * seq_len * hidden + (size_t)t * hidden + j];
+}
