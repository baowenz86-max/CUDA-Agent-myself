+// Kernel to elementwise compute gates, update c and h, and write output.
+// gates_pre_col: shape 4H x batch, column-major.
+// bias: length 4H.
+// c_col: hidden x batch, column-major, current cell state.
+// h_col: hidden x batch, column-major, current hidden state.
+// c_col_next, h_col_next: same layout for next time.
+// output: [batch, seq_len, hidden] row-major.
+// t: current timestep.
+__global__ void lstm_cell_elementwise(const float* __restrict__ gates_pre_col,
+                                      const float* __restrict__ bias,
+                                      const float* __restrict__ c_col,
+                                      const float* __restrict__ h_col,
+                                      float* __restrict__ c_col_next,
+                                      float* __restrict__ h_col_next,
+                                      float* __restrict__ output,
+                                      int batch, int seq_len, int hidden, int t) {
+    int b = blockIdx.x;
+    int j = threadIdx.x;
+    if (b >= batch || j >= hidden) return;
+    int H = hidden;
+    // indices in gates_pre_col: row j (i gate), H+j (f), 2H+j (g), 3H+j (o)
+    int col = b;
+    float gi = gates_pre_col[(size_t)j * batch + col] + bias[j];
+    float gf = gates_pre_col[(size_t)(H + j) * batch + col] + bias[H + j];
+    float gg = gates_pre_col[(size_t)(2 * H + j) * batch + col] + bias[2 * H + j];
+    float go = gates_pre_col[(size_t)(3 * H + j) * batch + col] + bias[3 * H + j];
+
+    float i = 1.0f / (1.0f + expf(-gi));
+    float f = 1.0f / (1.0f + expf(-gf));
+    float g = tanhf(gg);
+    float o = 1.0f / (1.0f + expf(-go));
+
+    float c_prev = c_col[(size_t)j * batch + b];
+    float h_prev = h_col[(size_t)j * batch + b];
+    float c_new = f * c_prev + i * g;
+    float h_new = o * tanhf(c_new);
+
+    c_col_next[(size_t)j * batch + b] = c_new;
+    h_col_next[(size_t)j * batch + b] = h_new;
+
+    // write to output tensor: output[b, t, j]
+    output[(size_t)b * seq_len * hidden + (size_t)t * hidden + j] = h_new;
+}
+
+// Kernel to transpose weight matrix from row-major [rows, cols] to column-major [rows, cols]? 
+// For GEMM, we need W_col of shape (4H, input_dim) in column-major. Since input weight is row-major [4H, input_dim], to convert to column-major we need to write W_col[j][i] = W_row[i][j]? Actually column-major storage means element (i,j) is at offset j*lda + i, where i is row (0..4H-1), j col (0..input_dim-1). If we have row-major W_row of shape (4H, input_dim), element (i,j) at offset i*input_dim + j. To get column-major with same logical dimensions, we need to copy such that W_col[j*4H + i] = W_row[i*input_dim + j]. This is a transpose.
+__global__ void transpose_weight(const float* __restrict__ src, float* __restrict__ dst,
+                                int rows, int cols) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = rows * cols;
+    if (idx >= total) return;
+    int i = idx / cols;
+    int j = idx % cols;
+    dst[(size_t)j * rows + i] = src[(size_t)i * cols + j];
+}
+
+// Kernel to copy column-major state (hidden x batch) to row-major hidden/cell output slice.
+// For layer l, we write hidden[l, b, j] = h_col[j*batch + b], row-major layout of hidden tensor is [num_layers, batch, hidden].
+// Hidden tensor pointer is row-major: offset = l * batch * hidden + b * hidden + j.
+__global__ void copy_state_to_output(const float* __restrict__ state_col, float* __restrict__ state_out,
+                                     int batch, int hidden, int layer, int num_layers) {
+    int b = blockIdx.x;
+    int j = threadIdx.x;
+    if (b >= batch || j >= hidden) return;
+    int val = state_col[(size_t)j * batch + b];
+    state_out[(size_t)layer * batch * hidden + (size_t)b * hidden + j] = val;
+}
+
+// cat_hidden_cell kernel: output[num_layers, 2*batch, hidden], first batch dimension from hidden, second from cell.
+// hidden and cell are row-major [num_layers, batch, hidden].
+__global__ void cat_hidden_cell_kernel(const float* __restrict__ hidden,
+                                       const float* __restrict__ cell,
+                                       float* __restrict__ output,
+                                       int num_layers, int batch, int hidden) {
+    int b = blockIdx.x;
+    int l = blockIdx.y;
+    int j = threadIdx.x;
+    if (b >= batch || l >= num_layers || j >= hidden) return;
+    int out_b = b;
+    output[(size_t)l * (2 * batch) * hidden + (size_t)out_b * hidden + j] = hidden[(size_t)l * batch * hidden + (size_t)b * hidden + j];
+    output[(size_t)l * (2 * batch) * hidden + (size_t)(batch + out_b) * hidden + j] = cell[(size_t)l * batch * hidden + (size_t)b * hidden + j];
+}
+
+// Launcher for LSTM forward.
+extern "C" void lstm_forward_launcher(
+    const float* x,           // [batch, seq_len, input_size]
+    const float* weight_ih_l0, // [4H, input_size]
+    const float* weight_hh_l0, // [4H, H]
+    const float* bias_ih_l0,   // [4H]
+    const float* bias_hh_l0,   // [4H]
+    const float* weight_ih_l1, // [4H, H]
+    const float* weight_hh_l1, // [4H, H]
+    const float* bias_ih_l1,   // [4H]
+    const float* bias_hh_l1,   // [4H]
+    int64_t hidden_size,
+    int64_t num_layers,       // should be 2
+    float* output,            // [batch, seq_len, hidden_size]
+    float* hidden_out,        // [num_layers, batch, hidden_size]
+    float* cell_out,          // [num_layers, batch, hidden_size]
+    int64_t batch_size,
+    int64_t seq_len,
+    int64_t input_size,
+    cudaStream_t stream
+) {
+    // Only support num_layers=2 as per contract.
+    int H = (int)hidden_size;
+    int B = (int)batch_size;
+    int S = (int)seq_len;
+    int D0 = (int)input_size;
+    int L = (int)num_layers;
+
+    // Create cuBLAS handle (static to avoid repeated creation)
+    static cublasHandle_t handle = nullptr;
+    if (!handle) {
+        cublasCreate(&handle);
+    }
+    cublasSetStream(handle, stream);
+
+    // Allocate temporary buffers
+    float *d_x_col, *d_h_col, *d_c_col, *d_h_col_next, *d_c_col_next, *d_gates_pre;
+    float *d_W_ih_col, *d_W_hh_col;
+    cudaMalloc(&d_x_col, sizeof(float) * D0 * B); // max input dim for layer0, for layer1 we'll allocate H*B
+    cudaMalloc(&d_h_col, sizeof(float) * H * B);
+    cudaMalloc(&d_c_col, sizeof(float) * H * B);
+    cudaMalloc(&d_h_col_next, sizeof(float) * H * B);
+    cudaMalloc(&d_c_col_next, sizeof(float) * H * B);
+    cudaMalloc(&d_gates_pre, sizeof(float) * (4 * H) * B);
+    cudaMalloc(&d_W_ih_col, sizeof(float) * (4 * H) * D0); // for layer0
+    cudaMalloc(&d_W_hh_col, sizeof(float) * (4 * H) * H);
+
+    // Initialize h and c to zero for first layer
+    cudaMemsetAsync(d_h_col, 0, sizeof(float) * H * B, stream);
+    cudaMemsetAsync(d_c_col, 0, sizeof(float) * H * B, stream);
+
+    // Set cuBLAS parameters
+    float alpha = 1.0f, beta = 0.0f;
+
+    // Loop over layers
+    for (int l = 0; l < L; ++l) {
+        int D = (l == 0) ? D0 : H;
+        const float* w_ih = (l == 0) ? weight_ih_l0 : weight_ih_l1;
+        const float* w_hh = (l == 0) ? weight_hh_l0 : weight_hh_l1;
+        const float* b_ih = (l == 0) ? bias_ih_l0 : bias_ih_l1;
+        const float* b_hh = (l == 0) ? bias_hh_l0 : bias_hh_l1;
+
+        // Transpose weights to column-major format
+        if (l == 0) {
+            int threads = 256;
+            int blocks = ((4 * H * D) + threads - 1) / threads;
+            transpose_weight<<<blocks, threads, 0, stream>>>(w_ih, d_W_ih_col, 4 * H, D);
+        } else {
+            // reuse d_W_ih_col with size (4H, H)
+            int threads = 256;
+            int blocks = ((4 * H * D) + threads - 1) / threads;
+            transpose_weight<<<blocks, threads, 0, stream>>>(w_ih, d_W_ih_col, 4 * H, D);
+        }
+        int threads = 256;
+        int blocks = ((4 * H * H) + threads - 1) / threads;
+        transpose_weight<<<blocks, threads, 0, stream>>>(w_hh, d_W_hh_col, 4 * H, H);
+
+        // For each timestep
+        for (int t = 0; t < S; ++t) {
+            // Copy input for current timestep to x_col
+            if (l == 0) {
+                int total = B * D;
+                int t_threads = 256;
+                int t_blocks = (total + t_threads - 1) / t_threads;
+                copy_x_to_col<<<t_blocks, t_threads, 0, stream>>>(x, d_x_col, B, S, D, t);
+            } else {
+                // input is output of previous layer
+                int total = B * H;
+                int t_threads = 256;
+                int t_blocks = (total + t_threads - 1) / t_threads;
+                copy_output_to_col<<<t_blocks, t_threads, 0, stream>>>(output, d_x_col, B, S, H, t);
+            }
+
+            // GEMM: gates_pre = W_ih_col * x_col (4H x B)
+            // Need to allocate gates_pre as (4H x B) column-major.
+            cublasSgemm(handle, CUBLAS_OP_N, CUBLAS_OP_N,
+                        4 * H, B, D,
+                        &alpha, d_W_ih_col, 4 * H,
+                        d_x_col, D,
+                        &beta, d_gates_pre, 4 * H);
+
+            // GEMM: gates_pre += W_hh_col * h_col
+            beta = 1.0f;
+            cublasSgemm(handle, CUBLAS_OP_N, CUBLAS_OP_N,
+                        4 * H, B, H,
+                        &alpha, d_W_hh_col, 4 * H,
+                        d_h_col, H,
+                        &beta, d_gates_pre, 4 * H);
+            beta = 0.0f; // reset for next iteration start
+
+            // Add biases in elementwise kernel; update c,h, write output.
+            // Launch kernel with grid = B, threads = H (or more for alignment).
+            int cell_threads = H;
+            int cell_blocks = B;
+            // Ensure threads >= 32? hidden=50, so 50 threads is fine but not a multiple of warp, but we can launch 64 threads and check bound in kernel.
+            if (cell_threads < 64) cell_threads = 64;
+            lstm_cell_elementwise<<<cell_blocks, cell_threads, 0, stream>>>(
+                d_gates_pre, b_ih, d_c_col, d_h_col,
+                d_c_col_next, d_h_col_next, output,
+                B, S, H, t);
+
+            // Swap h and c pointers for next timestep
+            float* tmp = d_h_col; d_h_col = d_h_col_next; d_h_col_next = tmp;
+            tmp = d_c_col; d_c_col = d_c_col_next; d_c_col_next = tmp;
+        }
+
+        // After finishing layer, copy final h and c to hidden_out and cell_out rows for this layer.
+        int state_threads = (H < 64) ? 64 : H;
+        copy_state_to_output<<<B, state_threads, 0, stream>>>(d_h_col, hidden_out, B, H, l, L);
+        copy_state_to_output<<<B, state_threads, 0, stream>>>(d_c_col, cell_out, B, H, l, L);
+
+        // Reset h and c for next layer (if any). We can reuse by setting to zero.
+        if (l < L - 1) {
+            cudaMemsetAsync(d_h_col, 0, sizeof(float) * H * B, stream);
+            cudaMemsetAsync(d_c_col, 0, sizeof(float) * H * B, stream);
+        }
+    }
+
+    // Free temporary buffers
+    cudaFree(d_x_col);
+    cudaFree(d_h_col);
+    cudaFree(d_c_col);
+    cudaFree(d_h_col_next);
+    cudaFree(d_c_col_next);
+    cudaFree(d_gates_pre);
+    cudaFree(d_W_ih_col);
+    cudaFree(d_W_hh_col);
+
+    // Check errors
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // Handle error? Binding layer can check; but we can print.
+        fprintf(stderr, "CUDA error in lstm_forward: %s\n", cudaGetErrorString(err));
+    }
+}
+
+// Launcher for cat_hidden_cell.
+extern "C" void cat_hidden_cell_launcher(
+    const float* hidden, // [num_layers, batch, hidden]
+    const float* cell,   // [num_layers, batch, hidden]
+    float* output,       // [num_layers, 2*batch, hidden]
+    int64_t num_layers,
+    int64_t batch_size,
+    int64_t hidden_size,
+    cudaStream_t stream
+) {
+    int L = (int)num_layers;
+    int B = (int)batch_size;
+    int H = (int)hidden_size;
+    dim3 grid(B, L);
+    int threads = (H < 64) ? 64 : H;
+    cat_hidden_cell_kernel<<<grid, threads, 0, stream>>>(hidden, cell, output, L, B, H);
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        fprintf(stderr, "CUDA error in cat_hidden_cell: %s\n", cudaGetErrorString(err));
+    }
+}
