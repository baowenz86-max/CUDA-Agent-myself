          "name": "dim",
          "kind": "int",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "concatenated shape of tensor_a and tensor_b along dim"
      },
      "semantics": [
        "沿指定维度 dim 拼接两个输入张量，等同于 torch.cat((tensor_a, tensor_b), dim=dim)。",
        "在本任务中 dim=1，输入形状均为 [num_layers, batch_size, hidden_size]，输出形状为 [num_layers, 2*batch_size, hidden_size]。",
        "输出为连续张量，保持与 torch.cat 一致的内存布局和数值。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "outputs, (hidden, cell) = self.lstm(x)",
      "semantics": [
        "调用 nn.LSTM 的前向，输入 x 形状 [16, 1024, 100]，返回 outputs 形状 [16, 1024, 50]，hidden 和 cell 形状 [2, 16, 50]。",
        "实际计算为两层 LSTM，无 dropout，batch_first=True。",
        "输出已在 CUDA 设备上。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "return torch.cat((hidden, cell), dim=1)",
      "semantics": [
        "将 hidden 和 cell 沿 dim=1 拼接，得到形状 [2, 32, 50] 的张量。",
        "拼接顺序为 hidden 在前，cell 在后。",
        "结果作为 forward 的返回值。"
      ]
    }
