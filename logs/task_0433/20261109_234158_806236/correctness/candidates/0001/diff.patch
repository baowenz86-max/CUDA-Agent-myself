+// custom_ops.cu - CUDA kernels for custom_unfold_forward
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// Unfold kernel: output[n, c*K + ki, i*outW + j] = input[n, c, i*strideH + ki*dilationH, j*strideW + kj*dilationW]
+// K = kernelH * kernelW
+template <typename T>
+__global__ void unfold_forward_kernel(
+    const T* __restrict__ input,
+    T* __restrict__ output,
+    int64_t N,
+    int64_t C,
+    int64_t H,
+    int64_t W,
+    int64_t kernelH,
+    int64_t kernelW,
+    int64_t dilationH,
+    int64_t dilationW,
+    int64_t strideH,
+    int64_t strideW,
+    int64_t outH,
+    int64_t outW,
+    int64_t L,
+    int64_t K)
+{
+    int64_t total = N * C * K * L;
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+
+    for (int64_t linear = idx; linear < total; linear += stride) {
+        // Decompose linear index
+        int64_t tmp = linear;
+        int64_t j = tmp % outW;
+        tmp /= outW;
+        int64_t i = tmp % outH;
+        tmp /= outH;
+        int64_t k = tmp % K;
+        tmp /= K;
+        int64_t c = tmp % C;
+        int64_t n = tmp / C;
+
+        int64_t kh = k / kernelW;
+        int64_t kw = k % kernelW;
+
+        int64_t in_h = i * strideH + kh * dilationH;
+        int64_t in_w = j * strideW + kw * dilationW;
+
+        // No padding, so input indices are valid if H/W large enough (verified by binding)
+        output[linear] = input[((n * C + c) * H + in_h) * W + in_w];
+    }
+}
+
+// C-style launcher for unfold
+extern "C" void custom_unfold_forward_launcher(
+    const float* input,
+    float* output,
+    int64_t N,
+    int64_t C,
+    int64_t H,
+    int64_t W,
+    int64_t kernelH,
+    int64_t kernelW,
+    int64_t dilationH,
+    int64_t dilationW,
+    int64_t strideH,
+    int64_t strideW,
+    int64_t outH,
+    int64_t outW,
+    int64_t L,
+    int64_t K,
+    cudaStream_t stream)
+{
+    int64_t total = N * C * K * L;
+    int threads = 256;
+    int64_t blocks = (total + threads - 1) / threads;
+    if (blocks > 1073741824LL) blocks = 1073741824LL; // cap grid size
+    unfold_forward_kernel<float><<<(unsigned)blocks, threads, 0, stream>>>(
+        input, output, N, C, H, W, kernelH, kernelW,
+        dilationH, dilationW, strideH, strideW, outH, outW, L, K);
+}
+
+// Placeholder for custom_reshape_3d: no kernel needed, binding will use torch::reshape
+// This declaration ensures the symbol exists for potential linking.
+extern "C" void custom_reshape_3d_launcher(
+    const float* input,
+    float* output,
+    int64_t total_elements,
+    cudaStream_t stream)
+{
+    // No-op: reshape is metadata-only.
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,130 @@
+// custom_ops_binding.cpp - PyTorch bindings for custom_ops.cu launchers
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void custom_unfold_forward_launcher(
+    const float* input,
+    float* output,
+    int64_t N,
+    int64_t C,
+    int64_t H,
+    int64_t W,
+    int64_t kernelH,
+    int64_t kernelW,
+    int64_t dilationH,
+    int64_t dilationW,
+    int64_t strideH,
+    int64_t strideW,
+    int64_t outH,
+    int64_t outW,
+    int64_t L,
+    int64_t K,
+    cudaStream_t stream);
+
+// reshape launcher is a no-op in .cu; we can declare it but it is not necessary,
+// we will handle reshape with tensor metadata manipulation in binding.
+
+// PyTorch wrapper for custom_unfold_forward
+torch::Tensor custom_unfold_forward(
+    torch::Tensor x,
+    int64_t kernel_size_h,
+    int64_t kernel_size_w,
+    int64_t dilation_h,
+    int64_t dilation_w,
+    int64_t stride_h,
+    int64_t stride_w) {
+
+    // Input validation
+    TORCH_CHECK(x.is_cuda(), "Input tensor must be CUDA");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input tensor must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input tensor must be contiguous");
+    TORCH_CHECK(x.dim() == 4, "Input tensor must have 4 dimensions (N,C,H,W)");
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+
+    TORCH_CHECK(kernel_size_h > 0 && kernel_size_w > 0, "Kernel sizes must be positive");
+    TORCH_CHECK(dilation_h > 0 && dilation_w > 0, "Dilations must be positive");
+    TORCH_CHECK(stride_h > 0 && stride_w > 0, "Strides must be positive");
+
+    int64_t K = kernel_size_h * kernel_size_w;
+
+    // Compute output spatial dimensions (no padding)
+    int64_t outH = (H - dilation_h * (kernel_size_h - 1) - 1) / stride_h + 1;
+    int64_t outW = (W - dilation_w * (kernel_size_w - 1) - 1) / stride_w + 1;
+    TORCH_CHECK(outH > 0 && outW > 0, "Kernel size too large for input spatial dims");
+
+    int64_t L = outH * outW;
+
+    // Output shape: [N, C*K, L]
+    auto output = torch::empty({N, C * K, L}, x.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    custom_unfold_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C, H, W,
+        kernel_size_h, kernel_size_w,
+        dilation_h, dilation_w,
+        stride_h, stride_w,
+        outH, outW, L, K,
+        stream);
+
+    // Check for launch errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// PyTorch wrapper for custom_reshape_3d (metadata-only, no kernel launch)
+torch::Tensor custom_reshape_3d(
+    torch::Tensor x,
+    int64_t dim0,
+    int64_t dim1,
+    int64_t dim2) {
+
+    // Input validation
+    TORCH_CHECK(x.is_cuda(), "Input tensor must be CUDA");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input tensor must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input tensor must be contiguous");
+
+    int64_t total = dim0 * dim1 * dim2;
+    TORCH_CHECK(total == x.numel(), "Requested reshape dimensions do not match tensor size");
+
+    // Metadata-only reshape via view
+    return x.view({dim0, dim1, dim2});
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_unfold_forward", &custom_unfold_forward,
+          "Unfold operation with dilation and stride",
+          py::arg("x"),
+          py::arg("kernel_size_h"),
+          py::arg("kernel_size_w"),
+          py::arg("dilation_h"),
+          py::arg("dilation_w"),
+          py::arg("stride_h"),
+          py::arg("stride_w"));
+
+    m.def("custom_reshape_3d", &custom_reshape_3d,
+          "Reshape tensor to 3D with specified dims",
+          py::arg("x"),
+          py::arg("dim0"),
+          py::arg("dim1"),
+          py::arg("dim2"));
+}
+
+// Auto-register with the binding registry
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,39 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, kernel_size, dilation, stride):
+        super().__init__()
+        self.kernel_size = kernel_size
+        self.dilation = dilation
+        self.stride = stride
+
+    def forward(self, x):
+        kH, kW = self.kernel_size
+        dH, dW = self.dilation
+        sH, sW = self.stride if isinstance(self.stride, (tuple, list)) else (self.stride, self.stride)
+        x = cuda_extension.custom_unfold_forward(
+            x, kH, kW, dH, dW, sH, sW
+        )
+        N = x.size(0)
+        C_out = x.size(1)
+        L = x.size(2)
+        x = cuda_extension.custom_reshape_3d(x, N, L, C_out)
+        return x
+
+    def debug_forward(self, x):
+        kH, kW = self.kernel_size
+        dH, dW = self.dilation
+        sH, sW = self.stride if isinstance(self.stride, (tuple, list)) else (self.stride, self.stride)
+        x = cuda_extension.custom_unfold_forward(
+            x, kH, kW, dH, dW, sH, sW
+        )
+        yield "step_001", x
+        N = x.size(0)
+        C_out = x.size(1)
+        L = x.size(2)
+        x = cuda_extension.custom_reshape_3d(x, N, L, C_out)
+        yield "step_002", x
+        yield "step_003", x
