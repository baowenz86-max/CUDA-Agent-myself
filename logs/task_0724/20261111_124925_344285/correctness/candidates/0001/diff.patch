--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,70 @@
+#include <cuda_runtime.h>
+#include <cmath>
+
+// -----------------------------------------------------------------------------
+// custom_mean_dim1: reduce over dim=1 (channels) with keepdim=True
+// Input:  x shape [B, C, H, W] contiguous float32
+// Output: y shape [B, 1, H, W] contiguous float32
+// -----------------------------------------------------------------------------
+
+__global__ void mean_dim1_kernel(const float* __restrict__ input,
+                                 float* __restrict__ output,
+                                 int B, int C, int H, int W) {
+    int total = B * H * W;
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= total) return;
+
+    int hw = H * W;
+    int b = idx / hw;
+    int hw_idx = idx - b * hw;
+
+    const float* base = input + (size_t)b * C * hw + hw_idx;
+    float sum = 0.0f;
+    for (int c = 0; c < C; ++c) {
+        sum += base[(size_t)c * hw];
+    }
+    output[idx] = sum / (float)C;
+}
+
+extern "C" void custom_mean_dim1_launcher(const float* input,
+                                           float* output,
+                                           int B, int C, int H, int W,
+                                           cudaStream_t stream) {
+    int total = B * H * W;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    mean_dim1_kernel<<<blocks, threads, 0, stream>>>(input, output, B, C, H, W);
+}
+
+// -----------------------------------------------------------------------------
+// custom_gelu: elementwise GELU (tanh approximation)
+// y = 0.5 * x * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))
+// Input:  x shape [N] contiguous float32 (flattened)
+// Output: y shape [N] contiguous float32
+// -----------------------------------------------------------------------------
+
+__global__ void gelu_kernel(const float* __restrict__ input,
+                            float* __restrict__ output,
+                            int N) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= N) return;
+
+    float x = input[idx];
+    const float sqrt_2_over_pi = 0.7978845608028654f; // sqrt(2/pi)
+    const float coeff = 0.044715f;
+    float x3 = x * x * x;
+    float inner = sqrt_2_over_pi * (x + coeff * x3);
+    float tanh_val = tanhf(inner);
+    output[idx] = 0.5f * x * (1.0f + tanh_val);
+}
+
+extern "C" void custom_gelu_launcher(const float* input,
+                                      float* output,
+                                      int N,
+                                      cudaStream_t stream) {
+    int threads = 256;
+    int blocks = (N + threads - 1) / threads;
+    gelu_kernel<<<blocks, threads, 0, stream>>>(input, output, N);
+}
+
+// No additional kernels or launchers needed.
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,73 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void custom_mean_dim1_launcher(const float* input,
+                                           float* output,
+                                           int B, int C, int H, int W,
+                                           cudaStream_t stream);
+
+extern "C" void custom_gelu_launcher(const float* input,
+                                      float* output,
+                                      int N,
+                                      cudaStream_t stream);
+
+static torch::Tensor custom_mean_dim1(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "custom_mean_dim1: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "custom_mean_dim1: input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "custom_mean_dim1: input must be contiguous");
+    TORCH_CHECK(x.dim() == 4, "custom_mean_dim1: input must be 4D [B,C,H,W]");
+
+    int64_t B = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+
+    auto output = torch::empty({B, 1, H, W}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_mean_dim1_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int>(B),
+        static_cast<int>(C),
+        static_cast<int>(H),
+        static_cast<int>(W),
+        stream
+    );
+
+    return output;
+}
+
+static torch::Tensor custom_gelu(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "custom_gelu: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "custom_gelu: input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "custom_gelu: input must be contiguous");
+
+    int64_t N = x.numel();
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_gelu_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int>(N),
+        stream
+    );
+
+    return output;
+}
+
+static void register_custom_ops(pybind11::module& m) {
+    m.def("custom_mean_dim1", &custom_mean_dim1, "Mean over channel dim (keepdim=True)",
+          py::arg("x"));
+    m.def("custom_gelu", &custom_gelu, "GELU activation (tanh approximation)",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,21 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x):
+        x = cuda_extension.custom_mean_dim1(x)
+        x = cuda_extension.custom_gelu(x)
+        return x
+
+    def debug_forward(self, *inputs):
+        x = inputs[0]
+        x = cuda_extension.custom_mean_dim1(x)
+        yield 'step_001', x
+        x = cuda_extension.custom_gelu(x)
+        yield 'step_002', x
+        yield 'step_003', x
