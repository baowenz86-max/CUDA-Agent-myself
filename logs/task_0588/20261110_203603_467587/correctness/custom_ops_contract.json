{
  "operators": [
    {
      "name": "batch_norm1d_eval_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, L] where N=64, C=128, L=20000",
          "layout": "supports strides, contiguous",
          "optional": false,
          "nullable": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "optional": false,
          "nullable": true
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "optional": false,
          "nullable": true
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "optional": false,
          "nullable": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "optional": false,
          "nullable": false
        },
        {
          "name": "eps",
          "kind": "float",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input [N, C, L]"
      },
      "semantics": [
        "Performs BatchNorm1d evaluation with affine transformation if weight/bias are not None",
        "For each channel c in 0..C-1, computes y[n,c,l] = (x[n,c,l] - running_mean[c]) / sqrt(running_var[c] + eps) * weight[c] + bias[c]",
        "If affine=False in original model, weight and bias would be None; but here affine=True so they are provided",
        "Input typically contiguous on CUDA; strides may be supported by underlying kernel design",
        "Returns output with same shape and dtype as input"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "return self.batch_norm(x)",
      "semantics": [
        "Calls BatchNorm1d forward",
        "Since model is in eval mode, uses running_mean and running_var for normalization",
        "Applies affine parameters weight and bias if present",
        "Output shape [64,128,20000], dtype float32, device CUDA"
      ]
    }
  ]
}