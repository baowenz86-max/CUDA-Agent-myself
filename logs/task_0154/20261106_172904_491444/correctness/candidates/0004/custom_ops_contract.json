{
  "operators": [
    {
      "name": "stft_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, sequence_length]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "n_fft",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "win_length",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "hop_length",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.complex64",
        "device": "cuda",
        "shape": "[batch, n_fft//2 + 1, num_frames]"
      },
      "semantics": [
        "执行 torch.stft(input, n_fft=n_fft, win_length=win_length, hop_length=hop_length, return_complex=True)。",
        "使用默认 center=True, pad_mode='reflect', normalized=False, onesided=True。",
        "输入为 batch 个一维信号，输出复数谱，形状为 [batch, freq_bins, frames]，freq_bins = n_fft//2 + 1。",
        "计算帧数 frames = 1 + (sequence_length + 2*pad - n_fft) // hop_length，其中 pad = n_fft//2（center=True 时）。",
        "返回 complex64 张量。"
      ]
    },
    {
      "name": "view_as_real_permute_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.complex64",
          "device": "cuda",
          "shape": "[batch, freq_bins, frames]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, 2, freq_bins, frames]"
      },
      "semantics": [
        "先执行 torch.view_as_real(input)，将 complex64 转换为 float32，在最后一维增加实部和虚部，形状变为 [batch, freq_bins, frames, 2]。",
        "然后执行 permute(0, 3, 1, 2)，将维序变为 [batch, 2, freq_bins, frames]。",
        "返回 float32 张量。"
      ]
    },
    {
      "name": "conv2d_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, in_channels, height, width]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels, in_channels, kernel_h, kernel_w]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "stride",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "padding",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "dilation",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, out_channels, out_height, out_width]"
      },
      "semantics": [
        "执行 2D 卷积，与参考 self.conv2d(x) 完全一致。",
        "输入形状 [N, C, H, W]，权重 [K, C, R, S]，输出 [N, K, Ho, Wo]。",
        "Ho = floor((H + 2*padding[0] - dilation[0]*(R-1) - 1) / stride[0] + 1)，Wo 同理。",
        "如果 bias 不为 None，则加到输出上；如果 bias 为 None，则不添加。",
        "使用 cuDNN 实现，确保 stride、padding、dilation 为实际传入的元组，但参数需要解包为两个 int 分别传递。",
        "注意：contract 中 stride/padding/dilation 参数应为 int，实际模型传入的是元组，因此需要在 Python 调用时解包。"
      ]
    },
    {
      "name": "index_select_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, channels, freq_bins, frames]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "index",
          "kind": "tensor",
          "dtype": "torch.int64",
          "device": "cuda",
          "shape": "[num_indices]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, channels, num_indices, frames] (当 dim=2)"
      },
      "semantics": [
        "执行 torch.index_select(input, dim, index)，沿指定 dim 选择索引对应的切片。",
        "输出形状与输入相同，除了 dim 维度大小变为 index 的长度。",
        "保持输入张量遍历顺序。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = torch.stft(x, n_fft=self.n_fft, win_length=self.win_length, hop_length=self.hop_length, return_complex=True)",
      "semantics": [
        "输入 x 形状 [batch, sequence_length]，输出 stft 复数谱 [batch, freq_bins, frames]。",
        "freq_bins = n_fft//2 + 1 = 257，frames 根据公式计算，此处为 321。",
        "返回 complex64 张量，形状 [32, 257, 321]，device cuda:0。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.view_as_real(x).permute(0, 3, 1, 2)",
      "semantics": [
        "将 complex64 转换为 float32 并 permute，得到 [batch, 2, freq_bins, frames] = [32, 2, 257, 321]。",
        "返回 float32 张量，形状 [32, 2, 257, 321]，device cuda:0。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = self.conv2d(x)",
      "semantics": [
        "对 permuted 张量执行 2D 卷积，输出 [batch, out_channels, freq_bins, frames] = [32, 32, 257, 321]。",
        "使用 conv2d 权重 [32, 2, 3, 3] 和 bias [32]，stride=1, padding=(1,1), dilation=(1,1)。",
        "返回 float32 张量，形状 [32, 32, 257, 321]，device cuda:0。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "x = torch.index_select(x, self.index_dim, self.indices)",
      "semantics": [
        "沿 dim=2 从 x 中选择索引 [0,1,2,3,4]，得到 [32, 32, 5, 321]。",
        "返回 float32 张量，形状 [32, 32, 5, 321]，device cuda:0。"
      ]
    },
    {
      "checkpoint": "step_005",
      "source": "return x",
      "semantics": [
        "最终输出与 step_004 相同。"
      ]
    }
  ]
}