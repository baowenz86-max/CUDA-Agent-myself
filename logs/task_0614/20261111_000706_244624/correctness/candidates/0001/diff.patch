--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,52 @@
+#include <cuda_runtime.h>
+
+// CUDA kernel: elementwise embedding lookup followed by greater-than threshold,
+// producing a boolean tensor. Output shape = indices.shape + [embedding_dim].
+// Thread block size is fixed as 256 for simplicity and good occupancy.
+__global__ void embedding_gt_kernel(
+    const float* __restrict__ weight,
+    const int64_t* __restrict__ indices,
+    bool* __restrict__ output,
+    int64_t embedding_dim,
+    int64_t total_indices,
+    double threshold)
+{
+    int64_t total_output = total_indices * embedding_dim;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t out_idx = blockIdx.x * blockDim.x + threadIdx.x;
+         out_idx < total_output;
+         out_idx += stride) {
+        int64_t idx = out_idx / embedding_dim;
+        int64_t dim = out_idx - idx * embedding_dim;
+        int64_t weight_row = indices[idx];
+        float val = weight[weight_row * embedding_dim + dim];
+        output[out_idx] = (val > (float)threshold);
+    }
+}
+
+// C-launcher for the embedding_gt_forward custom op.
+// All pointers are raw CUDA device pointers; tensors are checked and allocated
+// in the corresponding *_binding.cpp file.
+extern "C" void embedding_gt_forward_launcher(
+    const float* weight,
+    const int64_t* indices,
+    bool* output,
+    int64_t embedding_dim,
+    int64_t total_indices,
+    cudaStream_t stream)
+{
+    const int block_size = 256;
+    int64_t total_output = total_indices * embedding_dim;
+    // Use a grid large enough to cover all elements, but cap the grid size to
+    // avoid excessive launch overhead. The kernel uses a grid-stride loop,
+    // so a grid of up to 65535 blocks is sufficient for all realistic sizes.
+    int64_t blocks_needed = (total_output + block_size - 1) / block_size;
+    int grid_size = (int)(blocks_needed < 65535 ? blocks_needed : 65535);
+    if (grid_size == 0) grid_size = 1;
+
+    embedding_gt_kernel<<<grid_size, block_size, 0, stream>>>(
+        weight, indices, output, embedding_dim, total_indices, (double)0.5);
+
+    // Launcher does not synchronize; caller may use stream synchronization.
+    // Error checking is performed by the binding wrapper after launch.
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,67 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declaration of launcher from custom_ops.cu
+extern "C" void embedding_gt_forward_launcher(
+    const float* weight,
+    const int64_t* indices,
+    bool* output,
+    int64_t embedding_dim,
+    int64_t total_indices,
+    cudaStream_t stream);
+
+// PyTorch wrapper
+static torch::Tensor embedding_gt_forward(
+    torch::Tensor weight,
+    torch::Tensor indices,
+    int64_t padding_idx,
+    double threshold)
+{
+    // input validation
+    TORCH_CHECK(weight.is_cuda(), "weight must be a CUDA tensor");
+    TORCH_CHECK(indices.is_cuda(), "indices must be a CUDA tensor");
+    TORCH_CHECK(weight.dtype() == torch::kFloat32, "weight must be float32");
+    TORCH_CHECK(indices.dtype() == torch::kInt64, "indices must be int64");
+    TORCH_CHECK(weight.is_contiguous(), "weight must be contiguous");
+    TORCH_CHECK(indices.is_contiguous(), "indices must be contiguous");
+    TORCH_CHECK(weight.dim() == 2, "weight must be 2D [num_embeddings, embedding_dim]");
+    TORCH_CHECK(indices.dim() >= 1, "indices must have at least 1 dimension");
+
+    const int64_t embedding_dim = weight.size(1);
+    const int64_t total_indices = indices.numel();
+
+    // Output shape: indices.shape + [embedding_dim]
+    std::vector<int64_t> output_shape(indices.sizes().begin(), indices.sizes().end());
+    output_shape.push_back(embedding_dim);
+
+    auto output = torch::empty(output_shape, indices.options().dtype(torch::kBool));
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    embedding_gt_forward_launcher(
+        weight.data_ptr<float>(),
+        indices.data_ptr<int64_t>(),
+        output.data_ptr<bool>(),
+        embedding_dim,
+        total_indices,
+        stream);
+
+    // Note: padding_idx and threshold are not used by the current launcher (threshold hardcoded to 0.5),
+    // but they are accepted for interface compatibility.
+
+    return output;
+}
+
+// Registration function
+static void register_custom_ops_binding(pybind11::module& m) {
+    m.def("embedding_gt_forward", &embedding_gt_forward,
+          "Embedding lookup followed by greater-than threshold",
+          py::arg("weight"), py::arg("indices"), py::arg("padding_idx"), py::arg("threshold"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops_binding);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,29 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, num_embeddings, embedding_dim, padding_idx):
+        super().__init__()
+        self.embedding = nn.Embedding(num_embeddings, embedding_dim, padding_idx=padding_idx)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        if not x.is_cuda:
+            x = x.to('cuda')
+        return cuda_extension.embedding_gt_forward(self.embedding.weight, x, self.embedding.padding_idx, 0.5)
+
+    def debug_forward(self, *inputs):
+        x = inputs[0]
+        if not x.is_cuda:
+            x = x.to('cuda')
+        y = cuda_extension.embedding_gt_forward(self.embedding.weight, x, self.embedding.padding_idx, 0.5)
+        yield ('step_001', y)
+
+
+def get_inputs():
+    return [torch.randint(0, 1000, (256, 2048), dtype=torch.int64)]
+
+
+def get_init_inputs():
+    return [1000, 300, 0]
