--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,92 @@
+// custom_ops.cu - CUDA kernels for cat and ceil
+#include <cuda_runtime.h>
+#include <math.h>
+
+// Kernel to copy data from input1 and input2 into output, assuming dim=0 semantics
+// For dim=0, concatenation is just sequential memory copy of contiguous tensors.
+// This kernel works for any concatenation along the first dimension only.
+// If dim != 0, this kernel would need to handle non-contiguous slices; but
+// the contract specifies dim=0, so we implement the generic case with a check
+// inside the launcher to handle only dim=0 for correctness.
+__global__ void cat_copy_kernel(const float* __restrict__ x1,
+                                const float* __restrict__ x2,
+                                float* __restrict__ out,
+                                long long offset2,
+                                long long total_elements) {
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+    for (long long i = idx; i < total_elements; i += stride) {
+        if (i < offset2) {
+            out[i] = x1[i];
+        } else {
+            out[i] = x2[i - offset2];
+        }
+    }
+}
+
+// Kernel for ceil on float32
+__global__ void ceil_kernel(const float* __restrict__ input,
+                            float* __restrict__ output,
+                            long long n) {
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+    for (long long i = idx; i < n; i += stride) {
+        output[i] = ceilf(input[i]);
+    }
+}
+
+// Launcher for cat_forward: concatenates x1 and x2 along dimension dim.
+// Currently only supports dim=0 for contiguous float32 tensors.
+// Returns 0 on success, -1 on unsupported dim or CUDA error.
+extern "C" int cat_forward_launcher(const float* x1,
+                                    const float* x2,
+                                    float* output,
+                                    long long x1_elements,
+                                    long long x2_elements,
+                                    int dim,
+                                    cudaStream_t stream) {
+    // dim must be 0 for this simple implementation.
+    if (dim != 0) {
+        return -1;
+    }
+    long long total = x1_elements + x2_elements;
+    if (total == 0) {
+        // nothing to do
+        return 0;
+    }
+    int block_size = 256;
+    // Use 64-bit grid size to avoid overflow for large tensors.
+    long long grid_size = (total + block_size - 1) / block_size;
+    // Cap grid at 2^31-1 blocks (max grid dim x).
+    if (grid_size > 2147483647LL) {
+        grid_size = 2147483647LL;
+    }
+    cat_copy_kernel<<<(unsigned int)grid_size, block_size, 0, stream>>>(
+        x1, x2, output, x1_elements, total);
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        return -2;
+    }
+    return 0;
+}
+
+// Launcher for ceil_forward.
+extern "C" int ceil_forward_launcher(const float* input,
+                                     float* output,
+                                     long long n,
+                                     cudaStream_t stream) {
+    if (n <= 0) {
+        return 0;
+    }
+    int block_size = 256;
+    long long grid_size = (n + block_size - 1) / block_size;
+    if (grid_size > 2147483647LL) {
+        grid_size = 2147483647LL;
+    }
+    ceil_kernel<<<(unsigned int)grid_size, block_size, 0, stream>>>(input, output, n);
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        return -1;
+    }
+    return 0;
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,95 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" int cat_forward_launcher(const float* x1,
+                                    const float* x2,
+                                    float* output,
+                                    long long x1_elements,
+                                    long long x2_elements,
+                                    int dim,
+                                    cudaStream_t stream);
+
+extern "C" int ceil_forward_launcher(const float* input,
+                                     float* output,
+                                     long long n,
+                                     cudaStream_t stream);
+
+// Tensor wrapper for cat_forward
+torch::Tensor cat_forward(torch::Tensor x1, torch::Tensor x2, int64_t dim) {
+    // Validate inputs
+    TORCH_CHECK(x1.is_cuda(), "x1 must be a CUDA tensor");
+    TORCH_CHECK(x2.is_cuda(), "x2 must be a CUDA tensor");
+    TORCH_CHECK(x1.dtype() == torch::kFloat32, "x1 must be float32");
+    TORCH_CHECK(x2.dtype() == torch::kFloat32, "x2 must be float32");
+    TORCH_CHECK(dim == 0, "Only dim=0 is supported");
+    TORCH_CHECK(x1.sizes() == x2.sizes(), "x1 and x2 must have the same shape");
+
+    // Ensure contiguous (launcher assumes memory-contiguous layout for dim=0)
+    auto x1_contig = x1.contiguous();
+    auto x2_contig = x2.contiguous();
+
+    // Compute output shape: [x1.size(0)+x2.size(0), x1.size(1), ...]
+    auto out_sizes = x1_contig.sizes().vec();
+    out_sizes[0] = x1_contig.size(0) + x2_contig.size(0);
+    auto output = torch::empty(out_sizes, x1_contig.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    long long x1_elements = x1_contig.numel();
+    long long x2_elements = x2_contig.numel();
+    int status = cat_forward_launcher(
+        x1_contig.data_ptr<float>(),
+        x2_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        x1_elements,
+        x2_elements,
+        static_cast<int>(dim),
+        stream
+    );
+
+    TORCH_CHECK(status == 0, "cat_forward kernel launch failed with status ", status);
+    return output;
+}
+
+// Tensor wrapper for ceil_forward
+torch::Tensor ceil_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
+
+    auto output = torch::empty_like(x);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    int status = ceil_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<long long>(x.numel()),
+        stream
+    );
+
+    TORCH_CHECK(status == 0, "ceil_forward kernel launch failed with status ", status);
+    return output;
+}
+
+// Registration functions
+void register_cat_forward(pybind11::module& m) {
+    m.def("cat_forward", &cat_forward,
+          "Concatenate two CUDA float32 tensors along dim=0",
+          py::arg("x1"), py::arg("x2"), py::arg("dim"));
+}
+
+void register_ceil_forward(pybind11::module& m) {
+    m.def("ceil_forward", &ceil_forward,
+          "Element-wise ceil for CUDA float32 tensor",
+          py::arg("x"));
+}
+
+// Auto-register
+REGISTER_BINDING(cat_forward, register_cat_forward);
+REGISTER_BINDING(ceil_forward, register_ceil_forward);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,21 @@
+import torch
+
+import cuda_extension
+
+
+class ModelNew(torch.nn.Module):
+    def __init__(self, cat_dim):
+        super().__init__()
+        self.cat_dim = cat_dim
+
+    def forward(self, x1, x2):
+        x = cuda_extension.cat_forward(x1, x2, int(self.cat_dim))
+        x = cuda_extension.ceil_forward(x)
+        return x
+
+    def debug_forward(self, x1, x2):
+        x = cuda_extension.cat_forward(x1, x2, int(self.cat_dim))
+        yield 'step_001', x
+        x = cuda_extension.ceil_forward(x)
+        yield 'step_002', x
+        yield 'step_003', x
