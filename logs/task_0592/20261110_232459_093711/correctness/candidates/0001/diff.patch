--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,63 @@
+#include <cuda_runtime.h>
+
+// Kernel: concatenate two tensors along dim=0.
+// Assumes both inputs have the same shape and are contiguous.
+// output layout: first x1_numel elements from x1, then x2_numel elements from x2.
+__global__ void cat_dim0_kernel(const float* __restrict__ x1,
+                                const float* __restrict__ x2,
+                                float* __restrict__ out,
+                                long long x1_numel,
+                                long long x2_numel) {
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+    for (long long i = idx; i < x1_numel + x2_numel; i += stride) {
+        if (i < x1_numel) {
+            out[i] = x1[i];
+        } else {
+            out[i] = x2[i - x1_numel];
+        }
+    }
+}
+
+// Kernel: element-wise ceil
+__global__ void ceil_kernel(const float* __restrict__ input,
+                            float* __restrict__ output,
+                            long long numel) {
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+    for (long long i = idx; i < numel; i += stride) {
+        output[i] = ceilf(input[i]);
+    }
+}
+
+// Launcher for concatenation along dim=0.
+// Inputs: x1, x2 are device pointers; out is device pointer to allocated output.
+// x1_numel, x2_numel are the number of elements in each input.
+// stream is the CUDA stream to launch on.
+extern "C" void custom_cat_forward_launcher(const float* x1,
+                                            const float* x2,
+                                            float* out,
+                                            long long x1_numel,
+                                            long long x2_numel,
+                                            cudaStream_t stream) {
+    // Simple 1D grid-stride kernel.
+    int threads = 256;
+    long long total = x1_numel + x2_numel;
+    long long blocks_ll = (total + threads - 1) / threads;
+    // Cap grid at a reasonable number, grid-stride loop handles the rest.
+    int blocks = (blocks_ll > 65535) ? 65535 : (int)blocks_ll;
+    if (blocks < 1) blocks = 1;
+    cat_dim0_kernel<<<blocks, threads, 0, stream>>>(x1, x2, out, x1_numel, x2_numel);
+}
+
+// Launcher for ceil.
+extern "C" void custom_ceil_forward_launcher(const float* input,
+                                             float* output,
+                                             long long numel,
+                                             cudaStream_t stream) {
+    int threads = 256;
+    long long blocks_ll = (numel + threads - 1) / threads;
+    int blocks = (blocks_ll > 65535) ? 65535 : (int)blocks_ll;
+    if (blocks < 1) blocks = 1;
+    ceil_kernel<<<blocks, threads, 0, stream>>>(input, output, numel);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,85 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_runtime.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void custom_cat_forward_launcher(
+    const float* x1,
+    const float* x2,
+    float* out,
+    long long x1_numel,
+    long long x2_numel,
+    cudaStream_t stream);
+
+extern "C" void custom_ceil_forward_launcher(
+    const float* input,
+    float* output,
+    long long numel,
+    cudaStream_t stream);
+
+static torch::Tensor custom_cat_forward(torch::Tensor x1, torch::Tensor x2, int64_t dim) {
+    // Validate inputs
+    TORCH_CHECK(x1.is_cuda(), "x1 must be a CUDA tensor");
+    TORCH_CHECK(x2.is_cuda(), "x2 must be a CUDA tensor");
+    TORCH_CHECK(x1.dtype() == torch::kFloat32, "x1 must be float32");
+    TORCH_CHECK(x2.dtype() == torch::kFloat32, "x2 must be float32");
+    TORCH_CHECK(x1.is_contiguous(), "x1 must be contiguous");
+    TORCH_CHECK(x2.is_contiguous(), "x2 must be contiguous");
+    TORCH_CHECK(x1.sizes() == x2.sizes(), "x1 and x2 must have the same shape");
+    TORCH_CHECK(dim == 0, "Only dim=0 is supported for cat");
+
+    auto x1_numel = x1.numel();
+    auto x2_numel = x2.numel();
+
+    // Compute output shape: [x1.size(0) + x2.size(0), ...]
+    std::vector<int64_t> out_sizes(x1.sizes().begin(), x1.sizes().end());
+    out_sizes[0] = x1.size(0) + x2.size(0);
+
+    auto out = torch::empty(out_sizes, x1.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    custom_cat_forward_launcher(
+        x1.data_ptr<float>(),
+        x2.data_ptr<float>(),
+        out.data_ptr<float>(),
+        static_cast<long long>(x1_numel),
+        static_cast<long long>(x2_numel),
+        stream);
+
+    return out;
+}
+
+static torch::Tensor custom_ceil_forward(torch::Tensor x) {
+    // Validate input
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
+
+    auto out = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_ceil_forward_launcher(
+        x.data_ptr<float>(),
+        out.data_ptr<float>(),
+        static_cast<long long>(x.numel()),
+        stream);
+
+    return out;
+}
+
+static void register_custom_ops(pybind11::module& m) {
+    m.def("custom_cat_forward", &custom_cat_forward,
+          "Concatenate two tensors along dim=0",
+          py::arg("x1"), py::arg("x2"), py::arg("dim"));
+    m.def("custom_ceil_forward", &custom_ceil_forward,
+          "Element-wise ceil",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,21 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, cat_dim):
+        super().__init__()
+        self.cat_dim = cat_dim
+
+    def forward(self, x1, x2):
+        x = cuda_extension.custom_cat_forward(x1, x2, self.cat_dim)
+        x = cuda_extension.custom_ceil_forward(x)
+        return x
+
+    def debug_forward(self, x1, x2):
+        x = cuda_extension.custom_cat_forward(x1, x2, self.cat_dim)
+        yield 'step_001', x
+        x = cuda_extension.custom_ceil_forward(x)
+        yield 'step_002', x
+        yield 'step_003', x
