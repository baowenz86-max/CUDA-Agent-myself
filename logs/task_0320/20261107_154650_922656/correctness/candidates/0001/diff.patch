--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,48 @@
+#include <cuda_runtime.h>
+
+// Hardtanh: clamp to [-1, 1]
+__global__ void hardtanh_kernel(const float* __restrict__ input,
+                                float* __restrict__ output,
+                                int64_t numel) {
+    int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    int64_t stride = static_cast<int64_t>(blockDim.x) * gridDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        float v = input[i];
+        v = fminf(fmaxf(v, -1.0f), 1.0f);
+        output[i] = v;
+    }
+}
+
+// Leaky ReLU with negative_slope = 0.01
+__global__ void leaky_relu_kernel(const float* __restrict__ input,
+                                  float* __restrict__ output,
+                                  int64_t numel,
+                                  float negative_slope) {
+    int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    int64_t stride = static_cast<int64_t>(blockDim.x) * gridDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        float v = input[i];
+        output[i] = (v > 0.0f) ? v : (v * negative_slope);
+    }
+}
+
+extern "C" void hardtanh_forward_launcher(const float* input,
+                                           float* output,
+                                           int64_t numel,
+                                           cudaStream_t stream) {
+    if (numel == 0) return;
+    const int threads = 256;
+    const int blocks = static_cast<int>(min<int64_t>((numel + threads - 1) / threads, 65535));
+    hardtanh_kernel<<<blocks, threads, 0, stream>>>(input, output, numel);
+}
+
+extern "C" void leaky_relu_forward_launcher(const float* input,
+                                             float* output,
+                                             int64_t numel,
+                                             float negative_slope,
+                                             cudaStream_t stream) {
+    if (numel == 0) return;
+    const int threads = 256;
+    const int blocks = static_cast<int>(min<int64_t>((numel + threads - 1) / threads, 65535));
+    leaky_relu_kernel<<<blocks, threads, 0, stream>>>(input, output, numel, negative_slope);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,69 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void hardtanh_forward_launcher(const float* input,
+                                           float* output,
+                                           int64_t numel,
+                                           cudaStream_t stream);
+
+extern "C" void leaky_relu_forward_launcher(const float* input,
+                                             float* output,
+                                             int64_t numel,
+                                             float negative_slope,
+                                             cudaStream_t stream);
+
+// PyTorch wrapper for hardtanh
+torch::Tensor hardtanh_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.numel() > 0, "Input tensor must not be empty");
+
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    hardtanh_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        x.numel(),
+        stream
+    );
+
+    return output;
+}
+
+// PyTorch wrapper for leaky_relu
+torch::Tensor leaky_relu_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.numel() > 0, "Input tensor must not be empty");
+
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    constexpr float negative_slope = 0.01f;
+    leaky_relu_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        x.numel(),
+        negative_slope,
+        stream
+    );
+
+    return output;
+}
+
+// Registration
+void register_custom_ops(pybind11::module& m) {
+    m.def("hardtanh_forward", &hardtanh_forward, "Hardtanh forward",
+          py::arg("x"));
+    m.def("leaky_relu_forward", &leaky_relu_forward, "Leaky ReLU forward",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,19 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x):
+        x = cuda_extension.hardtanh_forward(x)
+        x = cuda_extension.leaky_relu_forward(x)
+        return x
+
+    def debug_forward(self, x):
+        x1 = cuda_extension.hardtanh_forward(x)
+        yield 'step_001', x1
+        x2 = cuda_extension.leaky_relu_forward(x1)
+        yield 'step_002', x2
+        yield 'step_003', x2
