--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,77 @@
+// CUDA kernels and launchers for custom_embedding and custom_split
+// This file contains no torch/ATen/pybind dependencies.
+
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// Kernel: given int64 indices and float32 weight (num_embeddings x embedding_dim),
+// output is N x embedding_dim, each row copied from the corresponding embedding row.
+// We use a 1D grid over total output elements (N * embedding_dim) for coalescing.
+__global__ void embed_forward_kernel(const int64_t* __restrict__ indices,
+                                     const float* __restrict__ weight,
+                                     float* __restrict__ output,
+                                     int64_t N,
+                                     int64_t embedding_dim) {
+    int64_t total = N * embedding_dim;
+    // grid-stride loop
+    for (int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
+         idx < total;
+         idx += (int64_t)blockDim.x * gridDim.x) {
+        int64_t row = idx / embedding_dim;
+        int64_t col = idx % embedding_dim;
+        int64_t index = indices[row];
+        output[idx] = weight[index * embedding_dim + col];
+    }
+}
+
+// Launcher for custom_embedding. The binding layer is responsible for
+// allocating output and passing data pointers.
+extern "C" void custom_embedding_launcher(const int64_t* indices,
+                                          const float* weight,
+                                          float* output,
+                                          int64_t N,
+                                          int64_t embedding_dim,
+                                          cudaStream_t stream) {
+    if (N <= 0 || embedding_dim <= 0) return;
+    int64_t total = N * embedding_dim;
+    int block_size = 256;
+    int64_t grid_size = (total + block_size - 1) / block_size;
+    // Cap grid size to avoid excessive blocks, rely on grid-stride loop.
+    const int64_t max_grid = 65535;
+    if (grid_size > max_grid) grid_size = max_grid;
+    embed_forward_kernel<<<(unsigned int)grid_size, block_size, 0, stream>>>(
+        indices, weight, output, N, embedding_dim);
+}
+
+// Launcher for custom_split. This does NOT launch a kernel; it computes
+// pointers and sizes for each split segment. The binding layer uses these
+// to create tensor views with torch::from_blob. Since the contract requires
+// views sharing storage, the input pointer is returned offset by row dim.
+// We assume dim=0 and num_splits=2, as specified in the contract.
+extern "C" void custom_split_launcher(const float* input,
+                                      int64_t num_splits,
+                                      int64_t dim,
+                                      int64_t N,
+                                      int64_t embedding_dim,
+                                      const float** out_ptrs,
+                                      int64_t* out_sizes,
+                                      cudaStream_t stream) {
+    // Only handle dim=0 and num_splits=2 per contract. If other values appear,
+    // the binding layer should have already validated.
+    if (dim != 0 || num_splits != 2) {
+        // In a real implementation, the binding would reject earlier. Here we
+        // set outputs to null/0 to signal error, but we cannot throw from .cu.
+        out_ptrs[0] = nullptr;
+        out_ptrs[1] = nullptr;
+        out_sizes[0] = 0;
+        out_sizes[1] = 0;
+        return;
+    }
+    int64_t split_size = N / num_splits;
+    // First split starts at input.
+    out_ptrs[0] = input;
+    out_sizes[0] = split_size;
+    // Second split starts at input + split_size * embedding_dim (row-major, dim=0).
+    out_ptrs[1] = input + split_size * embedding_dim;
+    out_sizes[1] = split_size;
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,140 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include <tuple>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void custom_embedding_launcher(const int64_t* indices,
+                                          const float* weight,
+                                          float* output,
+                                          int64_t N,
+                                          int64_t embedding_dim,
+                                          cudaStream_t stream);
+
+extern "C" void custom_split_launcher(const float* input,
+                                      int64_t num_splits,
+                                      int64_t dim,
+                                      int64_t N,
+                                      int64_t embedding_dim,
+                                      const float** out_ptrs,
+                                      int64_t* out_sizes,
+                                      cudaStream_t stream);
+
+// Wrapper for custom_embedding
+torch::Tensor custom_embedding_forward(torch::Tensor indices, torch::Tensor weight) {
+    // Validate inputs
+    TORCH_CHECK(indices.is_cuda(), "indices must be a CUDA tensor");
+    TORCH_CHECK(weight.is_cuda(), "weight must be a CUDA tensor");
+    TORCH_CHECK(indices.dtype() == torch::kInt64, "indices must be int64");
+    TORCH_CHECK(weight.dtype() == torch::kFloat32, "weight must be float32");
+    TORCH_CHECK(indices.dim() == 1, "indices must be 1-dimensional");
+    TORCH_CHECK(weight.dim() == 2, "weight must be 2-dimensional");
+
+    int64_t N = indices.size(0);
+    int64_t embedding_dim = weight.size(1);
+    if (N == 0) {
+        // Return empty tensor with correct shape
+        return torch::empty({0, embedding_dim}, weight.options());
+    }
+
+    // Allocate output
+    auto output = torch::empty({N, embedding_dim}, weight.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    custom_embedding_launcher(
+        indices.data_ptr<int64_t>(),
+        weight.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N,
+        embedding_dim,
+        stream
+    );
+
+    return output;
+}
+
+// Wrapper for custom_split
+std::tuple<torch::Tensor, torch::Tensor> custom_split_forward(torch::Tensor input,
+                                                               int64_t num_splits,
+                                                               int64_t dim) {
+    // Validate inputs
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(input.dim() >= 1, "input must have at least 1 dimension");
+    TORCH_CHECK(dim >= 0 && dim < input.dim(), "dim out of range");
+    TORCH_CHECK(num_splits > 0, "num_splits must be positive");
+    TORCH_CHECK(input.size(dim) % num_splits == 0, "split dimension must be divisible by num_splits");
+
+    // For this task, we only support dim=0 and num_splits=2 per launcher contract
+    TORCH_CHECK(dim == 0, "Only dim=0 is supported");
+    TORCH_CHECK(num_splits == 2, "Only num_splits=2 is supported");
+
+    int64_t N = input.size(0);
+    int64_t embedding_dim = input.numel() / N; // total / rows
+
+    // Prepare output pointers and sizes
+    const float* out_ptrs[2];
+    int64_t out_sizes[2];
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher to compute pointers/sizes
+    custom_split_launcher(
+        input.data_ptr<float>(),
+        num_splits,
+        dim,
+        N,
+        embedding_dim,
+        out_ptrs,
+        out_sizes,
+        stream
+    );
+
+    // Check for null pointers (launcher should always set them for valid input)
+    TORCH_CHECK(out_ptrs[0] != nullptr && out_ptrs[1] != nullptr, "split launcher returned null pointer");
+
+    // Create tensor views sharing storage with input
+    // Use torch::from_blob with the original storage of input to ensure proper sharing
+    // Since input is contiguous, we can create views using as_strided or from_blob with deleter.
+    auto input_untyped = input; // keep a reference to keep storage alive
+    auto storage = input.storage(); // get the Storage, keeps data alive
+    int64_t split_size = out_sizes[0];
+    auto options = torch::TensorOptions().dtype(torch::kFloat32).device(input.device());
+
+    torch::Tensor first = torch::from_blob(
+        const_cast<float*>(out_ptrs[0]),
+        {split_size, embedding_dim},
+        [storage](void*) {},  // no-op deleter, storage keeps data alive
+        options
+    );
+
+    torch::Tensor second = torch::from_blob(
+        const_cast<float*>(out_ptrs[1]),
+        {split_size, embedding_dim},
+        [storage](void*) {},
+        options
+    );
+
+    return std::make_tuple(first, second);
+}
+
+// Registration
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_embedding", &custom_embedding_forward,
+          "Custom embedding lookup",
+          py::arg("indices"),
+          py::arg("weight"));
+    m.def("custom_split", &custom_split_forward,
+          "Split input along dim=0 into two equal halves as views",
+          py::arg("input"),
+          py::arg("num_splits"),
+          py::arg("dim"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,21 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, num_embeddings, embedding_dim):
+        super().__init__()
+        self.embedding = nn.Embedding(num_embeddings, embedding_dim)
+
+    def forward(self, x):
+        embedded = cuda_extension.custom_embedding(x, self.embedding.weight)
+        split_tensors = cuda_extension.custom_split(embedded, 2, 0)
+        return split_tensors
+
+    def debug_forward(self, x):
+        embedded = cuda_extension.custom_embedding(x, self.embedding.weight)
+        yield "step_001", embedded
+        split_tensors = cuda_extension.custom_split(embedded, 2, 0)
+        yield "step_002", split_tensors
+        yield "step_003", split_tensors