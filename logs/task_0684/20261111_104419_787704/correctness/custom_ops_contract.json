{
  "operators": [
    {
      "name": "custom_embedding",
      "parameters": [
        {
          "name": "indices",
          "kind": "tensor",
          "dtype": "torch.int64",
          "device": "cuda",
          "shape": "[N]",
          "layout": "strided",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[num_embeddings, embedding_dim]",
          "layout": "strided",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, embedding_dim]"
      },
      "semantics": [
        "对应参考语句 embedded = self.embedding(x)。",
        "indices 是一维 int64 张量，weight 是 nn.Embedding 的权重矩阵。",
        "输出是对 indices 中每个索引在 weight 中的行向量查找结果，形状为 [N, embedding_dim]。",
        "假设 indices 中的所有值在 [0, num_embeddings-1] 范围内，无需边界检查。",
        "输出张量在 CUDA 设备上，为行主序连续存储。"
      ]
    },
    {
      "name": "custom_split",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, embedding_dim]",
          "layout": "strided",
          "nullable": false,
          "optional": false
        },
        {
          "name": "num_splits",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tuple of tensors",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "each tensor shape [N/num_splits, embedding_dim]"
      },
      "semantics": [
        "对应参考语句 split_tensors = torch.split(embedded, embedded.size(dim=0) // 2, dim=0)。",
        "该实现假设 num_splits=2 且 dim=0，仅处理当前任务需求。",
        "输入在指定维度 dim 被均匀分成 num_splits 份，每份大小为 N//num_splits。",
        "输出是一个包含 num_splits 个张量的 Python tuple，每个张量是输入沿 dim 维度的连续切片。",
        "输出张量与输入共享底层存储，为视图而非拷贝。",
        "如果 N 不能被 num_splits 整除，会抛出异常（但任务中 N=1000000 可被 2 整除）。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "embedded = self.embedding(x)",
      "semantics": [
        "使用 embedding 权重对索引张量 x 进行查找。",
        "输入 x 形状 [1000000]，输出 embedded 形状 [1000000, 512]，dtype 为 float32，device 为 cuda:0。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "split_tensors = torch.split(embedded, embedded.size(dim=0) // 2, dim=0)",
      "semantics": [
        "沿第0维将 embedded 分成两个大小相等的张量，每个形状 [500000, 512]。",
        "split_size 为 embedded.size(0)//2 = 500000。",
        "返回一个包含两个张量的元组。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return split_tensors",
      "semantics": [
        "返回 step_002 中的元组，包含两个形状为 [500000, 512] 的 CUDA float32 张量。"
      ]
    }
  ]
}