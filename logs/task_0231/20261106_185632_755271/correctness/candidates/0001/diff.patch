--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,83 @@
+#include <cuda_runtime.h>
+
+// Elementwise hardtanh clamp: out = min(max(x, min_val), max_val)
+__global__ void hardtanh_clamp_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int64_t numel,
+    float min_val,
+    float max_val) {
+    int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (idx < numel) {
+        float v = input[idx];
+        v = fminf(fmaxf(v, min_val), max_val);
+        output[idx] = v;
+    }
+}
+
+// Mean over channel dimension (dim=1) with keepdim=True.
+// Input assumed to be 4D contiguous with sizes [N,C,H,W] in row-major order.
+// Output is [N,1,H,W], also contiguous.
+// Each thread computes one output spatial position (h,w) for a batch n,
+// summing over channels.
+__global__ void mean_channel_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int64_t N,
+    int64_t C,
+    int64_t H,
+    int64_t W) {
+    // Compute linear index for output element (n, 0, h, w)
+    int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    int64_t total_output = N * H * W;
+    if (idx >= total_output) return;
+
+    // Decompose idx into n, h, w
+    int64_t n = idx / (H * W);
+    int64_t hw = idx % (H * W);
+    int64_t h = hw / W;
+    int64_t w = hw % W;
+
+    // Base input index for (n, 0, h, w)
+    int64_t input_base = (n * C) * (H * W) + h * W + w;
+
+    float sum = 0.0f;
+    for (int64_t c = 0; c < C; ++c) {
+        sum += input[input_base + c * (H * W)];
+    }
+    output[idx] = sum / static_cast<float>(C);
+}
+
+// Launcher for hardtanh_clamp. Input and output have same shape and are contiguous.
+// The binding layer is responsible for passing contiguous tensors; we assume that.
+extern "C" void hardtanh_clamp_launcher(
+    const float* input,
+    float* output,
+    int64_t numel,
+    float min_val,
+    float max_val,
+    cudaStream_t stream) {
+    if (numel <= 0) return;
+    const int block_size = 256;
+    int64_t grid_size = (numel + block_size - 1) / block_size;
+    // grid-size limit: use loop if needed, but numel max ~805M, grid up to ~3.1M within limit
+    hardtanh_clamp_kernel<<<(unsigned int)grid_size, block_size, 0, stream>>>(
+        input, output, numel, min_val, max_val);
+}
+
+// Launcher for mean_channel reduction. Input contiguous [N,C,H,W]. Output contiguous [N,1,H,W].
+extern "C" void mean_channel_launcher(
+    const float* input,
+    float* output,
+    int64_t N,
+    int64_t C,
+    int64_t H,
+    int64_t W,
+    cudaStream_t stream) {
+    int64_t total_output = N * H * W;
+    if (total_output <= 0) return;
+    const int block_size = 256;
+    int64_t grid_size = (total_output + block_size - 1) / block_size;
+    mean_channel_kernel<<<(unsigned int)grid_size, block_size, 0, stream>>>(
+        input, output, N, C, H, W);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,106 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Launcher declarations matching custom_ops.cu
+extern "C" void hardtanh_clamp_launcher(
+    const float* input,
+    float* output,
+    int64_t numel,
+    float min_val,
+    float max_val,
+    cudaStream_t stream);
+
+extern "C" void mean_channel_launcher(
+    const float* input,
+    float* output,
+    int64_t N,
+    int64_t C,
+    int64_t H,
+    int64_t W,
+    cudaStream_t stream);
+
+namespace {
+
+torch::Tensor hardtanh_clamp_forward(
+    torch::Tensor input,
+    double min_val = -1.0,
+    double max_val = 1.0) {
+    TORCH_CHECK(input.is_cuda(), "hardtanh_clamp: input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "hardtanh_clamp: input must be float32");
+
+    // Ensure contiguous for simple pointer-based kernel
+    auto input_contig = input.contiguous();
+    auto output = torch::empty_like(input_contig);
+
+    int64_t numel = input_contig.numel();
+    if (numel == 0) {
+        return output;
+    }
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    hardtanh_clamp_launcher(
+        input_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        numel,
+        static_cast<float>(min_val),
+        static_cast<float>(max_val),
+        stream);
+
+    // Check for kernel launch errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "hardtanh_clamp kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+torch::Tensor mean_channel_forward(torch::Tensor input) {
+    TORCH_CHECK(input.is_cuda(), "mean_channel: input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "mean_channel: input must be float32");
+    TORCH_CHECK(input.dim() == 4, "mean_channel: input must be 4D (N,C,H,W)");
+
+    // Ensure contiguous
+    auto input_contig = input.contiguous();
+    int64_t N = input_contig.size(0);
+    int64_t C = input_contig.size(1);
+    int64_t H = input_contig.size(2);
+    int64_t W = input_contig.size(3);
+
+    TORCH_CHECK(C > 0, "mean_channel: channel dimension must be positive");
+
+    // Allocate output shape [N, 1, H, W]
+    auto output = torch::empty({N, 1, H, W}, input_contig.options());
+
+    if (N == 0 || H == 0 || W == 0) {
+        return output;
+    }
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    mean_channel_launcher(
+        input_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C, H, W,
+        stream);
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "mean_channel kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("hardtanh_clamp", &hardtanh_clamp_forward,
+          "Elementwise hardtanh clamp",
+          py::arg("input"),
+          py::arg("min_val") = -1.0,
+          py::arg("max_val") = 1.0);
+    m.def("mean_channel", &mean_channel_forward,
+          "Mean over channel dimension (dim=1, keepdim=True)",
+          py::arg("input"));
+}
+
+} // namespace
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
