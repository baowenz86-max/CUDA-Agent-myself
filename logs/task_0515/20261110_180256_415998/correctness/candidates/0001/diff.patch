+// kernels/custom_ops.cu
+// CUDA kernels and launchers for custom operations.
+// This file contains only CUDA kernels and host launchers with raw pointers.
+// No PyTorch/Tensor dependencies.
+
+#include <cuda_runtime.h>
+#include <cublas_v2.h>
+
+// -----------------------------------------------------------------------------
+// adaptive_avg_pool2d
+// -----------------------------------------------------------------------------
+// Computes adaptive average pooling for 4D input (N, C, H, W)
+// with output size (outH, outW).
+// Each output element at (n, c, oh, ow) averages over the window
+// [start_h, end_h) x [start_w, end_w) where
+// start_h = floor(oh * H / outH), end_h = ceil((oh+1) * H / outH)
+// similarly for width.
+
+template <typename scalar_t>
+__global__ void adaptive_avg_pool2d_kernel(
+    const scalar_t* __restrict__ input,
+    scalar_t* __restrict__ output,
+    int N, int C, int H, int W,
+    int outH, int outW,
+    int total_elements) {
+
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= total_elements) return;
+
+    // Index decomposition: output is contiguous [N, C, outH, outW]
+    int ow = idx % outW;
+    int oh = (idx / outW) % outH;
+    int c = (idx / (outW * outH)) % C;
+    int n = idx / (outW * outH * C);
+
+    int start_h = (int)floor((float)oh * H / outH);
+    int end_h = (int)ceil((float)(oh + 1) * H / outH);
+    int start_w = (int)floor((float)ow * W / outW);
+    int end_w = (int)ceil((float)(ow + 1) * W / outW);
+
+    if (end_h > H) end_h = H;
+    if (end_w > W) end_w = W;
+    if (start_h < 0) start_h = 0;
+    if (start_w < 0) start_w = 0;
+    if (end_h <= start_h) end_h = start_h + 1;
+    if (end_w <= start_w) end_w = start_w + 1;
+
+    scalar_t sum = 0;
+    int count = 0;
+    const scalar_t* input_base = input + ((n * C + c) * H) * W;
+    for (int h = start_h; h < end_h; ++h) {
+        const scalar_t* row = input_base + h * W;
+        for (int w = start_w; w < end_w; ++w) {
+            sum += row[w];
+            ++count;
+        }
+    }
+    output[idx] = sum / (scalar_t)count;
+}
+
+// Launcher for float32 (only dtype used in contract)
+extern "C" void adaptive_avg_pool2d_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    int outH, int outW,
+    cudaStream_t stream) {
+
+    int total_elements = N * C * outH * outW;
+    int block_size = 256;
+    int grid_size = (total_elements + block_size - 1) / block_size;
+
+    adaptive_avg_pool2d_kernel<float><<<grid_size, block_size, 0, stream>>>(
+        input, output, N, C, H, W, outH, outW, total_elements);
+}
+
+// -----------------------------------------------------------------------------
+// view_flatten
+// -----------------------------------------------------------------------------
+// Since view returns a view, it must be done in binding.cpp with Tensor::view.
+// This .cu cannot implement it without Tensor operations.
+// We provide a dummy launcher declaration that binding can ignore or not use.
+// However, for completeness, we could implement a copy-based flatten if desired,
+// but contract says "No copy is performed; returns a view".
+// So we do not implement any CUDA kernel for view_flatten. The binding layer
+// will directly return x.view({batch_size, -1}) without calling CUDA.
+// To satisfy the requirement that each operator has a launcher, we define a
+// no-op launcher that does nothing, but it should not be called by binding.
+extern "C" void view_flatten_launcher(
+    const float* input, float* output, int batch_size, int num_features,
+    cudaStream_t stream) {
+    // This is intentionally a no-op placeholder; actual view is done in C++.
+    // It will not be used in the binding since binding directly returns a view.
+}
+
+// -----------------------------------------------------------------------------
+// bias_add kernel (for linear_forward after GEMM)
+// -----------------------------------------------------------------------------
+template <typename scalar_t>
+__global__ void bias_add_kernel(
+    scalar_t* __restrict__ output,
+    const scalar_t* __restrict__ bias,
+    int batch,
+    int out_features,
+    int total_elements) {
+
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= total_elements) return;
+
+    int col = idx % out_features;
+    output[idx] += bias[col];
+}
+
+// -----------------------------------------------------------------------------
+// linear_forward
+// -----------------------------------------------------------------------------
+// Computes output = input @ weight^T + bias using cuBLAS GEMM.
+// input: [batch, in_features]
+// weight: [out_features, in_features]
+// bias: [out_features] (may be null)
+// output: [batch, out_features]
+// Uses CUBLAS_OP_T for weight to perform X * W^T.
+
+extern "C" void linear_launcher(
+    const float* input,
+    const float* weight,
+    const float* bias,
+    float* output,
+    int batch,
+    int in_features,
+    int out_features,
+    cudaStream_t stream) {
+
+    cublasHandle_t handle;
+    cublasCreate(&handle);
+    cublasSetStream(handle, stream);
+
+    const float alpha = 1.0f;
+    const float beta = 0.0f;
+
+    // Perform GEMM: C = alpha * A * B + beta * C
+    // A is input [batch, in_features], B is weight^T [in_features, out_features]
+    // So we set: op(A)=CUBLAS_OP_N, op(B)=CUBLAS_OP_T
+    // lda = in_features, ldb = in_features, ldc = out_features
+    cublasSgemm(
+        handle,
+        CUBLAS_OP_N, CUBLAS_OP_T,
+        batch, out_features, in_features,
+        &alpha,
+        input, in_features,
+        weight, in_features,
+        &beta,
+        output, out_features);
+
+    // Add bias if present
+    if (bias != nullptr) {
+        int total_elements = batch * out_features;
+        int block_size = 256;
+        int grid_size = (total_elements + block_size - 1) / block_size;
+        bias_add_kernel<float><<<grid_size, block_size, 0, stream>>>(
+            output, bias, batch, out_features, total_elements);
+    }
+
+    cublasDestroy(handle);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,152 @@
+// kernels/custom_ops_binding.cpp
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void adaptive_avg_pool2d_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    int outH, int outW,
+    cudaStream_t stream);
+
+extern "C" void linear_launcher(
+    const float* input,
+    const float* weight,
+    const float* bias,
+    float* output,
+    int batch,
+    int in_features,
+    int out_features,
+    cudaStream_t stream);
+
+// Since view_flatten is a view, we do not call any launcher.
+// The placeholder launcher in .cu is not used; we directly return a view.
+
+// -----------------------------------------------------------------------------
+// adaptive_avg_pool2d_forward
+// -----------------------------------------------------------------------------
+torch::Tensor adaptive_avg_pool2d_forward(
+    torch::Tensor x,
+    int64_t output_h,
+    int64_t output_w) {
+    
+    // Input checks
+    TORCH_CHECK(x.is_cuda(), "Input x must be a CUDA tensor");
+    TORCH_CHECK(x.dim() == 4, "Input x must be 4D (N, C, H, W)");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input x must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input x must be contiguous");
+    TORCH_CHECK(output_h > 0 && output_w > 0, "output_h and output_w must be positive");
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+
+    auto output = torch::empty({N, C, output_h, output_w}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    adaptive_avg_pool2d_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C, H, W,
+        static_cast<int>(output_h),
+        static_cast<int>(output_w),
+        stream
+    );
+
+    return output;
+}
+
+// -----------------------------------------------------------------------------
+// view_flatten_forward
+// -----------------------------------------------------------------------------
+torch::Tensor view_flatten_forward(
+    torch::Tensor x,
+    int64_t batch_size) {
+
+    TORCH_CHECK(x.is_cuda(), "Input x must be a CUDA tensor");
+    TORCH_CHECK(x.dim() >= 1, "Input x must have at least 1 dimension");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input x must be float32");
+
+    // x.view(batch_size, -1)
+    auto output = x.view({batch_size, -1});
+    return output;
+}
+
+// -----------------------------------------------------------------------------
+// linear_forward
+// -----------------------------------------------------------------------------
+torch::Tensor linear_forward(
+    torch::Tensor input,
+    torch::Tensor weight,
+    c10::optional<torch::Tensor> bias) {
+
+    // Input checks
+    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(weight.is_cuda(), "Weight must be a CUDA tensor");
+    TORCH_CHECK(input.dim() == 2, "Input must be 2D [batch, in_features]");
+    TORCH_CHECK(weight.dim() == 2, "Weight must be 2D [out_features, in_features]");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(weight.dtype() == torch::kFloat32, "Weight must be float32");
+    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(weight.is_contiguous(), "Weight must be contiguous");
+
+    int batch = input.size(0);
+    int in_features = input.size(1);
+    int out_features = weight.size(0);
+    TORCH_CHECK(weight.size(1) == in_features, "Weight in_features must match input in_features");
+
+    torch::Tensor bias_tensor;
+    if (bias.has_value()) {
+        bias_tensor = bias.value();
+        TORCH_CHECK(bias_tensor.is_cuda(), "Bias must be a CUDA tensor");
+        TORCH_CHECK(bias_tensor.dim() == 1, "Bias must be 1D [out_features]");
+        TORCH_CHECK(bias_tensor.size(0) == out_features, "Bias size must match out_features");
+        TORCH_CHECK(bias_tensor.dtype() == torch::kFloat32, "Bias must be float32");
+        TORCH_CHECK(bias_tensor.is_contiguous(), "Bias must be contiguous");
+    }
+
+    auto output = torch::empty({batch, out_features}, input.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    const float* bias_ptr = nullptr;
+    if (bias.has_value()) {
+        bias_ptr = bias_tensor.data_ptr<float>();
+    }
+
+    linear_launcher(
+        input.data_ptr<float>(),
+        weight.data_ptr<float>(),
+        bias_ptr,
+        output.data_ptr<float>(),
+        batch,
+        in_features,
+        out_features,
+        stream
+    );
+
+    return output;
+}
+
+// -----------------------------------------------------------------------------
+// Registration
+// -----------------------------------------------------------------------------
+void register_custom_ops(pybind11::module& m) {
+    m.def("adaptive_avg_pool2d_forward", &adaptive_avg_pool2d_forward,
+          "Adaptive average pooling forward",
+          py::arg("x"), py::arg("output_h"), py::arg("output_w"));
+    m.def("view_flatten_forward", &view_flatten_forward,
+          "View flatten forward",
+          py::arg("x"), py::arg("batch_size"));
+    m.def("linear_forward", &linear_forward,
+          "Linear forward with cuBLAS",
+          py::arg("input"), py::arg("weight"), py::arg("bias"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,25 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, out_channels, kernel_size, stride, padding, ceil_mode):
+        super().__init__()
+        self.adaptive_avg_pool = nn.AdaptiveAvgPool2d(kernel_size)
+        self.linear = nn.Linear(in_channels * kernel_size[0] * kernel_size[1], out_channels)
+
+    def forward(self, x):
+        x = cuda_extension.adaptive_avg_pool2d_forward(x, self.adaptive_avg_pool.output_size[0], self.adaptive_avg_pool.output_size[1])
+        x = cuda_extension.view_flatten_forward(x, x.size(0))
+        x = cuda_extension.linear_forward(x, self.linear.weight, self.linear.bias)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.adaptive_avg_pool2d_forward(x, self.adaptive_avg_pool.output_size[0], self.adaptive_avg_pool.output_size[1])
+        yield 'step_001', x
+        x = cuda_extension.view_flatten_forward(x, x.size(0))
+        yield 'step_002', x
+        x = cuda_extension.linear_forward(x, self.linear.weight, self.linear.bias)
+        yield 'step_003', x
+        yield 'step_004', x
