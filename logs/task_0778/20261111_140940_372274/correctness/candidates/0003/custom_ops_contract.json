        "参数 kernel_size=3, stride=3, padding=0, dilation=1, ceil_mode=False",
        "输出 x 为 CUDA float32 [16,128,5461]，连续存储"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return (x, mask)",
      "semantics": [
        "返回元组 (pooled_x, mask)，pooled_x 为 step_002 的输出，mask 为 step_001 的输出",
        "元组结构、顺序、shape、dtype、device 均与参考一致"
      ]
    }
