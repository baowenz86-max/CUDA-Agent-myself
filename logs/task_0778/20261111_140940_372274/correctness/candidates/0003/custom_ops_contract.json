  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "mask = torch.isin(x, self.isin_values)",
      "semantics": [
        "输入 x 为 CUDA float32 [16,128,16384]，self.isin_values 为 CPU float32 [3]（实际扩展中转换为 CUDA）",
        "逐元素检查 x 中的值是否等于 values 中任一值，结果 mask 为 CUDA bool [16,128,16384]",
        "保留输入 shape，输出与输入相同 stride 布局"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.max_pool(x)",
      "semantics": [
