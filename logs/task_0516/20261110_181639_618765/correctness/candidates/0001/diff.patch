--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,143 @@
+#include <cuda_runtime.h>
+#include <math.h>
+
+// Group normalization kernel: normalizes input over (channels_per_group, height, width)
+// Each block handles one (batch, group) pair, computing mean and variance then normalizing.
+// Supports arbitrary strides via linear indexing using input strides provided by launcher.
+// Since input may be non-contiguous, launcher passes strides; kernel uses offset calculation for each element.
+
+__global__ void group_norm_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    const float* __restrict__ weight,
+    const float* __restrict__ bias,
+    int64_t batch_size,
+    int64_t channels,
+    int64_t height,
+    int64_t width,
+    int64_t num_groups,
+    int64_t channels_per_group,
+    int64_t input_stride_batch,
+    int64_t input_stride_channel,
+    int64_t input_stride_height,
+    int64_t output_stride_batch,
+    int64_t output_stride_channel,
+    int64_t output_stride_height,
+    double eps
+) {
+    // blockIdx.x = batch index, blockIdx.y = group index
+    int64_t batch = blockIdx.x;
+    int64_t group = blockIdx.y;
+    
+    int64_t group_size = channels_per_group * height * width;
+    int64_t tid = threadIdx.x;
+    int64_t block_dim = blockDim.x;
+    
+    // First pass: compute sum and sum of squares using block reduction.
+    // We'll use shared memory for reduction.
+    extern __shared__ double sdata[];
+    double* s_sum = sdata;
+    double* s_sumsq = sdata + block_dim;
+    
+    double local_sum = 0.0;
+    double local_sumsq = 0.0;
+    for (int64_t idx = tid; idx < group_size; idx += block_dim) {
+        // Decompose idx into channel within group, h, w
+        int64_t c_in_group = idx / (height * width);
+        int64_t rem = idx % (height * width);
+        int64_t h = rem / width;
+        int64_t w = rem % width;
+        int64_t channel = group * channels_per_group + c_in_group;
+        int64_t input_offset = batch * input_stride_batch + channel * input_stride_channel + h * input_stride_height + w;
+        float val = input[input_offset];
+        local_sum += (double)val;
+        local_sumsq += (double)val * val;
+    }
+    
+    s_sum[tid] = local_sum;
+    s_sumsq[tid] = local_sumsq;
+    __syncthreads();
+    
+    // Reduction (assuming block_dim is power of 2)
+    for (int64_t stride = block_dim / 2; stride > 0; stride >>= 1) {
+        if (tid < stride) {
+            s_sum[tid] += s_sum[tid + stride];
+            s_sumsq[tid] += s_sumsq[tid + stride];
+        }
+        __syncthreads();
+    }
+    
+    double mean = s_sum[0] / (double)group_size;
+    double var = s_sumsq[0] / (double)group_size - mean * mean;
+    double inv_std = rsqrt((double)var + eps);
+    
+    // Second pass: normalize each element
+    for (int64_t idx = tid; idx < group_size; idx += block_dim) {
+        int64_t c_in_group = idx / (height * width);
+        int64_t rem = idx % (height * width);
+        int64_t h = rem / width;
+        int64_t w = rem % width;
+        int64_t channel = group * channels_per_group + c_in_group;
+        int64_t input_offset = batch * input_stride_batch + channel * input_stride_channel + h * input_stride_height + w;
+        int64_t output_offset = batch * output_stride_batch + channel * output_stride_channel + h * output_stride_height + w;
+        float norm_val = (float)(((double)input[input_offset] - mean) * inv_std);
+        if (weight != nullptr) {
+            norm_val *= weight[channel];
+        }
+        if (bias != nullptr) {
+            norm_val += bias[channel];
+        }
+        output[output_offset] = norm_val;
+    }
+}
+
+// Launcher function (C-linkage)
+extern "C" void group_norm_forward_launcher(
+    float* output,
+    const float* input,
+    int64_t batch_size,
+    int64_t channels,
+    int64_t height,
+    int64_t width,
+    int64_t num_groups,
+    const float* weight,
+    const float* bias,
+    double eps,
+    int64_t input_stride_batch,
+    int64_t input_stride_channel,
+    int64_t input_stride_height,
+    int64_t output_stride_batch,
+    int64_t output_stride_channel,
+    int64_t output_stride_height,
+    cudaStream_t stream
+) {
+    int64_t channels_per_group = channels / num_groups;
+    int64_t group_size = channels_per_group * height * width;
+    
+    // Choose block size: 256 threads, each block computes one (batch, group)
+    int block_dim = 256;
+    // Shared memory: two arrays of double size block_dim
+    size_t shared_mem_size = 2 * block_dim * sizeof(double);
+    
+    dim3 grid((unsigned int)batch_size, (unsigned int)num_groups, 1);
+    
+    group_norm_kernel<<<grid, block_dim, shared_mem_size, stream>>>(
+        output,
+        input,
+        weight,
+        bias,
+        batch_size,
+        channels,
+        height,
+        width,
+        num_groups,
+        channels_per_group,
+        input_stride_batch,
+        input_stride_channel,
+        input_stride_height,
+        output_stride_batch,
+        output_stride_channel,
+        output_stride_height,
+        eps
+    );
+}
--- before/kernels/group_norm_binding.cpp
+++ after/kernels/group_norm_binding.cpp
@@ -0,0 +1,116 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_runtime.h>
+#include "../binding_registry.h"
+
+// Declaration of launcher from custom_ops.cu
+extern "C" void group_norm_forward_launcher(
+    float* output,
+    const float* input,
+    int64_t batch_size,
+    int64_t channels,
+    int64_t height,
+    int64_t width,
+    int64_t num_groups,
+    const float* weight,
+    const float* bias,
+    double eps,
+    int64_t input_stride_batch,
+    int64_t input_stride_channel,
+    int64_t input_stride_height,
+    int64_t output_stride_batch,
+    int64_t output_stride_channel,
+    int64_t output_stride_height,
+    cudaStream_t stream
+);
+
+torch::Tensor group_norm_forward(
+    torch::Tensor input,
+    int64_t num_groups,
+    c10::optional<torch::Tensor> weight,
+    c10::optional<torch::Tensor> bias,
+    double eps) {
+    // Validate input
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(input.dim() == 4, "input must be 4D: [batch, channels, height, width]");
+    TORCH_CHECK(num_groups > 0, "num_groups must be positive");
+    int64_t channels = input.size(1);
+    TORCH_CHECK(channels % num_groups == 0, "channels must be divisible by num_groups");
+
+    // Validate optional weight and bias
+    const float* weight_ptr = nullptr;
+    const float* bias_ptr = nullptr;
+    if (weight.has_value()) {
+        TORCH_CHECK(weight->is_cuda(), "weight must be a CUDA tensor");
+        TORCH_CHECK(weight->dtype() == torch::kFloat32, "weight must be float32");
+        TORCH_CHECK(weight->is_contiguous(), "weight must be contiguous");
+        TORCH_CHECK(weight->numel() == channels, "weight must have exactly channels elements");
+        weight_ptr = weight->data_ptr<float>();
+    }
+    if (bias.has_value()) {
+        TORCH_CHECK(bias->is_cuda(), "bias must be a CUDA tensor");
+        TORCH_CHECK(bias->dtype() == torch::kFloat32, "bias must be float32");
+        TORCH_CHECK(bias->is_contiguous(), "bias must be contiguous");
+        TORCH_CHECK(bias->numel() == channels, "bias must have exactly channels elements");
+        bias_ptr = bias->data_ptr<float>();
+    }
+
+    // Output: same shape as input. Use empty_like to preserve strides/layout, but ensure contiguous data? 
+    // The launcher writes output using output strides; if input is non-contiguous, output should match input stride to satisfy contract.
+    // However, cuda kernel writes with provided strides; output tensor can be non-contiguous matching input strides.
+    auto output = torch::empty_like(input);
+
+    int64_t batch_size = input.size(0);
+    int64_t height = input.size(2);
+    int64_t width = input.size(3);
+
+    int64_t input_stride_batch = input.stride(0);
+    int64_t input_stride_channel = input.stride(1);
+    int64_t input_stride_height = input.stride(2);
+    int64_t output_stride_batch = output.stride(0);
+    int64_t output_stride_channel = output.stride(1);
+    int64_t output_stride_height = output.stride(2);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    group_norm_forward_launcher(
+        output.data_ptr<float>(),
+        input.data_ptr<float>(),
+        batch_size,
+        channels,
+        height,
+        width,
+        num_groups,
+        weight_ptr,
+        bias_ptr,
+        eps,
+        input_stride_batch,
+        input_stride_channel,
+        input_stride_height,
+        output_stride_batch,
+        output_stride_channel,
+        output_stride_height,
+        stream
+    );
+
+    // Check for kernel launch errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "group_norm kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+void register_group_norm(pybind11::module& m) {
+    m.def("group_norm_forward", &group_norm_forward,
+          "Group normalization forward",
+          py::arg("input"),
+          py::arg("num_groups"),
+          py::arg("weight"),
+          py::arg("bias"),
+          py::arg("eps"));
+}
+
+REGISTER_BINDING(group_norm, register_group_norm);
