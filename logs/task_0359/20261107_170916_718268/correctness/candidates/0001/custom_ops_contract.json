          "device": "cuda",
          "shape": "[num_embeddings, embedding_dim]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "input_ids",
          "kind": "tensor",
          "dtype": "torch.int64",
          "device": "cuda",
          "shape": "[batch_size, input_seq_len]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, input_seq_len, embedding_dim]"
      },
      "semantics": [
        "对应参考语句 embedded = self.embedding(input_ids)，执行标准 embedding 查表：output[b, s, d] = weight[input_ids[b, s], d]",
        "input_ids 为 int64 CUDA tensor，weight 为 float32 CUDA tensor；输入形状 [64, 2048]，权重形状 [10000, 1024]，输出形状 [64, 2048, 1024]"
      ]
    },
    {
      "name": "index_select_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, input_seq_len, embedding_dim]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "index",
          "kind": "tensor",
          "dtype": "torch.int64",
          "device": "cuda",
          "shape": "[index_len]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, index_len, embedding_dim]"
      },
      "semantics": [
        "对应参考语句 index_selected = torch.index_select(embedded, dim, index)，沿指定维度 dim 按 index 选择切片；output[b, i, d] = input[b, index[i], d]",
        "dim 为 1，input 形状 [64, 2048, 1024]，index 长度 1024，输出形状 [64, 1024, 1024]；int64 索引 tensor 与 float32 输入 tensor 均为 CUDA tensor"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "embedded = self.embedding(input_ids)",
      "semantics": [
