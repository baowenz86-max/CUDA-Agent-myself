      ]
    },
    {
      "checkpoint": "step_002",
      "source": "index_selected = torch.index_select(embedded, dim, index)",
      "semantics": [
        "执行 index_select_forward(embedded, dim, index)，输出 [64, 1024, 1024] float32 CUDA tensor"
      ]
    },
    {
