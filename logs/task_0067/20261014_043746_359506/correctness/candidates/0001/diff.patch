--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,104 @@
+#include <cuda_runtime.h>
+
+// ELU activation: f(x) = x if x > 0 else alpha * (exp(x) - 1), alpha=1.0
+__global__ void elu_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    long long numel)
+{
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+    for (long long i = idx; i < numel; i += stride) {
+        float x = input[i];
+        output[i] = (x > 0.0f) ? x : (expf(x) - 1.0f);
+    }
+}
+
+// Mean over channel dimension (dim=1) with keepdim=True.
+// Input shape: [N, C, H, W] (C=3), output shape: [N, 1, H, W].
+// This kernel assumes input is contiguous, but can handle non-contiguous by using strides if needed.
+// For simplicity and performance, we use the contiguous case: input is contiguous as per contract.
+__global__ void mean_dim1_keepdim_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    int N, int C, int H, int W)
+{
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long total = (long long)N * H * W;
+    long long stride = (long long)blockDim.x * gridDim.x;
+    for (long long i = idx; i < total; i += stride) {
+        int n = i / (H * W);
+        int hw = i % (H * W);
+        int h = hw / W;
+        int w = hw % W;
+        float sum = 0.0f;
+        for (int c = 0; c < C; ++c) {
+            // input is contiguous with shape [N, C, H, W]
+            long long input_idx = ((long long)n * C + c) * (H * W) + hw;
+            sum += input[input_idx];
+        }
+        output[i] = sum / C;
+    }
+}
+
+// Add scalar (broadcast) to every element of input tensor.
+// scalar is a single float value at scalar_ptr[0].
+__global__ void add_scalar_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    const float* __restrict__ scalar,
+    long long numel)
+{
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+    float s = scalar[0];
+    for (long long i = idx; i < numel; i += stride) {
+        output[i] = input[i] + s;
+    }
+}
+
+// Launcher for elementwise ELU.
+// output and input are raw pointers to float32 CUDA memory.
+extern "C" void elu_forward_launcher(
+    float* output,
+    const float* input,
+    long long numel,
+    cudaStream_t stream)
+{
+    int threads = 256;
+    long long blocks_ll = (numel + threads - 1) / threads;
+    if (blocks_ll > 65535) blocks_ll = 65535; // grid cap, grid-stride loop handles rest
+    int blocks = (int)blocks_ll;
+    elu_kernel<<<blocks, threads, 0, stream>>>(output, input, numel);
+}
+
+// Launcher for mean over dim=1 with keepdim.
+// Input must be contiguous with shape [N, C, H, W].
+extern "C" void mean_dim1_keepdim_launcher(
+    float* output,
+    const float* input,
+    int N, int C, int H, int W,
+    cudaStream_t stream)
+{
+    int threads = 256;
+    long long total = (long long)N * H * W;
+    long long blocks_ll = (total + threads - 1) / threads;
+    if (blocks_ll > 65535) blocks_ll = 65535;
+    int blocks = (int)blocks_ll;
+    mean_dim1_keepdim_kernel<<<blocks, threads, 0, stream>>>(output, input, N, C, H, W);
+}
+
+// Launcher for add scalar.
+extern "C" void add_scalar_launcher(
+    float* output,
+    const float* input,
+    const float* scalar,
+    long long numel,
+    cudaStream_t stream)
+{
+    int threads = 256;
+    long long blocks_ll = (numel + threads - 1) / threads;
+    if (blocks_ll > 65535) blocks_ll = 65535;
+    int blocks = (int)blocks_ll;
+    add_scalar_kernel<<<blocks, threads, 0, stream>>>(output, input, scalar, numel);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,85 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void elu_forward_launcher(
+    float* output,
+    const float* input,
+    long long numel,
+    cudaStream_t stream);
+
+extern "C" void mean_dim1_keepdim_launcher(
+    float* output,
+    const float* input,
+    int N, int C, int H, int W,
+    cudaStream_t stream);
+
+extern "C" void add_scalar_launcher(
+    float* output,
+    const float* input,
+    const float* scalar,
+    long long numel,
+    cudaStream_t stream);
+
+static void check_cuda_float_contiguous(const torch::Tensor& t, const char* name) {
+    TORCH_CHECK(t.is_cuda(), name, " must be a CUDA tensor");
+    TORCH_CHECK(t.dtype() == torch::kFloat32, name, " must be float32");
+    TORCH_CHECK(t.is_contiguous(), name, " must be contiguous");
+}
+
+torch::Tensor elu_forward(torch::Tensor input) {
+    check_cuda_float_contiguous(input, "input");
+    auto output = torch::empty_like(input);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    elu_forward_launcher(
+        output.data_ptr<float>(),
+        input.data_ptr<float>(),
+        input.numel(),
+        stream);
+    return output;
+}
+
+torch::Tensor mean_dim1_keepdim_forward(torch::Tensor input) {
+    check_cuda_float_contiguous(input, "input");
+    TORCH_CHECK(input.dim() == 4, "mean_dim1_keepdim_forward expects 4D tensor [N,C,H,W]");
+    int N = input.size(0);
+    int C = input.size(1);
+    int H = input.size(2);
+    int W = input.size(3);
+    TORCH_CHECK(C > 0, "Channel dimension must be positive");
+
+    auto output = torch::empty({N, 1, H, W}, input.options());
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    mean_dim1_keepdim_launcher(
+        output.data_ptr<float>(),
+        input.data_ptr<float>(),
+        N, C, H, W,
+        stream);
+    return output;
+}
+
+torch::Tensor add_scalar_forward(torch::Tensor input, torch::Tensor scalar) {
+    check_cuda_float_contiguous(input, "input");
+    check_cuda_float_contiguous(scalar, "scalar");
+    TORCH_CHECK(scalar.numel() == 1, "scalar must have exactly one element");
+    auto output = torch::empty_like(input);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    add_scalar_launcher(
+        output.data_ptr<float>(),
+        input.data_ptr<float>(),
+        scalar.data_ptr<float>(),
+        input.numel(),
+        stream);
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("elu_forward", &elu_forward, "ELU activation forward");
+    m.def("mean_dim1_keepdim_forward", &mean_dim1_keepdim_forward, "Mean over dim=1 with keepdim=True");
+    m.def("add_scalar_forward", &add_scalar_forward, "Add scalar to every element");
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,24 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.mean = nn.Parameter(torch.randn(1))
+
+    def forward(self, x):
+        x = cuda_extension.elu_forward(x)
+        x = cuda_extension.mean_dim1_keepdim_forward(x)
+        x = cuda_extension.add_scalar_forward(x, self.mean)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.elu_forward(x)
+        yield 'step_001', x
+        x = cuda_extension.mean_dim1_keepdim_forward(x)
+        yield 'step_002', x
+        x = cuda_extension.add_scalar_forward(x, self.mean)
+        yield 'step_003', x
+        yield 'step_004', x
