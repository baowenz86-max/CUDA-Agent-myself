--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,79 @@
+#include <cuda_runtime.h>
+#include <device_launch_parameters.h>
+
+// Softmax kernel along the last dimension (dim=2)
+// Each thread processes one row (B*H rows total), computing softmax over W elements.
+// The row index = blockIdx.x * blockDim.x + threadIdx.x, with grid-stride loop if rows > total threads launched.
+__global__ void softmax_dim2_kernel(float* __restrict__ output, const float* __restrict__ input, int B, int H, int W) {
+    int total_rows = B * H;
+    for (int row = blockIdx.x * blockDim.x + threadIdx.x; row < total_rows; row += gridDim.x * blockDim.x) {
+        const float* in_row = input + (long long)row * W;
+        float* out_row = output + (long long)row * W;
+
+        // Find max for numerical stability
+        float max_val = in_row[0];
+        for (int i = 1; i < W; ++i) {
+            max_val = fmaxf(max_val, in_row[i]);
+        }
+
+        // Compute denominator sum of exp(x - max)
+        float sum = 0.0f;
+        for (int i = 0; i < W; ++i) {
+            sum += __expf(in_row[i] - max_val);
+        }
+
+        // Write normalized outputs
+        float inv_sum = 1.0f / sum;
+        for (int i = 0; i < W; ++i) {
+            out_row[i] = __expf(in_row[i] - max_val) * inv_sum;
+        }
+    }
+}
+
+// ELU kernel, vectorized with float4 for better memory throughput
+__global__ void elu_kernel(float* __restrict__ output, const float* __restrict__ input, int numel, float alpha) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = gridDim.x * blockDim.x;
+
+    // Vectorized portion (process 4 floats at a time)
+    int vec_count = numel / 4;
+    for (int i = idx; i < vec_count; i += stride) {
+        int base = i * 4;
+        float4 in_vec = reinterpret_cast<const float4*>(input)[i];
+        float4 out_vec;
+        out_vec.x = in_vec.x > 0.0f ? in_vec.x : alpha * (__expf(in_vec.x) - 1.0f);
+        out_vec.y = in_vec.y > 0.0f ? in_vec.y : alpha * (__expf(in_vec.y) - 1.0f);
+        out_vec.z = in_vec.z > 0.0f ? in_vec.z : alpha * (__expf(in_vec.z) - 1.0f);
+        out_vec.w = in_vec.w > 0.0f ? in_vec.w : alpha * (__expf(in_vec.w) - 1.0f);
+        reinterpret_cast<float4*>(output)[i] = out_vec;
+    }
+
+    // Handle remaining elements (numel % 4 != 0)
+    for (int i = vec_count * 4 + idx; i < numel; i += stride) {
+        float x = input[i];
+        output[i] = x > 0.0f ? x : alpha * (__expf(x) - 1.0f);
+    }
+}
+
+// Launchers with clear C linkage for binding layer
+extern "C" cudaError_t softmax_dim2_launcher(float* output, const float* input, int B, int H, int W, cudaStream_t stream) {
+    int total_rows = B * H;
+    int block_size = 256;
+    int grid_size = (total_rows + block_size - 1) / block_size;
+    // Limit grid size to reasonable max, grid-stride loop handles rest
+    int max_blocks = 65535;
+    if (grid_size > max_blocks) grid_size = max_blocks;
+
+    softmax_dim2_kernel<<<grid_size, block_size, 0, stream>>>(output, input, B, H, W);
+    return cudaGetLastError();
+}
+
+extern "C" cudaError_t elu_launcher(float* output, const float* input, int numel, float alpha, cudaStream_t stream) {
+    int block_size = 256;
+    int grid_size = (numel + block_size - 1) / block_size;
+    int max_blocks = 65535;
+    if (grid_size > max_blocks) grid_size = max_blocks;
+
+    elu_kernel<<<grid_size, block_size, 0, stream>>>(output, input, numel, alpha);
+    return cudaGetLastError();
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,89 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Launcher declarations from custom_ops.cu
+extern "C" cudaError_t softmax_dim2_launcher(
+    float* output,
+    const float* input,
+    int B,
+    int H,
+    int W,
+    cudaStream_t stream
+);
+
+extern "C" cudaError_t elu_launcher(
+    float* output,
+    const float* input,
+    int numel,
+    float alpha,
+    cudaStream_t stream
+);
+
+namespace {
+
+void check_cuda_float_contiguous(const torch::Tensor& t, const std::string& name) {
+    TORCH_CHECK(t.is_cuda(), name, " must be a CUDA tensor");
+    TORCH_CHECK(t.dtype() == torch::kFloat32, name, " must be float32");
+    TORCH_CHECK(t.is_contiguous(), name, " must be contiguous");
+}
+
+}  // namespace
+
+torch::Tensor softmax_dim2(torch::Tensor x) {
+    check_cuda_float_contiguous(x, "x");
+    TORCH_CHECK(x.dim() == 3, "x must be 3D (B, H, W)");
+
+    int B = static_cast<int>(x.size(0));
+    int H = static_cast<int>(x.size(1));
+    int W = static_cast<int>(x.size(2));
+
+    auto output = torch::empty_like(x);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    cudaError_t err = softmax_dim2_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        B,
+        H,
+        W,
+        stream
+    );
+    TORCH_CHECK(err == cudaSuccess, "softmax_dim2_launcher failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+torch::Tensor elu(torch::Tensor x, double alpha = 1.0) {
+    check_cuda_float_contiguous(x, "x");
+    TORCH_CHECK(alpha >= 0.0, "alpha must be non-negative");
+
+    int numel = static_cast<int>(x.numel());
+    auto output = torch::empty_like(x);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    cudaError_t err = elu_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        numel,
+        static_cast<float>(alpha),
+        stream
+    );
+    TORCH_CHECK(err == cudaSuccess, "elu_launcher failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("softmax_dim2", &softmax_dim2,
+          "Softmax over last dimension (dim=2) for 3D tensor",
+          py::arg("x"));
+    m.def("elu", &elu,
+          "Elementwise ELU",
+          py::arg("x"),
+          py::arg("alpha") = 1.0);
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,20 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x):
+        x = cuda_extension.softmax_dim2(x)
+        x = cuda_extension.elu(x)
+        return x
+
+    def debug_forward(self, x):
+        x_softmax = cuda_extension.softmax_dim2(x)
+        yield ('step_001', x_softmax)
+        x_elu = cuda_extension.elu(x_softmax)
+        yield ('step_002', x_elu)
+        yield ('step_003', x_elu)
