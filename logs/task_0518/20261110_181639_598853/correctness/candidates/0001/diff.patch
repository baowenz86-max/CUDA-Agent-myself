--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,63 @@
+#include <cuda_runtime.h>
+#include <math.h>
+
+// Stable softmin kernel: softmin(x, dim) = softmax(-x, dim)
+// Input x is contiguous of shape [num_rows, feat_dim]
+// Each thread computes one row's softmin.
+__global__ void softmin_kernel(const float* __restrict__ input,
+                               float* __restrict__ output,
+                               int64_t num_rows,
+                               int64_t feat_dim) {
+    int64_t row = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+
+    for (int64_t r = row; r < num_rows; r += stride) {
+        const float* row_in = input + r * feat_dim;
+        float* row_out = output + r * feat_dim;
+
+        // Find max of -x for numerical stability
+        float max_val = -row_in[0];
+        for (int64_t j = 1; j < feat_dim; ++j) {
+            float val = -row_in[j];
+            max_val = fmaxf(max_val, val);
+        }
+
+        // Compute exp(-x - max) and sum
+        float sum = 0.0f;
+        for (int64_t j = 0; j < feat_dim; ++j) {
+            float val = expf(-row_in[j] - max_val);
+            row_out[j] = val;  // temporarily store
+            sum += val;
+        }
+
+        // Normalize
+        float inv_sum = 1.0f / sum;
+        for (int64_t j = 0; j < feat_dim; ++j) {
+            row_out[j] *= inv_sum;
+        }
+    }
+}
+
+// Launcher: assumes contiguous float32 input/output, feat_dim > 0.
+// num_rows = total number of rows (e.g., batch * seq_len).
+extern "C" void softmin_forward_launcher(const float* input,
+                                         float* output,
+                                         int64_t num_rows,
+                                         int64_t feat_dim,
+                                         cudaStream_t stream) {
+    if (num_rows == 0 || feat_dim == 0) return;
+
+    const int block_size = 256;
+    // Grid size: enough to cover rows, but not exceed max grid dimension (65535 in x)
+    int64_t grid_size = (num_rows + block_size - 1) / block_size;
+    if (grid_size > 65535) grid_size = 65535;
+
+    softmin_kernel<<<(unsigned int)grid_size, block_size, 0, stream>>>(
+        input, output, num_rows, feat_dim);
+
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // In a real binding, we would throw; here we ignore since no exception support.
+        // The binding layer should check cudaGetLastError after launcher returns.
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,88 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launcher from .cu file
+extern "C" void softmin_forward_launcher(const float* input,
+                                         float* output,
+                                         int64_t num_rows,
+                                         int64_t feat_dim,
+                                         cudaStream_t stream);
+
+// PyTorch wrapper for softmin forward
+torch::Tensor softmin_forward(torch::Tensor x, int64_t dim) {
+    // Input validation
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 3, "Input must be 3-dimensional [batch, seq_len, features]");
+    TORCH_CHECK(dim >= 0 && dim < x.dim(), "dim out of range");
+
+    // Contract specifies input shape [64, 70000, 10] and dim=1
+    // We implement softmin along the last dimension (features=10) by permuting
+    // or reshaping if necessary. However, since dim is passed but launcher only
+    // handles softmin over last dim, we need to prepare accordingly.
+    // For simplicity and as per contract (dim=1), we permute so that dim=1 becomes
+    // last dimension, compute softmin, then permute back.
+    // Since input is contiguous and shape is fixed, we can use view as [batch*seq_len, features]
+    // only when dim=2 or dim=-1. For dim=1 we need to transpose.
+    
+    if (dim != 2 && dim != -1) {
+        // Move target dim to last position
+        auto perm = std::vector<int64_t>(x.dim());
+        for (int64_t i = 0; i < x.dim(); ++i) perm[i] = i;
+        perm.erase(perm.begin() + dim);
+        perm.push_back(dim);
+        x = x.permute(perm).contiguous();
+    }
+
+    int64_t feat_dim = x.size(-1);
+    int64_t num_rows = x.numel() / feat_dim;
+    auto output = torch::empty_like(x);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    softmin_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        num_rows,
+        feat_dim,
+        stream
+    );
+
+    // Check for kernel launch errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA kernel launch failed: ", cudaGetErrorString(err));
+
+    // If we permuted, permute back
+    if (dim != 2 && dim != -1) {
+        // Reconstruct original permutation
+        auto inv_perm = std::vector<int64_t>(x.dim());
+        auto perm = std::vector<int64_t>(x.dim());
+        for (int64_t i = 0; i < x.dim(); ++i) perm[i] = i;
+        perm.erase(perm.begin() + dim);
+        perm.push_back(dim);
+        for (int64_t i = 0; i < x.dim(); ++i) {
+            inv_perm[perm[i]] = i;
+        }
+        output = output.permute(inv_perm).contiguous();
+    }
+
+    return output;
+}
+
+// Registration function
+void register_softmin_forward(pybind11::module& m) {
+    m.def("softmin_forward", &softmin_forward,
+          "Softmin forward kernel",
+          py::arg("x"),
+          py::arg("dim"));
+}
+
+// Auto-register
+REGISTER_BINDING(softmin_forward, register_softmin_forward);
