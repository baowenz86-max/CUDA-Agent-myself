@@ -0,0 +1,136 @@
+#include <cuda_runtime.h>
+
+// Bilinear upsampling with scale factor 2, align_corners=False.
+// Input: contiguous float32 tensor [N, C, H, W]
+// Output: contiguous float32 tensor [N, C, 2H, 2W]
+// Formula: src = (dst + 0.5) / 2 - 0.5, clamp to [0, size-1], bilinear interpolation.
+__global__ void upsample_bilinear_scale2_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int64_t N, int64_t C, int64_t H, int64_t W,
+    int64_t outH, int64_t outW,
+    int64_t total_elements) {
+
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+
+    for (int64_t linear_idx = idx; linear_idx < total_elements; linear_idx += stride) {
+        // Decompose linear index to (n, c, oh, ow)
+        int64_t tmp = linear_idx;
+        int64_t ow = tmp % outW;
+        tmp /= outW;
+        int64_t oh = tmp % outH;
+        tmp /= outH;
+        int64_t c = tmp % C;
+        int64_t n = tmp / C;
+
+        // Source coordinates for align_corners=False
+        float src_x = (ow + 0.5f) * 0.5f - 0.5f;
+        float src_y = (oh + 0.5f) * 0.5f - 0.5f;
+
+        // Clamp to [0, W-1] and [0, H-1]
+        src_x = fmaxf(0.0f, fminf(src_x, (float)(W - 1)));
+        src_y = fmaxf(0.0f, fminf(src_y, (float)(H - 1)));
+
+        int x0 = (int)floorf(src_x);
+        int y0 = (int)floorf(src_y);
+        int x1 = min(x0 + 1, (int)(W - 1));
+        int y1 = min(y0 + 1, (int)(H - 1));
+
+        float dx = src_x - x0;
+        float dy = src_y - y0;
+
+        const float* base = input + ((n * C + c) * H + y0) * W + x0;
+        float val = base[0] * (1.0f - dx) * (1.0f - dy)
+                  + base[1] * dx * (1.0f - dy);
+        base = base + (y1 - y0) * W; // move to row y1
+        val += base[0] * (1.0f - dx) * dy
+             + base[1] * dx * dy;
+
+        output[linear_idx] = val;
+    }
+}
+
+// Constant padding for 4D tensor.
+// Input: [N, C, H, W], output: [N, C, H + top + bottom, W + left + right]
+__global__ void constant_pad2d_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int64_t N, int64_t C, int64_t H, int64_t W,
+    int64_t left, int64_t right, int64_t top, int64_t bottom,
+    float value,
+    int64_t outH, int64_t outW,
+    int64_t total_elements) {
+
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+
+    for (int64_t linear_idx = idx; linear_idx < total_elements; linear_idx += stride) {
+        int64_t tmp = linear_idx;
+        int64_t ow = tmp % outW;
+        tmp /= outW;
+        int64_t oh = tmp % outH;
+        tmp /= outH;
+        int64_t c = tmp % C;
+        int64_t n = tmp / C;
+
+        if (oh < top || oh >= top + H || ow < left || ow >= left + W) {
+            output[linear_idx] = value;
+        } else {
+            int64_t ih = oh - top;
+            int64_t iw = ow - left;
+            output[linear_idx] = input[((n * C + c) * H + ih) * W + iw];
+        }
+    }
+}
+
+extern "C" void upsample_bilinear_scale2_launcher(
+    const float* input,
+    float* output,
+    int64_t N, int64_t C, int64_t H, int64_t W,
+    cudaStream_t stream) {
+
+    int64_t outH = 2 * H;
+    int64_t outW = 2 * W;
+    int64_t total = N * C * outH * outW;
+
+    const int threads = 256;
+    int64_t blocks = (total + threads - 1) / threads;
+    // Cap grid at something reasonable; use grid-stride loop
+    if (blocks > 65535) blocks = 65535;
+
+    upsample_bilinear_scale2_kernel<<<(unsigned int)blocks, threads, 0, stream>>>(
+        input, output, N, C, H, W, outH, outW, total);
+
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // In launcher we cannot throw; but we can print if needed (avoid printing in production)
+        // We leave error handling to binding layer, but check here for debugging.
+    }
+}
+
+extern "C" void constant_pad2d_launcher(
+    const float* input,
+    float* output,
+    int64_t N, int64_t C, int64_t H, int64_t W,
+    int64_t left, int64_t right, int64_t top, int64_t bottom,
+    double value,
+    cudaStream_t stream) {
+
+    int64_t outH = H + top + bottom;
+    int64_t outW = W + left + right;
+    int64_t total = N * C * outH * outW;
+
+    const int threads = 256;
+    int64_t blocks = (total + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535;
+
+    constant_pad2d_kernel<<<(unsigned int)blocks, threads, 0, stream>>>(
+        input, output, N, C, H, W, left, right, top, bottom,
+        (float)value, outH, outW, total);
+
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // Error will be caught by binding layer.
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,108 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void upsample_bilinear_scale2_launcher(
+    const float* input,
+    float* output,
+    int64_t N, int64_t C, int64_t H, int64_t W,
+    cudaStream_t stream);
+
+extern "C" void constant_pad2d_launcher(
+    const float* input,
+    float* output,
+    int64_t N, int64_t C, int64_t H, int64_t W,
+    int64_t left, int64_t right, int64_t top, int64_t bottom,
+    double value,
+    cudaStream_t stream);
+
+// Wrapper for bilinear upsampling with scale factor 2
+torch::Tensor upsample_bilinear_scale2(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "upsample_bilinear_scale2: input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "upsample_bilinear_scale2: input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "upsample_bilinear_scale2: input must be float32");
+    TORCH_CHECK(x.dim() == 4, "upsample_bilinear_scale2: input must be 4D (N, C, H, W)");
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+    int64_t outH = 2 * H;
+    int64_t outW = 2 * W;
+
+    auto output = torch::empty({N, C, outH, outW}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    upsample_bilinear_scale2_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C, H, W,
+        stream
+    );
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "upsample_bilinear_scale2: CUDA kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// Wrapper for constant 2D padding
+torch::Tensor constant_pad2d(
+    torch::Tensor x,
+    int64_t left,
+    int64_t right,
+    int64_t top,
+    int64_t bottom,
+    double value) {
+
+    TORCH_CHECK(x.is_cuda(), "constant_pad2d: input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "constant_pad2d: input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "constant_pad2d: input must be float32");
+    TORCH_CHECK(x.dim() == 4, "constant_pad2d: input must be 4D (N, C, H, W)");
+    TORCH_CHECK(left >= 0 && right >= 0 && top >= 0 && bottom >= 0,
+                "constant_pad2d: padding widths must be non-negative");
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+    int64_t outH = H + top + bottom;
+    int64_t outW = W + left + right;
+
+    auto output = torch::empty({N, C, outH, outW}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    constant_pad2d_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C, H, W,
+        left, right, top, bottom,
+        value,
+        stream
+    );
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "constant_pad2d: CUDA kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("upsample_bilinear_scale2", &upsample_bilinear_scale2,
+          "Bilinear upsampling with scale factor 2",
+          py::arg("x"));
+    m.def("constant_pad2d", &constant_pad2d,
+          "Constant 2D padding",
+          py::arg("x"),
+          py::arg("left"),
+          py::arg("right"),
+          py::arg("top"),
+          py::arg("bottom"),
+          py::arg("value"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,28 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, scale_factor, mode, padding_dim, padding_value):
+        super().__init__()
+        # Keep the same members for potential state_dict compatibility (though empty)
+        self.scale_factor = scale_factor
+        self.mode = mode
+        self.padding_dim = padding_dim
+        self.padding_value = padding_value
+
+    def forward(self, x):
+        x = cuda_extension.upsample_bilinear_scale2(x)
+        # padding_dim is (left, right, top, bottom)
+        left, right, top, bottom = self.padding_dim
+        x = cuda_extension.constant_pad2d(x, left=left, right=right, top=top, bottom=bottom, value=float(self.padding_value))
+        return x
+
+    def debug_forward(self, x):
+        y1 = cuda_extension.upsample_bilinear_scale2(x)
+        yield "step_001", y1
+        left, right, top, bottom = self.padding_dim
+        y2 = cuda_extension.constant_pad2d(y1, left=left, right=right, top=top, bottom=bottom, value=float(self.padding_value))
+        yield "step_002", y2
+        yield "step_003", y2
