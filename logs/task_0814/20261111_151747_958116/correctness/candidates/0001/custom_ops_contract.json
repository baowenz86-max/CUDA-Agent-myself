{
  "operators": [
    {
      "name": "upsampling_bilinear2d_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "scale_factor",
          "kind": "float",
          "optional": false,
          "nullable": false
        },
        {
          "name": "align_corners",
          "kind": "bool",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C, H*scale_factor, W*scale_factor]"
      },
      "semantics": [
        "对应参考语句 x = self.upsample(x)，使用双线性插值，align_corners=False。",
        "输出高度 = floor(H * scale_factor)，输出宽度 = floor(W * scale_factor)。",
        "每个输出像素由输入中四个最近邻按双线性权重插值得到。",
        "支持任意 stride 的输入，内部处理为非连续情况（必要时进行显式连续化或按 stride 索引）。",
        "输入 dtype 必须为 float32，设备为 CUDA。"
      ]
    },
    {
      "name": "constant_pad2d_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "padding",
          "kind": "int",
          "optional": false,
          "nullable": false,
          "shape": "[4]",
          "note": "padding order is (left, right, top, bottom)"
        },
        {
          "name": "value",
          "kind": "float",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C, H + top + bottom, W + left + right]"
      },
      "semantics": [
        "对应参考语句 x = self.pad(x)，使用 ConstantPad2d 语义。",
        "在宽度两侧分别填充 left 和 right，在高度两侧分别填充 top 和 bottom。",
        "填充值为 value。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.upsample(x)",
      "semantics": [
        "输入 x 为 CUDA float32 张量，shape [256,3,64,512]。",
        "使用双线性插值，scale_factor=2, align_corners=False。",
        "输出 shape 为 [256,3,128,1024]，dtype float32，device cuda。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.pad(x)",
      "semantics": [
        "输入为上一步输出，shape [256,3,128,1024]。",
        "ConstantPad2d padding=(1,1,1,1), value=0。",
        "输出 shape 为 [256,3,130,1026]，dtype float32，device cuda。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回上一步输出。"
      ]
    }
  ]
