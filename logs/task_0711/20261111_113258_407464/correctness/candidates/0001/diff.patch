@@ -0,0 +1,142 @@
+#include <cuda_runtime.h>
+
+// -----------------------------------------------------------------------------
+// sum_channels_launcher: reduces over channel dimension (dim=1) with keepdim=true
+// Input: x shape [N, C, H, W], strides [sN, sC, sH, sW] (arbitrary, but typically contiguous)
+// Output: y shape [N, 1, H, W], contiguous (strides [H*W? Actually output is contiguous with shape [N,1,H,W] so strides [H*W, H*W, W, 1])
+// We compute each output element y[n,0,h,w] = sum_c x[n,c,h,w]
+// -----------------------------------------------------------------------------
+template <typename T>
+__global__ void sum_channels_kernel(
+    const T* __restrict__ x,
+    T* __restrict__ y,
+    int N, int C, int H, int W,
+    long long sN, long long sC, long long sH, long long sW,
+    long long total_out)  // N*H*W
+{
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+    for (; idx < total_out; idx += stride) {
+        int w = idx % W;
+        int tmp = idx / W;
+        int h = tmp % H;
+        int n = tmp / H;
+        // sum over c
+        T sum = 0;
+        const T* x_base = x + (long long)n * sN + (long long)h * sH + (long long)w * sW;
+        for (int c = 0; c < C; ++c) {
+            sum += x_base[c * sC];
+        }
+        y[idx] = sum;
+    }
+}
+
+extern "C" void sum_channels_launcher(
+    const float* x,
+    float* y,
+    int N, int C, int H, int W,
+    long long sN, long long sC, long long sH, long long sW,
+    cudaStream_t stream)
+{
+    long long total_out = (long long)N * H * W;
+    int block = 256;
+    long long grid_l = (total_out + block - 1) / block;
+    int grid = (int)min(grid_l, (long long)2147483647);
+    sum_channels_kernel<float><<<grid, block, 0, stream>>>(
+        x, y, N, C, H, W, sN, sC, sH, sW, total_out);
+}
+
+// -----------------------------------------------------------------------------
+// expand_channels_launcher: materializes x.expand(-1, channels_factor, -1, -1)
+// Input: x shape [N, 1, H, W], strides [sN, sC, sH, sW] (sC may be arbitrary since size 1, often 0 or H*W)
+// Output: y shape [N, channels_factor, H, W], contiguous
+// Each y[n,c,h,w] = x[n,0,h,w]
+// -----------------------------------------------------------------------------
+template <typename T>
+__global__ void expand_channels_kernel(
+    const T* __restrict__ x,
+    T* __restrict__ y,
+    int N, int channels_factor, int H, int W,
+    long long sN, long long sC, long long sH, long long sW,
+    long long total_out) // N*channels_factor*H*W
+{
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+    for (; idx < total_out; idx += stride) {
+        int w = idx % W;
+        int tmp = idx / W;
+        int h = tmp % H;
+        tmp /= H;
+        int c = tmp % channels_factor;
+        int n = tmp / channels_factor;
+        // read from x at [n,0,h,w]
+        const T* x_ptr = x + (long long)n * sN + (long long)0 * sC + (long long)h * sH + (long long)w * sW;
+        y[idx] = *x_ptr;
+    }
+}
+
+extern "C" void expand_channels_launcher(
+    const float* x,
+    float* y,
+    int N, int channels_factor, int H, int W,
+    long long sN, long long sC, long long sH, long long sW,
+    cudaStream_t stream)
+{
+    long long total_out = (long long)N * channels_factor * H * W;
+    int block = 256;
+    long long grid_l = (total_out + block - 1) / block;
+    int grid = (int)min(grid_l, (long long)2147483647);
+    expand_channels_kernel<float><<<grid, block, 0, stream>>>(
+        x, y, N, channels_factor, H, W, sN, sC, sH, sW, total_out);
+}
+
+// -----------------------------------------------------------------------------
+// pixel_shuffle_launcher: performs nn.PixelShuffle(r)
+// Input: x shape [N, C_in, H, W] (C_in divisible by r*r), strides [sN, sC, sH, sW]
+// Output: y shape [N, C_out, H*r, W*r] with C_out = C_in / (r*r)
+// Mapping: y[n, c_out, h*r + i, w*r + j] = x[n, c_out * r*r + i*r + j, h, w]
+// Write contiguous output.
+// -----------------------------------------------------------------------------
+template <typename T>
+__global__ void pixel_shuffle_kernel(
+    const T* __restrict__ x,
+    T* __restrict__ y,
+    int N, int C_in, int H, int W, int r,
+    long long sN, long long sC, long long sH, long long sW,
+    int C_out,
+    long long total_out) // N * C_out * H*r * W*r
+{
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+    for (; idx < total_out; idx += stride) {
+        int ow = idx % (W * r);
+        long long tmp = idx / (W * r);
+        int oh = tmp % (H * r);
+        tmp /= (H * r);
+        int c_out = tmp % C_out;
+        int n = tmp / C_out;
+        int i = oh / r;
+        int j = ow / r;
+        int h = i;
+        int w = j;
+        int c_in = c_out * r * r + (oh % r) * r + (ow % r);
+        const T* x_ptr = x + (long long)n * sN + (long long)c_in * sC + (long long)h * sH + (long long)w * sW;
+        y[idx] = *x_ptr;
+    }
+}
+
+extern "C" void pixel_shuffle_launcher(
+    const float* x,
+    float* y,
+    int N, int C_in, int H, int W, int r,
+    long long sN, long long sC, long long sH, long long sW,
+    cudaStream_t stream)
+{
+    int C_out = C_in / (r * r);
+    long long total_out = (long long)N * C_out * H * r * W * r;
+    int block = 256;
+    long long grid_l = (total_out + block - 1) / block;
+    int grid = (int)min(grid_l, (long long)2147483647);
+    pixel_shuffle_kernel<float><<<grid, block, 0, stream>>>(
+        x, y, N, C_in, H, W, r, sN, sC, sH, sW, C_out, total_out);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,132 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void sum_channels_launcher(
+    const float* x,
+    float* y,
+    int N, int C, int H, int W,
+    long long sN, long long sC, long long sH, long long sW,
+    cudaStream_t stream);
+
+extern "C" void expand_channels_launcher(
+    const float* x,
+    float* y,
+    int N, int channels_factor, int H, int W,
+    long long sN, long long sC, long long sH, long long sW,
+    cudaStream_t stream);
+
+extern "C" void pixel_shuffle_launcher(
+    const float* x,
+    float* y,
+    int N, int C_in, int H, int W, int r,
+    long long sN, long long sC, long long sH, long long sW,
+    cudaStream_t stream);
+
+// Helper to validate CUDA float32 tensor and get strides
+static void check_cuda_float_tensor(const torch::Tensor& t, const char* name) {
+    TORCH_CHECK(t.is_cuda(), name, " must be a CUDA tensor");
+    TORCH_CHECK(t.dtype() == torch::kFloat32, name, " must be float32");
+    TORCH_CHECK(t.dim() == 4, name, " must be 4-dimensional");
+}
+
+static std::tuple<long long, long long, long long, long long> get_strides(const torch::Tensor& t) {
+    // Strides are in elements
+    return std::make_tuple(
+        t.stride(0),
+        t.stride(1),
+        t.stride(2),
+        t.stride(3)
+    );
+}
+
+torch::Tensor sum_channels_forward(torch::Tensor x) {
+    check_cuda_float_tensor(x, "sum_channels_forward input");
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+
+    auto output = torch::empty({N, 1, H, W}, x.options());
+
+    auto [sN, sC, sH, sW] = get_strides(x);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    sum_channels_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C, H, W,
+        sN, sC, sH, sW,
+        stream
+    );
+
+    return output;
+}
+
+torch::Tensor expand_channels_forward(torch::Tensor x, int64_t channels_factor) {
+    check_cuda_float_tensor(x, "expand_channels_forward input");
+    TORCH_CHECK(channels_factor > 0, "channels_factor must be positive");
+    TORCH_CHECK(x.size(1) == 1, "expand_channels_forward expects x.size(1) == 1");
+
+    int N = x.size(0);
+    int H = x.size(2);
+    int W = x.size(3);
+
+    auto output = torch::empty({N, channels_factor, H, W}, x.options());
+
+    auto [sN, sC, sH, sW] = get_strides(x);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    expand_channels_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, (int)channels_factor, H, W,
+        sN, sC, sH, sW,
+        stream
+    );
+
+    return output;
+}
+
+torch::Tensor pixel_shuffle_forward(torch::Tensor x, int64_t upscale_factor) {
+    check_cuda_float_tensor(x, "pixel_shuffle_forward input");
+    TORCH_CHECK(upscale_factor > 0, "upscale_factor must be positive");
+    int r = (int)upscale_factor;
+    TORCH_CHECK(x.size(1) % (r * r) == 0, "channels must be divisible by r^2");
+
+    int N = x.size(0);
+    int C_in = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+    int C_out = C_in / (r * r);
+
+    auto output = torch::empty({N, C_out, H * r, W * r}, x.options());
+
+    auto [sN, sC, sH, sW] = get_strides(x);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    pixel_shuffle_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C_in, H, W, r,
+        sN, sC, sH, sW,
+        stream
+    );
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("sum_channels_forward", &sum_channels_forward, "Sum over channels with keepdim=True",
+          py::arg("x"));
+    m.def("expand_channels_forward", &expand_channels_forward, "Expand channels to given factor",
+          py::arg("x"), py::arg("channels_factor"));
+    m.def("pixel_shuffle_forward", &pixel_shuffle_forward, "Pixel shuffle operation",
+          py::arg("x"), py::arg("upscale_factor"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,32 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, upscale_factor, channels_factor):
+        super(ModelNew, self).__init__()
+        # Preserve attributes for compatibility (not used in forward)
+        self.upscale_factor = upscale_factor
+        self.channels_factor = channels_factor
+        # Reference used nn.PixelShuffle; we keep the module for state_dict key preservation (empty parameters).
+        self.pixel_shuffle = nn.PixelShuffle(upscale_factor)
+
+    def forward(self, x):
+        # Step 1: sum over channels, keepdim=True -> [N,1,H,W]
+        x = cuda_extension.sum_channels_forward(x)
+        # Step 2: expand to channels_factor -> [N,C',H,W]
+        x = cuda_extension.expand_channels_forward(x, self.channels_factor)
+        # Step 3: pixel shuffle -> [N, C'/r^2, H*r, W*r]
+        x = cuda_extension.pixel_shuffle_forward(x, self.upscale_factor)
+        return x
+
+    def debug_forward(self, x):
+        # Follow checkpoints: step_001, step_002, step_003, step_004 (return)
+        x_sum = cuda_extension.sum_channels_forward(x)
+        yield "step_001", x_sum
+        x_expand = cuda_extension.expand_channels_forward(x_sum, self.channels_factor)
+        yield "step_002", x_expand
+        x_out = cuda_extension.pixel_shuffle_forward(x_expand, self.upscale_factor)
+        yield "step_003", x_out
+        yield "step_004", x_out
