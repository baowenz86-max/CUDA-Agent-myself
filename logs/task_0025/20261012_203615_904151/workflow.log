#!/usr/bin/env python3
"""Reproducible final-forward verification; debug results never grant a pass."""

import argparse
from contextlib import contextmanager
import importlib
import os
from pathlib import Path
import sys
import traceback

import torch
import torch.nn.functional as F

from .diagnostics import (
    ComparisonFailure, check_equal, reference_trace,
    seed_all, transform_tree, write_json,
)


@contextmanager
def block_torch_functional(excludes=None):
    excludes = set() if excludes is None else excludes
    originals = {}
    for name in dir(F):
        attr = getattr(F, name)
        if callable(attr) and not name.startswith('_') and name not in excludes:
            originals[name] = attr
            def wrapper(*args, __name=name, **kwargs):
                raise RuntimeError(f'Function torch.nn.functional.{__name} is not allowed in this context.')
            setattr(F, name, wrapper)
    try:
        yield
    finally:
        for name, attr in originals.items():
            setattr(F, name, attr)


def fixture_directory():
    return Path(os.environ.get('CUDA_AGENT_RUN_DIR', '.correctness')).resolve()


def make_reference_fixture(directory, seed, device):
    """Create once per run, independently of any generated model."""
    directory.mkdir(parents=True, exist_ok=True)
    path = directory / 'reference_fixture.pt'
    if not path.exists():
        reference = importlib.import_module('model')
        seed_all(seed)
        init = reference.get_init_inputs()
        init = init if isinstance(init, (tuple, list)) else [init]
        model = reference.Model(*init).eval().to(device)
        torch.save({'seed': seed, 'init_inputs': transform_tree(init, lambda t: t.detach().cpu()),
                    'state_dict': transform_tree(model.state_dict(), lambda t: t.detach().cpu())}, path)
    fixture = torch.load(path, map_location='cpu', weights_only=False)
    if fixture['seed'] != seed:
        raise ValueError('Saved reference fixture seed differs from requested seed; use its replay seed')
    return fixture


def initialize_models(directory, seed, device):
    reference = importlib.import_module('model')
    fixture = make_reference_fixture(directory, seed, device)
    seed_all(seed)
    torch_model = reference.Model(*fixture['init_inputs']).eval().to(device)
    generated = importlib.import_module('model_new')
    seed_all(seed)
    cuda_model = generated.ModelNew(*fixture['init_inputs']).eval().to(device)
    torch_model.load_state_dict(fixture['state_dict'], strict=True)
    cuda_model.load_state_dict(fixture['state_dict'], strict=True)
    return torch_model, cuda_model, fixture


def build_inputs(seed):
    reference = importlib.import_module('model')
    seed_all(seed)
    inputs = reference.get_inputs()
    inputs = inputs if isinstance(inputs, (list, tuple)) else [inputs]
    # Retain untouched CPU fixtures even when the forward modifies its inputs.
    return transform_tree(inputs, lambda t: t.detach().cpu().clone())


def device_inputs(inputs, device):
    return transform_tree(inputs, lambda t: t.to(device).clone())


def synchronize(device):
    if str(device).startswith('cuda'):
        torch.cuda.synchronize()


def runtime_metadata(device):
    return {'python': sys.version, 'torch': torch.__version__, 'cuda': torch.version.cuda,
            'device': str(device), 'gpu': torch.cuda.get_device_name() if str(device).startswith('cuda') else None,
            'deterministic_algorithms': torch.are_deterministic_algorithms_enabled()}


def rng_state():
    import random
    state = {'python': random.getstate(), 'torch': torch.get_rng_state()}
    if torch.cuda.is_available():
        state['cuda'] = torch.cuda.get_rng_state_all()
    try:
        import numpy as np
        state['numpy'] = np.random.get_state()
    except ImportError:
        pass
    return state


def restore_rng(state):
    import random
    random.setstate(state['python'])
    torch.set_rng_state(state['torch'])
    if 'cuda' in state:
        torch.cuda.set_rng_state_all(state['cuda'])
    if 'numpy' in state:
        import numpy as np
        np.random.set_state(state['numpy'])


def diagnose(torch_model, cuda_model, fixture, inputs, input_seed, device):
    if not callable(getattr(cuda_model, 'debug_forward', None)):
        return {'status': 'unavailable', 'reason': 'ModelNew.debug_forward is missing'}
    try:
        ref_fn, stages = reference_trace(torch_model)
        torch_model.load_state_dict(fixture['state_dict'], strict=True)
        cuda_model.load_state_dict(fixture['state_dict'], strict=True)
        seed_all(input_seed)
        initial_rng = rng_state()
        reference = ref_fn(*device_inputs(inputs, device))
        with block_torch_functional():
            actual = iter(cuda_model.debug_forward(*device_inputs(inputs, device)))
        ref_rng = initial_rng
        actual_rng = rng_state()
        matched = 0
        for stage in stages:
            restore_rng(ref_rng)
            expected_id, expected = next(reference)
            ref_rng = rng_state()
            restore_rng(actual_rng)
            with block_torch_functional():
                checkpoint, value = next(actual)
                synchronize(device)
            actual_rng = rng_state()
            if checkpoint != expected_id:
                return {'status': 'failed', 'checkpoint': stage, 'kind': 'checkpoint_contract',
                        'actual_id': str(checkpoint), 'matched_checkpoints': matched}
            try:
                check_equal(value, expected, expected_id)
            except ComparisonFailure as exc:
                return {'status': 'failed', 'checkpoint': stage, 'error': exc.detail,
                        'matched_checkpoints': matched}
            matched += 1
            del expected, value
        sentinel = object()
        with block_torch_functional():
            if next(actual, sentinel) is not sentinel:
                return {'status': 'failed', 'kind': 'extra_checkpoint', 'matched_checkpoints': matched}
        return {'status': 'matched', 'matched_checkpoints': matched,
                'note': 'Debug checkpoints match; normal forward still failed and remains rejected'}
    except Exception as exc:
        return {'status': 'unavailable', 'reason': f'{type(exc).__name__}: {exc}',
                'traceback': traceback.format_exc()}


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--seed', type=int, default=int(os.environ.get('CUDA_AGENT_VERIFICATION_SEED', '2026')))
    parser.add_argument('--device', default='cuda')
    parser.add_argument('--replay', type=Path, help='Replay a trusted, locally saved failure_inputs.pt')
    parser.add_argument('--diagnose', action='store_true', help='Diagnose the saved failure in a fresh process')
    args = parser.parse_args(argv)
    directory = args.replay.resolve().parent if args.replay else fixture_directory()
    report_path = directory / 'verification.json'
    result = {'status': 'failed', 'seed': args.seed, 'num_checks': 5, 'checks': [],
              'passed_checks': 0, 'stage': 'initialization'}
    try:
        result['environment'] = runtime_metadata(args.device)
        torch_model, cuda_model, fixture = initialize_models(directory, args.seed, args.device)
        replay = torch.load(args.replay, map_location='cpu', weights_only=False) if args.replay else None
        if args.diagnose:
            failure = replay or torch.load(directory / 'failure_inputs.pt', map_location='cpu', weights_only=False)
            with torch.no_grad():
                diagnostic = diagnose(torch_model, cuda_model, fixture, failure['inputs'], failure['seed'], args.device)
            write_json(directory / 'diagnostic.json', diagnostic)
            print('[DIAGNOSTIC] ' + str(diagnostic))
            return 0
        indices = [replay['check_index']] if replay else range(5)
        first_failure_saved = False
        with torch.no_grad():
            for i in indices:
                input_seed = replay['seed'] if replay else args.seed + 1 + i
                inputs = replay['inputs'] if replay else build_inputs(input_seed)
                row = {'index': i, 'seed': input_seed, 'status': 'failed'}
                actual = expected = None
                try:
                    torch_model.load_state_dict(fixture['state_dict'], strict=True)
                    cuda_model.load_state_dict(fixture['state_dict'], strict=True)
                    seed_all(input_seed)
                    result['stage'] = 'reference'
                    expected = torch_model(*device_inputs(inputs, args.device))
                    synchronize(args.device)
                    seed_all(input_seed)
                    result['stage'] = 'forward'
                    with block_torch_functional():
                        actual = cuda_model(*device_inputs(inputs, args.device))
                        synchronize(args.device)
                    result['stage'] = 'comparison'
                    check_equal(actual, expected)
                    row['status'] = 'passed'
                    result['passed_checks'] += 1
                    print(f'[PASS] check {i + 1}/5')
                except Exception as exc:
                    row.update(stage=result['stage'], error=exc.detail if isinstance(exc, ComparisonFailure)
                               else {'kind': 'runtime', 'message': f'{type(exc).__name__}: {exc}'},
                               traceback=traceback.format_exc())
                    print(row['traceback'])
                    if not first_failure_saved:
                        result['first_failure'] = row
                        # Never overwrite a replay fixture while reading it.
                        if not args.replay:
                            temporary = directory / 'failure_inputs.tmp.pt'
                            torch.save({'inputs': inputs, 'seed': input_seed, 'check_index': i}, temporary)
                            temporary.replace(directory / 'failure_inputs.pt')
                        first_failure_saved = True
                finally:
                    result['checks'].append(row)
                    write_json(report_path if not args.replay else directory / 'replay_verification.json', result)
                    del actual, expected, inputs
                if row.get('stage') in ('reference', 'forward') and row['status'] == 'failed':
                    # A failed CUDA context cannot be reused safely; diagnose in a new subprocess.
                    break
        result['status'] = 'passed' if result['checks'] and all(r['status'] == 'passed' for r in result['checks']) and (replay or len(result['checks']) == 5) else 'failed'
        result['stage'] = 'verification'
    except Exception as exc:
        result.update(error={'kind': 'initialization', 'message': f'{type(exc).__name__}: {exc}'},
                      traceback=traceback.format_exc())
        print(result['traceback'])
    if args.diagnose:
        write_json(directory / 'diagnostic.json', {'status': 'unavailable', 'reason': result.get('error'), 'traceback': result.get('traceback')})
        return 1
    result['replay_command'] = f'{sys.executable} -m utils.verification --seed {args.seed} --device {args.device} --replay {directory / "failure_inputs.pt"}'
    write_json(report_path if not args.replay else directory / 'replay_verification.json', result)
    if result['status'] == 'passed':
        print('[PASS] verify success')
        return 0
    print('[FAIL] Structured report: ' + str(report_path))
    return 1


if __name__ == '__main__':
    raise SystemExit(main())


===== READ ONLY: utils/diagnostics.py =====
"""Trusted reference tracing and reproducible correctness diagnostics.

Torch is imported lazily so reference instrumentation can be tested without CUDA.
"""

import ast
import inspect
import json
import math
import random
import textwrap
from pathlib import Path


def write_json(path, data):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(data, ensure_ascii=False, indent=2, allow_nan=False), encoding="utf-8")
    temporary.replace(path)


def read_json(path, default=None):
    path = Path(path)
    return json.loads(path.read_text(encoding="utf-8")) if path.exists() else default


def seed_all(seed):
    import torch
    random.seed(seed)
    try:
        import numpy as np
        np.random.seed(seed % (2**32))
    except ImportError:
        pass
    torch.manual_seed(seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)


def transform_tree(value, fn):
    import torch
    if isinstance(value, torch.Tensor):
        return fn(value)
    if isinstance(value, tuple):
        return tuple(transform_tree(v, fn) for v in value)
    if isinstance(value, list):
        return [transform_tree(v, fn) for v in value]
    if isinstance(value, dict):
        return {k: transform_tree(v, fn) for k, v in value.items()}
    return value


def _target_value(target):
    if isinstance(target, ast.Name):
        return ast.Name(id=target.id, ctx=ast.Load())
    if isinstance(target, (ast.Tuple, ast.List)):
        return type(target)(elts=[_target_value(t) for t in target.elts], ctx=ast.Load())
    raise ValueError("Reference trace only supports local variable assignments")


def trace_function(source):
    """Return an instrumented generator AST and stable statement checkpoints.

    Unsupported control flow is rejected instead of silently changing semantics.
    """
    tree = ast.parse(textwrap.dedent(source))
    fn = next((n for n in tree.body if isinstance(n, ast.FunctionDef)), None)
    if fn is None:
        raise ValueError("Reference forward function was not found")
    if any(isinstance(n, (ast.Yield, ast.YieldFrom, ast.Await)) for n in ast.walk(fn)):
        raise ValueError("Generator/async reference forwards cannot be traced")
    stages, body = [], []
    for statement in fn.body:
        if isinstance(statement, ast.Expr) and isinstance(statement.value, ast.Constant) and isinstance(statement.value.value, str):
            body.append(statement)
            continue
        if isinstance(statement, ast.Assign):
            body.append(statement)
            value = _target_value(statement.targets[-1])
        elif isinstance(statement, ast.AnnAssign) and statement.value is not None:
            body.append(statement)
            value = _target_value(statement.target)
        elif isinstance(statement, ast.Return) and statement.value is not None:
            value = statement.value
        else:
            raise ValueError(f"Unsupported reference statement: {type(statement).__name__}")
        checkpoint = f"step_{len(stages) + 1:03d}"
        stages.append({"id": checkpoint, "source": ast.unparse(statement), "line": statement.lineno})
        body.append(ast.Expr(value=ast.Yield(value=ast.Tuple(
            elts=[ast.Constant(value=checkpoint), value], ctx=ast.Load()))))
        if isinstance(statement, ast.Return):
            body.append(ast.Return(value=None))
            break
    if not stages or not isinstance(statement, ast.Return):
        raise ValueError("Reference trace requires an explicit final return")
    # Do not re-evaluate defaults or annotations while instrumenting the function.
    fn.args.defaults = [ast.Constant(value=None) for _ in fn.args.defaults]
    fn.args.kw_defaults = [ast.Constant(value=None) if d is not None else None for d in fn.args.kw_defaults]
    for arg in (*fn.args.posonlyargs, *fn.args.args, *fn.args.kwonlyargs):
        arg.annotation = None
    if fn.args.vararg:
        fn.args.vararg.annotation = None
    if fn.args.kwarg:
        fn.args.kwarg.annotation = None
    fn.returns = None
    fn.name = "_reference_debug_forward"
    fn.decorator_list = []
    fn.body = body
    return ast.fix_missing_locations(tree), stages


def reference_trace(model):
    forward = type(model).forward
    if forward.__closure__:
        raise ValueError("Reference forward closures cannot be safely instrumented")
    tree, stages = trace_function(inspect.getsource(forward))
    namespace = dict(forward.__globals__)
    exec(compile(tree, "<reference-checkpoints>", "exec"), namespace)
    traced = namespace["_reference_debug_forward"]
    traced.__defaults__ = forward.__defaults__
    traced.__kwdefaults__ = forward.__kwdefaults__
    return traced.__get__(model), stages


def describe(value):
    import torch
    if isinstance(value, torch.Tensor):
        return {"type": "tensor", "shape": list(value.shape), "dtype": str(value.dtype),
                "device": str(value.device), "stride": list(value.stride()), "numel": value.numel()}
    if isinstance(value, (tuple, list)):
        return {"type": type(value).__name__, "items": [describe(v) for v in value]}
    if isinstance(value, dict):
        return {"type": "dict", "items": {str(k): describe(v) for k, v in value.items()}}
    return {"type": type(value).__name__, "value": repr(value)[:200]}


def api_signatures(model):
    """Resolve APIs in the installed runtime rather than trusting variable names."""
    forward = type(model).forward
    tree = ast.parse(textwrap.dedent(inspect.getsource(forward)))
    signatures = {}
    for call in (n for n in ast.walk(tree) if isinstance(n, ast.Call)):
        expression = ast.unparse(call.func)
        try:
            def resolve(node):
                if isinstance(node, ast.Name):
                    return model if node.id == "self" else forward.__globals__[node.id]
                if isinstance(node, ast.Attribute):
                    return getattr(resolve(node.value), node.attr)
                raise ValueError("dynamic callable")
            obj = resolve(call.func)
            target = obj.forward if hasattr(obj, "forward") else obj
            try:
                signature = str(inspect.signature(target))
            except (TypeError, ValueError):
                signature = "builtin signature unavailable; preserve exact reference arguments"
            signatures[expression] = {"signature": signature, "documentation": (inspect.getdoc(target) or inspect.getdoc(obj) or "")[:2400]}
        except (KeyError, AttributeError, TypeError, ValueError):
            signatures[expression] = "unresolved; retain the reference call's exact arguments"
    return signatures


class ComparisonFailure(AssertionError):
    def __init__(self, detail):
        self.detail = detail
        super().__init__(json.dumps(detail, ensure_ascii=False, allow_nan=False))


def _finite_json(value):
    return value if math.isfinite(value) else str(value)


def tensor_error(actual, expected):
    """Calculate failure metrics in chunks; do not allocate full float64 copies."""
    import torch
    detail = {"actual": describe(actual), "expected": describe(expected)}
    if actual.shape != expected.shape or actual.dtype != expected.dtype or actual.device != expected.device:
        detail["kind"] = "tensor_structure"
        return detail
    detail.update(kind="tensor_values", mismatched=0, numel=expected.numel(),
                  actual_nan=0, expected_nan=0, actual_inf=0, expected_inf=0)
    a, b = actual.reshape(-1), expected.reshape(-1)
    max_abs, max_rel = 0.0, 0.0
    samples = []
    for start in range(0, a.numel(), 1_048_576):
        av, bv = a[start:start + 1_048_576], b[start:start + 1_048_576]
        close = torch.isclose(av, bv, atol=1e-2, rtol=1e-2, equal_nan=False)
        detail["mismatched"] += int((~close).sum().item())
        for label, chunk in (("actual", av), ("expected", bv)):
            detail[label + "_nan"] += int(torch.isnan(chunk).sum().item())
            detail[label + "_inf"] += int(torch.isinf(chunk).sum().item())
        if (~close).any().item():
            bad = (~close).nonzero().flatten()
            for offset in bad[:max(0, 5 - len(samples))].tolist():
                flat = start + offset
                index = []
                for dimension in reversed(actual.shape):
                    index.append(flat % dimension)
                    flat //= dimension
                samples.append({"index": list(reversed(index)),
                                "actual": repr(av[offset].item()), "expected": repr(bv[offset].item())})
            # Complex values retain their imaginary parts; integer differences cannot overflow.
            dtype = torch.complex128 if av.is_complex() else torch.float64
            delta = (av.to(dtype) - bv.to(dtype)).abs()
            finite = torch.isfinite(delta)
            if finite.any().item():
                max_abs = max(max_abs, float(delta[finite].max().item()))
                relative = delta[finite] / bv.to(dtype).abs()[finite].clamp_min(1e-30)
                max_rel = max(max_rel, float(relative.max().item()))
            if ((~close) & (~finite)).any().item():
                max_abs = max_rel = math.inf
    detail.update(mismatch_ratio=detail["mismatched"] / max(1, detail["numel"]),
                  max_absolute_error=_finite_json(max_abs), max_relative_error=_finite_json(max_rel), samples=samples)
    return detail


def check_equal(actual, expected, path="output"):
    import torch
    if type(actual) is not type(expected):
        raise ComparisonFailure({"kind": "type", "path": path, "actual": describe(actual), "expected": describe(expected)})
    if isinstance(actual, (list, tuple)):
        if len(actual) != len(expected):
            raise ComparisonFailure({"kind": "length", "path": path, "actual": len(actual), "expected": len(expected)})
        for i, (x, y) in enumerate(zip(actual, expected)):
            check_equal(x, y, f"{path}[{i}]")
    elif isinstance(actual, dict):
        if actual.keys() != expected.keys():
            raise ComparisonFailure({"kind": "keys", "path": path, "actual": list(map(str, actual)), "expected": list(map(str, expected))})
        for key in expected:
            check_equal(actual[key], expected[key], f"{path}[{key!r}]")
    elif isinstance(actual, torch.Tensor):
        try:
            torch.testing.assert_close(actual, expected, atol=1e-2, rtol=1e-2)
        except AssertionError as exc:
            detail = tensor_error(actual, expected)
            detail.update(path=path, message=str(exc))
            raise ComparisonFailure(detail) from exc
    elif isinstance(actual, (str, float, int)):
        if actual != expected:
            raise ComparisonFailure({"kind": "scalar", "path": path, "actual": repr(actual), "expected": repr(expected)})
    else:
        raise ComparisonFailure({"kind": "unsupported_type", "path": path, "type": type(actual).__name__})


