--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,49 @@
+#include <cuda_runtime.h>
+
+__global__ void hardtanh_kernel(const float* __restrict__ input,
+                                float* __restrict__ output,
+                                long long numel,
+                                float min_val,
+                                float max_val) {
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (long long i = idx; i < numel; i += stride) {
+        float val = input[i];
+        val = fminf(fmaxf(val, min_val), max_val);
+        output[i] = val;
+    }
+}
+
+__global__ void div_scalar_kernel(const float* __restrict__ input,
+                                  float* __restrict__ output,
+                                  long long numel,
+                                  float divisor) {
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (long long i = idx; i < numel; i += stride) {
+        output[i] = input[i] / divisor;
+    }
+}
+
+extern "C" void hardtanh_forward_launcher(const float* input,
+                                          float* output,
+                                          long long numel,
+                                          float min_val,
+                                          float max_val,
+                                          cudaStream_t stream) {
+    const int block_size = 256;
+    long long blocks_ll = (numel + block_size - 1) / block_size;
+    int blocks = (blocks_ll > 65535) ? 65535 : (int)blocks_ll;
+    hardtanh_kernel<<<blocks, block_size, 0, stream>>>(input, output, numel, min_val, max_val);
+}
+
+extern "C" void div_scalar_forward_launcher(const float* input,
+                                            float* output,
+                                            long long numel,
+                                            float divisor,
+                                            cudaStream_t stream) {
+    const int block_size = 256;
+    long long blocks_ll = (numel + block_size - 1) / block_size;
+    int blocks = (blocks_ll > 65535) ? 65535 : (int)blocks_ll;
+    div_scalar_kernel<<<blocks, block_size, 0, stream>>>(input, output, numel, divisor);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,91 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void hardtanh_forward_launcher(
+    const float* input,
+    float* output,
+    long long numel,
+    float min_val,
+    float max_val,
+    cudaStream_t stream);
+
+extern "C" void div_scalar_forward_launcher(
+    const float* input,
+    float* output,
+    long long numel,
+    float divisor,
+    cudaStream_t stream);
+
+// PyTorch wrapper for hardtanh
+torch::Tensor hardtanh_forward(torch::Tensor input, double min_val = -1.0, double max_val = 1.0) {
+    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
+
+    // Ensure contiguous (launcher assumes contiguous)
+    auto input_contig = input.contiguous();
+
+    // Allocate output with same shape and options
+    auto output = torch::empty_like(input_contig);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call CUDA launcher
+    hardtanh_forward_launcher(
+        input_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<long long>(input_contig.numel()),
+        static_cast<float>(min_val),
+        static_cast<float>(max_val),
+        stream
+    );
+
+    return output;
+}
+
+// PyTorch wrapper for div_scalar
+torch::Tensor div_scalar_forward(torch::Tensor input, double divisor) {
+    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
+
+    // Ensure contiguous
+    auto input_contig = input.contiguous();
+
+    // Allocate output
+    auto output = torch::empty_like(input_contig);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call CUDA launcher
+    div_scalar_forward_launcher(
+        input_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<long long>(input_contig.numel()),
+        static_cast<float>(divisor),
+        stream
+    );
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("hardtanh_forward", &hardtanh_forward,
+          "Apply hardtanh to input tensor",
+          py::arg("input"),
+          py::arg("min_val") = -1.0,
+          py::arg("max_val") = 1.0);
+
+    m.def("div_scalar_forward", &div_scalar_forward,
+          "Divide input tensor by scalar",
+          py::arg("input"),
+          py::arg("divisor"));
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,21 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, input_size, div_factor):
+        super().__init__()
+        self.div_factor = div_factor
+
+    def forward(self, x):
+        x = cuda_extension.hardtanh_forward(x, -1.0, 1.0)
+        x = cuda_extension.div_scalar_forward(x, self.div_factor)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.hardtanh_forward(x, -1.0, 1.0)
+        yield 'step_001', x
+        x = cuda_extension.div_scalar_forward(x, self.div_factor)
+        yield 'step_002', x
+        yield 'step_003', x
