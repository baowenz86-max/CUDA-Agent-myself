{
  "operators": [
    {
      "name": "hardtanh_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference step input; e.g. [512, 3, 512, 512]",
          "layout": "supports strides; may be non-contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "min_val",
          "kind": "float",
          "default": -1.0,
          "optional": true,
          "nullable": false
        },
        {
          "name": "max_val",
          "kind": "float",
          "default": 1.0,
          "optional": true,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对应参考语句 x = F.hardtanh(x)（默认 min_val=-1, max_val=1）",
        "逐元素：output = min(max(input, min_val), max_val)",
        "保持输入 shape、dtype、device 和 stride（返回新张量，非原地）"
      ]
    },
    {
      "name": "div_scalar_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as previous step output; e.g. [512, 3, 512, 512]",
          "layout": "supports strides; may be non-contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "divisor",
          "kind": "float",
          "default": null,
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对应参考语句 x = x / self.div_factor",
        "逐元素：output = input / divisor",
        "保持输入 shape、dtype、device 和 stride（返回新张量，非原地）"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = F.hardtanh(x)",
      "semantics": [
        "F.hardtanh 使用默认 min_val=-1.0, max_val=1.0",
        "对输入逐元素钳位到 [-1, 1]"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = x / self.div_factor",
      "semantics": [
        "将上一步结果逐元素除以 div_factor（float）",
        "div_factor 为构造时传入的标量，此处为 2.0"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回最终张量，shape 与输入相同"
      ]
    }
  ]
}