--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,65 @@
+#include <cuda_runtime.h>
+
+// BatchNorm2d evaluation mode kernel.
+// Computes: out = (x - running_mean[c]) * inv_std * weight[c] + bias[c]
+// where c = (idx / (H*W)) % C for contiguous [N,C,H,W] input.
+// weight and bias may be null (treated as 1 and 0 respectively).
+__global__ void batch_norm_eval_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ out,
+    const float* __restrict__ weight,
+    const float* __restrict__ bias,
+    const float* __restrict__ running_mean,
+    const float* __restrict__ running_var,
+    double eps,
+    int N,
+    int C,
+    int HW,
+    long total_elements)
+{
+    long idx = static_cast<long>(blockIdx.x) * blockDim.x + threadIdx.x;
+    long stride = static_cast<long>(blockDim.x) * gridDim.x;
+    for (; idx < total_elements; idx += stride) {
+        int c = (idx / HW) % C;
+        float mean = running_mean[c];
+        float var = running_var[c];
+        float inv_std = rsqrtf(var + static_cast<float>(eps));
+        float w = (weight != nullptr) ? weight[c] : 1.0f;
+        float b = (bias != nullptr) ? bias[c] : 0.0f;
+        float val = x[idx];
+        out[idx] = (val - mean) * inv_std * w + b;
+    }
+}
+
+// Launcher for batch_norm_eval_forward.
+// All tensors must be contiguous, float32, CUDA, and have correct shapes.
+// x: [N, C, H, W], weight/bias: [C] or null, running_mean/running_var: [C].
+extern "C" void batch_norm_eval_launcher(
+    const float* x,
+    float* out,
+    const float* weight,
+    const float* bias,
+    const float* running_mean,
+    const float* running_var,
+    double eps,
+    int N,
+    int C,
+    int H,
+    int W,
+    cudaStream_t stream)
+{
+    long HW = static_cast<long>(H) * W;
+    long total_elements = static_cast<long>(N) * C * HW;
+    if (total_elements == 0) {
+        return;
+    }
+    const int block_size = 256;
+    int grid_size = static_cast<int>((total_elements + block_size - 1) / block_size);
+    // Limit grid size to avoid exceeding max grid dimension (2^31-1), use grid-stride loop.
+    const int max_grid_size = 65535 * 32; // A conservative high value, but grid-stride will cover.
+    if (grid_size > max_grid_size) {
+        grid_size = max_grid_size;
+    }
+    batch_norm_eval_kernel<<<grid_size, block_size, 0, stream>>>(
+        x, out, weight, bias, running_mean, running_var, eps, N, C, static_cast<int>(HW), total_elements);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,109 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declaration of launcher from custom_ops.cu
+extern "C" void batch_norm_eval_launcher(
+    const float* x,
+    float* out,
+    const float* weight,
+    const float* bias,
+    const float* running_mean,
+    const float* running_var,
+    double eps,
+    int N,
+    int C,
+    int H,
+    int W,
+    cudaStream_t stream);
+
+// Wrapper for batch_norm_eval_forward
+torch::Tensor batch_norm_eval_forward(
+    torch::Tensor x,
+    c10::optional<torch::Tensor> weight,
+    c10::optional<torch::Tensor> bias,
+    torch::Tensor running_mean,
+    torch::Tensor running_var,
+    double eps = 1e-05) {
+    // Validate input tensor
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
+    TORCH_CHECK(x.dim() == 4, "x must have 4 dimensions [N, C, H, W]");
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+
+    // Validate running_mean and running_var
+    TORCH_CHECK(running_mean.is_cuda(), "running_mean must be a CUDA tensor");
+    TORCH_CHECK(running_mean.dtype() == torch::kFloat32, "running_mean must be float32");
+    TORCH_CHECK(running_mean.is_contiguous(), "running_mean must be contiguous");
+    TORCH_CHECK(running_mean.numel() == C, "running_mean must have C elements");
+
+    TORCH_CHECK(running_var.is_cuda(), "running_var must be a CUDA tensor");
+    TORCH_CHECK(running_var.dtype() == torch::kFloat32, "running_var must be float32");
+    TORCH_CHECK(running_var.is_contiguous(), "running_var must be contiguous");
+    TORCH_CHECK(running_var.numel() == C, "running_var must have C elements");
+
+    // Validate optional weight and bias
+    const float* weight_ptr = nullptr;
+    if (weight.has_value()) {
+        auto w = weight.value();
+        TORCH_CHECK(w.is_cuda(), "weight must be a CUDA tensor");
+        TORCH_CHECK(w.dtype() == torch::kFloat32, "weight must be float32");
+        TORCH_CHECK(w.is_contiguous(), "weight must be contiguous");
+        TORCH_CHECK(w.numel() == C, "weight must have C elements");
+        weight_ptr = w.data_ptr<float>();
+    }
+
+    const float* bias_ptr = nullptr;
+    if (bias.has_value()) {
+        auto b = bias.value();
+        TORCH_CHECK(b.is_cuda(), "bias must be a CUDA tensor");
+        TORCH_CHECK(b.dtype() == torch::kFloat32, "bias must be float32");
+        TORCH_CHECK(b.is_contiguous(), "bias must be contiguous");
+        TORCH_CHECK(b.numel() == C, "bias must have C elements");
+        bias_ptr = b.data_ptr<float>();
+    }
+
+    // Allocate output tensor
+    auto out = torch::empty_like(x);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    batch_norm_eval_launcher(
+        x.data_ptr<float>(),
+        out.data_ptr<float>(),
+        weight_ptr,
+        bias_ptr,
+        running_mean.data_ptr<float>(),
+        running_var.data_ptr<float>(),
+        eps,
+        N,
+        C,
+        H,
+        W,
+        stream);
+
+    return out;
+}
+
+// Registration function
+void register_batch_norm_eval(pybind11::module& m) {
+    m.def("batch_norm_eval_forward", &batch_norm_eval_forward,
+          "BatchNorm2d evaluation forward",
+          py::arg("x"),
+          py::arg("weight"),
+          py::arg("bias"),
+          py::arg("running_mean"),
+          py::arg("running_var"),
+          py::arg("eps") = 1e-05);
+}
+
+REGISTER_BINDING(batch_norm_eval, register_batch_norm_eval);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,23 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, num_features, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True):
+        super().__init__()
+        self.batch_norm = nn.BatchNorm2d(
+            num_features, eps=eps, momentum=momentum, affine=affine, track_running_stats=track_running_stats
+        )
+
+    def forward(self, x):
+        weight = self.batch_norm.weight if self.batch_norm.affine else None
+        bias = self.batch_norm.bias if self.batch_norm.affine else None
+        return cuda_extension.batch_norm_eval_forward(
+            x, weight, bias, self.batch_norm.running_mean, self.batch_norm.running_var, self.batch_norm.eps
+        )
+
+    def debug_forward(self, x):
+        result = self.forward(x)
+        yield ("step_001", result)
+        yield ("final_return", result)
