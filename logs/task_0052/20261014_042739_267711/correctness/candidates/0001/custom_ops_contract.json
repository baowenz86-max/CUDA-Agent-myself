{
  "operators": [
    {
      "name": "custom_round",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[128, 3, 512, 128]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[128, 3, 512, 128]"
      },
      "semantics": [
        "逐元素计算 round(x)，即四舍五入到最近的整数，返回 float32 tensor，shape 与输入相同。",
        "对应参考语句 x = torch.round(x)。"
      ]
    },
    {
      "name": "custom_interpolate",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[128, 3, 512, 128]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "scale_factor",
          "kind": "float",
          "default": 2.0,
          "optional": true
        },
        {
          "name": "mode",
          "kind": "int",
          "default": 0,
          "optional": true
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[128, 3, 1024, 256]"
      },
      "semantics": [
        "对输入进行双线性插值，scale_factor=2.0，mode='bilinear'，不对齐角点（align_corners=False）。",
        "输出高度 = 输入高度 * 2 = 1024，输出宽度 = 输入宽度 * 2 = 256。",
        "对应参考语句 x = F.interpolate(x, scale_factor=self.interp_scale_factor, mode=self.interp_mode)。"
      ]
    },
    {
      "name": "custom_argmax",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[128, 3, 1024, 256]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "default": 0,
          "optional": true
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.int64",
        "device": "cuda",
        "shape": "[3, 1024, 256]"
      },
      "semantics": [
        "沿 dim=0 计算 argmax，返回每个位置的最大值索引，dtype 为 int64。",
        "输出 shape 为 [3, 1024, 256]，对应参考语句 x = torch.argmax(x, dim=self.argmax_dim)。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = torch.round(x)",
      "semantics": [
        "对输入 x 的每个元素执行四舍五入，返回 float32 tensor，shape [128, 3, 512, 128]，device cuda:0。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = F.interpolate(x, scale_factor=self.interp_scale_factor, mode=self.interp_mode)",
      "semantics": [
        "使用双线性插值，scale_factor=2.0，mode='bilinear'，align_corners 未指定（默认 False），输出 shape [128, 3, 1024, 256]，float32，cuda:0。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = torch.argmax(x, dim=self.argmax_dim)",
      "semantics": [
        "沿 dim=0 计算 argmax，返回 int64 tensor，shape [3, 1024, 256]，cuda:0。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return x",
      "semantics": [
        "返回 argmax 的结果，int64 tensor，shape [3, 1024, 256]，cuda:0。"
      ]
    }
  ]
}