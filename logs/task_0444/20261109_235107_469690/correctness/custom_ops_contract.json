      "source": "x = torch.clamp(x, min=0, max=1)",
      "semantics": [
        "输入 x 形状 [16, 1, 512, 256]。",
        "逐元素限制在 [0, 1] 区间，输出与输入同形状。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return x",
      "semantics": [
