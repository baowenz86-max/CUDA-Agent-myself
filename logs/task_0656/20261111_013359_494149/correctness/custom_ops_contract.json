{
  "operators": [
    {
      "name": "embedding_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.int64",
          "device": "cuda",
          "shape": "[N, S] (batch, seq_len)",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[num_embeddings, embedding_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, S, embedding_dim]"
      },
      "semantics": [
        "对应参考语句 self.embedding(x)，即 nn.Embedding 的 forward。",
        "对于输入中每个索引 idx（int64），从 weight 矩阵第 idx 行复制 embedding_dim 个 float32 值。",
        "输出形状与输入形状 + embedding_dim 相同，索引顺序保持输入顺序。",
        "输出张量在 CUDA 上，内存布局为连续或与参考 stride 一致。"
      ]
    },
    {
      "name": "layer_norm_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, S, embedding_dim] (normalized_shape 为最后一维)",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[embedding_dim]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[embedding_dim]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "default": 1e-05,
          "nullable": false,
          "optional": true
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, S, embedding_dim]"
      },
      "semantics": [
        "对应参考语句 F.layer_norm(x, normalized_shape=self.layer_norm.normalized_shape, eps=self.layer_norm.eps)。",
        "对最后一个维度（大小 embedding_dim）计算均值 mean 和方差 var（使用有偏估计，除以 embedding_dim）。",
        "对于每个元素 y = (x - mean) / sqrt(var + eps) * weight + bias，其中 weight 和 bias 为 LayerNorm 参数。",
        "输出形状与输入相同，dtype float32，设备 CUDA。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.embedding(x)",
      "semantics": [
        "输入 x 是 int64 张量，形状 [320,512]，每个元素是 [0,999] 的索引。",
        "embedding.weight 形状 [1000,300] float32，按索引取出对应行，得到 shape [320,512,300] 的 float32 张量。",
        "输出 stride 为 [153600,300,1]，连续内存。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = F.layer_norm(x, normalized_shape=self.layer_norm.normalized_shape, eps=self.layer_norm.eps)",
      "semantics": [
        "对 [320,512,300] 的 float32 张量，在最后一维 300 上计算均值和方差，并使用 layer_norm.weight 和 layer_norm.bias 进行仿射变换。",
        "输出 shape、stride 与输入相同。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回 LayerNorm 后的张量，shape [320,512,300]，float32，CUDA 设备。"
      ]
    }
  ]
}