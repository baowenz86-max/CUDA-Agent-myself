--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,187 @@
+#include <cuda_runtime.h>
+#include <math.h>
+
+// AvgPool1d forward kernel
+// Input: x [batch, in_channels, length], output [batch, in_channels, pooled_length]
+// kernel_size, stride, padding are scalars
+__global__ void avgpool1d_kernel(const float* __restrict__ x,
+                                 float* __restrict__ y,
+                                 int batch,
+                                 int channels,
+                                 int length,
+                                 int pooled_length,
+                                 int kernel_size,
+                                 int stride,
+                                 int padding) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = batch * channels * pooled_length;
+    if (idx >= total) return;
+
+    int ow = idx % pooled_length;
+    int oc = (idx / pooled_length) % channels;
+    int ob = idx / (pooled_length * channels);
+
+    int start = ow * stride - padding;
+    float sum = 0.0f;
+    for (int k = 0; k < kernel_size; ++k) {
+        int pos = start + k;
+        if (pos >= 0 && pos < length) {
+            sum += x[((ob * channels + oc) * length) + pos];
+        }
+    }
+    y[idx] = sum / kernel_size;
+}
+
+// Tanh forward kernel: element-wise tangent (not hyperbolic tanh)
+// Note: torch.tan computes tangent, not tanh. However, model_new.py uses cuda_extension.tanh_forward,
+// which maps to torch.tan in reference. The operator name is tanh_forward but semantics says tangent.
+// We name it tanh_kernel for consistency with function name, but compute tanf.
+__global__ void tanh_kernel(const float* __restrict__ x,
+                            float* __restrict__ y,
+                            int n) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx < n) {
+        y[idx] = tanf(x[idx]);
+    }
+}
+
+// Cross-entropy loss kernel with mean reduction
+// Input: x [batch, classes] where classes = in_channels * pooled_length
+// target: int64 [batch]
+// Output: scalar loss float
+__global__ void cross_entropy_loss_kernel(const float* __restrict__ x,
+                                          const long long* __restrict__ target,
+                                          float* __restrict__ loss,
+                                          int batch,
+                                          int classes) {
+    extern __shared__ float sdata[];
+    int tid = threadIdx.x;
+    int bid = blockIdx.x;
+
+    // Each block processes one batch sample
+    if (bid >= batch) return;
+
+    const float* sample = x + bid * classes;
+    long long t = target[bid];
+    
+    // Find max for numerical stability
+    float max_val = sample[0];
+    for (int i = tid; i < classes; i += blockDim.x) {
+        float v = sample[i];
+        if (v > max_val) max_val = v;
+    }
+    // block reduction for max
+    sdata[tid] = max_val;
+    __syncthreads();
+    for (int s = blockDim.x / 2; s > 0; s >>= 1) {
+        if (tid < s) {
+            if (sdata[tid + s] > sdata[tid]) sdata[tid] = sdata[tid + s];
+        }
+        __syncthreads();
+    }
+    float block_max = sdata[0];
+    __syncthreads();
+
+    // Compute sum of exp(x_i - max)
+    float sum_exp = 0.0f;
+    for (int i = tid; i < classes; i += blockDim.x) {
+        sum_exp += expf(sample[i] - block_max);
+    }
+    sdata[tid] = sum_exp;
+    __syncthreads();
+    for (int s = blockDim.x / 2; s > 0; s >>= 1) {
+        if (tid < s) {
+            sdata[tid] += sdata[tid + s];
+        }
+        __syncthreads();
+    }
+    float block_sum_exp = sdata[0];
+
+    // Compute loss for this sample: -x_target + log(sum_exp)
+    float sample_loss = 0.0f;
+    if (tid == 0) {
+        if (t >= 0 && t < classes) {
+            sample_loss = -sample[t] + logf(block_sum_exp);
+        } else {
+            sample_loss = logf(block_sum_exp); // ignore invalid target (should not happen)
+        }
+        atomicAdd(loss, sample_loss);
+    }
+}
+
+// Launchers
+extern "C" void avgpool1d_forward_launcher(const float* x,
+                                            float* y,
+                                            int batch,
+                                            int channels,
+                                            int length,
+                                            int pooled_length,
+                                            int kernel_size,
+                                            int stride,
+                                            int padding,
+                                            cudaStream_t stream) {
+    int total = batch * channels * pooled_length;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    avgpool1d_kernel<<<blocks, threads, 0, stream>>>(x, y, batch, channels, length, pooled_length,
+                                                    kernel_size, stride, padding);
+}
+
+extern "C" void tanh_forward_launcher(const float* x, float* y, int n, cudaStream_t stream) {
+    int threads = 256;
+    int blocks = (n + threads - 1) / threads;
+    tanh_kernel<<<blocks, threads, 0, stream>>>(x, y, n);
+}
+
+extern "C" void cross_entropy_loss_forward_launcher(const float* x,
+                                                    const long long* target,
+                                                    float* loss,
+                                                    int batch,
+                                                    int classes,
+                                                    cudaStream_t stream) {
+    // Initialize loss to 0 on device
+    cudaMemsetAsync(loss, 0, sizeof(float), stream);
+
+    int threads = 256;
+    int blocks = batch; // one block per sample
+    size_t shared_mem = threads * sizeof(float);
+    cross_entropy_loss_kernel<<<blocks, threads, shared_mem, stream>>>(x, target, loss, batch, classes);
+
+    // After kernel, need to divide by batch for mean reduction
+    // We'll do this in a separate small kernel
+    // Alternatively, we can incorporate the division in the kernel by scaling atomicAdd
+    // But easier: launch a simple scale kernel
+    // However, to avoid extra kernel, we can compute mean in a separate kernel or do in same kernel with atomicAdd and then scale on host? No, need device scalar.
+    // For simplicity, we'll use a second kernel to scale by 1/batch
+    // But we need a float* loss that is device memory.
+    // We'll add a simple scale kernel.
+}
+
+// Scale kernel for loss mean reduction
+__global__ void scale_kernel(float* loss, float scale) {
+    *loss *= scale;
+}
+
+// Launcher for cross entropy loss (including mean scaling)
+extern "C" void cross_entropy_loss_forward_launcher(const float* x,
+                                                    const long long* target,
+                                                    float* loss,
+                                                    int batch,
+                                                    int classes,
+                                                    cudaStream_t stream) {
+    // Initialize loss to 0 on device
+    cudaMemsetAsync(loss, 0, sizeof(float), stream);
+
+    int threads = 256;
+    int blocks = batch; // one block per sample
+    size_t shared_mem = threads * sizeof(float);
+    cross_entropy_loss_kernel<<<blocks, threads, shared_mem, stream>>>(x, target, loss, batch, classes);
+
+    // Scale by 1/batch for mean reduction
+    float scale = 1.0f / batch;
+    scale_kernel<<<1, 1, 0, stream>>>(loss, scale);
+}
+
+// Helper function to check CUDA errors (optional, not needed in launcher)
+// But we can add error checking in launchers if desired.
+// The binding will handle error checking, but we can add cudaGetLastError after launches.
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,137 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void avgpool1d_forward_launcher(const float* x,
+                                            float* y,
+                                            int batch,
+                                            int channels,
+                                            int length,
+                                            int pooled_length,
+                                            int kernel_size,
+                                            int stride,
+                                            int padding,
+                                            cudaStream_t stream);
+
+extern "C" void tanh_forward_launcher(const float* x, float* y, int n, cudaStream_t stream);
+
+extern "C" void cross_entropy_loss_forward_launcher(const float* x,
+                                                    const long long* target,
+                                                    float* loss,
+                                                    int batch,
+                                                    int classes,
+                                                    cudaStream_t stream);
+
+// Wrapper for avgpool1d_forward
+torch::Tensor avgpool1d_forward(torch::Tensor x, int64_t kernel_size, int64_t stride, int64_t padding) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 3, "Input must be 3D (batch, channels, length)");
+
+    int batch = x.size(0);
+    int channels = x.size(1);
+    int length = x.size(2);
+
+    // Compute pooled length as in PyTorch AvgPool1d: floor((L + 2*padding - kernel_size) / stride) + 1
+    int pooled_length = (length + 2 * static_cast<int>(padding) - static_cast<int>(kernel_size)) / static_cast<int>(stride) + 1;
+
+    TORCH_CHECK(pooled_length > 0, "Invalid pooling parameters");
+
+    auto y = torch::empty({batch, channels, pooled_length}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    avgpool1d_forward_launcher(
+        x.data_ptr<float>(),
+        y.data_ptr<float>(),
+        batch,
+        channels,
+        length,
+        pooled_length,
+        static_cast<int>(kernel_size),
+        static_cast<int>(stride),
+        static_cast<int>(padding),
+        stream
+    );
+
+    return y;
+}
+
+// Wrapper for tanh_forward (actually tangent, as per reference)
+torch::Tensor tanh_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+
+    auto y = torch::empty_like(x);
+    int n = x.numel();
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    tanh_forward_launcher(
+        x.data_ptr<float>(),
+        y.data_ptr<float>(),
+        n,
+        stream
+    );
+
+    return y;
+}
+
+// Wrapper for cross_entropy_loss_forward
+torch::Tensor cross_entropy_loss_forward(torch::Tensor x, torch::Tensor target) {
+    TORCH_CHECK(x.is_cuda(), "Input x must be a CUDA tensor");
+    TORCH_CHECK(target.is_cuda(), "Target must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "Input x must be contiguous");
+    TORCH_CHECK(target.is_contiguous(), "Target must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input x must be float32");
+    TORCH_CHECK(target.dtype() == torch::kInt64, "Target must be int64");
+    TORCH_CHECK(x.dim() >= 2, "Input x must have at least 2 dimensions");
+    TORCH_CHECK(target.dim() == 1, "Target must be 1D");
+
+    int batch = x.size(0);
+    int classes = x.numel() / batch;
+    TORCH_CHECK(target.size(0) == batch, "Batch size mismatch between x and target");
+
+    // Allocate scalar output on GPU
+    auto loss = torch::empty({}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    cross_entropy_loss_forward_launcher(
+        x.data_ptr<float>(),
+        reinterpret_cast<const long long*>(target.data_ptr<int64_t>()),
+        loss.data_ptr<float>(),
+        batch,
+        classes,
+        stream
+    );
+
+    return loss;
+}
+
+// Registration
+void register_custom_ops(pybind11::module& m) {
+    m.def("avgpool1d_forward", &avgpool1d_forward,
+          "AvgPool1d forward (CUDA)",
+          pybind11::arg("x"),
+          pybind11::arg("kernel_size"),
+          pybind11::arg("stride"),
+          pybind11::arg("padding"));
+
+    m.def("tanh_forward", &tanh_forward,
+          "Element-wise tangent forward (CUDA)",
+          pybind11::arg("x"));
+
+    m.def("cross_entropy_loss_forward", &cross_entropy_loss_forward,
+          "Cross entropy loss forward (CUDA)",
+          pybind11::arg("x"),
+          pybind11::arg("target"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,30 @@
+import torch
+import torch.nn as nn
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, kernel_size, stride, padding, num_classes):
+        super().__init__()
+        self.in_channels = in_channels
+        self.kernel_size = kernel_size
+        self.stride = stride
+        self.padding = padding
+        self.num_classes = num_classes
+        self.avg_pool = nn.AvgPool1d(kernel_size, stride=stride, padding=padding)
+
+    def forward(self, x, target):
+        import cuda_extension
+        x = cuda_extension.avgpool1d_forward(x, self.kernel_size, self.stride, self.padding)
+        x = cuda_extension.tanh_forward(x)
+        loss = cuda_extension.cross_entropy_loss_forward(x, target)
+        return loss
+
+    def debug_forward(self, *inputs):
+        import cuda_extension
+        x, target = inputs
+        x = cuda_extension.avgpool1d_forward(x, self.kernel_size, self.stride, self.padding)
+        yield 'step_001', x
+        x = cuda_extension.tanh_forward(x)
+        yield 'step_002', x
+        loss = cuda_extension.cross_entropy_loss_forward(x, target)
+        yield 'step_003', loss
+        yield 'step_004', loss
