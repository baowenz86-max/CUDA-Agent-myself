      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, D_in, embedding_dim]"
      },
      "semantics": [
        "对应 self.embedding(x)，即 torch.nn.functional.embedding(x, weight, padding_idx=None, max_norm=None, norm_type=2.0, scale_grad_by_freq=False, sparse=False)。输入 indices 形状 [N, D_in]，weight 形状 [num_embeddings, embedding_dim]，输出形状 [N, D_in, embedding_dim]。输出 dtype 为 float32，与 weight 相同。索引超出范围时行为同 PyTorch（未定义，但输入保证在范围内）。"
      ]
    },
    {
      "name": "reflection_pad2d_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, D_in, embedding_dim]",
          "layout": "strided",
          "nullable": false,
          "optional": false
        },
        {
          "name": "pad_l",
          "kind": "int",
          "dtype": null,
          "device": null,
          "shape": null,
          "layout": null,
          "nullable": false,
          "optional": false
        },
        {
          "name": "pad_r",
          "kind": "int",
          "dtype": null,
          "device": null,
          "shape": null,
          "layout": null,
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, D_in, embedding_dim + pad_l + pad_r]"
      },
      "semantics": [
        "对应 self.reflection_pad(x)，其中 padding_size=(pad_l, pad_r) 表示宽度维度（最后一个维度）两侧各填充 pad_l 和 pad_r。输入形状 [N, D_in, W]，输出形状 [N, D_in, W + pad_l + pad_r]。反射填充规则与 torch.nn.ReflectionPad2d 在 3D 输入上一致（将输入视为 [N, C, W]）。padding 必须小于对应维度的尺寸，输入保证满足。"
      ]
    },
    {
      "name": "sub_scalar_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, D_in, W_out]",
          "layout": "strided",
          "nullable": false,
          "optional": false
        },
        {
          "name": "scalar",
          "kind": "float",
          "dtype": null,
          "device": null,
          "shape": null,
          "layout": null,
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, D_in, W_out]"
      },
      "semantics": [
        "对应 torch.sub(x, scalar)，执行逐元素 x - scalar，输出形状与输入相同，dtype 为 float32。标量广播到整个张量。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.embedding(x)",
      "semantics": [
        "输入 indices 形状 [51200, 16]，device CPU 但实际传递到 CUDA；weight 形状 [5, 64]，float32。输出形状 [51200, 16, 64]，float32，cuda:0，stride [1024, 64, 1]。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.reflection_pad(x)",
      "semantics": [
        "对形状 [51200, 16, 64] 的 3D 张量进行 ReflectionPad2d(3,3)，即在最后一维两侧各 pad 3，输出形状 [51200, 16, 70]，float32，cuda:0，stride [1120, 70, 1]。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return torch.sub(x, 0.5)",
      "semantics": [
        "逐元素减去 0.5，输出形状 [51200, 16, 70]，float32，cuda:0。"
      ]
    }
  ]
