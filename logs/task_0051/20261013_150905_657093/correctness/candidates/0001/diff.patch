--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,137 @@
+#include <cuda_runtime.h>
+
+// Embedding lookup: output[n, d, e] = weight[indices[n, d], e]
+__global__ void embedding_kernel(
+    const int64_t* __restrict__ indices,
+    const float* __restrict__ weight,
+    float* __restrict__ output,
+    int N,
+    int D,
+    int E,
+    int num_embeddings) {
+    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
+    int64_t total = (int64_t)N * D * E;
+    if (idx >= total) return;
+
+    int n = idx / ((int64_t)D * E);
+    int rem = idx % ((int64_t)D * E);
+    int d = rem / E;
+    int e = rem % E;
+
+    int64_t input_idx = (int64_t)n * D + d;
+    int64_t embedding_idx = indices[input_idx];
+    // Assume indices in range; optionally clamp to [0, num_embeddings-1]
+    if (embedding_idx < 0 || embedding_idx >= num_embeddings) {
+        output[idx] = 0.0f;
+        return;
+    }
+    output[idx] = weight[embedding_idx * E + e];
+}
+
+// Reflection padding along last dimension: input [N, D, W_in], output [N, D, W_out]
+// where W_out = W_in + pad_l + pad_r.
+__global__ void reflection_pad2d_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int N,
+    int D,
+    int W_in,
+    int W_out,
+    int pad_l,
+    int pad_r) {
+    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
+    int64_t total = (int64_t)N * D * W_out;
+    if (idx >= total) return;
+
+    int n = idx / ((int64_t)D * W_out);
+    int rem = idx % ((int64_t)D * W_out);
+    int d = rem / W_out;
+    int w = rem % W_out;
+
+    // Compute reflected index in input width [0, W_in-1]
+    int src_w;
+    if (w < pad_l) {
+        // left padding: reflect from pad_l - w - 1? Actually mirror at boundary pad_l
+        // For reflection padding, leftmost output index 0 maps to input index pad_l, then pad_l-1,...
+        src_w = pad_l - w;  // w=0 -> pad_l, w=1 -> pad_l-1, ... up to pad_l-1 -> 1
+        if (src_w >= W_in) src_w = 2 * W_in - 2 - src_w; // if pad_l >= W_in (not expected)
+    } else if (w >= pad_l + W_in) {
+        // right padding: w - pad_l - W_in = 0,1,... => src_w = W_in-1 - (w - pad_l - W_in + 1)
+        int offset = w - pad_l - W_in;
+        src_w = W_in - 1 - (offset + 1);
+        // equivalent: src_w = 2*W_in - 2 - (pad_l + offset)
+    } else {
+        src_w = w - pad_l;
+    }
+
+    // Safety check for extreme padding, though contract assures pad < W_in
+    if (src_w < 0) src_w = 0;
+    if (src_w >= W_in) src_w = W_in - 1;
+
+    int64_t input_idx = ((int64_t)n * D + d) * W_in + src_w;
+    output[idx] = input[input_idx];
+}
+
+// Scalar subtraction: output[i] = input[i] - scalar
+__global__ void sub_scalar_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    float scalar,
+    int64_t total) {
+    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
+    if (idx >= total) return;
+    output[idx] = input[idx] - scalar;
+}
+
+// Host launchers with C linkage
+
+extern "C" void embedding_forward_cuda(
+    const int64_t* indices,
+    const float* weight,
+    float* output,
+    int N,
+    int D,
+    int E,
+    int num_embeddings,
+    cudaStream_t stream) {
+    int64_t total = (int64_t)N * D * E;
+    int threads = 256;
+    int64_t blocks = (total + threads - 1) / threads;
+    if (blocks > 0) {
+        embedding_kernel<<<(unsigned int)blocks, threads, 0, stream>>>(
+            indices, weight, output, N, D, E, num_embeddings);
+    }
+}
+
+extern "C" void reflection_pad2d_forward_cuda(
+    const float* input,
+    float* output,
+    int N,
+    int D,
+    int W_in,
+    int W_out,
+    int pad_l,
+    int pad_r,
+    cudaStream_t stream) {
+    int64_t total = (int64_t)N * D * W_out;
+    int threads = 256;
+    int64_t blocks = (total + threads - 1) / threads;
+    if (blocks > 0) {
+        reflection_pad2d_kernel<<<(unsigned int)blocks, threads, 0, stream>>>(
+            input, output, N, D, W_in, W_out, pad_l, pad_r);
+    }
+}
+
+extern "C" void sub_scalar_forward_cuda(
+    const float* input,
+    float* output,
+    float scalar,
+    int64_t total,
+    cudaStream_t stream) {
+    int threads = 256;
+    int64_t blocks = (total + threads - 1) / threads;
+    if (blocks > 0) {
+        sub_scalar_kernel<<<(unsigned int)blocks, threads, 0, stream>>>(
+            input, output, scalar, total);
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,122 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// 声明 custom_ops.cu 导出的 launcher
+extern "C" void embedding_forward_cuda(
+    const int64_t* indices,
+    const float* weight,
+    float* output,
+    int N,
+    int D,
+    int E,
+    int num_embeddings,
+    cudaStream_t stream);
+
+extern "C" void reflection_pad2d_forward_cuda(
+    const float* input,
+    float* output,
+    int N,
+    int D,
+    int W_in,
+    int W_out,
+    int pad_l,
+    int pad_r,
+    cudaStream_t stream);
+
+extern "C" void sub_scalar_forward_cuda(
+    const float* input,
+    float* output,
+    float scalar,
+    int64_t total,
+    cudaStream_t stream);
+
+// embedding_forward 包装
+torch::Tensor embedding_forward(torch::Tensor indices, torch::Tensor weight) {
+    TORCH_CHECK(indices.is_cuda(), "indices must be a CUDA tensor");
+    TORCH_CHECK(weight.is_cuda(), "weight must be a CUDA tensor");
+    TORCH_CHECK(indices.dtype() == torch::kInt64, "indices must be int64");
+    TORCH_CHECK(weight.dtype() == torch::kFloat32, "weight must be float32");
+    TORCH_CHECK(indices.is_contiguous(), "indices must be contiguous");
+    TORCH_CHECK(weight.is_contiguous(), "weight must be contiguous");
+
+    auto N = indices.size(0);
+    auto D = indices.size(1);
+    auto E = weight.size(1);
+    int num_embeddings = weight.size(0);
+
+    auto output = torch::empty({N, D, E}, indices.options().dtype(torch::kFloat32));
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    embedding_forward_cuda(
+        indices.data_ptr<int64_t>(),
+        weight.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, D, E, num_embeddings,
+        stream);
+
+    return output;
+}
+
+// reflection_pad2d_forward 包装
+torch::Tensor reflection_pad2d_forward(torch::Tensor input, int64_t pad_l, int64_t pad_r) {
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(input.is_contiguous(), "input must be contiguous");
+    TORCH_CHECK(input.dim() == 3, "input must be 3D (N, C, W)");
+
+    int N = input.size(0);
+    int D = input.size(1);
+    int W_in = input.size(2);
+    int pad_l_int = static_cast<int>(pad_l);
+    int pad_r_int = static_cast<int>(pad_r);
+    int W_out = W_in + pad_l_int + pad_r_int;
+
+    TORCH_CHECK(pad_l_int >= 0 && pad_r_int >= 0, "padding must be non-negative");
+
+    auto output = torch::empty({N, D, W_out}, input.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    reflection_pad2d_forward_cuda(
+        input.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, D, W_in, W_out, pad_l_int, pad_r_int,
+        stream);
+
+    return output;
+}
+
+// sub_scalar_forward 包装
+torch::Tensor sub_scalar_forward(torch::Tensor input, double scalar) {
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(input.is_contiguous(), "input must be contiguous");
+
+    auto output = torch::empty_like(input);
+    int64_t total = input.numel();
+    float scalar_f = static_cast<float>(scalar);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    sub_scalar_forward_cuda(
+        input.data_ptr<float>(),
+        output.data_ptr<float>(),
+        scalar_f,
+        total,
+        stream);
+
+    return output;
+}
+
+// 注册函数
+void register_custom_ops(pybind11::module& m) {
+    m.def("embedding_forward", &embedding_forward, "Embedding forward",
+          py::arg("indices"), py::arg("weight"));
+    m.def("reflection_pad2d_forward", &reflection_pad2d_forward, "ReflectionPad2d forward",
+          py::arg("input"), py::arg("pad_l"), py::arg("pad_r"));
+    m.def("sub_scalar_forward", &sub_scalar_forward, "Sub scalar forward",
+          py::arg("input"), py::arg("scalar"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,24 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, num_embeddings, embedding_dim, padding_size):
+        super().__init__()
+        self.embedding = nn.Embedding(num_embeddings, embedding_dim)
+        self.reflection_pad = nn.ReflectionPad2d(padding_size)
+        self.padding_size = padding_size
+
+    def forward(self, x):
+        x = cuda_extension.embedding_forward(x, self.embedding.weight)
+        x = cuda_extension.reflection_pad2d_forward(x, self.padding_size[0], self.padding_size[1])
+        return cuda_extension.sub_scalar_forward(x, 0.5)
+
+    def debug_forward(self, x):
+        x = cuda_extension.embedding_forward(x, self.embedding.weight)
+        yield 'step_001', x
+        x = cuda_extension.reflection_pad2d_forward(x, self.padding_size[0], self.padding_size[1])
+        yield 'step_002', x
+        result = cuda_extension.sub_scalar_forward(x, 0.5)
+        yield 'step_003', result
