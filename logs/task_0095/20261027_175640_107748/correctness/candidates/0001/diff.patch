--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,256 @@
+// kernels/custom_ops.cu
+// CUDA kernels and launchers for custom ops (no PyTorch dependencies)
+// All functions use raw pointers, scalars, and cudaStream_t
+
+#include <cuda_runtime.h>
+#include <cudnn.h>
+#include <cstdint>
+#include <cstdio>
+
+// -----------------------------------------------------------------------------
+// linspace kernel
+// Generates `steps` float32 values from start to end inclusive,
+// matching torch.linspace (endpoint included) and then moved to CUDA.
+// If steps == 1, output is [start].
+// -----------------------------------------------------------------------------
+__global__ void linspace_kernel(float* output, float start, float end, int64_t steps) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx < steps) {
+        if (steps == 1) {
+            output[idx] = start;
+        } else {
+            float ratio = static_cast<float>(idx) / static_cast<float>(steps - 1);
+            output[idx] = start + ratio * (end - start);
+        }
+    }
+}
+
+// -----------------------------------------------------------------------------
+// sub_broadcast kernel
+// Computes out[n, c, l] = x[n, c, l] - linear_space[l]
+// x may be non-contiguous: we use element-wise indexing with strides.
+// linear_space must be contiguous.
+// -----------------------------------------------------------------------------
+__global__ void sub_broadcast_kernel(
+    float* out,
+    const float* x,
+    const float* linear_space,
+    int64_t batch,
+    int64_t channels,
+    int64_t length,
+    int64_t stride_batch,
+    int64_t stride_channel,
+    int64_t stride_length
+) {
+    int64_t idx = blockIdx.x * static_cast<int64_t>(blockDim.x) + threadIdx.x;
+    int64_t total = batch * channels * length;
+    if (idx >= total) return;
+
+    int64_t l = idx % length;
+    int64_t rem = idx / length;
+    int64_t c = rem % channels;
+    int64_t n = rem / channels;
+
+    int64_t x_idx = n * stride_batch + c * stride_channel + l * stride_length;
+    out[idx] = x[x_idx] - linear_space[l];
+}
+
+// -----------------------------------------------------------------------------
+// cuDNN ConvTranspose1d launcher
+// Parameters:
+//   input:   [batch, in_channels, length_in]  (float32, may be non-contiguous)
+//   weight:  [in_channels, out_channels, kernel_size] (contiguous, float32)
+//   bias:    [out_channels] or nullptr
+//   stride, padding, output_padding
+// Returns via output pointer allocated by the caller (but launcher can optionally allocate,
+// here caller passes output pointer).
+// -----------------------------------------------------------------------------
+extern "C" void conv_transpose1d_launcher(
+    const float* input,
+    int64_t batch,
+    int64_t in_channels,
+    int64_t length_in,
+    const float* weight,
+    int64_t out_channels,
+    int64_t kernel_size,
+    const float* bias,
+    int64_t stride,
+    int64_t padding,
+    int64_t output_padding,
+    float* output,
+    int64_t length_out,
+    cudaStream_t stream
+) {
+    cudnnHandle_t handle;
+    cudnnCreate(&handle);
+    cudnnSetStream(handle, stream);
+
+    cudnnTensorDescriptor_t input_desc, output_desc, bias_desc;
+    cudnnFilterDescriptor_t filter_desc;
+    cudnnConvolutionDescriptor_t conv_desc;
+
+    cudnnCreateTensorDescriptor(&input_desc);
+    cudnnCreateTensorDescriptor(&output_desc);
+    cudnnCreateTensorDescriptor(&bias_desc);
+    cudnnCreateFilterDescriptor(&filter_desc);
+    cudnnCreateConvolutionDescriptor(&conv_desc);
+
+    // Set input descriptor: shape [batch, in_channels, length_in]
+    cudnnSetTensor4dDescriptor(
+        input_desc,
+        CUDNN_TENSOR_NCHW,
+        CUDNN_DATA_FLOAT,
+        batch,
+        static_cast<int>(in_channels),
+        static_cast<int>(length_in),
+        1
+    );
+
+    // Set filter descriptor: shape [in_channels, out_channels, kernel_size, 1]
+    // For ConvTranspose1d, cuDNN expects filter as [in_channels, out_channels, kernel_size, 1]
+    cudnnSetFilter4dDescriptor(
+        filter_desc,
+        CUDNN_DATA_FLOAT,
+        CUDNN_TENSOR_NCHW,
+        static_cast<int>(in_channels),
+        static_cast<int>(out_channels),
+        static_cast<int>(kernel_size),
+        1
+    );
+
+    // Set convolution descriptor: we need cuDNN backward data operation
+    // with stride and padding; output_padding is handled by choosing output size
+    // and setting proper padding mode.
+    cudnnSetConvolution2dDescriptor(
+        conv_desc,
+        static_cast<int>(padding),      // pad_h (use same for width but we use height as length)
+        0,                               // pad_w (not used effectively)
+        static_cast<int>(stride),       // stride_h
+        1,                               // stride_w
+        1,                               // dilation_h
+        1,                               // dilation_w
+        CUDNN_CROSS_CORRELATION,         // mode (ConvTranspose1d uses cross-correlation in PyTorch)
+        CUDNN_DATA_FLOAT
+    );
+
+    // Output descriptor: [batch, out_channels, length_out, 1]
+    cudnnSetTensor4dDescriptor(
+        output_desc,
+        CUDNN_TENSOR_NCHW,
+        CUDNN_DATA_FLOAT,
+        batch,
+        static_cast<int>(out_channels),
+        static_cast<int>(length_out),
+        1
+    );
+
+    // Bias descriptor: [1, out_channels, 1, 1]
+    if (bias != nullptr) {
+        cudnnSetTensor4dDescriptor(
+            bias_desc,
+            CUDNN_TENSOR_NCHW,
+            CUDNN_DATA_FLOAT,
+            1,
+            static_cast<int>(out_channels),
+            1,
+            1
+        );
+    }
+
+    // For ConvTranspose, we use cudnnConvolutionBackwardData
+    // No need for weight gradients; all pointers are const float* but cuDNN expects void*,
+    // so const_cast is used (input is read-only, output is written).
+    const float alpha = 1.0f;
+    const float beta = 0.0f;
+
+    cudnnStatus_t status = cudnnConvolutionBackwardData(
+        handle,
+        &alpha,
+        filter_desc,
+        weight,
+        input_desc,
+        input,
+        conv_desc,
+        CUDNN_CONVOLUTION_BWD_DATA_ALGO_0,
+        nullptr,
+        0,
+        &beta,
+        output_desc,
+        output
+    );
+
+    if (status != CUDNN_STATUS_SUCCESS) {
+        fprintf(stderr, "cudnnConvolutionBackwardData failed: %s\n", cudnnGetErrorString(status));
+    }
+
+    // Add bias if present
+    if (bias != nullptr) {
+        // use cudnnAddTensor
+        cudnnStatus_t bias_status = cudnnAddTensor(
+            handle,
+            &alpha,
+            bias_desc,
+            bias,
+            &alpha,
+            output_desc,
+            output
+        );
+        if (bias_status != CUDNN_STATUS_SUCCESS) {
+            fprintf(stderr, "cudnnAddTensor failed: %s\n", cudnnGetErrorString(bias_status));
+        }
+    }
+
+    cudnnDestroyTensorDescriptor(input_desc);
+    cudnnDestroyTensorDescriptor(output_desc);
+    cudnnDestroyTensorDescriptor(bias_desc);
+    cudnnDestroyFilterDescriptor(filter_desc);
+    cudnnDestroyConvolutionDescriptor(conv_desc);
+    cudnnDestroy(handle);
+}
+
+// -----------------------------------------------------------------------------
+// Host launchers with plain C interface for binding layer
+// -----------------------------------------------------------------------------
+extern "C" void linspace_launcher(
+    float* output,
+    float start,
+    float end,
+    int64_t steps,
+    cudaStream_t stream
+) {
+    const int block_size = 256;
+    int64_t blocks = (steps + block_size - 1) / block_size;
+    linspace_kernel<<<static_cast<int>(blocks), block_size, 0, stream>>>(
+        output, start, end, steps
+    );
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        fprintf(stderr, "linspace_kernel launch error: %s\n", cudaGetErrorString(err));
+    }
+}
+
+extern "C" void sub_broadcast_launcher(
+    float* output,
+    const float* x,
+    const float* linear_space,
+    int64_t batch,
+    int64_t channels,
+    int64_t length,
+    int64_t stride_batch,
+    int64_t stride_channel,
+    int64_t stride_length,
+    cudaStream_t stream
+) {
+    const int block_size = 256;
+    int64_t total = batch * channels * length;
+    int64_t blocks = (total + block_size - 1) / block_size;
+    sub_broadcast_kernel<<<static_cast<int>(blocks), block_size, 0, stream>>>(
+        output, x, linear_space,
+        batch, channels, length,
+        stride_batch, stride_channel, stride_length
+    );
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        fprintf(stderr, "sub_broadcast_kernel launch error: %s\n", cudaGetErrorString(err));
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,205 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void linspace_launcher(
+    float* output,
+    float start,
+    float end,
+    int64_t steps,
+    cudaStream_t stream
+);
+
+extern "C" void sub_broadcast_launcher(
+    float* output,
+    const float* x,
+    const float* linear_space,
+    int64_t batch,
+    int64_t channels,
+    int64_t length,
+    int64_t stride_batch,
+    int64_t stride_channel,
+    int64_t stride_length,
+    cudaStream_t stream
+);
+
+extern "C" void conv_transpose1d_launcher(
+    const float* input,
+    int64_t batch,
+    int64_t in_channels,
+    int64_t length_in,
+    const float* weight,
+    int64_t out_channels,
+    int64_t kernel_size,
+    const float* bias,
+    int64_t stride,
+    int64_t padding,
+    int64_t output_padding,
+    float* output,
+    int64_t length_out,
+    cudaStream_t stream
+);
+
+// linspace_op: start, end, steps, device (torch.device) -> tensor [steps]
+torch::Tensor linspace_op(double start, double end, int64_t steps, torch::Device device) {
+    TORCH_CHECK(steps > 0, "steps must be positive");
+    TORCH_CHECK(device.is_cuda(), "linspace_op supports only CUDA device");
+    
+    auto output = torch::empty({steps}, torch::TensorOptions().dtype(torch::kFloat32).device(device));
+    
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream(device.index()).stream();
+    
+    linspace_launcher(
+        output.data_ptr<float>(),
+        static_cast<float>(start),
+        static_cast<float>(end),
+        steps,
+        stream
+    );
+    
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "linspace_launcher failed: ", cudaGetErrorString(err));
+    
+    return output;
+}
+
+// sub_broadcast: x (supports strides), linear_space (contiguous) -> tensor same shape as x
+torch::Tensor sub_broadcast(torch::Tensor x, torch::Tensor linear_space) {
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(linear_space.is_cuda(), "linear_space must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(linear_space.dtype() == torch::kFloat32, "linear_space must be float32");
+    TORCH_CHECK(linear_space.is_contiguous(), "linear_space must be contiguous");
+    TORCH_CHECK(x.dim() == 3, "x must be 3D [batch, channels, length]");
+    TORCH_CHECK(linear_space.dim() == 1, "linear_space must be 1D [length]");
+    
+    int64_t length = x.size(2);
+    TORCH_CHECK(linear_space.size(0) == length, "linear_space length mismatch");
+    
+    auto output = torch::empty_like(x);
+    
+    int64_t batch = x.size(0);
+    int64_t channels = x.size(1);
+    int64_t stride_batch = x.stride(0);
+    int64_t stride_channel = x.stride(1);
+    int64_t stride_length = x.stride(2);
+    
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    
+    sub_broadcast_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        linear_space.data_ptr<float>(),
+        batch,
+        channels,
+        length,
+        stride_batch,
+        stride_channel,
+        stride_length,
+        stream
+    );
+    
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "sub_broadcast_launcher failed: ", cudaGetErrorString(err));
+    
+    return output;
+}
+
+// conv_transpose1d: input, weight, bias (optional), stride, padding, output_padding -> tensor
+torch::Tensor conv_transpose1d(
+    torch::Tensor input,
+    torch::Tensor weight,
+    torch::Tensor bias,
+    int64_t stride,
+    int64_t padding,
+    int64_t output_padding
+) {
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(weight.is_cuda(), "weight must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(weight.dtype() == torch::kFloat32, "weight must be float32");
+    TORCH_CHECK(weight.is_contiguous(), "weight must be contiguous");
+    
+    if (bias.defined()) {
+        TORCH_CHECK(bias.is_cuda(), "bias must be a CUDA tensor");
+        TORCH_CHECK(bias.dtype() == torch::kFloat32, "bias must be float32");
+        TORCH_CHECK(bias.is_contiguous(), "bias must be contiguous");
+    }
+    
+    TORCH_CHECK(input.dim() == 3, "input must be 3D [batch, in_channels, length]");
+    TORCH_CHECK(weight.dim() == 3, "weight must be 3D [in_channels, out_channels, kernel_size]");
+    
+    int64_t batch = input.size(0);
+    int64_t in_channels = input.size(1);
+    int64_t length_in = input.size(2);
+    int64_t out_channels = weight.size(1);
+    int64_t kernel_size = weight.size(2);
+    
+    TORCH_CHECK(weight.size(0) == in_channels, "weight in_channels mismatch");
+    
+    if (bias.defined()) {
+        TORCH_CHECK(bias.size(0) == out_channels, "bias size mismatch");
+    }
+    
+    int64_t length_out = (length_in - 1) * stride - 2 * padding + kernel_size + output_padding;
+    TORCH_CHECK(length_out > 0, "output length must be positive");
+    
+    auto output = torch::empty({batch, out_channels, length_out}, input.options());
+    
+    const float* bias_ptr = nullptr;
+    if (bias.defined()) {
+        bias_ptr = bias.data_ptr<float>();
+    }
+    
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    
+    conv_transpose1d_launcher(
+        input.data_ptr<float>(),
+        batch,
+        in_channels,
+        length_in,
+        weight.data_ptr<float>(),
+        out_channels,
+        kernel_size,
+        bias_ptr,
+        stride,
+        padding,
+        output_padding,
+        output.data_ptr<float>(),
+        length_out,
+        stream
+    );
+    
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "conv_transpose1d_launcher failed: ", cudaGetErrorString(err));
+    
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    pybind11::class_<torch::Device>(m, "Device")
+        .def(pybind11::init<>());
+    m.def("linspace_op", &linspace_op,
+          "linspace_op(start, end, steps, device) -> Tensor",
+          pybind11::arg("start"),
+          pybind11::arg("end"),
+          pybind11::arg("steps"),
+          pybind11::arg("device"));
+    m.def("sub_broadcast", &sub_broadcast,
+          "sub_broadcast(x, linear_space) -> Tensor",
+          pybind11::arg("x"),
+          pybind11::arg("linear_space"));
+    m.def("conv_transpose1d", &conv_transpose1d,
+          "conv_transpose1d(input, weight, bias, stride, padding, output_padding) -> Tensor",
+          pybind11::arg("input"),
+          pybind11::arg("weight"),
+          pybind11::arg("bias"),
+          pybind11::arg("stride"),
+          pybind11::arg("padding"),
+          pybind11::arg("output_padding"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,29 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, out_channels, kernel_size, stride, padding, output_padding, start, end, steps):
+        super().__init__()
+        self.conv_transpose = nn.ConvTranspose1d(
+            in_channels, out_channels, kernel_size, stride=stride, padding=padding, output_padding=output_padding
+        )
+        self.start = start
+        self.end = end
+        self.steps = steps
+
+    def forward(self, x):
+        linear_space = cuda_extension.linspace_op(self.start, self.end, self.steps, x.device)
+        x = cuda_extension.sub_broadcast(x, linear_space)
+        x = cuda_extension.conv_transpose1d(x, self.conv_transpose.weight, self.conv_transpose.bias, self.conv_transpose.stride[0], self.conv_transpose.padding[0], self.conv_transpose.output_padding[0])
+        return x
+
+    def debug_forward(self, x):
+        linear_space = cuda_extension.linspace_op(self.start, self.end, self.steps, x.device)
+        yield ('step_001', linear_space)
+        x = cuda_extension.sub_broadcast(x, linear_space)
+        yield ('step_002', x)
+        x = cuda_extension.conv_transpose1d(x, self.conv_transpose.weight, self.conv_transpose.bias, self.conv_transpose.stride[0], self.conv_transpose.padding[0], self.conv_transpose.output_padding[0])
+        yield ('step_003', x)
+        yield ('step_004', x)
