+import math
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, out_channels, kernel_size, stride, padding, output_padding, start, end, steps):
+        super().__init__()
+        self.conv_transpose = nn.ConvTranspose1d(
+            in_channels, out_channels, kernel_size, stride=stride, padding=padding, output_padding=output_padding
+        )
+        self.start = start
+        self.end = end
+        self.steps = steps
+
+    def forward(self, x):
+        if x.is_cuda:
+            device_index = x.device.index if x.device.index is not None else 0
+            linear_space = cuda_extension.linspace_1d(self.start, self.end, self.steps, device_index)
+            x = cuda_extension.elementwise_sub(x, linear_space)
+            x = cuda_extension.conv_transpose1d(
+                x, self.conv_transpose.weight, self.conv_transpose.bias,
+                self.conv_transpose.stride[0], self.conv_transpose.padding[0],
+                self.conv_transpose.output_padding[0]
+            )
+        else:
+            linear_space = torch.linspace(self.start, self.end, self.steps).to(x.device)
+            x = torch.sub(x, linear_space)
+            x = self.conv_transpose(x)
+        return x
+
