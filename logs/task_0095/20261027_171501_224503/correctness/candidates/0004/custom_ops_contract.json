      "source": "x = self.conv_transpose(x)",
      "semantics": [
        "Apply ConvTranspose1d with weight, bias, stride=2, padding=1, output_padding=1. Input [128,3,16384] -> output [128,16,32768]."
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return x",
      "semantics": [
        "Return the output tensor of conv_transpose1d."
      ]
