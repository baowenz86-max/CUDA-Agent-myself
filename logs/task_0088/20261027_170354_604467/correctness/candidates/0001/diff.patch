+#include <cuda_runtime.h>
+
+// Helper: ceil division
+__device__ __forceinline__ int ceil_div(int a, int b) {
+    return (a + b - 1) / b;
+}
+
+// log_softmax along dim=1 for float32, NCHW layout, C=3 assumed but dynamic
+// Each block handles one (n, spatial_index), threads across C
+// Grid: N * H * W blocks, blockDim = C_threads (power of 2 >= C, up to 1024)
+// For C=3 we use blockDim=32 for simplicity; dynamic C supported via shared memory reduction.
+// To support arbitrary C, we use blockDim = next_power_of_2(C) but cap at 1024,
+// and each thread loads one or more elements in strided fashion.
+// For C=3 a simpler kernel is sufficient and fast.
+
+#define MAX_C 32 // Max channels handled in one block; if C > 32 we need different strategy, but contract C=3
+
+template <int BLOCK_SIZE>
+__global__ void log_softmax_dim1_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    int N, int C, int H, int W,
+    int total_spatial)
+{
+    extern __shared__ float smem[];
+    float* s_max = smem;
+    float* s_sum = smem + BLOCK_SIZE;
+
+    int spatial_idx = blockIdx.x;
+    if (spatial_idx >= total_spatial) return;
+
+    int tid = threadIdx.x;
+    int n = spatial_idx / (H * W);
+    int hw = spatial_idx % (H * W);
+
+    // Each thread handles channel(s) tid, tid+BLOCK_SIZE, ...
+    float local_max = -CUDART_INF_F;
+    for (int c = tid; c < C; c += BLOCK_SIZE) {
+        int idx = ((n * C + c) * H + hw) * W; // incorrect? We need spatial index: n*C*H*W + c*H*W + hw
+        // Actually flatten: input[n][c][h][w] => index = n*C*H*W + c*H*W + h*W + w
+        // Here hw is linear within H*W: h = hw / W, w = hw % W
+        // So index = n*C*H*W + c*H*W + hw
+        int idx = n * C * H * W + c * H * W + hw;
+        float val = input[idx];
+        local_max = fmaxf(local_max, val);
+    }
+
+    // Block reduction for max
+    s_max[tid] = local_max;
+    __syncthreads();
+
+    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
+        if (tid < stride) {
+            s_max[tid] = fmaxf(s_max[tid], s_max[tid + stride]);
+        }
+        __syncthreads();
+    }
+
+    float block_max = s_max[0];
+    __syncthreads();
+
+    // Compute sum of exp(x - max)
+    float local_sum = 0.0f;
+    for (int c = tid; c < C; c += BLOCK_SIZE) {
+        int idx = n * C * H * W + c * H * W + hw;
+        float val = input[idx];
+        local_sum += __expf(val - block_max);
+    }
+
+    s_sum[tid] = local_sum;
+    __syncthreads();
+
+    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
+        if (tid < stride) {
+            s_sum[tid] += s_sum[tid + stride];
+        }
+        __syncthreads();
+    }
+
+    float block_sum = s_sum[0];
+    __syncthreads();
+
+    float log_sum = logf(block_sum);
+
+    // Write output: log_softmax = x - max - log(sum)
+    for (int c = tid; c < C; c += BLOCK_SIZE) {
+        int idx = n * C * H * W + c * H * W + hw;
+        float val = input[idx];
+        output[idx] = val - block_max - log_sum;
+    }
+}
+
+// Similar for softmax (without log)
+template <int BLOCK_SIZE>
+__global__ void softmax_dim1_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    int N, int C, int H, int W,
+    int total_spatial)
+{
+    extern __shared__ float smem[];
+    float* s_max = smem;
+    float* s_sum = smem + BLOCK_SIZE;
+
+    int spatial_idx = blockIdx.x;
+    if (spatial_idx >= total_spatial) return;
+
+    int tid = threadIdx.x;
+    int n = spatial_idx / (H * W);
+    int hw = spatial_idx % (H * W);
+
+    float local_max = -CUDART_INF_F;
+    for (int c = tid; c < C; c += BLOCK_SIZE) {
+        int idx = n * C * H * W + c * H * W + hw;
+        float val = input[idx];
+        local_max = fmaxf(local_max, val);
+    }
+
+    s_max[tid] = local_max;
+    __syncthreads();
+
+    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
+        if (tid < stride) {
+            s_max[tid] = fmaxf(s_max[tid], s_max[tid + stride]);
+        }
+        __syncthreads();
+    }
+
+    float block_max = s_max[0];
+    __syncthreads();
+
+    float local_sum = 0.0f;
+    for (int c = tid; c < C; c += BLOCK_SIZE) {
+        int idx = n * C * H * W + c * H * W + hw;
+        float val = input[idx];
+        local_sum += __expf(val - block_max);
+    }
+
+    s_sum[tid] = local_sum;
+    __syncthreads();
+
+    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
+        if (tid < stride) {
+            s_sum[tid] += s_sum[tid + stride];
+        }
+        __syncthreads();
+    }
+
+    float block_sum = s_sum[0];
+    __syncthreads();
+
+    for (int c = tid; c < C; c += BLOCK_SIZE) {
+        int idx = n * C * H * W + c * H * W + hw;
+        float val = input[idx];
+        output[idx] = __expf(val - block_max) / block_sum;
+    }
+}
+
+// ReflectionPad2d kernel for NCHW layout, pad=2
+__global__ void reflection_pad2d_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    int N, int C, int H_in, int W_in,
+    int H_out, int W_out,
+    int pad_h, int pad_w)
+{
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = N * C * H_out * W_out;
+    if (idx >= total) return;
+
+    // Decode output coordinates
+    int w = idx % W_out;
+    int h = (idx / W_out) % H_out;
+    int c = (idx / (W_out * H_out)) % C;
+    int n = idx / (W_out * H_out * C);
+
+    // Compute source coordinates with reflection
+    int src_h = h - pad_h;
+    if (src_h < 0) src_h = -src_h;
+    if (src_h >= H_in) src_h = 2 * H_in - 2 - src_h;
+    // For pad=2, H_in >= 2 always, but we handle general case:
+    // Use while loops for multiple reflections if H_in < pad, but unlikely.
+
+    int src_w = w - pad_w;
+    if (src_w < 0) src_w = -src_w;
+    if (src_w >= W_in) src_w = 2 * W_in - 2 - src_w;
+
+    // For general reflection where source may still be out of bounds, apply repeatedly
+    // But for H_in=256, pad=2, single reflection enough.
+    // For safety, use loop:
+    while (src_h < 0 || src_h >= H_in) {
+        if (src_h < 0) src_h = -src_h;
+        else if (src_h >= H_in) src_h = 2 * H_in - 2 - src_h;
+    }
+    while (src_w < 0 || src_w >= W_in) {
+        if (src_w < 0) src_w = -src_w;
+        else if (src_w >= W_in) src_w = 2 * W_in - 2 - src_w;
+    }
+
+    int in_idx = ((n * C + c) * H_in + src_h) * W_in + src_w;
+    output[idx] = input[in_idx];
+}
+
+// Launchers
+
+extern "C" void log_softmax_launcher(
+    float* output,
+    const float* input,
+    int N, int C, int H, int W,
+    int dim,
+    cudaStream_t stream)
+{
+    // Only dim=1 supported per contract
+    if (dim != 1) {
+        // We could leave output unchanged or set error, but caller ensures dim=1
+        return;
+    }
+    int total_spatial = N * H * W;
+    // Choose block size: next power of 2 >= C, but at least 32 and max 256 for occupancy
+    int block_size = 32;
+    while (block_size < C) block_size <<= 1;
+    if (block_size > 256) block_size = 256;
+
+    int shared_mem_size = 2 * block_size * sizeof(float);
+
+    dim3 grid(total_spatial);
+    dim3 block(block_size);
+
+    switch(block_size) {
+        case 32:
+            log_softmax_dim1_kernel<32><<<grid, block, shared_mem_size, stream>>>(
+                output, input, N, C, H, W, total_spatial);
+            break;
+        case 64:
+            log_softmax_dim1_kernel<64><<<grid, block, shared_mem_size, stream>>>(
+                output, input, N, C, H, W, total_spatial);
+            break;
+        case 128:
+            log_softmax_dim1_kernel<128><<<grid, block, shared_mem_size, stream>>>(
+                output, input, N, C, H, W, total_spatial);
+            break;
+        case 256:
+            log_softmax_dim1_kernel<256><<<grid, block, shared_mem_size, stream>>>(
+                output, input, N, C, H, W, total_spatial);
+            break;
+        default:
+            // For larger C, need multiple threads per channel, but not expected
+            // Use block_size = 256 with grid-stride over channels
+            log_softmax_dim1_kernel<256><<<grid, block, shared_mem_size, stream>>>(
+                output, input, N, C, H, W, total_spatial);
+            break;
+    }
+}
+
+extern "C" void softmax_launcher(
+    float* output,
+    const float* input,
+    int N, int C, int H, int W,
+    int dim,
+    cudaStream_t stream)
+{
+    if (dim != 1) {
+        return;
+    }
+    int total_spatial = N * H * W;
+    int block_size = 32;
+    while (block_size < C) block_size <<= 1;
+    if (block_size > 256) block_size = 256;
+
+    int shared_mem_size = 2 * block_size * sizeof(float);
+
+    dim3 grid(total_spatial);
+    dim3 block(block_size);
+
+    switch(block_size) {
+        case 32:
+            softmax_dim1_kernel<32><<<grid, block, shared_mem_size, stream>>>(
+                output, input, N, C, H, W, total_spatial);
+            break;
+        case 64:
+            softmax_dim1_kernel<64><<<grid, block, shared_mem_size, stream>>>(
+                output, input, N, C, H, W, total_spatial);
+            break;
+        case 128:
+            softmax_dim1_kernel<128><<<grid, block, shared_mem_size, stream>>>(
+                output, input, N, C, H, W, total_spatial);
+            break;
+        case 256:
+            softmax_dim1_kernel<256><<<grid, block, shared_mem_size, stream>>>(
+                output, input, N, C, H, W, total_spatial);
+            break;
+        default:
+            softmax_dim1_kernel<256><<<grid, block, shared_mem_size, stream>>>(
+                output, input, N, C, H, W, total_spatial);
+            break;
+    }
+}
+
+extern "C" void reflection_pad2d_launcher(
+    float* output,
+    const float* input,
+    int N, int C, int H_in, int W_in,
+    int pad,
+    cudaStream_t stream)
+{
+    int H_out = H_in + 2 * pad;
+    int W_out = W_in + 2 * pad;
+    int total = N * C * H_out * W_out;
+
+    int block_size = 256;
+    int grid_size = (total + block_size - 1) / block_size;
+
+    reflection_pad2d_kernel<<<grid_size, block_size, 0, stream>>>(
+        output, input, N, C, H_in, W_in, H_out, W_out, pad, pad);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,114 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Launcher declarations from custom_ops.cu
+extern "C" void log_softmax_launcher(
+    float* output,
+    const float* input,
+    int N, int C, int H, int W,
+    int dim,
+    cudaStream_t stream);
+
+extern "C" void softmax_launcher(
+    float* output,
+    const float* input,
+    int N, int C, int H, int W,
+    int dim,
+    cudaStream_t stream);
+
+extern "C" void reflection_pad2d_launcher(
+    float* output,
+    const float* input,
+    int N, int C, int H_in, int W_in,
+    int pad,
+    cudaStream_t stream);
+
+// Helper to check tensor properties and return contiguous version if needed
+static torch::Tensor ensure_contiguous_float_cuda(const torch::Tensor& x, const char* name) {
+    TORCH_CHECK(x.is_cuda(), name, " must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, name, " must be float32");
+    if (!x.is_contiguous()) {
+        return x.contiguous();
+    }
+    return x;
+}
+
+// log_softmax forward (dim=1)
+torch::Tensor log_softmax_forward(torch::Tensor x, int64_t dim) {
+    TORCH_CHECK(dim == 1, "log_softmax only supports dim=1");
+    x = ensure_contiguous_float_cuda(x, "log_softmax input");
+    TORCH_CHECK(x.dim() == 4, "log_softmax input must be 4D (N,C,H,W)");
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+    auto output = torch::empty_like(x);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    log_softmax_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        N, C, H, W,
+        static_cast<int>(dim),
+        stream);
+    return output;
+}
+
+// softmax forward (dim=1)
+torch::Tensor softmax_forward(torch::Tensor x, int64_t dim) {
+    TORCH_CHECK(dim == 1, "softmax only supports dim=1");
+    x = ensure_contiguous_float_cuda(x, "softmax input");
+    TORCH_CHECK(x.dim() == 4, "softmax input must be 4D (N,C,H,W)");
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+    auto output = torch::empty_like(x);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    softmax_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        N, C, H, W,
+        static_cast<int>(dim),
+        stream);
+    return output;
+}
+
+// reflection_pad2d forward
+torch::Tensor reflection_pad2d_forward(torch::Tensor x, int64_t padding) {
+    TORCH_CHECK(padding >= 0, "padding must be non-negative");
+    x = ensure_contiguous_float_cuda(x, "reflection_pad2d input");
+    TORCH_CHECK(x.dim() == 4, "reflection_pad2d input must be 4D (N,C,H,W)");
+    int N = x.size(0);
+    int C = x.size(1);
+    int H_in = x.size(2);
+    int W_in = x.size(3);
+    int H_out = H_in + 2 * static_cast<int>(padding);
+    int W_out = W_in + 2 * static_cast<int>(padding);
+    auto output = torch::empty({N, C, H_out, W_out}, x.options());
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    reflection_pad2d_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        N, C, H_in, W_in,
+        static_cast<int>(padding),
+        stream);
+    return output;
+}
+
+// Register bindings
+void register_custom_ops(pybind11::module& m) {
+    m.def("log_softmax", &log_softmax_forward,
+          "Compute log_softmax along dim=1",
+          py::arg("x"), py::arg("dim"));
+    m.def("softmax", &softmax_forward,
+          "Compute softmax along dim=1",
+          py::arg("x"), py::arg("dim"));
+    m.def("reflection_pad2d", &reflection_pad2d_forward,
+          "Apply reflection padding of given size",
+          py::arg("x"), py::arg("padding"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
