@@ -0,0 +1,113 @@
+#include <cuda_runtime.h>
+
+// Kernel to concatenate two contiguous float tensors along a given dimension.
+// Each block handles a linear output index range using grid-stride loop.
+// Output is assumed contiguous; inputs are assumed contiguous (binding will ensure).
+// The concatenation is done as a flat copy: compute source tensor and offset based on output linear index.
+__global__ void concat_copy_kernel(
+    const float* __restrict__ a,
+    const float* __restrict__ b,
+    float* __restrict__ out,
+    int64_t a_numel,
+    int64_t b_numel,
+    int64_t dim_size_a,
+    int64_t dim_size_b,
+    int64_t inner_size,
+    int64_t outer_size
+) {
+    int64_t total = (a_numel + b_numel);
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+
+    for (int64_t i = idx; i < total; i += stride) {
+        // Determine if i falls within first tensor
+        if (i < a_numel) {
+            // Copy from a directly, since a occupies first a_numel elements in output for contiguous concatenation along dim
+            // For concatenation along dim with outer and inner, output ordering is:
+            // for each outer index o, the entire inner block for all dim values is contiguous.
+            // But if inputs are contiguous, output contiguous, and we concat along dim,
+            // the memory layout of output is: for each outer o, first all elements from tensor a for that outer (dim_size_a * inner_size), then b.
+            // That is exactly equivalent to copying a entirely, then b entirely, as long as both inputs contiguous and output contiguous with same other dims.
+            // However, if dim is not the last dimension, a's elements for different outer are not contiguous as a whole, but a is contiguous.
+            // Let's verify: output flat index of element (o, d, i) = ((o * dim_total + d) * inner_size + i).
+            // a occupies d < dim_size_a. For a, flat index in a = ((o * dim_size_a + d) * inner_size + i).
+            // This is not a simple prefix sum because inner_size and outer patterns differ.
+            // So a simple copy of entire a into output does not work if inner_size > 1 and outer_size > 0.
+            // Correct approach: iterate over output flat index and compute source flat index.
+            int64_t o = i / (dim_size_a + dim_size_b) / inner_size; // outer index
+            int64_t rem = i % ((dim_size_a + dim_size_b) * inner_size);
+            int64_t d = rem / inner_size;
+            int64_t inner = rem % inner_size;
+            if (d < dim_size_a) {
+                // from a
+                int64_t src = (o * dim_size_a + d) * inner_size + inner;
+                // bounds: src < a_numel
+                out[i] = a[src];
+            } else {
+                // from b, d_b = d - dim_size_a
+                int64_t d_b = d - dim_size_a;
+                int64_t src = (o * dim_size_b + d_b) * inner_size + inner;
+                out[i] = b[src];
+            }
+        } else {
+            // This branch is unreachable because total = a_numel + b_numel and i < total
+        }
+    }
+}
+
+// Launcher for squeeze_dim: Since in this task no dimension is squeezed, we can simply return success.
+// The binding should return the same tensor view (no allocation).
+// To avoid any kernel launch, launcher does nothing.
+extern "C" void squeeze_dim_launcher(
+    const float* input,
+    float* output,
+    int64_t dim,
+    int64_t input_ndim,
+    const int64_t* input_sizes,
+    const int64_t* input_strides,
+    cudaStream_t stream
+) {
+    // No operation needed; output will be an as_strided view handled by binding.
+    (void)input;
+    (void)output;
+    (void)dim;
+    (void)input_ndim;
+    (void)input_sizes;
+    (void)input_strides;
+    (void)stream;
+}
+
+// Launcher for concatenation of two tensors along a dimension.
+extern "C" void concat_two_launcher(
+    const float* a,
+    const float* b,
+    float* out,
+    int64_t a_sizes[8],  // max 8 dims, but we'll use actual ndim
+    int64_t b_sizes[8],
+    int64_t ndim,
+    int64_t dim,
+    cudaStream_t stream
+) {
+    // Compute sizes along each dimension, assuming all except dim equal.
+    int64_t inner_size = 1;
+    for (int64_t d = dim + 1; d < ndim; ++d) {
+        inner_size *= a_sizes[d];
+    }
+    int64_t outer_size = 1;
+    for (int64_t d = 0; d < dim; ++d) {
+        outer_size *= a_sizes[d];
+    }
+    int64_t dim_size_a = a_sizes[dim];
+    int64_t dim_size_b = b_sizes[dim];
+    int64_t a_numel = outer_size * dim_size_a * inner_size;
+    int64_t b_numel = outer_size * dim_size_b * inner_size;
+    int64_t total = a_numel + b_numel;
+
+    int threads = 256;
+    int blocks = (int)((total + threads - 1) / threads);
+    if (blocks > 65535) blocks = 65535; // grid limit; but total likely fits
+    // Use grid-stride loop to cover all elements even if total > blocks*threads
+    concat_copy_kernel<<<blocks, threads, 0, stream>>>(
+        a, b, out, a_numel, b_numel, dim_size_a, dim_size_b, inner_size, outer_size
+    );
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,155 @@
+// Binding for custom ops: squeeze_dim and concat_dim
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_runtime.h>
+#include <vector>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void squeeze_dim_launcher(
+    const float* input,
+    float* output,
+    int64_t dim,
+    int64_t input_ndim,
+    const int64_t* input_sizes,
+    const int64_t* input_strides,
+    cudaStream_t stream
+);
+
+extern "C" void concat_two_launcher(
+    const float* a,
+    const float* b,
+    float* out,
+    int64_t a_sizes[8],
+    int64_t b_sizes[8],
+    int64_t ndim,
+    int64_t dim,
+    cudaStream_t stream
+);
+
+// Helper to get current CUDA stream
+static cudaStream_t getCurrentStream() {
+    return c10::cuda::getCurrentCUDAStream().stream();
+}
+
+// squeeze_dim: If size(dim)==1, return x.as_strided(new_sizes) (view), otherwise return x unchanged.
+// This matches torch.squeeze(input, dim) behavior for the given dimension.
+static torch::Tensor squeeze_dim(torch::Tensor x, int64_t dim) {
+    TORCH_CHECK(x.is_cuda(), "squeeze_dim: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "squeeze_dim: input must be float32");
+
+    auto ndim = x.dim();
+    // Normalize negative dim
+    if (dim < 0) dim += ndim;
+    TORCH_CHECK(dim >= 0 && dim < ndim, "squeeze_dim: dim out of range");
+
+    if (x.size(dim) == 1) {
+        // Remove dimension dim: new sizes and strides
+        std::vector<int64_t> new_sizes;
+        std::vector<int64_t> new_strides;
+        for (int64_t d = 0; d < ndim; ++d) {
+            if (d != dim) {
+                new_sizes.push_back(x.size(d));
+                new_strides.push_back(x.stride(d));
+            }
+        }
+        return x.as_strided(new_sizes, new_strides);
+    } else {
+        // No change, return original tensor (view)
+        return x;
+    }
+}
+
+// concat_dim: Concatenate a list of tensors along dimension dim.
+// All tensors must be CUDA float32, have same number of dimensions and identical sizes except along dim.
+// Output is a new contiguous tensor.
+static torch::Tensor concat_dim(std::vector<torch::Tensor> tensors, int64_t dim) {
+    TORCH_CHECK(tensors.size() > 0, "concat_dim: tensor list must not be empty");
+    
+    const auto& first = tensors[0];
+    TORCH_CHECK(first.is_cuda(), "concat_dim: all tensors must be CUDA");
+    TORCH_CHECK(first.dtype() == torch::kFloat32, "concat_dim: all tensors must be float32");
+    
+    int64_t ndim = first.dim();
+    if (dim < 0) dim += ndim;
+    TORCH_CHECK(dim >= 0 && dim < ndim, "concat_dim: dim out of range");
+    
+    // Validate all tensors
+    std::vector<torch::Tensor> processed_tensors;
+    processed_tensors.reserve(tensors.size());
+    for (const auto& t : tensors) {
+        TORCH_CHECK(t.is_cuda(), "concat_dim: all tensors must be CUDA");
+        TORCH_CHECK(t.dtype() == torch::kFloat32, "concat_dim: all tensors must be float32");
+        TORCH_CHECK(t.dim() == ndim, "concat_dim: all tensors must have same number of dimensions");
+        for (int64_t d = 0; d < ndim; ++d) {
+            if (d != dim) {
+                TORCH_CHECK(t.size(d) == first.size(d), "concat_dim: all tensors must have same sizes except along dim");
+            }
+        }
+        // Ensure contiguous for kernel (kernel assumes contiguous)
+        processed_tensors.push_back(t.contiguous());
+    }
+    
+    // Compute total size along dim
+    int64_t total_dim_size = 0;
+    for (const auto& t : processed_tensors) {
+        total_dim_size += t.size(dim);
+    }
+    
+    // Output sizes
+    std::vector<int64_t> out_sizes(ndim);
+    for (int64_t d = 0; d < ndim; ++d) {
+        out_sizes[d] = (d == dim) ? total_dim_size : first.size(d);
+    }
+    
+    auto out = torch::empty(out_sizes, first.options());
+    TORCH_CHECK(out.is_contiguous(), "concat_dim: output must be contiguous");
+    
+    // For simplicity and correctness, handle exactly two tensors using concat_two_launcher.
+    // The launcher expects arrays of sizes and computes concatenation along dim.
+    // Since contract only requires two tensors in current usage, we can call it directly.
+    // If more than two, we could call multiple times, but current model uses two.
+    TORCH_CHECK(processed_tensors.size() == 2, "concat_dim: currently only two tensors supported");
+    
+    const auto& a = processed_tensors[0];
+    const auto& b = processed_tensors[1];
+    
+    // Prepare size arrays for launcher (max 8 dims)
+    TORCH_CHECK(ndim <= 8, "concat_dim: too many dimensions");
+    int64_t a_sizes[8] = {0};
+    int64_t b_sizes[8] = {0};
+    for (int64_t d = 0; d < ndim; ++d) {
+        a_sizes[d] = a.size(d);
+        b_sizes[d] = b.size(d);
+    }
+    
+    cudaStream_t stream = getCurrentStream();
+    
+    concat_two_launcher(
+        a.data_ptr<float>(),
+        b.data_ptr<float>(),
+        out.data_ptr<float>(),
+        a_sizes,
+        b_sizes,
+        ndim,
+        dim,
+        stream
+    );
+    
+    // Check for kernel errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "concat_dim: CUDA kernel launch failed: ", cudaGetErrorString(err));
+    
+    return out;
+}
+
+// Registration
+void register_custom_ops(pybind11::module& m) {
+    m.def("squeeze_dim", &squeeze_dim, "Squeeze dimension if size is 1, otherwise return input",
+          py::arg("x"), py::arg("dim"));
+    m.def("concat_dim", &concat_dim, "Concatenate list of tensors along dimension",
+          py::arg("tensors"), py::arg("dim"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,22 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, input_size_1, input_size_2, squeeze_dim):
+        super().__init__()
+        self.squeeze_dim = squeeze_dim
+
+    def forward(self, x1: torch.Tensor, x2: torch.Tensor) -> torch.Tensor:
+        x1 = cuda_extension.squeeze_dim(x1, self.squeeze_dim)
+        x2 = cuda_extension.squeeze_dim(x2, self.squeeze_dim)
+        return cuda_extension.concat_dim((x1, x2), self.squeeze_dim)
+
+    def debug_forward(self, x1: torch.Tensor, x2: torch.Tensor):
+        x1 = cuda_extension.squeeze_dim(x1, self.squeeze_dim)
+        yield 'step_001', x1
+        x2 = cuda_extension.squeeze_dim(x2, self.squeeze_dim)
+        yield 'step_002', x2
+        out = cuda_extension.concat_dim((x1, x2), self.squeeze_dim)
+        yield 'step_003', out
