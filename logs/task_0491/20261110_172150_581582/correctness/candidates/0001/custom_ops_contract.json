{
  "operators": [
    {
      "name": "batch_norm_2d_eval",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[512, 1, 224, 224]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[1]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[1]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[1]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[1]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "y = (x - running_mean) / sqrt(running_var + eps) * weight + bias",
        "BatchNorm2d evaluation mode uses running statistics, not batch statistics",
        "normalization is per-channel (index 1) across N,H,W dimensions",
        "running_mean, running_var, weight, bias are broadcast along channels",
        "output preserves input shape, dtype, device and memory layout (strides may differ)",
        "if weight is None, multiplication is omitted; if bias is None, addition is omitted"
      ]
    },
    {
      "name": "clamp_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as previous step",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "min_val",
          "kind": "float",
          "nullable": false,
          "optional": false
        },
        {
          "name": "max_val",
          "kind": "float",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "output = min(max(x, min_val), max_val)",
        "operates element-wise on the input tensor",
        "preserves tensor shape, dtype, device and memory layout"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.batch_norm_2d(x)",
      "semantics": [
        "BatchNorm2d in eval mode: y = (x - running_mean) / sqrt(running_var + eps) * weight + bias",
        "affine=True and bias=True, so weight and bias are applied",
        "eps=1e-05, momentum=0.1 (momentum irrelevant in eval)",
        "input shape [512,1,224,224] float32 on CUDA; output same shape/dtype/device",
        "implementation must use cuda_extension.batch_norm_2d_eval"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.clamp(x, min=0.0, max=1.0)",
      "semantics": [
        "element-wise clamp between 0.0 and 1.0",
        "input shape [512,1,224,224] float32 on CUDA; output same shape/dtype/device",
        "implementation must use cuda_extension.clamp_forward"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "final output is clamped tensor [512,1,224,224] float32 on CUDA"
      ]
    }
  ]
}