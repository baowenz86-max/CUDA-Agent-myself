--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,112 @@
+#include <cuda_runtime.h>
+#include <cmath>
+
+// CUDA kernel for batch normalization evaluation mode
+// y = (x - running_mean[c]) / sqrt(running_var[c] + eps) * weight[c] + bias[c]
+// Input x is assumed contiguous with shape (N, C, H, W), treated as float32
+__global__ void batch_norm_2d_eval_kernel(
+    float* __restrict__ y,
+    const float* __restrict__ x,
+    const float* __restrict__ weight,
+    const float* __restrict__ bias,
+    const float* __restrict__ running_mean,
+    const float* __restrict__ running_var,
+    float eps,
+    int N,
+    int C,
+    int H,
+    int W
+) {
+    int total = N * C * H * W;
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+
+    for (int i = idx; i < total; i += stride) {
+        int c = (i / (H * W)) % C;
+        float mean = running_mean[c];
+        float var = running_var[c];
+        float inv_std = rsqrtf(var + eps);
+        float gamma = (weight != nullptr) ? weight[c] : 1.0f;
+        float beta = (bias != nullptr) ? bias[c] : 0.0f;
+        y[i] = (x[i] - mean) * inv_std * gamma + beta;
+    }
+}
+
+// CUDA kernel for clamp operation: min(max(x, min_val), max_val)
+__global__ void clamp_forward_kernel(
+    float* __restrict__ y,
+    const float* __restrict__ x,
+    float min_val,
+    float max_val,
+    int numel
+) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+
+    for (int i = idx; i < numel; i += stride) {
+        float v = x[i];
+        v = fminf(fmaxf(v, min_val), max_val);
+        y[i] = v;
+    }
+}
+
+// Host launcher for batch_norm_2d_eval
+// Inputs: y, x, weight, bias, running_mean, running_var, eps, N, C, H, W, stream
+// weight and bias can be nullptr (indicating absence)
+// x and y must be contiguous float32 arrays on device
+// y should be preallocated with same size as x
+extern "C" void batch_norm_2d_eval_launcher(
+    float* y,
+    const float* x,
+    const float* weight,
+    const float* bias,
+    const float* running_mean,
+    const float* running_var,
+    double eps,
+    int64_t N,
+    int64_t C,
+    int64_t H,
+    int64_t W,
+    cudaStream_t stream
+) {
+    int total = static_cast<int>(N * C * H * W);
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    // Cap blocks to avoid excessive grid dimensions; use grid-stride loop
+    if (blocks > 65535) blocks = 65535;
+    batch_norm_2d_eval_kernel<<<blocks, threads, 0, stream>>>(
+        y, x, weight, bias, running_mean, running_var,
+        static_cast<float>(eps),
+        static_cast<int>(N),
+        static_cast<int>(C),
+        static_cast<int>(H),
+        static_cast<int>(W)
+    );
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // Error handling is left to the binding layer; we don't include headers for logging
+    }
+}
+
+// Host launcher for clamp_forward
+// y, x contiguous float32 arrays on device, numel = number of elements
+extern "C" void clamp_forward_launcher(
+    float* y,
+    const float* x,
+    double min_val,
+    double max_val,
+    int64_t numel,
+    cudaStream_t stream
+) {
+    int total = static_cast<int>(numel);
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535;
+    clamp_forward_kernel<<<blocks, threads, 0, stream>>>(
+        y, x, static_cast<float>(min_val), static_cast<float>(max_val), total
+    );
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // Error handling is left to the binding layer
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,160 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_runtime.h>
+#include "../binding_registry.h"
+
+// Declarations from custom_ops.cu
+extern "C" void batch_norm_2d_eval_launcher(
+    float* y,
+    const float* x,
+    const float* weight,
+    const float* bias,
+    const float* running_mean,
+    const float* running_var,
+    double eps,
+    int64_t N,
+    int64_t C,
+    int64_t H,
+    int64_t W,
+    cudaStream_t stream
+);
+
+extern "C" void clamp_forward_launcher(
+    float* y,
+    const float* x,
+    double min_val,
+    double max_val,
+    int64_t numel,
+    cudaStream_t stream
+);
+
+// PyTorch wrapper for batch_norm_2d_eval
+torch::Tensor batch_norm_2d_eval(
+    torch::Tensor x,
+    c10::optional<torch::Tensor> weight,
+    c10::optional<torch::Tensor> bias,
+    torch::Tensor running_mean,
+    torch::Tensor running_var,
+    double eps
+) {
+    // Input validation
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(x.dim() == 4, "x must be 4D (N,C,H,W)");
+    TORCH_CHECK(running_mean.is_cuda(), "running_mean must be a CUDA tensor");
+    TORCH_CHECK(running_mean.dtype() == torch::kFloat32, "running_mean must be float32");
+    TORCH_CHECK(running_var.is_cuda(), "running_var must be a CUDA tensor");
+    TORCH_CHECK(running_var.dtype() == torch::kFloat32, "running_var must be float32");
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+
+    // Optional weight and bias validation
+    float* weight_ptr = nullptr;
+    float* bias_ptr = nullptr;
+    if (weight.has_value()) {
+        auto w = weight.value();
+        TORCH_CHECK(w.is_cuda(), "weight must be a CUDA tensor");
+        TORCH_CHECK(w.dtype() == torch::kFloat32, "weight must be float32");
+        TORCH_CHECK(w.numel() == C, "weight must have C elements");
+        TORCH_CHECK(w.is_contiguous(), "weight must be contiguous");
+        weight_ptr = w.data_ptr<float>();
+    }
+    if (bias.has_value()) {
+        auto b = bias.value();
+        TORCH_CHECK(b.is_cuda(), "bias must be a CUDA tensor");
+        TORCH_CHECK(b.dtype() == torch::kFloat32, "bias must be float32");
+        TORCH_CHECK(b.numel() == C, "bias must have C elements");
+        TORCH_CHECK(b.is_contiguous(), "bias must be contiguous");
+        bias_ptr = b.data_ptr<float>();
+    }
+
+    TORCH_CHECK(running_mean.is_contiguous(), "running_mean must be contiguous");
+    TORCH_CHECK(running_var.is_contiguous(), "running_var must be contiguous");
+    TORCH_CHECK(running_mean.numel() == C, "running_mean must have C elements");
+    TORCH_CHECK(running_var.numel() == C, "running_var must have C elements");
+
+    // Allocate output tensor with same shape and options as input
+    auto y = torch::empty_like(x);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    batch_norm_2d_eval_launcher(
+        y.data_ptr<float>(),
+        x.data_ptr<float>(),
+        weight_ptr,
+        bias_ptr,
+        running_mean.data_ptr<float>(),
+        running_var.data_ptr<float>(),
+        eps,
+        N,
+        C,
+        H,
+        W,
+        stream
+    );
+
+    // Check for errors after launch (optional but recommended)
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        AT_ERROR("batch_norm_2d_eval CUDA kernel launch failed: ", cudaGetErrorString(err));
+    }
+
+    return y;
+}
+
+// PyTorch wrapper for clamp_forward
+torch::Tensor clamp_forward(
+    torch::Tensor x,
+    double min_val,
+    double max_val
+) {
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+
+    int64_t numel = x.numel();
+    auto y = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    clamp_forward_launcher(
+        y.data_ptr<float>(),
+        x.data_ptr<float>(),
+        min_val,
+        max_val,
+        numel,
+        stream
+    );
+
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        AT_ERROR("clamp_forward CUDA kernel launch failed: ", cudaGetErrorString(err));
+    }
+
+    return y;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("batch_norm_2d_eval", &batch_norm_2d_eval,
+          "BatchNorm2d evaluation mode",
+          py::arg("x"),
+          py::arg("weight"),
+          py::arg("bias"),
+          py::arg("running_mean"),
+          py::arg("running_var"),
+          py::arg("eps"));
+    m.def("clamp_forward", &clamp_forward,
+          "Clamp forward",
+          py::arg("x"),
+          py::arg("min_val"),
+          py::arg("max_val"));
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,35 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+class ModelNew(nn.Module):
+    def __init__(self, in_features):
+        super().__init__()
+        self.batch_norm_2d = nn.BatchNorm2d(in_features)
+
+    def forward(self, x):
+        x = cuda_extension.batch_norm_2d_eval(
+            x,
+            self.batch_norm_2d.weight,
+            self.batch_norm_2d.bias,
+            self.batch_norm_2d.running_mean,
+            self.batch_norm_2d.running_var,
+            1e-05
+        )
+        x = cuda_extension.clamp_forward(x, 0.0, 1.0)
+        return x
+
+    def debug_forward(self, *inputs):
+        x = inputs[0]
+        x = cuda_extension.batch_norm_2d_eval(
+            x,
+            self.batch_norm_2d.weight,
+            self.batch_norm_2d.bias,
+            self.batch_norm_2d.running_mean,
+            self.batch_norm_2d.running_var,
+            1e-05
+        )
+        yield ('step_001', x)
+        x = cuda_extension.clamp_forward(x, 0.0, 1.0)
+        yield ('step_002', x)
+        yield ('step_003', x)
