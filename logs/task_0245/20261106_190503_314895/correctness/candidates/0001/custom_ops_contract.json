{
  "operators": [
    {
      "name": "reflection_pad2d_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "padding_size",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C, H+2*pad_top, W+2*pad_left]"
      },
      "semantics": [
        "对应参考语句 x = self.reflection_pad(x)，执行 2D 反射填充，padding=(3,3,3,3)。",
        "输出高度 H+6，宽度 W+6，填充值按输入边界镜像复制，不包含边界原始元素的一次重复。",
        "输入为 float32 CUDA 张量，支持任意 stride；输出为连续新张量，形状由 padding 确定。"
      ]
    },
    {
      "name": "add_scalar_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H', W']",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "scalar",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[1, 1, 1, 1]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "对应参考语句 x = x + self.normal_layer，执行广播逐元素加法。",
        "scalar 形状为 [1,1,1,1]，实际等价于对 x 的每个元素加上 scalar 的唯一值。",
        "输出保留输入形状和 dtype，返回新张量（或可复用输入内存的拷贝，但不修改输入）。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.reflection_pad(x)",
      "semantics": [
        "使用 reflection_pad2d_forward 对输入张量执行反射填充 padding=(3,3,3,3)。",
        "输出形状 [16,3,2054,1030]，dtype=float32，device=cuda:0。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = x + self.normal_layer",
      "semantics": [
        "使用 add_scalar_forward 将 normal_layer 加到填充后的张量上，广播形状 [1,1,1,1]。",
        "输出形状与 step_001 相同。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回 step_002 的计算结果，即填充并加标量后的张量。"
      ]
    }
  ]
}