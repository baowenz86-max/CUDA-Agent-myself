--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,116 @@
+#include <cuda_runtime.h>
+#include <cmath>
+
+// Elementwise tanh kernel. Input can be non-contiguous, using per-dimension strides.
+// We linearize thread index to flat offset over the 4D tensor (N, C, H, W) and
+// compute coordinates via division/modulo.
+__global__ void tanh_kernel(
+    float* __restrict__ out,
+    const float* __restrict__ in,
+    int N, int C, int H, int W,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,
+    long long in_stride_n,  long long in_stride_c,  long long in_stride_h,  long long in_stride_w,
+    long long total_elements)
+{
+    long long idx = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (long long linear = idx; linear < total_elements; linear += stride) {
+        // decompose linear index
+        int w = linear % W;
+        long long rem = linear / W;
+        int h = rem % H;
+        rem /= H;
+        int c = rem % C;
+        int n = rem / C;
+
+        long long out_offset = n * out_stride_n + c * out_stride_c + h * out_stride_h + w * out_stride_w;
+        long long in_offset  = n * in_stride_n  + c * in_stride_c  + h * in_stride_h  + w * in_stride_w;
+        out[out_offset] = tanhf(in[in_offset]);
+    }
+}
+
+// BatchNorm2d evaluation mode kernel. Each thread processes one (n,c,h,w) element.
+// We use grid-stride loop over total elements. For each element, we compute channel index c
+// and apply scale and shift from precomputed arrays. Weight, bias, running_mean, running_var
+// are assumed contiguous float arrays of length C (binding layer will pass contiguous).
+__global__ void batch_norm2d_eval_kernel(
+    float* __restrict__ out,
+    const float* __restrict__ in,
+    const float* __restrict__ weight,
+    const float* __restrict__ bias,
+    const float* __restrict__ running_mean,
+    const float* __restrict__ running_var,
+    float eps,
+    int N, int C, int H, int W,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,
+    long long in_stride_n,  long long in_stride_c,  long long in_stride_h,  long long in_stride_w,
+    long long total_elements)
+{
+    long long idx = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (long long linear = idx; linear < total_elements; linear += stride) {
+        int w = linear % W;
+        long long rem = linear / W;
+        int h = rem % H;
+        rem /= H;
+        int c = rem % C;
+        int n = rem / C;
+
+        long long out_offset = n * out_stride_n + c * out_stride_c + h * out_stride_h + w * out_stride_w;
+        long long in_offset  = n * in_stride_n  + c * in_stride_c  + h * in_stride_h  + w * in_stride_w;
+
+        float mean = running_mean[c];
+        float var = running_var[c];
+        float inv_std = rsqrtf(var + eps);
+        float scale = weight[c] * inv_std;
+        float shift = bias[c] - mean * scale;
+        out[out_offset] = in[in_offset] * scale + shift;
+    }
+}
+
+extern "C" void tanh_forward_launcher(
+    float* out,
+    const float* in,
+    int N, int C, int H, int W,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,
+    long long in_stride_n,  long long in_stride_c,  long long in_stride_h,  long long in_stride_w,
+    cudaStream_t stream)
+{
+    long long total = (long long)N * C * H * W;
+    if (total == 0) return;
+    const int block = 256;
+    long long grid_ll = (total + block - 1) / block;
+    // Cap grid to avoid exceeding max grid dim; grid-stride loop handles rest
+    int grid = (int)min(grid_ll, (long long)65535 * 32); // conservative: 65535*32 ~2.1M blocks > needed
+    tanh_kernel<<<grid, block, 0, stream>>>(
+        out, in, N, C, H, W,
+        out_stride_n, out_stride_c, out_stride_h, out_stride_w,
+        in_stride_n,  in_stride_c,  in_stride_h,  in_stride_w,
+        total);
+}
+
+extern "C" void batch_norm2d_forward_launcher(
+    float* out,
+    const float* in,
+    const float* weight,
+    const float* bias,
+    const float* running_mean,
+    const float* running_var,
+    float eps,
+    int N, int C, int H, int W,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,
+    long long in_stride_n,  long long in_stride_c,  long long in_stride_h,  long long in_stride_w,
+    cudaStream_t stream)
+{
+    long long total = (long long)N * C * H * W;
+    if (total == 0) return;
+    const int block = 256;
+    long long grid_ll = (total + block - 1) / block;
+    int grid = (int)min(grid_ll, (long long)65535 * 32);
+    batch_norm2d_eval_kernel<<<grid, block, 0, stream>>>(
+        out, in, weight, bias, running_mean, running_var, eps,
+        N, C, H, W,
+        out_stride_n, out_stride_c, out_stride_h, out_stride_w,
+        in_stride_n,  in_stride_c,  in_stride_h,  in_stride_w,
+        total);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,109 @@
+// PyTorch binding for custom tanh and batch_norm2d evaluation kernels.
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_runtime.h>
+#include "../binding_registry.h"
+
+// Launchers exported from custom_ops.cu
+extern "C" void tanh_forward_launcher(
+    float* out,
+    const float* in,
+    int N, int C, int H, int W,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,
+    long long in_stride_n,  long long in_stride_c,  long long in_stride_h,  long long in_stride_w,
+    cudaStream_t stream);
+
+extern "C" void batch_norm2d_forward_launcher(
+    float* out,
+    const float* in,
+    const float* weight,
+    const float* bias,
+    const float* running_mean,
+    const float* running_var,
+    float eps,
+    int N, int C, int H, int W,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,
+    long long in_stride_n,  long long in_stride_c,  long long in_stride_h,  long long in_stride_w,
+    cudaStream_t stream);
+
+// Helper: get strides as long long array from tensor, assuming 4D
+static inline std::array<long long, 4> get_strides_ll(const torch::Tensor& t) {
+    TORCH_CHECK(t.dim() == 4, "Expected 4D tensor");
+    return {t.stride(0), t.stride(1), t.stride(2), t.stride(3)};
+}
+
+// tanh_forward: elementwise tanh, output has same strides as input
+torch::Tensor tanh_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D");
+
+    auto out = torch::empty_strided(x.sizes(), x.strides(), x.options());
+
+    auto in_strides = get_strides_ll(x);
+    auto out_strides = get_strides_ll(out);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    tanh_forward_launcher(
+        out.data_ptr<float>(),
+        x.data_ptr<float>(),
+        x.size(0), x.size(1), x.size(2), x.size(3),
+        out_strides[0], out_strides[1], out_strides[2], out_strides[3],
+        in_strides[0], in_strides[1], in_strides[2], in_strides[3],
+        stream);
+
+    return out;
+}
+
+// batch_norm2d_forward: evaluation-mode batch norm, output strides match input
+torch::Tensor batch_norm2d_forward(
+    torch::Tensor x,
+    torch::Tensor weight,
+    torch::Tensor bias,
+    torch::Tensor running_mean,
+    torch::Tensor running_var,
+    double eps) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D");
+
+    for (const auto& t : {weight, bias, running_mean, running_var}) {
+        TORCH_CHECK(t.is_cuda(), "Parameter must be a CUDA tensor");
+        TORCH_CHECK(t.dtype() == torch::kFloat32, "Parameter must be float32");
+        TORCH_CHECK(t.is_contiguous(), "Parameter must be contiguous");
+        TORCH_CHECK(t.numel() == x.size(1), "Parameter size must equal channels");
+    }
+
+    auto out = torch::empty_strided(x.sizes(), x.strides(), x.options());
+
+    auto in_strides = get_strides_ll(x);
+    auto out_strides = get_strides_ll(out);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    batch_norm2d_forward_launcher(
+        out.data_ptr<float>(),
+        x.data_ptr<float>(),
+        weight.data_ptr<float>(),
+        bias.data_ptr<float>(),
+        running_mean.data_ptr<float>(),
+        running_var.data_ptr<float>(),
+        static_cast<float>(eps),
+        x.size(0), x.size(1), x.size(2), x.size(3),
+        out_strides[0], out_strides[1], out_strides[2], out_strides[3],
+        in_strides[0], in_strides[1], in_strides[2], in_strides[3],
+        stream);
+
+    return out;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("tanh_forward", &tanh_forward, "Elementwise tanh");
+    m.def("batch_norm2d_forward", &batch_norm2d_forward, "BatchNorm2d evaluation",
+          pybind11::arg("x"), pybind11::arg("weight"), pybind11::arg("bias"),
+          pybind11::arg("running_mean"), pybind11::arg("running_var"), pybind11::arg("eps"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops)
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,39 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+        # Preserve original state_dict keys for batch_norm2d
+        self.batch_norm2d = nn.BatchNorm2d(1024)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        # Apply tanh using custom CUDA op
+        x = cuda_extension.tanh_forward(x)
+        # Apply batch_norm2d using custom CUDA op
+        x = cuda_extension.batch_norm2d_forward(
+            x,
+            self.batch_norm2d.weight,
+            self.batch_norm2d.bias,
+            self.batch_norm2d.running_mean,
+            self.batch_norm2d.running_var,
+            1e-5
+        )
+        return x
+
+    def debug_forward(self, x: torch.Tensor):
+        # Debug interface: yield (checkpoint_id, value) in order
+        x = cuda_extension.tanh_forward(x)
+        yield ('step_001', x)
+        x = cuda_extension.batch_norm2d_forward(
+            x,
+            self.batch_norm2d.weight,
+            self.batch_norm2d.bias,
+            self.batch_norm2d.running_mean,
+            self.batch_norm2d.running_var,
+            1e-5
+        )
+        yield ('step_002', x)
+        yield ('step_003', x)
