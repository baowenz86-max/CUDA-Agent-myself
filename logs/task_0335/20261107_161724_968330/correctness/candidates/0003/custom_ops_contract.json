{
  "operators": [
    {
      "name": "linear_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, in_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_features, in_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_features]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, out_features]"
      },
      "semantics": [
        "实现 PyTorch nn.Linear: output = input @ weight.T + bias（bias 可省略，省略时相当于 None）。",
        "输入 shape [batch, in_features]，weight shape [out_features, in_features]，输出 shape [batch, out_features]。",
        "支持任意 batch 大小，不改变 dtype。"
      ]
    },
    {
      "name": "unsqueeze_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, out_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "optional": false,
          "nullable": false,
          "default": null
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, out_features, 1]"
      },
      "semantics": [
        "在指定 dim 插入大小为 1 的维度，返回 view（stride 与参考一致）。",
        "参考调用为 x.unsqueeze(2)，输入 [batch, out_features]，输出 [batch, out_features, 1]。"
      ]
    },
    {
      "name": "interpolate_nearest_1d",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, out_features, length_in]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "scale_factor",
          "kind": "float",
          "optional": false,
          "nullable": false,
          "default": null
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, out_features, length_out]"
      },
      "semantics": [
        "实现 F.interpolate(..., mode='nearest')，仅支持 1D 输入 [batch, channels, length]。",
        "输出长度 length_out = floor(length_in * scale_factor)，参考中 scale_factor=2，长度由 1 变为 2。",
        "最近邻插值：对于输出位置 i，源索引为 floor(i / scale_factor)，复制对应值。",
        "保持 batch 和 channels 维度不变。"
      ]
    },
    {
      "name": "conv_transpose1d_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, in_channels, length_in]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[in_channels, out_channels, kernel_size]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "stride",
          "kind": "int",
          "optional": false,
          "nullable": false,
          "default": null
        },
        {
          "name": "padding",
          "kind": "int",
          "optional": false,
          "nullable": false,
          "default": null
        },
        {
          "name": "output_padding",
          "kind": "int",
          "optional": false,
          "nullable": false,
          "default": null
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, out_channels, length_out]"
      },
      "semantics": [
        "实现 PyTorch ConvTranspose1d 前向：output = input * weight^T + bias（转置卷积）。",
        "参考参数：in_channels=128, out_channels=64, kernel_size=3, stride=2, padding=1, output_padding=1。",
        "输出长度公式：length_out = (length_in - 1)*stride - 2*padding + kernel_size + output_padding。",
        "参考中 length_in=2，输出长度为 (2-1)*2 - 2*1 + 3 + 1 = 4。",
        "bias 可省略，模块定义有 bias 时传入 bias 张量。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.linear(x)",
      "semantics": [
        "线性变换：x = x @ linear.weight.T + linear.bias。",
        "输入 [8192,256]，输出 [8192,128]，dtype float32，设备 cuda:0。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = x.unsqueeze(2)",
      "semantics": [
        "在第 2 维插入大小为 1 的维度。",
        "输入 [8192,128]，输出 [8192,128,1]，stride [128,1,1]。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = F.interpolate(x, scale_factor=self.scale_factor, mode='nearest')",
      "semantics": [
        "最近邻上采样，scale_factor=2，仅对时间维进行插值。",
        "输入 [8192,128,1]，输出 [8192,128,2]，每个输入时间点复制为两个。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "x = self.conv_transpose1d(x)",
      "semantics": [
        "转置卷积，参数如 ConvTranspose1d 定义。",
        "输入 [8192,128,2]，输出 [8192,64,4]，应用 bias。"
      ]
    },
    {
      "checkpoint": "step_005",
      "source": "return x",
      "semantics": [
        "返回最终张量，shape [8192,64,4]，dtype float32，device cuda:0。"
      ]
    }
  ]
}