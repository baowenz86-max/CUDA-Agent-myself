--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,131 @@
+#include <cuda_runtime.h>
+#include <math.h>
+
+// -----------------------------------------------------------------------------
+// AvgPool2d forward kernel
+// -----------------------------------------------------------------------------
+// Computes average pooling with kernel_size=3, stride=2, padding=1, count_include_pad=True
+// Input: (N, C, H, W) float32, output: (N, C, H_out, W_out)
+// H_out = floor((H + 2*padding - kernel_size)/stride) + 1
+// W_out = floor((W + 2*padding - kernel_size)/stride) + 1
+// Each output element is average of 3x3 input window (with zero padding outside)
+// Denominator is always kernel_size*kernel_size = 9 (count_include_pad=True)
+__global__ void avgpool2d_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int N, int C, int H, int W,
+    int H_out, int W_out,
+    int kernel_size, int stride, int padding
+) {
+    int total_elements = N * C * H_out * W_out;
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int grid_stride = blockDim.x * gridDim.x;
+
+    for (int linear_idx = idx; linear_idx < total_elements; linear_idx += grid_stride) {
+        // Decode linear index: (n, c, h_out, w_out)
+        int w_out = linear_idx % W_out;
+        int tmp = linear_idx / W_out;
+        int h_out = tmp % H_out;
+        tmp /= H_out;
+        int c = tmp % C;
+        int n = tmp / C;
+
+        // Input window origin in input coordinates
+        int h_start = h_out * stride - padding;
+        int w_start = w_out * stride - padding;
+
+        float sum = 0.0f;
+        for (int kh = 0; kh < kernel_size; ++kh) {
+            int h_in = h_start + kh;
+            if (h_in < 0 || h_in >= H) continue;
+            for (int kw = 0; kw < kernel_size; ++kw) {
+                int w_in = w_start + kw;
+                if (w_in < 0 || w_in >= W) continue;
+                // Input is contiguous (assume contiguous for simplicity; binding layer will ensure)
+                sum += input[((n * C + c) * H + h_in) * W + w_in];
+            }
+        }
+        float denom = (float)(kernel_size * kernel_size); // 9.0f
+        int out_idx = ((n * C + c) * H_out + h_out) * W_out + w_out;
+        output[out_idx] = sum / denom;
+    }
+}
+
+// -----------------------------------------------------------------------------
+// Pow scalar forward kernel
+// -----------------------------------------------------------------------------
+// Computes element-wise power: output[i] = input[i] ^ exponent
+// exponent is passed as a pointer to a single float value (0-dim tensor)
+__global__ void pow_scalar_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    const float* __restrict__ exponent_ptr,
+    int total_elements
+) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int grid_stride = blockDim.x * gridDim.x;
+    float exponent = *exponent_ptr;
+
+    for (int i = idx; i < total_elements; i += grid_stride) {
+        output[i] = powf(input[i], exponent);
+    }
+}
+
+// -----------------------------------------------------------------------------
+// Launcher functions (extern "C")
+// -----------------------------------------------------------------------------
+// These are called from binding.cpp. All pointers are raw device pointers.
+// Input tensors are assumed to be CUDA float32. Output tensors are pre-allocated by binding layer.
+// stream: CUDA stream on which to launch kernels.
+
+// Launch avgpool2d_forward
+// Parameters:
+//   input: device pointer to input tensor (N,C,H,W) contiguous float32
+//   output: device pointer to output tensor (N,C,H_out,W_out) contiguous float32 (allocated by caller)
+//   N, C, H, W: input dimensions
+//   H_out, W_out: output spatial dimensions
+//   kernel_size, stride, padding: pooling parameters
+//   stream: CUDA stream
+extern "C" void avgpool2d_forward_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    int H_out, int W_out,
+    int kernel_size, int stride, int padding,
+    cudaStream_t stream
+) {
+    int total_elements = N * C * H_out * W_out;
+    // Choose block size and grid size
+    int threads = 256;
+    int blocks = (total_elements + threads - 1) / threads;
+    // Cap blocks to a reasonable number and use grid-stride loop
+    if (blocks > 65535) blocks = 65535;
+    avgpool2d_kernel<<<blocks, threads, 0, stream>>>(
+        input, output,
+        N, C, H, W,
+        H_out, W_out,
+        kernel_size, stride, padding
+    );
+}
+
+// Launch pow_scalar_forward
+// Parameters:
+//   input: device pointer to input tensor (contiguous float32)
+//   output: device pointer to output tensor (same shape as input, allocated by caller)
+//   exponent_ptr: device pointer to a single float value (0-dim tensor)
+//   total_elements: number of elements
+//   stream: CUDA stream
+extern "C" void pow_scalar_forward_launcher(
+    const float* input,
+    float* output,
+    const float* exponent_ptr,
+    int total_elements,
+    cudaStream_t stream
+) {
+    int threads = 256;
+    int blocks = (total_elements + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535;
+    pow_scalar_kernel<<<blocks, threads, 0, stream>>>(
+        input, output, exponent_ptr, total_elements
+    );
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,117 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void avgpool2d_forward_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    int H_out, int W_out,
+    int kernel_size, int stride, int padding,
+    cudaStream_t stream
+);
+
+extern "C" void pow_scalar_forward_launcher(
+    const float* input,
+    float* output,
+    const float* exponent_ptr,
+    int total_elements,
+    cudaStream_t stream
+);
+
+// PyTorch wrapper for AvgPool2d forward
+torch::Tensor avgpool2d_forward(
+    torch::Tensor x,
+    int64_t kernel_size,
+    int64_t stride,
+    int64_t padding
+) {
+    // Validate input tensor
+    TORCH_CHECK(x.is_cuda(), "avgpool2d_forward: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "avgpool2d_forward: input must be float32");
+    TORCH_CHECK(x.dim() == 4, "avgpool2d_forward: input must be 4D (N,C,H,W)");
+    
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+
+    // Compute output spatial dimensions
+    int64_t H_out = (H + 2 * padding - kernel_size) / stride + 1;
+    int64_t W_out = (W + 2 * padding - kernel_size) / stride + 1;
+
+    TORCH_CHECK(H_out > 0 && W_out > 0, "avgpool2d_forward: invalid output shape");
+
+    // Allocate output tensor with same options as input
+    auto output = torch::empty({N, C, H_out, W_out}, x.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    avgpool2d_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int>(N),
+        static_cast<int>(C),
+        static_cast<int>(H),
+        static_cast<int>(W),
+        static_cast<int>(H_out),
+        static_cast<int>(W_out),
+        static_cast<int>(kernel_size),
+        static_cast<int>(stride),
+        static_cast<int>(padding),
+        stream
+    );
+
+    return output;
+}
+
+// PyTorch wrapper for Pow scalar forward
+torch::Tensor pow_scalar_forward(
+    torch::Tensor x,
+    torch::Tensor exponent
+) {
+    // Validate input tensors
+    TORCH_CHECK(x.is_cuda(), "pow_scalar_forward: input x must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "pow_scalar_forward: input x must be float32");
+    TORCH_CHECK(exponent.is_cuda(), "pow_scalar_forward: exponent must be a CUDA tensor");
+    TORCH_CHECK(exponent.dtype() == torch::kFloat32, "pow_scalar_forward: exponent must be float32");
+    TORCH_CHECK(exponent.numel() == 1, "pow_scalar_forward: exponent must be a scalar (0-dim or 1-element)");
+
+    // Ensure exponent is contiguous (0-dim tensors are contiguous by definition, but make sure)
+    auto exponent_contig = exponent.contiguous();
+
+    // Allocate output tensor with same stride as input to preserve layout
+    auto output = torch::empty_strided(x.sizes(), x.strides(), x.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    pow_scalar_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        exponent_contig.data_ptr<float>(),
+        static_cast<int>(x.numel()),
+        stream
+    );
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("avgpool2d_forward", &avgpool2d_forward,
+          "Average pooling 2D forward (kernel, stride, padding)",
+          py::arg("x"), py::arg("kernel_size"), py::arg("stride"), py::arg("padding"));
+    m.def("pow_scalar_forward", &pow_scalar_forward,
+          "Element-wise power with scalar exponent",
+          py::arg("x"), py::arg("exponent"));
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,29 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, out_channels, kernel_size, stride, padding, exponent):
+        super().__init__()
+        # Store pooling configuration (not used as nn module, just attributes)
+        self.kernel_size = kernel_size
+        self.stride = stride
+        self.padding = padding
+        # Exponent parameter (matches state_dict key 'pow')
+        self.pow = nn.Parameter(torch.tensor(exponent))
+        # Note: in_channels and out_channels are accepted but not used in this model
+        # (reference model ignores them except in signature)
+
+    def forward(self, x):
+        x = cuda_extension.avgpool2d_forward(x, self.kernel_size, self.stride, self.padding)
+        x = cuda_extension.pow_scalar_forward(x, self.pow)
+        return x
+
+    def debug_forward(self, *inputs):
+        x = inputs[0]
+        x = cuda_extension.avgpool2d_forward(x, self.kernel_size, self.stride, self.padding)
+        yield "step_001", x
+        x = cuda_extension.pow_scalar_forward(x, self.pow)
+        yield "step_002", x
+        yield "step_003", x
