{
  "operators": [
    {
      "name": "batch_norm_inference",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, L] where N=128, C=64, L=16384",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "default": 1e-05,
          "nullable": false,
          "optional": true
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "Performs BatchNorm1d inference: y = (x - running_mean) / sqrt(running_var + eps) * weight + bias.",
        "Normalization is applied per feature dimension (C), broadcasting over N and L.",
        "If weight is None (affine=False), use 1.0; if bias is None, use 0.0.",
        "Input x may be non-contiguous; kernel must handle arbitrary strides or internally make contiguous.",
        "Output has same shape and strides as x (or contiguous equivalent)."
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "return self.batch_norm(x)",
      "semantics": [
        "Calls BatchNorm1d in eval mode, using running statistics and affine parameters to compute normalized output.",
        "Output shape identical to input [128,64,16384], dtype float32, device CUDA."
      ]
    }
  ]
}