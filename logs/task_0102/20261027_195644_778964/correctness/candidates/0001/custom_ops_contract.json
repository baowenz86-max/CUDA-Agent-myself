        "输入为 CUDA float32 张量，形状 [512,3,256,256]",
        "输出形状、dtype、device 与输入相同"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回最终结果张量，形状 [512,3,256,256]，dtype float32，device cuda"
      ]
