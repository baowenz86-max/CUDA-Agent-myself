  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = F.elu(x)",
      "semantics": [
        "对输入张量 x 逐元素应用 ELU 激活函数：y = x if x > 0 else exp(x) - 1",
        "输入为 CUDA float32 张量，形状 [512,3,256,256]",
        "输出形状、dtype、device 与输入相同"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.triu(x)",
      "semantics": [
