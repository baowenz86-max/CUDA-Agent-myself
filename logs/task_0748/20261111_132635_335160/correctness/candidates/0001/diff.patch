--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,71 @@
+#include <cuda_runtime.h>
+#include <cfloat>
+
+// Kernel: softmax along dim=0 for 2D contiguous tensor (rows x cols)
+// Each block handles one column, threads iterate over rows in a grid-stride loop.
+__global__ void softmax_dim0_kernel(float* __restrict__ out, const float* __restrict__ in, int rows, int cols) {
+    int col = blockIdx.x;
+    if (col >= cols) return;
+
+    // Find max per column
+    float max_val = -FLT_MAX;
+    for (int row = threadIdx.x; row < rows; row += blockDim.x) {
+        float v = in[row * cols + col];
+        if (v > max_val) max_val = v;
+    }
+    // Warp/block reduction for max (since blockDim <= 1024)
+    __shared__ float smax[1024];
+    smax[threadIdx.x] = max_val;
+    __syncthreads();
+    for (int stride = blockDim.x / 2; stride > 0; stride >>= 1) {
+        if (threadIdx.x < stride) {
+            float other = smax[threadIdx.x + stride];
+            if (other > smax[threadIdx.x]) smax[threadIdx.x] = other;
+        }
+        __syncthreads();
+    }
+    max_val = smax[0];
+
+    // Compute exp and sum
+    float sum = 0.0f;
+    for (int row = threadIdx.x; row < rows; row += blockDim.x) {
+        float e = __expf(in[row * cols + col] - max_val);
+        out[row * cols + col] = e;
+        sum += e;
+    }
+    // Reduce sum
+    __shared__ float ssum[1024];
+    ssum[threadIdx.x] = sum;
+    __syncthreads();
+    for (int stride = blockDim.x / 2; stride > 0; stride >>= 1) {
+        if (threadIdx.x < stride) {
+            ssum[threadIdx.x] += ssum[threadIdx.x + stride];
+        }
+        __syncthreads();
+    }
+    sum = ssum[0];
+    float inv_sum = 1.0f / sum;
+
+    // Normalize
+    for (int row = threadIdx.x; row < rows; row += blockDim.x) {
+        out[row * cols + col] *= inv_sum;
+    }
+}
+
+// Launcher for softmax dim=0
+extern "C" void custom_softmax_launcher(float* out, const float* in, int rows, int cols, cudaStream_t stream) {
+    const int threads = 256;
+    const int blocks = cols;
+    softmax_dim0_kernel<<<blocks, threads, 0, stream>>>(out, in, rows, cols);
+}
+
+// Launcher for unsqueeze: output is a copy of input (binding will handle view)
+extern "C" void custom_unsqueeze_launcher(float* out, const float* in, int total_elements, cudaStream_t stream) {
+    int threads = 256;
+    int blocks = (total_elements + threads - 1) / threads;
+    // simple copy kernel
+    for (int i = 0; i < total_elements; i++) {
+        out[i] = in[i];
+    }
+    cudaMemcpyAsync(out, in, total_elements * sizeof(float), cudaMemcpyDeviceToDevice, stream);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,48 @@
+#include <torch/types.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launcher from custom_ops.cu
+extern "C" void custom_softmax_launcher(float* out, const float* in, int rows, int cols, cudaStream_t stream);
+
+// Wrapper for custom softmax (column-wise softmax)
+torch::Tensor custom_softmax_forward(torch::Tensor input, int64_t dim) {
+    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(input.dim() == 2, "Input must be 2D");
+    // The existing kernel only supports dim=0 (column-wise softmax)
+    TORCH_CHECK(dim == 0, "Only dim=0 supported");
+
+    int rows = input.size(0);
+    int cols = input.size(1);
+    auto output = torch::empty_like(input);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    custom_softmax_launcher(output.data_ptr<float>(), input.data_ptr<float>(), rows, cols, stream);
+
+    return output;
+}
+
+// Wrapper for custom unsqueeze (view)
+torch::Tensor custom_unsqueeze_forward(torch::Tensor input, int64_t dim) {
+    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(input.dim() == 2, "Input must be 2D");
+
+    // Unsqueeze is a view operation; no data copy.
+    return torch::unsqueeze(input, dim);
+}
+
+// Registration function
+void register_custom_ops_binding(pybind11::module& m) {
+    m.def("custom_softmax", &custom_softmax_forward, "Column-wise softmax",
+          pybind11::arg("input"), pybind11::arg("dim"));
+    m.def("custom_unsqueeze", &custom_unsqueeze_forward, "Unsqueeze view",
+          pybind11::arg("input"), pybind11::arg("dim"));
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops_binding, register_custom_ops_binding);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,20 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+class ModelNew(nn.Module):
+    def __init__(self, dim):
+        super().__init__()
+        self.dim = dim
+
+    def forward(self, x):
+        x = cuda_extension.custom_softmax(x, self.dim)
+        x = cuda_extension.custom_unsqueeze(x, self.dim)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.custom_softmax(x, self.dim)
+        yield 'step_001', x
+        x = cuda_extension.custom_unsqueeze(x, self.dim)
+        yield 'step_002', x
+        yield 'step_003', x
