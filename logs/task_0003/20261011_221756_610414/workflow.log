===== 现有 CUDA/C++ kernel 文件 =====

===== kernels/fused_mha_mul_stack.cu =====
#include <cuda_runtime.h>
#include <cstdint>
#include <cmath>
#include <cstdio>

#define WARP_SIZE 32

// Maximum head_dim supported by attention_kernel; adjust as needed.
#define MAX_HEAD_DIM 64

// Helper to compute ceil division for positive ints
static inline int ceil_div(int a, int b) {
    return (a + b - 1) / b;
}

// ---------------------------------------------------------------------
// Kernel 1: Fused QKV projection
// One thread per output element (B*num_heads*T*head_dim).
// Input x is [B, T, E]; output is [B, num_heads, T, head_dim].
// weight is [3*E, E]; bias may be NULL.
// proj_offset: 0 (Q), E (K), 2*E (V)
// ---------------------------------------------------------------------
__global__ void projection_kernel(
    const float* __restrict__ x,
    const float* __restrict__ weight,
    const float* __restrict__ bias,
    float* __restrict__ out,
    int B, int T, int E, int num_heads,
    int proj_offset,
    bool has_bias)
{
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int total = B * num_heads * T * (E / num_heads);
    if (idx >= total) return;

    int head_dim = E / num_heads;
    int d = idx % head_dim;
    int tmp = idx / head_dim;
    int t = tmp % T;
    tmp /= T;
    int h = tmp % num_heads;
    int b = tmp / num_heads;

    int e = h * head_dim + d;
    const float* x_row = x + ((size_t)b * T + t) * E;
    const float* w_row = weight + (size_t)(proj_offset + e) * E;
    float sum = 0.0f;
    for (int i = 0; i < E; ++i) {
        sum += x_row[i] * w_row[i];
    }
    if (has_bias) {
        sum += bias[proj_offset + e];
    }
    out[((size_t)(b * num_heads + h) * T + t) * head_dim + d] = sum;
}

// ---------------------------------------------------------------------
// Kernel 2: Multi-head attention with key padding mask (softmax)
// Each thread computes one query position (b, h, t).
// Uses a two-pass approach for numerical stability.
// Assumes head_dim <= MAX_HEAD_DIM (register array for output).
// Grid: (B, num_heads, ceil(T/blockDim.x))
// ---------------------------------------------------------------------
__global__ void attention_kernel(
    const float* __restrict__ Q,
    const float* __restrict__ K,
    const float* __restrict__ V,
    const bool* __restrict__ key_padding_mask,
    float* __restrict__ attn_out,
    int B, int T, int num_heads, int head_dim)
{
    int b = blockIdx.x;
    int h = blockIdx.y;
    int t = blockIdx.z * blockDim.x + threadIdx.x;
    if (t >= T) return;

    if (head_dim > MAX_HEAD_DIM) {
        // This should never happen for our target, but guard.
        if (t == 0) {
            __trap(); // In production would return error code; but launcher prevents this.
        }
        return;
    }

    const float* Q_base = Q + ((size_t)(b * num_heads + h) * T + t) * head_dim;
    const float* K_base = K + (size_t)(b * num_heads + h) * T * head_dim;
    const float* V_base = V + (size_t)(b * num_heads + h) * T * head_dim;
    float* out_base = attn_out + ((size_t)(b * num_heads + h) * T + t) * head_dim;

    const bool* mask_base = key_padding_mask + (size_t)b * T;

    float max_score = -1e30f;
    bool any_unmasked = false;

    // First pass: find max logit over unmasked keys
    for (int s = 0; s < T; ++s) {
        if (mask_base[s]) continue;
        any_unmasked = true;
        float score = 0.0f;
        const float* k_ptr = K_base + (size_t)s * head_dim;
        #pragma unroll
        for (int d = 0; d < head_dim; ++d) {
            score += Q_base[d] * k_ptr[d];
        }
        score /= sqrtf((float)head_dim);
        if (score > max_score) max_score = score;
    }

    if (!any_unmasked) {
        for (int d = 0; d < head_dim; ++d) out_base[d] = 0.0f;
        return;
    }

    float sum_exp = 0.0f;
    float out_vals[MAX_HEAD_DIM];
    #pragma unroll
    for (int d = 0; d < MAX_HEAD_DIM; ++d) {
        out_vals[d] = 0.0f;
    }

    // Second pass: accumulate weighted values
    for (int s = 0; s < T; ++s) {
        if (mask_base[s]) continue;
        float score = 0.0f;
        const float* k_ptr = K_base + (size_t)s * head_dim;
        #pragma unroll
        for (int d = 0; d < head_dim; ++d) {
            score += Q_base[d] * k_ptr[d];
        }
        score /= sqrtf((float)head_dim);
        float exp_score = __expf(score - max_score);
        sum_exp += exp_score;
        const float* v_ptr = V_base + (size_t)s * head_dim;
        #pragma unroll
        for (int d = 0; d < head_dim; ++d) {
            out_vals[d] += exp_score * v_ptr[d];
        }
    }

    float inv_sum = 1.0f / sum_exp;
    #pragma unroll
    for (int d = 0; d < head_dim; ++d) {
        out_base[d] = out_vals[d] * inv_sum;
    }
}

// ---------------------------------------------------------------------
// Kernel 3: Output projection + multiply + stack
// One thread per output element (B*T*E).
// Additionally computes x1*x2 for the corresponding (b,t,e).
// Writes three values (x3, multiply, attention output) to the stacked output.
// attn_head layout: [B, num_heads, T, head_dim]
// out_proj_weight: [E,E]; may have bias.
// stack_dim controls output layout.
// ---------------------------------------------------------------------
__global__ void output_projection_stack_kernel(
    const float* __restrict__ attn_head,
    const float* __restrict__ x1,
    const float* __restrict__ x2,
    const float* __restrict__ x3,
    const float* __restrict__ out_proj_weight,
    const float* __restrict__ out_proj_bias,
    float* __restrict__ out,
    int B, int T, int E, int num_heads, int head_dim, int stack_dim,
    bool has_out_bias)
{
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int total = B * T * E;
    if (idx >= total) return;

    int e = idx % E;
    int tmp = idx / E;
    int t = tmp % T;
    int b = tmp / T;

    // Compute output projection contribution for this (b,t,e)
    // The output projection is: sum_{h,d} attn_head[(b,h,t,d)] * W_out[e, h*head_dim + d]
    float acc = 0.0f;
    for (int h = 0; h < num_heads; ++h) {
        const float* ah = attn_head + ((size_t)(b * num_heads + h) * T + t) * head_dim;
        const float* wp = out_proj_weight + (size_t)e * E + h * head_dim;
        for (int d = 0; d < head_dim; ++d) {
            acc += ah[d] * wp[d];
        }
    }
    if (has_out_bias) {
        acc += out_proj_bias[e];
    }

    // Original values
    size_t linear_idx = ((size_t)b * T + t) * E + e;
    float x1_val = x1[linear_idx];
    float x2_val = x2[linear_idx];
    float x3_val = x3[linear_idx];
    float mul_val = x1_val * x2_val;

    // Write according to stack_dim
    if (stack_dim == 0) {
        // [3, B, T, E]
        size_t base = ((size_t)b * T + t) * E + e;
        out[base] = x3_val;                     // index 0
        out[(size_t)1 * B * T * E + base] = mul_val; // index 1
        out[(size_t)2 * B * T * E + base] = acc;     // index 2
    } else if (stack_dim == 1) {
        // [B, 3, T, E]
        size_t base = ((size_t)b * 3 * T + t) * E + e;
        out[base] = x3_val;                     // slice 0
        out[base + (size_t)T * E] = mul_val;   // slice 1
        out[base + (size_t)2 * T * E] = acc;    // slice 2
    } else if (stack_dim == 2) {
        // [B, T, 3, E]
        size_t base = ((size_t)(b * T + t) * 3 * E) + e;
        out[base] = x3_val;
        out[base + E] = mul_val;
        out[base + 2 * E] = acc;
    } else { // stack_dim == 3
        // [B, T, E, 3]
        size_t base = (((size_t)b * T + t) * E + e) * 3;
        out[base] = x3_val;
        out[base + 1] = mul_val;
        out[base + 2] = acc;
    }
}

// ---------------------------------------------------------------------
// Host launcher: allocates temporary buffers, launches kernels, frees.
// All parameters are raw pointers; stream provided.
// B, T, E, num_heads, stack_dim are ints.
// ---------------------------------------------------------------------
extern "C" void fused_mha_mul_stack_launcher(
    const float* x1, const float* x2, const float* x3,
    const bool* key_padding_mask,
    const float* in_proj_weight, const float* in_proj_bias,
    const float* out_proj_weight, const float* out_proj_bias,
    float* out,
    int B, int T, int E, int num_heads, int stack_dim,
    cudaStream_t stream)
{
    // Basic checks (should be done in binding, but double-guard)
    if (B <= 0 || T <= 0 || E <= 0 || num_heads <= 0) return;
    if (E % num_heads != 0) return; // head_dim not integer, cannot proceed

    int head_dim = E / num_heads;
    if (head_dim > MAX_HEAD_DIM) {
        // Not supported; the binding should have rejected this. We'll return without doing anything.
        // Better to set an error, but since launcher returns void, we just skip.
        return;
    }

    // Allocate temporary buffers on device
    size_t qkv_size = (size_t)B * num_heads * T * head_dim * sizeof(float);
    float *d_Q, *d_K, *d_V, *d_attn_head;
    cudaError_t err;
    err = cudaMalloc(&d_Q, qkv_size);
    if (err != cudaSuccess) return;
    err = cudaMalloc(&d_K, qkv_size);
    if (err != cudaSuccess) { cudaFree(d_Q); return; }
    err = cudaMalloc(&d_V, qkv_size);
    if (err != cudaSuccess) { cudaFree(d_Q); cudaFree(d_K); return; }
    err = cudaMalloc(&d_attn_head, qkv_size);
    if (err != cudaSuccess) { cudaFree(d_Q); cudaFree(d_K); cudaFree(d_V); return; }

    bool has_in_proj_bias = (in_proj_bias != nullptr);
    bool has_out_proj_bias = (out_proj_bias != nullptr);

    // Launch projection kernels for Q, K, V
    int total_proj = B * num_heads * T * head_dim;
    if (total_proj > 0) {
        int block_proj = 256;
        int grid_proj = ceil_div(total_proj, block_proj);

        projection_kernel<<<grid_proj, block_proj, 0, stream>>>(
            x1, in_proj_weight, in_proj_bias, d_Q,
            B, T, E, num_heads, 0, has_in_proj_bias);

        projection_kernel<<<grid_proj, block_proj, 0, stream>>>(
            x2, in_proj_weight, in_proj_bias, d_K,
            B, T, E, num_heads, E, has_in_proj_bias);

        projection_kernel<<<grid_proj, block_proj, 0, stream>>>(
            x3, in_proj_weight, in_proj_bias, d_V,
            B, T, E, num_heads, 2 * E, has_in_proj_bias);
    }

    // Launch attention kernel
    // Grid dimensions: (B, num_heads, ceil(T / block_attn))
    int block_attn = 256;
    dim3 grid_attn(B, num_heads, ceil_div(T, block_attn));
    attention_kernel<<<grid_attn, block_attn, 0, stream>>>(
        d_Q, d_K, d_V, key_padding_mask, d_attn_head,
        B, T, num_heads, head_dim);

    // Launch output projection + stack kernel
    int total_out = B * T * E;
    if (total_out > 0) {
        int block_out = 256;
        int grid_out = ceil_div(total_out, block_out);
        output_projection_stack_kernel<<<grid_out, block_out, 0, stream>>>(
            d_attn_head, x1, x2, x3, out_proj_weight, out_proj_bias, out,
            B, T, E, num_heads, head_dim, stack_dim, has_out_proj_bias);
    }

    // Free temporary buffers
    // Note: cudaFree is synchronous with respect to device, but it ensures the memory is freed
    // after all preceding work completes. This is acceptable for performance in this context.
    cudaFree(d_Q);
    cudaFree(d_K);
    cudaFree(d_V);
    cudaFree(d_attn_head);
}

