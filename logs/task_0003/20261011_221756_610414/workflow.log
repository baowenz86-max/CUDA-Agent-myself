===== kernels/fused_mha_mul_stack.cu =====
#include <cuda_runtime.h>
#include <cstdint>
#include <cmath>

// Kernel for single projection: computes one of Q, K, V from input x.
// proj_offset: 0 for Q, E for K, 2*E for V (row offset in weight and bias)
// output layout: [B, num_heads, T, head_dim]
__global__ void projection_kernel(
    const float* __restrict__ x,
    const float* __restrict__ weight,
    const float* __restrict__ bias,
    float* __restrict__ out,
    int B, int T, int E, int num_heads,
    int proj_offset,
    bool has_bias)
{
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int total = B * num_heads * T * (E / num_heads);
    if (idx >= total) return;

    int head_dim = E / num_heads;
    int d = idx % head_dim;
    int tmp = idx / head_dim;
    int t = tmp % T;
    tmp /= T;
    int h = tmp % num_heads;
    int b = tmp / num_heads;

    int e = h * head_dim + d;
    const float* x_row = x + (b * T + t) * E;
    const float* w_row = weight + (proj_offset + e) * E;
    float sum = 0.0f;
    for (int i = 0; i < E; ++i) {
        sum += x_row[i] * w_row[i];
    }
    if (has_bias) {
        sum += bias[proj_offset + e];
    }
    out[((b * num_heads + h) * T + t) * head_dim + d] = sum;
}

// Attention kernel: one thread per query (b,h,t). Uses shared memory for K and V tiles.
__global__ void attention_kernel(
    const float* __restrict__ Q,
    const float* __restrict__ K,
    const float* __restrict__ V,
    const bool* __restrict__ key_padding_mask,
    float* __restrict__ attn_out,
    int B, int T, int num_heads, int head_dim)
{
    int b = blockIdx.x;
    int h = blockIdx.y;
    int t = blockIdx.z * blockDim.x + threadIdx.x;
    if (t >= T) return;

    const float* Q_base = Q + ((b * num_heads + h) * T + t) * head_dim;
    const float* K_base = K + (b * num_heads + h) * T * head_dim;
    const float* V_base = V + (b * num_heads + h) * T * head_dim;
    float* out_base = attn_out + ((b * num_heads + h) * T + t) * head_dim;

    float max_score = -1e30f;
    bool any_unmasked = false;

    // First pass: compute max over unmasked keys
    for (int s = 0; s < T; ++s) {
        if (key_padding_mask[b * T + s]) continue;
        any_unmasked = true;
        float score = 0.0f;
        const float* k_ptr = K_base + s * head_dim;
        for (int d = 0; d < head_dim; ++d) {
            score += Q_base[d] * k_ptr[d];
        }
        score /= sqrtf((float)head_dim);
        if (score > max_score) max_score = score;
    }

    if (!any_unmasked) {
        for (int d = 0; d < head_dim; ++d) out_base[d] = 0.0f;
        return;
    }

    float sum_exp = 0.0f;
    float out_vals[64]; // head_dim assumed <= 64
    for (int d = 0; d < head_dim; ++d) out_vals[d] = 0.0f;

    // Second pass: compute softmax weighted sum
    for (int s = 0; s < T; ++s) {
        if (key_padding_mask[b * T + s]) continue;
        float score = 0.0f;
        const float* k_ptr = K_base + s * head_dim;
        for (int d = 0; d < head_dim; ++d) {
            score += Q_base[d] * k_ptr[d];
        }
        score /= sqrtf((float)head_dim);
        float exp_score = __expf(score - max_score);
        sum_exp += exp_score;
        const float* v_ptr = V_base + s * head_dim;
        for (int d = 0; d < head_dim; ++d) {
            out_vals[d] += exp_score * v_ptr[d];
        }
    }

    // Write output
    float inv_sum = 1.0f / sum_exp;
    for (int d = 0; d < head_dim; ++d) {
        out_base[d] = out_vals[d] * inv_sum;
    }
}

// Kernel for output projection + multiply + stack
__global__ void output_projection_stack_kernel(
    const float* __restrict__ attn_head,   // [B, num_heads, T, head_dim]
    const float* __restrict__ x1,          // [B,T,E]
    const float* __restrict__ x2,          // [B,T,E]
    const float* __restrict__ x3,          // [B,T,E]
    const float* __restrict__ out_proj_weight, // [E,E]
    const float* __restrict__ out_proj_bias,   // [E]
    float* __restrict__ out,               // layout depends on stack_dim
    int B, int T, int E, int num_heads, int head_dim, int stack_dim,
    bool has_out_bias)
{
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int total = B * T * E;
    if (idx >= total) return;

    int e = idx % E;
    int tmp = idx / E;
    int t = tmp % T;
    int b = tmp / T;

    // Compute output projection for this (b,t,e)
    float acc = 0.0f;
    for (int h = 0; h < num_heads; ++h) {
        int head_dim = E / num_heads;
        const float* ah = attn_head + ((b * num_heads + h) * T + t) * head_dim;
        const float* wp = out_proj_weight + e * E + h * head_dim;
        for (int d = 0; d < head_dim; ++d) {
            acc += ah[d] * wp[d];
        }
    }
    if (has_out_bias) {
        acc += out_proj_bias[e];
    }

    float x1_val = x1[idx];
    float x2_val = x2[idx];
    float x3_val = x3[idx];
    float mul_val = x1_val * x2_val;

    // Write output according to stack_dim
    if (stack_dim == 0) {
        // [3, B, T, E]
        out[(0 * B + b) * T * E + t * E + e] = x3_val;
        out[(1 * B + b) * T * E + t * E + e] = mul_val;
        out[(2 * B + b) * T * E + t * E + e] = acc;
    } else if (stack_dim == 1) {
        // [B, 3, T, E]
        out[((b * 3 + 0) * T + t) * E + e] = x3_val;
        out[((b * 3 + 1) * T + t) * E + e] = mul_val;
        out[((b * 3 + 2) * T + t) * E + e] = acc;
    } else if (stack_dim == 2) {
        // [B, T, 3, E]
        out[(((b * T + t) * 3 + 0) * E) + e] = x3_val;
        out[(((b * T + t) * 3 + 1) * E) + e] = mul_val;
        out[(((b * T + t) * 3 + 2) * E) + e] = acc;
    } else { // stack_dim == 3
        // [B, T, E, 3]
        out[(b * T * E + t * E + e) * 3 + 0] = x3_val;
        out[(b * T * E + t * E + e) * 3 + 1] = mul_val;
        out[(b * T * E + t * E + e) * 3 + 2] = acc;
    }
}

// Host launcher
extern "C" void fused_mha_mul_stack_launcher(
    const float* x1, const float* x2, const float* x3,
    const bool* key_padding_mask,
    const float* in_proj_weight, const float* in_proj_bias,
    const float* out_proj_weight, const float* out_proj_bias,
    float* out,
    int B, int T, int E, int num_heads, int stack_dim,
    cudaStream_t stream)
{
    int head_dim = E / num_heads;

    // Allocate temporary buffers
    size_t qkv_size = (size_t)B * num_heads * T * head_dim * sizeof(float);
    float *d_Q, *d_K, *d_V, *d_attn_head;
    cudaMalloc(&d_Q, qkv_size);
    cudaMalloc(&d_K, qkv_size);
    cudaMalloc(&d_V, qkv_size);
    cudaMalloc(&d_attn_head, qkv_size);

    bool has_in_proj_bias = (in_proj_bias != nullptr);
    bool has_out_proj_bias = (out_proj_bias != nullptr);

    // Launch three projection kernels
    int total_proj = B * num_heads * T * head_dim;
    int block_proj = 256;
    int grid_proj = (total_proj + block_proj - 1) / block_proj;

    projection_kernel<<<grid_proj, block_proj, 0, stream>>>(
        x1, in_proj_weight, in_proj_bias, d_Q, B, T, E, num_heads, 0, has_in_proj_bias);
    projection_kernel<<<grid_proj, block_proj, 0, stream>>>(
        x2, in_proj_weight, in_proj_bias, d_K, B, T, E, num_heads, E, has_in_proj_bias);
    projection_kernel<<<grid_proj, block_proj, 0, stream>>>(
        x3, in_proj_weight, in_proj_bias, d_V, B, T, E, num_heads, 2 * E, has_in_proj_bias);

    // Launch attention kernel: grid (B, num_heads, ceil(T/block))
    dim3 grid_attn(B, num_heads, (T + 255) / 256);
    int block_attn = 256;
    attention_kernel<<<grid_attn, block_attn, 0, stream>>>(
        d_Q, d_K, d_V, key_padding_mask, d_attn_head, B, T, num_heads, head_dim);

    // Launch output projection + stack kernel
    int total_out = B * T * E;
    int block_out = 256;
    int grid_out = (total_out + block_out - 1) / block_out;
    output_projection_stack_kernel<<<grid_out, block_out, 0, stream>>>(
        d_attn_head, x1, x2, x3, out_proj_weight, out_proj_bias, out,
        B, T, E, num_heads, head_dim, stack_dim, has_out_proj_bias);

    // Free temporary buffers (asynchronously? cudaFree is synchronous, but acceptable)
    cudaFree(d_Q);
    cudaFree(d_K);
    cudaFree(d_V);
    cudaFree(d_attn_head);
}

===== kernels/fused_mha_mul_stack_binding.cpp =====
#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>

#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

// Declare launcher from .cu file
extern "C" void fused_mha_mul_stack_launcher(
    const float* x1, // [B,T,E]
    const float* x2, // [B,T,E]
    const float* x3, // [B,T,E]
    const bool* key_padding_mask, // [B,T]
    const float* in_proj_weight, // [3E,E]
    const float* in_proj_bias,   // [3E] (may be null)
    const float* out_proj_weight, // [E,E]
    const float* out_proj_bias,   // [E] (may be null)
    float* out, // [3,B,T,E] or permuted according to stack_dim
    int B, int T, int E, int num_heads, int stack_dim,
    cudaStream_t stream);

// PyTorch wrapper
at::Tensor fused_mha_mul_stack_forward(
    at::Tensor x1,
    at::Tensor x2,
    at::Tensor x3,
    at::Tensor key_padding_mask,
    at::Tensor in_proj_weight,
    at::Tensor in_proj_bias,
    at::Tensor out_proj_weight,
    at::Tensor out_proj_bias,
    int64_t stack_dim) {

    // Input validation
    TORCH_CHECK(x1.is_cuda(), "x1 must be a CUDA tensor");
    TORCH_CHECK(x2.is_cuda(), "x2 must be a CUDA tensor");
    TORCH_CHECK(x3.is_cuda(), "x3 must be a CUDA tensor");
    TORCH_CHECK(key_padding_mask.is_cuda(), "key_padding_mask must be a CUDA tensor");
    TORCH_CHECK(in_proj_weight.is_cuda(), "in_proj_weight must be a CUDA tensor");
    TORCH_CHECK(out_proj_weight.is_cuda(), "out_proj_weight must be a CUDA tensor");
    if (in_proj_bias.numel() > 0) {
        TORCH_CHECK(in_proj_bias.is_cuda(), "in_proj_bias must be a CUDA tensor");
    }
    if (out_proj_bias.numel() > 0) {
        TORCH_CHECK(out_proj_bias.is_cuda(), "out_proj_bias must be a CUDA tensor");
    }

    // Contiguity checks
    TORCH_CHECK(x1.is_contiguous(), "x1 must be contiguous");
    TORCH_CHECK(x2.is_contiguous(), "x2 must be contiguous");
    TORCH_CHECK(x3.is_contiguous(), "x3 must be contiguous");
    TORCH_CHECK(key_padding_mask.is_contiguous(), "key_padding_mask must be contiguous");
    TORCH_CHECK(in_proj_weight.is_contiguous(), "in_proj_weight must be contiguous");
    TORCH_CHECK(in_proj_bias.is_contiguous(), "in_proj_bias must be contiguous");
    TORCH_CHECK(out_proj_weight.is_contiguous(), "out_proj_weight must be contiguous");
    TORCH_CHECK(out_proj_bias.is_contiguous(), "out_proj_bias must be contiguous");

    // Dtype checks: float32 only
    TORCH_CHECK(x1.dtype() == torch::kFloat32, "x1 must be float32");
    TORCH_CHECK(x2.dtype() == torch::kFloat32, "x2 must be float32");
    TORCH_CHECK(x3.dtype() == torch::kFloat32, "x3 must be float32");
    TORCH_CHECK(key_padding_mask.dtype() == torch::kBool, "key_padding_mask must be bool");
    TORCH_CHECK(in_proj_weight.dtype() == torch::kFloat32, "in_proj_weight must be float32");
    TORCH_CHECK(in_proj_bias.dtype() == torch::kFloat32, "in_proj_bias must be float32");
    TORCH_CHECK(out_proj_weight.dtype() == torch::kFloat32, "out_proj_weight must be float32");
    TORCH_CHECK(out_proj_bias.dtype() == torch::kFloat32, "out_proj_bias must be float32");

    // Shape checks
    TORCH_CHECK(x1.dim() == 3, "x1 must be 3D [B,T,E]");
    TORCH_CHECK(x2.dim() == 3, "x2 must be 3D [B,T,E]");
    TORCH_CHECK(x3.dim() == 3, "x3 must be 3D [B,T,E]");
    TORCH_CHECK(key_padding_mask.dim() == 2, "key_padding_mask must be 2D [B,T]");
    TORCH_CHECK(in_proj_weight.dim() == 2, "in_proj_weight must be 2D [3*E,E]");
    TORCH_CHECK(out_proj_weight.dim() == 2, "out_proj_weight must be 2D [E,E]");

    int64_t B = x1.size(0);
    int64_t T = x1.size(1);
    int64_t E = x1.size(2);
    int64_t num_heads = in_proj_weight.size(0) / (3 * E); // Compute num_heads from weight shape

    TORCH_CHECK(x2.size(0) == B && x2.size(1) == T && x2.size(2) == E, "x2 shape mismatch");
    TORCH_CHECK(x3.size(0) == B && x3.size(1) == T && x3.size(2) == E, "x3 shape mismatch");
    TORCH_CHECK(key_padding_mask.size(0) == B && key_padding_mask.size(1) == T, "key_padding_mask shape mismatch");
    TORCH_CHECK(in_proj_weight.size(0) == 3 * E && in_proj_weight.size(1) == E, "in_proj_weight shape mismatch");
    TORCH_CHECK(out_proj_weight.size(0) == E && out_proj_weight.size(1) == E, "out_proj_weight shape mismatch");
    TORCH_CHECK(E % num_heads == 0, "E must be divisible by num_heads");
    if (in_proj_bias.numel() > 0) {
        TORCH_CHECK(in_proj_bias.size(0) == 3 * E, "in_proj_bias shape mismatch");
    }
    if (out_proj_bias.numel() > 0) {
        TORCH_CHECK(out_proj_bias.size(0) == E, "out_proj_bias shape mismatch");
    }

    // Bias may be None from Python; we'll treat empty tensor as no bias.
    // Determine if we have bias tensors (non-empty).
    bool has_in_proj_bias = in_proj_bias.numel() > 0;
    bool has_out_proj_bias = out_proj_bias.numel() > 0;

    // stack_dim validation (0 to 3 inclusive)
    TORCH_CHECK(stack_dim >= 0 && stack_dim <= 3, "stack_dim must be in [0,3]");

    // Output shape depends on stack_dim:
    // If stack_dim=0: [3, B, T, E]
    // If stack_dim=1: [B, 3, T, E]
    // If stack_dim=2: [B, T, 3, E]
    // If stack_dim=3: [B, T, E, 3]
    std::vector<int64_t> out_shape;
    if (stack_dim == 0) {
        out_shape = {3, B, T, E};
    } else if (stack_dim == 1) {
        out_shape = {B, 3, T, E};
    } else if (stack_dim == 2) {
        out_shape = {B, T, 3, E};
    } else { // stack_dim == 3
        out_shape = {B, T, E, 3};
    }

    auto out = torch::empty(out_shape, x1.options());

    // Get current CUDA stream
    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    // Call launcher
    fused_mha_mul_stack_launcher(
        x1.data_ptr<float>(),
        x2.data_ptr<float>(),
        x3.data_ptr<float>(),
        key_padding_mask.data_ptr<bool>(),
        in_proj_weight.data_ptr<float>(),
        has_in_proj_bias ? in_proj_bias.data_ptr<float>() : nullptr,
        out_proj_weight.data_ptr<float>(),
        has_out_proj_bias ? out_proj_bias.data_ptr<float>() : nullptr,
        out.data_ptr<float>(),
        static_cast<int>(B),
        static_cast<int>(T),
        static_cast<int>(E),
        static_cast<int>(num_heads), // pass num_heads
        static_cast<int>(stack_dim),
        stream
    );

    return out;
}

// Register binding
void register_fused_mha_mul_stack(pybind11::module& m) {
    m.def("fused_mha_mul_stack", &fused_mha_mul_stack_forward,
          "Fused MultiheadAttention + multiply + stack",
          py::arg("x1"), py::arg("x2"), py::arg("x3"), py::arg("key_padding_mask"),
          py::arg("in_proj_weight"), py::arg("in_proj_bias"), py::arg("out_proj_weight"),
          py::arg("out_proj_bias"), py::arg("stack_dim"));
}

REGISTER_BINDING(fused_mha_mul_stack, register_fused_mha_mul_stack);
