#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>

#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

// Declare launcher from .cu file
extern "C" void fused_mha_mul_stack_launcher(
    const float* x1,
    const float* x2,
    const float* x3,
    const bool* key_padding_mask,
    const float* in_proj_weight,
    const float* in_proj_bias,
    const float* out_proj_weight,
    const float* out_proj_bias,
    float* out,
    int B, int T, int E, int num_heads, int stack_dim,
    cudaStream_t stream);

// PyTorch wrapper
at::Tensor fused_mha_mul_stack_forward(
    at::Tensor x1,
    at::Tensor x2,
    at::Tensor x3,
    at::Tensor key_padding_mask,
    at::Tensor in_proj_weight,
    at::Tensor in_proj_bias,
    at::Tensor out_proj_weight,
    at::Tensor out_proj_bias,
    int64_t stack_dim) {

    // Input validation
    TORCH_CHECK(x1.is_cuda(), "x1 must be a CUDA tensor");
    TORCH_CHECK(x2.is_cuda(), "x2 must be a CUDA tensor");
    TORCH_CHECK(x3.is_cuda(), "x3 must be a CUDA tensor");
    TORCH_CHECK(key_padding_mask.is_cuda(), "key_padding_mask must be a CUDA tensor");
    TORCH_CHECK(in_proj_weight.is_cuda(), "in_proj_weight must be a CUDA tensor");
    TORCH_CHECK(out_proj_weight.is_cuda(), "out_proj_weight must be a CUDA tensor");
    if (in_proj_bias.numel() > 0) {
        TORCH_CHECK(in_proj_bias.is_cuda(), "in_proj_bias must be a CUDA tensor");
    }
    if (out_proj_bias.numel() > 0) {
        TORCH_CHECK(out_proj_bias.is_cuda(), "out_proj_bias must be a CUDA tensor");
    }

    // Contiguity checks
    TORCH_CHECK(x1.is_contiguous(), "x1 must be contiguous");
    TORCH_CHECK(x2.is_contiguous(), "x2 must be contiguous");
    TORCH_CHECK(x3.is_contiguous(), "x3 must be contiguous");
    TORCH_CHECK(key_padding_mask.is_contiguous(), "key_padding_mask must be contiguous");
    TORCH_CHECK(in_proj_weight.is_contiguous(), "in_proj_weight must be contiguous");
    TORCH_CHECK(out_proj_weight.is_contiguous(), "out_proj_weight must be contiguous");
    if (in_proj_bias.numel() > 0) {
        TORCH_CHECK(in_proj_bias.is_contiguous(), "in_proj_bias must be contiguous");
    }
    if (out_proj_bias.numel() > 0) {
        TORCH_CHECK(out_proj_bias.is_contiguous(), "out_proj_bias must be contiguous");
    }

    // Dtype checks: float32 only
    TORCH_CHECK(x1.dtype() == torch::kFloat32, "x1 must be float32");
    TORCH_CHECK(x2.dtype() == torch::kFloat32, "x2 must be float32");
    TORCH_CHECK(x3.dtype() == torch::kFloat32, "x3 must be float32");
    TORCH_CHECK(key_padding_mask.dtype() == torch::kBool, "key_padding_mask must be bool");
    TORCH_CHECK(in_proj_weight.dtype() == torch::kFloat32, "in_proj_weight must be float32");
    TORCH_CHECK(out_proj_weight.dtype() == torch::kFloat32, "out_proj_weight must be float32");
    if (in_proj_bias.numel() > 0) {
        TORCH_CHECK(in_proj_bias.dtype() == torch::kFloat32, "in_proj_bias must be float32");
    }
    if (out_proj_bias.numel() > 0) {
        TORCH_CHECK(out_proj_bias.dtype() == torch::kFloat32, "out_proj_bias must be float32");
    }

    // Shape checks
    TORCH_CHECK(x1.dim() == 3, "x1 must be 3D [B,T,E]");
    TORCH_CHECK(x2.dim() == 3, "x2 must be 3D [B,T,E]");
    TORCH_CHECK(x3.dim() == 3, "x3 must be 3D [B,T,E]");
    TORCH_CHECK(key_padding_mask.dim() == 2, "key_padding_mask must be 2D [B,T]");
    TORCH_CHECK(in_proj_weight.dim() == 2, "in_proj_weight must be 2D [3*E,E]");
    TORCH_CHECK(out_proj_weight.dim() == 2, "out_proj_weight must be 2D [E,E]");

    int64_t B = x1.size(0);
    int64_t T = x1.size(1);
    int64_t E = x1.size(2);

    TORCH_CHECK(in_proj_weight.size(0) % (3 * E) == 0, "in_proj_weight first dim must be divisible by 3*E");
    int64_t num_heads = in_proj_weight.size(0) / (3 * E);
    TORCH_CHECK(E % num_heads == 0, "E must be divisible by num_heads");

    TORCH_CHECK(x2.size(0) == B && x2.size(1) == T && x2.size(2) == E, "x2 shape mismatch");
    TORCH_CHECK(x3.size(0) == B && x3.size(1) == T && x3.size(2) == E, "x3 shape mismatch");
    TORCH_CHECK(key_padding_mask.size(0) == B && key_padding_mask.size(1) == T, "key_padding_mask shape mismatch");
    TORCH_CHECK(in_proj_weight.size(0) == 3 * E && in_proj_weight.size(1) == E, "in_proj_weight shape mismatch");
    TORCH_CHECK(out_proj_weight.size(0) == E && out_proj_weight.size(1) == E, "out_proj_weight shape mismatch");

    if (in_proj_bias.numel() > 0) {
        TORCH_CHECK(in_proj_bias.size(0) == 3 * E, "in_proj_bias shape mismatch");
    }
    if (out_proj_bias.numel() > 0) {
        TORCH_CHECK(out_proj_bias.size(0) == E, "out_proj_bias shape mismatch");
    }

    // Bias may be None from Python; we'll treat empty tensor as no bias.
    bool has_in_proj_bias = in_proj_bias.numel() > 0;
    bool has_out_proj_bias = out_proj_bias.numel() > 0;

    // stack_dim validation (0 to 3 inclusive)
    TORCH_CHECK(stack_dim >= 0 && stack_dim <= 3, "stack_dim must be in [0,3]");

    // Output shape depends on stack_dim:
    std::vector<int64_t> out_shape;
    if (stack_dim == 0) {
        out_shape = {3, B, T, E};
    } else if (stack_dim == 1) {
        out_shape = {B, 3, T, E};
    } else if (stack_dim == 2) {
        out_shape = {B, T, 3, E};
    } else { // stack_dim == 3
        out_shape = {B, T, E, 3};
    }

    auto out = torch::empty(out_shape, x1.options());

    // Get current CUDA stream
    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    // Call launcher
    fused_mha_mul_stack_launcher(
        x1.data_ptr<float>(),
        x2.data_ptr<float>(),
        x3.data_ptr<float>(),
        key_padding_mask.data_ptr<bool>(),
        in_proj_weight.data_ptr<float>(),
        has_in_proj_bias ? in_proj_bias.data_ptr<float>() : nullptr,
        out_proj_weight.data_ptr<float>(),
        has_out_proj_bias ? out_proj_bias.data_ptr<float>() : nullptr,
        out.data_ptr<float>(),
        static_cast<int>(B),
        static_cast<int>(T),
        static_cast<int>(E),
        static_cast<int>(num_heads),
        static_cast<int>(stack_dim),
        stream
    );

    return out;
}

// Register binding
void register_fused_mha_mul_stack(pybind11::module& m) {
    m.def("fused_mha_mul_stack", &fused_mha_mul_stack_forward,
          "Fused MultiheadAttention + multiply + stack",
          py::arg("x1"), py::arg("x2"), py::arg("x3"), py::arg("key_padding_mask"),
          py::arg("in_proj_weight"), py::arg("in_proj_bias"), py::arg("out_proj_weight"),
          py::arg("out_proj_bias"), py::arg("stack_dim"));
}

REGISTER_BINDING(fused_mha_mul_stack, register_fused_mha_mul_stack);
