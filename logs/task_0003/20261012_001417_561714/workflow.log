===== kernels/multiply_broadcast.cu =====
// Multiply two tensors element-wise with broadcasting (both same shape for this use case)
// Supports float and half. Handles non-contiguous inputs by using strides provided externally.
#include <cuda_runtime.h>
#include <cstdint>

// Kernel assumes inputs are broadcast-compatible but does not compute broadcasting internally.
// Since the launcher receives tensors that are already expanded or have same shape,
// we just multiply elementwise over the total number of elements.
// If broadcasting is needed, we handle it by index calculation from original shapes? No, we simplify:
// The inputs are expected to have the same shape after expansion, so we just multiply 1D arrays.
// For safety, we compute using a simple identity mapping. The launcher ensures contiguous tensors.
template <typename T>
__global__ void multiply_kernel(T* out, const T* a, const T* b, int64_t total) {
    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
    int64_t stride = (int64_t)blockDim.x * gridDim.x;
    for (int64_t i = idx; i < total; i += stride) {
        out[i] = a[i] * b[i];
    }
}

// Launcher for float
extern "C" void multiply_broadcast_float(
    float* out, const float* a, const float* b, int64_t total, cudaStream_t stream) {
    if (total == 0) return;
    const int threads = 256;
    int64_t blocks64 = (total + threads - 1) / threads;
    int blocks = (int)min(blocks64, (int64_t)65535); // grid limit
    multiply_kernel<float><<<blocks, threads, 0, stream>>>(out, a, b, total);
}

// Launcher for half
extern "C" void multiply_broadcast_half(
    half* out, const half* a, const half* b, int64_t total, cudaStream_t stream) {
    if (total == 0) return;
    const int threads = 256;
    int64_t blocks64 = (total + threads - 1) / threads;
    int blocks = (int)min(blocks64, (int64_t)65535);
    multiply_kernel<half><<<blocks, threads, 0, stream>>>(out, a, b, total);
}

// Launcher for double
extern "C" void multiply_broadcast_double(
    double* out, const double* a, const double* b, int64_t total, cudaStream_t stream) {
    if (total == 0) return;
    const int threads = 256;
    int64_t blocks64 = (total + threads - 1) / threads;
    int blocks = (int)min(blocks64, (int64_t)65535);
    multiply_kernel<double><<<blocks, threads, 0, stream>>>(out, a, b, total);
}

===== kernels/stack_along_dim.cu =====
// Stack two tensors along a given dimension (0,1,2) efficiently.
// Since we know both tensors have same shape, we can simply copy data into output with offset.
// The output tensor shape differs from each input by an extra dimension of size 2 at stack_dim.
// Implementation: each thread computes its linear index in output, determines which input tensor and source index.
#include <cuda_runtime.h>
#include <cstdint>

// Kernel for stacking two tensors along a dimension.
// total_elements: total number of elements in output tensor.
// size_after_stack_dim: number of elements per slice after the stack dimension (i.e., product of dims > stack_dim).
// slice_size: number of contiguous elements up to and including stack_dim (i.e., product of dims <= stack_dim) but we compute more generally.
// More precisely: Let shape be [d0, d1, d2], stack_dim = s. The output shape has an extra dimension of size 2 at position s.
// For each linear output index, we recover the coordinates, then decide which tensor (0 or 1) and compute the linear index in that tensor.
// To avoid expensive divisions, we precompute strides. We assume 3D typical but general - we pass product of dimensions after stack dim and before.
// We can use a simple method: compute the planes.
// We'll define a kernel that takes pointers to two input tensors, output tensor, and parameters:
//   out_shape: shape of output (not passed as array, but we can compute from total and dimensions)
// We can pass: d0, d1, d2 (assuming 3D) but for generality, we can compute using product of dims.
// Since stack_dim could be 0,1,2 for 3D inputs, we can handle these cases separately with specialized kernels for speed.
// For simplicity and correctness, we use coordinate-based indexing with modulo and division; but that may be slow.
// Better: use linear index and precomputed strides for both output and input tensors, then vectorize.
// However, the inputs may be non-contiguous? We assume contiguous for now; binding will ensure contiguous.
// We'll implement a generic kernel using dimension sizes and strides provided by launcher.
// For performance, handle common cases with separate kernels specialized for stack_dim=0,1,2.
// We'll provide three kernels and switch in launcher.

// Kernel for stacking along dim 0: output shape [2, d1, d2], inputs shape [d1, d2]
// For each output index i = 0 or 1, then copy the entire input tensor.
template <typename T>
__global__ void stack_dim0_kernel(T* out, const T* a, const T* b, int64_t d1, int64_t d2) {
    int64_t total_elements = 2 * d1 * d2;
    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
    int64_t stride = (int64_t)blockDim.x * gridDim.x;
    for (int64_t i = idx; i < total_elements; i += stride) {
        int64_t which = i / (d1 * d2);
        int64_t offset = i % (d1 * d2);
        if (which == 0) {
            out[i] = a[offset];
        } else {
            out[i] = b[offset];
        }
    }
}

// Kernel for stacking along dim 1: output shape [d0, 2, d2], inputs shape [d0, d2]
// For each output index i, decompose as (i0, i1, i2) where i1 in {0,1}.
template <typename T>
__global__ void stack_dim1_kernel(T* out, const T* a, const T* b, int64_t d0, int64_t d2) {
    int64_t total_elements = 2 * d0 * d2;
    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
    int64_t stride = (int64_t)blockDim.x * gridDim.x;
    for (int64_t i = idx; i < total_elements; i += stride) {
        // i = ((i0 * 2) + i1) * d2 + i2
        int64_t i2 = i % d2; // innermost dim
        int64_t rest = i / d2;
        int64_t i1 = rest % 2; // stack index
        int64_t i0 = rest / 2;
        int64_t src_idx = i0 * d2 + i2;
        if (i1 == 0) {
            out[i] = a[src_idx];
        } else {
            out[i] = b[src_idx];
        }
    }
}

// Kernel for stacking along dim 2: output shape [d0, d1, 2], inputs shape [d0, d1]
// For each output index i, decompose as (i0, i1, i2) where i2 in {0,1}.
template <typename T>
__global__ void stack_dim2_kernel(T* out, const T* a, const T* b, int64_t d0, int64_t d1) {
    int64_t total_elements = 2 * d0 * d1;
    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
    int64_t stride = (int64_t)blockDim.x * gridDim.x;
    for (int64_t i = idx; i < total_elements; i += stride) {
        // i = (i0 * d1 + i1) * 2 + i2
        int64_t i2 = i % 2;
        int64_t rest = i / 2;
        int64_t i1 = rest % d1;
        int64_t i0 = rest / d1;
        int64_t src_idx = i0 * d1 + i1;
        if (i2 == 0) {
            out[i] = a[src_idx];
        } else {
            out[i] = b[src_idx];
        }
    }
}

// Generic helper: launcher function with dimensions and stack_dim.
// We assume input tensors are 3D: shape [d0, d1, d2]. stack_dim can be 0,1,2.
// Output shape is [d0, d1, d2] with one extra dimension of size 2 at stack_dim, i.e., total elements = 2 * d0 * d1 * d2.
// We require that input elements are contiguous. Binding will ensure contiguous before calling.

extern "C" void stack_along_dim_float(
    float* out, const float* a, const float* b,
    int stack_dim, int64_t d0, int64_t d1, int64_t d2,
    cudaStream_t stream) {
    if (out == nullptr || a == nullptr || b == nullptr) return;
    int64_t total = 2 * d0 * d1 * d2;
    if (total == 0) return;
    const int threads = 256;
    int64_t blocks64 = (total + threads - 1) / threads;
    int blocks = (int)min(blocks64, (int64_t)65535);
    switch (stack_dim) {
        case 0:
            stack_dim0_kernel<float><<<blocks, threads, 0, stream>>>(out, a, b, d1, d2);
            break;
        case 1:
            stack_dim1_kernel<float><<<blocks, threads, 0, stream>>>(out, a, b, d0, d2);
            break;
        case 2:
            stack_dim2_kernel<float><<<blocks, threads, 0, stream>>>(out, a, b, d0, d1);
            break;
        default:
            // Should not happen.
            break;
    }
}

extern "C" void stack_along_dim_half(
    half* out, const half* a, const half* b,
    int stack_dim, int64_t d0, int64_t d1, int64_t d2,
    cudaStream_t stream) {
    if (out == nullptr || a == nullptr || b == nullptr) return;
    int64_t total = 2 * d0 * d1 * d2;
    if (total == 0) return;
    const int threads = 256;
    int64_t blocks64 = (total + threads - 1) / threads;
    int blocks = (int)min(blocks64, (int64_t)65535);
    switch (stack_dim) {
        case 0:
            stack_dim0_kernel<half><<<blocks, threads, 0, stream>>>(out, a, b, d1, d2);
            break;
        case 1:
            stack_dim1_kernel<half><<<blocks, threads, 0, stream>>>(out, a, b, d0, d2);
            break;
        case 2:
            stack_dim2_kernel<half><<<blocks, threads, 0, stream>>>(out, a, b, d0, d1);
            break;
        default:
            break;
    }
}

extern "C" void stack_along_dim_double(
    double* out, const double* a, const double* b,
    int stack_dim, int64_t d0, int64_t d1, int64_t d2,
    cudaStream_t stream) {
    if (out == nullptr || a == nullptr || b == nullptr) return;
    int64_t total = 2 * d0 * d1 * d2;
    if (total == 0) return;
    const int threads = 256;
    int64_t blocks64 = (total + threads - 1) / threads;
    int blocks = (int)min(blocks64, (int64_t)65535);
    switch (stack_dim) {
        case 0:
            stack_dim0_kernel<double><<<blocks, threads, 0, stream>>>(out, a, b, d1, d2);
            break;
        case 1:
            stack_dim1_kernel<double><<<blocks, threads, 0, stream>>>(out, a, b, d0, d2);
            break;
        case 2:
            stack_dim2_kernel<double><<<blocks, threads, 0, stream>>>(out, a, b, d0, d1);
            break;
        default:
            break;
    }
}
