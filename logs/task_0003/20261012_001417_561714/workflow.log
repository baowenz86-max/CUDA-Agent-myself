// Declare launchers from .cu
extern "C" void multiply_broadcast_float(float* out, const float* a, const float* b, int64_t total, cudaStream_t stream);
extern "C" void multiply_broadcast_half(__half* out, const __half* a, const __half* b, int64_t total, cudaStream_t stream);
extern "C" void multiply_broadcast_double(double* out, const double* a, const double* b, int64_t total, cudaStream_t stream);

static torch::Tensor multiply_broadcast_forward(torch::Tensor a, torch::Tensor b) {
    // Basic checks
    TORCH_CHECK(a.is_cuda(), "Input tensor 'a' must be a CUDA tensor");
    TORCH_CHECK(b.is_cuda(), "Input tensor 'b' must be a CUDA tensor");
    TORCH_CHECK(a.dtype() == b.dtype(), "Input tensors must have the same dtype");
    TORCH_CHECK(a.dim() == b.dim(), "Input tensors must have the same number of dimensions");

    // Ensure shapes are broadcast-compatible (same shape in our use case)
    TORCH_CHECK(a.sizes() == b.sizes(), "Input tensors must have the same shape");

    // Make tensors contiguous
    a = a.contiguous();
    b = b.contiguous();

    auto output = torch::empty_like(a);
    int64_t total = a.numel();

    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    if (a.dtype() == torch::kFloat32) {
        multiply_broadcast_float(
            output.data_ptr<float>(),
            a.data_ptr<float>(),
            b.data_ptr<float>(),
            total,
            stream
        );
    } else if (a.dtype() == torch::kFloat16) {
        multiply_broadcast_half(
            reinterpret_cast<__half*>(output.data_ptr<at::Half>()),
            reinterpret_cast<const __half*>(a.data_ptr<at::Half>()),
            reinterpret_cast<const __half*>(b.data_ptr<at::Half>()),
            total,
            stream
        );
    } else if (a.dtype() == torch::kFloat64) {
        multiply_broadcast_double(
            output.data_ptr<double>(),
            a.data_ptr<double>(),
            b.data_ptr<double>(),
            total,
            stream
        );
    } else {
        TORCH_CHECK(false, "Unsupported dtype for multiply_broadcast_forward. Supported: float32, float16, float64");
    }

    return output;
}

void register_multiply_broadcast(pybind11::module& m) {
    m.def("multiply_broadcast", &multiply_broadcast_forward,
          "Element-wise multiplication of two tensors with broadcasting (supports float32, float16, float64)");
}

REGISTER_BINDING(multiply_broadcast, register_multiply_broadcast);
===== kernels/stack_along_dim.cu =====
// Stack two tensors along a given dimension (0,1,2) efficiently.
// Since we know both tensors have same shape, we can simply copy data into output with offset.
// The output tensor shape differs from each input by an extra dimension of size 2 at stack_dim.
// Implementation: each thread computes its linear index in output, determines which input tensor and source index.
#include <cuda_runtime.h>
#include <cuda_fp16.h>
#include <cstdint>

// Kernel for stacking along dim 0: output shape [2, d1, d2], inputs shape [d1, d2]
// For each output index i = 0 or 1, then copy the entire input tensor.
template <typename T>
__global__ void stack_dim0_kernel(T* out, const T* a, const T* b, int64_t d1, int64_t d2) {
    int64_t total_elements = 2 * d1 * d2;
    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
    int64_t stride = (int64_t)blockDim.x * gridDim.x;
    for (int64_t i = idx; i < total_elements; i += stride) {
        int64_t which = i / (d1 * d2);
        int64_t offset = i % (d1 * d2);
        if (which == 0) {
            out[i] = a[offset];
        } else {
            out[i] = b[offset];
        }
    }
}

// Kernel for stacking along dim 1: output shape [d0, 2, d2], inputs shape [d0, d2]
// For each output index i, decompose as (i0, i1, i2) where i1 in {0,1}.
template <typename T>
__global__ void stack_dim1_kernel(T* out, const T* a, const T* b, int64_t d0, int64_t d2) {
    int64_t total_elements = 2 * d0 * d2;
    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
    int64_t stride = (int64_t)blockDim.x * gridDim.x;
    for (int64_t i = idx; i < total_elements; i += stride) {
        // i = ((i0 * 2) + i1) * d2 + i2
        int64_t i2 = i % d2; // innermost dim
        int64_t rest = i / d2;
        int64_t i1 = rest % 2; // stack index
        int64_t i0 = rest / 2;
        int64_t src_idx = i0 * d2 + i2;
        if (i1 == 0) {
            out[i] = a[src_idx];
        } else {
            out[i] = b[src_idx];
        }
    }
}

// Kernel for stacking along dim 2: output shape [d0, d1, 2], inputs shape [d0, d1]
// For each output index i, decompose as (i0, i1, i2) where i2 in {0,1}.
template <typename T>
__global__ void stack_dim2_kernel(T* out, const T* a, const T* b, int64_t d0, int64_t d1) {
    int64_t total_elements = 2 * d0 * d1;
    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
    int64_t stride = (int64_t)blockDim.x * gridDim.x;
    for (int64_t i = idx; i < total_elements; i += stride) {
        // i = (i0 * d1 + i1) * 2 + i2
        int64_t i2 = i % 2;
        int64_t rest = i / 2;
        int64_t i1 = rest % d1;
        int64_t i0 = rest / d1;
        int64_t src_idx = i0 * d1 + i1;
        if (i2 == 0) {
            out[i] = a[src_idx];
        } else {
            out[i] = b[src_idx];
        }
    }
}

// Generic helper: launcher function with dimensions and stack_dim.
// We assume input tensors are 3D: shape [d0, d1, d2]. stack_dim can be 0,1,2.
// Output shape is [d0, d1, d2] with one extra dimension of size 2 at stack_dim, i.e., total elements = 2 * d0 * d1 * d2.
// We require that input elements are contiguous. Binding will ensure contiguous before calling.

extern "C" void stack_along_dim_float(
    float* out, const float* a, const float* b,
    int stack_dim, int64_t d0, int64_t d1, int64_t d2,
    cudaStream_t stream) {
    if (out == nullptr || a == nullptr || b == nullptr) return;
    int64_t total = 2 * d0 * d1 * d2;
    if (total == 0) return;
    const int threads = 256;
    int64_t blocks64 = (total + threads - 1) / threads;
    int blocks = (int)min(blocks64, (int64_t)65535);
    switch (stack_dim) {
        case 0:
            stack_dim0_kernel<float><<<blocks, threads, 0, stream>>>(out, a, b, d1, d2);
            break;
        case 1:
            stack_dim1_kernel<float><<<blocks, threads, 0, stream>>>(out, a, b, d0, d2);
            break;
        case 2:
            stack_dim2_kernel<float><<<blocks, threads, 0, stream>>>(out, a, b, d0, d1);
            break;
        default:
            // Should not happen.
            break;
    }
}

extern "C" void stack_along_dim_half(
    __half* out, const __half* a, const __half* b,
    int stack_dim, int64_t d0, int64_t d1, int64_t d2,
    cudaStream_t stream) {
    if (out == nullptr || a == nullptr || b == nullptr) return;
    int64_t total = 2 * d0 * d1 * d2;
    if (total == 0) return;
    const int threads = 256;
    int64_t blocks64 = (total + threads - 1) / threads;
    int blocks = (int)min(blocks64, (int64_t)65535);
    switch (stack_dim) {
        case 0:
            stack_dim0_kernel<__half><<<blocks, threads, 0, stream>>>(out, a, b, d1, d2);
            break;
        case 1:
            stack_dim1_kernel<__half><<<blocks, threads, 0, stream>>>(out, a, b, d0, d2);
            break;
        case 2:
            stack_dim2_kernel<__half><<<blocks, threads, 0, stream>>>(out, a, b, d0, d1);
            break;
        default:
            break;
    }
}

extern "C" void stack_along_dim_double(
    double* out, const double* a, const double* b,
    int stack_dim, int64_t d0, int64_t d1, int64_t d2,
    cudaStream_t stream) {
    if (out == nullptr || a == nullptr || b == nullptr) return;
    int64_t total = 2 * d0 * d1 * d2;
    if (total == 0) return;
    const int threads = 256;
    int64_t blocks64 = (total + threads - 1) / threads;
    int blocks = (int)min(blocks64, (int64_t)65535);
    switch (stack_dim) {
        case 0:
            stack_dim0_kernel<double><<<blocks, threads, 0, stream>>>(out, a, b, d1, d2);
            break;
        case 1:
            stack_dim1_kernel<double><<<blocks, threads, 0, stream>>>(out, a, b, d0, d2);
            break;
        case 2:
            stack_dim2_kernel<double><<<blocks, threads, 0, stream>>>(out, a, b, d0, d1);
            break;
        default:
            break;
    }
}
