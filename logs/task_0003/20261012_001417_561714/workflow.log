       stream\n        );\n    } else if (a.dtype() == torch::kFloat64) {\n        multiply_broadcast_double(\n            output.data_ptr<double>(),\n            a.data_ptr<double>(),\n            b.data_ptr<double>(),\n            total,\n            stream\n        );\n    } else {\n        TORCH_CHECK(false, \"Unsupported dtype for multiply_broadcast_forward. Supported: float32, float16, float64\");\n    }\n\n    return output;\n}\n\nvoid register_multiply_broadcast(pybind11::module& m) {\n    m.def(\"multiply_broadcast\", &multiply_broadcast_forward,\n          \"Element-wise multiplication of two tensors with broadcasting (supports float32, float16, float64)\");\n}\n\nREGISTER_BINDING(multiply_broadcast, register_multiply_broadcast);\n",
    "kernels/stack_along_dim_binding.cpp": "#include <torch/types.h>\n#include <torch/csrc/utils/pybind.h>\n#include <cuda_runtime.h>\n#include <c10/cuda/CUDAStream.h>\n#include \"../binding_registry.h\"\n\n// Declare launchers from .cu\nextern \"C\" void stack_along_dim_float(float* out, const float* a, const float* b, int stack_dim, int64_t d0, int64_t d1, int64_t d2, cudaStream_t stream);\nextern \"C\" void stack_along_dim_half(half* out, const half* a, const half* b, int stack_dim, int64_t d0, int64_t d1, int64_t d2, cudaStream_t stream);\nextern \"C\" void stack_along_dim_double(double* out, const double* a, const double* b, int stack_dim, int64_t d0, int64_t d1, int64_t d2, cudaStream_t stream);\n\nstatic torch::Tensor stack_along_dim_forward(torch::Tensor a, torch::Tensor b, int64_t stack_dim) {\n    // Basic checks\n    TORCH_CHECK(a.is_cuda() && b.is_cuda(), \"Input tensors must be CUDA tensors\");\n    TORCH_CHECK(a.dtype() == b.dtype(), \"Input tensors must have the same dtype\");\n    TORCH_CHECK(a.dim() == b.dim(), \"Input tensors must have the same number of dimensions\");\n    TORCH_CHECK(a.sizes() == b.sizes(), \"Input tensors must have the same shape\");\n    TORCH_CHECK(a.dim() == 3, \"stack_along_dim only supports 3D tensors\");\n    TORCH_CHECK(stack_dim >= 0 && stack_dim <= 2, \"stack_dim must be in [0,2]\");\n\n    // Make tensors contiguous\n    a = a.contiguous();\n    b = b.contiguous();\n\n    int64_t d0 = a.size(0);\n    int64_t d1 = a.size(1);\n    int64_t d2 = a.size(2);\n\n    // Compute output shape: insert dimension of size 2 at stack_dim\n    std::vector<int64_t> out_sizes;\n    for (int64_t i = 0; i < 3; ++i) {\n        if (i == stack_dim) {\n            out_sizes.push_back(2);\n        }\n        out_sizes.push_back(a.size(i));\n    }\n\n    auto output = torch::empty(out_sizes, a.options());\n\n    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n\n    if (a.dtype() == torch::kFloat32) {\n        stack_along_dim_float(\n            output.data_ptr<float>(),\n            a.data_ptr<float>(),\n            b.data_ptr<float>(),\n            static_cast<int>(stack_dim),\n            d0, d1, d2,\n            stream\n        );\n    } else if (a.dtype() == torch::kFloat16) {\n        stack_along_dim_half(\n            reinterpret_cast<half*>(output.data_ptr<at::Half>()),\n            reinterpret_cast<const half*>(a.data_ptr<at::Half>()),\n            reinterpret_cast<const half*>(b.data_ptr<at::Half>()),\n            static_cast<int>(stack_dim),\n            d0, d1, d2,\n            stream\n        );\n    } else if (a.dtype() == torch::kFloat64) {\n        stack_along_dim_double(\n            output.data_ptr<double>(),\n            a.data_ptr<double>(),\n            b.data_ptr<double>(),\n            static_cast<int>(stack_dim),\n            d0, d1, d2,\n            stream\n        );\n    } else {\n        TORCH_CHECK(false, \"Unsupported dtype for stack_along_dim_forward. Supported: float32, float16, float64\");\n    }\n\n    return output;\n}\n\nvoid register_stack_along_dim(pybind11::module& m) {\n    m.def(\"stack_along_dim\", &stack_along_dim_forward,\n          \"Stack two 3D tensors along specified dimension (0,1,2)\");\n}\n\nREGISTER_BINDING(stack_along_dim, register_stack_along_dim);\n"
  }
}
