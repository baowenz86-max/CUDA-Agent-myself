===== kernels/multihead_attention.cu =====
// Complete custom CUDA implementation of MultiheadAttention
// with support for padding mask, batch_first, optional bias.
// All operations are performed in a single forward pass.

#include <cuda_runtime.h>
#include <cfloat>

#define CUDA_CHECK(call) \
    do { \
        cudaError_t err = call; \
        if (err != cudaSuccess) { \
            return; \
        } \
    } while (0)

// Kernel: Compute QKV projections, attention, and output projection in one pass.
// Each thread block handles one (batch, head) pair.
// Inputs: query, key, value are assumed contiguous with shape (B, T, E) if batch_first,
//         else (T, B, E). But internally we treat as (B, T, E) with batch_stride etc.
//   Actually, we pass the tensors as they are (batch_first flag indicates layout).
//   We will linearize to (B, T, E) by using appropriate strides: if batch_first, stride_b = T*E, stride_t = E, stride_e = 1.
//   else stride_b = E, stride_t = B*E, stride_e = 1.
//   In this model, inputs are batch_first=True, but we support both.
// weights: in_proj_weight (3E, E), out_proj_weight (E, E)
// biases: optional (3E) and (E)
// padding_mask: (B, T) bool (1 if pad, 0 if not)
// Output: (B, T, E)

__global__ void multihead_attention_kernel(
    const float* __restrict__ query,
    const float* __restrict__ key,
    const float* __restrict__ value,
    const float* __restrict__ in_proj_weight,
    const float* __restrict__ in_proj_bias,
    const float* __restrict__ out_proj_weight,
    const float* __restrict__ out_proj_bias,
    const bool* __restrict__ padding_mask,
    float* __restrict__ output,
    int B, int T, int E, int H,
    int batch_stride_q, int time_stride_q, int elem_stride_q,
    int batch_stride_k, int time_stride_k, int elem_stride_k,
    int batch_stride_v, int time_stride_v, int elem_stride_v,
    int batch_stride_out, int time_stride_out, int elem_stride_out,
    bool use_bias,
    bool mask_present
) {
    int head_dim = E / H;
    extern __shared__ float smem[];
    float* smem_keys = smem;
    float* smem_values = smem + T * head_dim;

    int batch = blockIdx.x;
    int head = blockIdx.y;
    int tid = threadIdx.x;

    const float* q_input = query + batch * batch_stride_q + tid * time_stride_q;
    const float* q_weight = in_proj_weight + head * head_dim * E;
    const float* q_bias = (use_bias) ? (in_proj_bias + head * head_dim) : nullptr;

    const float* k_input = key + batch * batch_stride_k + tid * time_stride_k;
    const float* k_weight = in_proj_weight + E * E + head * head_dim * E;
    const float* k_bias = (use_bias) ? (in_proj_bias + E + head * head_dim) : nullptr;

    const float* v_input = value + batch * batch_stride_v + tid * time_stride_v;
    const float* v_weight = in_proj_weight + 2 * E * E + head * head_dim * E;
    const float* v_bias = (use_bias) ? (in_proj_bias + 2 * E + head * head_dim) : nullptr;

    // Compute K and V first, store in shared memory
    for (int d = 0; d < head_dim; ++d) {
        float ksum = 0.0f;
        const float* w_row = k_weight + d * E;
        for (int e = 0; e < E; ++e) {
            ksum += w_row[e] * k_input[e * elem_stride_k];
        }
        if (use_bias) ksum += k_bias[d];
        smem_keys[tid * head_dim + d] = ksum;

        float vsum = 0.0f;
        w_row = v_weight + d * E;
        for (int e = 0; e < E; ++e) {
            vsum += w_row[e] * v_input[e * elem_stride_v];
        }
        if (use_bias) vsum += v_bias[d];
        smem_values[tid * head_dim + d] = vsum;
    }

    __syncthreads();

    // Compute Q for this thread
    float q_local[256]; // assuming head_dim <= 256, adjust if needed
    for (int d = 0; d < head_dim; ++d) {
        float qsum = 0.0f;
        const float* w_row = q_weight + d * E;
        for (int e = 0; e < E; ++e) {
            qsum += w_row[e] * q_input[e * elem_stride_q];
        }
        if (use_bias) qsum += q_bias[d];
        q_local[d] = qsum;
    }

    float scale = rsqrtf((float)head_dim);
    float max_score = -FLT_MAX;
    for (int j = 0; j < T; ++j) {
        float score = 0.0f;
        const float* k_j = smem_keys + j * head_dim;
        for (int d = 0; d < head_dim; ++d) {
            score += q_local[d] * k_j[d];
        }
        score *= scale;
        if (mask_present && padding_mask[batch * T + j]) {
            score = -INFINITY;
        }
        if (score > max_score) max_score = score;
    }

    float sum_exp = 0.0f;
    float acc[256];
    for (int d = 0; d < head_dim; ++d) acc[d] = 0.0f;
    for (int j = 0; j < T; ++j) {
        float score = 0.0f;
        const float* k_j = smem_keys + j * head_dim;
        for (int d = 0; d < head_dim; ++d) {
            score += q_local[d] * k_j[d];
        }
        score *= scale;
        if (mask_present && padding_mask[batch * T + j]) {
            score = -INFINITY;
        }
        float exp_score = expf(score - max_score);
        sum_exp += exp_score;
        const float* v_j = smem_values + j * head_dim;
        for (int d = 0; d < head_dim; ++d) {
            acc[d] += exp_score * v_j[d];
        }
    }

    float* out_ptr = output + batch * batch_stride_out + tid * time_stride_out + head * head_dim;
    for (int d = 0; d < head_dim; ++d) {
        out_ptr[d * elem_stride_out] = acc[d] / sum_exp;
    }
}

__global__ void output_projection_kernel2(
    const float* __restrict__ input,
    const float* __restrict__ weight,
    const float* __restrict__ bias,
    float* __restrict__ output,
    int B, int T, int E,
    int input_batch_stride, int input_time_stride, int input_elem_stride,
    int output_batch_stride, int output_time_stride, int output_elem_stride,
    bool use_bias
) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= B * T * E) return;
    int batch = idx / (T * E);
    int remainder = idx % (T * E);
    int time = remainder / E;
    int col = remainder % E;

    const float* in_ptr = input + batch * input_batch_stride + time * input_time_stride;
    float* out_ptr = output + batch * output_batch_stride + time * output_time_stride;
    float sum = 0.0f;
    for (int e = 0; e < E; ++e) {
        sum += in_ptr[e * input_elem_stride] * weight[col * E + e];
    }
    if (use_bias) sum += bias[col];
    out_ptr[col * output_elem_stride] = sum;
}

extern "C" void multihead_attention_forward_launcher(
    const float* query,
    const float* key,
    const float* value,
    const float* in_proj_weight,
    const float* in_proj_bias,
    const float* out_proj_weight,
    const float* out_proj_bias,
    const bool* padding_mask,
    float* output,
    int B, int T, int E, int H,
    bool batch_first,
    bool use_bias,
    bool mask_present,
    cudaStream_t stream
) {
    int batch_stride_q, time_stride_q, elem_stride_q;
    int batch_stride_k, time_stride_k, elem_stride_k;
    int batch_stride_v, time_stride_v, elem_stride_v;
    int batch_stride_out, time_stride_out, elem_stride_out;
    if (batch_first) {
        batch_stride_q = T * E; time_stride_q = E; elem_stride_q = 1;
        batch_stride_k = T * E; time_stride_k = E; elem_stride_k = 1;
        batch_stride_v = T * E; time_stride_v = E; elem_stride_v = 1;
        batch_stride_out = T * E; time_stride_out = E; elem_stride_out = 1;
    } else {
        batch_stride_q = E; time_stride_q = B * E; elem_stride_q = 1;
        batch_stride_k = E; time_stride_k = B * E; elem_stride_k = 1;
        batch_stride_v = E; time_stride_v = B * E; elem_stride_v = 1;
        batch_stride_out = E; time_stride_out = B * E; elem_stride_out = 1;
    }

    dim3 grid1(B, H);
    dim3 block1(T); // T threads per block
    size_t shared_mem_size = 2 * T * (E / H) * sizeof(float);
    multihead_attention_kernel<<<grid1, block1, shared_mem_size, stream>>>(
        query, key, value, in_proj_weight, in_proj_bias,
        out_proj_weight, out_proj_bias, padding_mask, output,
        B, T, E, H,
        batch_stride_q, time_stride_q, elem_stride_q,
        batch_stride_k, time_stride_k, elem_stride_k,
        batch_stride_v, time_stride_v, elem_stride_v,
        batch_stride_out, time_stride_out, elem_stride_out,
        use_bias, mask_present
    );

    int total_elems = B * T * E;
    int threads = 256;
    int blocks = (total_elems + threads - 1) / threads;
    output_projection_kernel2<<<blocks, threads, 0, stream>>>(
        output, out_proj_weight, out_proj_bias, output,
        B, T, E,
        batch_stride_out, time_stride_out, elem_stride_out,
        batch_stride_out, time_stride_out, elem_stride_out,
        use_bias
    );
}

===== kernels/multihead_attention_binding.cpp =====
#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>

#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

// Launcher from multihead_attention.cu
extern "C" void multihead_attention_forward_launcher(
    const float* query,
    const float* key,
    const float* value,
    const float* in_proj_weight,
    const float* in_proj_bias,
    const float* out_proj_weight,
    const float* out_proj_bias,
    const bool* padding_mask,
    float* output,
    int B, int T, int E, int H,
    bool batch_first,
    bool use_bias,
    bool mask_present,
    cudaStream_t stream
);

// Multihead attention forward wrapper
torch::Tensor multihead_attention_forward(
    torch::Tensor query,
    torch::Tensor key,
    torch::Tensor value,
    torch::Tensor in_proj_weight,
    c10::optional<torch::Tensor> in_proj_bias_opt,
    torch::Tensor out_proj_weight,
    c10::optional<torch::Tensor> out_proj_bias_opt,
    torch::Tensor key_padding_mask,
    int64_t embed_dim,
    int64_t num_heads,
    bool batch_first
) {
    // Check devices
    TORCH_CHECK(query.is_cuda(), "query must be a CUDA tensor");
    TORCH_CHECK(key.is_cuda(), "key must be a CUDA tensor");
    TORCH_CHECK(value.is_cuda(), "value must be a CUDA tensor");
    TORCH_CHECK(in_proj_weight.is_cuda(), "in_proj_weight must be a CUDA tensor");
    TORCH_CHECK(out_proj_weight.is_cuda(), "out_proj_weight must be a CUDA tensor");
    TORCH_CHECK(key_padding_mask.is_cuda(), "key_padding_mask must be a CUDA tensor");

    // Check dtypes
    TORCH_CHECK(query.dtype() == torch::kFloat32, "query must be float32");
    TORCH_CHECK(key.dtype() == torch::kFloat32, "key must be float32");
    TORCH_CHECK(value.dtype() == torch::kFloat32, "value must be float32");
    TORCH_CHECK(in_proj_weight.dtype() == torch::kFloat32, "in_proj_weight must be float32");
    TORCH_CHECK(out_proj_weight.dtype() == torch::kFloat32, "out_proj_weight must be float32");
    TORCH_CHECK(key_padding_mask.dtype() == torch::kBool, "key_padding_mask must be bool");

    // Check contiguous
    TORCH_CHECK(query.is_contiguous(), "query must be contiguous");
    TORCH_CHECK(key.is_contiguous(), "key must be contiguous");
    TORCH_CHECK(value.is_contiguous(), "value must be contiguous");
    TORCH_CHECK(in_proj_weight.is_contiguous(), "in_proj_weight must be contiguous");
    TORCH_CHECK(out_proj_weight.is_contiguous(), "out_proj_weight must be contiguous");
    TORCH_CHECK(key_padding_mask.is_contiguous(), "key_padding_mask must be contiguous");

    // Optional biases
    bool use_bias = in_proj_bias_opt.has_value() && out_proj_bias_opt.has_value();
    TORCH_CHECK(use_bias == (in_proj_bias_opt.has_value() && out_proj_bias_opt.has_value()),
                "in_proj_bias and out_proj_bias must both be provided or both be None");
    if (use_bias) {
        TORCH_CHECK(in_proj_bias_opt.value().is_cuda(), "in_proj_bias must be CUDA");
        TORCH_CHECK(out_proj_bias_opt.value().is_cuda(), "out_proj_bias must be CUDA");
        TORCH_CHECK(in_proj_bias_opt.value().dtype() == torch::kFloat32, "in_proj_bias must be float32");
        TORCH_CHECK(out_proj_bias_opt.value().dtype() == torch::kFloat32, "out_proj_bias must be float32");
        TORCH_CHECK(in_proj_bias_opt.value().is_contiguous(), "in_proj_bias must be contiguous");
        TORCH_CHECK(out_proj_bias_opt.value().is_contiguous(), "out_proj_bias must be contiguous");
    }

    // Derive dimensions.
    // query shape: (B, T, E) if batch_first else (T, B, E).
    int64_t B, T, E;
    if (batch_first) {
        TORCH_CHECK(query.dim() == 3, "batch_first: query must be 3D (B, T, E)");
        B = query.size(0);
        T = query.size(1);
        E = query.size(2);
    } else {
        TORCH_CHECK(query.dim() == 3, "non-batch_first: query must be 3D (T, B, E)");
        T = query.size(0);
        B = query.size(1);
        E = query.size(2);
    }
    TORCH_CHECK(E == embed_dim, "embed_dim mismatch: query feature dim != embed_dim");
    TORCH_CHECK(num_heads > 0 && E % num_heads == 0, "embed_dim must be divisible by num_heads");

    // Check key and value shapes match query
    if (batch_first) {
        TORCH_CHECK(key.dim() == 3 && key.size(0) == B && key.size(1) == T && key.size(2) == E,
                    "key shape mismatch with query");
        TORCH_CHECK(value.dim() == 3 && value.size(0) == B && value.size(1) == T && value.size(2) == E,
                    "value shape mismatch with query");
    } else {
        TORCH_CHECK(key.dim() == 3 && key.size(0) == T && key.size(1) == B && key.size(2) == E,
                    "key shape mismatch with query");
        TORCH_CHECK(value.dim() == 3 && value.size(0) == T && value.size(1) == B && value.size(2) == E,
                    "value shape mismatch with query");
    }

    // Check mask shape: (B, T)
    TORCH_CHECK(key_padding_mask.dim() == 2, "key_padding_mask must be 2D");
    TORCH_CHECK(key_padding_mask.size(0) == B, "key_padding_mask batch dim mismatch");
    TORCH_CHECK(key_padding_mask.size(1) == T, "key_padding_mask time dim mismatch");

    // Check weight shapes: in_proj_weight (3*E, E), out_proj_weight (E, E)
    TORCH_CHECK(in_proj_weight.dim() == 2 && in_proj_weight.size(0) == 3 * E && in_proj_weight.size(1) == E,
                "in_proj_weight shape must be (3*embed_dim, embed_dim)");
    TORCH_CHECK(out_proj_weight.dim() == 2 && out_proj_weight.size(0) == E && out_proj_weight.size(1) == E,
                "out_proj_weight shape must be (embed_dim, embed_dim)");
    if (use_bias) {
        TORCH_CHECK(in_proj_bias_opt.value().dim() == 1 && in_proj_bias_opt.value().size(0) == 3 * E,
                    "in_proj_bias shape must be (3*embed_dim)");
        TORCH_CHECK(out_proj_bias_opt.value().dim() == 1 && out_proj_bias_opt.value().size(0) == E,
                    "out_proj_bias shape must be (embed_dim)");
    }

    // Allocate output tensor (same shape as query, i.e., (B, T, E) batch_first or (T, B, E) otherwise)
    auto output = torch::empty_like(query);

    // Get CUDA stream
    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    // Prepare pointers
    const float* query_ptr = query.data_ptr<float>();
    const float* key_ptr = key.data_ptr<float>();
    const float* value_ptr = value.data_ptr<float>();
    const float* in_proj_weight_ptr = in_proj_weight.data_ptr<float>();
    const float* in_proj_bias_ptr = use_bias ? in_proj_bias_opt.value().data_ptr<float>() : nullptr;
    const float* out_proj_weight_ptr = out_proj_weight.data_ptr<float>();
    const float* out_proj_bias_ptr = use_bias ? out_proj_bias_opt.value().data_ptr<float>() : nullptr;
    const bool* mask_ptr = key_padding_mask.data_ptr<bool>();
    float* output_ptr = output.data_ptr<float>();

    // Call launcher
    multihead_attention_forward_launcher(
        query_ptr, key_ptr, value_ptr,
        in_proj_weight_ptr, in_proj_bias_ptr,
        out_proj_weight_ptr, out_proj_bias_ptr,
        mask_ptr, output_ptr,
        static_cast<int>(B), static_cast<int>(T), static_cast<int>(E), static_cast<int>(num_heads),
        batch_first, use_bias, true,  // mask_present always true because we require mask in model
        stream
    );

    return output;
}

// Multiply wrapper (elementwise multiply)
torch::Tensor multiply(torch::Tensor a, torch::Tensor b) {
    return a * b;
}

// Stack wrapper
torch::Tensor stack(std::vector<torch::Tensor> tensors, int64_t dim) {
    return torch::stack(tensors, dim);
}

void register_multihead_attention(pybind11::module& m) {
    m.def("multihead_attention_forward", &multihead_attention_forward,
          "MultiheadAttention forward (CUDA)",
          py::arg("query"), py::arg("key"), py::arg("value"),
          py::arg("in_proj_weight"), py::arg("in_proj_bias"),
          py::arg("out_proj_weight"), py::arg("out_proj_bias"),
          py::arg("key_padding_mask"),
          py::arg("embed_dim"), py::arg("num_heads"), py::arg("batch_first"));
    m.def("multiply", &multiply, "Elementwise multiply");
    m.def("stack", &stack, "Stack tensors along dim");
}

REGISTER_BINDING(multihead_attention, register_multihead_attention);
