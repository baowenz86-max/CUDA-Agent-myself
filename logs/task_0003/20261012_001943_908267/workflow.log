===== kernels/multihead_attention.cu =====
// Complete custom CUDA implementation of MultiheadAttention
// with support for padding mask, batch_first, optional bias.
// All operations are performed in a single forward pass.

#include <cuda_runtime.h>
#include <cfloat>

#define CUDA_CHECK(call) \
    do { \
        cudaError_t err = call; \
        if (err != cudaSuccess) { \
            return; \
        } \
    } while (0)

// Kernel: Compute QKV projections, attention, and output projection in one pass.
// Each thread block handles one (batch, head) pair.
// Inputs: query, key, value are assumed contiguous with shape (B, T, E) if batch_first,
//         else (T, B, E). But internally we treat as (B, T, E) with batch_stride etc.
//   Actually, we pass the tensors as they are (batch_first flag indicates layout).
//   We will linearize to (B, T, E) by using appropriate strides: if batch_first, stride_b = T*E, stride_t = E, stride_e = 1.
//   else stride_b = E, stride_t = B*E, stride_e = 1.
//   In this model, inputs are batch_first=True, but we support both.
// weights: in_proj_weight (3E, E), out_proj_weight (E, E)
// biases: optional (3E) and (E)
// padding_mask: (B, T) bool (1 if pad, 0 if not)
// Output: (B, T, E)
// We use blockIdx.z to index over batch, blockIdx.y over heads, blockIdx.x over time?
// Better: blockIdx.x -> batch, blockIdx.y -> head, blockIdx.z -> unused. But for 2D grid, use x for batch, y for head.
//   Grid: (num_batches, num_heads)
// Block size: threads per block, we will use about 256 threads.
// Determine time dimension chunk per block: We want each block to process one (batch, head) and all time steps.
// But time may be up to 64, so each thread can handle one time step: time threads = T (64).
// But we need to compute attention for all T positions, each position is a query.
// So we have T threads, each computes a query vector and then does softmax over T keys and computes output.
// Since T is small (64), this fits in one block.
// We'll use T threads, each handles one query position. We'll need shared memory for Q,K,V and scores.

// We'll have a block of T threads (or rounded up to power of 2? T=64, so 64 threads).
// Shared memory: Q[head_dim], K per thread? Actually, for softmax, we need all scores for a query across all keys.
// We can compute scores on the fly. Each thread (query position i) computes dot product with all key positions (loop over j).
// No need to store all keys in shared? But we need key projections. We can compute key projections per thread for its assigned time position and store in shared, then all threads read.
// Simpler: each thread computes Q_i, then computes scores with all K_j (j loop), and computes V_j weighted.
// To avoid recomputation, each thread can compute all K_j and V_j on the fly for each j? That would be expensive (each thread does T projections).
// Better: first, all threads compute Q_i, and also compute K_i, V_i and store in shared memory arrays.
// Shared memory needed: K (T * head_dim), V (T * head_dim), maybe Q_i stored in register.
// head_dim = E / num_heads. For E=512, heads=8, head_dim=64. So K array = 64*64 = 4096 floats, V same, total 8192 floats = 32KB. Q also could be stored but each thread has its own Q in register.
// This fits in shared memory (48KB).
// Then each thread iterates over j, compute score = dot(Q_i, K_j), apply masking, softmax, and accumulate output = sum(softmax_j * V_j).

// We'll implement this kernel.
// Launch parameters: grid = (B, H), block = (T, 1, 1) but T may be >1024? In this model T=64, but general support: if T > blockDim x, we need multiple blocks per time? We'll cap block size 1024 and use loop over time chunks for scores. But for simplicity, we'll require T <= 1024, which is true.
// We'll use block of T threads. However, if T is not a power of 2, it's okay.
// For coalescing global memory, we access inputs using strides. But since each thread i accesses query[i, ...], key[j, ...] for all j in loop, we may have uncoalesced access for key/value when loading from global? Actually, when loading K_j and V_j initially, we can coalesce because threads correspond to time dimension j, and each thread loads its own K_j and V_j. So that's coalesced. For query, each thread loads Q_i, also coalesced.
// Then computations in shared memory.

// We'll also support non-batch_first by adjusting strides.

// Precision: Use float32. For mask, we set score to -inf (or large negative) for padded positions.

__global__ void multihead_attention_kernel(
    const float* __restrict__ query,
    const float* __restrict__ key,
    const float* __restrict__ value,
    const float* __restrict__ in_proj_weight,
    const float* __restrict__ in_proj_bias,
    const float* __restrict__ out_proj_weight,
    const float* __restrict__ out_proj_bias,
    const bool* __restrict__ padding_mask,
    float* __restrict__ output,
    int B, int T, int E, int H,
    int batch_stride_q, int time_stride_q, int elem_stride_q,
    int batch_stride_k, int time_stride_k, int elem_stride_k,
    int batch_stride_v, int time_stride_v, int elem_stride_v,
    int batch_stride_out, int time_stride_out, int elem_stride_out,
    bool use_bias,
    bool mask_present
) {
    int head_dim = E / H;
    extern __shared__ float smem[];
    // Shared memory layout:
    // - Key projections: H * T * head_dim? Actually we only need for current head, so one head: T * head_dim.
    // - Value projections: T * head_dim.
    // Since each block handles one (batch, head), we only need that head's K and V.
    float* smem_keys = smem;                     // size T * head_dim
    float* smem_values = smem + T * head_dim;    // size T * head_dim

    int batch = blockIdx.x;
    int head = blockIdx.y;
    int tid = threadIdx.x; // time position 0..T-1

    // Compute Q_i for this thread's time position
    // Q_i = query[batch, tid, :] projected through Q weight (first head_dim rows for this head)
    // Actually, in PyTorch MultiheadAttention, the in_proj_weight is (3E, E) and is applied to query, key, value separately? 
    // No, it applies to concatenated [query, key, value]? Wait, PyTorch's MultiheadAttention uses 
    //   Q = F.linear(query, in_proj_weight[0:E], in_proj_bias[0:E])
    //   K = F.linear(key,   in_proj_weight[E:2E], in_proj_bias[E:2E])
    //   V = F.linear(value, in_proj_weight[2E:3E], in_proj_bias[2E:3E])
    // So each projection uses a slice of in_proj_weight.
    // Input dim E, output dim E (for each). Then reshaped to (B, T, H, head_dim) and transposed to (B, H, T, head_dim).
    // Our approach: each thread computes Q_i of shape (head_dim) for its head.
    // The projection weights for this head: rows [head*head_dim, (head+1)*head_dim) of the Q weight matrix.
    // But the Q weight matrix is in_proj_weight[0:E, :], shape (E, E). For head h, we need rows h*head_dim to (h+1)*head_dim-1.
    // So we can compute Q_i = W_q[head_slice] * query_vec + bias_q[head_slice]

    // We need to compute a matrix-vector product of size head_dim x E.
    // This is per thread. We'll loop over input dimension E.
    float q[head_dim]; // dynamic shared? Not allowed variable length array in CUDA? It's allowed if constant? head_dim is runtime, but we can use local array with fixed max size? Better use float q_local[128]; assume head_dim <= 128.
    // We'll allocate local arrays with maximum head_dim 256 for safety. Since E up to maybe 1024, head_dim may be >128. We'll use dynamic allocation? Or just use shared? But we'll manage with a fixed max.
    // For simplicity, we'll use local array with size 256 and assume head_dim <= 256. In your model head_dim=64.
    // Alternatively, avoid array and compute q in registers manually? We'll just use if (head_dim <= 256), else fallback not needed.
    // We'll add a compile-time constant MAX_HEAD_DIM = 256.
    float p_q[256];
    // Compute q_i
    const float* q_input = query + batch * batch_stride_q + tid * time_stride_q;
    // q_input points to start of vector of size E, but possibly with elem stride 1 (contiguous) but may have stride for generality? We'll assume elem_stride=1 for simplicity if contiguous, but we'll handle by reading q_input[elem_stride_q * j]
    // For weight matrix: q_weight_slice = in_proj_weight + head * head_dim * E + 0*E? Actually weight is row-major (3E, E),
    // Q weight rows start at row 0 + head*head_dim.
    const float* q_weight = in_proj_weight + head * head_dim * E; // rows: head*head_dim to head*head_dim+head_dim-1
    const float* q_bias = (use_bias) ? (in_proj_bias + head * head_dim) : nullptr;
    for (int d = 0; d < head_dim; ++d) {
        float sum = 0.0f;
        const float* w_row = q_weight + d * E; // row d
        for (int e = 0; e < E; ++e) {
            sum += w_row[e] * q_input[e * elem_stride_q];
        }
        if (use_bias) sum += q_bias[d];
        p_q[d] = sum;
    }

    // Compute K_j and V_j for this thread's time position, store in shared
    // K_j projection from key[batch, tid, :]
    const float* k_input = key + batch * batch_stride_k + tid * time_stride_k;
    const float* k_weight = in_proj_weight + E * E + head * head_dim * E; // offset for K section (E rows)
    const float* k_bias = (use_bias) ? (in_proj_bias + E + head * head_dim) : nullptr;
    for (int d = 0; d < head_dim; ++d) {
        float sum = 0.0f;
        const float* w_row = k_weight + d * E;
        for (int e = 0; e < E; ++e) {
            sum += w_row[e] * k_input[e * elem_stride_k];
        }
        if (use_bias) sum += k_bias[d];
        smem_keys[tid * head_dim + d] = sum;
    }

    // V_j projection from value[batch, tid, :]
    const float* v_input = value + batch * batch_stride_v + tid * time_stride_v;
    const float* v_weight = in_proj_weight + 2 * E * E + head * head_dim * E;
    const float* v_bias = (use_bias) ? (in_proj_bias + 2 * E + head * head_dim) : nullptr;
    for (int d = 0; d < head_dim; ++d) {
        float sum = 0.0f;
        const float* w_row = v_weight + d * E;
        for (int e = 0; e < E; ++e) {
            sum += w_row[e] * v_input[e * elem_stride_v];
        }
        if (use_bias) sum += v_bias[d];
        smem_values[tid * head_dim + d] = sum;
    }

    __syncthreads(); // make sure all K and V are in shared memory

    // Compute attention for this query position (tid)
    // scores_j = dot(q, K_j) / sqrt(head_dim)
    // apply mask if padding_mask[batch, j] == true: score = -inf
    // softmax: exp(score - max_score) / sum
    // output = sum(softmax_j * V_j)
    float q_vec[256];
    for (int d = 0; d < head_dim; ++d) q_vec[d] = p_q[d];

    float scale = rsqrtf((float)head_dim);
    float max_score = -FLT_MAX;
    // First pass: compute max score
    for (int j = 0; j < T; ++j) {
        float score = 0.0f;
        const float* k_j = smem_keys + j * head_dim;
        for (int d = 0; d < head_dim; ++d) {
            score += q_vec[d] * k_j[d];
        }
        score *= scale;
        if (mask_present && padding_mask[batch * T + j]) {
            score = -INFINITY; // or -1e30
        }
        if (score > max_score) max_score = score;
    }

    // Second pass: compute exp and sum, and accumulate output contributions
    float sum_exp = 0.0f;
    float acc[256];
    for (int d = 0; d < head_dim; ++d) acc[d] = 0.0f;
    for (int j = 0; j < T; ++j) {
        float score = 0.0f;
        const float* k_j = smem_keys + j * head_dim;
        for (int d = 0; d < head_dim; ++d) {
            score += q_vec[d] * k_j[d];
        }
        score *= scale;
        if (mask_present && padding_mask[batch * T + j]) {
            score = -INFINITY;
        }
        float exp_score = expf(score - max_score);
        sum_exp += exp_score;
        const float* v_j = smem_values + j * head_dim;
        for (int d = 0; d < head_dim; ++d) {
            acc[d] += exp_score * v_j[d];
        }
    }

    // Normalize by sum_exp
    for (int d = 0; d < head_dim; ++d) {
        acc[d] /= sum_exp;
    }

    // Now we have the attention output for this head and time position (tid).
    // Apply output projection: out = acc * out_proj_weight (E x E), but only for this head's slice?
    // Wait: In MultiheadAttention, after attention, we concatenate all heads and apply out_proj.
    // But in our kernel, each block handles one head independently, so we cannot directly apply out_proj because it mixes heads.
    // Correct approach: We must produce the per-head attention output (head_dim vector) and then after all heads are done, concatenate and apply out_proj.
    // That means we cannot fuse out_proj into the head block unless we coordinate across heads.
    // We need a separate step for out_proj, or we can have each block output to a temporary buffer, then a second kernel applies out_proj.
    // However, we can also use a grid where each block handles one batch and all heads? Too large.
    // Simpler: We output per-head results to a temporary tensor (B, H, T, head_dim), then launch a second kernel for out_proj.
    // But we can also combine: after computing acc, each thread writes its acc to output buffer in the correct location for its head.
    // Then we launch a separate kernel for out_proj (linear layer) that reads concatenated head outputs and applies out_proj_weight and bias.
    // This is acceptable. We'll implement two kernels: multihead_attention_core (project QKV, attention, write per-head output) and then a linear layer for output projection.
    // However, we can also incorporate out_proj into the same kernel if we allocate shared memory for all heads? Not feasible.
    // So we'll do: first kernel produces attn_out_per_head (B, H, T, head_dim), second kernel applies out_proj to get final (B, T, E).
    // But we need to allocate temporary buffer. In the launcher, we'll allocate with cudaMalloc, then free.
    // Alternatively, we can use the output tensor directly for per-head output (but its shape is (B,T,E), which is equivalent to (B,T,H,head_dim) contiguous if we interpret correctly).
    // So we can write acc to output[batch, tid, head*head_dim + d]. Since output shape is (B,T,E), and head dimension is contiguous within E, we can write directly.
    // Then the second kernel reads output and applies out_proj in-place? Better: second kernel reads from output (per-head) and writes to a new tensor (or same if we overwrite carefully).
    // In the launcher, we can allocate output tensor (B,T,E), first kernel writes per-head attention into it, then second kernel overwrites it with final projected output.
    // This works if we launch second kernel after first kernel completes (implicit synchronization on same stream).

    // So in this kernel, after normalization, store acc to output:
    float* out_ptr = output + batch * batch_stride_out + tid * time_stride_out + head * head_dim;
    // out_ptr points to start of head segment for this time position.
    for (int d = 0; d < head_dim; ++d) {
        out_ptr[d * elem_stride_out] = acc[d];
    }
}

// Second kernel: output projection (linear layer) on (B*T, E) matrix.
// We'll use a simple elementwise kernel where each thread computes one output element.
// Input: attn_out (B, T, E) with contiguous? We'll assume output is contiguous and we'll compute with strides.
// Weight: out_proj_weight (E, E), bias optional.
// Output: final_output (B, T, E). We'll use same layout as input.
// We'll launch grid over (B*T, E) or one thread per output element.
__global__ void output_projection_kernel(
    const float* __restrict__ input, // (B*T, E)
    const float* __restrict__ weight, // (E, E)
    const float* __restrict__ bias,
    float* __restrict__ output, // (B*T, E)
    int num_rows, int E,
    int input_batch_stride, int input_time_stride, int input_elem_stride,
    int output_batch_stride, int output_time_stride, int output_elem_stride,
    bool use_bias
) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= num_rows * E) return;
    int row = idx / E;
    int col = idx % E;

    // map row to (batch, time) based on strides
    // We need to reconstruct batch and time from row index if row-major with batch_stride, time_stride.
    // For simplicity, assume input is contiguous with batch stride T*E, time stride E, elem stride 1 (batch_first).
    // We'll just use linear index and compute using provided strides by passing separate batch and time? Actually we can compute batch = row / T, time = row % T if batch_first.
    // Since we have strides, we can compute the memory location directly:
    // We'll compute input pointer as input + batch * input_batch_stride + time * input_time_stride + col * input_elem_stride.
    // Need batch and time from row. We'll compute assuming batch_first: batch = row / T, time = row % T.
    // Wait, T is not passed. So better pass T as parameter.
    // We'll pass T to launcher.
    // So in this kernel we need T. Add int T parameter.
    // We'll adjust signature accordingly.
}

// We need to modify the second kernel signature to include T.
// But since this is inside the same file, we can define it properly.

// Safer: define both kernels and launcher below.

// Host launcher function for the full multihead attention.
// Signature: 
// void multihead_attention_forward(
//     const float* query, const float* key, const float* value,
//     const float* in_proj_weight, const float* in_proj_bias,
//     const float* out_proj_weight, const float* out_proj_bias,
//     const bool* padding_mask,
//     float* output,
//     int B, int T, int E, int H,
//     bool batch_first, bool use_bias, bool mask_present,
//     cudaStream_t stream)
// This is the function that will be called from binding.cpp.

// But we must be careful: output tensor is allocated outside, we assume it has correct shape (B,T,E).
// We'll write the first kernel output to output (per-head attention). Then second kernel overwrites output with projected result.
// Need a temporary buffer for the first kernel? We can use output directly because first kernel writes to exactly the same positions that second kernel will read. That's fine.
// No need for extra memory.

// We'll implement the second kernel properly, with T parameter.

// Corrected second kernel:
__global__ void output_projection_kernel2(
    const float* __restrict__ input,
    const float* __restrict__ weight,
    const float* __restrict__ bias,
    float* __restrict__ output,
    int B, int T, int E,
    int input_batch_stride, int input_time_stride, int input_elem_stride,
    int output_batch_stride, int output_time_stride, int output_elem_stride,
    bool use_bias
) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= B * T * E) return;
    int batch = idx / (T * E);
    int remainder = idx % (T * E);
    int time = remainder / E;
    int col = remainder % E;

    const float* in_ptr = input + batch * input_batch_stride + time * input_time_stride;
    float* out_ptr = output + batch * output_batch_stride + time * output_time_stride;
    float sum = 0.0f;
    for (int e = 0; e < E; ++e) {
        sum += in_ptr[e * input_elem_stride] * weight[col * E + e]; // weight is row-major (E,E), row = output col
    }
    if (use_bias) sum += bias[col];
    out_ptr[col * output_elem_stride] = sum;
}

// Now the launcher.
extern "C" void multihead_attention_forward_launcher(
    const float* query,
    const float* key,
    const float* value,
    const float* in_proj_weight,
    const float* in_proj_bias,
    const float* out_proj_weight,
    const float* out_proj_bias,
    const bool* padding_mask,
    float* output,
    int B, int T, int E, int H,
    bool batch_first,
    bool use_bias,
    bool mask_present,
    cudaStream_t stream
) {
    // Compute strides based on batch_first
    int batch_stride_q, time_stride_q, elem_stride_q;
    int batch_stride_k, time_stride_k, elem_stride_k;
    int batch_stride_v, time_stride_v, elem_stride_v;
    int batch_stride_out, time_stride_out, elem_stride_out;
    if (batch_first) {
        batch_stride_q = T * E; time_stride_q = E; elem_stride_q = 1;
        batch_stride_k = T * E; time_stride_k = E; elem_stride_k = 1;
        batch_stride_v = T * E; time_stride_v = E; elem_stride_v = 1;
        batch_stride_out = T * E; time_stride_out = E; elem_stride_out = 1;
    } else {
        batch_stride_q = E; time_stride_q = B * E; elem_stride_q = 1;
        batch_stride_k = E; time_stride_k = B * E; elem_stride_k = 1;
        batch_stride_v = E; time_stride_v = B * E; elem_stride_v = 1;
        batch_stride_out = E; time_stride_out = B * E; elem_stride_out = 1;
    }
    // For simplicity, we assume elem stride 1 (contiguous). If not, the binding should make contiguous.

    // Launch first kernel
    dim3 grid1(B, H);
    dim3 block1(T); // T threads per block
    // But if T > 1024, this would fail. For T=64 it's fine.
    // We can add a fallback for larger T: use block dimension 256 and loop. But we'll keep as is.
    size_t shared_mem_size = 2 * T * (E / H) * sizeof(float); // keys and values
    multihead_attention_kernel<<<grid1, block1, shared_mem_size, stream>>>(
        query, key, value, in_proj_weight, in_proj_bias,
        out_proj_weight, out_proj_bias, padding_mask, output,
        B, T, E, H,
        batch_stride_q, time_stride_q, elem_stride_q,
        batch_stride_k, time_stride_k, elem_stride_k,
        batch_stride_v, time_stride_v, elem_stride_v,
        batch_stride_out, time_stride_out, elem_stride_out,
        use_bias, mask_present
    );

    // Launch second kernel (output projection)
    int total_elems = B * T * E;
    int threads = 256;
    int blocks = (total_elems + threads - 1) / threads;
    output_projection_kernel2<<<blocks, threads, 0, stream>>>(
        output, // input = output from first kernel
        out_proj_weight,
        out_proj_bias,
        output, // output = same tensor (overwrite)
        B, T, E,
        batch_stride_out, time_stride_out, elem_stride_out,
        batch_stride_out, time_stride_out, elem_stride_out,
        use_bias
    );

    // Note: We assume that the first kernel has finished before the second starts, which is guaranteed by the same stream.
}

// Also need to handle the case where bias is nullptr but use_bias false; pass nullptr.
// The launcher signature includes pointers that may be nullptr; the kernel checks use_bias before accessing.

// Ensure no compilation errors: include cuda_runtime.h and math functions.
