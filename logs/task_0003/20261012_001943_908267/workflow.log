import torch
import torch.nn as nn


class Model(nn.Module):
    def __init__(self, embed_dim, num_heads, bias, batch_first, stack_dim):
        super().__init__()
        self.multihead_attn = nn.MultiheadAttention(embed_dim, num_heads, bias=bias, batch_first=batch_first)
        self.stack_dim = stack_dim

    def forward(self, x1, x2, x3, key_padding_mask):
        x1, _ = self.multihead_attn(x1, x2, x3, key_padding_mask=key_padding_mask)
        x4 = torch.multiply(x1, x2)
        return torch.stack((x3, x4), dim=self.stack_dim)


batch_size = 128
seq_len = 64  # Increased from 32 to increase computation
embed_dim = 512
num_heads = 8
stack_dim = 1


def get_inputs():
    x1 = torch.randn(batch_size, seq_len, embed_dim)
    x2 = torch.randn(batch_size, seq_len, embed_dim)
    x3 = torch.randn(batch_size, seq_len, embed_dim)
    key_padding_mask = torch.rand(batch_size, seq_len) > 0.5
    return [x1, x2, x3, key_padding_mask]


def get_init_inputs():
    return [embed_dim, num_heads, True, True, stack_dim]

===== model_new.py =====
import torch
import torch.nn as nn
import cuda_extension


class ModelNew(nn.Module):
    def __init__(self, embed_dim, num_heads, bias, batch_first, stack_dim):
        super().__init__()
        self.embed_dim = embed_dim
        self.num_heads = num_heads
        self.bias = bias
        self.batch_first = batch_first
        self.stack_dim = stack_dim

        # MultiheadAttention parameters: in_proj_weight, in_proj_bias, out_proj.weight, out_proj.bias
        self.in_proj_weight = nn.Parameter(torch.empty(3 * embed_dim, embed_dim))
        self.in_proj_bias = nn.Parameter(torch.empty(3 * embed_dim)) if bias else None
        self.out_proj_weight = nn.Parameter(torch.empty(embed_dim, embed_dim))
        self.out_proj_bias = nn.Parameter(torch.empty(embed_dim)) if bias else None

        # Initialize parameters following PyTorch's default initialization
        nn.init.xavier_uniform_(self.in_proj_weight)
        if self.in_proj_bias is not None:
            nn.init.constant_(self.in_proj_bias, 0.0)
        nn.init.xavier_uniform_(self.out_proj_weight)
        if self.out_proj_bias is not None:
            nn.init.constant_(self.out_proj_bias, 0.0)

    def forward(self, x1, x2, x3, key_padding_mask):
        """
        Args:
            x1: query, shape (batch_size, seq_len, embed_dim) if batch_first else (seq_len, batch_size, embed_dim)
            x2: key, same shape as x1
            x3: value, same shape as x1
            key_padding_mask: bool tensor, shape (batch_size, seq_len)
        Returns:
            output tensor with shape depending on stack_dim
        """
        # MultiheadAttention forward: 
        #   attn_output, attn_weights = multihead_attn(x1, x2, x3, key_padding_mask=key_padding_mask)
        # We only need attn_output (x1 after attention).
        # In this model, x1, x2, x3 all have the same shape and are contiguous.
        # We delegate the entire multihead attention to a custom CUDA op.
        attn_output = cuda_extension.multihead_attention_forward(
            x1, x2, x3,
            self.in_proj_weight, self.in_proj_bias,
            self.out_proj_weight, self.out_proj_bias,
            key_padding_mask,
            self.embed_dim,
            self.num_heads,
            self.batch_first
        )

        # elementwise multiply attention output with x2 (original key)
        x4 = cuda_extension.multiply(attn_output, x2)

        # stack x3 and x4 along stack_dim
        return cuda_extension.stack([x3, x4], dim=self.stack_dim)


