el<<<grid_size, block_size, 0, stream>>>(V, V, in_proj_bias + 2 * E, M, N);\n\n    // 4. Attention kernel\n    float scale = 1.0f / sqrtf((float)D);\n    int shared_mem_size = 2 * L * D * sizeof(float);\n    attention_kernel<64, 64><<<B * H, 64, shared_mem_size, stream>>>(\n        Q, K, V, key_padding_mask, attn_output, B, H, scale);\n\n    // 5. Output projection: attn_out = attn_output @ out_proj_weight^T, store in Q\n    cublasSgemm_v2(handle, CUBLAS_OP_T, CUBLAS_OP_N,\n                   N, M, Kdim, &alpha, out_proj_weight, E, attn_output, E, &beta, Q, E);\n\n    // Add output bias\n    add_bias_kernel<<<grid_size, block_size, 0, stream>>>(Q, Q, out_proj_bias, M, N);\n\n    // 6. Multiply and stack\n    grid_size = (M + block_size - 1) / block_size;\n    multiply_and_stack_kernel<<<grid_size, block_size, 0, stream>>>(\n        Q, x2, x3, output, B, L, E);\n}\n"
  }
}
