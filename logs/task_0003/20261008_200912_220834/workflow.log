===== kernels/fused_mha.cu =====
#include <cuda_runtime.h>
#include <cublas_v2.h>
#include <math_constants.h>

// Attention kernel with fused bias addition for Q, K, V
// Template parameters L and D are compile-time constants for optimization.
template<int L, int D>
__global__ void attention_kernel(
    const float* __restrict__ Q,
    const float* __restrict__ K,
    const float* __restrict__ V,
    const float* __restrict__ in_proj_bias, // size 3*E
    const bool* __restrict__ key_padding_mask,
    float* __restrict__ attn_output,
    int B, int H, float scale)
{
    extern __shared__ float shared_mem[];
    float* K_s = shared_mem;                 // L*D floats
    float* V_s = shared_mem + L*D;           // L*D floats

    int bid = blockIdx.x; // batch-head index: b*H + h
    int b = bid / H;
    int h = bid % H;

    int tid = threadIdx.x;
    int block_size = blockDim.x;

    // Offsets for biases
    const float* bias_q = in_proj_bias + h * D;           // Q bias for this head
    const float* bias_k = in_proj_bias + H * D + h * D;   // K bias for this head (E = H*D)
    const float* bias_v = in_proj_bias + 2 * H * D + h * D; // V bias for this head

    // Load K and V into shared memory with bias, using float4 vectorization
    const int vec_per_row = D / 4; // number of float4 per row, D must be multiple of 4
    const int total_vecs = L * vec_per_row;

    for (int i = tid; i < total_vecs; i += block_size) {
        int l = i / vec_per_row;
        int v = i % vec_per_row;

        const float4* K_ptr = reinterpret_cast<const float4*>(&K[((b * L + l) * H + h) * D]);
        const float4* V_ptr = reinterpret_cast<const float4*>(&V[((b * L + l) * H + h) * D]);

        float4 k_val = K_ptr[v];
        float4 v_val = V_ptr[v];

        // Add bias for K and V
        const float4* K_bias_ptr = reinterpret_cast<const float4*>(bias_k);
        const float4* V_bias_ptr = reinterpret_cast<const float4*>(bias_v);
        float4 k_bias = K_bias_ptr[v];
        float4 v_bias = V_bias_ptr[v];

        k_val.x += k_bias.x; k_val.y += k_bias.y; k_val.z += k_bias.z; k_val.w += k_bias.w;
        v_val.x += v_bias.x; v_val.y += v_bias.y; v_val.z += v_bias.z; v_val.w += v_bias.w;

        // Store to shared memory
        reinterpret_cast<float4*>(&K_s[l * D])[v] = k_val;
        reinterpret_cast<float4*>(&V_s[l * D])[v] = v_val;
    }
    __syncthreads();

    // Each thread processes one query position (tid < L)
    if (tid < L) {
        int q = tid;
        // Load query vector with bias
        float q_vec[D];
        const float4* Q_ptr = reinterpret_cast<const float4*>(&Q[((b * L + q) * H + h) * D]);
        const float4* Q_bias_ptr = reinterpret_cast<const float4*>(bias_q);
        #pragma unroll
        for (int v = 0; v < vec_per_row; ++v) {
            float4 q_val = Q_ptr[v];
            float4 q_bias = Q_bias_ptr[v];
            q_val.x += q_bias.x; q_val.y += q_bias.y; q_val.z += q_bias.z; q_val.w += q_bias.w;
            q_vec[4*v]   = q_val.x;
            q_vec[4*v+1] = q_val.y;
            q_vec[4*v+2] = q_val.z;
            q_vec[4*v+3] = q_val.w;
        }

        // Compute attention scores and softmax
        float scores[L];
        float max_score = -3.402823466e+38F;

        #pragma unroll
        for (int l = 0; l < L; ++l) {
            const float4* K_row = reinterpret_cast<const float4*>(&K_s[l * D]);
            float dot = 0.f;
            #pragma unroll
            for (int v = 0; v < vec_per_row; ++v) {
                float4 k_val = K_row[v];
                // manual dot product with q_vec
                dot += q_vec[4*v]   * k_val.x;
                dot += q_vec[4*v+1] * k_val.y;
                dot += q_vec[4*v+2] * k_val.z;
                dot += q_vec[4*v+3] * k_val.w;
            }
            dot *= scale;
            // Apply key padding mask (True means ignore)
            if (key_padding_mask[b * L + l]) {
                dot = -3.402823466e+38F;
            }
            scores[l] = dot;
            max_score = fmaxf(max_score, dot);
        }

        // Softmax denominator and numerator
        float sum_exp = 0.f;
        if (max_score == -3.402823466e+38F) {
            // All keys are masked, output zeros
            #pragma unroll
            for (int d = 0; d < D; ++d) {
                attn_output[((b * L + q) * H + h) * D + d] = 0.f;
            }
            return;
        }
        #pragma unroll
        for (int l = 0; l < L; ++l) {
            float e = expf(scores[l] - max_score);
            scores[l] = e;
            sum_exp += e;
        }
        float inv_sum = 1.f / sum_exp;

        // Compute weighted sum over values
        float out_vec[D];
        #pragma unroll
        for (int d = 0; d < D; ++d) {
            out_vec[d] = 0.f;
        }
        #pragma unroll
        for (int l = 0; l < L; ++l) {
            float w = scores[l] * inv_sum;
            const float4* V_row = reinterpret_cast<const float4*>(&V_s[l * D]);
            #pragma unroll
            for (int v = 0; v < vec_per_row; ++v) {
                float4 v_val = V_row[v];
                out_vec[4*v]   += w * v_val.x;
                out_vec[4*v+1] += w * v_val.y;
                out_vec[4*v+2] += w * v_val.z;
                out_vec[4*v+3] += w * v_val.w;
            }
        }

        // Store output (no bias needed here)
        float4* out_ptr = reinterpret_cast<float4*>(&attn_output[((b * L + q) * H + h) * D]);
        #pragma unroll
        for (int v = 0; v < vec_per_row; ++v) {
            float4 val;
            val.x = out_vec[4*v];
            val.y = out_vec[4*v+1];
            val.z = out_vec[4*v+2];
            val.w = out_vec[4*v+3];
            out_ptr[v] = val;
        }
    }
}

// Multiply and stack kernel with fused out_proj bias addition
__global__ void multiply_and_stack_kernel(
    const float* __restrict__ attn_out,   // out_proj result (no bias)
    const float* __restrict__ out_proj_bias,
    const float* __restrict__ x2,
    const float* __restrict__ x3,
    float* __restrict__ output,
    int B, int L, int E)
{
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx < B * L * E) {
        int b = idx / (L * E);
        int rem = idx % (L * E);
        int l = rem / E;
        int e = rem % E;

        float attn_val = attn_out[idx] + out_proj_bias[e];
        float x4_val = attn_val * x2[idx];

        // output shape (B, 2, L, E) for stack_dim=1
        int base = ((b * 2 + 0) * L + l) * E + e;
        output[base] = x3[idx];
        output[base + L * E] = x4_val;
    }
}

// Launcher function
extern "C" void fused_mha_forward_launcher(
    const float* x1,
    const float* x2,
    const float* x3,
    const bool* key_padding_mask,
    const float* in_proj_weight,
    const float* in_proj_bias,
    const float* out_proj_weight,
    const float* out_proj_bias,
    float* Q,
    float* K,
    float* V,
    float* attn_output,
    float* output,
    int B,
    int L,
    int E,
    int H,
    int D,
    int stack_dim,
    cudaStream_t stream)
{
    // Handle cuBLAS
    static cublasHandle_t handle = nullptr;
    if (handle == nullptr) {
        cublasCreate(&handle);
        // Enable Tensor Cores with TF32 for FP32 GEMM (Ampere+)
        cublasSetMathMode(handle, CUBLAS_TF32_TENSOR_OP_MATH);
    }
    cublasSetStream(handle, stream);

    const float alpha = 1.0f;
    const float beta = 0.0f;

    int M = B * L;   // rows
    int N = E;       // cols
    int Kdim = E;    // inner dim

    // Pointers to slices of in_proj_weight (E, E) row-major
    const float* Wq = in_proj_weight;
    const float* Wk = in_proj_weight + E * E;
    const float* Wv = in_proj_weight + 2 * E * E;

    // 1. Compute Q = x1 @ Wq^T
    cublasSgemm_v2(handle, CUBLAS_OP_N, CUBLAS_OP_T,
                   M, N, Kdim, &alpha, x1, Kdim, Wq, Kdim, &beta, Q, N);

    // 2. Compute K = x2 @ Wk^T
    cublasSgemm_v2(handle, CUBLAS_OP_N, CUBLAS_OP_T,
                   M, N, Kdim, &alpha, x2, Kdim, Wk, Kdim, &beta, K, N);

    // 3. Compute V = x3 @ Wv^T
    cublasSgemm_v2(handle, CUBLAS_OP_N, CUBLAS_OP_T,
                   M, N, Kdim, &alpha, x3, Kdim, Wv, Kdim, &beta, V, N);

    // 4. Attention kernel (includes bias addition for Q, K, V)
    float scale = 1.0f / sqrtf((float)D);
    int shared_mem_size = 2 * L * D * sizeof(float);
    // Use L threads per block (L=64). Ensure block size matches L.
    attention_kernel<64, 64><<<B * H, L, shared_mem_size, stream>>>(
        Q, K, V, in_proj_bias, key_padding_mask, attn_output, B, H, scale);

    // 5. Output projection: out_proj_result = attn_output @ out_proj_weight^T (no bias)
    cublasSgemm_v2(handle, CUBLAS_OP_N, CUBLAS_OP_T,
                   M, N, Kdim, &alpha, attn_output, Kdim, out_proj_weight, Kdim, &beta, Q, N);

    // 6. Multiply and stack (also adds out_proj bias)
    int block_size = 256;
    int grid_size = (M * E + block_size - 1) / block_size;
    multiply_and_stack_kernel<<<grid_size, block_size, 0, stream>>>(
        Q, out_proj_bias, x2, x3, output, B, L, E);
}

===== kernels/fused_mha_binding.cpp =====
#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>
#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

// Declare launcher
extern "C" void fused_mha_forward_launcher(
    const float* x1,
    const float* x2,
    const float* x3,
    const bool* key_padding_mask,
    const float* in_proj_weight,
    const float* in_proj_bias,
    const float* out_proj_weight,
    const float* out_proj_bias,
    float* Q,
    float* K,
    float* V,
    float* attn_output,
    float* output,
    int B,
    int L,
    int E,
    int H,
    int D,
    int stack_dim,
    cudaStream_t stream);

torch::Tensor fused_mha_forward(
    torch::Tensor x1,
    torch::Tensor x2,
    torch::Tensor x3,
    torch::Tensor key_padding_mask,
    torch::Tensor in_proj_weight,
    torch::Tensor in_proj_bias,
    torch::Tensor out_proj_weight,
    torch::Tensor out_proj_bias,
    int64_t num_heads,
    int64_t stack_dim)
{
    TORCH_CHECK(x1.is_cuda(), "x1 must be CUDA");
    TORCH_CHECK(x2.is_cuda(), "x2 must be CUDA");
    TORCH_CHECK(x3.is_cuda(), "x3 must be CUDA");
    TORCH_CHECK(key_padding_mask.is_cuda(), "mask must be CUDA");
    TORCH_CHECK(in_proj_weight.is_cuda(), "in_proj_weight must be CUDA");
    TORCH_CHECK(in_proj_bias.is_cuda(), "in_proj_bias must be CUDA");
    TORCH_CHECK(out_proj_weight.is_cuda(), "out_proj_weight must be CUDA");
    TORCH_CHECK(out_proj_bias.is_cuda(), "out_proj_bias must be CUDA");

    TORCH_CHECK(x1.is_contiguous(), "x1 must be contiguous");
    TORCH_CHECK(x2.is_contiguous(), "x2 must be contiguous");
    TORCH_CHECK(x3.is_contiguous(), "x3 must be contiguous");
    TORCH_CHECK(key_padding_mask.is_contiguous(), "mask must be contiguous");
    TORCH_CHECK(in_proj_weight.is_contiguous(), "in_proj_weight must be contiguous");
    TORCH_CHECK(in_proj_bias.is_contiguous(), "in_proj_bias must be contiguous");
    TORCH_CHECK(out_proj_weight.is_contiguous(), "out_proj_weight must be contiguous");
    TORCH_CHECK(out_proj_bias.is_contiguous(), "out_proj_bias must be contiguous");

    TORCH_CHECK(x1.dtype() == torch::kFloat32, "x1 must be float32");
    TORCH_CHECK(x2.dtype() == torch::kFloat32, "x2 must be float32");
    TORCH_CHECK(x3.dtype() == torch::kFloat32, "x3 must be float32");
    TORCH_CHECK(key_padding_mask.dtype() == torch::kBool, "mask must be bool");
    TORCH_CHECK(in_proj_weight.dtype() == torch::kFloat32, "in_proj_weight must be float32");
    TORCH_CHECK(in_proj_bias.dtype() == torch::kFloat32, "in_proj_bias must be float32");
    TORCH_CHECK(out_proj_weight.dtype() == torch::kFloat32, "out_proj_weight must be float32");
    TORCH_CHECK(out_proj_bias.dtype() == torch::kFloat32, "out_proj_bias must be float32");

    TORCH_CHECK(stack_dim == 1, "Only stack_dim=1 is supported");

    int B = static_cast<int>(x1.size(0));
    int L = static_cast<int>(x1.size(1));
    int E = static_cast<int>(x1.size(2));
    int H = static_cast<int>(num_heads);
    TORCH_CHECK(E % H == 0, "embed_dim must be divisible by num_heads");
    int D = E / H;
    TORCH_CHECK(L == 64 && D == 64, "Only L=64 and D=64 supported for now");

    auto options = x1.options();
    auto Q = torch::empty({B, L, E}, options);
    auto K = torch::empty({B, L, E}, options);
    auto V = torch::empty({B, L, E}, options);
    auto attn_output = torch::empty({B, L, E}, options);
    auto output = torch::empty({B, 2, L, E}, options);

    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    fused_mha_forward_launcher(
        x1.data_ptr<float>(),
