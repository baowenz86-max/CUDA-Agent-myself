===== kernels/fused_mha.cu =====
#include <cuda_runtime.h>
#include <cublas_v2.h>
#include <math_constants.h>

// Bias add kernel
__global__ void add_bias_kernel(float* out, const float* in, const float* bias, int rows, int cols) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx < rows * cols) {
        int col = idx % cols;
        out[idx] = in[idx] + bias[col];
    }
}

// Attention kernel (fused scaled dot-product attention)
template<int L, int D>
__global__ void attention_kernel(
    const float* __restrict__ Q,
    const float* __restrict__ K,
    const float* __restrict__ V,
    const bool* __restrict__ key_padding_mask,
    float* __restrict__ attn_output,
    int B, int H, float scale)
{
    extern __shared__ float shared_mem[];
    float* K_s = shared_mem;                 // size L*D
    float* V_s = shared_mem + L*D;           // size L*D

    int bid = blockIdx.x; // 0..B*H-1
    int b = bid / H;
    int h = bid % H;

    int tid = threadIdx.x;
    int block_size = blockDim.x;

    // Load K and V into shared memory
    for (int idx = tid; idx < L*D; idx += block_size) {
        int l = idx / D;
        int d = idx % D;
        K_s[idx] = K[((b*L + l)*H + h)*D + d];
        V_s[idx] = V[((b*L + l)*H + h)*D + d];
    }
    __syncthreads();

    // Each thread processes one query position if tid < L
    if (tid < L) {
        int q = tid;
        // Load query vector into registers
        float q_vec[D];
        #pragma unroll
        for (int d = 0; d < D; ++d) {
            q_vec[d] = Q[((b*L + q)*H + h)*D + d];
        }

        float scores[L];
        float max_score = -3.402823466e+38F;
        #pragma unroll
        for (int l = 0; l < L; ++l) {
            float dot = 0.f;
            #pragma unroll
            for (int d = 0; d < D; ++d) {
                dot += q_vec[d] * K_s[l*D + d];
            }
            dot *= scale;
            // Apply key padding mask
            if (key_padding_mask[b*L + l]) {
                dot = -3.402823466e+38F;
            }
            scores[l] = dot;
            max_score = fmaxf(max_score, dot);
        }

        // Softmax
        float sum_exp = 0.f;
        if (max_score == -3.402823466e+38F) {
            // All keys are masked, output zeros
            #pragma unroll
            for (int d = 0; d < D; ++d) {
                attn_output[((b*L + q)*H + h)*D + d] = 0.f;
            }
            return;
        }
        #pragma unroll
        for (int l = 0; l < L; ++l) {
            float e = expf(scores[l] - max_score);
            scores[l] = e;
            sum_exp += e;
        }
        float inv_sum = 1.f / sum_exp;

        // Compute weighted sum over values
        float out_vec[D];
        #pragma unroll
        for (int d = 0; d < D; ++d) {
            out_vec[d] = 0.f;
        }
        #pragma unroll
        for (int l = 0; l < L; ++l) {
            float w = scores[l] * inv_sum;
            #pragma unroll
            for (int d = 0; d < D; ++d) {
                out_vec[d] += w * V_s[l*D + d];
            }
        }

        // Store output
        #pragma unroll
        for (int d = 0; d < D; ++d) {
            attn_output[((b*L + q)*H + h)*D + d] = out_vec[d];
        }
    }
}

// Multiply and stack kernel
__global__ void multiply_and_stack_kernel(
    const float* __restrict__ attn_out,
    const float* __restrict__ x2,
    const float* __restrict__ x3,
    float* __restrict__ output,
    int B, int L, int E)
{
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx < B * L * E) {
        int b = idx / (L * E);
        int rem = idx % (L * E);
        int l = rem / E;
        int e = rem % E;

        // output shape (B, 2, L, E) for stack_dim=1
        int base = ((b * 2 + 0) * L + l) * E + e;
        output[base] = x3[idx];
        output[base + L * E] = attn_out[idx] * x2[idx];
    }
}

// Launcher function
extern "C" void fused_mha_forward_launcher(
    const float* x1,
    const float* x2,
    const float* x3,
    const bool* key_padding_mask,
    const float* in_proj_weight,
    const float* in_proj_bias,
    const float* out_proj_weight,
    const float* out_proj_bias,
    float* Q,
    float* K,
    float* V,
    float* attn_output,
    float* output,
    int B,
    int L,
    int E,
    int H,
    int D,
    int stack_dim,
    cudaStream_t stream)
{
    // Handle cuBLAS
    static cublasHandle_t handle = nullptr;
    if (handle == nullptr) {
        cublasCreate(&handle);
    }
    cublasSetStream(handle, stream);

    const float alpha = 1.0f;
    const float beta = 0.0f;

    int M = B * L;  // rows for GEMM
    int N = E;      // cols for GEMM
    int Kdim = E;   // common dim

    // Pointers to slices of in_proj_weight
    const float* Wq = in_proj_weight;                  // (E, E) row-major
    const float* Wk = in_proj_weight + E * E;          // (E, E)
    const float* Wv = in_proj_weight + 2 * E * E;      // (E, E)

    // 1. Compute Q = x1 @ Wq^T
    cublasSgemm_v2(handle, CUBLAS_OP_N, CUBLAS_OP_N,
                   N, M, Kdim, &alpha, Wq, N, x1, Kdim, &beta, Q, N);

    // 2. Compute K = x2 @ Wk^T
    cublasSgemm_v2(handle, CUBLAS_OP_N, CUBLAS_OP_N,
                   N, M, Kdim, &alpha, Wk, N, x2, Kdim, &beta, K, N);

    // 3. Compute V = x3 @ Wv^T
    cublasSgemm_v2(handle, CUBLAS_OP_N, CUBLAS_OP_N,
                   N, M, Kdim, &alpha, Wv, N, x3, Kdim, &beta, V, N);

    // Add biases to Q, K, V
    int total_elements = M * N;
    int block_size = 256;
    int grid_size = (total_elements + block_size - 1) / block_size;
    add_bias_kernel<<<grid_size, block_size, 0, stream>>>(Q, Q, in_proj_bias, M, N);
    add_bias_kernel<<<grid_size, block_size, 0, stream>>>(K, K, in_proj_bias + E, M, N);
    add_bias_kernel<<<grid_size, block_size, 0, stream>>>(V, V, in_proj_bias + 2 * E, M, N);

    // 4. Attention kernel
    float scale = 1.0f / sqrtf((float)D);
    int shared_mem_size = 2 * L * D * sizeof(float);
    attention_kernel<64, 64><<<B * H, 64, shared_mem_size, stream>>>(
        Q, K, V, key_padding_mask, attn_output, B, H, scale);

    // 5. Output projection: attn_out = attn_output @ out_proj_weight^T, store in Q
    cublasSgemm_v2(handle, CUBLAS_OP_N, CUBLAS_OP_N,
                   N, M, Kdim, &alpha, out_proj_weight, N, attn_output, Kdim, &beta, Q, N);

    // Add output bias
    add_bias_kernel<<<grid_size, block_size, 0, stream>>>(Q, Q, out_proj_bias, M, N);

    // 6. Multiply and stack
    grid_size = (M + block_size - 1) / block_size;
    multiply_and_stack_kernel<<<grid_size, block_size, 0, stream>>>(
        Q, x2, x3, output, B, L, E);
}

===== kernels/fused_mha_binding.cpp =====
#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>
#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

// Declare launcher
extern "C" void fused_mha_forward_launcher(
    const float* x1,
    const float* x2,
    const float* x3,
    const bool* key_padding_mask,
    const float* in_proj_weight,
    const float* in_proj_bias,
    const float* out_proj_weight,
    const float* out_proj_bias,
    float* Q,
    float* K,
    float* V,
    float* attn_output,
    float* output,
    int B,
    int L,
    int E,
    int H,
    int D,
    int stack_dim,
    cudaStream_t stream);

torch::Tensor fused_mha_forward(
    torch::Tensor x1,
    torch::Tensor x2,
    torch::Tensor x3,
    torch::Tensor key_padding_mask,
    torch::Tensor in_proj_weight,
    torch::Tensor in_proj_bias,
    torch::Tensor out_proj_weight,
    torch::Tensor out_proj_bias,
    int64_t num_heads,
    int64_t stack_dim)
{
    TORCH_CHECK(x1.is_cuda(), "x1 must be CUDA");
    TORCH_CHECK(x2.is_cuda(), "x2 must be CUDA");
    TORCH_CHECK(x3.is_cuda(), "x3 must be CUDA");
    TORCH_CHECK(key_padding_mask.is_cuda(), "mask must be CUDA");
    TORCH_CHECK(in_proj_weight.is_cuda(), "in_proj_weight must be CUDA");
    TORCH_CHECK(in_proj_bias.is_cuda(), "in_proj_bias must be CUDA");
    TORCH_CHECK(out_proj_weight.is_cuda(), "out_proj_weight must be CUDA");
    TORCH_CHECK(out_proj_bias.is_cuda(), "out_proj_bias must be CUDA");

    TORCH_CHECK(x1.is_contiguous(), "x1 must be contiguous");
    TORCH_CHECK(x2.is_contiguous(), "x2 must be contiguous");
    TORCH_CHECK(x3.is_contiguous(), "x3 must be contiguous");
    TORCH_CHECK(key_padding_mask.is_contiguous(), "mask must be contiguous");
    TORCH_CHECK(in_proj_weight.is_contiguous(), "in_proj_weight must be contiguous");
    TORCH_CHECK(in_proj_bias.is_contiguous(), "in_proj_bias must be contiguous");
    TORCH_CHECK(out_proj_weight.is_contiguous(), "out_proj_weight must be contiguous");
    TORCH_CHECK(out_proj_bias.is_contiguous(), "out_proj_bias must be contiguous");

    TORCH_CHECK(x1.dtype() == torch::kFloat32, "x1 must be float32");
    TORCH_CHECK(x2.dtype() == torch::kFloat32, "x2 must be float32");
    TORCH_CHECK(x3.dtype() == torch::kFloat32, "x3 must be float32");
    TORCH_CHECK(key_padding_mask.dtype() == torch::kBool, "mask must be bool");
    TORCH_CHECK(in_proj_weight.dtype() == torch::kFloat32, "in_proj_weight must be float32");
    TORCH_CHECK(in_proj_bias.dtype() == torch::kFloat32, "in_proj_bias must be float32");
    TORCH_CHECK(out_proj_weight.dtype() == torch::kFloat32, "out_proj_weight must be float32");
    TORCH_CHECK(out_proj_bias.dtype() == torch::kFloat32, "out_proj_bias must be float32");

    TORCH_CHECK(stack_dim == 1, "Only stack_dim=1 is supported");

    int B = static_cast<int>(x1.size(0));
    int L = static_cast<int>(x1.size(1));
    int E = static_cast<int>(x1.size(2));
    int H = static_cast<int>(num_heads);
    TORCH_CHECK(E % H == 0, "embed_dim must be divisible by num_heads");
    int D = E / H;
    TORCH_CHECK(L == 64 && D == 64, "Only L=64 and D=64 supported for now");

    auto options = x1.options();
    auto Q = torch::empty({B, L, E}, options);
    auto K = torch::empty({B, L, E}, options);
    auto V = torch::empty({B, L, E}, options);
    auto attn_output = torch::empty({B, L, E}, options);
    auto output = torch::empty({B, 2, L, E}, options);

    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    fused_mha_forward_launcher(
        x1.data_ptr<float>(),
        x2.data_ptr<float>(),
        x3.data_ptr<float>(),
        key_padding_mask.data_ptr<bool>(),
        in_proj_weight.data_ptr<float>(),
        in_proj_bias.data_ptr<float>(),
        out_proj_weight.data_ptr<float>(),
        out_proj_bias.data_ptr<float>(),
        Q.data_ptr<float>(),
        K.data_ptr<float>(),
        V.data_ptr<float>(),
        attn_output.data_ptr<float>(),
        output.data_ptr<float>(),
        B, L, E, H, D, static_cast<int>(stack_dim),
        stream
    );

    return output;
}

void register_fused_mha(pybind11::module& m) {
    m.def("fused_mha_forward", &fused_mha_forward,
          "Fused MultiheadAttention forward with multiply and stack",
          py::arg("x1"),
          py::arg("x2"),
          py::arg("x3"),
          py::arg("key_padding_mask"),
          py::arg("in_proj_weight"),
          py::arg("in_proj_bias"),
          py::arg("out_proj_weight"),
          py::arg("out_proj_bias"),
          py::arg("num_heads"),
          py::arg("stack_dim"));
}

REGISTER_BINDING(fused_mha, register_fused_mha);
