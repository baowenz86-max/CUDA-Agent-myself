===== kernels/mha_forward.cu =====
#include <cuda_runtime.h>
#include <cublas_v2.h>
#include <cmath>
#include <cfloat>
#include <cstdint>

__global__ void bias_add_kernel(float* out, const float* bias, int rows, int cols) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int total = rows * cols;
    if (idx >= total) return;
    int col = idx % cols;
    out[idx] += bias[col];
}

__global__ void split_qkv_kernel(const float* qkv, float* q, float* k, float* v,
                                 int B, int S, int H, int D) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int total = B * S * H * D;
    if (idx >= total) return;
    int d = idx % D;
    int tmp = idx / D;
    int h = tmp % H;
    int s = (tmp / H) % S;
    int b = tmp / (H * S);
    int src_row = b * S + s;
    int src_col_q = h * D + d;
    int src_col_k = src_col_q + H * D;
    int src_col_v = src_col_k + H * D;
    q[idx] = qkv[src_row * (3 * H * D) + src_col_q];
    k[idx] = qkv[src_row * (3 * H * D) + src_col_k];
    v[idx] = qkv[src_row * (3 * H * D) + src_col_v];
}

__global__ void mask_scores_kernel(float* scores, const bool* mask, int B, int H, int S) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int total = B * H * S * S;
    if (idx >= total) return;
    int kk = idx % S;
    int tmp = idx / S;
    int q = tmp % S;
    tmp /= S;
    int h = tmp % H;
    int b = tmp / H;
    int row = (b * H + h) * S + q;
    if (mask[b * S + kk]) {
        scores[row * S + kk] = -INFINITY;
    }
}

__global__ void softmax_kernel(float* scores, int rows, int cols) {
    int warp_id = (blockIdx.x * blockDim.x + threadIdx.x) / 32;
    int lane = threadIdx.x % 32;
    if (warp_id >= rows) return;
    float* row = scores + warp_id * cols;

    float max_val = -INFINITY;
    for (int i = lane; i < cols; i += 32) {
        float val = row[i];
        if (val > max_val) max_val = val;
    }
    for (int offset = 16; offset > 0; offset >>= 1) {
        max_val = fmaxf(max_val, __shfl_down_sync(0xffffffff, max_val, offset));
    }
    max_val = __shfl_sync(0xffffffff, max_val, 0);

    float sum = 0.0f;
    for (int i = lane; i < cols; i += 32) {
        float val = row[i];
        if (val != -INFINITY) {
            sum += expf(val - max_val);
        }
    }
    for (int offset = 16; offset > 0; offset >>= 1) {
        sum += __shfl_down_sync(0xffffffff, sum, offset);
    }
    sum = __shfl_sync(0xffffffff, sum, 0);

    for (int i = lane; i < cols; i += 32) {
        float val = row[i];
        if (val != -INFINITY) {
            row[i] = expf(val - max_val) / sum;
        } else {
            row[i] = 0.0f;
        }
    }
}

__global__ void merge_heads_kernel(const float* attn_out, float* merged,
                                   int B, int S, int H, int D) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int total = B * S * H * D;
    if (idx >= total) return;
    int d = idx % D;
    int tmp = idx / D;
    int h = tmp % H;
    int s = (tmp / H) % S;
    int b = tmp / (H * S);
    int src_idx = ((b * H + h) * S + s) * D + d;
    int dst_row = b * S + s;
    int dst_col = h * D + d;
    merged[dst_row * (H * D) + dst_col] = attn_out[src_idx];
}

__global__ void elementwise_mul_kernel(const float* a, const float* b, float* out, int N) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= N) return;
    out[idx] = a[idx] * b[idx];
}

__global__ void stack_kernel(const float* x3, const float* x4, float* out,
                             int out_d0, int out_d1, int out_d2, int out_d3,
                             int B, int S, int E, int stack_dim) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int total = out_d0 * out_d1 * out_d2 * out_d3;
    if (idx >= total) return;
    int tmp = idx;
    int d3 = tmp % out_d3; tmp /= out_d3;
    int d2 = tmp % out_d2; tmp /= out_d2;
    int d1 = tmp % out_d1; tmp /= out_d1;
    int d0 = tmp;
    bool from_x3;
    int input_idx;
    if (stack_dim == 0) {
        from_x3 = (d0 == 0);
        input_idx = (d1 * S + d2) * E + d3;
    } else if (stack_dim == 1) {
        from_x3 = (d1 == 0);
        input_idx = (d0 * S + d2) * E + d3;
    } else if (stack_dim == 2) {
        from_x3 = (d2 == 0);
        input_idx = (d0 * S + d1) * E + d3;
    } else if (stack_dim == 3) {
        from_x3 = (d3 == 0);
        input_idx = (d0 * S + d1) * E + d2;
    } else {
        from_x3 = true;
        input_idx = 0;
    }
    const float* src = from_x3 ? x3 : x4;
    out[idx] = src[input_idx];
}

extern "C" void mha_forward_launcher(
    const float* x1, const float* x2, const float* x3,
    const bool* key_padding_mask,
    const float* in_proj_weight, const float* in_proj_bias,
    const float* out_proj_weight, const float* out_proj_bias,
    float* output,
    float* qkv, float* q, float* k, float* v,
    float* scores, float* attn_out, float* attn_merged,
    float* out_proj, float* x4,
    int B, int S, int E, int H, int stack_dim,
    cudaStream_t stream
) {
    int D = E / H;
    int M = B * S;

    static cublasHandle_t handle = nullptr;
    if (handle == nullptr) {
        cublasCreate(&handle);
    }
    cublasSetStream(handle, stream);

    float alpha = 1.0f, beta = 0.0f;

    // 1. QKV = x1 * in_proj_weight^T
    cublasSgemm(handle, CUBLAS_OP_N, CUBLAS_OP_T,
                M, 3*E, E,
                &alpha,
                x1, E,
                in_proj_weight, E,
                &beta,
                qkv, 3*E);

    // 2. add bias
    int total_qkv = M * 3 * E;
    bias_add_kernel<<<(total_qkv+255)/256, 256, 0, stream>>>(qkv, in_proj_bias, M, 3*E);

    // 3. split qkv into q,k,v
    int total_q = B * H * S * D;
    split_qkv_kernel<<<(total_q+255)/256, 256, 0, stream>>>(qkv, q, k, v, B, S, H, D);

    // 4. scores = q * k^T * scale
    float scale = 1.0f / sqrtf((float)D);
    cublasSgemmStridedBatched(handle, CUBLAS_OP_N, CUBLAS_OP_T,
                              S, S, D,
                              &scale,
                              q, D, S*D,
                              k, D, S*D,
                              &beta,
                              scores, S, S*S,
                              B*H);

    // 5. apply mask
    int total_scores = B * H * S * S;
    mask_scores_kernel<<<(total_scores+255)/256, 256, 0, stream>>>(scores, key_padding_mask, B, H, S);

    // 6. softmax
    int rows = B * H * S;
    int block_size = 256;
    int warps_per_block = block_size / 32;
    int blocks = (rows + warps_per_block - 1) / warps_per_block;
    softmax_kernel<<<blocks, block_size, 0, stream>>>(scores, rows, S);

    // 7. attn_out = scores * v
    cublasSgemmStridedBatched(handle, CUBLAS_OP_N, CUBLAS_OP_N,
                              S, D, S,
                              &alpha,
                              scores, S, S*S,
                              v, S, S*D,
                              &beta,
                              attn_out, D, S*D,
                              B*H);

    // 8. merge heads
    int total_merged = M * E;
    merge_heads_kernel<<<(total_merged+255)/256, 256, 0, stream>>>(attn_out, attn_merged, B, S, H, D);

    // 9. out_proj = attn_merged * out_proj_weight^T
    cublasSgemm(handle, CUBLAS_OP_N, CUBLAS_OP_T,
                M, E, E,
                &alpha,
                attn_merged, E,
                out_proj_weight, E,
                &beta,
                out_proj, E);

    // add bias
    int total_out_proj = M * E;
    bias_add_kernel<<<(total_out_proj+255)/256, 256, 0, stream>>>(out_proj, out_proj_bias, M, E);

    // 10. elementwise multiply
    elementwise_mul_kernel<<<(total_out_proj+255)/256, 256, 0, stream>>>(out_proj, x2, x4, total_out_proj);

    // 11. stack
    int out_d0, out_d1, out_d2, out_d3;
    if (stack_dim < 0) stack_dim += 4;
    if (stack_dim == 0) { out_d0=2; out_d1=B; out_d2=S; out_d3=E; }
    else if (stack_dim == 1) { out_d0=B; out_d1=2; out_d2=S; out_d3=E; }
    else if (stack_dim == 2) { out_d0=B; out_d1=S; out_d2=2; out_d3=E; }
    else if (stack_dim == 3) { out_d0=B; out_d1=S; out_d2=E; out_d3=2; }
    else { /* invalid */ }
    int total_out = out_d0 * out_d1 * out_d2 * out_d3;
    stack_kernel<<<(total_out+255)/256, 256, 0, stream>>>(x3, x4, output, out_d0, out_d1, out_d2, out_d3, B, S, E, stack_dim);
}

===== kernels/mha_forward_binding.cpp =====
#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>
#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

extern "C" void mha_forward_launcher(
    const float* x1, const float* x2, const float* x3,
    const bool* key_padding_mask,
    const float* in_proj_weight, const float* in_proj_bias,
    const float* out_proj_weight, const float* out_proj_bias,
    float* output,
    float* qkv, float* q, float* k, float* v,
    float* scores, float* attn_out, float* attn_merged,
    float* out_proj, float* x4,
    int B, int S, int E, int H, int stack_dim,
    cudaStream_t stream
);

torch::Tensor mha_stack_forward(
    torch::Tensor x1, torch::Tensor x2, torch::Tensor x3,
    torch::Tensor key_padding_mask,
    torch::Tensor in_proj_weight, torch::Tensor in_proj_bias,
    torch::Tensor out_proj_weight, torch::Tensor out_proj_bias,
    int64_t num_heads, int64_t stack_dim
) {
    TORCH_CHECK(x1.is_cuda(), "x1 must be CUDA");
    TORCH_CHECK(x1.dtype() == torch::kFloat32, "x1 must be float32");
    TORCH_CHECK(x1.is_contiguous(), "x1 must be contiguous");
    TORCH_CHECK(x2.is_cuda() && x2.dtype() == torch::kFloat32 && x2.is_contiguous(), "x2 invalid");
    TORCH_CHECK(x3.is_cuda() && x3.dtype() == torch::kFloat32 && x3.is_contiguous(), "x3 invalid");
    TORCH_CHECK(key_padding_mask.is_cuda() && key_padding_mask.dtype() == torch::kBool && key_padding_mask.is_contiguous(), "mask invalid");
    TORCH_CHECK(in_proj_weight.is_cuda() && in_proj_weight.dtype() == torch::kFloat32 && in_proj_weight.is_contiguous(), "in_proj_weight invalid");
    TORCH_CHECK(in_proj_bias.is_cuda() && in_proj_bias.dtype() == torch::kFloat32 && in_proj_bias.is_contiguous(), "in_proj_bias invalid");
    TORCH_CHECK(out_proj_weight.is_cuda() && out_proj_weight.dtype() == torch::kFloat32 && out_proj_weight.is_contiguous(), "out_proj_weight invalid");
    TORCH_CHECK(out_proj_bias.is_cuda() && out_proj_bias.dtype() == torch::kFloat32 && out_proj_bias.is_contiguous(), "out_proj_bias invalid");

    int B = x1.size(0);
    int S = x1.size(1);
    int E = x1.size(2);
    int H = num_heads;
    int D = E / H;
    TORCH_CHECK(E % H == 0, "embed_dim must be divisible by num_heads");
    TORCH_CHECK(x2.size(0) == B && x2.size(1) == S && x2.size(2) == E, "x2 shape mismatch");
    TORCH_CHECK(x3.size(0) == B && x3.size(1) == S && x3.size(2) == E, "x3 shape mismatch");
    TORCH_CHECK(key_padding_mask.size(0) == B && key_padding_mask.size(1) == S, "mask shape mismatch");
    TORCH_CHECK(in_proj_weight.size(0) == 3*E && in_proj_weight.size(1) == E, "in_proj_weight shape");
    TORCH_CHECK(in_proj_bias.size(0) == 3*E, "in_proj_bias size");
    TORCH_CHECK(out_proj_weight.size(0) == E && out_proj_weight.size(1) == E, "out_proj_weight shape");
    TORCH_CHECK(out_proj_bias.size(0) == E, "out_proj_bias size");

    int stack_dim_int = static_cast<int>(stack_dim);
    int out_d0, out_d1, out_d2, out_d3;
    if (stack_dim_int < 0) stack_dim_int += 4;
    if (stack_dim_int == 0) { out_d0=2; out_d1=B; out_d2=S; out_d3=E; }
    else if (stack_dim_int == 1) { out_d0=B; out_d1=2; out_d2=S; out_d3=E; }
    else if (stack_dim_int == 2) { out_d0=B; out_d1=S; out_d2=2; out_d3=E; }
    else if (stack_dim_int == 3) { out_d0=B; out_d1=S; out_d2=E; out_d3=2; }
    else TORCH_CHECK(false, "invalid stack_dim");

    auto options = x1.options();
    auto qkv = torch::empty({B*S, 3*E}, options);
    auto q = torch::empty({B*H, S, D}, options);
    auto k = torch::empty({B*H, S, D}, options);
    auto v = torch::empty({B*H, S, D}, options);
    auto scores = torch::empty({B*H, S, S}, options);
    auto attn_out = torch::empty({B*H, S, D}, options);
    auto attn_merged = torch::empty({B*S, E}, options);
    auto out_proj = torch::empty({B*S, E}, options);
    auto x4 = torch::empty({B, S, E}, options);
    auto output = torch::empty({out_d0, out_d1, out_d2, out_d3}, options);

    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    mha_forward_launcher(
        x1.data_ptr<float>(), x2.data_ptr<float>(), x3.data_ptr<float>(),
        key_padding_mask.data_ptr<bool>(),
        in_proj_weight.data_ptr<float>(), in_proj_bias.data_ptr<float>(),
        out_proj_weight.data_ptr<float>(), out_proj_bias.data_ptr<float>(),
        output.data_ptr<float>(),
        qkv.data_ptr<float>(), q.data_ptr<float>(), k.data_ptr<float>(), v.data_ptr<float>(),
        scores.data_ptr<float>(), attn_out.data_ptr<float>(), attn_merged.data_ptr<float>(),
        out_proj.data_ptr<float>(), x4.data_ptr<float>(),
        B, S, E, H, stack_dim_int,
        stream
    );

    return output;
}

void register_mha_stack(pybind11::module& m) {
    m.def("mha_stack_forward", &mha_stack_forward,
          "MultiheadAttention + multiply + stack",
          py::arg("x1"), py::arg("x2"), py::arg("x3"), py::arg("key_padding_mask"),
          py::arg("in_proj_weight"), py::arg("in_proj_bias"),
          py::arg("out_proj_weight"), py::arg("out_proj_bias"),
          py::arg("num_heads"), py::arg("stack_dim"));
}

REGISTER_BINDING(mha_stack, register_mha_stack);
