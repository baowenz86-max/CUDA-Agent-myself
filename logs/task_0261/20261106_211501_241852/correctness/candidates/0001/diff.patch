+// Helper: move tensor to CUDA if not already, and ensure contiguous
+torch::Tensor ensure_cuda_contiguous(torch::Tensor t, const std::string& name) {
+    TORCH_CHECK(t.is_cuda(), name, " must be a CUDA tensor");
+    if (!t.is_contiguous()) {
+        t = t.contiguous();
+    }
+    return t;
+}
