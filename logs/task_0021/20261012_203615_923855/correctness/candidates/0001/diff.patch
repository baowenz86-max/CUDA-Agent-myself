--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,153 @@
+#include <cuda_runtime.h>
+#include <math.h>
+
+// All kernels are float32 only as per contract.
+
+// -----------------------------------------------------------------------------
+// Conv1d forward: output[b, oc, ol] = bias[oc] + sum_{ic, k} input[b, ic, ol+k] * weight[oc, ic, k]
+// input is [B, C_in, L_in], weight [C_out, C_in, K], output [B, C_out, L_out]
+// Assume contiguous tensors, stride: input: (C_in*L_in, L_in, 1), weight: (C_in*K, K, 1), output: (C_out*L_out, L_out, 1)
+// No padding, stride=1, dilation=1, L_out = L_in - K + 1.
+// B, C_in, C_out, L_in, L_out are ints passed from binding.
+__global__ void conv1d_kernel(
+    const float* __restrict__ input,
+    const float* __restrict__ weight,
+    const float* __restrict__ bias,
+    float* __restrict__ output,
+    int B, int C_in, int C_out, int L_in, int L_out, int K) {
+    int total = B * C_out * L_out;
+    int index = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+    for (int idx = index; idx < total; idx += stride) {
+        int ol = idx % L_out;
+        int tmp = idx / L_out;
+        int oc = tmp % C_out;
+        int b = tmp / C_out;
+        float acc = bias[oc];
+        for (int ic = 0; ic < C_in; ++ic) {
+            const float* in_ptr = input + b * C_in * L_in + ic * L_in + ol;
+            const float* w_ptr = weight + oc * C_in * K + ic * K;
+            #pragma unroll
+            for (int k = 0; k < K; ++k) {
+                acc += in_ptr[k] * w_ptr[k];
+            }
+        }
+        output[idx] = acc;
+    }
+}
+
+extern "C" void conv1d_launcher(
+    const float* input,
+    const float* weight,
+    const float* bias,
+    float* output,
+    int B, int C_in, int C_out, int L_in, int L_out, int K,
+    cudaStream_t stream) {
+    int total = B * C_out * L_out;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    // Limit blocks to avoid excessive grid size if total huge; but total ~67M, blocks ~262k ok.
+    conv1d_kernel<<<blocks, threads, 0, stream>>>(input, weight, bias, output, B, C_in, C_out, L_in, L_out, K);
+}
+
+// -----------------------------------------------------------------------------
+// Batch Matmul: output[b, i, j] = sum_k A[b, i, k] * A[b, j, k]
+// A is [B, N, K], output [B, N, N]
+// Because A^T is used, we multiply rows of A with rows of A (dot product over K).
+__global__ void batch_matmul_kernel(
+    const float* __restrict__ A,
+    float* __restrict__ output,
+    int B, int N, int K) {
+    int total = B * N * N;
+    int index = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+    for (int idx = index; idx < total; idx += stride) {
+        int j = idx % N;
+        int tmp = idx / N;
+        int i = tmp % N;
+        int b = tmp / N;
+        const float* row_i = A + b * N * K + i * K;
+        const float* row_j = A + b * N * K + j * K;
+        float acc = 0.0f;
+        for (int k = 0; k < K; ++k) {
+            acc += row_i[k] * row_j[k];
+        }
+        output[idx] = acc;
+    }
+}
+
+extern "C" void batch_matmul_launcher(
+    const float* A,
+    float* output,
+    int B, int N, int K,
+    cudaStream_t stream) {
+    int total = B * N * N;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    batch_matmul_kernel<<<blocks, threads, 0, stream>>>(A, output, B, N, K);
+}
+
+// -----------------------------------------------------------------------------
+// Softplus: output = log(1 + exp(x)), with linear fallback for x > threshold
+// PyTorch default: beta=1, threshold=20
+__global__ void softplus_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int total,
+    float threshold) {
+    int index = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+    for (int idx = index; idx < total; idx += stride) {
+        float x = input[idx];
+        float y;
+        if (x > threshold) {
+            y = x;
+        } else {
+            y = log1pf(expf(x));
+        }
+        output[idx] = y;
+    }
+}
+
+extern "C" void softplus_launcher(
+    const float* input,
+    float* output,
+    int total,
+    float threshold,
+    cudaStream_t stream) {
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    softplus_kernel<<<blocks, threads, 0, stream>>>(input, output, total, threshold);
+}
+
+// -----------------------------------------------------------------------------
+// Add bias: output[b, c, n] = input[b, c, n] + bias[c]
+// bias shape [C_out, 1] but we treat as array of length C_out; broadcast over last dim.
+__global__ void add_bias_kernel(
+    const float* __restrict__ input,
+    const float* __restrict__ bias,
+    float* __restrict__ output,
+    int B, int C_out, int N) {
+    int total = B * C_out * N;
+    int index = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+    for (int idx = index; idx < total; idx += stride) {
+        int n = idx % N;
+        int tmp = idx / N;
+        int c = tmp % C_out;
+        // b = tmp / C_out not used except for indexing input, but input has same layout with leading B dim.
+        output[idx] = input[idx] + bias[c];
+    }
+}
+
+extern "C" void add_bias_launcher(
+    const float* input,
+    const float* bias,
+    float* output,
+    int B, int C_out, int N,
+    cudaStream_t stream) {
+    int total = B * C_out * N;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    add_bias_kernel<<<blocks, threads, 0, stream>>>(input, bias, output, B, C_out, N);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,167 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void conv1d_launcher(
+    const float* input,
+    const float* weight,
+    const float* bias,
+    float* output,
+    int B, int C_in, int C_out, int L_in, int L_out, int K,
+    cudaStream_t stream);
+
+extern "C" void batch_matmul_launcher(
+    const float* A,
+    float* output,
+    int B, int N, int K,
+    cudaStream_t stream);
+
+extern "C" void softplus_launcher(
+    const float* input,
+    float* output,
+    int total,
+    float threshold,
+    cudaStream_t stream);
+
+extern "C" void add_bias_launcher(
+    const float* input,
+    const float* bias,
+    float* output,
+    int B, int C_out, int N,
+    cudaStream_t stream);
+
+// Conv1d wrapper
+at::Tensor conv1d_forward(
+    const at::Tensor& input,
+    const at::Tensor& weight,
+    const at::Tensor& bias) {
+    // Validate input
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(weight.is_cuda(), "weight must be a CUDA tensor");
+    TORCH_CHECK(bias.is_cuda(), "bias must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == at::kFloat, "input must be float32");
+    TORCH_CHECK(weight.dtype() == at::kFloat, "weight must be float32");
+    TORCH_CHECK(bias.dtype() == at::kFloat, "bias must be float32");
+
+    // Conv1d expects 3D input [B, C_in, L]
+    TORCH_CHECK(input.dim() == 3, "input must be 3D [B, C_in, L]");
+    TORCH_CHECK(weight.dim() == 3, "weight must be 3D [C_out, C_in, K]");
+    TORCH_CHECK(bias.dim() == 1, "bias must be 1D [C_out]");
+
+    int B = input.size(0);
+    int C_in = input.size(1);
+    int L_in = input.size(2);
+    int C_out = weight.size(0);
+    int K = weight.size(2);
+
+    TORCH_CHECK(weight.size(1) == C_in, "weight C_in dimension mismatch");
+    TORCH_CHECK(bias.size(0) == C_out, "bias length must match C_out");
+
+    int L_out = L_in - K + 1;
+
+    // Ensure contiguous
+    auto input_c = input.contiguous();
+    auto weight_c = weight.contiguous();
+    auto bias_c = bias.contiguous();
+
+    // Allocate output
+    auto output = at::empty({B, C_out, L_out}, input.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    conv1d_launcher(
+        input_c.data_ptr<float>(),
+        weight_c.data_ptr<float>(),
+        bias_c.data_ptr<float>(),
+        output.data_ptr<float>(),
+        B, C_in, C_out, L_in, L_out, K,
+        stream);
+
+    return output;
+}
+
+// Batch Matmul wrapper: A is [B, N, K], output is [B, N, N]
+at::Tensor batch_matmul_forward(const at::Tensor& A) {
+    TORCH_CHECK(A.is_cuda(), "A must be a CUDA tensor");
+    TORCH_CHECK(A.dtype() == at::kFloat, "A must be float32");
+    TORCH_CHECK(A.dim() == 3, "A must be 3D [B, N, K]");
+
+    int B = A.size(0);
+    int N = A.size(1);
+    int K = A.size(2);
+
+    auto A_c = A.contiguous();
+    auto output = at::empty({B, N, N}, A.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    batch_matmul_launcher(
+        A_c.data_ptr<float>(),
+        output.data_ptr<float>(),
+        B, N, K,
+        stream);
+
+    return output;
+}
+
+// Softplus wrapper (elementwise)
+at::Tensor softplus_forward(const at::Tensor& input, double threshold = 20.0) {
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == at::kFloat, "input must be float32");
+
+    auto input_c = input.contiguous();
+    auto output = at::empty_like(input_c);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    softplus_launcher(
+        input_c.data_ptr<float>(),
+        output.data_ptr<float>(),
+        input_c.numel(),
+        static_cast<float>(threshold),
+        stream);
+
+    return output;
+}
+
+// Add bias wrapper: input [B, C, N], bias [C]
+at::Tensor add_bias_forward(const at::Tensor& input, const at::Tensor& bias) {
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(bias.is_cuda(), "bias must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == at::kFloat, "input must be float32");
+    TORCH_CHECK(bias.dtype() == at::kFloat, "bias must be float32");
+    TORCH_CHECK(input.dim() == 3, "input must be 3D [B, C, N]");
+    TORCH_CHECK(bias.dim() == 1, "bias must be 1D [C]");
+
+    int B = input.size(0);
+    int C = input.size(1);
+    int N = input.size(2);
+
+    TORCH_CHECK(bias.size(0) == C, "bias length must match C");
+
+    auto input_c = input.contiguous();
+    auto bias_c = bias.contiguous();
+    auto output = at::empty_like(input_c);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    add_bias_launcher(
+        input_c.data_ptr<float>(),
+        bias_c.data_ptr<float>(),
+        output.data_ptr<float>(),
+        B, C, N,
+        stream);
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("conv1d_forward", &conv1d_forward, "Conv1d forward");
+    m.def("batch_matmul_forward", &batch_matmul_forward, "Batch matmul forward");
+    m.def("softplus_forward", &softplus_forward, "Softplus forward",
+          pybind11::arg("input"), pybind11::arg("threshold") = 20.0);
+    m.def("add_bias_forward", &add_bias_forward, "Add bias forward");
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,28 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, out_channels, kernel_size, bias_shape):
+        super().__init__()
+        self.conv1d = nn.Conv1d(in_channels, out_channels, kernel_size)
+        self.bias = nn.Parameter(torch.randn(bias_shape))
+
+    def forward(self, x):
+        x = cuda_extension.conv1d_forward(x, self.conv1d.weight, self.conv1d.bias)
+        x = cuda_extension.batch_matmul_forward(x, x.transpose(1, 2))
+        x = cuda_extension.softplus_forward(x)
+        x = cuda_extension.add_bias_forward(x, self.bias)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.conv1d_forward(x, self.conv1d.weight, self.conv1d.bias)
+        yield "step_001", x
+        x = cuda_extension.batch_matmul_forward(x, x.transpose(1, 2))
+        yield "step_002", x
+        x = cuda_extension.softplus_forward(x)
+        yield "step_003", x
+        x = cuda_extension.add_bias_forward(x, self.bias)
+        yield "step_004", x
+        yield "step_005", x
