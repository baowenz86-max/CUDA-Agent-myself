        x = cuda_extension.batch_matmul_forward(x)
        # Step 3: softplus
        x = cuda_extension.softplus_forward(x)
        # Step 4: add bias (shape [out_channels, 1])
        x = cuda_extension.add_bias_forward(x, self.bias)
        return x

