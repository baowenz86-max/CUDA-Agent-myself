out_channels = 64
kernel_size = 3
bias_shape = (out_channels, 1)


def get_inputs():
    sequence_length = 8192  # Increased from 1024 to increase computation
    x = torch.randn(batch_size, in_channels, sequence_length)
    return [x]


def get_init_inputs():
    return [in_channels, out_channels, kernel_size, bias_shape]

