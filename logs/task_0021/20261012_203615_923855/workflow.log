        yield 'step_002', x
        # step_003: after softplus
        x = cuda_extension.softplus_forward(x)
        yield 'step_003', x
        # step_004: after bias add
        x = cuda_extension.add_bias_forward(x, self.bias)
        yield 'step_004', x
        # step_005: final return
