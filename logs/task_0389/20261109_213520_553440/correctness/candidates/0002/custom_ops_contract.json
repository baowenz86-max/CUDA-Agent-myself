{
  "operators": [
    {
      "name": "batch_norm2d_eval",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "Computes BatchNorm2d inference formula: (x - running_mean[None, :, None, None]) / sqrt(running_var[None, :, None, None] + eps) * weight[None, :, None, None] + bias[None, :, None, None]",
        "If weight or bias is None, they are omitted from the expression (equivalent to 1 and 0 respectively)",
        "Broadcasts over N, H, W while normalizing over channel dimension C",
        "Preserves input strides; output tensor has same shape, dtype, and device"
      ]
    },
    {
      "name": "softmax_channel",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "Computes softmax over dimension 1 (channel axis) for each spatial location (n, h, w)",
        "For each (n, h, w), computes exp(x[n, c, h, w] - max_c x[n, c, h, w]) / sum_{c'} exp(x[n, c', h, w] - max_c x[n, c, h, w])",
        "Numerically stable using max subtraction",
        "Preserves input strides; output has same shape, dtype, and device"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.batchnorm(x)",
      "semantics": [
        "Applies BatchNorm2d in inference mode using running statistics",
        "Normalizes each channel independently: (x - running_mean[c]) / sqrt(running_var[c] + eps) * weight[c] + bias[c]",
        "Output shape [16, 512, 100, 100], dtype float32, device cuda:0"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.softmax(x)",
      "semantics": [
        "Applies softmax over channel dimension (dim=1)",
        "For each spatial position, the 512 channel values form a probability distribution",
        "Output shape [16, 512, 100, 100], dtype float32, device cuda:0"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "Returns the softmax output tensor",
        "Shape [16, 512, 100, 100], dtype float32, device cuda:0"
      ]
    }
  ]
}