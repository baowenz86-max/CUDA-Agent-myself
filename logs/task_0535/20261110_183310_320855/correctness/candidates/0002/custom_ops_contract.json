{
  "operators": [
    {
      "name": "cummax_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, M] contiguous",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tuple<torch.Tensor values, torch.Tensor indices>",
        "values": {
          "type": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as x"
        },
        "indices": {
          "type": "tensor",
          "dtype": "torch.int64",
          "device": "cuda",
          "shape": "same as x"
        }
      },
      "semantics": [
        "沿 dim=0 执行前缀最大值：对于每个位置 (i, j)，values[i, j] = max(x[0:i+1, j])",
        "indices[i, j] 记录该前缀最大值对应的索引位置（当出现相等值时，返回最新索引还是最旧索引需要按照参考 torch.cummax 行为：torch.cummax 返回最新索引）",
        "输入 x 为 CUDA float32 张量，形状 [20000, 50]，连续存储",
        "输出 values 为 float32，indices 为 int64，形状与输入相同",
        "dim 必须为 0"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "max_values, _ = torch.cummax(x, dim=0)",
      "semantics": [
        "计算沿 dim=0 的累积最大值，返回元组 (values, indices)",
        "values 为 float32，indices 为 int64，形状与输入相同",
        "结果位于 cuda 设备"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "return max_values",
      "semantics": [
        "返回累积最大值 values 张量，形状 [20000, 50]，float32，cuda"
      ]
    }
  ]
}