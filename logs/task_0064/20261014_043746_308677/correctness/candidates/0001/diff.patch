+#include <cuda_runtime.h>
+#include <cstdint>
+
+// ReflectionPad2d kernel
+// x: input pointer (float32)
+// out: output pointer (float32)
+// N, C, H, W: input dimensions
+// pad_left, pad_right, pad_top, pad_bottom: padding sizes
+// in_stride_n, in_stride_c, in_stride_h, in_stride_w: input strides
+// out_stride_n, out_stride_c, out_stride_h, out_stride_w: output strides
+__global__ void reflection_pad2d_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ out,
+    int N, int C, int H, int W,
+    int pad_left, int pad_right, int pad_top, int pad_bottom,
+    int64_t in_stride_n, int64_t in_stride_c, int64_t in_stride_h, int64_t in_stride_w,
+    int64_t out_stride_n, int64_t out_stride_c, int64_t out_stride_h, int64_t out_stride_w
+) {
+    int64_t total = (int64_t)N * C * (H + pad_top + pad_bottom) * (W + pad_left + pad_right);
+    int64_t idx = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)blockDim.x * gridDim.x;
+
+    int out_H = H + pad_top + pad_bottom;
+    int out_W = W + pad_left + pad_right;
+
+    for (int64_t i = idx; i < total; i += stride) {
+        int oh = i % out_W;
+        int64_t tmp = i / out_W;
+        int oc = tmp % out_H;
+        tmp /= out_H;
+        int on = tmp % C;
+        int n = tmp / C;
+
+        // Reflect indices for height and width
+        int ih = oh - pad_top;
+        if (ih < 0) ih = -ih - 1;
+        else if (ih >= H) ih = 2 * H - ih - 1;
+
+        int iw = i % out_W - pad_left;
+        if (iw < 0) iw = -iw - 1;
+        else if (iw >= W) iw = 2 * W - iw - 1;
+
+        // Compute source linear index using input strides
+        int64_t src_idx = (int64_t)n * in_stride_n + (int64_t)on * in_stride_c
+                       + (int64_t)ih * in_stride_h + (int64_t)iw * in_stride_w;
+        // Compute destination linear index using output strides
+        int64_t dst_idx = (int64_t)n * out_stride_n + (int64_t)on * out_stride_c
+                        + (int64_t)oh * out_stride_h + (int64_t)oc * out_stride_w;
+        out[dst_idx] = x[src_idx];
+    }
+}
+
+// nansum_dim12 kernel
+// x: input pointer (float32)
+// out: output pointer (float32) to be added to (must be pre-zeroed)
+// N, C, H, W: dimensions
+// in_stride_n, in_stride_c, in_stride_h, in_stride_w: input strides
+__global__ void nansum_dim12_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ out,
+    int N, int C, int H, int W,
+    int64_t in_stride_n, int64_t in_stride_c, int64_t in_stride_h, int64_t in_stride_w
+) {
+    int64_t total = (int64_t)N * C * H * W;
+    int64_t idx = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)blockDim.x * gridDim.x;
+
+    for (int64_t i = idx; i < total; i += stride) {
+        int w = i % W;
+        int64_t tmp = i / W;
+        int h = tmp % H;
+        tmp /= H;
+        int c = tmp % C;
+        int n = tmp / C;
+
+        int64_t src_idx = (int64_t)n * in_stride_n + (int64_t)c * in_stride_c
+                        + (int64_t)h * in_stride_h + (int64_t)w * in_stride_w;
+        float val = x[src_idx];
+        if (!isnan(val)) {
+            atomicAdd(&out[(int64_t)n * W + w], val);
+        }
+    }
+}
+
+// Host launcher for reflection_pad2d
+// x, out: raw device pointers (float32)
+// N, C, H, W: input dims
+// pad_left, pad_right, pad_top, pad_bottom
+// in_strides: array of 4 int64 strides
+// out_strides: array of 4 int64 strides
+// stream: CUDA stream
+extern "C" void reflection_pad2d_launcher(
+    const float* x,
+    float* out,
+    int N, int C, int H, int W,
+    int pad_left, int pad_right, int pad_top, int pad_bottom,
+    const int64_t* in_strides,
+    const int64_t* out_strides,
+    cudaStream_t stream
+) {
+    int64_t total = (int64_t)N * C * (H + pad_top + pad_bottom) * (W + pad_left + pad_right);
+    if (total == 0) return;
+    int block = 256;
+    int grid = (int)((total + block - 1) / block);
+    // Cap grid at 65535*4? Better use a reasonable max and rely on grid-stride loop.
+    int maxGrid = 65535 * 4;
+    if (grid > maxGrid) grid = maxGrid;
+    reflection_pad2d_kernel<<<grid, block, 0, stream>>>(
+        x, out, N, C, H, W,
+        pad_left, pad_right, pad_top, pad_bottom,
+        in_strides[0], in_strides[1], in_strides[2], in_strides[3],
+        out_strides[0], out_strides[1], out_strides[2], out_strides[3]
+    );
+}
+
+// Host launcher for nansum_dim12
+// x: input pointer
+// out: output pointer pre-zeroed (float32)
+// N, C, H, W: dims
+// in_strides: array of 4 int64 strides
+// stream
+extern "C" void nansum_dim12_launcher(
+    const float* x,
+    float* out,
+    int N, int C, int H, int W,
+    const int64_t* in_strides,
+    cudaStream_t stream
+) {
+    int64_t total = (int64_t)N * C * H * W;
+    if (total == 0) return;
+    int block = 256;
+    int grid = (int)((total + block - 1) / block);
+    int maxGrid = 65535 * 4;
+    if (grid > maxGrid) grid = maxGrid;
+    nansum_dim12_kernel<<<grid, block, 0, stream>>>(
+        x, out, N, C, H, W,
+        in_strides[0], in_strides[1], in_strides[2], in_strides[3]
+    );
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,276 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cudnn.h>
+#include <vector>
+#include <cstdint>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void reflection_pad2d_launcher(
+    const float* x,
+    float* out,
+    int N, int C, int H, int W,
+    int pad_left, int pad_right, int pad_top, int pad_bottom,
+    const int64_t* in_strides,
+    const int64_t* out_strides,
+    cudaStream_t stream
+);
+
+extern "C" void nansum_dim12_launcher(
+    const float* x,
+    float* out,
+    int N, int C, int H, int W,
+    const int64_t* in_strides,
+    cudaStream_t stream
+);
+
+// Helper: check CUDA error
+#define CHECK_CUDA(call) { \
+    cudaError_t err = call; \
+    TORCH_CHECK(err == cudaSuccess, "CUDA error: ", cudaGetErrorString(err)); \
+}
+
+// Helper: check cuDNN error
+#define CHECK_CUDNN(call) { \
+    cudnnStatus_t err = call; \
+    TORCH_CHECK(err == CUDNN_STATUS_SUCCESS, "cuDNN error: ", cudnnGetErrorString(err)); \
+}
+
+// reflection_pad2d wrapper
+torch::Tensor reflection_pad2d(
+    torch::Tensor x,
+    int64_t pad_left,
+    int64_t pad_right,
+    int64_t pad_top,
+    int64_t pad_bottom
+) {
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(x.dim() == 4, "x must be 4D [N,C,H,W]");
+    TORCH_CHECK(pad_left >= 0 && pad_right >= 0 && pad_top >= 0 && pad_bottom >= 0, "padding must be non-negative");
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+    int out_H = H + pad_top + pad_bottom;
+    int out_W = W + pad_left + pad_right;
+
+    auto out = torch::empty({N, C, out_H, out_W}, x.options());
+
+    // Prepare stride arrays (int64_t)
+    std::vector<int64_t> in_strides(4);
+    std::vector<int64_t> out_strides(4);
+    for (int i = 0; i < 4; ++i) {
+        in_strides[i] = x.stride(i);
+        out_strides[i] = out.stride(i);
+    }
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    reflection_pad2d_launcher(
+        x.data_ptr<float>(),
+        out.data_ptr<float>(),
+        N, C, H, W,
+        (int)pad_left, (int)pad_right, (int)pad_top, (int)pad_bottom,
+        in_strides.data(),
+        out_strides.data(),
+        stream
+    );
+    CHECK_CUDA(cudaGetLastError());
+
+    return out;
+}
+
+// conv2d wrapper using cuDNN
+torch::Tensor conv2d(
+    torch::Tensor x,
+    torch::Tensor weight,
+    torch::optional<torch::Tensor> bias,
+    int64_t stride_h,
+    int64_t stride_w,
+    int64_t padding_h,
+    int64_t padding_w,
+    int64_t dilation_h,
+    int64_t dilation_w
+) {
+    TORCH_CHECK(x.is_cuda(), "x must be CUDA");
+    TORCH_CHECK(weight.is_cuda(), "weight must be CUDA");
+    if (bias.has_value()) {
+        TORCH_CHECK(bias.value().is_cuda(), "bias must be CUDA");
+        TORCH_CHECK(bias.value().dtype() == torch::kFloat32, "bias must be float32");
+    }
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(weight.dtype() == torch::kFloat32, "weight must be float32");
+    TORCH_CHECK(x.dim() == 4 && weight.dim() == 4, "x and weight must be 4D");
+
+    // Contract: weight shape [C_out, C_in, KH, KW]
+    int N = x.size(0);
+    int C_in = x.size(1);
+    int H_in = x.size(2);
+    int W_in = x.size(3);
+    int C_out = weight.size(0);
+    int KH = weight.size(2);
+    int KW = weight.size(3);
+
+    TORCH_CHECK(weight.size(1) == C_in, "weight input channels mismatch");
+    TORCH_CHECK(stride_h > 0 && stride_w > 0, "stride must be positive");
+    TORCH_CHECK(padding_h >= 0 && padding_w >= 0, "padding must be non-negative");
+    TORCH_CHECK(dilation_h > 0 && dilation_w > 0, "dilation must be positive");
+
+    int H_out = (H_in + 2 * padding_h - dilation_h * (KH - 1) - 1) / stride_h + 1;
+    int W_out = (W_in + 2 * padding_w - dilation_w * (KW - 1) - 1) / stride_w + 1;
+
+    auto out = torch::empty({N, C_out, H_out, W_out}, x.options());
+
+    // Create cuDNN handle
+    cudnnHandle_t cudnn_handle;
+    CHECK_CUDNN(cudnnCreate(&cudnn_handle));
+
+    // Set stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    CHECK_CUDNN(cudnnSetStream(cudnn_handle, stream));
+
+    // Describe tensors
+    cudnnTensorDescriptor_t x_desc, y_desc;
+    cudnnFilterDescriptor_t w_desc;
+    cudnnConvolutionDescriptor_t conv_desc;
+    cudnnTensorDescriptor_t bias_desc;
+
+    CHECK_CUDNN(cudnnCreateTensorDescriptor(&x_desc));
+    CHECK_CUDNN(cudnnCreateTensorDescriptor(&y_desc));
+    CHECK_CUDNN(cudnnCreateFilterDescriptor(&w_desc));
+    CHECK_CUDNN(cudnnCreateConvolutionDescriptor(&conv_desc));
+    CHECK_CUDNN(cudnnCreateTensorDescriptor(&bias_desc));
+
+    // Set tensor descriptors to NCHW float32
+    CHECK_CUDNN(cudnnSetTensor4dDescriptor(x_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT, N, C_in, H_in, W_in));
+    CHECK_CUDNN(cudnnSetTensor4dDescriptor(y_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT, N, C_out, H_out, W_out));
+    CHECK_CUDNN(cudnnSetFilter4dDescriptor(w_desc, CUDNN_DATA_FLOAT, CUDNN_TENSOR_NCHW, C_out, C_in, KH, KW));
+    CHECK_CUDNN(cudnnSetConvolution2dDescriptor(
+        conv_desc,
+        padding_h, padding_w,
+        stride_h, stride_w,
+        dilation_h, dilation_w,
+        CUDNN_CROSS_CORRELATION,
+        CUDNN_DATA_FLOAT
+    ));
+
+    // Set bias descriptor: one bias per output channel
+    CHECK_CUDNN(cudnnSetTensor4dDescriptor(bias_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT, 1, C_out, 1, 1));
+
+    // Find best algorithm (forward)
+    cudnnConvolutionFwdAlgo_t algo;
+    CHECK_CUDNN(cudnnGetConvolutionForwardAlgorithm(
+        cudnn_handle,
+        x_desc, w_desc, conv_desc, y_desc,
+        CUDNN_CONVOLUTION_FWD_PREFER_FASTEST,
+        0,
+        &algo
+    ));
+
+    // Allocate workspace
+    size_t workspace_size = 0;
+    CHECK_CUDNN(cudnnGetConvolutionForwardWorkspaceSize(
+        cudnn_handle, x_desc, w_desc, conv_desc, y_desc, algo, &workspace_size
+    ));
+    void* workspace = nullptr;
+    if (workspace_size > 0) {
+        CHECK_CUDA(cudaMalloc(&workspace, workspace_size));
+    }
+
+    float alpha = 1.0f;
+    float beta = 0.0f;
+
+    if (bias.has_value()) {
+        // Compute convolution without bias activation, then add bias
+        CHECK_CUDNN(cudnnConvolutionForward(
+            cudnn_handle,
+            &alpha,
+            x_desc, x.data_ptr<float>(),
+            w_desc, weight.data_ptr<float>(),
+            conv_desc,
+            algo,
+            workspace, workspace_size,
+            &beta,
+            y_desc, out.data_ptr<float>()
+        ));
+        // Add bias: use cudnnAddTensor
+        CHECK_CUDNN(cudnnAddTensor(
+            cudnn_handle,
+            &alpha,
+            bias_desc, bias.value().data_ptr<float>(),
+            &alpha,
+            y_desc, out.data_ptr<float>()
+        ));
+    } else {
+        CHECK_CUDNN(cudnnConvolutionForward(
+            cudnn_handle,
+            &alpha,
+            x_desc, x.data_ptr<float>(),
+            w_desc, weight.data_ptr<float>(),
+            conv_desc,
+            algo,
+            workspace, workspace_size,
+            &beta,
+            y_desc, out.data_ptr<float>()
+        ));
+    }
+
+    // Cleanup
+    if (workspace) cudaFree(workspace);
+    cudnnDestroyTensorDescriptor(x_desc);
+    cudnnDestroyTensorDescriptor(y_desc);
+    cudnnDestroyFilterDescriptor(w_desc);
+    cudnnDestroyConvolutionDescriptor(conv_desc);
+    cudnnDestroyTensorDescriptor(bias_desc);
+    cudnnDestroy(cudnn_handle);
+    CHECK_CUDA(cudaGetLastError());
+
+    return out;
+}
+
+// nansum_dim12 wrapper
+torch::Tensor nansum_dim12(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "x must be CUDA");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(x.dim() == 4, "x must be 4D [N,C,H,W]");
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+
+    auto out = torch::zeros({N, W}, x.options());
+
+    std::vector<int64_t> in_strides(4);
+    for (int i = 0; i < 4; ++i) {
+        in_strides[i] = x.stride(i);
+    }
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    nansum_dim12_launcher(
+        x.data_ptr<float>(),
+        out.data_ptr<float>(),
+        N, C, H, W,
+        in_strides.data(),
+        stream
+    );
+    CHECK_CUDA(cudaGetLastError());
+
+    return out;
+}
+
+// Registration
+void register_custom_ops(pybind11::module& m) {
+    m.def("reflection_pad2d", &reflection_pad2d, "ReflectionPad2d forward",
+          py::arg("x"), py::arg("pad_left"), py::arg("pad_right"), py::arg("pad_top"), py::arg("pad_bottom"));
+    m.def("conv2d", &conv2d, "Conv2d forward using cuDNN",
+          py::arg("x"), py::arg("weight"), py::arg("bias"), py::arg("stride_h"), py::arg("stride_w"),
+          py::arg("padding_h"), py::arg("padding_w"), py::arg("dilation_h"), py::arg("dilation_w"));
+    m.def("nansum_dim12", &nansum_dim12, "nansum over dims 1 and 2", py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,29 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, input_channels, padding_size, out_channels):
+        super().__init__()
+        self.padding_size = padding_size
+        self.input_channels = input_channels
+        self.out_channels = out_channels
+        # 保持 state_dict 键与参考模型一致
+        self.conv = nn.Conv2d(input_channels, out_channels, kernel_size=3)
+
+    def forward(self, x):
+        x = cuda_extension.reflection_pad2d(x, self.padding_size[0], self.padding_size[1], self.padding_size[2], self.padding_size[3])
+        x = cuda_extension.conv2d(x, self.conv.weight, self.conv.bias, 1, 1, 0, 0, 1, 1)
+        x = cuda_extension.nansum_dim12(x)
+        return x
+
+    def debug_forward(self, *inputs):
+        x = inputs[0]
+        x = cuda_extension.reflection_pad2d(x, self.padding_size[0], self.padding_size[1], self.padding_size[2], self.padding_size[3])
+        yield 'step_001', x
+        x = cuda_extension.conv2d(x, self.conv.weight, self.conv.bias, 1, 1, 0, 0, 1, 1)
+        yield 'step_002', x
+        x = cuda_extension.nansum_dim12(x)
+        yield 'step_003', x
+        yield 'step_004', x
