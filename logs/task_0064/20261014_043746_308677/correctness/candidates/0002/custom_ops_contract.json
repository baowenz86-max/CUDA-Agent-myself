{
  "operators": [
    {
      "name": "reflection_pad2d",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "pad_left",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "pad_right",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "pad_top",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "pad_bottom",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C, H + pad_top + pad_bottom, W + pad_left + pad_right]"
      },
      "semantics": [
        "对应参考语句 x = self.pad(x)，即 nn.ReflectionPad2d((pad_left, pad_right, pad_top, pad_bottom))。",
        "输出高度 = H + pad_top + pad_bottom，输出宽度 = W + pad_left + pad_right。",
        "对于每个输出位置 (oh, ow)，计算反射索引 ih = reflect(oh - pad_top, H)，iw = reflect(ow - pad_left, W)，其中 reflect(i, size) 在 i < 0 时返回 -i - 1，在 i >= size 时返回 2*size - i - 1，否则返回 i。",
        "输出按批次和通道顺序复制对应位置的值。"
      ]
    },
    {
      "name": "conv2d",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C_in, H_in, W_in]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C_out, C_in, KH, KW]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C_out]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "stride_h",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "stride_w",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "padding_h",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "padding_w",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "dilation_h",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "dilation_w",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C_out, H_out, W_out]"
      },
      "semantics": [
        "对应参考语句 x = self.conv(x)，即 nn.Conv2d(input_channels, out_channels, kernel_size=3)（stride=1, padding=0, dilation=1, groups=1, bias=True）。",
        "输出高度 H_out = floor((H_in + 2*padding_h - dilation_h*(KH-1) - 1)/stride_h + 1)，宽度类似。",
        "使用 cuDNN 实现，Python 调用参数与参考实际参数一致（bias 为模块 bias，不使用 None）。",
        "若 bias 为 None，则输出仅包含卷积结果，不添加偏置。"
      ]
    },
    {
      "name": "nansum_dim12",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, W]"
      },
      "semantics": [
        "对应参考语句 x = torch.nansum(x, dim=[1, 2])，即对输入张量的第1维（通道）和第2维（高度）求和，忽略 NaN 值。",
        "输出形状为 [N, W]，保持批次和宽度维度。",
        "对于每个批次 n 和宽度 w，计算 sum_{c=0}^{C-1} sum_{h=0}^{H-1} x[n,c,h,w]，其中遇到 NaN 时视为 0。",
        "输入可以为任意 stride，实现需正确处理非连续内存。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.pad(x)",
      "semantics": [
        "对输入 x 应用 ReflectionPad2d((1,1,1,1))，输出形状 [512,3,130,130]。",
        "反射填充：边界像素镜像复制，不重复边界。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.conv(x)",
      "semantics": [
        "对填充后的 x 应用 Conv2d(3,16,kernel_size=3,stride=1,padding=0)，输出形状 [512,16,128,128]。",
        "卷积核形状 [16,3,3,3]，使用 bias。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = torch.nansum(x, dim=[1, 2])",
      "semantics": [
        "对卷积输出按通道和高度维度求和，忽略 NaN，输出形状 [512,128]。",
        "求和轴顺序不影响结果，保持输出 dtype float32。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return x",
      "semantics": [
        "返回最终输出，形状 [512,128]，dtype float32，device cuda。"
      ]
    }
  ]
}