--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,89 @@
+#include <cuda_runtime.h>
+#include <cmath>
+
+// Elementwise hard shrink: y = x if abs(x) > 0.5 else 0
+__global__ void hardshrink_kernel(const float* __restrict__ input,
+                                  float* __restrict__ output,
+                                  int64_t total) {
+    int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    int64_t stride = static_cast<int64_t>(blockDim.x) * gridDim.x;
+    for (int64_t i = idx; i < total; i += stride) {
+        float x = input[i];
+        output[i] = (fabsf(x) > 0.5f) ? x : 0.0f;
+    }
+}
+
+// Elementwise ELU with alpha=1.0: y = x if x >= 0 else exp(x)-1
+__global__ void elu_kernel(const float* __restrict__ input,
+                           float* __restrict__ output,
+                           int64_t total) {
+    int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    int64_t stride = static_cast<int64_t>(blockDim.x) * gridDim.x;
+    for (int64_t i = idx; i < total; i += stride) {
+        float x = input[i];
+        output[i] = (x >= 0.0f) ? x : (expf(x) - 1.0f);
+    }
+}
+
+// Fused hardshrink then ELU, single pass
+__global__ void fused_hardshrink_elu_kernel(const float* __restrict__ input,
+                                            float* __restrict__ output,
+                                            int64_t total) {
+    int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    int64_t stride = static_cast<int64_t>(blockDim.x) * gridDim.x;
+    for (int64_t i = idx; i < total; i += stride) {
+        float x = input[i];
+        // hardshrink
+        float h = (fabsf(x) > 0.5f) ? x : 0.0f;
+        // elu
+        output[i] = (h >= 0.0f) ? h : (expf(h) - 1.0f);
+    }
+}
+
+// Helper to compute grid size (blocks) for given total elements and block size
+static inline int64_t compute_grid(int64_t total, int block_size) {
+    if (total <= 0) return 0;
+    return (total + block_size - 1) / block_size;
+}
+
+extern "C" void hardshrink_forward_launcher(const float* input,
+                                            float* output,
+                                            int64_t total,
+                                            cudaStream_t stream) {
+    if (total == 0) return;
+    const int block_size = 256;
+    int64_t grid = compute_grid(total, block_size);
+    hardshrink_kernel<<<grid, block_size, 0, stream>>>(input, output, total);
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // The binding layer will check errors; we don't throw here.
+    }
+}
+
+extern "C" void elu_forward_launcher(const float* input,
+                                     float* output,
+                                     int64_t total,
+                                     cudaStream_t stream) {
+    if (total == 0) return;
+    const int block_size = 256;
+    int64_t grid = compute_grid(total, block_size);
+    elu_kernel<<<grid, block_size, 0, stream>>>(input, output, total);
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // ignore here, binding will check
+    }
+}
+
+extern "C" void hardshrink_elu_forward_launcher(const float* input,
+                                                float* output,
+                                                int64_t total,
+                                                cudaStream_t stream) {
+    if (total == 0) return;
+    const int block_size = 256;
+    int64_t grid = compute_grid(total, block_size);
+    fused_hardshrink_elu_kernel<<<grid, block_size, 0, stream>>>(input, output, total);
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // ignore here, binding will check
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,94 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void hardshrink_forward_launcher(const float* input,
+                                             float* output,
+                                             int64_t total,
+                                             cudaStream_t stream);
+
+extern "C" void elu_forward_launcher(const float* input,
+                                      float* output,
+                                      int64_t total,
+                                      cudaStream_t stream);
+
+extern "C" void hardshrink_elu_forward_launcher(const float* input,
+                                                 float* output,
+                                                 int64_t total,
+                                                 cudaStream_t stream);
+
+namespace {
+
+void validate_cuda_float32(const torch::Tensor& x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.numel() > 0, "Input must have at least one element");
+    // Ensure no overlapping strides that would break elementwise kernel correctness.
+    // A simple contiguity check is not sufficient for broadcasted views; but our
+    // elementwise kernel reads with a single linear index assuming no overlap.
+    // Overlapping strides typically indicate a broadcasted tensor, which we cannot handle.
+    // We require the input to be non-overlapping: the stride of each dimension must either
+    // be the product of sizes of subsequent dimensions (contiguous) or the tensor has
+    // fewer than 2 dims where overlap is impossible, and no stride is zero.
+    // This simple check ensures no zero strides and for contiguous case works.
+    // The model will pass contiguous tensors, so this is acceptable.
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous for elementwise kernel");
+}
+
+} // anonymous namespace
+
+torch::Tensor hardshrink_forward(torch::Tensor x) {
+    validate_cuda_float32(x);
+    auto output = torch::empty_like(x);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    hardshrink_forward_launcher(x.data_ptr<float>(),
+                                output.data_ptr<float>(),
+                                x.numel(),
+                                stream);
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "hardshrink_forward kernel launch failed: ", cudaGetErrorString(err));
+    return output;
+}
+
+torch::Tensor elu_forward(torch::Tensor x) {
+    validate_cuda_float32(x);
+    auto output = torch::empty_like(x);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    elu_forward_launcher(x.data_ptr<float>(),
+                         output.data_ptr<float>(),
+                         x.numel(),
+                         stream);
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "elu_forward kernel launch failed: ", cudaGetErrorString(err));
+    return output;
+}
+
+torch::Tensor hardshrink_elu_forward(torch::Tensor x) {
+    validate_cuda_float32(x);
+    auto output = torch::empty_like(x);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    hardshrink_elu_forward_launcher(x.data_ptr<float>(),
+                                    output.data_ptr<float>(),
+                                    x.numel(),
+                                    stream);
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "hardshrink_elu_forward kernel launch failed: ", cudaGetErrorString(err));
+    return output;
+}
+
+void register_custom_ops_binding(pybind11::module& m) {
+    m.def("hardshrink_forward", &hardshrink_forward,
+          "hardshrink_forward(x: Tensor) -> Tensor",
+          py::arg("x"));
+    m.def("elu_forward", &elu_forward,
+          "elu_forward(x: Tensor) -> Tensor",
+          py::arg("x"));
+    m.def("hardshrink_elu_forward", &hardshrink_elu_forward,
+          "hardshrink_elu_forward(x: Tensor) -> Tensor",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops_binding);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,21 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, channels):
+        super().__init__()
+        self.channels = channels
+
+    def forward(self, x):
+        return cuda_extension.hardshrink_elu_forward(x)
+
+    def debug_forward(self, x):
+        hardshrink_out = cuda_extension.hardshrink_forward(x)
+        yield "step_001", hardshrink_out
+
+        elu_out = cuda_extension.elu_forward(hardshrink_out)
+        yield "step_002", elu_out
+
+        yield "step_003", elu_out
