--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,104 @@
+#include <cuda_runtime.h>
+
+// 辅助函数：获取全局线程索引
+typedef unsigned int uint;
+
+// triu_forward kernel：对每个 batch 和 channel 的最后两维执行上三角掩码
+// 输入形状: [N, C, H, W]，连续存储
+// 输出与输入形状相同
+__global__ void triu_kernel(const float* __restrict__ input,
+                            float* __restrict__ output,
+                            int N, int C, int H, int W,
+                            uint total_elements) {
+    uint idx = blockIdx.x * blockDim.x + threadIdx.x;
+    uint stride = blockDim.x * gridDim.x;
+
+    for (uint i = idx; i < total_elements; i += stride) {
+        // 计算 n, c, h, w
+        int w = i % W;
+        int tmp = i / W;
+        int h = tmp % H;
+        tmp = tmp / H;
+        int c = tmp % C;
+        int n = tmp / C;
+
+        // 上三角：保留 h <= w 的元素，否则置零
+        if (h <= w) {
+            output[i] = input[i];
+        } else {
+            output[i] = 0.0f;
+        }
+    }
+}
+
+// batch_norm_eval_forward kernel：每个元素独立归一化
+// 输入形状: [N, C, H, W]，参数形状: [C]
+__global__ void batch_norm_eval_kernel(const float* __restrict__ x,
+                                       float* __restrict__ y,
+                                       const float* __restrict__ running_mean,
+                                       const float* __restrict__ running_var,
+                                       const float* __restrict__ weight,
+                                       const float* __restrict__ bias,
+                                       float eps,
+                                       int N, int C, int H, int W,
+                                       uint total_elements) {
+    uint idx = blockIdx.x * blockDim.x + threadIdx.x;
+    uint stride = blockDim.x * gridDim.x;
+
+    for (uint i = idx; i < total_elements; i += stride) {
+        // 计算通道索引 c
+        int w = i % W;
+        int tmp = i / W;
+        int h = tmp % H;
+        tmp = tmp / H;
+        int c = tmp % C;
+
+        float mean = running_mean[c];
+        float var = running_var[c];
+        float gamma = weight ? weight[c] : 1.0f;  // 如果 weight 为 null，则视为 1
+        float beta = bias ? bias[c] : 0.0f;      // 如果 bias 为 null，则视为 0
+
+        float inv_std = rsqrtf(var + eps);
+        y[i] = (x[i] - mean) * inv_std * gamma + beta;
+    }
+}
+
+// launcher: triu_forward
+// 参数：输入指针，输出指针，N, C, H, W, stream
+extern "C" void triu_forward_launcher(const float* input,
+                                     float* output,
+                                     int N, int C, int H, int W,
+                                     cudaStream_t stream) {
+    uint total = (uint)N * C * H * W;
+    if (total == 0) return;
+
+    // 选择 block 大小和 grid 大小，使用 grid-stride 循环
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535; // 限制 grid 大小，配合 grid-stride
+
+    triu_kernel<<<blocks, threads, 0, stream>>>(input, output, N, C, H, W, total);
+}
+
+// launcher: batch_norm_eval_forward
+// 参数：输入指针，输出指针，running_mean, running_var, weight, bias, eps, N, C, H, W, stream
+extern "C" void batch_norm_eval_forward_launcher(const float* input,
+                                                 float* output,
+                                                 const float* running_mean,
+                                                 const float* running_var,
+                                                 const float* weight,
+                                                 const float* bias,
+                                                 float eps,
+                                                 int N, int C, int H, int W,
+                                                 cudaStream_t stream) {
+    uint total = (uint)N * C * H * W;
+    if (total == 0) return;
+
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535;
+
+    batch_norm_eval_kernel<<<blocks, threads, 0, stream>>>(
+        input, output, running_mean, running_var, weight, bias, eps,
+        N, C, H, W, total);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,129 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void triu_forward_launcher(const float* input,
+                                     float* output,
+                                     int N, int C, int H, int W,
+                                     cudaStream_t stream);
+
+extern "C" void batch_norm_eval_forward_launcher(const float* input,
+                                                 float* output,
+                                                 const float* running_mean,
+                                                 const float* running_var,
+                                                 const float* weight,
+                                                 const float* bias,
+                                                 float eps,
+                                                 int N, int C, int H, int W,
+                                                 cudaStream_t stream);
+
+// Helper to check tensor is float32 CUDA dense and contiguous
+torch::Tensor check_cuda_float_contiguous(const torch::Tensor& t, const std::string& name) {
+    TORCH_CHECK(t.is_cuda(), name, " must be a CUDA tensor");
+    TORCH_CHECK(t.dtype() == torch::kFloat32, name, " must be float32");
+    TORCH_CHECK(t.is_contiguous(), name, " must be contiguous");
+    return t;
+}
+
+torch::Tensor triu_forward(torch::Tensor x) {
+    // Validate input
+    x = check_cuda_float_contiguous(x, "x");
+    TORCH_CHECK(x.dim() == 4, "x must be 4D (N, C, H, W)");
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    triu_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C, H, W,
+        stream
+    );
+
+    // Check for kernel launch errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA error in triu_forward: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+torch::Tensor batch_norm_eval_forward(torch::Tensor x,
+                                      torch::Tensor running_mean,
+                                      torch::Tensor running_var,
+                                      torch::Tensor weight,
+                                      torch::Tensor bias,
+                                      double eps) {
+    // Validate inputs
+    x = check_cuda_float_contiguous(x, "x");
+    running_mean = check_cuda_float_contiguous(running_mean, "running_mean");
+    running_var = check_cuda_float_contiguous(running_var, "running_var");
+    if (weight.defined()) {
+        weight = check_cuda_float_contiguous(weight, "weight");
+    }
+    if (bias.defined()) {
+        bias = check_cuda_float_contiguous(bias, "bias");
+    }
+
+    TORCH_CHECK(x.dim() == 4, "x must be 4D (N, C, H, W)");
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+
+    // Check parameter shapes: should be [C]
+    TORCH_CHECK(running_mean.numel() == C, "running_mean size mismatch");
+    TORCH_CHECK(running_var.numel() == C, "running_var size mismatch");
+    if (weight.defined()) {
+        TORCH_CHECK(weight.numel() == C, "weight size mismatch");
+    }
+    if (bias.defined()) {
+        TORCH_CHECK(bias.numel() == C, "bias size mismatch");
+    }
+
+    auto output = torch::empty_like(x);
+
+    const float* weight_ptr = weight.defined() ? weight.data_ptr<float>() : nullptr;
+    const float* bias_ptr = bias.defined() ? bias.data_ptr<float>() : nullptr;
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    batch_norm_eval_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        running_mean.data_ptr<float>(),
+        running_var.data_ptr<float>(),
+        weight_ptr,
+        bias_ptr,
+        static_cast<float>(eps),
+        N, C, H, W,
+        stream
+    );
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA error in batch_norm_eval_forward: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("triu_forward", &triu_forward,
+          "Apply upper triangular mask to last two dimensions (N,C,H,W)",
+          pybind11::arg("x"));
+    m.def("batch_norm_eval_forward", &batch_norm_eval_forward,
+          "BatchNorm2d evaluation forward",
+          pybind11::arg("x"),
+          pybind11::arg("running_mean"),
+          pybind11::arg("running_var"),
+          pybind11::arg("weight"),
+          pybind11::arg("bias"),
+          pybind11::arg("eps"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,42 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, num_channels, eps_value):
+        super().__init__()
+        # 保持与参考相同的模块结构，但 forward 中不使用 torch 模块计算
+        self.batch_norm = nn.BatchNorm2d(num_channels, eps=eps_value)
+
+    def forward(self, x):
+        # 第一步：上三角掩码（自定义算子）
+        x = cuda_extension.triu_forward(x)
+        # 第二步：BatchNorm2d eval 模式（自定义算子）
+        x = cuda_extension.batch_norm_eval_forward(
+            x,
+            self.batch_norm.running_mean,
+            self.batch_norm.running_var,
+            self.batch_norm.weight,
+            self.batch_norm.bias,
+            self.batch_norm.eps,
+        )
+        return x
+
+    def debug_forward(self, *inputs):
+        x = inputs[0]
+        # step_001: torch.triu
+        x_triu = cuda_extension.triu_forward(x)
+        yield 'step_001', x_triu
+        # step_002: batch_norm eval
+        x_bn = cuda_extension.batch_norm_eval_forward(
+            x_triu,
+            self.batch_norm.running_mean,
+            self.batch_norm.running_var,
+            self.batch_norm.weight,
+            self.batch_norm.bias,
+            self.batch_norm.eps,
+        )
+        yield 'step_002', x_bn
+        # step_003: return
+        yield 'step_003', x_bn
