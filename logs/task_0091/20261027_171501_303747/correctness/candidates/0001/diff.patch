--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,194 @@
+#include <cuda_runtime.h>
+
+// -----------------------------------------------------------------------------
+// triu_forward kernel
+// Applies torch.triu (diagonal=0) to each HxW matrix in the last two dimensions.
+// Input and output have shape [N, C, H, W], potentially non-contiguous.
+// Each thread handles one element of the output.
+// -----------------------------------------------------------------------------
+__global__ void triu_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    int N, int C, int H, int W,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w)
+{
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long total = (long long)N * C * H * W;
+    if (idx >= total) return;
+
+    // Decode linear index to n,c,h,w
+    int w = idx % W;
+    long long tmp = idx / W;
+    int h = tmp % H;
+    tmp /= H;
+    int c = tmp % C;
+    int n = tmp / C;
+
+    // triu condition: keep if h <= w (i.e., on or above main diagonal)
+    float val = 0.0f;
+    if (h <= w) {
+        const float* in_ptr = input + n * in_stride_n + c * in_stride_c + h * in_stride_h + w * in_stride_w;
+        val = *in_ptr;
+    }
+    float* out_ptr = output + n * out_stride_n + c * out_stride_c + h * out_stride_h + w * out_stride_w;
+    *out_ptr = val;
+}
+
+extern "C" void triu_forward_launcher(
+    float* output,
+    const float* input,
+    int N, int C, int H, int W,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,
+    cudaStream_t stream)
+{
+    long long total = (long long)N * C * H * W;
+    if (total <= 0) return;
+    const int threads = 256;
+    long long blocks = (total + threads - 1) / threads;
+    // Cap grid dimension at 2^31-1 and use grid-stride loop if needed.
+    // For simplicity, if blocks exceed max grid size, use a grid-stride loop version.
+    // Here we assume typical sizes fit; implement a safe cap with loop.
+    int max_blocks = 65535; // conservative for older GPUs; can be larger but safe
+    int grid = (int)min((long long)max_blocks, blocks);
+    triu_kernel<<<grid, threads, 0, stream>>>(
+        output, input, N, C, H, W,
+        in_stride_n, in_stride_c, in_stride_h, in_stride_w,
+        out_stride_n, out_stride_c, out_stride_h, out_stride_w
+    );
+    // If blocks > max_blocks, we need a grid-stride loop; but for our target sizes (512*3*64*64=6M),
+    // blocks=24576 which is below 65535, so it's fine. However, include loop to be safe.
+}
+
+// Grid-stride loop variant for very large tensors (not actually needed for current task)
+__global__ void triu_kernel_grid_stride(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    long long total,
+    int N, int C, int H, int W,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w)
+{
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (; idx < total; idx += stride) {
+        int w = idx % W;
+        long long tmp = idx / W;
+        int h = tmp % H;
+        tmp /= H;
+        int c = tmp % C;
+        int n = tmp / C;
+
+        float val = 0.0f;
+        if (h <= w) {
+            const float* in_ptr = input + n * in_stride_n + c * in_stride_c + h * in_stride_h + w * in_stride_w;
+            val = *in_ptr;
+        }
+        float* out_ptr = output + n * out_stride_n + c * out_stride_c + h * out_stride_h + w * out_stride_w;
+        *out_ptr = val;
+    }
+}
+
+// We'll use the grid-stride version always for safety and simplicity.
+extern "C" void triu_forward_launcher(
+    float* output,
+    const float* input,
+    int N, int C, int H, int W,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,
+    cudaStream_t stream)
+{
+    long long total = (long long)N * C * H * W;
+    if (total <= 0) return;
+    const int threads = 256;
+    // Cap grid at a reasonable number, then use grid-stride loop in kernel.
+    int grid = (int)min((long long)65535, (total + threads - 1) / threads);
+    if (grid == 0) grid = 1;
+    triu_kernel_grid_stride<<<grid, threads, 0, stream>>>(
+        output, input, total, N, C, H, W,
+        in_stride_n, in_stride_c, in_stride_h, in_stride_w,
+        out_stride_n, out_stride_c, out_stride_h, out_stride_w
+    );
+}
+
+// -----------------------------------------------------------------------------
+// add_bias_forward kernel
+// Adds bias of shape [C] or [C,1,1] to x of shape [N,C,H,W] following broadcasting.
+// We assume bias is contiguous and of shape [C] or [C,1,1] with C elements.
+// Output shape = input shape, contiguous.
+// -----------------------------------------------------------------------------
+__global__ void add_bias_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    const float* __restrict__ bias,
+    long long total,
+    int C, int HW,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w)
+{
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (; idx < total; idx += stride) {
+        // Decode n,c,h,w from idx: idx = n*C*HW + c*HW + hw
+        int hw = idx % HW;
+        long long tmp = idx / HW;
+        int c = tmp % C;
+        // For bias shape [C,1,1] or [C], bias index is just c
+        float b = bias[c];
+        // Compute input value using strides
+        long long n = tmp / C;
+        // Need h,w from hw
+        int h = hw / (int)out_stride_h; // unsafe; better pass H,W separately. We'll assume output contiguous: out_stride_h = W, out_stride_w=1. For simplicity but correctness.
+        // Actually we should pass H,W to decode; we'll do that in final version below.
+        // Output pointer: output + n*out_stride_n + c*out_stride_c + h*out_stride_h + w*out_stride_w
+        // Since output is contiguous, this simplifies; but to be general, use n,c,h,w.
+    }
+}
+
+// Proper implementation with H,W passed.
+__global__ void add_bias_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    const float* __restrict__ bias,
+    long long total,
+    int N, int C, int H, int W,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w)
+{
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (; idx < total; idx += stride) {
+        int w = idx % W;
+        long long tmp = idx / W;
+        int h = tmp % H;
+        tmp /= H;
+        int c = tmp % C;
+        int n = tmp / C;
+
+        float b = bias[c];
+        float val = input[n * in_stride_n + c * in_stride_c + h * in_stride_h + w * in_stride_w];
+        output[n * out_stride_n + c * out_stride_c + h * out_stride_h + w * out_stride_w] = val + b;
+    }
+}
+
+extern "C" void add_bias_forward_launcher(
+    float* output,
+    const float* input,
+    const float* bias,
+    int N, int C, int H, int W,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,
+    cudaStream_t stream)
+{
+    long long total = (long long)N * C * H * W;
+    if (total <= 0) return;
+    const int threads = 256;
+    int grid = (int)min((long long)65535, (total + threads - 1) / threads);
+    if (grid == 0) grid = 1;
+    add_bias_kernel<<<grid, threads, 0, stream>>>(
+        output, input, bias, total, N, C, H, W,
+        in_stride_n, in_stride_c, in_stride_h, in_stride_w,
+        out_stride_n, out_stride_c, out_stride_h, out_stride_w
+    );
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,271 @@
+// Binding for custom ops: triu_forward, conv2d_forward, add_bias_forward
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cudnn.h>
+#include <vector>
+#include "../binding_registry.h"
+
+// Forward declarations of launchers from custom_ops.cu
+extern "C" void triu_forward_launcher(
+    float* output,
+    const float* input,
+    int N, int C, int H, int W,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,
+    cudaStream_t stream);
+
+extern "C" void add_bias_forward_launcher(
+    float* output,
+    const float* input,
+    const float* bias,
+    int N, int C, int H, int W,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,
+    cudaStream_t stream);
+
+// Helper function to check CUDA tensor properties
+static void check_cuda_float32(const torch::Tensor& t, const char* name) {
+    TORCH_CHECK(t.is_cuda(), name, " must be a CUDA tensor");
+    TORCH_CHECK(t.dtype() == torch::kFloat32, name, " must have dtype torch.float32");
+    TORCH_CHECK(t.is_contiguous(), name, " must be contiguous");
+}
+
+// triu_forward: zeros below diagonal of last two dims
+torch::Tensor triu_forward(torch::Tensor x) {
+    check_cuda_float32(x, "x");
+    TORCH_CHECK(x.dim() == 4, "triu_forward expects 4D tensor [N,C,H,W]");
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+
+    auto output = torch::empty_like(x);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Input and output are both contiguous, but we pass actual strides to be safe.
+    // Since output is empty_like, it shares strides with input (assuming same memory format).
+    // For contiguous tensors, strides are as expected.
+    long long in_stride_n = x.stride(0);
+    long long in_stride_c = x.stride(1);
+    long long in_stride_h = x.stride(2);
+    long long in_stride_w = x.stride(3);
+    long long out_stride_n = output.stride(0);
+    long long out_stride_c = output.stride(1);
+    long long out_stride_h = output.stride(2);
+    long long out_stride_w = output.stride(3);
+
+    triu_forward_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        N, C, H, W,
+        in_stride_n, in_stride_c, in_stride_h, in_stride_w,
+        out_stride_n, out_stride_c, out_stride_h, out_stride_w,
+        stream
+    );
+
+    return output;
+}
+
+// conv2d_forward using cuDNN (mandatory for convolution)
+torch::Tensor conv2d_forward(
+    torch::Tensor x,
+    torch::Tensor weight,
+    torch::Tensor bias,
+    int64_t stride = 1,
+    int64_t padding = 0,
+    int64_t dilation = 1,
+    int64_t groups = 1)
+{
+    check_cuda_float32(x, "x");
+    check_cuda_float32(weight, "weight");
+    if (bias.numel() > 0) {
+        check_cuda_float32(bias, "bias");
+    }
+    TORCH_CHECK(x.dim() == 4, "conv2d_forward expects 4D input [N,C,H,W]");
+    TORCH_CHECK(weight.dim() == 4, "conv2d_forward expects 4D weight [C_out,C_in,kH,kW]");
+
+    int N = x.size(0);
+    int C_in = x.size(1);
+    int H_in = x.size(2);
+    int W_in = x.size(3);
+    int C_out = weight.size(0);
+    int C_in_w = weight.size(1);
+    int kH = weight.size(2);
+    int kW = weight.size(3);
+
+    TORCH_CHECK(C_in == C_in_w, "conv2d_forward: input channels mismatch");
+    TORCH_CHECK(groups == 1, "conv2d_forward: only groups=1 is supported");
+    if (bias.numel() > 0) {
+        TORCH_CHECK(bias.size(0) == C_out, "conv2d_forward: bias size mismatch");
+    }
+
+    // Output dimensions
+    int H_out = (H_in + 2 * padding - dilation * (kH - 1) - 1) / stride + 1;
+    int W_out = (W_in + 2 * padding - dilation * (kW - 1) - 1) / stride + 1;
+
+    auto output = torch::empty({N, C_out, H_out, W_out}, x.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // cuDNN setup
+    cudnnHandle_t cudnn_handle;
+    CUDNN_CHECK(cudnnCreate(&cudnn_handle));
+    CUDNN_CHECK(cudnnSetStream(cudnn_handle, stream));
+
+    // Tensor descriptors
+    cudnnTensorDescriptor_t x_desc, y_desc;
+    cudnnFilterDescriptor_t w_desc;
+    cudnnConvolutionDescriptor_t conv_desc;
+
+    CUDNN_CHECK(cudnnCreateTensorDescriptor(&x_desc));
+    CUDNN_CHECK(cudnnCreateFilterDescriptor(&w_desc));
+    CUDNN_CHECK(cudnnCreateConvolutionDescriptor(&conv_desc));
+    CUDNN_CHECK(cudnnCreateTensorDescriptor(&y_desc));
+
+    // Set tensor descriptor for input: NCHW
+    CUDNN_CHECK(cudnnSetTensor4dDescriptor(
+        x_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT,
+        N, C_in, H_in, W_in));
+
+    // Filter descriptor: C_out, C_in/groups, kH, kW
+    CUDNN_CHECK(cudnnSetFilter4dDescriptor(
+        w_desc, CUDNN_DATA_FLOAT, CUDNN_TENSOR_NCHW,
+        C_out, C_in_w, kH, kW));
+
+    // Convolution descriptor
+    CUDNN_CHECK(cudnnSetConvolution2dDescriptor(
+        conv_desc,
+        padding, padding,
+        stride, stride,
+        dilation, dilation,
+        CUDNN_CROSS_CORRELATION, // PyTorch conv2d uses cross-correlation
+        CUDNN_DATA_FLOAT));
+
+    // Set math type allow TF32 if available (performance)
+    cudnnSetConvolutionMathType(conv_desc, CUDNN_TENSOR_OP_MATH_ALLOW_CONVERSION);
+
+    // Output descriptor
+    CUDNN_CHECK(cudnnSetTensor4dDescriptor(
+        y_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT,
+        N, C_out, H_out, W_out));
+
+    // Choose forward algorithm (workspace size)
+    cudnnConvolutionFwdAlgo_t algo = CUDNN_CONVOLUTION_FWD_ALGO_IMPLICIT_PRECOMP_GEMM;
+    // Could use heuristics: cudnnGetConvolutionForwardAlgorithm_v7, but implicit is fine.
+    void* workspace = nullptr;
+    size_t workspace_size = 0;
+
+    // Get workspace size for selected algo
+    CUDNN_CHECK(cudnnGetConvolutionForwardWorkspaceSize(
+        cudnn_handle, x_desc, w_desc, conv_desc, y_desc, algo, &workspace_size));
+
+    if (workspace_size > 0) {
+        cudaError_t err = cudaMalloc(&workspace, workspace_size);
+        TORCH_CHECK(err == cudaSuccess, "conv2d_forward: cudaMalloc for workspace failed");
+    }
+
+    float alpha = 1.0f;
+    float beta = 0.0f;
+
+    bool has_bias = bias.numel() > 0;
+    if (has_bias) {
+        // If bias exists, we can add it using cudnnConvolutionForward with beta=1 after setting y to bias? 
+        // Better: use cudnnConvolutionBiasActivationForward for fused conv+bias.
+        cudnnActivationDescriptor_t act_desc;
+        CUDNN_CHECK(cudnnCreateActivationDescriptor(&act_desc));
+        CUDNN_CHECK(cudnnSetActivationDescriptor(act_desc, CUDNN_ACTIVATION_IDENTITY, CUDNN_PROPAGATE_NAN, 0.0));
+        CUDNN_CHECK(cudnnConvolutionBiasActivationForward(
+            cudnn_handle,
+            &alpha,
+            x_desc, x.data_ptr<float>(),
+            w_desc, weight.data_ptr<float>(),
+            conv_desc, algo, workspace, workspace_size,
+            &beta,  // beta=0
+            y_desc, output.data_ptr<float>(),
+            // bias descriptor - use same as y? Need separate tensor for bias [1,C_out,1,1]
+            // We'll create bias desc and pass bias pointer.
+            // For NCHW, bias shape is [1,C_out,1,1]. Let's create a descriptor.
+            // Simpler: use cudnnConvolutionForward with beta=0, then add bias by cudnnAddTensor with beta=1.
+        ));
+    } else {
+        CUDNN_CHECK(cudnnConvolutionForward(
+            cudnn_handle,
+            &alpha,
+            x_desc, x.data_ptr<float>(),
+            w_desc, weight.data_ptr<float>(),
+            conv_desc, algo, workspace, workspace_size,
+            &beta,
+            y_desc, output.data_ptr<float>()));
+    }
+
+    if (workspace) {
+        cudaFree(workspace);
+    }
+
+    // Cleanup descriptors and handle
+    cudnnDestroyTensorDescriptor(x_desc);
+    cudnnDestroyFilterDescriptor(w_desc);
+    cudnnDestroyConvolutionDescriptor(conv_desc);
+    cudnnDestroyTensorDescriptor(y_desc);
+    cudnnDestroy(cudnn_handle);
+
+    return output;
+}
+
+// add_bias_forward: broadcast add bias
+torch::Tensor add_bias_forward(torch::Tensor x, torch::Tensor bias) {
+    check_cuda_float32(x, "x");
+    check_cuda_float32(bias, "bias");
+    TORCH_CHECK(x.dim() == 4, "add_bias_forward expects 4D input");
+    TORCH_CHECK(bias.dim() == 3 || bias.dim() == 1, "add_bias_forward: bias should be 1D or 3D with shape [C,1,1]");
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+
+    auto output = torch::empty_like(x);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    long long in_stride_n = x.stride(0);
+    long long in_stride_c = x.stride(1);
+    long long in_stride_h = x.stride(2);
+    long long in_stride_w = x.stride(3);
+    long long out_stride_n = output.stride(0);
+    long long out_stride_c = output.stride(1);
+    long long out_stride_h = output.stride(2);
+    long long out_stride_w = output.stride(3);
+
+    add_bias_forward_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        bias.data_ptr<float>(),
+        N, C, H, W,
+        in_stride_n, in_stride_c, in_stride_h, in_stride_w,
+        out_stride_n, out_stride_c, out_stride_h, out_stride_w,
+        stream
+    );
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("triu_forward", &triu_forward, "Apply torch.triu to last two dims",
+          py::arg("x"));
+    m.def("conv2d_forward", &conv2d_forward, "2D convolution using cuDNN",
+          py::arg("x"), py::arg("weight"), py::arg("bias"),
+          py::arg("stride") = 1, py::arg("padding") = 0,
+          py::arg("dilation") = 1, py::arg("groups") = 1);
+    m.def("add_bias_forward", &add_bias_forward, "Broadcasted addition of bias",
+          py::arg("x"), py::arg("bias"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,32 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, out_channels, kernel_size, bias_shape):
+        super().__init__()
+        # Keep the same structure as Model.__init__ for state_dict compatibility
+        self.conv = nn.Conv2d(in_channels, out_channels, kernel_size)
+        self.bias = nn.Parameter(torch.randn(bias_shape))
+
+    def forward(self, x):
+        x = cuda_extension.triu_forward(x)
+        x = cuda_extension.conv2d_forward(
+            x, self.conv.weight, self.conv.bias,
+            stride=1, padding=0, dilation=1, groups=1
+        )
+        x = cuda_extension.add_bias_forward(x, self.bias)
+        return x
+
+    def debug_forward(self, x):
+        x1 = cuda_extension.triu_forward(x)
+        yield 'step_001', x1
+        x2 = cuda_extension.conv2d_forward(
+            x1, self.conv.weight, self.conv.bias,
+            stride=1, padding=0, dilation=1, groups=1
+        )
+        yield 'step_002', x2
+        x3 = cuda_extension.add_bias_forward(x2, self.bias)
+        yield 'step_003', x3
+        yield 'step_004', x3
