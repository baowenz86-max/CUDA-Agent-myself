===== 现有 CUDA/C++ kernel 文件 =====

===== kernels/fused_activation.cu =====
#include <cuda_runtime.h>
#include <cuda_fp16.h>

// Dedicated half kernel that loads half, converts to float, applies ops, converts back.
__global__ void fused_activation_kernel_half(
    __half* __restrict__ output,
    const __half* __restrict__ input,
    int numel,
    float leakyrelu_slope,
    float pow_exponent,
    float mish_alpha,
    float relu_threshold,
    float abs_max)
{
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx < numel) {
        float x = __half2float(input[idx]);

        x = x >= 0 ? x : leakyrelu_slope * x;
        x = powf(x, pow_exponent);
        x = fabsf(x);
        float sp = log1pf(expf(mish_alpha * x));
        x = x * tanhf(sp);
        if (x < relu_threshold) x = relu_threshold;
        if (x < 0) x = 0;
        if (x > abs_max) x = abs_max;

        output[idx] = __float2half(x);
    }
}

// Fused activation kernel: LeakyReLU -> Power -> Abs -> Mish -> ReLU -> Clamp
// All operations are element-wise, no shape change.
template <typename scalar_t>
__global__ void fused_activation_kernel(
    scalar_t* __restrict__ output,
    const scalar_t* __restrict__ input,
    int numel,
    scalar_t leakyrelu_slope,
    scalar_t pow_exponent,
    scalar_t mish_alpha,
    scalar_t relu_threshold,
    scalar_t abs_max)
{
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx < numel) {
        scalar_t x = input[idx];

        // LeakyReLU: x if x >= 0 else slope * x
        x = x >= 0 ? x : leakyrelu_slope * x;

        // Power: x^pow_exponent
        // Use standard pow. For exponent 2, could optimize, but keep general.
        x = powf((float)x, (float)pow_exponent);

        // Abs
        x = fabsf((float)x);

        // Mish: x * tanh(softplus(alpha * x))
        // Note: PyTorch F.mish signature is mish(x, alpha=1). Check parameter usage. 
        // Usually Mish has no alpha, but model_new passes mish_alpha as third argument.
        // We'll implement as x * tanh(log(1 + exp(alpha * x))) to match potential alpha scaling.
        // To be safe, use alpha=1 if mish_alpha==1, else use the provided alpha.
        float xf = (float)x;
        float sp = log1pf(expf(mish_alpha * xf));
        x = xf * tanhf(sp);

        // ReLU with threshold: max(x, threshold) if x >= threshold? Actually F.relu(x, threshold)
        // In PyTorch, F.relu(input, threshold) applies threshold-based ReLU: max(input - threshold, 0) + threshold?
        // Let's recall: torch.nn.functional.relu(input, threshold=0.0, value=0.0) does max(input, threshold).
        // Wait: official docs: relu(input, threshold=0.0, value=0.0) -> max(input, threshold).
        // So threshold is the lower bound. If x < threshold, output = threshold, else x.
        // But original code: F.relu(x, self.relu_threshold) with relu_threshold=0.2, so it's max(x, 0.2).
        if (x < relu_threshold) x = relu_threshold;

        // Clamp: min=0, max=abs_max
        if (x < 0) x = 0;
        if (x > abs_max) x = abs_max;

        output[idx] = (scalar_t)x;
    }
}

// Launcher for float (float32)
extern "C" void fused_activation_float_launcher(
    float* output,
    const float* input,
    int numel,
    float leakyrelu_slope,
    float pow_exponent,
    float mish_alpha,
    float relu_threshold,
    float abs_max,
    cudaStream_t stream)
{
    const int threads = 256;
    const int blocks = (numel + threads - 1) / threads;
    fused_activation_kernel<float><<<blocks, threads, 0, stream>>>(
        output, input, numel,
        leakyrelu_slope, pow_exponent, mish_alpha, relu_threshold, abs_max);
}

// Launcher for double (float64) - may be needed for dtype dispatch, but model uses float32
extern "C" void fused_activation_double_launcher(
    double* output,
    const double* input,
    int numel,
    double leakyrelu_slope,
    double pow_exponent,
    double mish_alpha,
    double relu_threshold,
    double abs_max,
    cudaStream_t stream)
{
    const int threads = 256;
    const int blocks = (numel + threads - 1) / threads;
    fused_activation_kernel<double><<<blocks, threads, 0, stream>>>(
        output, input, numel,
        leakyrelu_slope, pow_exponent, mish_alpha, relu_threshold, abs_max);
}

// Launcher for half (float16) - if needed
extern "C" void fused_activation_half_launcher(
    __half* output,
    const __half* input,
    int numel,
    __half leakyrelu_slope,
    __half pow_exponent,
    __half mish_alpha,
    __half relu_threshold,
    __half abs_max,
    cudaStream_t stream)
{
    // Convert half parameters to float for computation
    float slope = __half2float(leakyrelu_slope);
    float exp = __half2float(pow_exponent);
    float alpha = __half2float(mish_alpha);
    float threshold = __half2float(relu_threshold);
    float max_val = __half2float(abs_max);

    const int threads = 256;
    const int blocks = (numel + threads - 1) / threads;
    fused_activation_kernel_half<<<blocks, threads, 0, stream>>>(
        output, input, numel, slope, exp, alpha, threshold, max_val);
}

