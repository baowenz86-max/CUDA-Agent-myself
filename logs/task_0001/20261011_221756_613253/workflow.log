===== kernels/fused_activation.cu =====
#include <cuda_runtime.h>
#include <cuda_fp16.h>
#include <cmath>

// Fused activation kernel: LeakyReLU -> Power -> Abs -> Mish -> ReLU -> Clamp
// All operations are element-wise, no shape change.
template <typename scalar_t>
__global__ void fused_activation_kernel(
    scalar_t* __restrict__ output,
    const scalar_t* __restrict__ input,
    int numel,
    double leakyrelu_slope,
    double pow_exponent,
    double mish_alpha,
    double relu_threshold,
    double abs_max)
{
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx < numel) {
        scalar_t x = input[idx];

        // LeakyReLU: x if x >= 0 else slope * x
        x = x >= 0 ? x : static_cast<scalar_t>(leakyrelu_slope * x);

        // Power: x^pow_exponent
        x = static_cast<scalar_t>(pow(static_cast<double>(x), pow_exponent));

        // Abs
        x = fabs(x);

        // Mish: x * tanh(softplus(alpha * x))
        double xd = static_cast<double>(x);
        double sp = log1p(exp(mish_alpha * xd));
        xd *= tanh(sp);
        x = static_cast<scalar_t>(xd);

        // ReLU with threshold: max(x, threshold)
        x = fmax(x, static_cast<scalar_t>(relu_threshold));

        // Clamp: min=0, max=abs_max
        x = fmin(fmax(x, static_cast<scalar_t>(0)), static_cast<scalar_t>(abs_max));

        output[idx] = x;
    }
}

// Specialized kernel for half: compute in float, convert back to half.
__global__ void fused_activation_kernel_half(
    __half* __restrict__ output,
    const __half* __restrict__ input,
    int numel,
    double leakyrelu_slope,
    double pow_exponent,
    double mish_alpha,
    double relu_threshold,
    double abs_max)
{
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx < numel) {
        float x = __half2float(input[idx]);

        // LeakyReLU
        x = x >= 0.0f ? x : static_cast<float>(leakyrelu_slope * x);

        // Power
        x = static_cast<float>(pow(static_cast<double>(x), pow_exponent));

        // Abs
        x = fabsf(x);

        // Mish
        double xd = static_cast<double>(x);
        double sp = log1p(exp(mish_alpha * xd));
        xd *= tanh(sp);
        x = static_cast<float>(xd);

        // ReLU with threshold
        x = fmaxf(x, static_cast<float>(relu_threshold));

        // Clamp
        x = fminf(fmaxf(x, 0.0f), static_cast<float>(abs_max));

        output[idx] = __float2half(x);
    }
}

// Launcher for float
__host__ void fused_activation_float_launcher(
    float* output,
    const float* input,
    int numel,
    double leakyrelu_slope,
    double pow_exponent,
    double mish_alpha,
    double relu_threshold,
    double abs_max,
    cudaStream_t stream)
{
    const int threads = 256;
    const int blocks = (numel + threads - 1) / threads;
    fused_activation_kernel<float><<<blocks, threads, 0, stream>>>(
        output, input, numel,
        leakyrelu_slope, pow_exponent, mish_alpha, relu_threshold, abs_max);
}

// Launcher for double
__host__ void fused_activation_double_launcher(
    double* output,
    const double* input,
    int numel,
    double leakyrelu_slope,
    double pow_exponent,
    double mish_alpha,
    double relu_threshold,
    double abs_max,
    cudaStream_t stream)
{
    const int threads = 256;
    const int blocks = (numel + threads - 1) / threads;
    fused_activation_kernel<double><<<blocks, threads, 0, stream>>>(
        output, input, numel,
        leakyrelu_slope, pow_exponent, mish_alpha, relu_threshold, abs_max);
}

// Launcher for half
__host__ void fused_activation_half_launcher(
    __half* output,
    const __half* input,
    int numel,
    double leakyrelu_slope,
    double pow_exponent,
    double mish_alpha,
    double relu_threshold,
    double abs_max,
    cudaStream_t stream)
{
    const int threads = 256;
    const int blocks = (numel + threads - 1) / threads;
    fused_activation_kernel_half<<<blocks, threads, 0, stream>>>(
        output, input, numel,
        leakyrelu_slope, pow_exponent, mish_alpha, relu_threshold, abs_max);
}

===== kernels/fused_activation_binding.cpp =====
#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>

#include <cuda_runtime.h>
#include <cuda_fp16.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

// Declare launchers from fused_activation.cu
extern "C" void fused_activation_float_launcher(
    float* output,
    const float* input,
    int numel,
    float leakyrelu_slope,
    float pow_exponent,
    float mish_alpha,
    float relu_threshold,
    float abs_max,
    cudaStream_t stream);

extern "C" void fused_activation_double_launcher(
    double* output,
    const double* input,
    int numel,
    double leakyrelu_slope,
    double pow_exponent,
    double mish_alpha,
    double relu_threshold,
    double abs_max,
    cudaStream_t stream);

extern "C" void fused_activation_half_launcher(
    __half* output,
    const __half* input,
    int numel,
    __half leakyrelu_slope,
    __half pow_exponent,
    __half mish_alpha,
    __half relu_threshold,
    __half abs_max,
    cudaStream_t stream);

// PyTorch wrapper for fused activation
torch::Tensor fused_activation_forward(
    torch::Tensor input,
    double leakyrelu_negative_slope,
    double pow_exponent,
    double mish_alpha,
    double relu_threshold,
    double abs_max) {
    // Input validation
    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
    
    // Allocate output tensor with same shape and dtype
    auto output = torch::empty_like(input);
    
    int numel = static_cast<int>(input.numel());
    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
    
    // Dispatch based on dtype
    if (input.dtype() == torch::kFloat32) {
        fused_activation_float_launcher(
            output.data_ptr<float>(),
            input.data_ptr<float>(),
            numel,
            static_cast<float>(leakyrelu_negative_slope),
            static_cast<float>(pow_exponent),
            static_cast<float>(mish_alpha),
            static_cast<float>(relu_threshold),
            static_cast<float>(abs_max),
            stream);
    } else if (input.dtype() == torch::kFloat64) {
        fused_activation_double_launcher(
            output.data_ptr<double>(),
            input.data_ptr<double>(),
            numel,
            static_cast<double>(leakyrelu_negative_slope),
            static_cast<double>(pow_exponent),
            static_cast<double>(mish_alpha),
            static_cast<double>(relu_threshold),
            static_cast<double>(abs_max),
            stream);
    } else if (input.dtype() == torch::kFloat16) {
        // Convert parameters to half
        __half slope_h = __float2half(static_cast<float>(leakyrelu_negative_slope));
        __half pow_h = __float2half(static_cast<float>(pow_exponent));
        __half alpha_h = __float2half(static_cast<float>(mish_alpha));
        __half threshold_h = __float2half(static_cast<float>(relu_threshold));
        __half absmax_h = __float2half(static_cast<float>(abs_max));
        
        fused_activation_half_launcher(
            reinterpret_cast<__half*>(output.data_ptr<at::Half>()),
            reinterpret_cast<const __half*>(input.data_ptr<at::Half>()),
            numel,
            slope_h,
            pow_h,
            alpha_h,
            threshold_h,
            absmax_h,
            stream);
    } else {
        TORCH_CHECK(false, "Unsupported dtype for fused_activation: only float32, float64, and float16 are supported");
    }
    
    return output;
}

// Registration function
void register_fused_activation(pybind11::module& m) {
    m.def("fused_activation_forward", &fused_activation_forward,
          "Fused activation: LeakyReLU -> Power -> Abs -> Mish -> ReLU -> Clamp",
          py::arg("input"),
          py::arg("leakyrelu_negative_slope"),
          py::arg("pow_exponent"),
          py::arg("mish_alpha"),
          py::arg("relu_threshold"),
          py::arg("abs_max"));
}

// Auto-register via macro
REGISTER_BINDING(fused_activation, register_fused_activation);
