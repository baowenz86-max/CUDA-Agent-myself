===== kernels/fused_activation.cu =====
#include <cuda_runtime.h>
#include <cuda_fp16.h>
#include <math_constants.h>
#include <cmath>

// Fused activation kernel: LeakyReLU -> Power -> Abs -> Mish -> ReLU -> Clamp
// All operations are element-wise, no shape change.
template <typename scalar_t>
__global__ void fused_activation_kernel(
    scalar_t* __restrict__ output,
    const scalar_t* __restrict__ input,
    int numel,
    scalar_t leakyrelu_slope,
    scalar_t pow_exponent,
    scalar_t mish_alpha,
    scalar_t relu_threshold,
    scalar_t abs_max)
{
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx < numel) {
        scalar_t x = input[idx];

        // LeakyReLU: x if x >= 0 else slope * x
        x = x >= 0 ? x : leakyrelu_slope * x;

        // Power: x^pow_exponent
        x = static_cast<scalar_t>(std::pow(static_cast<double>(x), static_cast<double>(pow_exponent)));

        // Abs
        x = static_cast<scalar_t>(std::fabs(static_cast<double>(x)));

        // Mish: x * tanh(softplus(alpha * x))
        double xd = static_cast<double>(x);
        double sp = std::log1p(std::exp(static_cast<double>(mish_alpha) * xd));
        xd *= std::tanh(sp);
        x = static_cast<scalar_t>(xd);

        // ReLU with threshold: max(x, threshold)
        x = static_cast<scalar_t>(std::fmax(static_cast<double>(x), static_cast<double>(relu_threshold)));

        // Clamp: min=0, max=abs_max
        x = static_cast<scalar_t>(std::fmin(std::fmax(static_cast<double>(x), 0.0), static_cast<double>(abs_max)));

        output[idx] = x;
    }
}

// Specialized kernel for half: compute in float, convert back to half.
__global__ void fused_activation_kernel_half(
    __half* __restrict__ output,
    const __half* __restrict__ input,
    int numel,
    float leakyrelu_slope,
    float pow_exponent,
    float mish_alpha,
    float relu_threshold,
    float abs_max)
{
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx < numel) {
        float x = __half2float(input[idx]);

        // LeakyReLU
        x = x >= 0.0f ? x : leakyrelu_slope * x;

        // Power
        x = std::pow(x, pow_exponent);

        // Abs
        x = std::fabs(x);

        // Mish
        float sp = std::log1p(std::exp(mish_alpha * x));
        x = x * std::tanh(sp);

        // ReLU with threshold
        x = std::fmax(x, relu_threshold);

        // Clamp
        x = std::fmin(std::fmax(x, 0.0f), abs_max);

        output[idx] = __float2half(x);
    }
}

// Launcher for float
extern "C" void fused_activation_float_launcher(
    float* output,
    const float* input,
    int numel,
    float leakyrelu_slope,
    float pow_exponent,
    float mish_alpha,
    float relu_threshold,
    float abs_max,
    cudaStream_t stream)
{
    const int threads = 256;
    const int blocks = (numel + threads - 1) / threads;
    fused_activation_kernel<float><<<blocks, threads, 0, stream>>>(
        output, input, numel,
        leakyrelu_slope, pow_exponent, mish_alpha, relu_threshold, abs_max);
}

// Launcher for double
extern "C" void fused_activation_double_launcher(
    double* output,
    const double* input,
    int numel,
    double leakyrelu_slope,
    double pow_exponent,
    double mish_alpha,
    double relu_threshold,
    double abs_max,
    cudaStream_t stream)
{
    const int threads = 256;
    const int blocks = (numel + threads - 1) / threads;
    fused_activation_kernel<double><<<blocks, threads, 0, stream>>>(
        output, input, numel,
        leakyrelu_slope, pow_exponent, mish_alpha, relu_threshold, abs_max);
}

// Launcher for half
extern "C" void fused_activation_half_launcher(
    __half* output,
    const __half* input,
    int numel,
    __half leakyrelu_slope,
    __half pow_exponent,
    __half mish_alpha,
    __half relu_threshold,
    __half abs_max,
    cudaStream_t stream)
{
    // Convert half parameters to float for computation
    float slope = __half2float(leakyrelu_slope);
    float exp = __half2float(pow_exponent);
    float alpha = __half2float(mish_alpha);
    float threshold = __half2float(relu_threshold);
    float max_val = __half2float(abs_max);

    const int threads = 256;
    const int blocks = (numel + threads - 1) / threads;
    fused_activation_kernel_half<<<blocks, threads, 0, stream>>>(
        output, input, numel, slope, exp, alpha, threshold, max_val);
}

