--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,36 @@
+#include <cuda_runtime.h>
+#include <math.h>
+
+// Elementwise hyperbolic tangent kernel for float32 tensors.
+// Grid-stride loop ensures all elements are processed even if grid size
+// does not cover the entire tensor.
+__global__ void custom_tanh_kernel(float* __restrict__ output,
+                                   const float* __restrict__ input,
+                                   int64_t numel) {
+    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        output[i] = tanhf(input[i]);
+    }
+}
+
+// C-interface launcher for the custom tanh operation.
+// The binding layer (C++) will call this function after validating
+// that input and output are CUDA tensors of dtype float32 and that
+// output is allocated with the same shape as input.
+// No PyTorch dependencies are included here.
+extern "C" void custom_tanh_launcher(float* output,
+                                     const float* input,
+                                     int64_t numel,
+                                     cudaStream_t stream) {
+    // Launch kernel with 256 threads per block and enough blocks to
+    // saturate the GPU, but with grid-stride loop the grid can be limited.
+    // Use grid size capped at 32 blocks per SM times number of SMs? Simpler:
+    // blockDim = 256, gridDim = min((numel + 255) / 256, 4096) which is ample.
+    int block_size = 256;
+    int64_t num_blocks_64 = (numel + block_size - 1) / block_size;
+    if (num_blocks_64 > 4096) num_blocks_64 = 4096;
+    int num_blocks = (int)num_blocks_64;
+    custom_tanh_kernel<<<num_blocks, block_size, 0, stream>>>(
+        output, input, numel);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,57 @@
+// PyTorch binding for custom tanh CUDA kernel
+// This file handles tensor validation, memory allocation, stream management,
+// and Python registration. The actual CUDA kernel is in custom_ops.cu.
+
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Launcher declared in custom_ops.cu
+extern "C" void custom_tanh_launcher(float* output,
+                                     const float* input,
+                                     int64_t numel,
+                                     cudaStream_t stream);
+
+// PyTorch wrapper for the custom tanh operation.
+// Input: x - CUDA tensor of dtype float32, any shape acceptable but must be finite.
+// Output: new tensor of same shape, dtype, device, computed tanh elementwise.
+torch::Tensor custom_tanh(torch::Tensor x) {
+    // Validate device
+    TORCH_CHECK(x.is_cuda(), "custom_tanh: input must be a CUDA tensor");
+    // Validate dtype
+    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "custom_tanh: input must be float32");
+    // Ensure contiguous layout for linear element access in kernel
+    auto x_contig = x.contiguous();
+
+    // Allocate output with same shape as contiguous input (identical to original shape)
+    auto output = torch::empty_like(x_contig);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Launch kernel
+    custom_tanh_launcher(
+        output.data_ptr<float>(),
+        x_contig.data_ptr<float>(),
+        x_contig.numel(),
+        stream
+    );
+
+    // Check for kernel launch errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "custom_tanh: CUDA kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// Registration function called by BindingRegistry
+void register_custom_tanh(pybind11::module& m) {
+    m.def("custom_tanh", &custom_tanh,
+          "Custom Tanh (CUDA)",
+          pybind11::arg("x"));
+}
+
+// Auto-register binding
+REGISTER_BINDING(custom_tanh, register_custom_tanh);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,14 @@
+import torch
+import torch.nn as nn
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return torch.ops.cuda_extension.custom_tanh(x)
+
+    def debug_forward(self, x: torch.Tensor):
+        y = torch.ops.cuda_extension.custom_tanh(x)
+        yield 'step_001', y
