{
  "operators": [
    {
      "name": "batchnorm_inference",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[16, 768, 64, 64]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[768]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[768]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[768]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[768]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[16, 768, 64, 64]"
      },
      "semantics": [
        "Computes BatchNorm2d inference: y = (x - running_mean) / sqrt(running_var + eps) * weight + bias, applied per-channel over N,H,W.",
        "If weight is None, it is treated as 1; if bias is None, it is treated as 0.",
        "running_mean and running_var are per-channel 1D tensors.",
        "Output is contiguous and has the same shape as x."
      ]
    },
    {
      "name": "triplet_margin_loss_sum",
      "parameters": [
        {
          "name": "anchor",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[16, 768, 64, 64]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "positive",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[16, 768, 64, 64]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "negative",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[16, 768, 64, 64]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "margin",
          "kind": "float",
          "nullable": false,
          "optional": false
        },
        {
          "name": "p",
          "kind": "int",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[]"
      },
      "semantics": [
        "Computes TripletMarginLoss with reduction='sum': loss = sum_i max(d(anchor_i, positive_i) - d(anchor_i, negative_i) + margin, 0).",
        "d(x,y) = ||x - y||_p = (sum_j |x_j - y_j|^p)^(1/p).",
        "p=2 is used in this task, so d is Euclidean distance.",
        "The output is a scalar tensor (shape [])."
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.batchnorm(x)",
      "semantics": [
        "BatchNorm2d inference on x using running_mean, running_var, weight, bias, and eps.",
        "y = (x - running_mean) / sqrt(running_var + eps) * weight + bias.",
        "Per-channel affine transform over N,H,W dimensions."
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "loss = self.triplet_loss(input_anchor, input_positive, input_negative)",
      "semantics": [
        "TripletMarginLoss with margin=1.0, p=2, reduction='sum'.",
        "loss = sum_i max(||anchor_i - positive_i||_2 - ||anchor_i - negative_i||_2 + 1.0, 0).",
        "Output is a scalar tensor."
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return (x, loss)",
      "semantics": [
        "Returns a tuple containing the batchnorm output x and the scalar loss tensor."
      ]
    }
  ]
}