{
  "operators": [
    {
      "name": "batch_norm_eval_2d",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C, H, W]"
      },
      "semantics": [
        "Computes y = (x - running_mean) / sqrt(running_var + eps) * weight + bias for each channel c.",
        "Broadcasts weight, bias, running_mean, running_var over N,H,W dimensions.",
        "Assumes evaluation mode: uses running statistics, not batch statistics.",
        "Input x must be contiguous float32 on CUDA."
      ]
    },
    {
      "name": "triplet_margin_loss_sum",
      "parameters": [
        {
          "name": "anchor",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "positive",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "negative",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "margin",
          "kind": "float",
          "nullable": false,
          "optional": false
        },
        {
          "name": "p",
          "kind": "int",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[]"
      },
      "semantics": [
        "Computes triplet margin loss with Lp distance (p=2) and reduction='sum'.",
        "For each sample in batch: d_pos = ||anchor - positive||_p, d_neg = ||anchor - negative||_p, loss_i = max(d_pos - d_neg + margin, 0).",
        "Returns the sum of loss_i over the batch as a scalar tensor.",
        "Implements stable reduction using summation over elements.",
        "Assumes input tensors are float32 contiguous on CUDA."
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.batchnorm(x)",
      "semantics": [
        "Normalizes x using running_mean and running_var, then scales and shifts with weight and bias per channel.",
        "BatchNorm2d in evaluation mode uses running statistics, eps=1e-05.",
        "Returns tensor of same shape as x."
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "loss = self.triplet_loss(input_anchor, input_positive, input_negative)",
      "semantics": [
        "Computes scalar triplet margin loss with margin=1.0, p=2, reduction='sum'.",
        "Uses Euclidean distance between flattened anchor, positive, negative tensors per batch sample.",
        "Returns scalar tensor on CUDA."
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return (x, loss)",
      "semantics": [
        "Returns a tuple containing the normalized x tensor and the scalar loss tensor."
      ]
    }
  ]
}