{
  "operators": [
    {
      "name": "custom_abs",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference step",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "对应参考语句 x = torch.abs(x)",
        "逐元素计算绝对值，不支持 inplace",
        "保持输入 shape、dtype、device",
        "输出张量与输入形状相同"
      ]
    },
    {
      "name": "custom_layer_norm",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference step",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as normalized_shape (3, 300, 300)",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as weight",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "shape": null,
          "layout": null,
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "对应参考语句 x = self.layer_norm(x)",
        "对输入 x 的最后 n 个维度进行 LayerNorm，n = len(weight.shape) = 3",
        "计算每个 sample 在最后三维上的 mean 和 variance，使用 eps 进行数值稳定",
        "应用 affine 变换：output = (x - mean) / sqrt(var + eps) * weight + bias",
        "weight 和 bias 的形状与归一化维度相同，如果为 None 则跳过相应 affine 部分",
        "返回形状与输入相同的张量，float32 cuda"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = torch.abs(x)",
      "semantics": [
        "计算输入张量 x 的逐元素绝对值，输出为新的 float32 张量，形状为输入形状 (512, 3, 300, 300)，设备为 cuda:0"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.layer_norm(x)",
      "semantics": [
        "使用预训练的 nn.LayerNorm 模块，对输入张量 x 的最后三维 (3, 300, 300) 进行层归一化，weight 和 bias 形状为 (3, 300, 300)，输出形状 (512, 3, 300, 300)，float32，cuda:0"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回 step_002 的结果，即 LayerNorm 输出张量"
      ]
    }
  ]
}