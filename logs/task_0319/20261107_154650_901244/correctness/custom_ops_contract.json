{
  "operators": [
    {
      "name": "mha_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[256, 32, 512]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "in_proj_weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[1536, 512]",
          "layout": "row-major contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "in_proj_bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[1536]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "out_proj_weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[512, 512]",
          "layout": "row-major contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "out_proj_bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[512]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tuple",
        "description": "tuple(attn_output, attn_weights)",
        "dtype": "not applicable",
        "device": "not applicable",
        "shape": "not applicable"
      },
      "semantics": [
        "对应 self.multihead_attention(x,x,x) 内部计算，无 mask，need_weights=True，平均注意力权重。",
        "先做 in_projection: x @ in_proj_weight^T + in_proj_bias，得到 query, key, value，形状 [256, 32, 512]。",
        "重塑为 [256*32, 4, 128] 并转置为 [4, 256*32, 128]，num_heads=4。",
        "计算缩放点积注意力：q @ k^T / sqrt(128)，softmax 在最后一个维度，attn @ v。",
        "将输出转置并重塑回 [256*32, 512]，然后应用 out_projection: out @ out_proj_weight^T + out_proj_bias。",
        "返回 tuple(attn_output, attn_weights_avg)，其中 attn_weights_avg 形状 [32, 256, 256]（batch 平均）。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x, _ = self.multihead_attention(x, x, x)",
      "semantics": [
        "执行整个多头注意力，返回 tuple[attn_output, attn_weights]。",
        "输入 x 形状 [256, 32, 512]，输出 x 形状相同。",
        "attn_weights 形状 [32, 256, 256]，是 4 个头注意力权重的平均。",
        "忽略第二个返回值，因此 forward 最终返回 attn_output。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "return x",
      "semantics": [
        "返回上一步得到的 attn_output 张量。"
      ]
    }
  ]
}