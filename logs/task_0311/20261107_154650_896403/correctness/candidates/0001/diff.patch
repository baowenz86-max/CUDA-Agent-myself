--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,34 @@
+#include <cuda_runtime.h>
+
+// Elementwise Leaky ReLU kernel with grid-stride loop.
+// Each thread processes multiple elements if numel exceeds grid size.
+__global__ void leaky_relu_kernel(const float* __restrict__ input,
+                                  float* __restrict__ output,
+                                  int64_t numel,
+                                  float negative_slope) {
+    int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    int64_t stride = static_cast<int64_t>(blockDim.x) * gridDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        float val = input[i];
+        output[i] = (val >= 0.0f) ? val : (negative_slope * val);
+    }
+}
+
+// Host launcher: raw pointers, scalar negative_slope, total element count,
+// and the current CUDA stream. No PyTorch dependencies.
+extern "C" void leaky_relu_forward_launcher(const float* input,
+                                            float* output,
+                                            int64_t numel,
+                                            float negative_slope,
+                                            cudaStream_t stream) {
+    if (numel <= 0) return;
+
+    const int threads = 256;
+    // Cap grid to avoid exceeding maximum grid dimension, use grid-stride loop.
+    int64_t blocks64 = (numel + threads - 1) / threads;
+    const int64_t max_blocks = 65535; // typical maximum for x dimension
+    if (blocks64 > max_blocks) blocks64 = max_blocks;
+    int grid = static_cast<int>(blocks64);
+
+    leaky_relu_kernel<<<grid, threads, 0, stream>>>(input, output, numel, negative_slope);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,50 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+
+#include "../binding_registry.h"
+
+// Launcher declaration matches custom_ops.cu
+extern "C" void leaky_relu_forward_launcher(const float* input,
+                                            float* output,
+                                            int64_t numel,
+                                            float negative_slope,
+                                            cudaStream_t stream);
+
+// PyTorch binding for leaky_relu_forward
+torch::Tensor leaky_relu_forward(torch::Tensor x, double negative_slope) {
+    // Validate input tensor
+    TORCH_CHECK(x.is_cuda(), "Input tensor must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input tensor must have dtype torch.float32");
+    TORCH_CHECK(x.is_contiguous(), "Input tensor must be contiguous");
+
+    // Allocate output tensor with same shape and options
+    auto output = torch::empty_like(x);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher with raw pointers
+    leaky_relu_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        x.numel(),
+        static_cast<float>(negative_slope),
+        stream
+    );
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("leaky_relu_forward", &leaky_relu_forward,
+          "Leaky ReLU forward (CUDA)",
+          py::arg("x"),
+          py::arg("negative_slope"));
+}
+
+// Auto-register binding
+REGISTER_BINDING(custom_ops, register_custom_ops);
