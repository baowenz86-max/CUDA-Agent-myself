{
  "operators": [
    {
      "name": "custom_abs_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[512, 16, 256, 256]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "逐元素计算绝对值，结果形状、dtype、device 与输入相同",
        "对应参考语句 x = torch.abs(x)"
      ]
    },
    {
      "name": "custom_flip_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[512, 16, 256, 256]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dims",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "dim2",
          "kind": "int",
          "optional": true,
          "nullable": false,
          "default": 3
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "沿指定维度翻转张量，参考实现中 dims 为 (2,3)，因此翻转第2和第3维",
        "参数 dims 表示第一个翻转维度，dim2 表示第二个翻转维度（默认3）",
        "输出与输入形状、dtype、device 相同"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = torch.abs(x)",
      "semantics": [
        "计算输入张量的绝对值，输出 shape/dtype/device 与输入相同"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.flip(x, self.flip_dims)",
      "semantics": [
        "沿 self.flip_dims 指定的维度翻转 x（实际为 (2,3)），输出 shape/dtype/device 与输入相同"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回最终 flipped 张量"
      ]
    }
  ]
}