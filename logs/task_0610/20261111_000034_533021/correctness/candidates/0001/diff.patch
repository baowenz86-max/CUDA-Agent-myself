+++ after/kernels/custom_ops.cu
@@ -0,0 +1,94 @@
+#include <cuda_runtime.h>
+
+// BatchNorm1d forward kernel (eval mode)
+// Computes: y[n,c,l] = (input[n,c,l] - running_mean[c]) / sqrt(running_var[c] + eps) * weight[c] + bias[c]
+// If weight is null: omit weight multiplication (default 1.0)
+// If bias is null: omit bias addition (default 0.0)
+// Supports non-contiguous input via explicit strides.
+__global__ void batch_norm_1d_forward_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    const float* __restrict__ running_mean,
+    const float* __restrict__ running_var,
+    const float* __restrict__ weight,
+    const float* __restrict__ bias,
+    int N, int C, int L,
+    long long input_stride_n,   // stride in bytes? no, we will pass element strides from launcher
+    long long input_stride_c,
+    long long input_stride_l,
+    long long output_stride_n,
+    long long output_stride_c,
+    long long output_stride_l,
+    float eps
+) {
+    // Grid-stride loop over flat index of output elements, assuming output shape [N,C,L]
+    int total = N * C * L;
+    for (int idx = blockIdx.x * blockDim.x + threadIdx.x; idx < total; idx += gridDim.x * blockDim.x) {
+        // decompose idx into (n,c,l)
+        int n = idx / (C * L);
+        int rem = idx - n * (C * L);
+        int c = rem / L;
+        int l = rem - c * L;
+
+        // compute input and output addresses using strides
+        const float* in_ptr = input + n * input_stride_n + c * input_stride_c + l * input_stride_l;
+        float* out_ptr = output + n * output_stride_n + c * output_stride_c + l * output_stride_l;
+
+        float mean = running_mean[c];
+        float var = running_var[c];
+        float inv_std = rsqrtf(var + eps);
+        float val = (*in_ptr - mean) * inv_std;
+        if (weight != nullptr) {
+            val *= weight[c];
+        }
+        if (bias != nullptr) {
+            val += bias[c];
+        }
+        *out_ptr = val;
+    }
+}
+
+// Launcher (C interface, no PyTorch dependencies)
+// Parameters:
+//   input, output: pointers to float arrays
+//   running_mean, running_var: valid pointers (size C)
+//   weight, bias: may be nullptr, size C if non-null
+//   N, C, L: dimensions
+//   strides: element counts between consecutive elements in each dimension
+//   eps: epsilon value (float, passed as float; contract uses double but converts)
+//   stream: CUDA stream to launch on
+extern "C" void batch_norm_1d_forward_launcher(
+    const float* input,
+    float* output,
+    const float* running_mean,
+    const float* running_var,
+    const float* weight,
+    const float* bias,
+    int N, int C, int L,
+    long long input_stride_n,
+    long long input_stride_c,
+    long long input_stride_l,
+    long long output_stride_n,
+    long long output_stride_c,
+    long long output_stride_l,
+    float eps,
+    cudaStream_t stream
+) {
+    int total = N * C * L;
+    if (total <= 0) return;
+
+    // Choose block size and grid size for good occupancy
+    const int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    // Cap blocks to a reasonable number to avoid excessive grid launch overhead; grid-stride loop handles rest
+    const int max_blocks = 65535; // safe for all GPUs
+    if (blocks > max_blocks) blocks = max_blocks;
+
+    batch_norm_1d_forward_kernel<<<blocks, threads, 0, stream>>>(
+        input, output, running_mean, running_var, weight, bias,
+        N, C, L,
+        input_stride_n, input_stride_c, input_stride_l,
+        output_stride_n, output_stride_c, output_stride_l,
+        eps
+    );
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,128 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include <c10/util/Optional.h>
+#include "../binding_registry.h"
+
+// Declare launcher from .cu file
+extern "C" void batch_norm_1d_forward_launcher(
+    const float* input,
+    float* output,
+    const float* running_mean,
+    const float* running_var,
+    const float* weight,
+    const float* bias,
+    int N, int C, int L,
+    long long input_stride_n,
+    long long input_stride_c,
+    long long input_stride_l,
+    long long output_stride_n,
+    long long output_stride_c,
+    long long output_stride_l,
+    float eps,
+    cudaStream_t stream
+);
+
+torch::Tensor batch_norm_1d_forward(
+    torch::Tensor input,
+    c10::optional<torch::Tensor> weight,
+    c10::optional<torch::Tensor> bias,
+    torch::Tensor running_mean,
+    torch::Tensor running_var,
+    double eps) {
+    // Check input tensor
+    TORCH_CHECK(input.dim() == 3, "input must be 3D (N, C, L)");
+    TORCH_CHECK(input.scalar_type() == torch::kFloat32, "input must be float32");
+
+    // Ensure input is on CUDA
+    if (!input.is_cuda()) {
+        input = input.cuda();
+    }
+
+    int N = input.size(0);
+    int C = input.size(1);
+    int L = input.size(2);
+
+    // Check running_mean and running_var
+    TORCH_CHECK(running_mean.is_cuda(), "running_mean must be a CUDA tensor");
+    TORCH_CHECK(running_var.is_cuda(), "running_var must be a CUDA tensor");
+    TORCH_CHECK(running_mean.scalar_type() == torch::kFloat32, "running_mean must be float32");
+    TORCH_CHECK(running_var.scalar_type() == torch::kFloat32, "running_var must be float32");
+    TORCH_CHECK(running_mean.is_contiguous(), "running_mean must be contiguous");
+    TORCH_CHECK(running_var.is_contiguous(), "running_var must be contiguous");
+    TORCH_CHECK(running_mean.numel() == C, "running_mean shape mismatch");
+    TORCH_CHECK(running_var.numel() == C, "running_var shape mismatch");
+
+    // Check weight and bias if provided, ensure contiguous and on CUDA
+    torch::Tensor weight_contig;
+    torch::Tensor bias_contig;
+    const float* weight_ptr = nullptr;
+    const float* bias_ptr = nullptr;
+
+    if (weight.has_value() && weight->defined()) {
+        TORCH_CHECK(weight->is_cuda(), "weight must be a CUDA tensor");
+        TORCH_CHECK(weight->scalar_type() == torch::kFloat32, "weight must be float32");
+        TORCH_CHECK(weight->is_contiguous(), "weight must be contiguous");
+        TORCH_CHECK(weight->numel() == C, "weight shape mismatch");
+        weight_contig = weight->contiguous();
+        weight_ptr = weight_contig.data_ptr<float>();
+    }
+
+    if (bias.has_value() && bias->defined()) {
+        TORCH_CHECK(bias->is_cuda(), "bias must be a CUDA tensor");
+        TORCH_CHECK(bias->scalar_type() == torch::kFloat32, "bias must be float32");
+        TORCH_CHECK(bias->is_contiguous(), "bias must be contiguous");
+        TORCH_CHECK(bias->numel() == C, "bias shape mismatch");
+        bias_contig = bias->contiguous();
+        bias_ptr = bias_contig.data_ptr<float>();
+    }
+
+    // Allocate output tensor with same shape as input (contiguous)
+    auto output = torch::empty_like(input, input.options());
+
+    // Get strides for input (element-wise, not bytes)
+    auto input_strides = input.strides();
+    // PyTorch strides are in elements, same as launcher expects
+    long long input_stride_n = input_strides[0];
+    long long input_stride_c = input_strides[1];
+    long long input_stride_l = input_strides[2];
+
+    // Output is contiguous, so its strides are C*L, L, 1
+    long long output_stride_n = static_cast<long long>(C) * L;
+    long long output_stride_c = L;
+    long long output_stride_l = 1;
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    batch_norm_1d_forward_launcher(
+        input.data_ptr<float>(),
+        output.data_ptr<float>(),
+        running_mean.data_ptr<float>(),
+        running_var.data_ptr<float>(),
+        weight_ptr,
+        bias_ptr,
+        N, C, L,
+        input_stride_n, input_stride_c, input_stride_l,
+        output_stride_n, output_stride_c, output_stride_l,
+        static_cast<float>(eps),
+        stream
+    );
+
+    return output;
+}
+
+void register_batch_norm_1d(pybind11::module& m) {
+    m.def("batch_norm_1d_forward", &batch_norm_1d_forward,
+          "BatchNorm1d forward (eval mode)",
+          py::arg("input"),
+          py::arg("weight"),
+          py::arg("bias"),
+          py::arg("running_mean"),
+          py::arg("running_var"),
+          py::arg("eps") = 1e-05);
+}
+
+REGISTER_BINDING(batch_norm_1d, register_batch_norm_1d);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,38 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, num_features, eps=1e-5, momentum=0.1, affine=True, track_running_stats=True):
+        super().__init__()
+        self.batch_norm = nn.BatchNorm1d(
+            num_features, eps=eps, momentum=momentum, affine=affine, track_running_stats=track_running_stats
+        )
+
+    def forward(self, x):
+        x_norm = cuda_extension.batch_norm_1d_forward(
+            x,
+            self.batch_norm.weight,
+            self.batch_norm.bias,
+            self.batch_norm.running_mean,
+            self.batch_norm.running_var,
+            self.batch_norm.eps
+        )
+        x_equal = torch.equal(x, x_norm)
+        return x_equal, x_norm
+
+    def debug_forward(self, *inputs):
+        x = inputs[0]
+        x_norm = cuda_extension.batch_norm_1d_forward(
+            x,
+            self.batch_norm.weight,
+            self.batch_norm.bias,
+            self.batch_norm.running_mean,
+            self.batch_norm.running_var,
+            self.batch_norm.eps
+        )
+        yield ('step_001', x_norm)
+        x_equal = torch.equal(x, x_norm)
+        yield ('step_002', x_equal)
+        yield ('step_003', (x_equal, x_norm))
