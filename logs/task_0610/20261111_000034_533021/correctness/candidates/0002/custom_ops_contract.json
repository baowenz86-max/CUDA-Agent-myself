{
  "operators": [
    {
      "name": "batch_norm_1d_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, L]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "default": 1e-05,
          "nullable": false,
          "optional": true
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C, L]"
      },
      "semantics": [
        "计算 BatchNorm1d 在 eval 模式下的输出：y = (x - running_mean) / sqrt(running_var + eps) * weight + bias，当 weight 或 bias 为 None 时省略对应项",
        "对通道维度 C 逐个归一化，N 和 L 维度保持不变",
        "输入可以为非连续 stride，weight/bias/running_mean/running_var 强制连续；若输入不在 CUDA 上，先移动到 CUDA",
        "eps 使用默认值 1e-5，与 nn.BatchNorm1d 一致"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x_norm = self.batch_norm(x)",
      "semantics": [
        "BatchNorm1d 前向，使用 running_mean 和 running_var 进行归一化",
        "shape 与输入相同 [64, 128, 16384]，dtype float32，device cuda:0"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x_equal = torch.equal(x, x_norm)",
      "semantics": [
        "比较原始输入和归一化输出，因数值不同返回 Python bool False"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return (x_equal, x_norm)",
      "semantics": [
        "返回元组 (bool, tensor)，其中 bool 为 torch.equal 结果，tensor 为归一化输出"
      ]
    }
  ]
}