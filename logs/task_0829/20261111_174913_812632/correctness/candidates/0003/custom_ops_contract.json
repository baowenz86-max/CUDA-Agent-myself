{
  "operators": [
    {
      "name": "multihead_attention_forward",
      "parameters": [
        {
          "name": "query",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, seq_len, embed_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "key",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, seq_len, embed_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "value",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, seq_len, embed_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "in_proj_weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[3 * embed_dim, embed_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "in_proj_bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[3 * embed_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "out_proj_weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[embed_dim, embed_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "out_proj_bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[embed_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "embed_dim",
          "kind": "int",
          "default": 128,
          "optional": true
        },
        {
          "name": "num_heads",
          "kind": "int",
          "default": 4,
          "optional": true
        },
        {
          "name": "batch_first",
          "kind": "bool",
          "default": true,
          "optional": true
        },
        {
          "name": "add_zero_attn",
          "kind": "bool",
          "default": false,
          "optional": true
        },
        {
          "name": "is_causal",
          "kind": "bool",
          "default": false,
          "optional": true
        },
        {
          "name": "key_padding_mask",
          "kind": "tensor",
          "dtype": "torch.bool",
          "device": "cuda",
          "shape": "[batch_size, seq_len] or None",
          "layout": "supports strides",
          "nullable": true,
          "optional": true,
          "default": null
        },
        {
          "name": "attn_mask",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[seq_len, seq_len] or [batch_size * num_heads, seq_len, seq_len] or None",
          "layout": "supports strides",
          "nullable": true,
          "optional": true,
          "default": null
        },
        {
          "name": "need_weights",
          "kind": "bool",
          "default": true,
          "optional": true
        },
        {
          "name": "average_attn_weights",
          "kind": "bool",
          "default": true,
          "optional": true
        }
      ],
      "returns": {
        "type": "tuple",
        "items": [
          {
            "type": "tensor",
            "dtype": "torch.float32",
            "device": "cuda",
            "shape": "[batch_size, seq_len, embed_dim]"
          },
          {
            "type": "tensor",
            "dtype": "torch.float32",
            "device": "cuda",
            "shape": "[batch_size, seq_len, seq_len]"
          }
        ]
      },
      "semantics": [
        "对应参考语句 x, _ = self.attention(query, key, value)，实现 nn.MultiheadAttention 前向计算。",
        "内部计算包括：in_proj 线性变换（query, key, value 分别乘以 in_proj_weight 对应部分并加上 in_proj_bias），然后 reshape 为多头形式，计算缩放点积注意力，应用 out_proj 线性变换。",
        "返回 tuple (attn_output, attn_weights)，attn_output 的 shape 与 query 相同，attn_weights 为注意力权重（当 need_weights=True 时返回，否则返回 None，但本任务中 need_weights 恒为 True）。",
        "支持 batch_first=True，输入输出均为 [batch_size, seq_len, embed_dim]。",
        "参数 add_zero_attn, is_causal, key_padding_mask, attn_mask 按 nn.MultiheadAttention 的语义处理，但本任务中不会传入非默认值。"
      ]
    },
    {
      "name": "matmul_forward",
      "parameters": [
        {
          "name": "a",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, seq_len, embed_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "b",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, embed_dim, seq_len]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, seq_len, seq_len]"
      },
      "semantics": [
        "对应参考语句 out = torch.matmul(x, value.transpose(1, 2))，实现批量矩阵乘法。",
        "输入 a 与 b 为三维张量，b 是 value 的转置（shape [batch_size, embed_dim, seq_len]），输出为 batch_size 个 seq_len x seq_len 的矩阵乘积。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x, _ = self.attention(query, key, value)",
      "semantics": [
        "执行 nn.MultiheadAttention 前向，返回 tuple (attn_output, attn_weights)。",
        "attn_output shape [32, 1024, 128]，attn_weights shape [32, 1024, 1024]。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "return torch.matmul(x, value.transpose(1, 2))",
      "semantics": [
        "对注意力输出 x 与 value 的转置进行批量矩阵乘法，得到 shape [32, 1024, 1024] 的输出。"
      ]
    }
  ]
}