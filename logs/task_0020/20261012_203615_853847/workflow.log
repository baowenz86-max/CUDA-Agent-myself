    "model_new.py": "import torch\nimport torch.nn as nn\nimport cuda_extension\n\n\nclass ModelNew(nn.Module):\n    def __init__(\n        self, in_channels, out_channels, kernel_size, stride, padding, output_padding, num_embeddings, embedding_dim\n    ):\n        super().__init__()\n        # 保持与原始 nn.ConvTranspose1d 和 nn.Embedding 相同的参数结构\n        self.conv_transpose1d = nn.ConvTranspose1d(\n            in_channels, out_channels, kernel_size, stride=stride, padding=padding, output_padding=output_padding\n        )\n        self.embedding = nn.Embedding(num_embeddings, embedding_dim)\n        # 缓存标量参数供自定义算子使用\n        self.in_channels = in_channels\n        self.out_channels = out_channels\n        self.kernel_size = kernel_size\n        self.stride = stride\n        self.padding = padding\n        self.output_padding = output_padding\n        self.num_embeddings = num_embeddings\n        self.embedding_dim = embedding_dim\n\n    def forward(self, x, indices):\n        # 步骤1: ConvTranspose1d\n        x = cuda_extension.conv_transpose1d_forward(\n            x,\n            self.conv_transpose1d.weight,\n            self.conv_transpose1d.bias,\n            self.kernel_size,\n            self.stride,\n            self.padding,\n            self.output_padding,\n        )\n        # 步骤2: sign\n        x = cuda_extension.sign_forward(x)\n        # 步骤3: embedding\n        embedded = cuda_extension.embedding_forward(\n            indices,\n            self.embedding.weight,\n        )\n        return x, embedded\n\n    def debug_forward(self, x, indices):\n        # 按 checkpoints 顺序 yield (id, value)\n        x = cuda_extension.conv_transpose1d_forward(\n            x,\n            self.conv_transpose1d.weight,\n            self.conv_transpose1d.bias,\n            self.kernel_size,\n            self.stride,\n            self.padding,\n            self.output_padding,\n        )\n        yield \"step_001\", x\n        x = cuda_extension.sign_forward(x)\n        yield \"step_002\", x\n        embedded = cuda_extension.embedding_forward(\n            indices,\n            self.embedding.weight,\n        )\n        yield \"step_003\", embedded\n        result = (x, embedded)\n        yield \"step_004\", result\n        return  # debug_forward 是一个 generator，不需要显式返回 result",
    "kernels/custom_ops.cu": "#include <cuda_runtime.h>\n\n// ConvTranspose1d kernel\n// Input: (batch, in_channels, length_in)\n// Weight: (in_channels, out_channels, kernel_size)\n// Bias: (out_channels)\n// Output: (batch, out_channels, length_out)\n// length_out = (length_in - 1) * stride - 2 * padding + kernel_size + output_padding\n// All tensors assumed contiguous.\n__global__ void conv_transpose1d_kernel(\n    const float* __restrict__ input,\n    const float* __restrict__ weight,\n    const float* __restrict__ bias,\n    float* __restrict__ output,\n    int batch_size,\n    int in_channels,\n    int out_channels,\n    int length_in,\n    int length_out,\n    int kernel_size,\n    int stride,\n    int padding,\n    int output_padding)\n{\n    int total = batch_size * out_channels * length_out;\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int stride_total = blockDim.x * gridDim.x;\n    for (int i = idx; i < total; i += stride_total) {\n        int l_out = i % length_out;\n        int tmp = i / length_out;\n        int oc = tmp % out_channels;\n        int b = tmp / out_channels;\n\n        float sum = 0.0f;\n        for (int ic = 0; ic < in_channels; ++ic) {\n            const float* input_ptr = input + (b * in_channels + ic) * length_in;\n            const float* weight_ptr = weight + (ic * out_channels + oc) * kernel_size;\n            for (int k = 0; k < kernel_size; ++k) {\n                int pos = l_out + padding - k;\n                if (pos >= 0 && pos % stride == 0) {\n                    int l_in = pos / stride;\n                    if (l_in < length_in) {\n                        // FIX: flip the kernel index to match ConvTranspose1d's cross-correlation\n                        sum += input_ptr[l_in] * weight_ptr[kernel_size - 1 - k];\n                    }\n                }\n            }\n        }\n        output[i] = sum + bias[oc];\n    }\n}\n\n// Launcher for ConvTranspose1d\nextern \"C\" void conv_transpose1d_forward(\n    const float* input,\n    const float* weight,\n    const float* bias,\n    float* output,\n    int batch_size,\n    int in_channels,\n    int out_channels,\n    int length_in,\n    int length_out,\n    int kernel_size,\n    int stride,\n    int padding,\n    int output_padding,\n    cudaStream_t stream)\n{\n    int total = batch_size * out_channels * length_out;\n    int threads = 256;\n    int blocks = (total + threads - 1) / threads;\n    if (blocks > 65535) blocks = 65535; // grid cap, kernel uses grid-stride loop\n    conv_transpose1d_kernel<<<blocks, threads, 0, stream>>>(\n        input, weight, bias, output,\n        batch_size, in_channels, out_channels, length_in, length_out,\n        kernel_size, stride, padding, output_padding);\n}\n\n__global__ void sign_kernel(const float* __restrict__ input, float* __restrict__ output, int n)\n{\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int stride = blockDim.x * gridDim.x;\n    for (int i = idx; i < n; i += stride) {\n        float v = input[i];\n        output[i] = (v > 0.0f) - (v < 0.0f);\n    }\n}\n\nextern \"C\" void sign_forward(const float* input, float* output, int n, cudaStream_t stream)\n{\n    int threads = 256;\n    int blocks = (n + threads - 1) / threads;\n    if (blocks > 65535) blocks = 65535;\n    sign_kernel<<<blocks, threads, 0, stream>>>(input, output, n);\n}\n\n// Embedding kernel: gather rows from weight\n__global__ void embedding_kernel(\n    const int64_t* __restrict__ indices,\n    const float* __restrict__ weight,\n    float* __restrict__ output,\n    int num_indices,\n    int embedding_dim)\n{\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int stride = blockDim.x * gridDim.x;\n    for (int i = idx; i < num_indices; i += stride) {\n        int64_t index = indices[i];\n        // Assume indices are valid (< num_embeddings); binding can check but we don't have num_embeddings here.\n        // We'll rely on weight rows count provided.\n        const float* src = weight + index * embedding_dim;\n        float* dst = output + i * embedding_dim;\n        // copy embedding_dim floats\n        for (int j = 0; j < embedding_dim; ++j) {\n            dst[j] = src[j];\n        }\n    }\n}\n\nextern \"C\" void embedding_forward(\n    const int64_t* indices,\n    const float* weight,\n    float* output,\n    int num_indices,\n    int embedding_dim,\n    cudaStream_t stream)\n{\n    int threads = 256;\n    int blocks = (num_indices + threads - 1) / threads;\n    if (blocks > 65535) blocks = 65535;\n    embedding_kernel<<<blocks, threads, 0, stream>>>(\n        indices, weight, output, num_indices, embedding_dim);\n}"
