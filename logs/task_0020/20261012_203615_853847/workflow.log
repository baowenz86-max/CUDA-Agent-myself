output_padding = 1
num_embeddings = 100
embedding_dim = 128


def get_inputs():
    x = torch.randn(batch_size, in_channels, length)
    indices = torch.randint(0, num_embeddings, (batch_size, length))
    return [x, indices]


def get_init_inputs():
