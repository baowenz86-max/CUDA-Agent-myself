      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C, L] same as input x"
      },
      "semantics": [
        "Computes y = (x - running_mean) / sqrt(running_var + eps) * weight + bias",
        "Broadcasting is over batch N and length L; per-channel parameters are indexed by C dimension",
        "Input x, weight, bias, running_mean, running_var are expected on CUDA, float32",
        "eps is a python float passed as double to the extension",
        "The operation is elementwise with no reduction; output shape matches input",
        "Corresponds to reference statement: return self.batchnorm1d(x)"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "return self.batchnorm1d(x)",
      "semantics": [
        "Calls BatchNorm1d in eval mode (training=False)",
        "Uses running_mean and running_var for normalization",
        "Applies affine transformation with weight and bias",
        "Output has same shape [16, 64, 128000], dtype float32, device cuda:0"
