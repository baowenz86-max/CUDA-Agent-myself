--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,63 @@
+#include <cuda_runtime.h>
+
+// CUDA kernel for pixel_shuffle (also known as depth-to-space in some frameworks)
+// Input:  x (N, C, H, W) where C = C_out * r * r
+// Output: y (N, C_out, H * r, W * r)
+// The mapping is:
+//   y[n, c_out, h * r + i, w * r + j] = x[n, c_out * (r*r) + i * r + j, h, w]
+// where 0 <= i,j < r, 0 <= h < H, 0 <= w < W
+// The kernel is launched with enough blocks to cover all output elements.
+// Grid-stride loop is used for safety with large tensors.
+
+template <typename scalar_t>
+__global__ void pixel_shuffle_kernel(
+    const scalar_t* __restrict__ input,
+    scalar_t* __restrict__ output,
+    int N, int C, int H, int W,
+    int r
+) {
+    int total_elements = N * (C / (r * r)) * (H * r) * (W * r);
+    int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+
+    for (int idx = tid; idx < total_elements; idx += stride) {
+        // Decode output index: (n, c_out, oh, ow)
+        int tmp = idx;
+        int ow = tmp % (W * r);
+        tmp /= (W * r);
+        int oh = tmp % (H * r);
+        tmp /= (H * r);
+        int c_out = tmp % (C / (r * r));
+        tmp /= (C / (r * r));
+        int n = tmp;
+
+        // Compute input coordinates
+        int h = oh / r;
+        int w = ow / r;
+        int i = oh % r;
+        int j = ow % r;
+        int c = c_out * (r * r) + i * r + j;
+
+        // Input linear index (assuming contiguous row-major layout)
+        int input_idx = ((n * C + c) * H + h) * W + w;
+        output[idx] = input[input_idx];
+    }
+}
+
+// Declare launcher with C linkage for easy binding from .cpp files
+extern "C" void pixel_shuffle_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    int scale_factor,
+    cudaStream_t stream
+) {
+    const int block_size = 256;
+    int total_elements = N * (C / (scale_factor * scale_factor)) * (H * scale_factor) * (W * scale_factor);
+    int blocks = (total_elements + block_size - 1) / block_size;
+
+    // Launch kernel
+    pixel_shuffle_kernel<float><<<blocks, block_size, 0, stream>>>(
+        input, output, N, C, H, W, scale_factor
+    );
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,68 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include <ATen/cuda/CUDAContext.h>
+#include "../binding_registry.h"
+
+// Declare launcher from custom_ops.cu
+extern "C" void pixel_shuffle_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    int scale_factor,
+    cudaStream_t stream
+);
+
+torch::Tensor pixel_shuffle(torch::Tensor x, int64_t scale_factor) {
+    // Input validation
+    TORCH_CHECK(x.is_cpu(), "pixel_shuffle expects CPU input tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "pixel_shuffle expects float32 input");
+    TORCH_CHECK(x.dim() == 4, "pixel_shuffle expects 4D input (N,C,H,W)");
+    TORCH_CHECK(x.is_contiguous(), "pixel_shuffle expects contiguous input");
+    TORCH_CHECK(scale_factor >= 1, "scale_factor must be >= 1");
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+    int r = static_cast<int>(scale_factor);
+    TORCH_CHECK(C % (r * r) == 0, "C must be divisible by scale_factor^2");
+    int64_t C_out = C / (r * r);
+
+    // Allocate output on CUDA
+    auto options = torch::TensorOptions().dtype(torch::kFloat32).device(torch::kCUDA);
+    auto output = torch::empty({N, C_out, H * r, W * r}, options);
+
+    // Copy input from CPU to CUDA
+    auto x_cuda = x.to(torch::kCUDA);
+    TORCH_CHECK(x_cuda.is_contiguous(), "CUDA tensor must be contiguous");
+
+    // Get current CUDA stream
+    cudaStream_t stream = at::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher with CUDA pointers
+    pixel_shuffle_launcher(
+        x_cuda.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int>(N),
+        static_cast<int>(C),
+        static_cast<int>(H),
+        static_cast<int>(W),
+        r,
+        stream
+    );
+
+    // Check for kernel errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "pixel_shuffle kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+void register_pixel_shuffle(pybind11::module& m) {
+    m.def("pixel_shuffle", &pixel_shuffle, "Pixel shuffle operator (CPU input, CUDA output)",
+          pybind11::arg("x"), pybind11::arg("scale_factor"));
+}
+
+REGISTER_BINDING(pixel_shuffle, register_pixel_shuffle);
