--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,77 @@
+#include <cuda_runtime.h>
+#include <math.h>
+
+// Kernel for computing mean over dim=1 with keepdim=True
+// Input shape: [batch, channels, height, width], contiguous, float32
+// Output shape: [batch, 1, height, width]
+__global__ void mean_dim1_kernel(float* __restrict__ output,
+                                const float* __restrict__ input,
+                                int batch,
+                                int channels,
+                                int height,
+                                int width) {
+    int total_output = batch * height * width;
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+
+    for (int i = idx; i < total_output; i += stride) {
+        int b = i / (height * width);
+        int hw = i % (height * width);
+        int h = hw / width;
+        int w = hw % width;
+
+        float sum = 0.0f;
+        int base = b * channels * height * width + h * width + w;
+        for (int c = 0; c < channels; ++c) {
+            sum += input[base + c * height * width];
+        }
+        output[i] = sum / channels;
+    }
+}
+
+// Kernel for GELU activation (default approximate='none')
+// y = x * 0.5 * (1 + erf(x / sqrt(2)))
+__global__ void gelu_kernel(float* __restrict__ output,
+                            const float* __restrict__ input,
+                            int numel) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+
+    for (int i = idx; i < numel; i += stride) {
+        float x = input[i];
+        // Use erf and constant sqrt(2)/2 = 0.70710678f
+        output[i] = 0.5f * x * (1.0f + erff(x * 0.70710678118654752440f));
+    }
+}
+
+// Host launcher for custom_mean_dim1
+// Expects contiguous input tensor of shape [batch, channels, height, width]
+// Output initialized to zeros before launch? The kernel writes every element, so not strictly needed.
+extern "C" void custom_mean_dim1_launcher(float* output,
+                                           const float* input,
+                                           int batch,
+                                           int channels,
+                                           int height,
+                                           int width,
+                                           cudaStream_t stream) {
+    int total_output = batch * height * width;
+    int threads = 256;
+    int blocks = (total_output + threads - 1) / threads;
+    // Cap blocks to avoid excessive grid size; grid-stride loop handles rest
+    if (blocks > 65535) blocks = 65535;
+
+    mean_dim1_kernel<<<blocks, threads, 0, stream>>>(
+        output, input, batch, channels, height, width);
+}
+
+// Host launcher for custom_gelu
+extern "C" void custom_gelu_launcher(float* output,
+                                      const float* input,
+                                      int numel,
+                                      cudaStream_t stream) {
+    int threads = 256;
+    int blocks = (numel + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535;
+
+    gelu_kernel<<<blocks, threads, 0, stream>>>(output, input, numel);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,82 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void custom_mean_dim1_launcher(float* output,
+                                           const float* input,
+                                           int batch,
+                                           int channels,
+                                           int height,
+                                           int width,
+                                           cudaStream_t stream);
+
+extern "C" void custom_gelu_launcher(float* output,
+                                      const float* input,
+                                      int numel,
+                                      cudaStream_t stream);
+
+// Wrapper for custom_mean_dim1
+torch::Tensor custom_mean_dim1_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dim() == 4, "Input must have 4 dimensions");
+
+    int batch = x.size(0);
+    int channels = x.size(1);
+    int height = x.size(2);
+    int width = x.size(3);
+
+    auto output = torch::empty({batch, 1, height, width}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_mean_dim1_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        batch,
+        channels,
+        height,
+        width,
+        stream
+    );
+
+    return output;
+}
+
+// Wrapper for custom_gelu
+torch::Tensor custom_gelu_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+
+    auto output = torch::empty_like(x);
+    int numel = x.numel();
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_gelu_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        numel,
+        stream
+    );
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_mean_dim1", &custom_mean_dim1_forward,
+          "Compute mean over dim=1 with keepdim=True",
+          py::arg("x"));
+    m.def("custom_gelu", &custom_gelu_forward,
+          "Apply GELU activation",
+          py::arg("x"));
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,20 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x):
+        x = cuda_extension.custom_mean_dim1(x)
+        x = cuda_extension.custom_gelu(x)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.custom_mean_dim1(x)
+        yield "step_001", x
+        x = cuda_extension.custom_gelu(x)
+        yield "step_002", x
+        yield "step_003", x
