      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[1024, 1, 512, 256]"
      },
      "semantics": [
        "对输入张量逐元素应用 GELU 激活函数，公式为 F.gelu(x)，默认 approximate='none'",
        "保持输入 shape 不变，输出 dtype/device 与输入一致"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = torch.mean(x, dim=1, keepdim=True)",
      "semantics": [
        "在 dim=1（通道维度）上求均值，keepdim=True，输出 shape [1024,1,512,256]",
        "输入 x 为 [1024,3,512,256] float32 CUDA 张量"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = F.gelu(x)",
      "semantics": [
        "对 step_001 的输出应用 GELU 激活，默认 approximate='none'",
        "输出 shape 不变 [1024,1,512,256]"
      ]
    },
    {
      "checkpoint": "step_003",
