      ]
    },
    {
      "name": "custom_gelu",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[1024, 1, 512, 256]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
