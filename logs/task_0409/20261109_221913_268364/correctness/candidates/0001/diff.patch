--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,201 @@
+#include <cuda_runtime.h>
+#include <cstdint>
+#include <cstring>
+
+// Helper macro for CUDA error checking
+template <typename T>
+void check(T result, const char* const func, const char* const file, int const line) {
+    if (result) {
+        fprintf(stderr, "CUDA error at %s:%d code=%d(%s) \"%s\" \n",
+                file, line, static_cast<unsigned int>(result), cudaGetErrorName(result), func);
+        cudaDeviceReset();
+        exit(EXIT_FAILURE);
+    }
+}
+#define checkCudaErrors(val) check((val), #val, __FILE__, __LINE__)
+
+// Kernel: compute max along dim=1 (C dimension) for each (n,h,w)
+// Input: contiguous data (after possible copy), shape N x C x H x W
+// Output: max_val shape N x 1 x H x W
+template <int BLOCK_SIZE>
+__global__ void max_dim1_kernel(const float* __restrict__ input,
+                                float* __restrict__ output,
+                                int N, int C, int H, int W) {
+    int idx = blockIdx.x * BLOCK_SIZE + threadIdx.x;
+    int total = N * H * W;
+    if (idx >= total) return;
+
+    int n = idx / (H * W);
+    int rem = idx % (H * W);
+    int h = rem / W;
+    int w = rem % W;
+
+    const float* base = input + n * C * H * W + h * W + w;
+    float max_val = -1e30f; // very small value
+    for (int c = 0; c < C; ++c) {
+        float val = base[c * H * W];
+        if (val > max_val) max_val = val;
+    }
+    output[idx] = max_val;
+}
+
+// Kernel: compute argmax (first occurrence of max) along dim=1
+template <int BLOCK_SIZE>
+__global__ void argmax_dim1_kernel(const float* __restrict__ input,
+                                   int64_t* __restrict__ output,
+                                   int N, int C, int H, int W) {
+    int idx = blockIdx.x * BLOCK_SIZE + threadIdx.x;
+    int total = N * H * W;
+    if (idx >= total) return;
+
+    int n = idx / (H * W);
+    int rem = idx % (H * W);
+    int h = rem / W;
+    int w = rem % W;
+
+    const float* base = input + n * C * H * W + h * W + w;
+    float max_val = -1e30f;
+    int max_idx = 0;
+    for (int c = 0; c < C; ++c) {
+        float val = base[c * H * W];
+        if (val > max_val) {
+            max_val = val;
+            max_idx = c;
+        }
+    }
+    output[idx] = static_cast<int64_t>(max_idx);
+}
+
+// Kernel: multiply each element of input by scalar (scalar is a single float)
+template <int BLOCK_SIZE>
+__global__ void scalar_mul_kernel(const float* __restrict__ input,
+                                  float* __restrict__ output,
+                                  float scalar,
+                                  int total) {
+    int idx = blockIdx.x * BLOCK_SIZE + threadIdx.x;
+    if (idx >= total) return;
+    output[idx] = input[idx] * scalar;
+}
+
+// Helper function to copy non-contiguous 4D tensor to contiguous memory
+// input: pointer to original data (may be non-contiguous)
+// shape: N,C,H,W, strides: sN,sC,sH,sW
+// Returns contiguous array allocated on device (caller must free)
+float* make_contiguous(const float* input,
+                       int N, int C, int H, int W,
+                       int64_t sN, int64_t sC, int64_t sH, int64_t sW,
+                       cudaStream_t stream) {
+    size_t size = static_cast<size_t>(N) * C * H * W * sizeof(float);
+    float* contig;
+    checkCudaErrors(cudaMalloc(&contig, size));
+    // Launch kernel to copy element-wise using strides
+    // We'll use a simple kernel for copying
+    int total = N * C * H * W;
+    int block = 256;
+    int grid = (total + block - 1) / block;
+    // Define a copy kernel inline (can also use cudaMemcpy2D but generic)
+    auto copy_kernel = [] __device__ (const float* src, float* dst,
+                                      int N, int C, int H, int W,
+                                      int64_t sN, int64_t sC, int64_t sH, int64_t sW,
+                                      int total) {
+        int idx = blockIdx.x * blockDim.x + threadIdx.x;
+        if (idx >= total) return;
+        int n = idx / (C * H * W);
+        int rem = idx % (C * H * W);
+        int c = rem / (H * W);
+        int rem2 = rem % (H * W);
+        int h = rem2 / W;
+        int w = rem2 % W;
+        dst[idx] = src[n * sN + c * sC + h * sH + w * sW];
+    };
+    // Can't define lambda __device__ easily outside; use separate kernel function
+    // Instead, we'll declare a kernel and call it here
+    extern __global__ void copy_contiguous_kernel(const float* __restrict__ src, float* __restrict__ dst,
+                                                  int N, int C, int H, int W,
+                                                  int64_t sN, int64_t sC, int64_t sH, int64_t sW,
+                                                  int total);
+    copy_contiguous_kernel<<<grid, block, 0, stream>>>(input, contig, N, C, H, W, sN, sC, sH, sW, total);
+    checkCudaErrors(cudaGetLastError());
+    return contig;
+}
+
+// Global copy kernel definition
+__global__ void copy_contiguous_kernel(const float* __restrict__ src, float* __restrict__ dst,
+                                       int N, int C, int H, int W,
+                                       int64_t sN, int64_t sC, int64_t sH, int64_t sW,
+                                       int total) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= total) return;
+    int n = idx / (C * H * W);
+    int rem = idx % (C * H * W);
+    int c = rem / (H * W);
+    int rem2 = rem % (H * W);
+    int h = rem2 / W;
+    int w = rem2 % W;
+    dst[idx] = src[n * sN + c * sC + h * sH + w * sW];
+}
+
+// Launchers exposed to C++ (binding)
+extern "C" {
+
+void custom_max_dim1_launcher(const float* input,
+                              float* output,
+                              int N, int C, int H, int W,
+                              int64_t sN, int64_t sC, int64_t sH, int64_t sW,
+                              cudaStream_t stream) {
+    // Check if input is contiguous (strides match contiguous layout)
+    bool contiguous = (sC == (int64_t)H * W && sH == W && sW == 1 && sN == (int64_t)C * H * W);
+    const float* data = input;
+    float* temp = nullptr;
+    if (!contiguous) {
+        temp = make_contiguous(input, N, C, H, W, sN, sC, sH, sW, stream);
+        data = temp;
+    }
+
+    int total = N * H * W;
+    const int block = 256;
+    int grid = (total + block - 1) / block;
+    max_dim1_kernel<block><<<grid, block, 0, stream>>>(data, output, N, C, H, W);
+    checkCudaErrors(cudaGetLastError());
+
+    if (temp) {
+        checkCudaErrors(cudaFree(temp));
+    }
+}
+
+void custom_argmax_dim1_launcher(const float* input,
+                                 int64_t* output,
+                                 int N, int C, int H, int W,
+                                 int64_t sN, int64_t sC, int64_t sH, int64_t sW,
+                                 cudaStream_t stream) {
+    bool contiguous = (sC == (int64_t)H * W && sH == W && sW == 1 && sN == (int64_t)C * H * W);
+    const float* data = input;
+    float* temp = nullptr;
+    if (!contiguous) {
+        temp = make_contiguous(input, N, C, H, W, sN, sC, sH, sW, stream);
+        data = temp;
+    }
+
+    int total = N * H * W;
+    const int block = 256;
+    int grid = (total + block - 1) / block;
+    argmax_dim1_kernel<block><<<grid, block, 0, stream>>>(data, output, N, C, H, W);
+    checkCudaErrors(cudaGetLastError());
+
+    if (temp) {
+        checkCudaErrors(cudaFree(temp));
+    }
+}
+
+void custom_scalar_mul_launcher(const float* input,
+                                float* output,
+                                float scalar_value,
+                                int total,
+                                cudaStream_t stream) {
+    const int block = 256;
+    int grid = (total + block - 1) / block;
+    scalar_mul_kernel<block><<<grid, block, 0, stream>>>(input, output, scalar_value, total);
+    checkCudaErrors(cudaGetLastError());
+}
+
+} // extern "C"
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,146 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declarations of launchers from custom_ops.cu
+extern "C" void custom_max_dim1_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    int64_t sN, int64_t sC, int64_t sH, int64_t sW,
+    cudaStream_t stream);
+
+extern "C" void custom_argmax_dim1_launcher(
+    const float* input,
+    int64_t* output,
+    int N, int C, int H, int W,
+    int64_t sN, int64_t sC, int64_t sH, int64_t sW,
+    cudaStream_t stream);
+
+extern "C" void custom_scalar_mul_launcher(
+    const float* input,
+    float* output,
+    float scalar_value,
+    int total,
+    cudaStream_t stream);
+
+// Helper to check CUDA tensor properties
+static void check_cuda_float_tensor(const torch::Tensor& t, const char* name) {
+    TORCH_CHECK(t.is_cuda(), name, " must be a CUDA tensor");
+    TORCH_CHECK(t.dtype() == torch::kFloat32, name, " must be float32");
+    TORCH_CHECK(t.dim() == 4, name, " must be 4-dimensional");
+}
+
+// PyTorch wrapper for custom_max_dim1
+torch::Tensor custom_max_dim1(torch::Tensor x) {
+    check_cuda_float_tensor(x, "x");
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+
+    // Allocate output tensor [N, 1, H, W]
+    auto output = torch::empty({N, 1, H, W}, x.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Obtain raw pointers and strides (int64_t)
+    const float* input_ptr = x.data_ptr<float>();
+    float* output_ptr = output.data_ptr<float>();
+    int64_t sN = x.stride(0);
+    int64_t sC = x.stride(1);
+    int64_t sH = x.stride(2);
+    int64_t sW = x.stride(3);
+
+    // Call launcher (launcher internally handles non-contiguous input by making a contiguous copy if needed)
+    custom_max_dim1_launcher(input_ptr, output_ptr,
+                             static_cast<int>(N), static_cast<int>(C),
+                             static_cast<int>(H), static_cast<int>(W),
+                             sN, sC, sH, sW,
+                             stream);
+
+    // Check for errors after launch
+    TORCH_CHECK(cudaGetLastError() == cudaSuccess, "custom_max_dim1 launch failed");
+
+    return output;
+}
+
+// PyTorch wrapper for custom_argmax_dim1
+torch::Tensor custom_argmax_dim1(torch::Tensor x) {
+    check_cuda_float_tensor(x, "x");
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+
+    // Allocate output tensor [N, 1, H, W] of int64
+    auto output = torch::empty({N, 1, H, W}, x.options().dtype(torch::kInt64));
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    const float* input_ptr = x.data_ptr<float>();
+    int64_t* output_ptr = output.data_ptr<int64_t>();
+    int64_t sN = x.stride(0);
+    int64_t sC = x.stride(1);
+    int64_t sH = x.stride(2);
+    int64_t sW = x.stride(3);
+
+    custom_argmax_dim1_launcher(input_ptr, output_ptr,
+                                static_cast<int>(N), static_cast<int>(C),
+                                static_cast<int>(H), static_cast<int>(W),
+                                sN, sC, sH, sW,
+                                stream);
+
+    TORCH_CHECK(cudaGetLastError() == cudaSuccess, "custom_argmax_dim1 launch failed");
+
+    return output;
+}
+
+// PyTorch wrapper for custom_scalar_mul
+torch::Tensor custom_scalar_mul(torch::Tensor input, torch::Tensor scalar) {
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(input.dim() == 4, "input must be 4-dimensional");
+    TORCH_CHECK(scalar.is_cpu(), "scalar must be a CPU tensor");
+    TORCH_CHECK(scalar.dtype() == torch::kFloat32, "scalar must be float32");
+    TORCH_CHECK(scalar.numel() == 1, "scalar must have exactly one element");
+
+    int64_t total = input.numel();
+
+    // Allocate output with same shape as input
+    auto output = torch::empty_like(input);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    const float* input_ptr = input.data_ptr<float>();
+    float* output_ptr = output.data_ptr<float>();
+
+    // Retrieve scalar value from CPU tensor (ensure synchronization)
+    float scalar_value = scalar.item<float>();
+
+    custom_scalar_mul_launcher(input_ptr, output_ptr, scalar_value,
+                               static_cast<int>(total), stream);
+
+    TORCH_CHECK(cudaGetLastError() == cudaSuccess, "custom_scalar_mul launch failed");
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_max_dim1", &custom_max_dim1, "Custom max along dim=1 (keepdim)",
+          py::arg("x"));
+    m.def("custom_argmax_dim1", &custom_argmax_dim1, "Custom argmax along dim=1 (keepdim)",
+          py::arg("x"));
+    m.def("custom_scalar_mul", &custom_scalar_mul, "Multiply tensor by scalar",
+          py::arg("input"), py::arg("scalar"));
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,25 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, scalar):
+        super(ModelNew, self).__init__()
+        self.scalar = nn.Parameter(torch.tensor(scalar))
+
+    def forward(self, x):
+        max_val = cuda_extension.custom_max_dim1(x)
+        scalar_tensor = torch.scalar_tensor(self.scalar.item())
+        out = cuda_extension.custom_scalar_mul(max_val, scalar_tensor)
+        return out
+
+    def debug_forward(self, x):
+        max_val = cuda_extension.custom_max_dim1(x)
+        argmax_indices = cuda_extension.custom_argmax_dim1(x)
+        max_tuple = torch.return_types.max((max_val, argmax_indices))
+        yield 'step_001', max_tuple
+        scalar_tensor = torch.scalar_tensor(self.scalar.item())
+        yield 'step_002', scalar_tensor
+        out = cuda_extension.custom_scalar_mul(max_val, scalar_tensor)
+        yield 'step_003', out
