+    CUDNN_CHECK(cudnnConvolutionBackwardData(
+        handle,
+        &alpha,
+        w_desc,
+        transposed_weight,
+        dy_desc,
+        x_contig.data_ptr<float>(),  // dy = x
+        conv_desc,
+        algo,
+        workspace,
+        workspace_size,
+        &beta,
+        dx_desc,
+        core_output.data_ptr<float>()  // dx = core output
+    ));
