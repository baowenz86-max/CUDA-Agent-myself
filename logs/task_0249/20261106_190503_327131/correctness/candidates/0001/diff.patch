+// custom_ops_binding.cpp - PyTorch bindings for custom_conv_transpose1d and custom_silu
+
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_runtime.h>
+#include <cudnn.h>
+#include <cstdint>
+#include <stdexcept>
+#include "../binding_registry.h"
+
+// Forward declaration of silu launcher from custom_ops.cu
+extern "C" cudaError_t custom_silu_launcher(
+    float* output,
+    const float* input,
+    int64_t numel,
+    cudaStream_t stream
+);
+
+// Helper to check cudnn status
+#define CUDNN_CHECK(expr) \
+    do { \
+        cudnnStatus_t status = (expr); \
+        if (status != CUDNN_STATUS_SUCCESS) { \
+            throw std::runtime_error(\
+                std::string("cuDNN error at ") + __FILE__ + ":" + std::to_string(__LINE__) + \
+                ": " + cudnnGetErrorString(status)); \
+        } \
+    } while (0)
+
+// Helper to check cuda error
+#define CUDA_CHECK(expr) \
+    do { \
+        cudaError_t err = (expr); \
+        if (err != cudaSuccess) { \
+            throw std::runtime_error(\
+                std::string("CUDA error at ") + __FILE__ + ":" + std::to_string(__LINE__) + \
+                ": " + cudaGetErrorString(err)); \
+        } \
+    } while (0)
+
+// custom_silu binding: calls the launcher in .cu
+torch::Tensor custom_silu(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "custom_silu: input must be CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "custom_silu: input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "custom_silu: input must be contiguous");
+
+    auto output = torch::empty_like(x);
+    int64_t numel = x.numel();
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    cudaError_t err = custom_silu_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        numel,
+        stream
+    );
+    CUDA_CHECK(err);
+
+    return output;
+}
+
+// custom_conv_transpose1d binding using cuDNN
+torch::Tensor custom_conv_transpose1d(
+    torch::Tensor x,
+    torch::Tensor weight,
+    torch::Tensor bias,   // may be undefined or None
+    int64_t stride,
+    int64_t padding,
+    int64_t output_padding
+) {
+    // Input checks
+    TORCH_CHECK(x.is_cuda(), "custom_conv_transpose1d: x must be CUDA tensor");
+    TORCH_CHECK(weight.is_cuda(), "custom_conv_transpose1d: weight must be CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "custom_conv_transpose1d: x must be float32");
+    TORCH_CHECK(weight.dtype() == torch::kFloat32, "custom_conv_transpose1d: weight must be float32");
+    TORCH_CHECK(x.dim() == 3, "custom_conv_transpose1d: x must be 3D (N, C, L)");
+    TORCH_CHECK(weight.dim() == 3, "custom_conv_transpose1d: weight must be 3D (C_in, C_out, kernel_size)");
+
+    int64_t N = x.size(0);
+    int64_t C_in = x.size(1);
+    int64_t L_in = x.size(2);
+    int64_t C_out = weight.size(1);
+    int64_t kernel_size = weight.size(2);
+
+    TORCH_CHECK(weight.size(0) == C_in, "custom_conv_transpose1d: weight shape mismatch");
+    TORCH_CHECK(stride > 0, "custom_conv_transpose1d: stride must be positive");
+    TORCH_CHECK(padding >= 0, "custom_conv_transpose1d: padding must be non-negative");
+    TORCH_CHECK(output_padding >= 0 && output_padding < stride, "custom_conv_transpose1d: invalid output_padding");
+
+    // Bias check
+    bool has_bias = bias.defined();
+    if (has_bias) {
+        TORCH_CHECK(bias.is_cuda(), "custom_conv_transpose1d: bias must be CUDA tensor");
+        TORCH_CHECK(bias.dtype() == torch::kFloat32, "custom_conv_transpose1d: bias must be float32");
+        TORCH_CHECK(bias.dim() == 1 && bias.size(0) == C_out, "custom_conv_transpose1d: bias size must match C_out");
+    }
+
+    // Make input, weight, bias contiguous (if not already)
+    auto x_contig = x.contiguous();
+    auto weight_contig = weight.contiguous();
+    torch::Tensor bias_contig;
+    if (has_bias) {
+        bias_contig = bias.contiguous();
+    }
+
+    // Compute output length
+    int64_t L_out = (L_in - 1) * stride - 2 * padding + kernel_size + output_padding;
+    TORCH_CHECK(L_out > 0, "custom_conv_transpose1d: output length must be positive");
+
+    // Allocate output [N, C_out, L_out]
+    auto output = torch::empty({N, C_out, L_out}, x.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Create cuDNN handle
+    cudnnHandle_t handle;
+    CUDNN_CHECK(cudnnCreate(&handle));
+    CUDNN_CHECK(cudnnSetStream(handle, stream));
+
+    // Tensor descriptors: use NCHW with H=1 (4D)
+    cudnnTensorDescriptor_t x_desc, y_desc;
+    cudnnFilterDescriptor_t w_desc;
+
+    CUDNN_CHECK(cudnnCreateTensorDescriptor(&x_desc));
+    CUDNN_CHECK(cudnnCreateTensorDescriptor(&y_desc));
+    CUDNN_CHECK(cudnnCreateFilterDescriptor(&w_desc));
+
+    // Set x_desc: [N, C_in, 1, L_in]
+    CUDNN_CHECK(cudnnSetTensor4dDescriptor(
+        x_desc,
+        CUDNN_TENSOR_NCHW,
+        CUDNN_DATA_FLOAT,
+        (int)N,
+        (int)C_in,
+        1,
+        (int)L_in
+    ));
+
+    // Set y_desc: [N, C_out, 1, L_out]
+    CUDNN_CHECK(cudnnSetTensor4dDescriptor(
+        y_desc,
+        CUDNN_TENSOR_NCHW,
+        CUDNN_DATA_FLOAT,
+        (int)N,
+        (int)C_out,
+        1,
+        (int)L_out
+    ));
+
+    // Weight descriptor: PyTorch weight shape is [C_in, C_out, kernel_size],
+    // cuDNN expects [K, C, H, W] with K=C_out, C=C_in, W=kernel_size.
+    // We can set the descriptor with custom strides to avoid a full transpose.
+    // Since weight is contiguous, strides are: (C_out*kernel_size, kernel_size, 1).
+    // We need a transposed memory layout: [C_out, C_in, kernel_size],
+    // which corresponds to strides: (kernel_size, C_out*kernel_size, 1).
+    // We can either create a temporary transposed tensor or set the descriptor
+    // with those strides using cudnnSetFilter4dDescriptor (it accepts strides).
+    // We'll allocate a transposed copy on device and copy using a simple cudaMemcpy2D
+    // approach or a small kernel. Since kernel_size=3 and C_in/C_out small,
+    // we can use a simple kernel from the host? Easier: allocate a contiguous
+    // tensor of shape [C_out, C_in, kernel_size] and use a CUDA kernel to transpose.
+    // But we cannot write kernels in .cpp (only .cu). However, we can use
+    // cudaMemcpy2D to transpose matrix blocks? Not straightforward for 3D.
+    // Alternative: use cudnnSetFilterNdDescriptor with strides that match the
+    // PyTorch memory layout but are transposed. cuDNN filter descriptor supports
+    // arbitrary strides, so we can set strides as if it were [C_out, C_in, kernel_size]
+    // but pointing to the original memory. That is, set desc with shape
+    // [C_out, C_in, 1, kernel_size] and strides [kernel_size, C_out*kernel_size,
+    // C_out*kernel_size, 1]? Wait, the strides are in elements along each dimension.
+    // We need to be careful: cuDNN expects filter in KCRS order: K (output),
+    // C (input), R (kernel). Stride for K dimension is number of elements to move
+    // to next filter (output channel). If we treat the original memory as [C_in, C_out, K],
+    // then moving to next C_in (input channel) increments by C_out*K; moving to next
+    // C_out (output channel) increments by K; moving to next kernel element increments
+    // by 1. So the filter descriptor should have dims [C_out, C_in, 1, K]
+    // and strides [K, C_out*K, C_out*K, 1] (the third dimension stride unused).
+    // Actually, for cudnnSetFilter4dDescriptor, the strides array is in elements
+    // and must be in order of most significant to least: dimA[0] (K), dimA[1] (C),
+    // dimA[2] (H), dimA[3] (W). So we set dimA = [C_out, C_in, 1, kernel_size]
+    // and strideA = [kernel_size, C_out*kernel_size, C_out*kernel_size, 1].
+    // But cudnnSetFilter4dDescriptor does not allow strides; we need
+    // cudnnSetFilterNdDescriptor. Yes, there is cudnnSetFilterNdDescriptor.
+    // We'll use that.
+
+    int filterDimA[4] = {(int)C_out, (int)C_in, 1, (int)kernel_size};
+    // Strides for each dimension in number of elements
+    int filterStrideA[4] = {
+        (int)kernel_size,               // next output channel: move by kernel_size elements
+        (int)(C_out * kernel_size),    // next input channel: move by C_out*kernel_size
+        (int)(C_out * kernel_size),    // height (unused, but set to same as above)
+        1                              // next kernel element: move by 1
+    };
+
+    CUDNN_CHECK(cudnnSetFilterNdDescriptor(
+        w_desc,
+        CUDNN_DATA_FLOAT,
+        CUDNN_TENSOR_NCHW,
+        4,
+        filterDimA
+    ));
+
+    // Note: cudnnSetFilterNdDescriptor does not take strides; it assumes contiguous
+    // in the order specified. So to use non-contiguous layout we must set strides
+    // using cudnnSetFilterNdDescriptor with format CUDNN_TENSOR_NCHW? Actually,
+    // there is cudnnSetFilterNdDescriptor with a parameter for strides? Let's check:
+    // The API is cudnnSetFilterNdDescriptor(
+    //    cudnnFilterDescriptor_t filterDesc,
+    //    cudnnDataType_t dataType,
+    //    cudnnTensorFormat_t format,
+    //    int nbDims,
+    //    const int filterDimA[]
+    // );
+    // It does NOT accept strides. So we cannot specify custom strides with this call.
+    // We have to use cudnnSetFilter4dDescriptor which also doesn't take strides.
+    // Therefore, we must provide a physically contiguous filter in KCRS order.
+    // Since PyTorch weight is in [C_in, C_out, K], we need to transpose it.
+    // We'll allocate a temporary CUDA tensor of shape [C_out, C_in, kernel_size]
+    // and perform a transpose copy using a small CUDA kernel. But we cannot write
+    // kernels in .cpp. However, we can use cudaMemcpy2D to transpose slices,
+    // or use cublas? Not ideal. Since the weight is small (8*16*3 = 384 floats),
+    // we could perform the transpose on CPU? But the weight is on GPU. We could
+    // copy weight to CPU, transpose on CPU, and copy back. That is inefficient but
+    // acceptable for small weights; but we must avoid CPU in hot path. Since
+    // this is only at op call time (once per forward), it's okay.
+    // But we need to ensure we don't use torch operations. We can use cudaMemcpy
+    // and do the transpose manually in C++ (host) using a std::vector. That is allowed.
+    // Let's do that: allocate a std::vector<float> of size C_out*C_in*kernel_size,
+    // copy weight from device to host, transpose, copy back to device into a
+    // new device buffer. Since weight size is small, this is fine.
+
+    // Allocate device buffer for transposed weight
+    size_t weight_numel = C_out * C_in * kernel_size;
+    float* transposed_weight = nullptr;
+    CUDA_CHECK(cudaMalloc(&transposed_weight, weight_numel * sizeof(float)));
+
+    // Copy original weight to host
+    std::vector<float> host_weight(weight_numel);
+    CUDA_CHECK(cudaMemcpy(host_weight.data(), weight_contig.data_ptr<float>(),
+                          weight_numel * sizeof(float), cudaMemcpyDeviceToHost));
+
+    // Transpose on host: original indices: i*C_out*K + o*K + k (i in C_in, o in C_out, k in K)
+    // Target indices: o*C_in*K + i*K + k
+    std::vector<float> host_transposed(weight_numel);
+    for (int64_t i = 0; i < C_in; ++i) {
+        for (int64_t o = 0; o < C_out; ++o) {
+            for (int64_t k = 0; k < kernel_size; ++k) {
+                int64_t src_idx = i * C_out * kernel_size + o * kernel_size + k;
+                int64_t dst_idx = o * C_in * kernel_size + i * kernel_size + k;
+                host_transposed[dst_idx] = host_weight[src_idx];
+            }
+        }
+    }
+
+    // Copy transposed weight to device
+    CUDA_CHECK(cudaMemcpy(transposed_weight, host_transposed.data(),
+                          weight_numel * sizeof(float), cudaMemcpyHostToDevice));
+
+    // Now set filter descriptor as contiguous [C_out, C_in, 1, K]
+    CUDNN_CHECK(cudnnSetFilter4dDescriptor(
+        w_desc,
+        CUDNN_DATA_FLOAT,
+        CUDNN_TENSOR_NCHW,
+        (int)C_out,
+        (int)C_in,
+        1,
+        (int)kernel_size
+    ));
+
+    // Convolution descriptor: we need to perform a transposed convolution.
+    // cuDNN has cudnnConvolutionBackwardData, which computes gradInput
+    // given output grad and weight. That is equivalent to transposed conv
+    // with appropriate parameters. We'll use that.
+    cudnnConvolutionDescriptor_t conv_desc;
+    CUDNN_CHECK(cudnnCreateConvolutionDescriptor(&conv_desc));
+
+    // Set convolution descriptor for forward conv with same stride/padding
+    // but without output_padding. The transposed conv output length is
+    // (L_in-1)*stride - 2*padding + kernel_size + output_padding.
+    // The backward data computation naturally produces length
+    // (L_in-1)*stride - 2*padding + kernel_size. Then we need to add
+    // output_padding columns of zeros at the end (or beginning? PyTorch
+    // adds at the end). We'll handle that separately after the main conv.
+    // So we first compute a temporary output of length
+    // L_temp = (L_in-1)*stride - 2*padding + kernel_size,
+    // then copy it into the final output with extra columns zeroed.
+    // However, calling cudnnConvolutionBackwardData requires the
+    // dimensions of the forward conv. The forward conv would have input
+    // of length L_temp? Actually, the standard formula: given input length
+    // L_in and kernel K, stride S, padding P, output length of forward conv is
+    // L_out_fwd = floor((L_in + 2P - K)/S) + 1. For transposed conv,
+    // we want output length L_out = (L_in-1)*S - 2P + K + output_padding.
+    // This can be seen as backward data of a forward conv with input
+    // length L_out, output length L_in, stride S, padding P, kernel K.
+    // The backward data output length is exactly the forward input length L_out.
+    // So we can set up a forward conv descriptor with input spatial size = L_out,
+    // output spatial size = L_in, stride S, padding P. Then compute backward data
+    // with dy = x (as input gradient), and w = weight, and dx = output.
+    // But we need to account for output_padding: the extra zeros at the
+    // end of output. We can either set the convolution descriptor with a
+    // larger padding? Actually, output_padding is not part of standard
+    // convolution; it adds extra columns at the end of the transposed output.
+    // So we compute the core transposed conv of length L_core, then pad zeros
+    // to length L_core + output_padding. We'll do that.
+
+    int64_t L_core = (L_in - 1) * stride - 2 * padding + kernel_size;
+    TORCH_CHECK(L_core > 0, "invalid core output length");
+
+    // Create temporary output for core
+    auto core_output = torch::empty({N, C_out, L_core}, x.options());
+
+    // Set convolution descriptor for the forward conv (used as backward data)
+    // The forward conv would have input shape [N, C_in, 1, L_core] and
+    // output shape [N, C_out, 1, L_in], but note that in backward data,
+    // the roles of input and output channels are reversed: the filter is
+    // still [C_out, C_in, ...], gradOutput is [N, C_out, 1, L_in] (which is x),
+    // and gradInput is [N, C_in, 1, L_core] (our desired output). So
+    // we need to set the convolution descriptor accordingly.
+    // Actually, cudnnConvolutionBackwardData computes dx from dy and w.
+    // The convolution descriptor must describe the forward convolution that
+    // the backward data corresponds to. In that forward conv,
+    // input channels = C_in (since dx has C_in channels), output channels = C_out
+    // (since dy has C_out channels), and the spatial dimensions are:
+    // forward input spatial = L_core, forward output spatial = L_in.
+    // The convolution descriptor should have stride, padding, dilation.
+    // Then backward data uses the same descriptor.
+
+    CUDNN_CHECK(cudnnSetConvolution2dDescriptor(
+        conv_desc,
+        (int)padding,      // pad_h
+        0,                 // pad_w (unused, but set 0)
+        (int)stride,       // stride_h
+        1,                 // stride_w
+        1,                 // dilation_h
+        1,                 // dilation_w
+        CUDNN_CROSS_CORRELATION,
+        CUDNN_DATA_FLOAT
+    ));
+
+    // Note: For 1D, the second dimension is height=1, so we can use 2D descriptor
+    // with appropriate dims. We need to set the tensor descriptors accordingly.
+    // Our x_desc is [N, C_in, 1, L_in] but for backward data, the input (dy)
+    // is [N, C_out, 1, L_in] (since x is treated as output gradient), and the
+    // output (dx) is [N, C_out? no, dx has C_in channels]. Wait, we need to
+    // redefine descriptors: dy_desc should be [N, C_out, 1, L_in] (same as x),
+    // dx_desc should be [N, C_in, 1, L_core] (our core output).
+    // The original y_desc we set as [N, C_out, 1, L_out] is too large;
+    // we'll use core_output tensor with its own descriptor.
