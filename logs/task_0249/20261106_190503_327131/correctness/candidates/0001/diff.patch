+        // bias broadcast over N and L dimensions. But cudnnAddTensor expects
+        // same dimensions? There is cudnnAddTensor that adds a tensor to another
+        // with broadcasting via cudnnOpTensor? Actually, cudnnAddTensor supports
+        // broadcasting where one tensor can have fewer dimensions if they match
+        // trailing dimensions? Not straightforward. Alternatively, use cudnnOpTensor
+        // with bias expanded? That would require creating an expanded bias tensor.
+        // Since bias is small, we can use a simple loop on device? We cannot.
+        // Use cudnnTransformTensor? Better: use cudnnAddTensor with a bias tensor
+        // that is replicated? We can use cudnnAddTensor with a bias tensor descriptor
+        // that has shape [1, C_out, 1, 1]. According to cuDNN, cudnnAddTensor can
+        // broadcast over dimensions of size 1 if the other tensor has larger
+        // dimensions, but I'm not sure. The safe way is to create a device tensor
+        // of shape [1, C_out, 1, 1] with bias values, then use cudnnAddTensor with
+        // alpha=1 and beta=1, and rely on broadcasting. cuDNN's cudnnAddTensor
+        // documentation says it supports broadcasting where one tensor may have
+        // dimension of 1 to broadcast to the larger tensor's dimension.
+        // We'll attempt this.
+        cudnnTensorDescriptor_t bias_full_desc;
+        CUDNN_CHECK(cudnnCreateTensorDescriptor(&bias_full_desc));
+        CUDNN_CHECK(cudnnSetTensor4dDescriptor(
+            bias_full_desc,
+            CUDNN_TENSOR_NCHW,
+            CUDNN_DATA_FLOAT,
+            1, (int)C_out, 1, 1
+        ));
