+        // We have bias_contig.data_ptr<float>() which points to C_out floats.
+        // Descriptor expects a tensor of dims [1,C_out,1,1], which is contiguous
+        // of size C_out. So we can use it directly.
+        float add_alpha = 1.0f, add_beta = 1.0f;
+        CUDNN_CHECK(cudnnAddTensor(
+            handle,
+            &add_alpha,
+            bias_full_desc,
+            bias_contig.data_ptr<float>(),
+            &add_beta,
+            dx_desc,
+            core_output.data_ptr<float>()
+        ));
+        CUDNN_CHECK(cudnnDestroyTensorDescriptor(bias_full_desc));
+    }
+
+    // Now handle output_padding: we need to add output_padding columns of zeros
+    // at the end of L dimension. Since output_padding is usually small (< stride),
+    // we can allocate final output and copy core_output into it, leaving the
+    // extra columns zeroed. We cannot use torch::cat or slicing because that
+    // would use torch ops. We can copy using cudaMemcpy2D for each batch and channel.
+    // Or we can allocate final output with torch::zeros and then copy each slice.
+    // Use cudaMemcpy2DAsync for each (n,c) pair.
+    auto final_output = torch::zeros({N, C_out, L_out}, x.options());
+    // Copy core_output (L_core elements per (n,c)) to final_output[..., :L_core]
+    // For each n,c, copy row of length L_core floats.
+    for (int64_t n = 0; n < N; ++n) {
+        for (int64_t c = 0; c < C_out; ++c) {
+            // Source pointer: core_output[n][c][0]
+            const float* src = core_output.data_ptr<float>() + n * C_out * L_core + c * L_core;
+            // Destination pointer: final_output[n][c][0]
+            float* dst = final_output.data_ptr<float>() + n * C_out * L_out + c * L_out;
+            CUDA_CHECK(cudaMemcpyAsync(dst, src, L_core * sizeof(float),
+                                       cudaMemcpyDeviceToDevice, stream));
+        }
+    }
+
+    // Cleanup
+    CUDA_CHECK(cudaFree(transposed_weight));
+    if (workspace) {
+        CUDA_CHECK(cudaFree(workspace));
+    }
+    CUDNN_CHECK(cudnnDestroyTensorDescriptor(x_desc));
+    CUDNN_CHECK(cudnnDestroyTensorDescriptor(y_desc));
+    CUDNN_CHECK(cudnnDestroyTensorDescriptor(dy_desc));
+    CUDNN_CHECK(cudnnDestroyTensorDescriptor(dx_desc));
+    CUDNN_CHECK(cudnnDestroyFilterDescriptor(w_desc));
+    CUDNN_CHECK(cudnnDestroyConvolutionDescriptor(conv_desc));
+    CUDNN_CHECK(cudnnDestroy(handle));
+
+    return final_output;
+}
