+        // write a kernel in .cpp. We can use cudnnAddTensor with a bias descriptor.
+        cudnnTensorDescriptor_t bias_desc;
+        CUDNN_CHECK(cudnnCreateTensorDescriptor(&bias_desc));
+        CUDNN_CHECK(cudnnSetTensor4dDescriptor(
+            bias_desc,
+            CUDNN_TENSOR_NCHW,
+            CUDNN_DATA_FLOAT,
+            1, (int)C_out, 1, 1
+        ));
