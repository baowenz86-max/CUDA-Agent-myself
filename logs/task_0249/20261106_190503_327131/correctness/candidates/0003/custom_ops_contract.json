          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, out_channels, output_length]"
      },
      "semantics": [
        "执行与参考 F.conv_transpose1d 相同的转置卷积，输入 x shape 为 [N, C_in, L_in]，weight shape 为 [C_in, C_out, kernel_size]，bias 可为 None，stride/padding/output_padding 为整数，输出 shape 为 [N, C_out, L_out]，其中 L_out = (L_in - 1) * stride - 2 * padding + kernel_size + output_padding。",
        "使用 cuDNN 实现 ConvTranspose1d，必须与参考代码的 bias、stride、padding、output_padding 完全一致。"
      ]
    },
    {
      "name": "custom_silu",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, out_channels, output_length]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, out_channels, output_length]"
      },
      "semantics": [
        "对输入张量逐元素计算 SiLU 激活函数：silu(x) = x * sigmoid(x)，输出 shape 与输入相同。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = F.conv_transpose1d(x, self.conv_transpose1d.weight, bias=self.conv_transpose1d.bias if self.bias else None, stride=self.stride, padding=self.padding, output_padding=self.output_padding)",
      "semantics": [
        "实际执行转置卷积，bias 根据 self.bias 决定，为模块 bias 或 None。",
        "输出 shape 由输入长度、kernel_size、stride、padding、output_padding 决定。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.silu(x)",
      "semantics": [
        "对转置卷积输出逐元素应用 SiLU 激活函数：x * sigmoid(x)。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回 Silu 后的张量，shape 为 [N, C_out, L_out]，dtype float32，device cuda:0。"
      ]
    }
  ]
