--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,79 @@
+#include <cuda_runtime.h>
+#include <cstdint>
+#include <cmath>
+
+// CPU comparison: torch.equal for int64 tensors
+extern "C" bool custom_equal_cpu_int64_launcher(
+    const int64_t* x,
+    const int64_t* y,
+    int64_t numel,
+    cudaStream_t stream)
+{
+    // This is a CPU-only operation; stream is unused.
+    for (int64_t i = 0; i < numel; ++i) {
+        if (x[i] != y[i]) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// CUDA kernel for sin(int64_t) -> float32
+__global__ void sin_int64_to_float_kernel(
+    const int64_t* __restrict__ input,
+    float* __restrict__ output,
+    int64_t numel)
+{
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        output[i] = static_cast<float>(sin(static_cast<double>(input[i])));
+    }
+}
+
+// Launcher for sin: copies int64 CPU tensor to GPU, computes sin, returns float32 output
+extern "C" bool custom_sin_cuda_int64_launcher(
+    const int64_t* cpu_input,
+    int64_t numel,
+    float* cuda_output,
+    cudaStream_t stream)
+{
+    int64_t* d_input = nullptr;
+    cudaError_t err = cudaMalloc(&d_input, numel * sizeof(int64_t));
+    if (err != cudaSuccess) {
+        return false;
+    }
+
+    err = cudaMemcpyAsync(d_input, cpu_input, numel * sizeof(int64_t), cudaMemcpyHostToDevice, stream);
+    if (err != cudaSuccess) {
+        cudaFree(d_input);
+        return false;
+    }
+
+    // Launch configuration: use 512 threads per block, enough blocks to cover numel with grid-stride loop
+    const int block_size = 512;
+    int64_t grid_size = (numel + block_size - 1) / block_size;
+    // Limit grid size to avoid exceeding max grid dimension (2^31-1)
+    const int64_t max_grid_size = 2147483647LL;
+    if (grid_size > max_grid_size) {
+        grid_size = max_grid_size;
+    }
+
+    sin_int64_to_float_kernel<<<(unsigned int)grid_size, block_size, 0, stream>>>(
+        d_input,
+        cuda_output,
+        numel);
+
+    err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        cudaFree(d_input);
+        return false;
+    }
+
+    err = cudaFree(d_input);
+    if (err != cudaSuccess) {
+        return false;
+    }
+
+    return true;
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,77 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" bool custom_equal_cpu_int64_launcher(
+    const int64_t* x,
+    const int64_t* y,
+    int64_t numel,
+    cudaStream_t stream);
+
+extern "C" bool custom_sin_cuda_int64_launcher(
+    const int64_t* cpu_input,
+    int64_t numel,
+    float* cuda_output,
+    cudaStream_t stream);
+
+bool custom_equal_cpu_int64(torch::Tensor x, torch::Tensor y) {
+    TORCH_CHECK(!x.is_cuda(), "custom_equal_cpu_int64: x must be a CPU tensor");
+    TORCH_CHECK(!y.is_cuda(), "custom_equal_cpu_int64: y must be a CPU tensor");
+    TORCH_CHECK(x.dtype() == torch::kInt64, "custom_equal_cpu_int64: x must be int64");
+    TORCH_CHECK(y.dtype() == torch::kInt64, "custom_equal_cpu_int64: y must be int64");
+    TORCH_CHECK(x.is_contiguous(), "custom_equal_cpu_int64: x must be contiguous");
+    TORCH_CHECK(y.is_contiguous(), "custom_equal_cpu_int64: y must be contiguous");
+    TORCH_CHECK(x.sizes() == y.sizes(), "custom_equal_cpu_int64: x and y must have the same shape");
+
+    int64_t numel = x.numel();
+    if (numel == 0) {
+        return true;
+    }
+
+    // Use the current CUDA stream (unused by launcher, but required for signature consistency)
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    return custom_equal_cpu_int64_launcher(
+        x.data_ptr<int64_t>(),
+        y.data_ptr<int64_t>(),
+        numel,
+        stream);
+}
+
+torch::Tensor custom_sin_cuda_int64(torch::Tensor x) {
+    TORCH_CHECK(!x.is_cuda(), "custom_sin_cuda_int64: x must be a CPU tensor");
+    TORCH_CHECK(x.dtype() == torch::kInt64, "custom_sin_cuda_int64: x must be int64");
+    TORCH_CHECK(x.is_contiguous(), "custom_sin_cuda_int64: x must be contiguous");
+
+    int64_t numel = x.numel();
+    auto output = torch::empty_like(x, x.options().dtype(torch::kFloat32).device(torch::kCUDA));
+    if (numel == 0) {
+        return output;
+    }
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    bool success = custom_sin_cuda_int64_launcher(
+        x.data_ptr<int64_t>(),
+        numel,
+        output.data_ptr<float>(),
+        stream);
+
+    TORCH_CHECK(success, "custom_sin_cuda_int64: launcher failed");
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_equal_cpu_int64", &custom_equal_cpu_int64,
+          "Compare two int64 CPU tensors element-wise (torch.equal)",
+          py::arg("x"), py::arg("y"));
+    m.def("custom_sin_cuda_int64", &custom_sin_cuda_int64,
+          "Compute sin of int64 CPU tensor, producing float32 CUDA tensor",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,20 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x: torch.Tensor, y: torch.Tensor) -> torch.Tensor:
+        equal = cuda_extension.custom_equal_cpu_int64(x, y)
+        sin = cuda_extension.custom_sin_cuda_int64(x)
+        return equal, sin
+
+    def debug_forward(self, x: torch.Tensor, y: torch.Tensor):
+        equal = cuda_extension.custom_equal_cpu_int64(x, y)
+        yield 'step_001', equal
+        sin = cuda_extension.custom_sin_cuda_int64(x)
+        yield 'step_002', sin
+        yield 'step_003', (equal, sin)
