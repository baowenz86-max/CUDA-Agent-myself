{
  "operators": [
    {
      "name": "custom_equal_cpu_int64",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.int64",
          "device": "cpu",
          "shape": "[16, 2048, 4096]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "y",
          "kind": "tensor",
          "dtype": "torch.int64",
          "device": "cpu",
          "shape": "[16, 2048, 4096]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "bool",
        "description": "Python bool indicating whether the two tensors are equal element-wise and have the same shape."
      },
      "semantics": [
        "对应参考 torch.equal(x, y)：比较两个 int64 CPU 张量，返回 bool。",
        "若形状不同或任一元素不等返回 False；否则 True。",
        "在 CPU 上顺序比较，不涉及广播。"
      ]
    },
    {
      "name": "custom_sin_cuda_int64",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.int64",
          "device": "cpu",
          "shape": "[16, 2048, 4096]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda:0",
        "shape": "[16, 2048, 4096]",
        "layout": "contiguous"
      },
      "semantics": [
        "对应参考 torch.sin(x)：对 int64 输入计算正弦，结果提升为 float32。",
        "首先将 CPU int64 张量复制到 CUDA，然后在 CUDA 上对每个元素计算 sin，输出 float32。",
        "保持原始 shape 和内存布局（contiguous）。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "equal = torch.equal(x, y)",
      "semantics": [
        "调用 torch.equal 比较 x 和 y，返回 bool。",
        "在本任务中两个输入形状相同且均为 1，因此返回 True。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "sin = torch.sin(x)",
      "semantics": [
        "对 int64 输入 x 计算正弦，结果提升为 float32 并在 CUDA 上计算。",
        "输出 shape 和 stride 与输入一致。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return (equal, sin)",
      "semantics": [
        "返回一个 tuple，包含 bool equal 和 CUDA float32 tensor sin。"
      ]
    }
  ]
}