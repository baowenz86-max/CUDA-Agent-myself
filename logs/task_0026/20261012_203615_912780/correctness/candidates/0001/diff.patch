--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,119 @@
+// CUDA kernels for one_hot, maximum_scalar, bucketize
+#include <cuda_runtime.h>
+
+// Kernel: one_hot_forward
+// Input: x (int64) shape [B, L]
+// Output: out (int64) shape [B, L, C]
+__global__ void one_hot_kernel(const long long* __restrict__ x,
+                               long long* __restrict__ out,
+                               long long num_elements,
+                               int num_classes,
+                               int L,
+                               int C) {
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = blockDim.x * gridDim.x;
+    for (; idx < num_elements; idx += stride) {
+        // Determine (b, l) from idx
+        long long b = idx / L;
+        long long l = idx % L;
+        long long cls = x[idx];
+        long long out_idx = (b * L + l) * C + cls;
+        out[out_idx] = 1;
+    }
+}
+
+// Kernel: maximum_scalar_forward
+// Input: x (float) shape [B, L, C]
+// Output: out (float) shape [B, L, C]
+// scalar: 0.0
+__global__ void maximum_scalar_kernel(const float* __restrict__ x,
+                                      float* __restrict__ out,
+                                      long long num_elements) {
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = blockDim.x * gridDim.x;
+    for (; idx < num_elements; idx += stride) {
+        float v = x[idx];
+        out[idx] = (v > 0.0f) ? v : 0.0f;
+    }
+}
+
+// Kernel: bucketize_forward
+// Input: values (float) shape [B, L]
+// boundaries: float 1D ascending, length nb
+// Output: out (int64) shape [B, L], right=False: largest i such that boundaries[i-1] < values[idx] <= boundaries[i]
+// Equivalent to upper_bound in sorted boundaries.
+__global__ void bucketize_kernel(const float* __restrict__ values,
+                                 const float* __restrict__ boundaries,
+                                 long long* __restrict__ out,
+                                 long long num_elements,
+                                 int nb) {
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = blockDim.x * gridDim.x;
+    for (; idx < num_elements; idx += stride) {
+        float val = values[idx];
+        // binary search upper_bound
+        int lo = 0, hi = nb;
+        while (lo < hi) {
+            int mid = (lo + hi) >> 1;
+            if (boundaries[mid] < val) {
+                lo = mid + 1;
+            } else {
+                hi = mid;
+            }
+        }
+        out[idx] = (long long)lo;
+    }
+}
+
+// Launcher: one_hot_forward
+// x: int64 pointer, shape [B, L]
+// num_elements: B*L
+// num_classes: C
+// L: sequence length
+// stream: CUDA stream
+extern "C" void one_hot_forward_launcher(const long long* x,
+                                          long long* out,
+                                          long long num_elements,
+                                          int num_classes,
+                                          int L,
+                                          cudaStream_t stream) {
+    // Determine block and grid sizes
+    const int threads = 256;
+    const long long blocks_ll = (num_elements + threads - 1) / threads;
+    const int max_grid = 65535;
+    int blocks = (int)min((long long)max_grid, blocks_ll);
+    one_hot_kernel<<<blocks, threads, 0, stream>>>(x, out, num_elements, num_classes, L, num_classes);
+}
+
+// Launcher: maximum_scalar_forward
+// x: float pointer, shape [B, L, C]
+// num_elements: B*L*C
+extern "C" void maximum_scalar_forward_launcher(const float* x,
+                                                  float* out,
+                                                  long long num_elements,
+                                                  cudaStream_t stream) {
+    const int threads = 256;
+    const long long blocks_ll = (num_elements + threads - 1) / threads;
+    const int max_grid = 65535;
+    int blocks = (int)min((long long)max_grid, blocks_ll);
+    maximum_scalar_kernel<<<blocks, threads, 0, stream>>>(x, out, num_elements);
+}
+
+// Launcher: bucketize_forward
+// values: float pointer, shape [B, L]
+// boundaries: float pointer, length nb
+// out: int64 pointer, shape [B, L]
+// num_elements: B*L
+// nb: number of boundaries
+extern "C" void bucketize_forward_launcher(const float* values,
+                                             const float* boundaries,
+                                             long long* out,
+                                             long long num_elements,
+                                             int nb,
+                                             cudaStream_t stream) {
+    const int threads = 256;
+    const long long blocks_ll = (num_elements + threads - 1) / threads;
+    const int max_grid = 65535;
+    int blocks = (int)min((long long)max_grid, blocks_ll);
+    bucketize_kernel<<<blocks, threads, 0, stream>>>(values, boundaries, out, num_elements, nb);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,115 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void one_hot_forward_launcher(const long long* x,
+                                          long long* out,
+                                          long long num_elements,
+                                          int num_classes,
+                                          int L,
+                                          cudaStream_t stream);
+
+extern "C" void maximum_scalar_forward_launcher(const float* x,
+                                                  float* out,
+                                                  long long num_elements,
+                                                  cudaStream_t stream);
+
+extern "C" void bucketize_forward_launcher(const float* values,
+                                             const float* boundaries,
+                                             long long* out,
+                                             long long num_elements,
+                                             int nb,
+                                             cudaStream_t stream);
+
+// one_hot_forward: x (int64) shape [B, L], returns int64 shape [B, L, num_classes]
+torch::Tensor one_hot_forward(torch::Tensor x, int64_t num_classes) {
+    TORCH_CHECK(x.is_cuda(), "Input x must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kInt64, "Input x must be int64");
+    TORCH_CHECK(x.is_contiguous(), "Input x must be contiguous");
+    TORCH_CHECK(x.dim() >= 1, "Input x must have at least 1 dimension");
+
+    auto sizes = x.sizes();
+    auto output_sizes = sizes.vec();
+    output_sizes.push_back(num_classes);
+    auto out = torch::empty(output_sizes, x.options());
+
+    long long num_elements = x.numel();
+    int L = (x.dim() == 1) ? x.size(0) : x.size(-1);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    one_hot_forward_launcher(
+        x.data_ptr<long long>(),
+        out.data_ptr<long long>(),
+        num_elements,
+        static_cast<int>(num_classes),
+        L,
+        stream
+    );
+
+    return out;
+}
+
+// maximum_scalar_forward: x (float32) shape [B, L, C], returns float32 same shape
+torch::Tensor maximum_scalar_forward(torch::Tensor x, double scalar) {
+    TORCH_CHECK(x.is_cuda(), "Input x must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input x must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input x must be contiguous");
+    TORCH_CHECK(scalar == 0.0, "Only scalar=0.0 is supported");
+
+    auto out = torch::empty_like(x);
+    long long num_elements = x.numel();
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    maximum_scalar_forward_launcher(
+        x.data_ptr<float>(),
+        out.data_ptr<float>(),
+        num_elements,
+        stream
+    );
+
+    return out;
+}
+
+// bucketize_forward: values (float32) shape [B, L], boundaries (float32) 1D, returns int64 shape [B, L]
+torch::Tensor bucketize_forward(torch::Tensor values, torch::Tensor boundaries) {
+    TORCH_CHECK(values.is_cuda(), "Input values must be a CUDA tensor");
+    TORCH_CHECK(values.dtype() == torch::kFloat32, "Input values must be float32");
+    TORCH_CHECK(values.is_contiguous(), "Input values must be contiguous");
+    TORCH_CHECK(boundaries.is_cuda(), "Boundaries must be a CUDA tensor");
+    TORCH_CHECK(boundaries.dtype() == torch::kFloat32, "Boundaries must be float32");
+    TORCH_CHECK(boundaries.is_contiguous(), "Boundaries must be contiguous");
+    TORCH_CHECK(boundaries.dim() == 1, "Boundaries must be 1-dimensional");
+
+    auto out = torch::empty_like(values, values.options().dtype(torch::kInt64));
+    long long num_elements = values.numel();
+    int nb = static_cast<int>(boundaries.numel());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    bucketize_forward_launcher(
+        values.data_ptr<float>(),
+        boundaries.data_ptr<float>(),
+        out.data_ptr<long long>(),
+        num_elements,
+        nb,
+        stream
+    );
+
+    return out;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("one_hot_forward", &one_hot_forward,
+          "One-hot encode int64 tensor",
+          pybind11::arg("x"), pybind11::arg("num_classes"));
+    m.def("maximum_scalar_forward", &maximum_scalar_forward,
+          "Element-wise maximum with scalar",
+          pybind11::arg("x"), pybind11::arg("scalar"));
+    m.def("bucketize_forward", &bucketize_forward,
+          "Bucketize values using boundaries",
+          pybind11::arg("values"), pybind11::arg("boundaries"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,29 @@
+import torch
+import torch.nn as nn
+
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, num_classes, bucket_boundaries_shape):
+        super().__init__()
+        self.num_classes = num_classes
+        self.bucket_boundaries = nn.Parameter(torch.randn(bucket_boundaries_shape))
+
+    def forward(self, x, values):
+        x = cuda_extension.one_hot_forward(x, self.num_classes)
+        x = cuda_extension.maximum_scalar_forward(x, 0.0)
+        x = cuda_extension.bucketize_forward(values, self.bucket_boundaries)
+        return x
+
+    def debug_forward(self, x, values):
+        one_hot = cuda_extension.one_hot_forward(x, self.num_classes)
+        yield 'step_001', one_hot
+
+        maximum = cuda_extension.maximum_scalar_forward(one_hot, 0.0)
+        yield 'step_002', maximum
+
+        bucketize = cuda_extension.bucketize_forward(values, self.bucket_boundaries)
+        yield 'step_003', bucketize
+
+        yield 'step_004', bucketize
