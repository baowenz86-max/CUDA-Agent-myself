+static bool load_cudnn_library() {
+    CudnnAPI& api = get_cudnn_api();
+    if (api.loaded) return true;
+    if (api.load_failed) return false;
+    
+    // Try common library names
+    const char* libnames[] = {"libcudnn.so", "libcudnn.so.8", "libcudnn.so.7"};
+    for (const char* name : libnames) {
+        api.handle = dlopen(name, RTLD_NOW | RTLD_GLOBAL);
+        if (api.handle) break;
+    }
+    if (!api.handle) {
+        api.load_failed = true;
+        return false;
+    }
+    
+    #define LOAD_SYMBOL(name) do { \
+        api.name = (decltype(api.name))dlsym(api.handle, #name); \
+        if (!api.name) { \
+            dlclose(api.handle); \
+            api.handle = nullptr; \
+            api.load_failed = true; \
+            return false; \
+        } \
+    } while(0)
+    
+    LOAD_SYMBOL(cudnnCreate);
+    LOAD_SYMBOL(cudnnDestroy);
+    LOAD_SYMBOL(cudnnSetStream);
