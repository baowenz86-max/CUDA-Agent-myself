--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,94 @@
+#include <cuda_runtime.h>
+
+// CUDA kernels and launchers for max_dim1 and expm1 operations.
+// This file must not include torch/ATen/pybind headers.
+// Bindings in kernels/*_binding.cpp will call these launchers.
+
+// Kernel: compute max over dim=1 (channels) with keepdim=True.
+// Input: float* x with shape [batch, channels, height, width], arbitrary strides.
+// Output: float* values, int64_t* indices, shape [batch, 1, height, width].
+// tie-breaking: first max index.
+__global__ void max_dim1_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ values,
+    int64_t* __restrict__ indices,
+    int batch,
+    int channels,
+    int height,
+    int width,
+    long long total) {
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (; idx < total; idx += stride) {
+        // Decode linear index into batch, h, w (since output has same shape but channels=1)
+        int w = idx % width;
+        long long tmp = idx / width;
+        int h = tmp % height;
+        int b = tmp / height;
+
+        // Input offset for channel 0 at (b,0,h,w)
+        // Input strides: assume contiguous? We'll compute using base index: b*channels*height*width + c*height*width + h*width + w
+        // But support non-contiguous? The contract says input can be non-contiguous; we can handle strides by passing strides, but launcher currently passes raw pointer; we assume contiguous for now as contract says 'contiguous or supports strides'.
+        // For simplicity, we'll assume input is contiguous (as provided strides are contiguous).
+        // If non-contiguous, binding may make contiguous before calling.
+        long long base = ((long long)b * channels + 0LL) * ((long long)height * width) + (long long)h * width + w;
+        float max_val = x[base];
+        int max_idx = 0;
+        for (int c = 1; c < channels; ++c) {
+            long long offset = ((long long)b * channels + c) * ((long long)height * width) + (long long)h * width + w;
+            float val = x[offset];
+            if (val > max_val) {
+                max_val = val;
+                max_idx = c;
+            }
+        }
+        values[idx] = max_val;
+        indices[idx] = max_idx;
+    }
+}
+
+// Kernel: expm1 elementwise. Output same shape as input.
+__global__ void expm1_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ y,
+    long long total) {
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (; idx < total; idx += stride) {
+        y[idx] = expf(x[idx]) - 1.0f;
+    }
+}
+
+// Launcher for max_dim1. Assumes x is contiguous float32 CUDA tensor.
+// Outputs values (float) and indices (int64_t) allocated by caller.
+extern "C" void max_dim1_kernel_launcher(
+    const float* x,
+    float* values,
+    int64_t* indices,
+    int batch,
+    int channels,
+    int height,
+    int width,
+    cudaStream_t stream) {
+    long long total = (long long)batch * height * width;
+    int threads = 256;
+    int blocks = (int)((total + threads - 1) / threads);
+    // Cap blocks at 65535 for old GPUs; but we need grid-stride loop for larger.
+    int max_blocks = 65535;
+    if (blocks > max_blocks) blocks = max_blocks;
+    max_dim1_kernel<<<blocks, threads, 0, stream>>>(
+        x, values, indices, batch, channels, height, width, total);
+}
+
+// Launcher for expm1. Assumes x contiguous float32, output y allocated by caller.
+extern "C" void expm1_kernel_launcher(
+    const float* x,
+    float* y,
+    long long total,
+    cudaStream_t stream) {
+    int threads = 256;
+    int blocks = (int)((total + threads - 1) / threads);
+    int max_blocks = 65535;
+    if (blocks > max_blocks) blocks = max_blocks;
+    expm1_kernel<<<blocks, threads, 0, stream>>>(x, y, total);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,107 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void max_dim1_kernel_launcher(
+    const float* x,
+    float* values,
+    int64_t* indices,
+    int batch,
+    int channels,
+    int height,
+    int width,
+    cudaStream_t stream
+);
+
+extern "C" void expm1_kernel_launcher(
+    const float* x,
+    float* y,
+    long long total,
+    cudaStream_t stream
+);
+
+// Wrapper for max_dim1_kernel
+// Returns torch.return_types.max with values and indices
+torch::return_types::max max_dim1_kernel(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D [batch, channels, height, width]");
+
+    // Ensure input is contiguous for the launcher
+    torch::Tensor x_contig = x.contiguous();
+
+    int batch = x_contig.size(0);
+    int channels = x_contig.size(1);
+    int height = x_contig.size(2);
+    int width = x_contig.size(3);
+
+    // Output shapes: [batch, 1, height, width]
+    auto options_values = torch::TensorOptions()
+        .dtype(torch::kFloat32)
+        .device(x.device());
+    auto options_indices = torch::TensorOptions()
+        .dtype(torch::kInt64)
+        .device(x.device());
+
+    torch::Tensor values = torch::empty({batch, 1, height, width}, options_values);
+    torch::Tensor indices = torch::empty({batch, 1, height, width}, options_indices);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    max_dim1_kernel_launcher(
+        x_contig.data_ptr<float>(),
+        values.data_ptr<float>(),
+        indices.data_ptr<int64_t>(),
+        batch,
+        channels,
+        height,
+        width,
+        stream
+    );
+
+    // Check for CUDA errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA error in max_dim1_kernel: ", cudaGetErrorString(err));
+
+    return {values, indices};
+}
+
+// Wrapper for expm1_kernel
+torch::Tensor expm1_kernel(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+
+    // Launcher expects contiguous input
+    torch::Tensor x_contig = x.contiguous();
+
+    auto output = torch::empty_like(x_contig);
+
+    long long total = x_contig.numel();
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    expm1_kernel_launcher(
+        x_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        total,
+        stream
+    );
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA error in expm1_kernel: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// Registration
+void register_custom_ops(pybind11::module& m) {
+    m.def("max_dim1_kernel", &max_dim1_kernel, "Compute max over dim=1 with keepdim=True. Returns (values, indices)",
+          py::arg("x"));
+    m.def("expm1_kernel", &expm1_kernel, "Compute exp(x)-1 elementwise",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,32 @@
+import torch
+
+
+class ModelNew(torch.nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x):
+        max_result = cuda_extension.max_dim1_kernel(x)
+        x = max_result.values
+        x = cuda_extension.expm1_kernel(x)
+        return x
+
+    def debug_forward(self, x):
+        import cuda_extension
+        import torch
+        from torch.utils.hooks import RemovableHandle
+
+        checkpoints = [
+            ('step_001', lambda: (self._max_step(x),)),
+            ('step_002', lambda: (self._expm1_step(self._max_step(x)[0]),)),
+            ('step_003', lambda: (self._expm1_step(self._max_step(x)[0]),)),
+        ]
+
+        for checkpoint_id, fn in checkpoints:
+            yield checkpoint_id, fn()[0]
+
+    def _max_step(self, x):
+        return cuda_extension.max_dim1_kernel(x)
+
+    def _expm1_step(self, x):
+        return cuda_extension.expm1_kernel(x)
