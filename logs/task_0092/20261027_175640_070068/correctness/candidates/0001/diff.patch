--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,188 @@
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// Helper to compute linear index from 4D strides
+__device__ __forceinline__ int64_t idx4(int64_t n, int64_t c, int64_t h, int64_t w,
+                                        int64_t stride_n, int64_t stride_c, int64_t stride_h, int64_t stride_w) {
+    return n * stride_n + c * stride_c + h * stride_h + w * stride_w;
+}
+
+// Softmax along dim=1 (C dimension)
+// Input: x shape (N, C, H, W), output same shape
+// Each thread block handles one (n, h, w) position, loops over C
+__global__ void softmax_dim1_kernel(const float* __restrict__ input,
+                                     float* __restrict__ output,
+                                     int N, int C, int H, int W,
+                                     int64_t stride_n, int64_t stride_c, int64_t stride_h, int64_t stride_w) {
+    int64_t total_positions = (int64_t)N * H * W;
+    int64_t pos = blockIdx.x * blockDim.x + threadIdx.x;
+    if (pos >= total_positions) return;
+
+    int n = pos / (H * W);
+    int rem = pos % (H * W);
+    int h = rem / W;
+    int w = rem % W;
+
+    // Find max for numerical stability
+    float max_val = -1e30f;
+    for (int c = 0; c < C; ++c) {
+        int64_t idx = idx4(n, c, h, w, stride_n, stride_c, stride_h, stride_w);
+        float v = input[idx];
+        if (v > max_val) max_val = v;
+    }
+
+    // Compute exp sum
+    float sum_exp = 0.0f;
+    for (int c = 0; c < C; ++c) {
+        int64_t idx = idx4(n, c, h, w, stride_n, stride_c, stride_h, stride_w);
+        float v = expf(input[idx] - max_val);
+        output[idx] = v;
+        sum_exp += v;
+    }
+
+    // Normalize
+    float inv_sum = 1.0f / sum_exp;
+    for (int c = 0; c < C; ++c) {
+        int64_t idx = idx4(n, c, h, w, stride_n, stride_c, stride_h, stride_w);
+        output[idx] *= inv_sum;
+    }
+}
+
+// Sort along dim=1 (C dimension) using insertion sort within one thread per (n,h,w)
+// For small C (like 10), insertion sort is efficient and stable.
+// Two kernels to optionally produce indices.
+__global__ void sort_dim1_values_kernel(const float* __restrict__ input,
+                                         float* __restrict__ output,
+                                         int N, int C, int H, int W,
+                                         int64_t stride_n, int64_t stride_c, int64_t stride_h, int64_t stride_w) {
+    int64_t total_positions = (int64_t)N * H * W;
+    int64_t pos = blockIdx.x * blockDim.x + threadIdx.x;
+    if (pos >= total_positions) return;
+
+    int n = pos / (H * W);
+    int rem = pos % (H * W);
+    int h = rem / W;
+    int w = rem % W;
+
+    float vals[32]; // assume C <= 32, currently C=10
+    for (int c = 0; c < C; ++c) {
+        int64_t idx = idx4(n, c, h, w, stride_n, stride_c, stride_h, stride_w);
+        vals[c] = input[idx];
+    }
+
+    // Insertion sort (stable)
+    for (int i = 1; i < C; ++i) {
+        float key = vals[i];
+        int j = i - 1;
+        while (j >= 0 && vals[j] > key) {
+            vals[j + 1] = vals[j];
+            j--;
+        }
+        vals[j + 1] = key;
+    }
+
+    for (int c = 0; c < C; ++c) {
+        int64_t idx = idx4(n, c, h, w, stride_n, stride_c, stride_h, stride_w);
+        output[idx] = vals[c];
+    }
+}
+
+__global__ void sort_dim1_values_indices_kernel(const float* __restrict__ input,
+                                                 float* __restrict__ sorted_values,
+                                                 int64_t* __restrict__ indices,
+                                                 int N, int C, int H, int W,
+                                                 int64_t stride_n, int64_t stride_c, int64_t stride_h, int64_t stride_w) {
+    int64_t total_positions = (int64_t)N * H * W;
+    int64_t pos = blockIdx.x * blockDim.x + threadIdx.x;
+    if (pos >= total_positions) return;
+
+    int n = pos / (H * W);
+    int rem = pos % (H * W);
+    int h = rem / W;
+    int w = rem % W;
+
+    float vals[32];
+    int64_t idxs[32];
+    for (int c = 0; c < C; ++c) {
+        int64_t idx = idx4(n, c, h, w, stride_n, stride_c, stride_h, stride_w);
+        vals[c] = input[idx];
+        idxs[c] = c;
+    }
+
+    // Insertion sort (stable by only swapping when strictly greater)
+    for (int i = 1; i < C; ++i) {
+        float key_val = vals[i];
+        int64_t key_idx = idxs[i];
+        int j = i - 1;
+        while (j >= 0 && vals[j] > key_val) {
+            vals[j + 1] = vals[j];
+            idxs[j + 1] = idxs[j];
+            j--;
+        }
+        vals[j + 1] = key_val;
+        idxs[j + 1] = key_idx;
+    }
+
+    for (int c = 0; c < C; ++c) {
+        int64_t idx = idx4(n, c, h, w, stride_n, stride_c, stride_h, stride_w);
+        sorted_values[idx] = vals[c];
+        indices[idx] = idxs[c];
+    }
+}
+
+// Launchers
+extern "C" void custom_softmax_dim1_launcher(const float* input,
+                                               float* output,
+                                               int64_t N, int64_t C, int64_t H, int64_t W,
+                                               int64_t stride_n, int64_t stride_c, int64_t stride_h, int64_t stride_w,
+                                               cudaStream_t stream) {
+    int64_t total_positions = N * H * W;
+    int threads = 256;
+    int64_t blocks = (total_positions + threads - 1) / threads;
+    if (blocks > 0) {
+        softmax_dim1_kernel<<<(unsigned int)blocks, threads, 0, stream>>>(
+            input, output, (int)N, (int)C, (int)H, (int)W,
+            stride_n, stride_c, stride_h, stride_w);
+    }
+}
+
+extern "C" void custom_sort_dim1_launcher(const float* input,
+                                           float* sorted_values,
+                                           int64_t* indices, // can be nullptr if return_key=false
+                                           int return_key,
+                                           int64_t N, int64_t C, int64_t H, int64_t W,
+                                           int64_t stride_n, int64_t stride_c, int64_t stride_h, int64_t stride_w,
+                                           cudaStream_t stream) {
+    int64_t total_positions = N * H * W;
+    int threads = 256;
+    int64_t blocks = (total_positions + threads - 1) / threads;
+    if (blocks > 0) {
+        if (return_key) {
+            sort_dim1_values_indices_kernel<<<(unsigned int)blocks, threads, 0, stream>>>(
+                input, sorted_values, indices, (int)N, (int)C, (int)H, (int)W,
+                stride_n, stride_c, stride_h, stride_w);
+        } else {
+            sort_dim1_values_kernel<<<(unsigned int)blocks, threads, 0, stream>>>(
+                input, sorted_values, (int)N, (int)C, (int)H, (int)W,
+                stride_n, stride_c, stride_h, stride_w);
+        }
+    }
+}
+
+// Split along dim=1. Since splitting is a view operation and we cannot return tensors,
+// this function simply computes the offsets and sizes for each chunk. The binding layer
+// will use these to create narrow views. Here we define a helper that can be called from
+// C++ (binding) but since this .cu cannot include torch, we expose an extern "C" function
+// that fills arrays with chunk offsets.
+extern "C" void custom_split_dim1_offsets(int64_t C, int64_t chunk_size,
+                                         int64_t* offsets_out, int64_t* sizes_out,
+                                         int* num_chunks_out) {
+    int num_chunks = (int)((C + chunk_size - 1) / chunk_size);
+    *num_chunks_out = num_chunks;
+    for (int i = 0; i < num_chunks; ++i) {
+        int64_t start = i * chunk_size;
+        int64_t size = (start + chunk_size <= C) ? chunk_size : (C - start);
+        offsets_out[i] = start;
+        sizes_out[i] = size;
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,130 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cstdint>
+#include <vector>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void custom_softmax_dim1_launcher(const float* input,
+                                               float* output,
+                                               int64_t N, int64_t C, int64_t H, int64_t W,
+                                               int64_t stride_n, int64_t stride_c, int64_t stride_h, int64_t stride_w,
+                                               cudaStream_t stream);
+
+extern "C" void custom_sort_dim1_launcher(const float* input,
+                                           float* sorted_values,
+                                           int64_t* indices,
+                                           int return_key,
+                                           int64_t N, int64_t C, int64_t H, int64_t W,
+                                           int64_t stride_n, int64_t stride_c, int64_t stride_h, int64_t stride_w,
+                                           cudaStream_t stream);
+
+extern "C" void custom_split_dim1_offsets(int64_t C, int64_t chunk_size,
+                                         int64_t* offsets_out, int64_t* sizes_out,
+                                         int* num_chunks_out);
+
+// Helper to check common tensor requirements
+static void check_cuda_float32_4d(const torch::Tensor& x, const char* op_name) {
+    TORCH_CHECK(x.is_cuda(), op_name, ": input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, op_name, ": input must be float32");
+    TORCH_CHECK(x.dim() == 4, op_name, ": input must be 4D (N,C,H,W)");
+}
+
+static torch::Tensor custom_softmax_dim1(torch::Tensor x) {
+    check_cuda_float32_4d(x, "custom_softmax_dim1");
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_softmax_dim1_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C, H, W,
+        x.stride(0), x.stride(1), x.stride(2), x.stride(3),
+        stream
+    );
+
+    return output;
+}
+
+static py::tuple custom_sort_dim1(torch::Tensor x, bool return_key = false) {
+    check_cuda_float32_4d(x, "custom_sort_dim1");
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+
+    auto sorted_values = torch::empty_like(x);
+    torch::Tensor indices;
+    if (return_key) {
+        indices = torch::empty_like(x, x.options().dtype(torch::kInt64));
+    }
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_sort_dim1_launcher(
+        x.data_ptr<float>(),
+        sorted_values.data_ptr<float>(),
+        return_key ? indices.data_ptr<int64_t>() : nullptr,
+        return_key ? 1 : 0,
+        N, C, H, W,
+        x.stride(0), x.stride(1), x.stride(2), x.stride(3),
+        stream
+    );
+
+    if (return_key) {
+        return py::make_tuple(sorted_values, indices);
+    } else {
+        return py::make_tuple(sorted_values);
+    }
+}
+
+static py::tuple custom_split_dim1(torch::Tensor x, int64_t chunk_size) {
+    check_cuda_float32_4d(x, "custom_split_dim1");
+    TORCH_CHECK(chunk_size > 0, "custom_split_dim1: chunk_size must be positive");
+
+    int64_t C = x.size(1);
+    int num_chunks = (int)((C + chunk_size - 1) / chunk_size);
+
+    std::vector<int64_t> offsets(num_chunks);
+    std::vector<int64_t> sizes(num_chunks);
+    int num_chunks_from_cuda = 0;
+
+    // Call helper to compute offsets/sizes (host function, no CUDA needed)
+    custom_split_dim1_offsets(C, chunk_size, offsets.data(), sizes.data(), &num_chunks_from_cuda);
+    TORCH_CHECK(num_chunks_from_cuda == num_chunks, "custom_split_dim1: chunk calculation mismatch");
+
+    py::tuple result(num_chunks);
+    for (int i = 0; i < num_chunks; ++i) {
+        // Use narrow to create a view along dim=1, sharing storage
+        result[i] = x.narrow(1, offsets[i], sizes[i]);
+    }
+    return result;
+}
+
+static void register_custom_ops(pybind11::module& m) {
+    m.def("custom_softmax_dim1", &custom_softmax_dim1,
+          "Custom softmax along dim=1 for 4D tensor",
+          py::arg("x"));
+
+    m.def("custom_sort_dim1", &custom_sort_dim1,
+          "Custom sort along dim=1 for 4D tensor; returns tuple of (sorted_values, indices) if return_key=true else (sorted_values,)",
+          py::arg("x"),
+          py::arg("return_key") = false);
+
+    m.def("custom_split_dim1", &custom_split_dim1,
+          "Split tensor along dim=1 into views of given chunk_size",
+          py::arg("x"),
+          py::arg("chunk_size"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,45 @@
+import torch
+import torch.nn as nn
+
+
+class ModelNew(nn.Module):
+    def __init__(self, n_class, chunks, dim_chunk):
+        super().__init__()
+        self.n_class = n_class
+        self.chunks = chunks
+        self.dim_chunk = dim_chunk
+
+    def forward(self, x):
+        x = self._move_to_cuda(x)
+        x = custom_softmax_dim1(x)
+        x = custom_sort_dim1(x, return_key=False)
+        out = custom_split_dim1(x, self.dim_chunk)
+        return out
+
+    def debug_forward(self, x):
+        x = self._move_to_cuda(x)
+        # step_001: softmax
+        x = custom_softmax_dim1(x)
+        yield 'step_001', x
+        # step_002: sort (need full tuple with indices)
+        sort_result = custom_sort_dim1(x, return_key=True)
+        yield 'step_002', sort_result
+        x = sort_result[0]
+        # step_003: split
+        out = custom_split_dim1(x, self.dim_chunk)
+        yield 'step_003', out
+        # step_004: return x
+        yield 'step_004', out
+
+    def _move_to_cuda(self, x):
+        if not x.is_cuda:
+            x = x.to('cuda')
+        return x
+
+
+import cuda_extension
+
+# These names will be resolved at runtime from cuda_extension
+custom_softmax_dim1 = cuda_extension.custom_softmax_dim1
+custom_sort_dim1 = cuda_extension.custom_sort_dim1
+custom_split_dim1 = cuda_extension.custom_split_dim1
