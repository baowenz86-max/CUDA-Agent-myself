--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,149 @@
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// Softmax over dim=1 for tensor shape [N, C, H, W] where C=10, float32
+// Block size = C (10), one block per (n, h, w) position.
+// Grid dimension: N * H * W blocks.
+// Input/output must be contiguous with strides [C*H*W, H*W, W, 1] (row-major).
+// Launcher handles non-contiguous inputs by copying to contiguous in binding.
+__global__ void softmax_dim1_kernel(const float* __restrict__ input,
+                                    float* __restrict__ output,
+                                    int C, int HW) {
+    // blockIdx.x encodes n*h*w position (flattened)
+    int pos = blockIdx.x;
+    int base = pos * C;
+    __shared__ float smem[10];
+    // Load C values into shared memory, compute max
+    float max_val = -1e30f;
+    for (int i = threadIdx.x; i < C; i += blockDim.x) {
+        float val = input[base + i];
+        smem[i] = val;
+        max_val = fmaxf(max_val, val);
+    }
+    __syncthreads();
+    // Reduce max across block (C small, use simple loop)
+    // Since C=10 and threads=10, each thread has one element, no need for reduction,
+    // but we keep generic: compute shared max via warp shuffle? Simpler: recompute max from smem.
+    // Actually after __syncthreads, all smem filled. Each thread can compute max from smem sequentially.
+    // But we already computed max_val per thread, need global max. For C=10, use block reduction:
+    // Use shared memory to store partial maxes (optional). Since C=10, just recompute max from smem for each thread.
+    float block_max = -1e30f;
+    for (int i = 0; i < C; ++i) {
+        block_max = fmaxf(block_max, smem[i]);
+    }
+    __syncthreads();
+    // Compute exp and sum
+    float sum_exp = 0.0f;
+    for (int i = threadIdx.x; i < C; i += blockDim.x) {
+        smem[i] = __expf(smem[i] - block_max);
+    }
+    __syncthreads();
+    for (int i = 0; i < C; ++i) {
+        sum_exp += smem[i];
+    }
+    __syncthreads();
+    // Write output
+    for (int i = threadIdx.x; i < C; i += blockDim.x) {
+        output[base + i] = smem[i] / sum_exp;
+    }
+}
+
+// Stable sort along dim=1 for C=10 elements, one block per (n, h, w).
+// Inputs: values (float), output values and indices (int64).
+// Uses shared memory and simple insertion sort (stable).
+__global__ void sort_dim1_kernel(const float* __restrict__ input,
+                                  float* __restrict__ out_values,
+                                  int64_t* __restrict__ out_indices,
+                                  int C, int HW) {
+    int pos = blockIdx.x;
+    int base = pos * C;
+    __shared__ float vals[10];
+    __shared__ int64_t idx[10];
+    for (int i = threadIdx.x; i < C; i += blockDim.x) {
+        vals[i] = input[base + i];
+        idx[i] = i;
+    }
+    __syncthreads();
+    // Insertion sort (stable) executed redundantly by all threads or just thread 0?
+    // Since C=10, let each thread do the sort? That would duplicate work but okay.
+    // Better: have all threads cooperate on sorting? Simpler: each thread performs the entire sort
+    // because C is small, then writes its own element.
+    if (threadIdx.x < C) {
+        for (int i = 1; i < C; ++i) {
+            float key_val = vals[i];
+            int64_t key_idx = idx[i];
+            int j = i - 1;
+            while (j >= 0 && vals[j] > key_val) {
+                vals[j + 1] = vals[j];
+                idx[j + 1] = idx[j];
+                --j;
+            }
+            vals[j + 1] = key_val;
+            idx[j + 1] = key_idx;
+        }
+    }
+    __syncthreads();
+    int i = threadIdx.x;
+    if (i < C) {
+        out_values[base + i] = vals[i];
+        out_indices[base + i] = idx[i];
+    }
+}
+
+// Split: copy subtensors along dim=1 (C) into output tensors.
+// Input: contiguous float tensor of shape [N, C, H, W].
+// Output: array of output pointers, each with shape [N, chunk_size, H, W], stored contiguously.
+// Since binding will allocate each output tensor with shape [N, chunk_size, H, W], we simply copy the corresponding slices.
+// The launcher receives output pointers for all chunks.
+__global__ void split_copy_kernel(const float* __restrict__ input,
+                                  float** __restrict__ outputs,
+                                  int C, int chunk_size, int num_chunks, int HW) {
+    // Grid: one block per (n, h*w) -> total N*HW blocks.
+    int pos = blockIdx.x; // n*HW + hw
+    int n = pos / HW;
+    int hw = pos % HW;
+    int input_offset = n * C * HW + hw;
+    int chunk_idx = threadIdx.x; // chunk index (0..num_chunks-1)
+    if (chunk_idx >= num_chunks) return;
+    int this_chunk_size = (chunk_idx < num_chunks - 1) ? chunk_size : (C - chunk_idx * chunk_size);
+    if (this_chunk_size <= 0) return;
+    const float* src = input + input_offset + chunk_idx * chunk_size * HW;
+    float* dst = outputs[chunk_idx] + n * this_chunk_size * HW + hw;
+    // copy this_chunk_size elements along dim=1
+    for (int c = 0; c < this_chunk_size; ++c) {
+        dst[c * HW] = src[c * HW];
+    }
+}
+
+// Launcher functions
+extern "C" void softmax_forward_launcher(const float* input,
+                                           float* output,
+                                           int N, int C, int H, int W,
+                                           cudaStream_t stream) {
+    int HW = H * W;
+    int num_blocks = N * HW;
+    softmax_dim1_kernel<<<num_blocks, C, 0, stream>>>(input, output, C, HW);
+}
+
+extern "C" void sort_forward_launcher(const float* input,
+                                        float* out_values,
+                                        int64_t* out_indices,
+                                        int N, int C, int H, int W,
+                                        cudaStream_t stream) {
+    int HW = H * W;
+    int num_blocks = N * HW;
+    sort_dim1_kernel<<<num_blocks, C, 0, stream>>>(input, out_values, out_indices, C, HW);
+}
+
+extern "C" void split_forward_launcher(const float* input,
+                                         float** outputs,
+                                         int N, int C, int H, int W,
+                                         int split_size, int num_chunks,
+                                         cudaStream_t stream) {
+    int HW = H * W;
+    int num_blocks = N * HW;
+    // Each block handles one (n,hw) position and all chunks by looping over chunks in threads.
+    // We launch with num_chunks threads per block.
+    // But kernel assumes threadIdx.x corresponds to chunk idx, so blockDim.x = num_chunks.
+    split_copy_kernel<<<num_blocks, num_chunks, 0, stream>>>(input, outputs, C, split_size, num_chunks, HW);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,182 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+#include <vector>
+
+// Declare launchers from custom_ops.cu
+extern "C" void softmax_forward_launcher(const float* input,
+                                           float* output,
+                                           int N, int C, int H, int W,
+                                           cudaStream_t stream);
+
+extern "C" void sort_forward_launcher(const float* input,
+                                        float* out_values,
+                                        int64_t* out_indices,
+                                        int N, int C, int H, int W,
+                                        cudaStream_t stream);
+
+extern "C" void split_forward_launcher(const float* input,
+                                         float** outputs,
+                                         int N, int C, int H, int W,
+                                         int split_size, int num_chunks,
+                                         cudaStream_t stream);
+
+static void check_cuda_error(const char* msg) {
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, msg, ": ", cudaGetErrorString(err));
+}
+
+torch::Tensor softmax_forward(torch::Tensor x, int64_t dim) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D");
+    TORCH_CHECK(dim == 1, "Only dim=1 is supported");
+
+    // Ensure contiguous
+    if (!x.is_contiguous()) {
+        x = x.contiguous();
+    }
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    softmax_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int>(N),
+        static_cast<int>(C),
+        static_cast<int>(H),
+        static_cast<int>(W),
+        stream
+    );
+
+    check_cuda_error("softmax_forward_launcher failed");
+    return output;
+}
+
+std::tuple<torch::Tensor, torch::Tensor> sort_forward(torch::Tensor x, int64_t dim) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D");
+    TORCH_CHECK(dim == 1, "Only dim=1 is supported");
+
+    if (!x.is_contiguous()) {
+        x = x.contiguous();
+    }
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+
+    auto out_values = torch::empty_like(x);
+    auto out_indices = torch::empty_like(x, x.options().dtype(torch::kInt64));
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    sort_forward_launcher(
+        x.data_ptr<float>(),
+        out_values.data_ptr<float>(),
+        out_indices.data_ptr<int64_t>(),
+        static_cast<int>(N),
+        static_cast<int>(C),
+        static_cast<int>(H),
+        static_cast<int>(W),
+        stream
+    );
+
+    check_cuda_error("sort_forward_launcher failed");
+    return std::make_tuple(out_values, out_indices);
+}
+
+std::vector<torch::Tensor> split_forward(torch::Tensor x, int64_t split_size, int64_t dim) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D");
+    TORCH_CHECK(dim == 1, "Only dim=1 is supported");
+    TORCH_CHECK(split_size > 0, "split_size must be positive");
+
+    if (!x.is_contiguous()) {
+        x = x.contiguous();
+    }
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+
+    int64_t num_chunks = (C + split_size - 1) / split_size;
+    std::vector<torch::Tensor> outputs;
+    outputs.reserve(num_chunks);
+
+    // Allocate output tensors with appropriate shapes
+    for (int64_t i = 0; i < num_chunks; ++i) {
+        int64_t chunk_len = std::min(split_size, C - i * split_size);
+        outputs.push_back(torch::empty({N, chunk_len, H, W}, x.options()));
+    }
+
+    // Prepare pointer array
+    std::vector<float*> output_ptrs;
+    output_ptrs.reserve(num_chunks);
+    for (auto& t : outputs) {
+        output_ptrs.push_back(t.data_ptr<float>());
+    }
+
+    // Copy pointer array to device
+    float** d_output_ptrs;
+    cudaMalloc(&d_output_ptrs, num_chunks * sizeof(float*));
+    TORCH_CHECK(d_output_ptrs != nullptr, "cudaMalloc failed");
+    cudaMemcpy(d_output_ptrs, output_ptrs.data(), num_chunks * sizeof(float*), cudaMemcpyHostToDevice);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    split_forward_launcher(
+        x.data_ptr<float>(),
+        d_output_ptrs,
+        static_cast<int>(N),
+        static_cast<int>(C),
+        static_cast<int>(H),
+        static_cast<int>(W),
+        static_cast<int>(split_size),
+        static_cast<int>(num_chunks),
+        stream
+    );
+
+    check_cuda_error("split_forward_launcher failed");
+
+    cudaFree(d_output_ptrs);
+
+    // Return as tuple (convert vector to tuple for pybind)
+    // pybind11 will convert std::vector to tuple automatically? Actually we want tuple.
+    // We can return std::vector and pybind will convert to list, but model_new.py expects tuple unpacking.
+    // We'll return std::vector but model_new.py uses `x = cuda_extension.split_forward(...)` and then returns x, but split in Python returns tuple.
+    // Since model_new.py just returns the result, it may be okay if it's a list? No, forward expects tuple of tensors.
+    // We need to return a tuple. We can construct py::tuple manually, but easier: return std::vector<torch::Tensor> and rely on pybind's automatic conversion to tuple? Actually pybind converts std::vector to list, not tuple.
+    // To match torch.split which returns tuple, we should return py::tuple.
+    // However, we are in binding.cpp and can construct py::tuple from vector.
+    py::tuple tuple_output(num_chunks);
+    for (size_t i = 0; i < num_chunks; ++i) {
+        tuple_output[i] = outputs[i];
+    }
+    return outputs; // This will be converted to list; need to return py::tuple explicitly.
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("softmax_forward", &softmax_forward, "Softmax forward along dim=1",
+          py::arg("x"), py::arg("dim"));
+    m.def("sort_forward", &sort_forward, "Stable sort forward along dim=1",
+          py::arg("x"), py::arg("dim"));
+    m.def("split_forward", &split_forward, "Split forward along dim=1",
+          py::arg("x"), py::arg("split_size"), py::arg("dim"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
