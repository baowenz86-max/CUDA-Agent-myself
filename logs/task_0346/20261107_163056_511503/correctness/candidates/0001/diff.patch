--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,89 @@
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// Bilinear upsampling kernel (align_corners=False)
+// input: float pointer with shape [N, C, H, W], non-contiguous supported via strides
+// output: float pointer with shape [N, C, outH, outW], non-contiguous supported via strides
+// scale_factor: integer upsampling factor >= 1
+template <typename T>
+__global__ void upsample_bilinear2d_kernel(
+    const T* __restrict__ input,
+    T* __restrict__ output,
+    int N, int C, int H, int W,
+    int outH, int outW,
+    int scale_factor,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w)
+{
+    long long total = (long long)N * C * outH * outW;
+    long long idx = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+
+    float inv_scale = 1.0f / (float)scale_factor;
+
+    for (long long linear = idx; linear < total; linear += stride) {
+        int ow = linear % outW;
+        long long tmp = linear / outW;
+        int oh = tmp % outH;
+        tmp /= outH;
+        int c = tmp % C;
+        int n = tmp / C;
+
+        // source coordinate (align_corners=False)
+        float src_h_f = (oh + 0.5f) * inv_scale - 0.5f;
+        float src_w_f = (ow + 0.5f) * inv_scale - 0.5f;
+
+        // clamp to valid range [0, H-1] and [0, W-1]
+        src_h_f = fmaxf(0.0f, fminf(src_h_f, (float)(H - 1)));
+        src_w_f = fmaxf(0.0f, fminf(src_w_f, (float)(W - 1)));
+
+        int h0 = (int)src_h_f;
+        int w0 = (int)src_w_f;
+        int h1 = min(h0 + 1, H - 1);
+        int w1 = min(w0 + 1, W - 1);
+
+        float h_lambda = src_h_f - h0;
+        float w_lambda = src_w_f - w0;
+
+        const T* in_base = input + (long long)n * in_stride_n + (long long)c * in_stride_c;
+        const T* p00 = in_base + (long long)h0 * in_stride_h + (long long)w0 * in_stride_w;
+        const T* p01 = in_base + (long long)h0 * in_stride_h + (long long)w1 * in_stride_w;
+        const T* p10 = in_base + (long long)h1 * in_stride_h + (long long)w0 * in_stride_w;
+        const T* p11 = in_base + (long long)h1 * in_stride_h + (long long)w1 * in_stride_w;
+
+        float val = (1.0f - h_lambda) * ((1.0f - w_lambda) * (*p00) + w_lambda * (*p01)) +
+                    h_lambda * ((1.0f - w_lambda) * (*p10) + w_lambda * (*p11));
+
+        T* out_ptr = output + (long long)n * out_stride_n + (long long)c * out_stride_c +
+                     (long long)oh * out_stride_h + (long long)ow * out_stride_w;
+        *out_ptr = (T)val;
+    }
+}
+
+extern "C" void upsample_bilinear2d_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    int outH, int outW,
+    int scale_factor,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,
+    cudaStream_t stream)
+{
+    long long total = (long long)N * C * outH * outW;
+    if (total == 0) return;
+
+    const int threads = 256;
+    int blocks = (int)((total + threads - 1) / threads);
+    // Cap blocks to avoid excessive grid dimensions; grid-stride loop handles the rest.
+    const int max_blocks = 65535;
+    if (blocks > max_blocks) blocks = max_blocks;
+
+    upsample_bilinear2d_kernel<float><<<blocks, threads, 0, stream>>>(
+        input, output,
+        N, C, H, W,
+        outH, outW,
+        scale_factor,
+        in_stride_n, in_stride_c, in_stride_h, in_stride_w,
+        out_stride_n, out_stride_c, out_stride_h, out_stride_w);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,80 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launcher from custom_ops.cu
+extern "C" void upsample_bilinear2d_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    int outH, int outW,
+    int scale_factor,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,
+    cudaStream_t stream);
+
+// PyTorch wrapper for bilinear upsampling
+torch::Tensor upsample_bilinear2d(torch::Tensor input, int64_t scale_factor) {
+    // Validation
+    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(input.dim() == 4, "Input must be 4D (N, C, H, W)");
+    TORCH_CHECK(scale_factor >= 1, "scale_factor must be >= 1");
+
+    int N = input.size(0);
+    int C = input.size(1);
+    int H = input.size(2);
+    int W = input.size(3);
+    int sf = static_cast<int>(scale_factor);
+    int outH = H * sf;
+    int outW = W * sf;
+
+    // Allocate output (contiguous)
+    auto output = torch::empty({N, C, outH, outW}, input.options());
+
+    // Ensure input is contiguous (or get strides in elements)
+    auto input_contig = input.contiguous();
+    auto output_contig = output.contiguous();
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Get strides in elements (for contiguous tensors, but also handle non-contiguous correctly)
+    // Use data_ptr directly with original strides if possible; since we call contiguous(),
+    // we can rely on contiguous strides, but pass actual strides anyway.
+    long long in_stride_n = input_contig.stride(0);
+    long long in_stride_c = input_contig.stride(1);
+    long long in_stride_h = input_contig.stride(2);
+    long long in_stride_w = input_contig.stride(3);
+
+    long long out_stride_n = output_contig.stride(0);
+    long long out_stride_c = output_contig.stride(1);
+    long long out_stride_h = output_contig.stride(2);
+    long long out_stride_w = output_contig.stride(3);
+
+    // Call launcher
+    upsample_bilinear2d_launcher(
+        input_contig.data_ptr<float>(),
+        output_contig.data_ptr<float>(),
+        N, C, H, W,
+        outH, outW,
+        sf,
+        in_stride_n, in_stride_c, in_stride_h, in_stride_w,
+        out_stride_n, out_stride_c, out_stride_h, out_stride_w,
+        stream);
+
+    return output;
+}
+
+// Registration
+void register_upsample_bilinear2d(pybind11::module& m) {
+    m.def("upsample_bilinear2d", &upsample_bilinear2d,
+          "Bilinear upsampling (align_corners=False)",
+          pybind11::arg("input"),
+          pybind11::arg("scale_factor"));
+}
+
+REGISTER_BINDING(upsample_bilinear2d, register_upsample_bilinear2d);
