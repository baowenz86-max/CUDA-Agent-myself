@@ -0,0 +1,97 @@
+#include <cuda_runtime.h>
+#include <stdint.h>
+
+// Bilinear upsampling kernel for 4D tensor (N, C, H, W)
+// Supports arbitrary strides; each thread processes one output element.
+__global__ void bilinear_upsample_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int64_t N, int64_t C, int64_t H_in, int64_t W_in,
+    int64_t H_out, int64_t W_out,
+    int64_t stride_n_in, int64_t stride_c_in, int64_t stride_h_in, int64_t stride_w_in,
+    int64_t stride_n_out, int64_t stride_c_out, int64_t stride_h_out, int64_t stride_w_out,
+    float scale_factor) {
+    int64_t total = N * C * H_out * W_out;
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t grid_size = blockDim.x * gridDim.x;
+    for (; idx < total; idx += grid_size) {
+        int64_t w_out = idx % W_out;
+        int64_t tmp = idx / W_out;
+        int64_t h_out = tmp % H_out;
+        tmp /= H_out;
+        int64_t c = tmp % C;
+        int64_t n = tmp / C;
+
+        float h1 = (h_out + 0.5f) / scale_factor - 0.5f;
+        float w1 = (w_out + 0.5f) / scale_factor - 0.5f;
+        if (h1 < 0) h1 = 0;
+        if (w1 < 0) w1 = 0;
+        int64_t h0 = (int64_t)h1;
+        int64_t w0 = (int64_t)w1;
+        int64_t h1_int = h0 + 1;
+        int64_t w1_int = w0 + 1;
+        if (h0 >= H_in - 1) { h0 = H_in - 1; h1_int = H_in - 1; }
+        if (w0 >= W_in - 1) { w0 = W_in - 1; w1_int = W_in - 1; }
+        float h_lambda = h1 - h0;
+        float w_lambda = w1 - w0;
+
+        const float* base_in = input + n * stride_n_in + c * stride_c_in;
+        int64_t i00 = h0 * stride_h_in + w0 * stride_w_in;
+        int64_t i01 = h0 * stride_h_in + w1_int * stride_w_in;
+        int64_t i10 = h1_int * stride_h_in + w0 * stride_w_in;
+        int64_t i11 = h1_int * stride_h_in + w1_int * stride_w_in;
+
+        float top = base_in[i00] * (1.0f - w_lambda) + base_in[i01] * w_lambda;
+        float bottom = base_in[i10] * (1.0f - w_lambda) + base_in[i11] * w_lambda;
+        float val = top * (1.0f - h_lambda) + bottom * h_lambda;
+
+        int64_t out_idx = n * stride_n_out + c * stride_c_out + h_out * stride_h_out + w_out * stride_w_out;
+        output[out_idx] = val;
+    }
+}
+
+// Elementwise ReLU kernel for arbitrary 1D flattened indexing (strides handled by offset calculation in launcher?)
+// Actually, we compute the linear index and access output[index] and input[index] assuming contiguous flattened memory.
+// The launcher will ensure the input and output are contiguous for simplicity, or we can pass strides for 4D.
+// Since relu_where is applied on the output of interpolate which is contiguous, we assume contiguous.
+__global__ void relu_kernel(const float* __restrict__ input, float* __restrict__ output, int64_t total) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t grid_size = blockDim.x * gridDim.x;
+    for (; idx < total; idx += grid_size) {
+        float val = input[idx];
+        output[idx] = (val > 0.0f) ? val : 0.0f;
+    }
+}
+
+// Host launcher for bilinear upsampling (no PyTorch dependencies)
+extern "C" void interpolate_bilinear_scale_launcher(
+    const float* input,
+    float* output,
+    int64_t N, int64_t C, int64_t H_in, int64_t W_in,
+    int64_t H_out, int64_t W_out,
+    int64_t stride_n_in, int64_t stride_c_in, int64_t stride_h_in, int64_t stride_w_in,
+    int64_t stride_n_out, int64_t stride_c_out, int64_t stride_h_out, int64_t stride_w_out,
+    float scale_factor,
+    cudaStream_t stream) {
+    int64_t total = N * C * H_out * W_out;
+    int block_size = 256;
+    int64_t blocks = (total + block_size - 1) / block_size;
+    if (blocks > 65535) blocks = 65535; // grid cap, grid-stride loop handles rest
+    bilinear_upsample_kernel<<<(int)blocks, block_size, 0, stream>>>(
+        input, output, N, C, H_in, W_in, H_out, W_out,
+        stride_n_in, stride_c_in, stride_h_in, stride_w_in,
+        stride_n_out, stride_c_out, stride_h_out, stride_w_out,
+        scale_factor);
+}
+
+// Host launcher for ReLU (assumes contiguous input and output)
+extern "C" void relu_where_launcher(
+    const float* input,
+    float* output,
+    int64_t total,
+    cudaStream_t stream) {
+    int block_size = 256;
+    int64_t blocks = (total + block_size - 1) / block_size;
+    if (blocks > 65535) blocks = 65535;
+    relu_kernel<<<(int)blocks, block_size, 0, stream>>>(input, output, total);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,100 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declarations from custom_ops.cu
+extern "C" void interpolate_bilinear_scale_launcher(
+    const float* input,
+    float* output,
+    int64_t N, int64_t C, int64_t H_in, int64_t W_in,
+    int64_t H_out, int64_t W_out,
+    int64_t stride_n_in, int64_t stride_c_in, int64_t stride_h_in, int64_t stride_w_in,
+    int64_t stride_n_out, int64_t stride_c_out, int64_t stride_h_out, int64_t stride_w_out,
+    float scale_factor,
+    cudaStream_t stream);
+
+extern "C" void relu_where_launcher(
+    const float* input,
+    float* output,
+    int64_t total,
+    cudaStream_t stream);
+
+torch::Tensor interpolate_bilinear_scale(torch::Tensor x, double scale_factor) {
+    TORCH_CHECK(x.is_cuda(), "interpolate_bilinear_scale: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "interpolate_bilinear_scale: input must be float32");
+    TORCH_CHECK(x.dim() == 4, "interpolate_bilinear_scale: input must be 4D (N,C,H,W)");
+    TORCH_CHECK(scale_factor > 0, "interpolate_bilinear_scale: scale_factor must be positive");
+
+    // Ensure input is contiguous for simpler launcher (kernel handles strides but we can avoid complexity)
+    // Actually kernel supports arbitrary strides, so we can pass original strides. But ensure x is contiguous
+    // if possible, or use .contiguous() only if needed.
+    if (!x.is_contiguous()) {
+        x = x.contiguous();
+    }
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H_in = x.size(2);
+    int64_t W_in = x.size(3);
+    int64_t H_out = static_cast<int64_t>(std::floor(H_in * scale_factor));
+    int64_t W_out = static_cast<int64_t>(std::floor(W_in * scale_factor));
+
+    auto output = torch::empty({N, C, H_out, W_out}, x.options());
+
+    // Get strides after possible contiguous conversion
+    int64_t stride_n_in = x.stride(0);
+    int64_t stride_c_in = x.stride(1);
+    int64_t stride_h_in = x.stride(2);
+    int64_t stride_w_in = x.stride(3);
+    int64_t stride_n_out = output.stride(0);
+    int64_t stride_c_out = output.stride(1);
+    int64_t stride_h_out = output.stride(2);
+    int64_t stride_w_out = output.stride(3);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    interpolate_bilinear_scale_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C, H_in, W_in,
+        H_out, W_out,
+        stride_n_in, stride_c_in, stride_h_in, stride_w_in,
+        stride_n_out, stride_c_out, stride_h_out, stride_w_out,
+        static_cast<float>(scale_factor),
+        stream
+    );
+    TORCH_CHECK(cudaGetLastError() == cudaSuccess, "interpolate_bilinear_scale: kernel launch failed");
+    return output;
+}
+
+torch::Tensor relu_where(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "relu_where: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "relu_where: input must be float32");
+    // relu_where_launcher assumes contiguous flat memory; make contiguous if not
+    if (!x.is_contiguous()) {
+        x = x.contiguous();
+    }
+    auto output = torch::empty_like(x);
+    int64_t total = x.numel();
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    relu_where_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        total,
+        stream
+    );
+    TORCH_CHECK(cudaGetLastError() == cudaSuccess, "relu_where: kernel launch failed");
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("interpolate_bilinear_scale", &interpolate_bilinear_scale,
+          "Bilinear upsampling with scale_factor (align_corners=False)",
+          pybind11::arg("x"), pybind11::arg("scale_factor") = 1.0);
+    m.def("relu_where", &relu_where,
+          "Elementwise ReLU (max(x,0))",
+          pybind11::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,25 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, scale_factor=1.0, mode='bilinear'):
+        super(ModelNew, self).__init__()
+        self.scale_factor = scale_factor
+        self.mode = mode
+
+    def forward(self, x):
+        x = cuda_extension.interpolate_bilinear_scale(x, self.scale_factor)
+        x = cuda_extension.relu_where(x)
+        x = cuda_extension.interpolate_bilinear_scale(x, self.scale_factor)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.interpolate_bilinear_scale(x, self.scale_factor)
+        yield 'step_001', x
+        x = cuda_extension.relu_where(x)
+        yield 'step_002', x
+        x = cuda_extension.interpolate_bilinear_scale(x, self.scale_factor)
+        yield 'step_003', x
+        yield 'step_004', x
