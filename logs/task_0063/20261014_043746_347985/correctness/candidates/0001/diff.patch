--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,123 @@
+#include <cuda_runtime.h>
+#include <cmath>
+#include <cstdint>
+
+// Adaptive average pooling 1D kernel
+// Each output element is the mean of pooled input elements in the adaptive window.
+// The input tensor is assumed to be contiguous with shape [N, C, L_in].
+// Output has shape [N, C, L_out].
+// Grid: one block per (n, c) pair, threads across L_out.
+__global__ void adaptive_avgpool1d_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int L_in,
+    int L_out)
+{
+    int n = blockIdx.x;
+    int c = blockIdx.y;
+    int tid = threadIdx.x;
+    int stride = blockDim.x;
+
+    // Base index for this (n,c) slice
+    const float* in_slice = input + (size_t)n * gridDim.y * L_in; // gridDim.y == C
+    float* out_slice = output + (size_t)n * gridDim.y * L_out;
+
+    for (int i = tid; i < L_out; i += stride) {
+        int start = (int)floorf((float)i * L_in / L_out);
+        int end = (int)ceilf((float)(i + 1) * L_in / L_out);
+        if (end > L_in) end = L_in;
+        float sum = 0.0f;
+        for (int j = start; j < end; ++j) {
+            sum += in_slice[c * L_in + j];
+        }
+        out_slice[c * L_out + i] = sum / (end - start);
+    }
+}
+
+// Launcher for adaptive_avgpool1d_forward
+// Input: x is a contiguous float32 CUDA tensor of shape [N, C, L_in]
+// output_size: desired L_out
+// Returns: newly allocated float32 tensor of shape [N, C, L_out] via external allocation.
+// The caller (binding layer) is responsible for allocating output and passing pointers.
+extern "C" void adaptive_avgpool1d_launcher(
+    const float* input,
+    float* output,
+    int N,
+    int C,
+    int L_in,
+    int L_out,
+    cudaStream_t stream)
+{
+    // Thread configuration: one block per (n,c) pair, with enough threads for striding over L_out.
+    dim3 grid(N, C);
+    int threads = 256;
+    if (L_out < threads) threads = L_out; // ensure at least one thread, but if L_out=0 no launch needed
+    if (N <= 0 || C <= 0 || L_in <= 0 || L_out <= 0) return;
+    adaptive_avgpool1d_kernel<<<grid, threads, 0, stream>>>(input, output, L_in, L_out);
+}
+
+// Unfold (im2col) kernel
+// Input: x shape [N, C, L], contiguous float32
+// Parameters: kernel_size, stride, padding (all int)
+// Output shape: [N, C * kernel_size, L_out]
+// L_out = floor((L + 2*padding - kernel_size) / stride) + 1
+// Output layout: for each n, output rows are c * kernel_size + k,
+// and columns are output positions.
+// Each thread computes one output element.
+__global__ void unfold_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int N,
+    int C,
+    int L,
+    int kernel_size,
+    int stride,
+    int padding,
+    int L_out)
+{
+    // Total output elements: N * C * kernel_size * L_out
+    int total = N * C * kernel_size * L_out;
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= total) return;
+
+    // Decompose idx into (n, ck, l_out)
+    int l_out = idx % L_out;
+    int tmp = idx / L_out;
+    int ck = tmp % (C * kernel_size);
+    int n = tmp / (C * kernel_size);
+
+    // Decompose ck into c and k
+    int c = ck / kernel_size;
+    int k = ck % kernel_size;
+
+    // Input index: n*C*L + c*L + (l_out*stride - padding + k)
+    int in_idx = l_out * stride - padding + k;
+    if (in_idx >= 0 && in_idx < L) {
+        output[idx] = input[(size_t)n * C * L + c * L + in_idx];
+    } else {
+        output[idx] = 0.0f;
+    }
+}
+
+// Launcher for unfold_forward
+// Input: x contiguous float32 [N, C, L]
+// kernel_size, stride, padding
+// Output: float32 [N, C*kernel_size, L_out]
+extern "C" void unfold_launcher(
+    const float* input,
+    float* output,
+    int N,
+    int C,
+    int L,
+    int kernel_size,
+    int stride,
+    int padding,
+    int L_out,
+    cudaStream_t stream)
+{
+    if (N <= 0 || C <= 0 || L <= 0 || kernel_size <= 0 || stride <= 0 || L_out <= 0) return;
+    int total = N * C * kernel_size * L_out;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    unfold_kernel<<<blocks, threads, 0, stream>>>(input, output, N, C, L, kernel_size, stride, padding, L_out);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,114 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void adaptive_avgpool1d_launcher(
+    const float* input,
+    float* output,
+    int N,
+    int C,
+    int L_in,
+    int L_out,
+    cudaStream_t stream);
+
+extern "C" void unfold_launcher(
+    const float* input,
+    float* output,
+    int N,
+    int C,
+    int L,
+    int kernel_size,
+    int stride,
+    int padding,
+    int L_out,
+    cudaStream_t stream);
+
+// Wrapper for adaptive_avgpool1d_forward
+torch::Tensor adaptive_avgpool1d_forward(torch::Tensor x, int64_t output_size) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 3, "Input must have shape [N, C, L]");
+    TORCH_CHECK(output_size > 0, "output_size must be positive");
+
+    // Ensure contiguous (input from avgpool is contiguous, but be safe)
+    if (!x.is_contiguous()) {
+        x = x.contiguous();
+    }
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int L_in = x.size(2);
+    int L_out = static_cast<int>(output_size);
+
+    auto output = torch::empty({N, C, L_out}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    adaptive_avgpool1d_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N,
+        C,
+        L_in,
+        L_out,
+        stream
+    );
+
+    return output;
+}
+
+// Wrapper for unfold_forward
+torch::Tensor unfold_forward(torch::Tensor x, int64_t kernel_size, int64_t stride, int64_t padding) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 3, "Input must have shape [N, C, L]");
+    TORCH_CHECK(kernel_size > 0, "kernel_size must be positive");
+    TORCH_CHECK(stride > 0, "stride must be positive");
+    TORCH_CHECK(padding >= 0, "padding must be non-negative");
+
+    // Ensure contiguous
+    if (!x.is_contiguous()) {
+        x = x.contiguous();
+    }
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int L = x.size(2);
+    int k = static_cast<int>(kernel_size);
+    int s = static_cast<int>(stride);
+    int p = static_cast<int>(padding);
+    int L_out = (L + 2 * p - k) / s + 1;
+    TORCH_CHECK(L_out > 0, "Invalid unfold parameters: L_out must be positive");
+
+    auto output = torch::empty({N, C * k, L_out}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    unfold_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N,
+        C,
+        L,
+        k,
+        s,
+        p,
+        L_out,
+        stream
+    );
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("adaptive_avgpool1d_forward", &adaptive_avgpool1d_forward,
+          "Adaptive average pooling 1D forward",
+          pybind11::arg("x"), pybind11::arg("output_size"));
+    m.def("unfold_forward", &unfold_forward,
+          "Unfold (im2col) forward",
+          pybind11::arg("x"), pybind11::arg("kernel_size"),
+          pybind11::arg("stride"), pybind11::arg("padding"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,26 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, output_size, in_channels, kernel_size, stride, padding):
+        super().__init__()
+        self.avgpool = nn.AdaptiveAvgPool1d(output_size=output_size)
+        self.unfold = nn.Unfold(kernel_size=kernel_size, stride=stride, padding=padding)
+
+    def forward(self, x):
+        x = cuda_extension.adaptive_avgpool1d_forward(x, self.avgpool.output_size[0])
+        x = cuda_extension.unfold_forward(x, kernel_size=self.unfold.kernel_size[0],
+                                          stride=self.unfold.stride[0],
+                                          padding=self.unfold.padding[0])
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.adaptive_avgpool1d_forward(x, self.avgpool.output_size[0])
+        yield ('step_001', x)
+        x = cuda_extension.unfold_forward(x, kernel_size=self.unfold.kernel_size[0],
+                                          stride=self.unfold.stride[0],
+                                          padding=self.unfold.padding[0])
+        yield ('step_002', x)
+        yield ('step_003', x)
