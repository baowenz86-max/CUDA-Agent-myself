{
  "operators": [
    {
      "name": "conv_transpose_op",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, in_channels, L_in]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[in_channels, out_channels, kernel_size]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "stride",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "padding",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "output_padding",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[B, out_channels, L_out]"
      },
      "semantics": [
        "实现 PyTorch ConvTranspose1d 前向，包含卷积权重和可选 conv bias",
        "L_out = (L_in - 1) * stride - 2 * padding + kernel_size + output_padding",
        "输入、权重、bias 均在 CUDA 上，launcher 使用 cuDNN 或等价实现",
        "bias 可以为 None，此时不添加卷积 bias"
      ]
    },
    {
      "name": "add_bias_op",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, C, L]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C, 1]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对应参考语句 x = x + self.bias",
        "bias 形状 [C,1]，按 channel 广播到 [B,C,L]",
        "输出新张量，不修改输入"
      ]
    },
    {
      "name": "softmax_channel_op",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, C, L]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对应参考语句 torch.softmax(x, dim=1)",
        "在 channel 维度上计算 softmax，数值稳定实现（减去每列最大值）"
      ]
    },
    {
      "name": "scale_op",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, C, L]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "scaling_factor",
          "kind": "float",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对应参考语句 x = x * self.scaling_factor",
        "对输入每个元素乘以标量 scaling_factor"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.conv_transpose(x)",
      "semantics": [
        "调用 ConvTranspose1d 前向，得到形状 [512,16,16384] 的输出"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = x + self.bias",
      "semantics": [
        "将形状 [16,1] 的偏置广播加到 conv 输出上"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = torch.softmax(x, dim=1)",
      "semantics": [
        "在通道维度 dim=1 上对每个空间位置独立计算 softmax"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "x = x * self.scaling_factor",
      "semantics": [
        "将 softmax 输出逐元素乘以标量 2.0"
      ]
    },
    {
      "checkpoint": "step_005",
      "source": "return x",
      "semantics": [
        "返回最终缩放后的张量，形状 [512,16,16384]"
      ]
    }
  ]
}