--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,210 @@
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// -----------------------------------------------------------------------------
+// PReLU forward kernel
+// input: (N, C, H, W) float32
+// weight: (C,) float32
+// output: (N, C, H, W) float32
+// -----------------------------------------------------------------------------
+__global__ void prelu_kernel(
+    const float* __restrict__ input,
+    const float* __restrict__ weight,
+    float* __restrict__ output,
+    int64_t total_elements,
+    int64_t channel_stride,   // elements between consecutive channels (H*W for contiguous)
+    int64_t channels) {
+
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)blockDim.x * gridDim.x;
+
+    for (int64_t i = idx; i < total_elements; i += stride) {
+        int64_t c = (i / channel_stride) % channels;
+        float w = weight[c];
+        float val = input[i];
+        output[i] = (val > 0.0f) ? val : (w * val);
+    }
+}
+
+// -----------------------------------------------------------------------------
+// Bilinear interpolation forward kernel (align_corners=false)
+// input: (N, C, H_in, W_in) float32, contiguous
+// output: (N, C, H_out, W_out) float32
+// scale_factor: float, output spatial dims are computed as floor(scale * input)
+// -----------------------------------------------------------------------------
+__global__ void bilinear_interpolate_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int64_t N,
+    int64_t C,
+    int64_t H_in,
+    int64_t W_in,
+    int64_t H_out,
+    int64_t W_out,
+    float scale_h,
+    float scale_w) {
+
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t total_output_elements = N * C * H_out * W_out;
+    int64_t stride = (int64_t)blockDim.x * gridDim.x;
+
+    for (int64_t i = idx; i < total_output_elements; i += stride) {
+        // Decode linear index to (n, c, h_out, w_out)
+        int64_t tmp = i;
+        int64_t w_out = tmp % W_out;
+        tmp /= W_out;
+        int64_t h_out = tmp % H_out;
+        tmp /= H_out;
+        int64_t c = tmp % C;
+        int64_t n = tmp / C;
+
+        // Input coordinates (align_corners=false)
+        float h_src = (h_out + 0.5f) / scale_h - 0.5f;
+        float w_src = (w_out + 0.5f) / scale_w - 0.5f;
+
+        // Boundary handling: if h_src or w_src is -0.5, it corresponds to -0.5
+        // but interpolation uses floor and ceil with clamping.
+        int64_t h0 = (int64_t)floorf(h_src);
+        int64_t w0 = (int64_t)floorf(w_src);
+        int64_t h1 = h0 + 1;
+        int64_t w1 = w0 + 1;
+
+        float h_lambda = h_src - floorf(h_src);
+        float w_lambda = w_src - floorf(w_src);
+
+        // Clamp indices to [0, H_in-1] / [0, W_in-1]
+        h0 = max(h0, (int64_t)0);
+        h0 = min(h0, H_in - 1);
+        h1 = max(h1, (int64_t)0);
+        h1 = min(h1, H_in - 1);
+        w0 = max(w0, (int64_t)0);
+        w0 = min(w0, W_in - 1);
+        w1 = max(w1, (int64_t)0);
+        w1 = min(w1, W_in - 1);
+
+        // Base offset for this (n, c) in input
+        int64_t base = (n * C + c) * H_in * W_in;
+
+        // Load four corner values
+        float v00 = input[base + h0 * W_in + w0];
+        float v01 = input[base + h0 * W_in + w1];
+        float v10 = input[base + h1 * W_in + w0];
+        float v11 = input[base + h1 * W_in + w1];
+
+        // Bilinear interpolation
+        float top = v00 * (1.0f - w_lambda) + v01 * w_lambda;
+        float bottom = v10 * (1.0f - w_lambda) + v11 * w_lambda;
+        float result = top * (1.0f - h_lambda) + bottom * h_lambda;
+
+        output[i] = result;
+    }
+}
+
+// -----------------------------------------------------------------------------
+// Argmax over dimension 1 (channels) kernel
+// input: (N, C, H, W) float32, contiguous
+// output: (N, 1, H, W) int64, contiguous
+// dim = 1, keepdim = true
+// -----------------------------------------------------------------------------
+__global__ void argmax_dim_kernel(
+    const float* __restrict__ input,
+    int64_t* __restrict__ output,
+    int64_t N,
+    int64_t C,
+    int64_t spatial_size) {  // H*W
+
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t total_positions = N * spatial_size;
+    int64_t stride = (int64_t)blockDim.x * gridDim.x;
+
+    for (int64_t i = idx; i < total_positions; i += stride) {
+        int64_t n = i / spatial_size;
+        int64_t s = i % spatial_size;
+
+        const float* base_ptr = input + n * C * spatial_size + s;
+        float max_val = base_ptr[0];
+        int64_t max_index = 0;
+
+        for (int64_t c = 1; c < C; ++c) {
+            float val = base_ptr[c * spatial_size];
+            if (val > max_val) {
+                max_val = val;
+                max_index = c;
+            }
+        }
+
+        // Output index: since keepdim=true, output has shape (N, 1, H, W),
+        // but the spatial position mapping is the same.
+        output[i] = max_index;
+    }
+}
+
+// -----------------------------------------------------------------------------
+// Host launcher functions (extern "C")
+// -----------------------------------------------------------------------------
+
+// prelu_forward(input_ptr, weight_ptr, output_ptr, total_elements, channel_stride, channels, stream)
+extern "C" void prelu_forward_launcher(
+    const float* input,
+    const float* weight,
+    float* output,
+    int64_t total_elements,
+    int64_t channel_stride,
+    int64_t channels,
+    cudaStream_t stream) {
+
+    if (total_elements == 0) return;
+
+    int threads = 256;
+    int64_t blocks_64 = (total_elements + threads - 1) / threads;
+    // Cap blocks at 65535, use grid-stride loop to cover remainder
+    int blocks = (int)min(blocks_64, (int64_t)65535);
+
+    prelu_kernel<<<blocks, threads, 0, stream>>>(
+        input, weight, output, total_elements, channel_stride, channels);
+}
+
+// bilinear_interpolate_forward(input_ptr, output_ptr, N, C, H_in, W_in, H_out, W_out, scale_h, scale_w, stream)
+extern "C" void bilinear_interpolate_forward_launcher(
+    const float* input,
+    float* output,
+    int64_t N,
+    int64_t C,
+    int64_t H_in,
+    int64_t W_in,
+    int64_t H_out,
+    int64_t W_out,
+    float scale_h,
+    float scale_w,
+    cudaStream_t stream) {
+
+    int64_t total_output_elements = N * C * H_out * W_out;
+    if (total_output_elements == 0) return;
+
+    int threads = 256;
+    int64_t blocks_64 = (total_output_elements + threads - 1) / threads;
+    int blocks = (int)min(blocks_64, (int64_t)65535);
+
+    bilinear_interpolate_kernel<<<blocks, threads, 0, stream>>>(
+        input, output, N, C, H_in, W_in, H_out, W_out, scale_h, scale_w);
+}
+
+// argmax_dim_forward(input_ptr, output_ptr, N, C, spatial_size, stream)
+extern "C" void argmax_dim_forward_launcher(
+    const float* input,
+    int64_t* output,
+    int64_t N,
+    int64_t C,
+    int64_t spatial_size,
+    cudaStream_t stream) {
+
+    int64_t total_positions = N * spatial_size;
+    if (total_positions == 0) return;
+
+    int threads = 256;
+    int64_t blocks_64 = (total_positions + threads - 1) / threads;
+    int blocks = (int)min(blocks_64, (int64_t)65535);
+
+    argmax_dim_kernel<<<blocks, threads, 0, stream>>>(
+        input, output, N, C, spatial_size);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,160 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void prelu_forward_launcher(
+    const float* input,
+    const float* weight,
+    float* output,
+    int64_t total_elements,
+    int64_t channel_stride,
+    int64_t channels,
+    cudaStream_t stream);
+
+extern "C" void bilinear_interpolate_forward_launcher(
+    const float* input,
+    float* output,
+    int64_t N,
+    int64_t C,
+    int64_t H_in,
+    int64_t W_in,
+    int64_t H_out,
+    int64_t W_out,
+    float scale_h,
+    float scale_w,
+    cudaStream_t stream);
+
+extern "C" void argmax_dim_forward_launcher(
+    const float* input,
+    int64_t* output,
+    int64_t N,
+    int64_t C,
+    int64_t spatial_size,
+    cudaStream_t stream);
+
+// -----------------------------------------------------------------------------
+// PReLU forward binding
+// -----------------------------------------------------------------------------
+torch::Tensor prelu_forward(torch::Tensor input, torch::Tensor weight) {
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(weight.is_cuda(), "weight must be a CUDA tensor");
+    TORCH_CHECK(input.is_contiguous(), "input must be contiguous");
+    TORCH_CHECK(weight.is_contiguous(), "weight must be contiguous");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(weight.dtype() == torch::kFloat32, "weight must be float32");
+    TORCH_CHECK(input.dim() == 4, "input must be 4D (N, C, H, W)");
+    TORCH_CHECK(weight.dim() == 1, "weight must be 1D (C,)");
+
+    int64_t N = input.size(0);
+    int64_t C = input.size(1);
+    int64_t H = input.size(2);
+    int64_t W = input.size(3);
+    TORCH_CHECK(weight.size(0) == C, "weight size must match input channel dimension");
+
+    auto output = torch::empty_like(input);
+    int64_t total_elements = input.numel();
+    int64_t channel_stride = H * W;
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    prelu_forward_launcher(
+        input.data_ptr<float>(),
+        weight.data_ptr<float>(),
+        output.data_ptr<float>(),
+        total_elements,
+        channel_stride,
+        C,
+        stream);
+
+    return output;
+}
+
+// -----------------------------------------------------------------------------
+// Bilinear interpolate forward binding (align_corners=false)
+// -----------------------------------------------------------------------------
+torch::Tensor bilinear_interpolate_forward(torch::Tensor input, double scale_factor) {
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(input.is_contiguous(), "input must be contiguous");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(input.dim() == 4, "input must be 4D (N, C, H, W)");
+    TORCH_CHECK(scale_factor > 0, "scale_factor must be positive");
+
+    int64_t N = input.size(0);
+    int64_t C = input.size(1);
+    int64_t H_in = input.size(2);
+    int64_t W_in = input.size(3);
+
+    // PyTorch bilinear with align_corners=False uses output size = floor(input_size * scale_factor)
+    int64_t H_out = static_cast<int64_t>(std::floor(H_in * scale_factor));
+    int64_t W_out = static_cast<int64_t>(std::floor(W_in * scale_factor));
+
+    auto output = torch::empty({N, C, H_out, W_out}, input.options());
+
+    float scale_h = static_cast<float>(scale_factor);
+    float scale_w = static_cast<float>(scale_factor);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    bilinear_interpolate_forward_launcher(
+        input.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N,
+        C,
+        H_in,
+        W_in,
+        H_out,
+        W_out,
+        scale_h,
+        scale_w,
+        stream);
+
+    return output;
+}
+
+// -----------------------------------------------------------------------------
+// Argmax over dimension 1 (keepdim=True) binding
+// -----------------------------------------------------------------------------
+torch::Tensor argmax_dim_forward(torch::Tensor input, int64_t dim, bool keepdim) {
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(input.is_contiguous(), "input must be contiguous");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(input.dim() == 4, "input must be 4D (N, C, H, W)");
+    TORCH_CHECK(dim == 1, "only dim=1 is supported");
+    TORCH_CHECK(keepdim == true, "only keepdim=true is supported");
+
+    int64_t N = input.size(0);
+    int64_t C = input.size(1);
+    int64_t H = input.size(2);
+    int64_t W = input.size(3);
+    int64_t spatial_size = H * W;
+
+    auto output = torch::empty({N, 1, H, W}, input.options().dtype(torch::kInt64));
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    argmax_dim_forward_launcher(
+        input.data_ptr<float>(),
+        output.data_ptr<int64_t>(),
+        N,
+        C,
+        spatial_size,
+        stream);
+
+    return output;
+}
+
+// -----------------------------------------------------------------------------
+// Registration
+// -----------------------------------------------------------------------------
+void register_custom_ops(pybind11::module& m) {
+    m.def("prelu_forward", &prelu_forward, "PReLU forward",
+          py::arg("input"), py::arg("weight"));
+    m.def("bilinear_interpolate_forward", &bilinear_interpolate_forward,
+          "Bilinear interpolation forward",
+          py::arg("input"), py::arg("scale_factor"));
+    m.def("argmax_dim_forward", &argmax_dim_forward,
+          "Argmax over dimension 1 with keepdim",
+          py::arg("input"), py::arg("dim"), py::arg("keepdim"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,31 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, out_channels, kernel_size, alpha_value, scale_factor, mode):
+        super().__init__()
+        # 保持与参考模型相同的参数结构与 state_dict 键
+        self.prelu_weight = nn.Parameter(torch.full((in_channels,), float(alpha_value), dtype=torch.float32))
+        self.scale_factor = float(scale_factor)
+        self.mode = mode
+
+    def forward(self, x):
+        # 调用自定义 CUDA 扩展中的算子，保持计算顺序与参考一致
+        x = cuda_extension.prelu_forward(x, self.prelu_weight)
+        if self.mode != 'bilinear':
+            raise NotImplementedError(f'Unsupported interpolation mode: {self.mode}')
+        x = cuda_extension.bilinear_interpolate_forward(x, self.scale_factor)
+        x = cuda_extension.argmax_dim_forward(x, 1, True)
+        return x
+
+    def debug_forward(self, x):
+        # 按 checkpoints 顺序产出中间结果，调试接口不改变计算公式
+        prelu_out = cuda_extension.prelu_forward(x, self.prelu_weight)
+        yield 'step_001', prelu_out
+        interp_out = cuda_extension.bilinear_interpolate_forward(prelu_out, self.scale_factor)
+        yield 'step_002', interp_out
+        argmax_out = cuda_extension.argmax_dim_forward(interp_out, 1, True)
+        yield 'step_003', argmax_out
+        yield 'step_004', argmax_out
