  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.unfold(x)",
      "semantics": [
        "输入 x shape [16,3,512,512]，kernel_size=(3,3), dilation=(1,1), padding=(1,1)，stride=1。",
        "输出 shape [16,27,262144]，dtype float32，device cuda:0。",
        "nn.Unfold 按照通道优先、kernel 位置优先的顺序展开，L = 512*512 = 262144。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "max_val = torch.amax(x, dim=(1, 2))",
      "semantics": [
        "在 unfold 输出 [16,27,262144] 的 dim=(1,2) 上取最大值。",
        "每个 batch 得到 1 个 float32 标量，共 [16]。"
      ]
    },
    {
