      "source": "non_zero_count = torch.count_nonzero(x, dim=(1, 2))",
      "semantics": [
        "在 unfold 输出上对 dim=(1,2) 统计非零元素个数。",
        "每个 batch 得到 1 个 int64 标量，共 [16]。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return (max_val, non_zero_count)",
      "semantics": [
