--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,59 @@
+#include <cuda_runtime.h>
+
+// CUDA kernel to sum over dimension 1 (channels) of a 4D tensor.
+// Each thread computes one output element: out[b, h, w] = sum_c x[b, c, h, w].
+// Grid-stride loop over all output elements.
+__global__ void sum_dim_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ out,
+    int64_t batch,
+    int64_t channels,
+    int64_t height,
+    int64_t width)
+{
+    int64_t total = batch * height * width;
+    for (int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+         idx < total;
+         idx += gridDim.x * blockDim.x)
+    {
+        int64_t w = idx % width;
+        int64_t tmp = idx / width;
+        int64_t h = tmp % height;
+        int64_t b = tmp / height;
+
+        const float* base = x + b * channels * height * width + h * width + w;
+        float sum = 0.0f;
+        for (int64_t c = 0; c < channels; ++c)
+        {
+            sum += base[c * height * width];
+        }
+        out[idx] = sum;
+    }
+}
+
+// Launcher function, to be called from binding C++ code.
+// Input x is a CUDA device pointer. The input may be non-contiguous but the
+// indexing assumes the standard contiguous layout for a 4D tensor.
+// Since the contract specifies supports strides, the binding must ensure
+// that the tensor is contiguous or pass the actual strides if non-contiguous.
+// For simplicity and because the current task input is contiguous (as per
+// task_contract.json), we assume contiguous input.
+extern "C" void sum_dim_forward_launcher(
+    const float* x,
+    float* out,
+    int64_t batch,
+    int64_t channels,
+    int64_t height,
+    int64_t width,
+    cudaStream_t stream)
+{
+    int64_t total = batch * height * width;
+    // Choose block size and grid size.
+    int block_size = 256;
+    int grid_size = (int)((total + block_size - 1) / block_size);
+    // Cap grid size to avoid exceeding limits (grid-stride loop handles rest).
+    const int max_grid = 65535;
+    if (grid_size > max_grid) grid_size = max_grid;
+    sum_dim_kernel<<<grid_size, block_size, 0, stream>>>(
+        x, out, batch, channels, height, width);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,61 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declaration of launcher from custom_ops.cu
+extern "C" void sum_dim_forward_launcher(
+    const float* x,
+    float* out,
+    int64_t batch,
+    int64_t channels,
+    int64_t height,
+    int64_t width,
+    cudaStream_t stream);
+
+// PyTorch wrapper for sum over dimension 1
+torch::Tensor sum_dim_forward(torch::Tensor x, int64_t dim) {
+    // Input checks
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D (batch, channels, height, width)");
+    TORCH_CHECK(dim == 1, "Only dim=1 is supported");
+
+    // Make contiguous to match launcher indexing, if necessary
+    auto x_contig = x.contiguous();
+
+    int64_t batch = x_contig.size(0);
+    int64_t channels = x_contig.size(1);
+    int64_t height = x_contig.size(2);
+    int64_t width = x_contig.size(3);
+
+    // Allocate output tensor: [batch, height, width]
+    auto out = torch::empty({batch, height, width}, x_contig.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    sum_dim_forward_launcher(
+        x_contig.data_ptr<float>(),
+        out.data_ptr<float>(),
+        batch,
+        channels,
+        height,
+        width,
+        stream
+    );
+
+    return out;
+}
+
+// Registration function
+void register_sum_dim_forward(pybind11::module& m) {
+    m.def("sum_dim_forward", &sum_dim_forward,
+          "Sum over dimension 1 (channels)",
+          py::arg("x"), py::arg("dim"));
+}
+
+// Auto-register
+REGISTER_BINDING(sum_dim_forward, register_sum_dim_forward);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,22 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.identity = nn.Identity()
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        x = cuda_extension.sum_dim_forward(x, dim=1)
+        x = self.identity(x)
+        return x
+
+    def debug_forward(self, *inputs):
+        x = inputs[0]
+        y = cuda_extension.sum_dim_forward(x, dim=1)
+        yield "step_001", y
+        y2 = self.identity(y)
+        yield "step_002", y2
+        yield "step_003", y2
