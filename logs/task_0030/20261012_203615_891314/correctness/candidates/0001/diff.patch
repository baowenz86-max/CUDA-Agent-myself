--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,140 @@
+// custom_ops.cu
+#include <cuda_runtime.h>
+#include <cmath>
+#include <cstdint>
+
+// =========================== POLAR ===========================
+// Computes complex64 output from float32 magnitudes and angles.
+// Each thread computes one element: real = mag * cos(angle), imag = mag * sin(angle).
+__global__ void polar_kernel(const float* __restrict__ mag,
+                             const float* __restrict__ angle,
+                             float2* __restrict__ out,
+                             int64_t total) {
+    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)gridDim.x * blockDim.x;
+    for (int64_t i = idx; i < total; i += stride) {
+        float m = mag[i];
+        float a = angle[i];
+        out[i].x = m * cosf(a);
+        out[i].y = m * sinf(a);
+    }
+}
+
+extern "C" void polar_launcher(const float* mag,
+                               const float* angle,
+                               float2* out,
+                               int64_t total,
+                               cudaStream_t stream) {
+    if (total <= 0) return;
+    int threads = 256;
+    int64_t blocks64 = (total + threads - 1) / threads;
+    int blocks = (blocks64 > 1024) ? 1024 : (int)blocks64;
+    polar_kernel<<<blocks, threads, 0, stream>>>(mag, angle, out, total);
+}
+
+// =========================== ONE_HOT ===========================
+// Generates identity matrix of shape num_classes x num_classes as float32.
+// Output is a float32 tensor with 1 on diagonal, 0 elsewhere.
+__global__ void one_hot_kernel(float* out, int num_classes) {
+    int row = blockIdx.y * blockDim.y + threadIdx.y;
+    int col = blockIdx.x * blockDim.x + threadIdx.x;
+    if (row < num_classes && col < num_classes) {
+        out[row * num_classes + col] = (row == col) ? 1.0f : 0.0f;
+    }
+}
+
+extern "C" void one_hot_launcher(float* out,
+                                int num_classes,
+                                cudaStream_t stream) {
+    if (num_classes <= 0) return;
+    dim3 block(16, 16);
+    dim3 grid((num_classes + block.x - 1) / block.x,
+              (num_classes + block.y - 1) / block.y);
+    one_hot_kernel<<<grid, block, 0, stream>>>(out, num_classes);
+}
+
+// =========================== SDPA ===========================
+// Scaled dot-product attention: softmax(Q*K^T / sqrt(d)) * V
+// Inputs: Q, K, V of shape [B, H, L, D], float32.
+// Output: O of same shape, float32.
+// This implementation uses one thread per output element, with a loop over sequence length.
+// It is optimized for the given dimensions (L=128, D=16) but works generally.
+__global__ void sdpa_kernel(const float* __restrict__ q,
+                            const float* __restrict__ k,
+                            const float* __restrict__ v,
+                            float* __restrict__ out,
+                            int B, int H, int L, int D) {
+    int total = B * H * L * D;
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= total) return;
+
+    // Decode indices
+    int d = idx % D;
+    int l = (idx / D) % L;
+    int h = (idx / (D * L)) % H;
+    int b = idx / (D * L * H);
+
+    float inv_scale = 1.0f / sqrtf((float)D);
+
+    // Compute softmax denominator and numerator parts for this (b,h,l)
+    float max_score = -1e30f;
+    float scores[128]; // L up to 128, but we'll assume L <= 128 for stack; use dynamic for large L
+    // For general L, we should use dynamic allocation, but for known L=128 we can use fixed array.
+    // To be safe, we use a loop with two passes and no large array: first compute max, then denominator, then output.
+
+    // First pass: compute max score for stability
+    float local_max = -1e30f;
+    for (int j = 0; j < L; ++j) {
+        const float* q_row = q + ((b * H + h) * L + l) * D;
+        const float* k_row = k + ((b * H + h) * L + j) * D;
+        float dot = 0.0f;
+        for (int dd = 0; dd < D; ++dd) {
+            dot += q_row[dd] * k_row[dd];
+        }
+        dot *= inv_scale;
+        if (dot > local_max) local_max = dot;
+    }
+
+    // Second pass: compute denominator (sum of exp(score - max))
+    float denom = 0.0f;
+    for (int j = 0; j < L; ++j) {
+        const float* q_row = q + ((b * H + h) * L + l) * D;
+        const float* k_row = k + ((b * H + h) * L + j) * D;
+        float dot = 0.0f;
+        for (int dd = 0; dd < D; ++dd) {
+            dot += q_row[dd] * k_row[dd];
+        }
+        dot = (dot * inv_scale) - local_max;
+        denom += expf(dot);
+    }
+
+    // Third pass: compute weighted sum of V
+    float sum = 0.0f;
+    for (int j = 0; j < L; ++j) {
+        const float* q_row = q + ((b * H + h) * L + l) * D;
+        const float* k_row = k + ((b * H + h) * L + j) * D;
+        const float* v_row = v + ((b * H + h) * L + j) * D;
+        float dot = 0.0f;
+        for (int dd = 0; dd < D; ++dd) {
+            dot += q_row[dd] * k_row[dd];
+        }
+        dot = (dot * inv_scale) - local_max;
+        float weight = expf(dot) / denom;
+        sum += weight * v_row[d];
+    }
+
+    out[idx] = sum;
+}
+
+extern "C" void sdpa_launcher(const float* q,
+                              const float* k,
+                              const float* v,
+                              float* out,
+                              int B, int H, int L, int D,
+                              cudaStream_t stream) {
+    if (B <= 0 || H <= 0 || L <= 0 || D <= 0) return;
+    int total = B * H * L * D;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    sdpa_kernel<<<blocks, threads, 0, stream>>>(q, k, v, out, B, H, L, D);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,93 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" {
+void polar_launcher(const float* mag, const float* angle, float2* out, int64_t total, cudaStream_t stream);
+void one_hot_launcher(float* out, int num_classes, cudaStream_t stream);
+void sdpa_launcher(const float* q, const float* k, const float* v, float* out, int B, int H, int L, int D, cudaStream_t stream);
+}
+
+torch::Tensor polar_forward(torch::Tensor magnitudes, torch::Tensor angles) {
+    TORCH_CHECK(magnitudes.is_cuda(), "magnitudes must be a CUDA tensor");
+    TORCH_CHECK(angles.is_cuda(), "angles must be a CUDA tensor");
+    TORCH_CHECK(magnitudes.dtype() == torch::kFloat32, "magnitudes must be float32");
+    TORCH_CHECK(angles.dtype() == torch::kFloat32, "angles must be float32");
+    TORCH_CHECK(magnitudes.sizes() == angles.sizes(), "magnitudes and angles must have the same shape");
+    TORCH_CHECK(magnitudes.is_contiguous(), "magnitudes must be contiguous");
+    TORCH_CHECK(angles.is_contiguous(), "angles must be contiguous");
+
+    auto output = torch::empty_like(magnitudes, torch::TensorOptions().dtype(torch::kComplexFloat));
+    TORCH_CHECK(output.is_contiguous(), "output allocation failed");
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    polar_launcher(
+        magnitudes.data_ptr<float>(),
+        angles.data_ptr<float>(),
+        reinterpret_cast<float2*>(output.data_ptr<c10::complex<float>>()),
+        magnitudes.numel(),
+        stream
+    );
+
+    return output;
+}
+
+torch::Tensor one_hot_forward(int64_t num_classes) {
+    TORCH_CHECK(num_classes > 0, "num_classes must be positive");
+    auto output = torch::empty({num_classes, num_classes}, torch::TensorOptions().dtype(torch::kFloat32).device(torch::kCPU));
+    // Launcher expects float* and stream; for CPU we pass 0 (no CUDA stream needed)
+    one_hot_launcher(output.data_ptr<float>(), static_cast<int>(num_classes), 0);
+    return output;
+}
+
+torch::Tensor sdpa_forward(torch::Tensor query, torch::Tensor key, torch::Tensor value) {
+    TORCH_CHECK(query.is_cuda(), "query must be a CUDA tensor");
+    TORCH_CHECK(key.is_cuda(), "key must be a CUDA tensor");
+    TORCH_CHECK(value.is_cuda(), "value must be a CUDA tensor");
+    TORCH_CHECK(query.dtype() == torch::kFloat32, "query must be float32");
+    TORCH_CHECK(key.dtype() == torch::kFloat32, "key must be float32");
+    TORCH_CHECK(value.dtype() == torch::kFloat32, "value must be float32");
+    TORCH_CHECK(query.dim() == 4, "query must be 4D [B,H,L,D]");
+    TORCH_CHECK(key.dim() == 4, "key must be 4D [B,H,L,D]");
+    TORCH_CHECK(value.dim() == 4, "value must be 4D [B,H,L,D]");
+    TORCH_CHECK(query.size(0) == key.size(0) && key.size(0) == value.size(0), "batch size mismatch");
+    TORCH_CHECK(query.size(1) == key.size(1) && key.size(1) == value.size(1), "num_heads mismatch");
+    TORCH_CHECK(key.size(2) == value.size(2), "key/value sequence length mismatch");
+    TORCH_CHECK(query.size(3) == key.size(3), "head dim mismatch");
+    TORCH_CHECK(query.is_contiguous(), "query must be contiguous");
+    TORCH_CHECK(key.is_contiguous(), "key must be contiguous");
+    TORCH_CHECK(value.is_contiguous(), "value must be contiguous");
+
+    int B = static_cast<int>(query.size(0));
+    int H = static_cast<int>(query.size(1));
+    int L = static_cast<int>(query.size(2));
+    int D = static_cast<int>(query.size(3));
+
+    auto output = torch::empty_like(query);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    sdpa_launcher(
+        query.data_ptr<float>(),
+        key.data_ptr<float>(),
+        value.data_ptr<float>(),
+        output.data_ptr<float>(),
+        B, H, L, D,
+        stream
+    );
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("polar_forward", &polar_forward, "Compute complex numbers from magnitudes and angles (CUDA)",
+          pybind11::arg("magnitudes"), pybind11::arg("angles"));
+    m.def("one_hot_forward", &one_hot_forward, "Generate one-hot identity matrix on CPU",
+          pybind11::arg("num_classes"));
+    m.def("sdpa_forward", &sdpa_forward, "Scaled dot-product attention (CUDA)",
+          pybind11::arg("query"), pybind11::arg("key"), pybind11::arg("value"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,26 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, num_classes, embed_dim, num_heads):
+        super().__init__()
+        self.num_classes = num_classes
+        self.embed_dim = embed_dim
+        self.num_heads = num_heads
+
+    def forward(self, magnitudes, angles, query, key, value):
+        complex_numbers = cuda_extension.polar_forward(magnitudes, angles)
+        one_hot_encodings = cuda_extension.one_hot_forward(self.num_classes)
+        attention_output = cuda_extension.sdpa_forward(query, key, value)
+        return complex_numbers, one_hot_encodings, attention_output
+
+    def debug_forward(self, magnitudes, angles, query, key, value):
+        complex_numbers = cuda_extension.polar_forward(magnitudes, angles)
+        yield 'step_001', complex_numbers
+        one_hot_encodings = cuda_extension.one_hot_forward(self.num_classes)
+        yield 'step_002', one_hot_encodings
+        attention_output = cuda_extension.sdpa_forward(query, key, value)
+        yield 'step_003', attention_output
+        yield 'step_004', (complex_numbers, one_hot_encodings, attention_output)
