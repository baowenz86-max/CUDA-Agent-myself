    {
      "name": "softmax_dim1_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, channels, length]",
          "layout": "contiguous or supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "沿 dim=1 计算 softmax，即对每个 batch 和 length 位置，对 channels 维度求 softmax。",
        "数值稳定：先减每通道最大值再 exp 并归一化。",
        "返回与参考 step_002 相同的 shape、dtype、device 的张量。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = F.conv_transpose1d(x, self.conv_transpose1d.weight, self.conv_transpose1d.bias, stride=self.conv_transpose1d.stride, padding=self.conv_transpose1d.padding, output_padding=self.conv_transpose1d.output_padding)",
      "semantics": [
        "ConvTranspose1d 前向计算，使用提供的权重和偏置。",
        "stride=2, padding=1, output_padding=1，输入 shape [128, 3, 8192]，输出 shape [128, 16, 16384]。",
        "输出 dtype float32，device cuda。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.softmax(x)",
      "semantics": [
        "对 ConvTranspose1d 输出沿 dim=1 计算 softmax。",
        "输出 shape 保持不变 [128, 16, 16384]。",
        "输出 dtype float32，device cuda。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回软最大值结果，与 step_002 相同的张量。"
      ]
    }
  ]
