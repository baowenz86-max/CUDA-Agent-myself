{
  "operators": [
    {
      "name": "custom_adaptive_avg_pool2d_5d",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, in_channels, depth, height, width]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "output_size",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "output_size_y",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, in_channels, depth, 1, 1]"
      },
      "semantics": [
        "Performs adaptive average pooling over the last two dimensions (height, width) to output size (1,1).",
        "For each (batch, channel, depth), computes mean over all height and width elements.",
        "Preserves depth dimension unchanged.",
        "Equivalent to nn.AdaptiveAvgPool2d(output_size=(1,1)) applied to the last two dims of a 5D tensor."
      ]
    },
    {
      "name": "custom_conv3d",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, in_channels, depth, height, width]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels, in_channels, kD, kH, kW]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "stride",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "padding",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, out_channels, out_depth, out_height, out_width]"
      },
      "semantics": [
        "Performs 3D convolution with given stride and padding (same integer for all dims).",
        "Uses cuDNN backend.",
        "Bias is added per output channel; if None, no bias is added.",
        "Output shape computed as floor((input_size + 2*padding - kernel_size)/stride) + 1."
      ]
    },
    {
      "name": "custom_leaky_relu",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, channels, depth, height, width]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "negative_slope",
          "kind": "float",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "Applies LeakyReLU elementwise: max(0, x) + negative_slope * min(0, x).",
        "Default negative_slope is 0.01."
      ]
    },
    {
      "name": "custom_bias_add",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, out_channels, depth, height, width]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels, 1, 1, 1]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "Adds bias to each channel: output[b,c,d,h,w] = x[b,c,d,h,w] + bias[c,0,0,0].",
        "Bias is broadcast along depth, height, width."
      ]
    },
    {
      "name": "custom_clamp",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, channels, depth, height, width]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "min_val",
          "kind": "float",
          "optional": false,
          "nullable": false
        },
        {
          "name": "max_val",
          "kind": "float",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "Clamps all elements to [min_val, max_val].",
        "Equivalent to torch.clamp(x, min=min_val, max=max_val)."
      ]
    },
    {
      "name": "custom_conv_transpose3d",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, in_channels, depth, height, width]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[in_channels, out_channels, kD, kH, kW]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "stride",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "padding",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "output_padding",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, out_channels, out_depth, out_height, out_width]"
      },
      "semantics": [
        "Performs 3D transposed convolution with given stride, padding, output_padding.",
        "Uses cuDNN backend.",
        "Bias is added per output channel if provided.",
        "Output shape computed as (input_size - 1)*stride - 2*padding + kernel_size + output_padding."
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.adaptive_avg_pool(x)",
      "semantics": [
        "Adaptive average pooling on last two dims (height, width) to (1,1).",
        "Input shape [512,3,128,128,128] -> output [512,3,128,1,1].",
        "Mean over all 128x128 elements for each (batch, channel, depth)."
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.conv3d(x)",
      "semantics": [
        "3D convolution with kernel_size=(3,3,3), stride=(1,1,1), padding=(1,1,1).",
        "Input [512,3,128,1,1] -> output [512,64,128,1,1].",
        "Bias is added."
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = self.relu(x)",
      "semantics": [
        "LeakyReLU with negative_slope=0.01 applied elementwise."
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "x = x + self.bias",
      "semantics": [
        "Add bias parameter of shape [64,1,1,1] to x.",
        "Broadcast along channel dimension."
      ]
    },
    {
      "checkpoint": "step_005",
      "source": "x = torch.clamp(x, min=0.0, max=1.0)",
      "semantics": [
        "Clamp values between 0.0 and 1.0."
      ]
    },
    {
      "checkpoint": "step_006",
      "source": "x = self.conv_transpose3d(x)",
      "semantics": [
        "3D transposed convolution with kernel_size=(3,3,3), stride=(1,1,1), padding=(1,1,1), output_padding=(0,0,0).",
        "Input [512,64,128,1,1] -> output [512,64,128,1,1].",
        "Bias is added."
      ]
    },
    {
      "checkpoint": "step_007",
      "source": "return x",
      "semantics": [
        "Return final tensor [512,64,128,1,1]."
      ]
    }
  ]
}