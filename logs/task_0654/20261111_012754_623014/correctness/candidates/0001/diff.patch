--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,74 @@
+#include <cuda_runtime.h>
+
+// Kernel for element-wise absolute value
+// Supports arbitrary strides; each thread handles one element via grid-stride loop
+__global__ void abs_kernel(float* output, const float* input, long long numel) {
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+    for (; idx < numel; idx += stride) {
+        output[idx] = fabsf(input[idx]);
+    }
+}
+
+// Kernel for argmin along dimension 1.
+// Input shape: [B, D, H, W] (dim=1)
+// Output shape: [B, H, W]
+// Each thread computes argmin for one (b, h, w).
+// Input and output are assumed contiguous in memory layout, but we use explicit strides
+// to be safe. The strides are passed as arguments.
+__global__ void argmin_kernel(const float* input, int64_t* output,
+                              int B, int D, int H, int W,
+                              long long in_stride_b, long long in_stride_d,
+                              long long in_stride_h, long long in_stride_w,
+                              long long out_stride_b, long long out_stride_h,
+                              long long out_stride_w) {
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long total = (long long)B * H * W;
+    long long stride = (long long)blockDim.x * gridDim.x;
+    for (; idx < total; idx += stride) {
+        int b = idx / ((long long)H * W);
+        int rem = idx % ((long long)H * W);
+        int h = rem / W;
+        int w = rem % W;
+
+        const float* base = input + b * in_stride_b + h * in_stride_h + w * in_stride_w;
+        float min_val = base[0];
+        int min_idx = 0;
+        for (int d = 1; d < D; ++d) {
+            float val = base[d * in_stride_d];
+            if (val < min_val) {
+                min_val = val;
+                min_idx = d;
+            }
+        }
+        output[b * out_stride_b + h * out_stride_h + w * out_stride_w] = (int64_t)min_idx;
+    }
+}
+
+// Launcher for abs kernel
+extern "C" void copy_tensor_k_abs_out_launcher(float* output, const float* input,
+                                                long long numel, cudaStream_t stream) {
+    int threads = 256;
+    int blocks = (int)((numel + threads - 1) / threads);
+    if (blocks > 65535) blocks = 65535;  // grid-stride loop handles the rest
+    abs_kernel<<<blocks, threads, 0, stream>>>(output, input, numel);
+}
+
+// Launcher for argmin kernel
+extern "C" void copy_tensor_k_argmin_out_launcher(const float* input, int64_t* output,
+                                                   int B, int D, int H, int W,
+                                                   long long in_stride_b, long long in_stride_d,
+                                                   long long in_stride_h, long long in_stride_w,
+                                                   long long out_stride_b, long long out_stride_h,
+                                                   long long out_stride_w,
+                                                   cudaStream_t stream) {
+    long long total = (long long)B * H * W;
+    int threads = 256;
+    int blocks = (int)((total + threads - 1) / threads);
+    if (blocks > 65535) blocks = 65535;
+    argmin_kernel<<<blocks, threads, 0, stream>>>(input, output, B, D, H, W,
+                                                  in_stride_b, in_stride_d,
+                                                  in_stride_h, in_stride_w,
+                                                  out_stride_b, out_stride_h,
+                                                  out_stride_w);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,87 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void copy_tensor_k_abs_out_launcher(float* output, const float* input,
+                                                long long numel, cudaStream_t stream);
+extern "C" void copy_tensor_k_argmin_out_launcher(const float* input, int64_t* output,
+                                                   int B, int D, int H, int W,
+                                                   long long in_stride_b, long long in_stride_d,
+                                                   long long in_stride_h, long long in_stride_w,
+                                                   long long out_stride_b, long long out_stride_h,
+                                                   long long out_stride_w,
+                                                   cudaStream_t stream);
+
+// Wrapper for abs kernel
+torch::Tensor copy_tensor_k_abs_out(torch::Tensor input) {
+    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(input.scalar_type() == torch::kFloat32, "Input must be float32");
+
+    auto output = torch::empty_like(input);
+    long long numel = input.numel();
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    copy_tensor_k_abs_out_launcher(output.data_ptr<float>(), input.data_ptr<float>(), numel, stream);
+
+    return output;
+}
+
+// Wrapper for argmin kernel
+// Handles arbitrary dim, but currently only dim=1 is expected and optimized.
+torch::Tensor copy_tensor_k_argmin_out(torch::Tensor input, int64_t dim) {
+    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(input.scalar_type() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(input.dim() >= 1, "Input must have at least 1 dimension");
+
+    // Normalize negative dim
+    if (dim < 0) dim += input.dim();
+    TORCH_CHECK(dim >= 0 && dim < input.dim(), "dim out of range");
+
+    // For this specific task, dim=1 and input is 4D, but we can keep general logic for robustness.
+    // Compute output sizes: remove the dim dimension
+    auto sizes = input.sizes().vec();
+    sizes.erase(sizes.begin() + dim);
+    auto options = torch::TensorOptions().dtype(torch::kInt64).device(input.device());
+    auto output = torch::empty(sizes, options);
+
+    // Currently the .cu launcher is specialized for dim=1 with 4D tensor.
+    // For general dim, we need a different approach, but the contract only requires dim=1.
+    TORCH_CHECK(dim == 1, "Only dim=1 is supported for this kernel");
+    TORCH_CHECK(input.dim() == 4, "Input must be 4D for dim=1 argmin");
+
+    int B = input.size(0);
+    int D = input.size(1);
+    int H = input.size(2);
+    int W = input.size(3);
+
+    long long in_stride_b = input.stride(0);
+    long long in_stride_d = input.stride(1);
+    long long in_stride_h = input.stride(2);
+    long long in_stride_w = input.stride(3);
+
+    long long out_stride_b = output.stride(0);
+    long long out_stride_h = output.stride(1);
+    long long out_stride_w = output.stride(2);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    copy_tensor_k_argmin_out_launcher(input.data_ptr<float>(), output.data_ptr<int64_t>(),
+                                      B, D, H, W,
+                                      in_stride_b, in_stride_d, in_stride_h, in_stride_w,
+                                      out_stride_b, out_stride_h, out_stride_w,
+                                      stream);
+
+    return output;
+}
+
+// Registration
+void register_custom_ops(pybind11::module& m) {
+    m.def("copy_tensor_k_abs_out", &copy_tensor_k_abs_out, "Absolute value forward",
+          py::arg("input"));
+    m.def("copy_tensor_k_argmin_out", &copy_tensor_k_argmin_out, "Argmin forward",
+          py::arg("input"), py::arg("dim"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,22 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, input_size, reduction_indices):
+        super().__init__()
+        self.input_size = input_size
+        self.reduction_indices = reduction_indices
+
+    def forward(self, x):
+        x = cuda_extension.copy_tensor_k_abs_out(x)
+        x = cuda_extension.copy_tensor_k_argmin_out(x, self.reduction_indices)
+        return x
+
+    def debug_forward(self, x):
+        abs_result = cuda_extension.copy_tensor_k_abs_out(x)
+        yield 'step_001', abs_result
+        argmin_result = cuda_extension.copy_tensor_k_argmin_out(abs_result, self.reduction_indices)
+        yield 'step_002', argmin_result
+        yield 'step_003', argmin_result
