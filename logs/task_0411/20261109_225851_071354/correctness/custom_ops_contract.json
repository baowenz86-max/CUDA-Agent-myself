          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, sequence_length, embedding_dim]"
      },
      "semantics": [
        "对应参考语句 x = self.embedding(x)，将 int64 索引映射到 embedding 权重行。",
        "输入索引为 CPU int64 张量，权重为 CPU float32 张量。",
        "输出为 CUDA float32 张量，形状 [batch_size, sequence_length, embedding_dim]。",
        "索引范围为 [0, num_embeddings)，超出范围行为与 PyTorch nn.Embedding 相同（不检查）。",
        "返回张量在 CUDA 设备上，以便后续 CUDA 算子处理。"
      ]
    },
    {
      "name": "log_softmax_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, sequence_length, embedding_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, sequence_length, embedding_dim]"
      },
      "semantics": [
        "对应参考语句 x = torch.log_softmax(x, dim=-1)，沿最后一维计算 log_softmax。",
        "输入和输出均为 CUDA float32 张量，形状相同。",
        "计算时使用数值稳定的 log-sum-exp 方法。",
        "输出与输入具有相同的 stride 和内存布局。"
      ]
    },
    {
      "name": "softmax_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, sequence_length, embedding_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, sequence_length, embedding_dim]"
      },
      "semantics": [
        "对应参考语句 target = F.softmax(target, dim=-1)，沿最后一维计算 softmax。",
        "输入和输出均为 CUDA float32 张量，形状相同。",
        "计算时使用数值稳定的 exp(x - max) 方法。",
        "输出与输入具有相同的 stride 和内存布局。"
      ]
    },
    {
      "name": "kl_div_batchmean_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, sequence_length, embedding_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "target",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, sequence_length, embedding_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[]"
      },
      "semantics": [
        "对应参考语句 x = F.kl_div(x, target, reduction='batchmean')。",
        "输入 log-probabilities (input) 和 probabilities (target) 均为 CUDA float32 张量，形状相同。",
        "计算逐元素 target * (log(target) - input)，然后求和并除以 batch_size。",
        "batchmean 的 batch_size 取输入张量第 0 维大小。",
        "输出为标量 CUDA float32 张量。"
      ]
    }
  ],
  "reference_steps": [
    {
