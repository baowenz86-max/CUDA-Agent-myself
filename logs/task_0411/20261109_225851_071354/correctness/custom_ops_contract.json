        "使用数值稳定方法。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "target = F.softmax(target, dim=-1)",
      "semantics": [
        "沿最后一维计算 softmax，输出形状 [128, 1024, 512]。",
        "使用数值稳定方法。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "x = F.kl_div(x, target, reduction='batchmean')",
      "semantics": [
        "计算 KL 散度，reduction='batchmean'，输出标量 float32 CUDA 张量。",
        "公式为 sum(target * (log(target) - input)) / batch_size。"
      ]
    },
    {
      "checkpoint": "step_005",
      "source": "return x",
      "semantics": [
        "返回标量 float32 CUDA 张量。"
      ]
    }
  ]
