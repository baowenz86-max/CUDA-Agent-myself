--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,71 @@
+#include <cuda_runtime.h>
+#include <math.h>
+
+// Element-wise softplus: y = x for x > 20, else log1p(exp(x))
+__global__ void softplus_kernel(const float* __restrict__ input,
+                                float* __restrict__ output,
+                                long long total_elements) {
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+    for (long long i = idx; i < total_elements; i += stride) {
+        float x = input[i];
+        if (x > 20.0f) {
+            output[i] = x;
+        } else {
+            output[i] = log1pf(expf(x));
+        }
+    }
+}
+
+// Sum over dimension 1 (size C) with keepdim=true.
+// Input shape [N, C, H, W], output shape [N, 1, H, W].
+// Input is contiguous in H,W and C, but stride in N is C*H*W = C*HW.
+// Output stride: [C*HW, HW, W, 1] where HW = H*W, but output dim1 size is 1.
+// We compute output[b,0,h,w] = sum_{c=0}^{C-1} input[b,c,h,w]
+__global__ void sum_dim1_kernel(const float* __restrict__ input,
+                                float* __restrict__ output,
+                                int N, int C, int H, int W) {
+    long long HW = (long long)H * W;
+    long long total_output = (long long)N * HW; // number of output elements
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+    for (long long i = idx; i < total_output; i += stride) {
+        // i corresponds to output index: b * HW + (h*W + w)
+        int b = i / HW;
+        long long hw = i % HW;
+        int h = hw / W;
+        int w = hw % W;
+        // input base for this b and hw
+        const float* in_base = input + (long long)b * C * HW + hw;
+        float sum = 0.0f;
+        #pragma unroll 8
+        for (int c = 0; c < C; ++c) {
+            sum += in_base[(long long)c * HW];
+        }
+        output[i] = sum;
+    }
+}
+
+// Host launcher for softplus (no PyTorch dependencies, accepts raw pointers and stream)
+extern "C" void custom_softplus_launcher(const float* input,
+                                         float* output,
+                                         long long total_elements,
+                                         cudaStream_t stream) {
+    int threads = 256;
+    int blocks = (int)((total_elements + threads - 1) / threads);
+    if (blocks > 65535) blocks = 65535; // grid cap, but kernel uses grid-stride loop
+    softplus_kernel<<<blocks, threads, 0, stream>>>(input, output, total_elements);
+}
+
+// Host launcher for sum over dim1
+extern "C" void custom_sum_dim1_launcher(const float* input,
+                                         float* output,
+                                         int N, int C, int H, int W,
+                                         cudaStream_t stream) {
+    long long HW = (long long)H * W;
+    long long total_output = (long long)N * HW;
+    int threads = 256;
+    int blocks = (int)((total_output + threads - 1) / threads);
+    if (blocks > 65535) blocks = 65535;
+    sum_dim1_kernel<<<blocks, threads, 0, stream>>>(input, output, N, C, H, W);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,71 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void custom_softplus_launcher(const float* input,
+                                         float* output,
+                                         long long total_elements,
+                                         cudaStream_t stream);
+
+extern "C" void custom_sum_dim1_launcher(const float* input,
+                                         float* output,
+                                         int N, int C, int H, int W,
+                                         cudaStream_t stream);
+
+// PyTorch wrapper for softplus
+torch::Tensor custom_softplus(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D");
+
+    auto output = torch::empty_like(x);
+    long long total_elements = x.numel();
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    custom_softplus_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        total_elements,
+        stream
+    );
+
+    return output;
+}
+
+// PyTorch wrapper for sum over dim 1 (keepdim=True)
+torch::Tensor custom_sum_dim1(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D");
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+
+    auto output = torch::empty({N, 1, H, W}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    custom_sum_dim1_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C, H, W,
+        stream
+    );
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_softplus", &custom_softplus, "Softplus forward",
+          pybind11::arg("x"));
+    m.def("custom_sum_dim1", &custom_sum_dim1, "Sum over dim 1 with keepdim",
+          pybind11::arg("x"));
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,21 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_features, out_features, dim):
+        super().__init__()
+        self.dim = dim
+
+    def forward(self, x):
+        x = cuda_extension.custom_softplus(x)
+        x = cuda_extension.custom_sum_dim1(x)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.custom_softplus(x)
+        yield 'step_001', x
+        x = cuda_extension.custom_sum_dim1(x)
+        yield 'step_002', x
+        yield 'step_003', x
