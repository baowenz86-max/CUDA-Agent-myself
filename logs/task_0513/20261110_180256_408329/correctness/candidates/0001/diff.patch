--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,77 @@
+// MaxPool1d CUDA kernel and launcher
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// Kernel: each thread computes one output element
+template <typename T>
+__global__ void maxpool1d_kernel(
+    const T* __restrict__ input,
+    T* __restrict__ output,
+    int64_t N,          // batch size
+    int64_t C,          // channels
+    int64_t L_in,       // input length
+    int64_t L_out,      // output length
+    int64_t kernel_size,
+    int64_t stride,
+    int64_t padding)
+{
+    int64_t total = N * C * L_out;
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t grid_stride = blockDim.x * gridDim.x;
+
+    for (int64_t i = idx; i < total; i += grid_stride) {
+        // Decode indices: i -> (n, c, l_out)
+        int64_t l_out = i % L_out;
+        int64_t tmp = i / L_out;
+        int64_t c = tmp % C;
+        int64_t n = tmp / C;
+
+        // Compute input window start (including padding)
+        int64_t start = l_out * stride - padding;
+        int64_t end = start + kernel_size; // exclusive
+
+        // Clamp to valid input range
+        int64_t valid_start = start < 0 ? 0 : start;
+        int64_t valid_end = end > L_in ? L_in : end;
+
+        // If window is entirely in padding (should not happen with typical settings), output -inf? 
+        // For MaxPool1d with padding, windows outside input are -inf in torch, but with k<=L+2p, at least one valid.
+        T max_val = -1e30; // initialize to very negative
+        bool has_valid = false;
+
+        const T* input_base = input + (n * C + c) * L_in;
+        for (int64_t k = valid_start; k < valid_end; ++k) {
+            T val = input_base[k];
+            if (!has_valid || val > max_val) {
+                max_val = val;
+                has_valid = true;
+            }
+        }
+
+        output[i] = max_val;
+    }
+}
+
+// Launcher with fixed float32 (since contract only uses float32)
+extern "C" void maxpool1d_forward_launcher(
+    const float* input,
+    float* output,
+    int64_t N,
+    int64_t C,
+    int64_t L_in,
+    int64_t L_out,
+    int64_t kernel_size,
+    int64_t stride,
+    int64_t padding,
+    cudaStream_t stream)
+{
+    int64_t total = N * C * L_out;
+    int block_size = 256;
+    int grid_size = (int)((total + block_size - 1) / block_size);
+    // Cap grid size to avoid exceeding max grid dimension (usually 2^31-1), but total is ~268M, grid ~1M, well within limits.
+    if (grid_size > 65535) {
+        grid_size = 65535; // use grid-stride loop for anything larger
+    }
+    maxpool1d_kernel<float><<<grid_size, block_size, 0, stream>>>(
+        input, output, N, C, L_in, L_out, kernel_size, stride, padding);
+}
--- before/kernels/maxpool1d_binding.cpp
+++ after/kernels/maxpool1d_binding.cpp
@@ -0,0 +1,93 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launcher from custom_ops.cu
+extern "C" void maxpool1d_forward_launcher(
+    const float* input,
+    float* output,
+    int64_t N,
+    int64_t C,
+    int64_t L_in,
+    int64_t L_out,
+    int64_t kernel_size,
+    int64_t stride,
+    int64_t padding,
+    cudaStream_t stream);
+
+// PyTorch wrapper
+torch::Tensor maxpool1d_forward(
+    torch::Tensor input,
+    int64_t kernel_size,
+    int64_t stride,
+    int64_t padding,
+    bool ceil_mode) {
+    // 输入检查
+    TORCH_CHECK(input.is_cuda(), "Input tensor must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input tensor must be float32");
+    TORCH_CHECK(input.dim() == 3, "Input tensor must be 3D (N, C, L)");
+    TORCH_CHECK(input.is_contiguous(), "Input tensor must be contiguous");
+
+    // 提取尺寸
+    int64_t N = input.size(0);
+    int64_t C = input.size(1);
+    int64_t L_in = input.size(2);
+
+    // 计算输出长度（ceil_mode 当前实现不考虑，但传参保留）
+    // 与 PyTorch MaxPool1d 公式一致
+    int64_t L_out;
+    if (ceil_mode) {
+        // ceil_mode = true 时输出长度 = ceil((L + 2*padding - kernel_size)/stride) + 1
+        // 但当前 CUDA kernel 未实现 ceil_mode，仅接受参数，实际仍按照 floor 计算。
+        // 为保持与 kernel 一致，我们按 floor 计算，但契约中 ceil_mode 被调用为 false。
+        // 这里安全处理：如果 ceil_mode 为 true，仍使用 floor 逻辑，但可能会与参考不一致。
+        // 由于实际调用 ceil_mode = false，我们仅需支持 false 情况。
+        // 如果未来需要支持，需要更新 kernel。暂时使用 floor 计算。
+        TORCH_CHECK(false, "ceil_mode=true is not supported yet");
+    } else {
+        L_out = (L_in + 2 * padding - kernel_size) / stride + 1;
+        // 确保有效窗口至少为 1，且不超过输入长度
+        TORCH_CHECK(L_out > 0, "Output length must be positive");
+    }
+
+    // 分配输出张量
+    auto output = torch::empty({N, C, L_out}, input.options());
+
+    // 获取当前 CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // 调用 launcher
+    maxpool1d_forward_launcher(
+        input.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N,
+        C,
+        L_in,
+        L_out,
+        kernel_size,
+        stride,
+        padding,
+        stream);
+
+    // 检查 CUDA 错误
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// 注册到 pybind
+void register_maxpool1d(pybind11::module& m) {
+    m.def("maxpool1d_forward", &maxpool1d_forward,
+          "MaxPool1d forward",
+          py::arg("input"),
+          py::arg("kernel_size"),
+          py::arg("stride"),
+          py::arg("padding"),
+          py::arg("ceil_mode"));
+}
+
+// 自动注册
+REGISTER_BINDING(maxpool1d, register_maxpool1d);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,20 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels: int, kernel_size: int, stride: int = 1, padding: int = 0):
+        super().__init__()
+        self.in_channels = in_channels
+        self.kernel_size = kernel_size
+        self.stride = stride
+        self.padding = padding
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return cuda_extension.maxpool1d_forward(x, self.kernel_size, self.stride, self.padding, False)
+
+    def debug_forward(self, *inputs):
+        x = inputs[0]
+        out = self.forward(x)
+        yield 'step_001', out
