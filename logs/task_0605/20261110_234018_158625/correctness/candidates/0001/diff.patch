+#include <cuda_runtime.h>
+#include <math.h>
+
+// MaxPool2d forward kernel for NCHW float32 tensor
+// Supports arbitrary stride, padding, dilation, ceil_mode (ceil_mode only affects output size, but we follow ceil_mode semantics)
+// Ignores padding regions by initializing to -inf and only considering valid input coordinates.
+__global__ void maxpool2d_forward_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int N, int C, int H, int W,
+    int outH, int outW,
+    int kernelH, int kernelW,
+    int strideH, int strideW,
+    int paddingH, int paddingW,
+    int dilationH, int dilationW) {
+    
+    int total = N * C * outH * outW;
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+    
+    for (int i = idx; i < total; i += stride) {
+        int ow = i % outW;
+        int tmp = i / outW;
+        int oh = tmp % outH;
+        tmp = tmp / outH;
+        int c = tmp % C;
+        int n = tmp / C;
+        
+        // Input start coordinates corresponding to output (oh, ow) before padding
+        int hstart = oh * strideH - paddingH;
+        int wstart = ow * strideW - paddingW;
+        
+        float maxval = -INFINITY;
+        
+        for (int kh = 0; kh < kernelH; ++kh) {
+            int ih = hstart + kh * dilationH;
+            if (ih < 0 || ih >= H) continue;
+            for (int kw = 0; kw < kernelW; ++kw) {
+                int iw = wstart + kw * dilationW;
+                if (iw < 0 || iw >= W) continue;
+                const float val = input[((n * C + c) * H + ih) * W + iw];
+                if (val > maxval) maxval = val;
+            }
+        }
+        
+        // If no valid element (should not happen with valid output indices), output -inf, but PyTorch would produce -inf for all-padding windows? Actually such windows are not generated because output size only considers positions where kernel overlaps at least partially.
+        // However, with ceil_mode and padding, some output positions may have no valid input elements? MaxPool with count_include_pad=False ignores padding, but if all positions are padding, the output is -inf? PyTorch documentation says output is -inf for empty windows if ceil_mode used? Let's check: In practice, output size formula ensures that at least one valid element exists for any output position when ceil_mode=False (floor). For ceil_mode=True, output may include positions beyond the input, causing empty windows. Since current model uses ceil_mode=False, we can safely assume at least one valid element. But to be safe, we output maxval even if -inf.
+        output[i] = maxval;
+    }
+}
+
+// ReLU forward kernel: output = max(input, 0)
+__global__ void relu_forward_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int total) {
+    
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+    
+    for (int i = idx; i < total; i += stride) {
+        float val = input[i];
+        output[i] = val > 0.0f ? val : 0.0f;
+    }
+}
+
+// Launcher for maxpool2d
+// All tensors are assumed contiguous. If input may be non-contiguous, binding layer should pass contiguous copy or handle strides. 
+// The contract mentions "layout: supports strides", but launcher receives raw pointer; cannot handle strides. Therefore binding layer must ensure contiguity, or we can pass strides. We'll design launcher to accept only contiguous data pointer, and binding will call .contiguous() if needed.
+// The binding.cpp will be responsible for making contiguous.
+extern "C" void maxpool2d_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    int outH, int outW,
+    int kernelH, int kernelW,
+    int strideH, int strideW,
+    int paddingH, int paddingW,
+    int dilationH, int dilationW,
+    cudaStream_t stream) {
+    
+    int total = N * C * outH * outW;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    // Limit blocks to a reasonable number; grid-stride loop handles rest
+    const int max_blocks = 65535;
+    if (blocks > max_blocks) blocks = max_blocks;
+    
+    maxpool2d_forward_kernel<<<blocks, threads, 0, stream>>>(
+        input, output,
+        N, C, H, W,
+        outH, outW,
+        kernelH, kernelW,
+        strideH, strideW,
+        paddingH, paddingW,
+        dilationH, dilationW);
+}
+
+// Launcher for relu
+extern "C" void relu_launcher(
+    const float* input,
+    float* output,
+    int total,
+    cudaStream_t stream) {
+    
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    const int max_blocks = 65535;
+    if (blocks > max_blocks) blocks = max_blocks;
+    
+    relu_forward_kernel<<<blocks, threads, 0, stream>>>(
+        input, output, total);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,154 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void maxpool2d_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    int outH, int outW,
+    int kernelH, int kernelW,
+    int strideH, int strideW,
+    int paddingH, int paddingW,
+    int dilationH, int dilationW,
+    cudaStream_t stream);
+
+extern "C" void relu_launcher(
+    const float* input,
+    float* output,
+    int total,
+    cudaStream_t stream);
+
+// Helper to compute maxpool output dimensions (same as PyTorch MaxPool2d)
+static inline int64_t maxpool_output_size(
+    int64_t input_size, int64_t kernel_size, int64_t stride, int64_t padding, int64_t dilation, bool ceil_mode) {
+    int64_t numerator = input_size + 2 * padding - dilation * (kernel_size - 1) - 1;
+    if (ceil_mode) {
+        return (numerator + stride - 1) / stride + 1;
+    } else {
+        return numerator / stride + 1;
+    }
+}
+
+// Wrapper for custom_maxpool2d
+torch::Tensor custom_maxpool2d(
+    torch::Tensor input,
+    int64_t kernel_h,
+    int64_t kernel_w,
+    int64_t stride_h,
+    int64_t stride_w,
+    int64_t padding_h,
+    int64_t padding_w,
+    int64_t dilation_h,
+    int64_t dilation_w,
+    bool ceil_mode) {
+
+    // Input checks
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(input.dim() == 4, "input must be a 4D tensor (NCHW)");
+    TORCH_CHECK(input.scalar_type() == torch::kFloat32, "input must have dtype float32");
+    TORCH_CHECK(kernel_h > 0 && kernel_w > 0, "kernel size must be positive");
+    TORCH_CHECK(stride_h > 0 && stride_w > 0, "stride must be positive");
+    TORCH_CHECK(dilation_h > 0 && dilation_w > 0, "dilation must be positive");
+
+    // Ensure contiguous input (launcher assumes contiguous)
+    auto input_contig = input.contiguous();
+
+    int64_t N = input_contig.size(0);
+    int64_t C = input_contig.size(1);
+    int64_t H = input_contig.size(2);
+    int64_t W = input_contig.size(3);
+
+    // Compute output dimensions using maxpool_output_size helper
+    int64_t outH = maxpool_output_size(H, kernel_h, stride_h, padding_h, dilation_h, ceil_mode);
+    int64_t outW = maxpool_output_size(W, kernel_w, stride_w, padding_w, dilation_w, ceil_mode);
+
+    TORCH_CHECK(outH > 0 && outW > 0, "computed output size is non-positive");
+
+    // Allocate output tensor
+    auto output = torch::empty({N, C, outH, outW}, input_contig.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Launch maxpool kernel
+    maxpool2d_launcher(
+        input_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int>(N),
+        static_cast<int>(C),
+        static_cast<int>(H),
+        static_cast<int>(W),
+        static_cast<int>(outH),
+        static_cast<int>(outW),
+        static_cast<int>(kernel_h),
+        static_cast<int>(kernel_w),
+        static_cast<int>(stride_h),
+        static_cast<int>(stride_w),
+        static_cast<int>(padding_h),
+        static_cast<int>(padding_w),
+        static_cast<int>(dilation_h),
+        static_cast<int>(dilation_w),
+        stream);
+
+    return output;
+}
+
+// Wrapper for custom_relu
+torch::Tensor custom_relu(torch::Tensor input) {
+    // Input checks
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(input.scalar_type() == torch::kFloat32, "input must have dtype float32");
+
+    // Ensure contiguous input
+    auto input_contig = input.contiguous();
+
+    int64_t total = input_contig.numel();
+    TORCH_CHECK(total > 0, "input must not be empty");
+
+    // Allocate output tensor of same shape
+    auto output = torch::empty_like(input_contig);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Launch relu kernel
+    relu_launcher(
+        input_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int>(total),
+        stream);
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def(
+        "custom_maxpool2d",
+        &custom_maxpool2d,
+        "Custom MaxPool2d forward",
+        py::arg("input"),
+        py::arg("kernel_h"),
+        py::arg("kernel_w"),
+        py::arg("stride_h"),
+        py::arg("stride_w"),
+        py::arg("padding_h"),
+        py::arg("padding_w"),
+        py::arg("dilation_h"),
+        py::arg("dilation_w"),
+        py::arg("ceil_mode"));
+
+    m.def(
+        "custom_relu",
+        &custom_relu,
+        "Custom ReLU forward",
+        py::arg("input"));
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,82 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(
+        self,
+        in_channels: int,
+        out_channels: int,
+        kernel_size: tuple,
+        stride: int = 1,
+        padding: tuple = (0, 0),
+        dilation: tuple = (1, 1),
+        bias: bool = True,
+    ):
+        super().__init__()
+        # 保持与参考模型相同的结构，只使用传入的 kernel_size, stride, padding, dilation
+        self.maxpool = nn.MaxPool2d(
+            kernel_size,
+            stride=stride,
+            padding=padding,
+            dilation=dilation,
+            ceil_mode=False,
+        )
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        # 使用自定义算子实现 maxpool 和 relu
+        # 从 self.maxpool 提取参数
+        kernel_h, kernel_w = self.maxpool.kernel_size
+        stride = self.maxpool.stride
+        stride_h, stride_w = stride if isinstance(stride, tuple) else (stride, stride)
+        padding = self.maxpool.padding
+        padding_h, padding_w = padding if isinstance(padding, tuple) else (padding, padding)
+        dilation = self.maxpool.dilation
+        dilation_h, dilation_w = dilation if isinstance(dilation, tuple) else (dilation, dilation)
+        ceil_mode = self.maxpool.ceil_mode
+
+        x = cuda_extension.custom_maxpool2d(
+            x,
+            kernel_h,
+            kernel_w,
+            stride_h,
+            stride_w,
+            padding_h,
+            padding_w,
+            dilation_h,
+            dilation_w,
+            ceil_mode,
+        )
+        x = cuda_extension.custom_relu(x)
+        return x
+
+    def debug_forward(self, *inputs):
+        x = inputs[0]
+        kernel_h, kernel_w = self.maxpool.kernel_size
+        stride = self.maxpool.stride
+        stride_h, stride_w = stride if isinstance(stride, tuple) else (stride, stride)
+        padding = self.maxpool.padding
+        padding_h, padding_w = padding if isinstance(padding, tuple) else (padding, padding)
+        dilation = self.maxpool.dilation
+        dilation_h, dilation_w = dilation if isinstance(dilation, tuple) else (dilation, dilation)
+        ceil_mode = self.maxpool.ceil_mode
+
+        x = cuda_extension.custom_maxpool2d(
+            x,
+            kernel_h,
+            kernel_w,
+            stride_h,
+            stride_w,
+            padding_h,
+            padding_w,
+            dilation_h,
+            dilation_w,
+            ceil_mode,
+        )
+        yield "step_001", x
+
+        x = cuda_extension.custom_relu(x)
+        yield "step_002", x
+
+        yield "step_003", x
