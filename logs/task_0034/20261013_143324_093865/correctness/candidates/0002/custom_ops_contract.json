          "name": "stride",
          "kind": "int",
          "default": null,
          "optional": false,
          "nullable": false
        },
        {
          "name": "padding",
          "kind": "int",
          "default": null,
          "optional": false,
          "nullable": false
        },
        {
          "name": "output_padding",
          "kind": "int",
          "default": null,
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, out_channels, H_out, W_out]"
      },
      "semantics": [
        "计算 ConvTranspose2d，输入为 input [N, C_in, H_in, W_in]，权重 weight [C_in, C_out, kH, kW]，偏置 bias [C_out]，stride、padding、output_padding 为标量整数。",
        "输出形状 H_out = (H_in - 1) * stride - 2 * padding + kernel_size + output_padding，W_out 同理。",
        "等价于参考代码 self.conv_transpose(x)，使用 cuDNN 实现，包含 bias 加法。",
        "输入、权重、偏置均需在 CUDA 上，输出为 CUDA float32 张量。"
      ]
    },
    {
      "name": "upsample_nearest_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H_in, W_in]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "scale_factor",
          "kind": "int",
          "default": null,
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C, H_in * scale_factor, W_in * scale_factor]"
      },
      "semantics": [
        "计算最近邻上采样，模式为 nearest，scale_factor 为整数倍。",
        "输出在空间维度上重复每个像素 scale_factor 次，等价于 self.upsample(x)。",
        "输入为 CUDA float32，输出为 CUDA float32。"
      ]
    },
    {
      "name": "one_hot_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.int64",
          "device": "cuda",
          "shape": "[N, *]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "num_classes",
          "kind": "int",
          "default": null,
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.int64",
        "device": "cuda",
        "shape": "[N, *, num_classes]"
      },
      "semantics": [
        "将输入整数张量转换为 one-hot 编码，新增最后一维长度为 num_classes。",
        "输入值范围 [0, num_classes-1]，输出在对应类别位置为 1，其余为 0，dtype 为 int64。",
        "等价于 F.one_hot(input, num_classes=num_classes)。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.conv_transpose(x)",
      "semantics": [
        "对输入 x [1024,3,24,24] 执行 ConvTranspose2d，权重形状 [3,16,3,3]，偏置形状 [16]，stride=2, padding=1, output_padding=1。",
        "输出形状为 [1024,16,48,48]，float32，CUDA 张量。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.upsample(x)",
      "semantics": [
        "对 conv_transpose 输出 [1024,16,48,48] 执行最近邻上采样，scale_factor=2。",
        "输出形状为 [1024,16,96,96]，float32，CUDA 张量。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "target = F.one_hot(target, num_classes=self.num_classes)",
      "semantics": [
        "对 target [1024,48,48] 进行 one-hot 编码，num_classes=10。",
        "输出形状为 [1024,48,48,10]，int64，CUDA 张量。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return (x, target)",
      "semantics": [
        "返回元组 (x, target)，分别为上采样输出 [1024,16,96,96] float32 和 one-hot 输出 [1024,48,48,10] int64。"
      ]
    }
  ]
}