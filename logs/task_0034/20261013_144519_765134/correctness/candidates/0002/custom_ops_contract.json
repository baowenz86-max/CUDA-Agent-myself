          "optional": false
        },
        {
          "name": "stride",
          "kind": "int",
          "default": 1,
          "optional": false,
          "nullable": false
        },
        {
          "name": "padding",
          "kind": "int",
          "default": 0,
          "optional": false,
          "nullable": false
        },
        {
          "name": "output_padding",
          "kind": "int",
          "default": 0,
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C_out, H_out, W_out]"
      },
      "semantics": [
        "使用 cuDNN 实现 ConvTranspose2d，与参考 nn.ConvTranspose2d 相同语义，包括 bias 添加、stride、padding、output_padding。",
        "输出尺寸：H_out = (H_in - 1) * stride - 2 * padding + kernel_size + output_padding，W_out 类似。",
        "参数 stride、padding、output_padding 可为 int 或 tuple，内部统一为 (int, int)，但契约中按 int 处理（参考模型传入单个整数，扩展内部复制到两个维度）。"
      ]
    },
    {
      "name": "custom_upsample_nearest2d",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "scale_factor",
          "kind": "float",
          "default": 2.0,
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C, H * scale_factor, W * scale_factor]"
      },
      "semantics": [
        "实现 nearest 上采样，与参考 nn.Upsample(scale_factor=scale_factor, mode='nearest') 相同。",
        "输出尺寸：out_H = floor(H * scale_factor)，out_W = floor(W * scale_factor)，但参考中 scale_factor=2 为整数倍，因此为精确 2 倍。",
        "最近邻索引：out_y = floor(in_y / scale_factor)，out_x = floor(in_x / scale_factor)。"
      ]
    },
    {
      "name": "custom_one_hot",
      "parameters": [
        {
          "name": "target",
          "kind": "tensor",
          "dtype": "torch.int64",
          "device": "cuda",
          "shape": "[N, H, W]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "num_classes",
          "kind": "int",
          "default": -1,
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.int64",
        "device": "cuda",
        "shape": "[N, H, W, num_classes]"
      },
      "semantics": [
        "实现 F.one_hot，与参考语义相同：在最后一维添加 one-hot 编码。",
        "输出 dtype 为 torch.int64，与参考一致（参考目标 dtype 为 int64）。",
        "若 target 中的值超出 [0, num_classes-1]，参考行为是输出全零行，但不做异常检查。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.conv_transpose(x)",
      "semantics": [
        "执行 ConvTranspose2d 前向，输入 x shape [1024,3,24,24] float32，输出 x shape [1024,16,48,48] float32。",
        "使用 conv_transpose.weight shape [3,16,3,3] 和 bias shape [16]，stride=2, padding=1, output_padding=1。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.upsample(x)",
      "semantics": [
        "执行 nearest 上采样，scale_factor=2，输入 x shape [1024,16,48,48]，输出 shape [1024,16,96,96]。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "target = F.one_hot(target, num_classes=self.num_classes)",
      "semantics": [
        "执行 one_hot 编码，输入 target shape [1024,48,48] int64，num_classes=10，输出 shape [1024,48,48,10] int64。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return (x, target)",
      "semantics": [
        "返回元组 (x, target)，x 为 upsample 输出 shape [1024,16,96,96] float32，target 为 one_hot 输出 shape [1024,48,48,10] int64。"
      ]
    }
  ]
}