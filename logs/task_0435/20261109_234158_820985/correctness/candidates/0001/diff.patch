--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,46 @@
+// PixelUnshuffle CUDA kernel
+// Implements torch.nn.PixelUnshuffle forward pass
+// Input: float32 tensor with shape [N, C, H, W]
+// Output: float32 tensor with shape [N, C*downscale_factor^2, H/downscale_factor, W/downscale_factor]
+// The output value at (n, c*r^2 + i*r + j, h_out, w_out) equals input value at (n, c, h_out*r + i, w_out*r + j)
+
+#include <cuda_runtime.h>
+
+// Kernel: each thread writes one output element
+// Uses grid-stride loop to cover arbitrary number of elements
+__global__ void pixel_unshuffle_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int N, int C, int H, int W, int r,
+    long long total_elements)
+{
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+
+    for (; idx < total_elements; idx += stride) {
+        // Compute output coordinates
+        int w_out = idx % (W / r);
+        long long tmp = idx / (W / r);
+        int h_out = tmp % (H / r);
+        tmp /= (H / r);
+        int c_out = tmp % (C * r * r);
+        int n = tmp / (C * r * r);
+
+        // From c_out compute original c, i, j
+        int c = c_out / (r * r);
+        int ij = c_out % (r * r);
+        int i = ij / r;
+        int j = ij % r;
+
+        // Input coordinates
+        int h_in = h_out * r + i;
+        int w_in = w_out * r + j;
+
+        // Input index (assuming contiguous input; caller ensures contiguity or uses strides?)
+        // Contract says arbitrary stride, so we need to handle strides. But launcher receives only dims and pointer? We'll add stride parameters.
+        // For now, assume contiguous as contract includes layout "supports strides". Better add stride params to launcher.
+        // We will add strideN, strideC, strideH, strideW to kernel and launcher.
+        // However, the binding.cpp is fixed? Actually binding is not provided yet, but we can define launcher signature accordingly.
+        // Since we are only writing .cu, we define launcher with the needed parameters and document that binding will pass strides.
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,71 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launcher from custom_ops.cu
+extern "C" void pixel_unshuffle_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W, int r,
+    long long total_elements,
+    cudaStream_t stream
+);
+
+torch::Tensor pixel_unshuffle_forward(torch::Tensor x, int64_t downscale_factor) {
+    // Validate input tensor
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D (N, C, H, W)");
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+    int64_t r = downscale_factor;
+
+    TORCH_CHECK(r > 0, "downscale_factor must be positive");
+    TORCH_CHECK(H % r == 0 && W % r == 0, "H and W must be divisible by downscale_factor");
+
+    // Make input contiguous if necessary (we rely on contiguous memory in the kernel)
+    auto x_contig = x.contiguous();
+
+    // Allocate output tensor with required shape
+    int64_t H_out = H / r;
+    int64_t W_out = W / r;
+    int64_t C_out = C * r * r;
+    auto output = torch::empty({N, C_out, H_out, W_out}, x.options());
+
+    long long total_elements = output.numel();
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    pixel_unshuffle_launcher(
+        x_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int>(N),
+        static_cast<int>(C),
+        static_cast<int>(H),
+        static_cast<int>(W),
+        static_cast<int>(r),
+        total_elements,
+        stream
+    );
+
+    // Check for kernel launch errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "Kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+void register_pixel_unshuffle(pybind11::module& m) {
+    m.def("pixel_unshuffle_forward", &pixel_unshuffle_forward,
+          "PixelUnshuffle forward (CUDA)",
+          py::arg("x"), py::arg("downscale_factor"));
+}
+
+REGISTER_BINDING(pixel_unshuffle, register_pixel_unshuffle);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,16 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, upscale_factor):
+        super().__init__()
+        self.pixel_unshuffle = nn.PixelUnshuffle(upscale_factor)
+
+    def forward(self, x):
+        return cuda_extension.pixel_unshuffle_forward(x, self.pixel_unshuffle.downscale_factor)
+
+    def debug_forward(self, x):
+        output = cuda_extension.pixel_unshuffle_forward(x, self.pixel_unshuffle.downscale_factor)
+        yield 'step_001', output
