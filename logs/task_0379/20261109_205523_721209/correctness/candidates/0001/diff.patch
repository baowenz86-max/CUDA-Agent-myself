--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,93 @@
+#include <cuda_runtime.h>
+#include <math.h>
+#include <stdio.h>
+
+// Kernel for custom_max_dim1: computes max over dimension 1.
+// Input x has shape [N, C, H, W], output has shape [N, H, W].
+// x_stride[0..3] are strides in elements for each dimension.
+// out is contiguous with strides [H*W, W, 1].
+__global__ void max_dim1_kernel(const float* __restrict__ x,
+                                float* __restrict__ out,
+                                int N, int C, int H, int W,
+                                long long x_stride0, long long x_stride1,
+                                long long x_stride2, long long x_stride3) {
+    long long total = (long long)N * H * W;
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+
+    for (; idx < total; idx += stride) {
+        int w = idx % W;
+        long long tmp = idx / W;
+        int h = tmp % H;
+        int n = tmp / H;
+
+        const float* base = x + (long long)n * x_stride0 + (long long)h * x_stride2 + (long long)w * x_stride3;
+        float max_val = -INFINITY;
+        for (int c = 0; c < C; ++c) {
+            float val = base[c * x_stride1];
+            if (val > max_val) max_val = val;
+        }
+        out[idx] = max_val;
+    }
+}
+
+// Kernel for custom_exp: element-wise expf.
+__global__ void exp_kernel(const float* __restrict__ x,
+                           float* __restrict__ out,
+                           long long numel,
+                           long long stride) {
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long grid_stride = (long long)blockDim.x * gridDim.x;
+    for (; idx < numel; idx += grid_stride) {
+        out[idx] = expf(x[idx * stride]);
+    }
+}
+
+// Launcher for custom_max_dim1.
+// x_data: pointer to input tensor data (float32)
+// out_data: pointer to output tensor data (float32), already allocated contiguous
+// N, C, H, W: dimensions
+// strides: array of 4 strides (in elements) for input tensor
+// stream: CUDA stream to launch kernel on
+extern "C" void custom_max_dim1_launcher(const float* x_data,
+                                         float* out_data,
+                                         int N, int C, int H, int W,
+                                         const long long* strides,
+                                         cudaStream_t stream) {
+    long long total = (long long)N * H * W;
+    const int threads = 256;
+    long long blocks_ll = (total + threads - 1) / threads;
+    int blocks = (blocks_ll > 2147483647LL) ? 2147483647 : (int)blocks_ll;
+
+    max_dim1_kernel<<<blocks, threads, 0, stream>>>(
+        x_data, out_data, N, C, H, W,
+        strides[0], strides[1], strides[2], strides[3]);
+
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        fprintf(stderr, "custom_max_dim1 kernel launch failed: %s\n", cudaGetErrorString(err));
+    }
+}
+
+// Launcher for custom_exp.
+// x_data: pointer to input tensor data (float32)
+// out_data: pointer to output tensor data (float32), already allocated with same shape as input
+// numel: number of elements
+// stride: stride in elements between consecutive elements in x (for non-contiguous, may be >1; for contiguous, =1)
+// stream: CUDA stream
+extern "C" void custom_exp_launcher(const float* x_data,
+                                    float* out_data,
+                                    long long numel,
+                                    long long stride,
+                                    cudaStream_t stream) {
+    const int threads = 256;
+    long long blocks_ll = (numel + threads - 1) / threads;
+    int blocks = (blocks_ll > 2147483647LL) ? 2147483647 : (int)blocks_ll;
+
+    exp_kernel<<<blocks, threads, 0, stream>>>(x_data, out_data, numel, stride);
+
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        fprintf(stderr, "custom_exp kernel launch failed: %s\n", cudaGetErrorString(err));
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,99 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include <vector>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void custom_max_dim1_launcher(const float* x_data,
+                                          float* out_data,
+                                          int N, int C, int H, int W,
+                                          const long long* strides,
+                                          cudaStream_t stream);
+
+extern "C" void custom_exp_launcher(const float* x_data,
+                                     float* out_data,
+                                     long long numel,
+                                     long long stride,
+                                     cudaStream_t stream);
+
+// Wrapper for custom_max_dim1
+// Input: x (torch.Tensor) with shape [N, C, H, W] (float32, CUDA)
+// Output: torch.Tensor with shape [N, H, W] (float32, CUDA, contiguous)
+torch::Tensor custom_max_dim1(torch::Tensor x) {
+    // Check tensor properties
+    TORCH_CHECK(x.is_cuda(), "custom_max_dim1: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "custom_max_dim1: input must be float32");
+    TORCH_CHECK(x.dim() == 4, "custom_max_dim1: input must be 4D (N,C,H,W)");
+
+    // Make input contiguous for simple stride calculation.
+    // The launcher accepts arbitrary strides, but we'll use contiguous layout.
+    x = x.contiguous();
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+
+    // Allocate output tensor of shape [N, H, W]
+    auto out = torch::empty({N, H, W}, x.options());
+
+    // Compute strides for contiguous input: element strides in each dimension
+    // layout: [N, C, H, W] contiguous => strides: [C*H*W, H*W, W, 1]
+    long long strides[4];
+    strides[0] = (long long)C * H * W;
+    strides[1] = (long long)H * W;
+    strides[2] = (long long)W;
+    strides[3] = 1;
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    custom_max_dim1_launcher(
+        x.data_ptr<float>(),
+        out.data_ptr<float>(),
+        N, C, H, W,
+        strides,
+        stream
+    );
+
+    return out;
+}
+
+// Wrapper for custom_exp
+// Input: x (torch.Tensor) arbitrary shape (float32, CUDA)
+// Output: torch.Tensor same shape, exp applied elementwise
+torch::Tensor custom_exp(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "custom_exp: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "custom_exp: input must be float32");
+
+    // Make contiguous for simple stride=1
+    x = x.contiguous();
+    long long numel = x.numel();
+    long long stride = 1; // contiguous, so elements are consecutive
+
+    auto out = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_exp_launcher(
+        x.data_ptr<float>(),
+        out.data_ptr<float>(),
+        numel,
+        stride,
+        stream
+    );
+
+    return out;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_max_dim1", &custom_max_dim1, "Custom max over dimension 1", py::arg("x"));
+    m.def("custom_exp", &custom_exp, "Custom elementwise exp", py::arg("x"));
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,20 @@
+import torch
+import torch.nn as nn
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_features):
+        super().__init__()
+        self.in_features = in_features
+
+    def forward(self, x):
+        x = torch.ops.cuda_extension.custom_max_dim1(x)
+        x = torch.ops.cuda_extension.custom_exp(x)
+        return x
+
+    def debug_forward(self, x):
+        x = torch.ops.cuda_extension.custom_max_dim1(x)
+        yield 'step_001', x
+        x = torch.ops.cuda_extension.custom_exp(x)
+        yield 'step_002', x
+        yield 'step_003', x
