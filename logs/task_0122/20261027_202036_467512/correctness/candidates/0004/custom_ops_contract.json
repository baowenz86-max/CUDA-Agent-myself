{
  "operators": [
    {
      "name": "linear_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, in_features]",
          "layout": "contiguous",
          "optional": false,
          "nullable": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_features, in_features]",
          "layout": "contiguous",
          "optional": false,
          "nullable": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_features]",
          "layout": "contiguous",
          "optional": true,
          "nullable": true,
          "default": null
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, out_features]"
      },
      "semantics": [
        "Computes Y = input @ weight.T + bias if bias is not None, else input @ weight.T",
        "bias is broadcast along rows; no activation",
        "Uses cuDNN for GEMM/conv per requirements",
        "Input/weight must be CUDA float32 contiguous; output same dtype/device as input"
      ]
    },
    {
      "name": "adaptive_log_softmax_log_prob",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, input_size]",
          "layout": "contiguous",
          "optional": false,
          "nullable": false
        },
        {
          "name": "head_weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[head_size, input_size]",
          "layout": "contiguous",
          "optional": false,
          "nullable": false
        },
        {
          "name": "tail0_w1",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[reduce_size0, input_size]",
          "layout": "contiguous",
          "optional": false,
          "nullable": false
        },
        {
          "name": "tail0_w2",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[cluster_size0, reduce_size0]",
          "layout": "contiguous",
          "optional": false,
          "nullable": false
        },
        {
          "name": "tail1_w1",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[reduce_size1, input_size]",
          "layout": "contiguous",
          "optional": false,
          "nullable": false
        },
        {
          "name": "tail1_w2",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[cluster_size1, reduce_size1]",
          "layout": "contiguous",
          "optional": false,
          "nullable": false
        },
        {
          "name": "cutoffs",
          "kind": "int",
          "optional": false
        },
        {
          "name": "div_value",
          "kind": "float",
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, n_classes]"
      },
      "semantics": [
        "Computes adaptive log-softmax log probabilities as in torch.nn.AdaptiveLogSoftmaxWithLoss.log_prob",
        "head_logits = input @ head_weight.T (linear_forward with bias=None); head_logprobs = log_softmax(head_logits, dim=1)",
        "For each tail i: reduced = input @ tail_i_w1.T; tail_logits = reduced @ tail_i_w2.T; effective_logits = cat([head_logits[:, shortlist_size:cutoffs[i]], tail_logits * div_value], dim=1); tail_logprobs = log_softmax(effective_logits, dim=1)",
        "Output = cat([head_logprobs[:, :shortlist_size], tail0_logprobs, tail1_logprobs], dim=1)",
        "All reductions are along dim=1; stable numerical behavior required; no target conditioning in this op",
        "Expects the same parameter values as the constructed module; caller must pass correct weights and hyperparameters"
      ]
    },
    {
      "name": "topk",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, n_classes]",
          "layout": "contiguous",
          "optional": false,
          "nullable": false
        },
        {
          "name": "k",
          "kind": "int",
          "optional": false
        }
      ],
      "returns": {
        "type": "return_types_topk",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "values [batch_size, k] (float32), indices [batch_size, k] (int64)"
      },
      "semantics": [
        "Performs torch.topk(input, k, dim=1) exactly: largest k values along each row",
        "Returns topk values and indices with stable ordering as in torch.topk: input order for ties (as per PyTorch reference)",
        "The return is a torch.return_types.topk container built in Python from the two tensors using torch.return_types.topk((values, indices)); no torch computational ops used",
        "Both output tensors are CUDA: values float32, indices int64"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "log_probs = self.adaptive_log_softmax.log_prob(x)",
      "semantics": [
        "x: [2048,768] CPU input moved to CUDA by harness; log_probs obtained via adaptive_log_softmax_log_prob custom op",
        "log_probs shape [2048,10000], dtype float32, device cuda:0"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "topk_values, topk_indices = torch.topk(log_probs, k)",
      "semantics": [
        "Calls custom topk op on log_probs with k=5, dim=1",
        "Returns topk_values [2048,5] float32 CUDA and topk_indices [2048,5] int64 CUDA"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return (topk_values, topk_indices)",
      "semantics": [
        "Returns tuple of the two topk tensors, exactly matching reference output structure"
      ]
    }
  ]
}