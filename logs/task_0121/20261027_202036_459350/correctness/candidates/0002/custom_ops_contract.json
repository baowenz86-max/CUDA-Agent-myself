{
  "operators": [
    {
      "name": "custom_pad1d_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, C, H, W]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "padding_left",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "padding_right",
          "kind": "int",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[B, C, H, W + padding_left + padding_right]"
      },
      "semantics": [
        "对应参考语句 x = self.padding(x)，即 ConstantPad1d 在最后一维两侧补零，padding_left 为左补零数，padding_right 为右补零数。",
        "输入为 CUDA float32 连续张量，输出为 CUDA float32 连续张量，形状按 W 扩展，其他维度不变。",
        "不改变数值，仅复制输入并填充零。"
      ]
    },
    {
      "name": "custom_conv_transpose2d_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, C_in, H_in, W_in]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C_in, C_out, kH, kW]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C_out]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "stride",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "output_padding",
          "kind": "int",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[B, C_out, H_out, W_out]"
      },
      "semantics": [
        "对应参考语句 x = self.conv_transpose(x)，使用 ConvTranspose2d 权重和偏置。",
        "输入根据前面的 padding 操作得到，步长 stride 在两个空间维度相同，output_padding 在两个空间维度相同。",
        "采用 cuDNN 实现，保持与参考相同的数值语义，包括 bias、stride、padding 等。",
        "输出形状根据 ConvTranspose2d 公式确定。"
      ]
    },
    {
      "name": "custom_add_bias_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, C, H, W]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C, 1, 1]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[B, C, H, W]"
      },
      "semantics": [
        "对应参考语句 x = x + self.bias，bias 形状为 [C,1,1]，广播到整个空间维度。",
        "按通道维度加上 bias，输出与输入同 shape，dtype float32，device cuda。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.padding(x)",
      "semantics": [
        "对输入 x 在最后一维进行 ConstantPad1d 填充，左 padding 2，右 padding 3，填充值为 0。",
        "输入 shape [512,3,32,32]，输出 shape [512,3,32,37]。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.conv_transpose(x)",
      "semantics": [
        "使用 ConvTranspose2d，权重 shape [3,64,3,3]，bias shape [64]，stride=2，output_padding=1。",
        "输入 shape [512,3,32,37]，输出 shape [512,64,66,76]。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = x + self.bias",
      "semantics": [
        "加上形状为 [64,1,1] 的可训练 bias，广播到每个通道的空间位置。",
        "输入输出 shape [512,64,66,76]。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return x",
      "semantics": [
        "返回最终输出张量，shape [512,64,66,76]，dtype float32，device cuda:0。"
      ]
    }
  ]
}