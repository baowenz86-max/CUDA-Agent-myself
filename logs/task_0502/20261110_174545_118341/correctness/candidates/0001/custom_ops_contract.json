      },
      "semantics": [
        "执行 2D 矩阵乘法: y = x @ y，等价于 torch.matmul(x, y)。",
        "输入为 float32 CUDA 张量，形状分别为 [2048, 1024] 和 [1024, 2048]。",
        "输出形状 [2048, 2048]，与参考一致。",
        "若输入非连续，应先将其连续化，但输出始终为连续布局。",
        "实现使用 cuBLAS GEMM，假设行优先存储，通过转置参数处理。"
      ]
    },
    {
      "name": "softmax_dim0",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[2048, 2048]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[2048, 2048]"
      },
      "semantics": [
        "沿 dim=0 计算 softmax，即对每一列独立做 softmax。",
        "输入输出形状 [2048, 2048]，float32 CUDA 张量。",
        "数值稳定：先减每列最大值，再 exp、求和、归一化。",
        "输出与输入具有相同形状，但保证连续布局。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "z = torch.matmul(x, y)",
      "semantics": [
        "z = x 与 y 的矩阵乘积，输入 [2048, 1024] 和 [1024, 2048]，输出 [2048, 2048]，float32。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "z = torch.softmax(z, dim=0)",
      "semantics": [
        "对 z 沿第 0 维 (列方向) 做 softmax，形状不变。"
      ]
    },
    {
      "checkpoint": "step_003",
