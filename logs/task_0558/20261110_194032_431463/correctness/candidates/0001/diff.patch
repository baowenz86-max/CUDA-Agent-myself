--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,34 @@
+#include <cuda_runtime.h>
+
+// Hardsigmoid: clamp(x/6 + 0.5, 0, 1)
+__global__ void hardsigmoid_kernel(const float* __restrict__ input,
+                                  float* __restrict__ output,
+                                  int64_t numel) {
+    int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    int64_t stride = static_cast<int64_t>(blockDim.x) * gridDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        float x = input[i];
+        float y = x / 6.0f + 0.5f;
+        y = fminf(fmaxf(y, 0.0f), 1.0f);
+        output[i] = y;
+    }
+}
+
+// C-interface launcher. All pointers are raw CUDA device pointers; stream is provided by binding.
+extern "C" void hardsigmoid_forward_launcher(const float* input,
+                                              float* output,
+                                              int64_t numel,
+                                              cudaStream_t stream) {
+    if (numel <= 0) return;
+    const int block_size = 256;
+    int64_t grid_size = (numel + block_size - 1) / block_size;
+    if (grid_size > 2147483647) {
+        grid_size = 2147483647; // maximum grid dimension in x
+    }
+    hardsigmoid_kernel<<<(unsigned int)grid_size, block_size, 0, stream>>>(input, output, numel);
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // The launcher has no way to return an error code; assume caller checks stream.
+        // We still record the error so that subsequent cudaStreamSynchronize can catch it.
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,38 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Launcher declaration from custom_ops.cu
+extern "C" void hardsigmoid_forward_launcher(const float* input,
+                                              float* output,
+                                              int64_t numel,
+                                              cudaStream_t stream);
+
+torch::Tensor hardsigmoid_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+
+    auto output = torch::empty_like(x);
+    int64_t numel = x.numel();
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    hardsigmoid_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        numel,
+        stream
+    );
+
+    return output;
+}
+
+void register_hardsigmoid(pybind11::module& m) {
+    m.def("hardsigmoid_forward", &hardsigmoid_forward, "Hardsigmoid forward",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(hardsigmoid, register_hardsigmoid);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,15 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return cuda_extension.hardsigmoid_forward(x.cuda())
+
+    def debug_forward(self, x: torch.Tensor):
+        out = cuda_extension.hardsigmoid_forward(x.cuda())
+        yield 'step_001', out
