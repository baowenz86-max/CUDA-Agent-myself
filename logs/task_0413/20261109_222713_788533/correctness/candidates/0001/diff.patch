+// custom_ops.cu - CUDA kernels and launchers for max_dim_reduce and sync_bn_inference
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// -----------------------------------------------------------------------------
+// max_dim_reduce: reduces over dimension 1 (channels) with keepdim=True.
+// Input: x (float32), shape [N, C, H, W] contiguous
+// Output: values (float32) shape [N, 1, H, W], indices (int64) shape [N, 1, H, W]
+// dim is expected to be 1 (hardcoded due to contract), keepdim true.
+// -----------------------------------------------------------------------------
+
+__global__ void max_reduce_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ values,
+    int64_t* __restrict__ indices,
+    int N, int C, int H, int W)
+{
+    int total_spatial = N * H * W;  // number of output elements (N*1*H*W)
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+
+    for (int pos = idx; pos < total_spatial; pos += stride) {
+        // Decode pos into n, h, w
+        int n = pos / (H * W);
+        int rem = pos % (H * W);
+        int h = rem / W;
+        int w = rem % W;
+
+        // Input base pointer for this n: x + n*C*H*W
+        const float* base = x + (size_t)n * C * H * W;
+        int c_offset = h * W + w;
+
+        float max_val = base[c_offset];
+        int max_idx = 0;
+        for (int c = 1; c < C; ++c) {
+            float val = base[c * H * W + c_offset];
+            if (val > max_val) {
+                max_val = val;
+                max_idx = c;
+            }
+        }
+        values[pos] = max_val;
+        indices[pos] = (int64_t)max_idx;
+    }
+}
+
+extern "C" void max_dim_reduce_launcher(
+    const float* x,
+    float* values,
+    int64_t* indices,
+    int64_t dim,
+    bool keepdim,
+    int N, int C, int H, int W,
+    cudaStream_t stream)
+{
+    // We only support dim=1 and keepdim=true per contract; other cases are not used.
+    // For safety, if dim != 1 or keepdim != true, we do nothing (should not happen).
+    if (dim != 1 || !keepdim || N <= 0 || C <= 0 || H <= 0 || W <= 0) {
+        return;
+    }
+
+    int total_spatial = N * H * W;
+    int threads = 256;
+    int blocks = (total_spatial + threads - 1) / threads;
+    // Cap blocks to avoid excessive grid size? But total_spatial = 512*64*64 = 2,097,152, blocks = 8192.
+    // That's fine (max grid dimension 2^31-1).
+    max_reduce_kernel<<<blocks, threads, 0, stream>>>(
+        x, values, indices, N, C, H, W);
+}
+
+// -----------------------------------------------------------------------------
+// sync_bn_inference: applies BatchNorm inference using running statistics.
+// Input: x (float32), shape [N, C, H, W] contiguous
+// weight, bias, running_mean, running_var: float32 arrays of size C
+// eps: double
+// Output: y (float32) same shape as x
+// -----------------------------------------------------------------------------
+
+__global__ void bn_inference_kernel(
+    const float* __restrict__ x,
+    const float* __restrict__ weight,
+    const float* __restrict__ bias,
+    const float* __restrict__ running_mean,
+    const float* __restrict__ running_var,
+    float* __restrict__ y,
+    int N, int C, int H, int W,
+    double eps)
+{
+    int total_elements = N * C * H * W;
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+
+    for (int i = idx; i < total_elements; i += stride) {
+        // Determine channel index
+        int c = (i / (H * W)) % C;
+        float scale = weight[c] / sqrtf((float)(running_var[c] + eps));
+        float shift = bias[c] - running_mean[c] * scale;
+        y[i] = x[i] * scale + shift;
+    }
+}
+
+extern "C" void sync_bn_inference_launcher(
+    const float* x,
+    const float* weight,
+    const float* bias,
+    const float* running_mean,
+    const float* running_var,
+    double eps,
+    float* y,
+    int N, int C, int H, int W,
+    cudaStream_t stream)
+{
+    if (N <= 0 || C <= 0 || H <= 0 || W <= 0) {
+        return;
+    }
+
+    int total_elements = N * C * H * W;
+    int threads = 256;
+    int blocks = (total_elements + threads - 1) / threads;
+    // total_elements = 512*32*64*64 = 67,108,864 -> blocks = 262,144
+    // That's fine for modern GPUs.
+    bn_inference_kernel<<<blocks, threads, 0, stream>>>(
+        x, weight, bias, running_mean, running_var, y, N, C, H, W, eps);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,142 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void max_dim_reduce_launcher(
+    const float* x,
+    float* values,
+    int64_t* indices,
+    int64_t dim,
+    bool keepdim,
+    int N, int C, int H, int W,
+    cudaStream_t stream);
+
+extern "C" void sync_bn_inference_launcher(
+    const float* x,
+    const float* weight,
+    const float* bias,
+    const float* running_mean,
+    const float* running_var,
+    double eps,
+    float* y,
+    int N, int C, int H, int W,
+    cudaStream_t stream);
+
+torch::Tensor sync_bn_inference(
+    torch::Tensor x,
+    torch::Tensor weight,
+    torch::Tensor bias,
+    torch::Tensor running_mean,
+    torch::Tensor running_var,
+    double eps) {
+    // Check device
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(weight.is_cuda(), "weight must be a CUDA tensor");
+    TORCH_CHECK(bias.is_cuda(), "bias must be a CUDA tensor");
+    TORCH_CHECK(running_mean.is_cuda(), "running_mean must be a CUDA tensor");
+    TORCH_CHECK(running_var.is_cuda(), "running_var must be a CUDA tensor");
+
+    // Check dtype
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(weight.dtype() == torch::kFloat32, "weight must be float32");
+    TORCH_CHECK(bias.dtype() == torch::kFloat32, "bias must be float32");
+    TORCH_CHECK(running_mean.dtype() == torch::kFloat32, "running_mean must be float32");
+    TORCH_CHECK(running_var.dtype() == torch::kFloat32, "running_var must be float32");
+
+    // Check contiguity
+    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
+    TORCH_CHECK(weight.is_contiguous(), "weight must be contiguous");
+    TORCH_CHECK(bias.is_contiguous(), "bias must be contiguous");
+    TORCH_CHECK(running_mean.is_contiguous(), "running_mean must be contiguous");
+    TORCH_CHECK(running_var.is_contiguous(), "running_var must be contiguous");
+
+    // Check dimensions and sizes
+    TORCH_CHECK(x.dim() == 4, "x must be 4D (N,C,H,W)");
+    TORCH_CHECK(weight.dim() == 1, "weight must be 1D");
+    TORCH_CHECK(bias.dim() == 1, "bias must be 1D");
+    TORCH_CHECK(running_mean.dim() == 1, "running_mean must be 1D");
+    TORCH_CHECK(running_var.dim() == 1, "running_var must be 1D");
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+
+    TORCH_CHECK(weight.size(0) == C, "weight size must match C");
+    TORCH_CHECK(bias.size(0) == C, "bias size must match C");
+    TORCH_CHECK(running_mean.size(0) == C, "running_mean size must match C");
+    TORCH_CHECK(running_var.size(0) == C, "running_var size must match C");
+
+    auto y = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    sync_bn_inference_launcher(
+        x.data_ptr<float>(),
+        weight.data_ptr<float>(),
+        bias.data_ptr<float>(),
+        running_mean.data_ptr<float>(),
+        running_var.data_ptr<float>(),
+        eps,
+        y.data_ptr<float>(),
+        N, C, H, W,
+        stream);
+
+    return y;
+}
+
+std::tuple<torch::Tensor, torch::Tensor> max_dim_reduce(
+    torch::Tensor x,
+    int64_t dim,
+    bool keepdim) {
+    // Check device
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+
+    // Check dtype
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+
+    // Check contiguity
+    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
+
+    // Check dimensions
+    TORCH_CHECK(x.dim() == 4, "x must be 4D (N,C,H,W)");
+
+    TORCH_CHECK(dim == 1, "dim must be 1");
+    TORCH_CHECK(keepdim == true, "keepdim must be true");
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+
+    auto values = torch::empty({N, 1, H, W}, x.options());
+    auto indices = torch::empty({N, 1, H, W}, x.options().dtype(torch::kInt64));
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    max_dim_reduce_launcher(
+        x.data_ptr<float>(),
+        values.data_ptr<float>(),
+        indices.data_ptr<int64_t>(),
+        dim,
+        keepdim,
+        N, C, H, W,
+        stream);
+
+    return {values, indices};
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("max_dim_reduce", &max_dim_reduce,
+          "Max reduction over dim=1 with keepdim=True. Returns (values, indices)",
+          py::arg("x"), py::arg("dim"), py::arg("keepdim"));
+    m.def("sync_bn_inference", &sync_bn_inference,
+          "SyncBatchNorm inference using running statistics",
+          py::arg("x"), py::arg("weight"), py::arg("bias"),
+          py::arg("running_mean"), py::arg("running_var"), py::arg("eps"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,35 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, num_features, eps=1e-5, momentum=0.1, affine=True, track_running_stats=True):
+        super().__init__()
+        self.sync_bn = nn.SyncBatchNorm(num_features, eps, momentum, affine, track_running_stats)
+
+    def forward(self, x):
+        x_max, _ = cuda_extension.max_dim_reduce(x, dim=1, keepdim=True)
+        x = cuda_extension.sync_bn_inference(
+            x,
+            self.sync_bn.weight,
+            self.sync_bn.bias,
+            self.sync_bn.running_mean,
+            self.sync_bn.running_var,
+            self.sync_bn.eps,
+        )
+        return x, x_max
+
+    def debug_forward(self, x):
+        x_max, indices = cuda_extension.max_dim_reduce(x, dim=1, keepdim=True)
+        yield "step_001", (x_max, indices)
+        x = cuda_extension.sync_bn_inference(
+            x,
+            self.sync_bn.weight,
+            self.sync_bn.bias,
+            self.sync_bn.running_mean,
+            self.sync_bn.running_var,
+            self.sync_bn.eps,
+        )
+        yield "step_002", x
+        yield "step_003", (x, x_max)
