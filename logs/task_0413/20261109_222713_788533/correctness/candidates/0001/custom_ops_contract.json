      "semantics": [
        "Maps to torch.max(x, dim=1, keepdim=True); returns (values, indices) tuple.",
        "Reduction is over channel dimension C=32, producing shape [N,1,H,W].",
        "indices are int64 and contain the argmax along dim=1 for each spatial location.",
        "No additional broadcasting; input must be contiguous."
      ]
    },
    {
      "name": "sync_bn_inference",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W] with N=512, C=32, H=64, W=64",
