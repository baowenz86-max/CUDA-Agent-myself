{
  "operators": [
    {
      "name": "batch_norm2d_inference",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "some as reference step",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[num_features]",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[num_features]",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[num_features]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[num_features]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "dtype": "not applicable",
          "device": "not applicable",
          "shape": "not applicable",
          "layout": "not applicable",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "对应参考语句 x = self.batch_norm(x)，在 eval 模式下执行 BatchNorm2d: y = (x - running_mean) / sqrt(running_var + eps) * weight + bias",
        "若 weight 或 bias 为 None，则分别省略对应乘法或加法",
        "广播轴为通道维 (dim=1)，各通道独立计算",
        "返回与输入 x 形状相同的张量"
      ]
    },
    {
      "name": "clamp_min",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference step",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "min_val",
          "kind": "float",
          "dtype": "not applicable",
          "device": "not applicable",
          "shape": "not applicable",
          "layout": "not applicable",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "对应参考语句 torch.clamp(x, min=0.1)",
        "逐元素计算 max(x, min_val)",
        "返回与输入 x 形状相同的张量"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.batch_norm(x)",
      "semantics": [
        "BatchNorm2d eval 模式：y = (x - running_mean) / sqrt(running_var + eps) * weight + bias，通道维广播"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.clamp(x, min=0.1)",
      "semantics": [
        "逐元素 clamp 下限，min=0.1"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回最终张量，形状 [512,16,64,64]"
      ]
    }
  ]
}