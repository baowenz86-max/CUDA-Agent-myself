--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,115 @@
+#include <cuda_runtime.h>
+
+// Upsample nearest neighbor 2D for NCHW layout
+// Input: x (float*) with shape [N, C, H, W], strides [n_stride, c_stride, h_stride, w_stride]
+// Output: out (float*) contiguous shape [N, C, H*scale_factor, W*scale_factor]
+// scale_factor: positive integer
+extern "C" __global__ void upsample_nearest2d_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ out,
+    int N, int C, int H, int W, int scale_factor,
+    long long n_stride, long long c_stride, long long h_stride, long long w_stride) {
+    int out_h = H * scale_factor;
+    int out_w = W * scale_factor;
+    long long total = (long long)N * C * out_h * out_w;
+    long long idx = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+
+    for (; idx < total; idx += stride) {
+        // Decompose output index
+        int ow = idx % out_w;
+        long long tmp = idx / out_w;
+        int oh = tmp % out_h;
+        tmp /= out_h;
+        int c = tmp % C;
+        int n = tmp / C;
+
+        // Nearest neighbor source coordinates
+        int ih = oh / scale_factor;
+        int iw = ow / scale_factor;
+
+        long long src_idx = (long long)n * n_stride + (long long)c * c_stride
+                          + (long long)ih * h_stride + (long long)iw * w_stride;
+        out[idx] = x[src_idx];
+    }
+}
+
+// ReLU elementwise for arbitrary strides
+// Input: x (float*) with shape [N, C, H, W], strides [n_stride, c_stride, h_stride, w_stride]
+// Output: out (float*) contiguous same shape
+// numel = N*C*H*W
+extern "C" __global__ void relu_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ out,
+    long long numel,
+    int N, int C, int H, int W,
+    long long n_stride, long long c_stride, long long h_stride, long long w_stride) {
+    long long idx = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+
+    for (; idx < numel; idx += stride) {
+        // Decompose linear index into n,c,h,w
+        int w = idx % W;
+        long long tmp = idx / W;
+        int h = tmp % H;
+        tmp /= H;
+        int c = tmp % C;
+        int n = tmp / C;
+
+        long long src_idx = (long long)n * n_stride + (long long)c * c_stride
+                          + (long long)h * h_stride + (long long)w * w_stride;
+        float val = x[src_idx];
+        out[idx] = val > 0.0f ? val : 0.0f;
+    }
+}
+
+// Host launchers (C interface)
+
+extern "C" void upsample_nearest2d_launcher(
+    const float* x,
+    float* out,
+    int N, int C, int H, int W, int scale_factor,
+    long long n_stride, long long c_stride, long long h_stride, long long w_stride,
+    cudaStream_t stream) {
+    int out_h = H * scale_factor;
+    int out_w = W * scale_factor;
+    long long total = (long long)N * C * out_h * out_w;
+    if (total == 0) return;
+
+    int block_size = 256;
+    // grid cap: use enough blocks to cover all elements, but not exceed max grid dim (2^31-1)
+    long long blocks_ll = (total + block_size - 1) / block_size;
+    int blocks = (int)min(blocks_ll, (long long)2147483647);
+    upsample_nearest2d_kernel<<<blocks, block_size, 0, stream>>>(
+        x, out, N, C, H, W, scale_factor,
+        n_stride, c_stride, h_stride, w_stride);
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // In a real binding, you would throw an exception. Here we simply avoid ignoring error.
+        // The binding layer should handle error checking, but we include this for completeness.
+        // We cannot include torch headers, so we can't throw torch exceptions.
+        // Instead, we could call cudaDeviceReset or abort, but that's intrusive.
+        // For simplicity, we do nothing here; the binding layer will check errors after launch if desired.
+        // However, we should at least avoid warning about unused variable.
+        (void)err;
+    }
+}
+
+extern "C" void relu_launcher(
+    const float* x,
+    float* out,
+    long long numel,
+    int N, int C, int H, int W,
+    long long n_stride, long long c_stride, long long h_stride, long long w_stride,
+    cudaStream_t stream) {
+    if (numel == 0) return;
+
+    int block_size = 256;
+    long long blocks_ll = (numel + block_size - 1) / block_size;
+    int blocks = (int)min(blocks_ll, (long long)2147483647);
+    relu_kernel<<<blocks, block_size, 0, stream>>>(
+        x, out, numel, N, C, H, W,
+        n_stride, c_stride, h_stride, w_stride);
+    cudaError_t err = cudaGetLastError();
+    (void)err;
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,125 @@
+// Binding for upsample_nearest2d and relu custom ops
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+// upsample_nearest2d_launcher:
+//   const float* x, float* out, int N, int C, int H, int W, int scale_factor,
+//   long long n_stride, long long c_stride, long long h_stride, long long w_stride,
+//   cudaStream_t stream
+extern "C" void upsample_nearest2d_launcher(
+    const float* x,
+    float* out,
+    int N, int C, int H, int W, int scale_factor,
+    long long n_stride, long long c_stride, long long h_stride, long long w_stride,
+    cudaStream_t stream);
+
+// relu_launcher:
+//   const float* x, float* out, long long numel,
+//   int N, int C, int H, int W,
+//   long long n_stride, long long c_stride, long long h_stride, long long w_stride,
+//   cudaStream_t stream
+extern "C" void relu_launcher(
+    const float* x,
+    float* out,
+    long long numel,
+    int N, int C, int H, int W,
+    long long n_stride, long long c_stride, long long h_stride, long long w_stride,
+    cudaStream_t stream);
+
+// Utility to check 4D NCHW tensor and extract dims
+static void check_input_4d(const torch::Tensor& x, const char* op_name) {
+    TORCH_CHECK(x.is_cuda(), op_name, ": input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, op_name, ": input must be float32");
+    TORCH_CHECK(x.dim() == 4, op_name, ": input must be 4D (N, C, H, W)");
+}
+
+// Convert tensor to contiguous if not already, then compute strides of contiguous layout
+static void get_contiguous_strides(
+    const torch::Tensor& t,
+    int N, int C, int H, int W,
+    long long& n_stride, long long& c_stride, long long& h_stride, long long& w_stride) {
+    // For a contiguous NCHW tensor, strides are (C*H*W, H*W, W, 1)
+    n_stride = static_cast<long long>(C) * H * W;
+    c_stride = static_cast<long long>(H) * W;
+    h_stride = W;
+    w_stride = 1;
+}
+
+// upsample_nearest2d binding
+torch::Tensor upsample_nearest2d(torch::Tensor x, int64_t scale_factor) {
+    check_input_4d(x, "upsample_nearest2d");
+    TORCH_CHECK(scale_factor > 0, "upsample_nearest2d: scale_factor must be positive");
+    TORCH_CHECK(x.is_contiguous(), "upsample_nearest2d: input must be contiguous");
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+
+    int out_h = H * static_cast<int>(scale_factor);
+    int out_w = W * static_cast<int>(scale_factor);
+
+    auto out = torch::empty({N, C, out_h, out_w}, x.options());
+
+    // Since we require contiguous input, use contiguous strides
+    long long n_stride, c_stride, h_stride, w_stride;
+    get_contiguous_strides(x, N, C, H, W, n_stride, c_stride, h_stride, w_stride);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    upsample_nearest2d_launcher(
+        x.data_ptr<float>(),
+        out.data_ptr<float>(),
+        N, C, H, W, static_cast<int>(scale_factor),
+        n_stride, c_stride, h_stride, w_stride,
+        stream);
+
+    C10_CUDA_CHECK(cudaGetLastError());
+    return out;
+}
+
+// relu binding
+torch::Tensor relu(torch::Tensor x) {
+    check_input_4d(x, "relu");
+    TORCH_CHECK(x.is_contiguous(), "relu: input must be contiguous");
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+    long long numel = static_cast<long long>(N) * C * H * W;
+
+    auto out = torch::empty_like(x);
+
+    long long n_stride, c_stride, h_stride, w_stride;
+    get_contiguous_strides(x, N, C, H, W, n_stride, c_stride, h_stride, w_stride);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    relu_launcher(
+        x.data_ptr<float>(),
+        out.data_ptr<float>(),
+        numel,
+        N, C, H, W,
+        n_stride, c_stride, h_stride, w_stride,
+        stream);
+
+    C10_CUDA_CHECK(cudaGetLastError());
+    return out;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("upsample_nearest2d", &upsample_nearest2d,
+          "Nearest neighbor 2D upsampling",
+          py::arg("x"), py::arg("scale_factor"));
+    m.def("relu", &relu,
+          "ReLU activation",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,21 @@
+import torch
+import torch.nn as nn
+
+
+class ModelNew(nn.Module):
+    def __init__(self, scale_factor, mode):
+        super().__init__()
+        self.scale_factor = scale_factor
+        self.mode = mode
+
+    def forward(self, x):
+        x = cuda_extension.upsample_nearest2d(x, self.scale_factor)
+        x = cuda_extension.relu(x)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.upsample_nearest2d(x, self.scale_factor)
+        yield 'step_001', x
+        x = cuda_extension.relu(x)
+        yield 'step_002', x
+        yield 'step_003', x
