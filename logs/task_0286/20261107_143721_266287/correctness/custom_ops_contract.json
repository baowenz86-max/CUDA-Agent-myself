{
  "operators": [
    {
      "name": "upsample_nearest2d",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "scale_factor",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C, H*scale_factor, W*scale_factor]"
      },
      "semantics": [
        "对应 F.upsample_nearest(x, scale_factor=self.scale_factor)，最近邻上采样，输出尺寸为输入尺寸的 scale_factor 倍。",
        "输入为 CUDA float32 NCHW 张量，允许任意 stride；输出为连续 CUDA float32 张量。",
        "不进行插值，直接复制对应像素值。",
        "scale_factor 为正整数。"
      ]
    },
    {
      "name": "relu",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as input",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对应 F.relu(x)，逐元素计算 max(x, 0)。",
        "输入为 CUDA float32 张量，允许任意 stride；输出为连续 CUDA float32 张量。",
        "保持 shape 和 dtype 不变。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = F.upsample_nearest(x, scale_factor=self.scale_factor)",
      "semantics": [
        "最近邻上采样，scale_factor=2，输入 [512,3,256,256] float32 CPU，输出 [512,3,512,512] float32 CUDA。",
        "输出张量连续，stride [786432,262144,512,1]。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = F.relu(x)",
      "semantics": [
        "对 upsample 输出逐元素 ReLU，shape 不变为 [512,3,512,512]，dtype float32 CUDA。",
        "输出与输入 shape/dtype/device 相同，stride 保持连续。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回 ReLU 结果，shape [512,3,512,512] float32 CUDA。"
      ]
    }
  ]
