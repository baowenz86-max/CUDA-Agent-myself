{
  "operators": [
    {
      "name": "adaptive_log_softmax",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, in_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "head_weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[head_size, in_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "tail_weight0",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[tail_hidden_size, in_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "tail_weight1",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[tail_size, tail_hidden_size]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "cutoffs",
          "kind": "int",
          "dtype": "N/A",
          "device": "N/A",
          "shape": "list of ints",
          "layout": "N/A",
          "nullable": false,
          "optional": false
        },
        {
          "name": "div_value",
          "kind": "float",
          "dtype": "N/A",
          "device": "N/A",
          "shape": "scalar",
          "layout": "N/A",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, n_classes]"
      },
      "semantics": [
        "Computes log-probabilities of AdaptiveLogSoftmaxWithLoss.log_prob.",
        "For each input x_i, compute head linear output: y_head = head_weight @ x_i^T (no bias).",
        "Apply log_softmax over head output.",
        "Truncate to head_size = cutoffs[0] + 1.",
        "For classes beyond cutoffs[0], compute tail: h = tail_weight0 @ x_i^T; h = ReLU(h); y_tail = tail_weight1 @ h^T; log_softmax over tail_size.",
        "Scale tail log-probs by div_value (default 4.0) and append to head part.",
        "Return concatenated log-probs of shape [batch_size, n_classes]."
      ]
    },
    {
      "name": "custom_softmax",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, n_classes]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "dtype": "N/A",
          "device": "N/A",
          "shape": "scalar",
          "layout": "N/A",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, n_classes]"
      },
      "semantics": [
        "Applies softmax over the specified dimension dim (here -1).",
        "For each row, compute exp(x_i - max) and normalize by sum."
      ]
    },
    {
      "name": "custom_clone",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, n_classes]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, n_classes]"
      },
      "semantics": [
        "Returns a copy of the input tensor with same data, shape, dtype, device."
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "log_probs = self.adaptive_log_softmax.log_prob(x)",
      "semantics": [
        "Computes AdaptiveLogSoftmaxWithLoss log-probabilities for input x.",
        "Shape [2048, 10000] float32 on CUDA.",
        "Uses head and tail linear layers with no bias, followed by log_softmax and concatenation."
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "softmax_output = torch.softmax(log_probs, dim=-1)",
      "semantics": [
        "Applies softmax along last dimension of log_probs.",
        "Shape [2048, 10000] float32 on CUDA."
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "cloned_output = torch.clone(softmax_output)",
      "semantics": [
        "Creates a clone of softmax_output.",
        "Shape [2048, 10000] float32 on CUDA."
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return (cloned_output, log_probs, target)",
      "semantics": [
        "Returns tuple of cloned_output, log_probs, target.",
        "Shapes: [2048,10000], [2048,10000], [2048] on CUDA."
      ]
    }
  ]
}