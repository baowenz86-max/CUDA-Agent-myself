height = 128
width = 512  # Increased width to increase computation


def get_inputs():
    # Generate random tensor (batch_size, input_size, height, width)
    x = torch.randn(batch_size, *[3, height, width])
    return [x]


def get_init_inputs():
    return [3]  # Assuming input_size is hardcoded to 3

