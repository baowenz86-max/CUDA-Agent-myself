xing::Slice(), torch::indexing::Slice(), w});\n        // Construct max object\n        pybind11::object max_obj = max_type(values_w, indices_w);\n        result.append(max_obj);\n    }\n    return result;\n}\n\nvoid register_custom_unbind_max(pybind11::module& m) {\n    m.def(\"custom_unbind_max\", &custom_unbind_max, \"Compute max along C for each (B,H,W) and return list of max tuples\");\n}\n\nREGISTER_BINDING(custom_unbind_max, register_custom_unbind_max);\n"
