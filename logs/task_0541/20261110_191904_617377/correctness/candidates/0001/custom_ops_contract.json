{
  "operators": [
    {
      "name": "custom_batchnorm2d_eval",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "device": "",
          "shape": "",
          "layout": "",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "Computes eval-mode BatchNorm2d: y = (x - running_mean) / sqrt(running_var + eps) * weight + bias per channel",
        "Input shape [N, C, H, W]; normalization is per channel over N,H,W",
        "Matches torch.nn.BatchNorm2d.forward in eval mode with track_running_stats=True",
        "No training statistics update"
      ]
    },
    {
      "name": "custom_gelu_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as bn output",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "Computes GELU activation: x * 0.5 * (1 + erf(x / sqrt(2)))",
        "Matches torch.nn.GELU with approximate='none'"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.bn(x)",
      "semantics": [
        "BatchNorm2d in eval mode: per-channel affine transformation using running statistics",
        "Output dtype float32, shape [N, C, H, W], device cuda"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.gelu(x)",
      "semantics": [
        "GELU activation function applied elementwise",
        "Output dtype float32, shape [N, C, H, W], device cuda"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "Returns the final tensor from GELU step"
      ]
    }
  ]
}