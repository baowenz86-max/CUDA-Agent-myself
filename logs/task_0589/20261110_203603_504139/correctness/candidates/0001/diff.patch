@@ -0,0 +1,103 @@
+// kernels/custom_ops.cu
+// CUDA kernels for custom_tril, custom_elu, custom_add_bias
+// All launchers take raw pointers and cudaStream_t; no torch/ATen/c10 dependencies.
+
+#include <cuda_runtime.h>
+#include <math.h>
+
+// ------------------------- custom_tril -------------------------
+// Applies torch.tril to a 4D tensor with shape [B, C, H, W].
+// Zeroes elements where j > i in the last two dimensions.
+// Input is assumed contiguous; flattened index = ((b*C + c)*H + i)*W + j
+__global__ void tril_kernel(const float* __restrict__ input,
+                            float* __restrict__ output,
+                            int B, int C, int H, int W,
+                            long long total_elements) {
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (; idx < total_elements; idx += stride) {
+        // Decompose flattened index
+        int j = idx % W;
+        long long tmp = idx / W;
+        int i = tmp % H;
+        tmp /= H;
+        // c = tmp % C; b = tmp / C (unused)
+        // We only need i and j
+        if (j <= i) {
+            output[idx] = input[idx];
+        } else {
+            output[idx] = 0.0f;
+        }
+    }
+}
+
+extern "C" void custom_tril_launcher(const float* input,
+                                     float* output,
+                                     int B, int C, int H, int W,
+                                     long long total_elements,
+                                     cudaStream_t stream) {
+    const int threads = 256;
+    long long blocks_ll = (total_elements + threads - 1) / threads;
+    // Cap blocks to max grid dimension (2^31-1) and use grid-stride loop
+    int blocks = (blocks_ll > 2147483647LL) ? 2147483647 : (int)blocks_ll;
+    tril_kernel<<<blocks, threads, 0, stream>>>(input, output, B, C, H, W, total_elements);
+}
+
+// ------------------------- custom_elu -------------------------
+// Applies ELU with alpha=1.0 elementwise: output = x if x > 0 else exp(x)-1
+__global__ void elu_kernel(const float* __restrict__ input,
+                           float* __restrict__ output,
+                           long long total_elements) {
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (; idx < total_elements; idx += stride) {
+        float val = input[idx];
+        output[idx] = (val > 0.0f) ? val : expf(val) - 1.0f;
+    }
+}
+
+extern "C" void custom_elu_launcher(const float* input,
+                                    float* output,
+                                    long long total_elements,
+                                    cudaStream_t stream) {
+    const int threads = 256;
+    long long blocks_ll = (total_elements + threads - 1) / threads;
+    int blocks = (blocks_ll > 2147483647LL) ? 2147483647 : (int)blocks_ll;
+    elu_kernel<<<blocks, threads, 0, stream>>>(input, output, total_elements);
+}
+
+// ------------------------- custom_add_bias -------------------------
+// Adds bias[c] to each element in channel c. bias has shape [C,1,1].
+// input shape [B, C, H, W]; output same shape.
+// For each element (b,c,i,j): output = input + bias[c]
+__global__ void add_bias_kernel(const float* __restrict__ input,
+                                const float* __restrict__ bias,
+                                float* __restrict__ output,
+                                int B, int C, int H, int W,
+                                long long total_elements) {
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (; idx < total_elements; idx += stride) {
+        // Decompose to get channel c
+        int j = idx % W;
+        long long tmp = idx / W;
+        int i = tmp % H;
+        tmp /= H;
+        int c = tmp % C;
+        // b = tmp / C;
+        float b = bias[c];  // bias is contiguous of length C
+        output[idx] = input[idx] + b;
+    }
+}
+
+extern "C" void custom_add_bias_launcher(const float* input,
+                                         const float* bias,
+                                         float* output,
+                                         int B, int C, int H, int W,
+                                         long long total_elements,
+                                         cudaStream_t stream) {
+    const int threads = 256;
+    long long blocks_ll = (total_elements + threads - 1) / threads;
+    int blocks = (blocks_ll > 2147483647LL) ? 2147483647 : (int)blocks_ll;
+    add_bias_kernel<<<blocks, threads, 0, stream>>>(input, bias, output, B, C, H, W, total_elements);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,113 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_runtime.h>
+#include "../binding_registry.h"
+
+// Declarations of CUDA launchers from custom_ops.cu
+extern "C" void custom_tril_launcher(const float* input, float* output,
+                                    int B, int C, int H, int W,
+                                    long long total_elements,
+                                    cudaStream_t stream);
+
+extern "C" void custom_elu_launcher(const float* input, float* output,
+                                    long long total_elements,
+                                    cudaStream_t stream);
+
+extern "C" void custom_add_bias_launcher(const float* input, const float* bias,
+                                         float* output,
+                                         int B, int C, int H, int W,
+                                         long long total_elements,
+                                         cudaStream_t stream);
+
+// ------------------------- custom_tril binding -------------------------
+torch::Tensor custom_tril(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "custom_tril: input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "custom_tril: input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "custom_tril: input must be float32");
+    TORCH_CHECK(x.dim() == 4, "custom_tril: input must be 4D");
+
+    const int B = x.size(0);
+    const int C = x.size(1);
+    const int H = x.size(2);
+    const int W = x.size(3);
+    const long long total_elements = x.numel();
+
+    auto output = torch::empty_like(x);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_tril_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        B, C, H, W,
+        total_elements,
+        stream
+    );
+
+    return output;
+}
+
+// ------------------------- custom_elu binding -------------------------
+torch::Tensor custom_elu(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "custom_elu: input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "custom_elu: input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "custom_elu: input must be float32");
+
+    const long long total_elements = x.numel();
+
+    auto output = torch::empty_like(x);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_elu_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        total_elements,
+        stream
+    );
+
+    return output;
+}
+
+// ------------------------- custom_add_bias binding -------------------------
+torch::Tensor custom_add_bias(torch::Tensor x, torch::Tensor bias) {
+    TORCH_CHECK(x.is_cuda(), "custom_add_bias: x must be a CUDA tensor");
+    TORCH_CHECK(bias.is_cuda(), "custom_add_bias: bias must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "custom_add_bias: x must be contiguous");
+    TORCH_CHECK(bias.is_contiguous(), "custom_add_bias: bias must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "custom_add_bias: x must be float32");
+    TORCH_CHECK(bias.dtype() == torch::kFloat32, "custom_add_bias: bias must be float32");
+    TORCH_CHECK(x.dim() == 4, "custom_add_bias: x must be 4D");
+    TORCH_CHECK(bias.dim() == 3, "custom_add_bias: bias must be 3D");
+    TORCH_CHECK(bias.size(0) == x.size(1), "custom_add_bias: bias first dim must match channel count");
+    TORCH_CHECK(bias.size(1) == 1 && bias.size(2) == 1, "custom_add_bias: bias spatial dims must be 1x1");
+
+    const int B = x.size(0);
+    const int C = x.size(1);
+    const int H = x.size(2);
+    const int W = x.size(3);
+    const long long total_elements = x.numel();
+
+    auto output = torch::empty_like(x);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_add_bias_launcher(
+        x.data_ptr<float>(),
+        bias.data_ptr<float>(),
+        output.data_ptr<float>(),
+        B, C, H, W,
+        total_elements,
+        stream
+    );
+
+    return output;
+}
+
+// ------------------------- Registration -------------------------
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_tril", &custom_tril, "Apply torch.tril to a 4D contiguous float32 tensor", py::arg("x"));
+    m.def("custom_elu", &custom_elu, "Apply ELU (alpha=1.0) elementwise", py::arg("x"));
+    m.def("custom_add_bias", &custom_add_bias, "Add broadcasted bias of shape [C,1,1]",
+          py::arg("x"), py::arg("bias"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,34 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_features, bias_shape):
+        super().__init__()
+        # weight parameter is present in reference but unused; keep for state_dict compatibility
+        self.weight = nn.Parameter(torch.randn(in_features, in_features))
+        self.bias = nn.Parameter(torch.randn(bias_shape))
+
+    def forward(self, x):
+        # Step 1: torch.tril(x)
+        x = cuda_extension.custom_tril(x)
+        # Step 2: F.elu(x)
+        x = cuda_extension.custom_elu(x)
+        # Step 3: x + self.bias
+        x = cuda_extension.custom_add_bias(x, self.bias)
+        return x
+
+    def debug_forward(self, x):
+        # Debug version yields each checkpoint value in order
+        # Step 1
+        x1 = cuda_extension.custom_tril(x)
+        yield 'step_001', x1
+        # Step 2
+        x2 = cuda_extension.custom_elu(x1)
+        yield 'step_002', x2
+        # Step 3
+        x3 = cuda_extension.custom_add_bias(x2, self.bias)
+        yield 'step_003', x3
+        # Step 4 (final return)
+        yield 'step_004', x3
