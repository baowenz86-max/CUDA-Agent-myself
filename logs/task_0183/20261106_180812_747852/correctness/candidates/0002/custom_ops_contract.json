        "device": "cuda",
        "shape": "[batch, channels, height + 2 * padding, width + 2 * padding]"
      },
      "semantics": [
        "对应参考语句 x = self.pad(x)，self.pad 为 nn.ReflectionPad2d(1)",
        "在最后两维进行反射填充，padding 为 1",
        "输出维度为 [batch, channels, height+2, width+2]",
        "填充值按照反射规则从输入边缘复制，不涉及其他计算",
        "返回新张量，输入不变"
      ]
    },
    {
      "name": "conv2d",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, in_channels, height, width]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels, in_channels, kernel_height, kernel_width]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels]",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        },
        {
          "name": "stride",
          "kind": "int",
          "optional": true,
          "default": 1,
          "nullable": false
        },
        {
          "name": "padding",
          "kind": "int",
          "optional": true,
          "default": 0,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, out_channels, output_height, output_width]"
      },
      "semantics": [
        "对应参考语句 x = self.conv(x)，self.conv 为 nn.Conv2d(3, 16, kernel_size=3, stride=1, padding=0, bias=True)",
        "使用 cuDNN 实现标准 2D 卷积，bias 为实际传入的 bias 张量，不能省略",
        "输出空间维度 = (输入维度 - kernel_size) / stride + 1，当前为 (130 - 3) / 1 + 1 = 128",
        "返回新张量，输入不变"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.pad(x)",
      "semantics": [
        "ReflectionPad2d(1) 在输入的最后两维各填充 1 个像素，使用反射模式复制边缘元素",
        "输入 shape [512, 3, 128, 128]，输出 shape [512, 3, 130, 130]",
        "dtype 为 float32，device 为 cuda:0"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.conv(x)",
      "semantics": [
