          "device": "cuda",
          "shape": "[batch, channels, height, width]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "padding",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
