--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,61 @@
+#include <cuda_runtime.h>
+#include <cmath>
+
+// 使用 erf 的 GELU 计算
+template <typename scalar_t>
+__device__ scalar_t gelu_erf(scalar_t x) {
+    return scalar_t(0.5) * x * (scalar_t(1) + erff(x * scalar_t(1.0) / scalar_t(sqrt(2.0))));
+}
+
+// 融合 embedding lookup 和 GELU
+// indices: int64_t* 形状 [batch, seq]，值是 [0, num_embeddings-1] 之间的索引
+// weight: float* 形状 [num_embeddings, embedding_dim]
+// output: float* 形状 [batch, seq, embedding_dim]
+// num_indices: batch * seq
+// embedding_dim: 每个 token 的嵌入维度
+__global__ void embedding_lookup_gelu_kernel_float(
+    const int64_t* __restrict__ indices,
+    const float* __restrict__ weight,
+    float* __restrict__ output,
+    int64_t num_indices,
+    int64_t embedding_dim
+) {
+    // 每个线程处理多个输出元素，使用 grid-stride loop
+    int64_t total_out = num_indices * embedding_dim;
+    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * (int64_t)gridDim.x;
+
+    for (int64_t out_idx = idx; out_idx < total_out; out_idx += stride) {
+        int64_t token_idx = out_idx / embedding_dim;
+        int64_t dim = out_idx % embedding_dim;
+        int64_t row = indices[token_idx]; // 可能越界，但由 binding 层检查
+        float val = weight[row * embedding_dim + dim];
+        output[out_idx] = gelu_erf(val);
+    }
+}
+
+// Launcher 函数，供 binding.cpp 调用
+extern "C" void embedding_lookup_gelu_launcher(
+    const int64_t* indices,
+    const float* weight,
+    float* output,
+    int64_t num_indices,
+    int64_t embedding_dim,
+    cudaStream_t stream
+) {
+    int threads = 256;
+    int64_t total_out = num_indices * embedding_dim;
+    int blocks = (int)((total_out + threads - 1) / threads);
+    // 限制最大 grid 尺寸避免过大
+    if (blocks > 1048576) blocks = 1048576;
+    if (blocks < 1) blocks = 1;
+
+    embedding_lookup_gelu_kernel_float<<<blocks, threads, 0, stream>>>(
+        indices, weight, output, num_indices, embedding_dim);
+
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // 只记录错误，不抛出，binding 层可能需要处理
+        // 实际 binding 层会检查 cudaGetLastError
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,73 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launcher from custom_ops.cu
+extern "C" void embedding_lookup_gelu_launcher(
+    const int64_t* indices,
+    const float* weight,
+    float* output,
+    int64_t num_indices,
+    int64_t embedding_dim,
+    cudaStream_t stream
+);
+
+// PyTorch binding wrapper
+torch::Tensor embedding_lookup_gelu(torch::Tensor indices, torch::Tensor weight) {
+    // Ensure indices and weight are on CUDA
+    TORCH_CHECK(indices.dtype() == torch::kInt64, "indices must be int64");
+    TORCH_CHECK(weight.dtype() == torch::kFloat32, "weight must be float32");
+    TORCH_CHECK(weight.is_cuda(), "weight must be on CUDA");
+
+    // Move indices to CUDA if needed
+    if (!indices.is_cuda()) {
+        indices = indices.to(torch::kCUDA);
+    }
+
+    TORCH_CHECK(indices.dim() == 2, "indices must be 2D");
+    int64_t batch_size = indices.size(0);
+    int64_t seq_len = indices.size(1);
+    int64_t num_indices = batch_size * seq_len;
+
+    TORCH_CHECK(weight.dim() == 2, "weight must be 2D");
+    int64_t num_embeddings = weight.size(0);
+    int64_t embedding_dim = weight.size(1);
+
+    // Optionally check indices range (debug only). Not necessary for performance.
+    // TORCH_CHECK(indices.min().item<int64_t>() >= 0 && indices.max().item<int64_t>() < num_embeddings,
+    //             "indices out of range");
+
+    // Allocate output tensor on CUDA
+    auto output = torch::empty({batch_size, seq_len, embedding_dim}, weight.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Launch kernel via launcher
+    embedding_lookup_gelu_launcher(
+        indices.data_ptr<int64_t>(),
+        weight.data_ptr<float>(),
+        output.data_ptr<float>(),
+        num_indices,
+        embedding_dim,
+        stream
+    );
+
+    // Check for CUDA errors after launch
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// Registration function
+void register_embedding_lookup_gelu(pybind11::module& m) {
+    m.def("embedding_lookup_gelu", &embedding_lookup_gelu,
+          "Fused embedding lookup followed by GELU activation",
+          py::arg("indices"), py::arg("weight"));
+}
+
+// Auto-register
+REGISTER_BINDING(embedding_lookup_gelu, register_embedding_lookup_gelu);
