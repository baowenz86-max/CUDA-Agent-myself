--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,47 @@
+#include <cuda_runtime.h>
+
+// Channel shuffle kernel: input shape (N, C, H, W), groups g.
+// Reshape to (N, g, C/g, H, W), transpose(1,2), reshape back to (N, C, H, W).
+// For output element (n, co, h, w):
+//   g_idx = co / (C/g);   // which group in output (0..g-1)
+//   c_in_group = co % (C/g); // channel within group
+//   ci = c_in_group * g + g_idx; // source channel index
+__global__ void channel_shuffle_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    int N, int C, int H, int W, int groups)
+{
+    int total = N * C * H * W;
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+    int channels_per_group = C / groups;
+    for (int pos = idx; pos < total; pos += stride) {
+        // decompose pos into (n, co, hw)
+        int hw = H * W;
+        int n = pos / (C * hw);
+        int rem = pos - n * C * hw;
+        int co = rem / hw;
+        int hw_idx = rem - co * hw;
+
+        int g_idx = co / channels_per_group;
+        int c_in_group = co - g_idx * channels_per_group;
+        int ci = c_in_group * groups + g_idx;
+
+        int src_pos = n * C * hw + ci * hw + hw_idx;
+        output[pos] = input[src_pos];
+    }
+}
+
+extern "C" void channel_shuffle_cuda_launcher(
+    float* output,
+    const float* input,
+    int N, int C, int H, int W, int groups,
+    cudaStream_t stream)
+{
+    int total = N * C * H * W;
+    const int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535; // grid stride loop handles rest
+    channel_shuffle_kernel<<<blocks, threads, 0, stream>>>(
+        output, input, N, C, H, W, groups);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,60 @@
+// Binding for channel_shuffle_cuda
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declaration of launcher from custom_ops.cu
+extern "C" void channel_shuffle_cuda_launcher(
+    float* output,
+    const float* input,
+    int N, int C, int H, int W, int groups,
+    cudaStream_t stream);
+
+namespace {
+
+inline void check_input(const torch::Tensor& x, int64_t groups, int64_t C) {
+    TORCH_CHECK(x.is_cuda(), "channel_shuffle_cuda: input must be a CUDA tensor");
+    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "channel_shuffle_cuda: input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "channel_shuffle_cuda: input must be contiguous");
+    TORCH_CHECK(x.dim() == 4, "channel_shuffle_cuda: input must be 4D (N,C,H,W)");
+    TORCH_CHECK(C % groups == 0, "channel_shuffle_cuda: number of channels must be divisible by groups");
+    TORCH_CHECK(groups > 0, "channel_shuffle_cuda: groups must be positive");
+}
+
+} // anonymous namespace
+
+torch::Tensor channel_shuffle_cuda(torch::Tensor x, int64_t groups) {
+    auto N = x.size(0);
+    auto C = x.size(1);
+    auto H = x.size(2);
+    auto W = x.size(3);
+
+    check_input(x, groups, C);
+
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    channel_shuffle_cuda_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        static_cast<int>(N),
+        static_cast<int>(C),
+        static_cast<int>(H),
+        static_cast<int>(W),
+        static_cast<int>(groups),
+        stream
+    );
+
+    return output;
+}
+
+void register_channel_shuffle_cuda(pybind11::module& m) {
+    m.def("channel_shuffle_cuda", &channel_shuffle_cuda,
+          "Channel shuffle operation on CUDA",
+          pybind11::arg("x"), pybind11::arg("groups"));
+}
+
+REGISTER_BINDING(channel_shuffle_cuda, register_channel_shuffle_cuda);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,17 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, num_channels, groups):
+        super().__init__()
+        self.groups = groups
+
+    def forward(self, x):
+        return cuda_extension.channel_shuffle_cuda(x, self.groups)
+
+    def debug_forward(self, x):
+        out = cuda_extension.channel_shuffle_cuda(x, self.groups)
+        yield 'step_001', out
+        yield 'step_002', out
