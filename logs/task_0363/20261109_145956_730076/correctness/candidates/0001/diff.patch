--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,79 @@
+#include <cuda_runtime.h>
+
+__global__ void pixel_unshuffle_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int N,
+    int C,
+    int H,
+    int W,
+    int upscale_factor,
+    int64_t in_n_stride,
+    int64_t in_c_stride,
+    int64_t in_h_stride,
+    int64_t in_w_stride,
+    int64_t total_elements
+) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t grid_size = blockDim.x * gridDim.x;
+    for (int64_t linear = idx; linear < total_elements; linear += grid_size) {
+        // output is contiguous in N, C_out, H_out, W_out order
+        // output shape: [N, C_out, H_out, W_out], C_out = C * upscale_factor * upscale_factor
+        // Compute coordinates from linear index
+        int w_out = linear % (W / upscale_factor);
+        int h_out = (linear / (W / upscale_factor)) % (H / upscale_factor);
+        int c_out = (linear / ((H / upscale_factor) * (W / upscale_factor))) % (C * upscale_factor * upscale_factor);
+        int n = linear / ((C * upscale_factor * upscale_factor) * (H / upscale_factor) * (W / upscale_factor));
+
+        int c_in = c_out % C;
+        int rem = c_out / C;
+        int dy = rem / upscale_factor;
+        int dx = rem % upscale_factor;
+        int h_in = h_out * upscale_factor + dy;
+        int w_in = w_out * upscale_factor + dx;
+
+        int64_t input_index = n * in_n_stride + c_in * in_c_stride + h_in * in_h_stride + w_in * in_w_stride;
+        output[linear] = input[input_index];
+    }
+}
+
+extern "C" void pixel_unshuffle_launcher(
+    const float* input,
+    float* output,
+    int N,
+    int C,
+    int H,
+    int W,
+    int upscale_factor,
+    int64_t in_n_stride,
+    int64_t in_c_stride,
+    int64_t in_h_stride,
+    int64_t in_w_stride,
+    cudaStream_t stream
+) {
+    int C_out = C * upscale_factor * upscale_factor;
+    int H_out = H / upscale_factor;
+    int W_out = W / upscale_factor;
+    int64_t total_elements = (int64_t)N * C_out * H_out * W_out;
+
+    const int block_size = 256;
+    int grid_size = (int)((total_elements + block_size - 1) / block_size);
+    // Cap grid to avoid exceeding max grid dimension; grid-stride loop handles remainder
+    if (grid_size > 65535) grid_size = 65535;
+    if (grid_size < 1) grid_size = 1;
+
+    pixel_unshuffle_kernel<<<grid_size, block_size, 0, stream>>>(
+        input,
+        output,
+        N,
+        C,
+        H,
+        W,
+        upscale_factor,
+        in_n_stride,
+        in_c_stride,
+        in_h_stride,
+        in_w_stride,
+        total_elements
+    );
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,80 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launcher from custom_ops.cu
+extern "C" void pixel_unshuffle_launcher(
+    const float* input,
+    float* output,
+    int N,
+    int C,
+    int H,
+    int W,
+    int upscale_factor,
+    int64_t in_n_stride,
+    int64_t in_c_stride,
+    int64_t in_h_stride,
+    int64_t in_w_stride,
+    cudaStream_t stream
+);
+
+torch::Tensor pixel_unshuffle_forward(torch::Tensor x, int64_t upscale_factor) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(upscale_factor > 0, "upscale_factor must be positive");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D (N, C, H, W)");
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+    TORCH_CHECK(H % upscale_factor == 0 && W % upscale_factor == 0,
+                "H and W must be divisible by upscale_factor");
+
+    int H_out = H / upscale_factor;
+    int W_out = W / upscale_factor;
+    int C_out = C * upscale_factor * upscale_factor;
+
+    auto output = torch::empty({N, C_out, H_out, W_out}, x.options());
+
+    // Get strides (int64_t)
+    int64_t in_n_stride = x.stride(0);
+    int64_t in_c_stride = x.stride(1);
+    int64_t in_h_stride = x.stride(2);
+    int64_t in_w_stride = x.stride(3);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    pixel_unshuffle_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N,
+        C,
+        H,
+        W,
+        static_cast<int>(upscale_factor),
+        in_n_stride,
+        in_c_stride,
+        in_h_stride,
+        in_w_stride,
+        stream
+    );
+
+    // Check for kernel launch errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+void register_pixel_unshuffle(pybind11::module& m) {
+    m.def("pixel_unshuffle_forward", &pixel_unshuffle_forward,
+          "Pixel unshuffle forward",
+          pybind11::arg("x"),
+          pybind11::arg("upscale_factor"));
+}
+
+REGISTER_BINDING(pixel_unshuffle, register_pixel_unshuffle);
