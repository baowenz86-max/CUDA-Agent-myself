import torch
import torch.nn as nn
import cuda_extension


class Model(nn.Module):
    def __init__(self, in_channels, out_channels, kernel_size, padding, bias_shape):
        super().__init__()
        # Store parameters for later use, but avoid creating original nn.Conv2d to prevent
        # unwanted torch ops in forward. We still need to initialize conv weight for state_dict
        # compatibility. However, original model initialized conv via nn.Conv2d, which includes
        # weight and bias. We need to replicate that exact state_dict structure and initialization.
        # We create a dummy nn.Conv2d just to get its parameters, but we will not use it in forward.
        # Since nn.Conv2d creation is allowed (it's not a torch operation in forward), we can do this
        # in __init__. In forward we will only use our custom op.
        self.conv = nn.Conv2d(in_channels, out_channels, kernel_size)  # param initialization
        self.bias = nn.Parameter(torch.randn(bias_shape))
        self.padding = padding
        self.kernel_size = kernel_size

    def forward(self, x):
        # Combine pad + rotate + conv + mask inf fill 0 + add bias into single custom op.
        # We define a custom fused operator 'fused_pad_rotate_conv_maskinf_addbias'.
        # Inputs: x (input tensor), conv_weight (from self.conv.weight), conv_bias (from self.conv.bias),
        #         add_bias (self.bias), padding (tuple), kernel_size (int).
        # The custom op must handle:
        #   - Constant padding with padding value padding[0] (same for all sides as in original)
        #   - Rotate 90 degrees clockwise: equivalent to transposing last two dims and flipping horizontally,
        #     i.e., out[b, c, i, j] = in[b, c, j, W-1-i] after padding.
        #   - Conv2d with given weight and bias (conv_bias is separate from add_bias)
        #   - Replace all positive/negative infinity values with 0.0 (masked fill with 0)
        #   - Add add_bias with broadcasting (add_bias shape: (out_channels,1,1))
        # Return: output tensor with shape (N, out_channels, H_out, W_out)
        return cuda_extension.fused_pad_rotate_conv_maskinf_addbias(
            x, self.conv.weight, self.conv.bias, self.bias,
            self.padding, self.kernel_size
        )


