===== 现有 CUDA/C++ kernel 文件 =====

===== kernels/fused_pad_rotate_conv_maskinf_addbias.cu =====
#include <cuda_runtime.h>
#include <cstdint>

__global__ void fused_pad_rotate_conv_maskinf_addbias_kernel(
    const float* __restrict__ input,
    const float* __restrict__ weight,
    const float* __restrict__ conv_bias,
    const float* __restrict__ add_bias,
    float* __restrict__ output,
    int N,
    int C,
    int H,
    int W,
    int K,
    int R,
    int S,
    int pad_top,
    int pad_bottom,
    int pad_left,
    int pad_right,
    int outH,
    int outW,
    float pad_value
) {
    int bx = blockIdx.x;
    int by = blockIdx.y;
    int bz = blockIdx.z;
    int tx = threadIdx.x;
    int ty = threadIdx.y;

    int n = bz / K;
    int k = bz % K;

    int ow = bx * blockDim.x + tx;
    int oh = by * blockDim.y + ty;

    if (ow >= outW || oh >= outH) {
        return;
    }

    float sum = 0.0f;

    extern __shared__ float smem[];

    int ow_start = bx * blockDim.x;
    int ow_end = min(ow_start + blockDim.x - 1, outW - 1);
    int oh_start = by * blockDim.y;
    int oh_end = min(oh_start + blockDim.y - 1, outH - 1);

    int W_pad = W + pad_left + pad_right;
    int H_pad = H + pad_top + pad_bottom;

    int w_pad_min = ow_start;
    int w_pad_max = ow_end + S - 1;
    if (w_pad_max > W_pad - 1) w_pad_max = W_pad - 1;
    if (w_pad_min > W_pad - 1) w_pad_min = W_pad - 1;

    int h_pad_max = H_pad - 1 - oh_start;
    int h_pad_min = H_pad - 1 - (oh_end + R - 1);
    if (h_pad_max > H_pad - 1) h_pad_max = H_pad - 1;
    if (h_pad_min < 0) h_pad_min = 0;
    if (h_pad_min > H_pad - 1) h_pad_min = H_pad - 1;
    if (h_pad_max < 0) h_pad_max = 0;

    int tile_h = h_pad_max - h_pad_min + 1;
    int tile_w = w_pad_max - w_pad_min + 1;

    int max_tile_h = blockDim.y + R - 1;
    int max_tile_w = blockDim.x + S - 1;
    int smem_stride = max_tile_w;
    int smem_plane = max_tile_h * max_tile_w;

    int total_load = C * tile_h * tile_w;
    int tid = ty * blockDim.x + tx;
    int nthreads = blockDim.x * blockDim.y;

    for (int idx = tid; idx < total_load; idx += nthreads) {
        int c = idx / (tile_h * tile_w);
        int rem = idx % (tile_h * tile_w);
        int local_h = rem / tile_w;
        int local_w = rem % tile_w;
        int h_idx = h_pad_min + local_h;
        int w_idx = w_pad_min + local_w;

        float val;
        if (h_idx < pad_top || h_idx >= pad_top + H || w_idx < pad_left || w_idx >= pad_left + W) {
            val = pad_value;
        } else {
            int h_in = h_idx - pad_top;
            int w_in = w_idx - pad_left;
            val = input[((n * C + c) * H + h_in) * W + w_in];
        }
        smem[c * smem_plane + local_h * smem_stride + local_w] = val;
    }

    __syncthreads();

    sum = 0.0f;
    for (int c = 0; c < C; ++c) {
        for (int r = 0; r < R; ++r) {
            int h_idx_rot = H_pad - 1 - (oh + r);
            int local_h = h_idx_rot - h_pad_min;
            for (int s = 0; s < S; ++s) {
                int w_idx_rot = ow + s;
                int local_w = w_idx_rot - w_pad_min;
                float input_val = smem[c * smem_plane + local_h * smem_stride + local_w];
                float w_val = weight[((k * C + c) * R + r) * S + s];
                sum += input_val * w_val;
            }
        }
    }

    sum += conv_bias[k];

    if (isinf(sum)) {
        sum = 0.0f;
    }

    sum += add_bias[k];

    output[((n * K + k) * outH + oh) * outW + ow] = sum;
}

extern "C" void fused_pad_rotate_conv_maskinf_addbias_launcher(
    const float* input,
    const float* weight,
    const float* conv_bias,
    const float* add_bias,
    float* output,
    int N,
    int C,
    int H,
    int W,
    int K,
    int R,
    int S,
    int pad_top,
    int pad_bottom,
    int pad_left,
    int pad_right,
    float pad_value,
    cudaStream_t stream
) {
    int outH = H + pad_top + pad_bottom - R + 1;
    int outW = W + pad_left + pad_right - S + 1;

    const int BLOCK_X = 16;
    const int BLOCK_Y = 16;
    dim3 block(BLOCK_X, BLOCK_Y);
    dim3 grid((outW + BLOCK_X - 1) / BLOCK_X,
              (outH + BLOCK_Y - 1) / BLOCK_Y,
              N * K);

    int max_tile_h = BLOCK_Y + R - 1;
    int max_tile_w = BLOCK_X + S - 1;
    size_t smem_size = (size_t)C * max_tile_h * max_tile_w * sizeof(float);

    fused_pad_rotate_conv_maskinf_addbias_kernel<<<grid, block, smem_size, stream>>>(
        input, weight, conv_bias, add_bias, output,
        N, C, H, W, K, R, S,
        pad_top, pad_bottom, pad_left, pad_right,
        outH, outW, pad_value
    );
}

===== kernels/fused_pad_rotate_conv_maskinf_addbias_binding.cpp =====
// Binding for fused_pad_rotate_conv_maskinf_addbias custom op
#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>
#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

// Declaration of the launcher function from .cu file
extern "C" void fused_pad_rotate_conv_maskinf_addbias_launcher(
    const float* input,
    const float* weight,
    const float* conv_bias,
    const float* add_bias,
    float* output,
    int N,
    int C,
    int H,
    int W,
    int K,
    int R,
    int S,
    int pad_top,
    int pad_bottom,
    int pad_left,
    int pad_right,
    float pad_value,
    cudaStream_t stream
);

// PyTorch wrapper function
at::Tensor fused_pad_rotate_conv_maskinf_addbias_forward(
    at::Tensor input,
    at::Tensor weight,
    at::Tensor conv_bias,
    at::Tensor add_bias,
    std::tuple<int, int> padding,
    int kernel_size
) {
    // Input validation
    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
    TORCH_CHECK(weight.is_cuda(), "weight must be a CUDA tensor");
    TORCH_CHECK(conv_bias.is_cuda(), "conv_bias must be a CUDA tensor");
    TORCH_CHECK(add_bias.is_cuda(), "add_bias must be a CUDA tensor");
    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
    TORCH_CHECK(weight.dtype() == torch::kFloat32, "weight must be float32");
    TORCH_CHECK(conv_bias.dtype() == torch::kFloat32, "conv_bias must be float32");
    TORCH_CHECK(add_bias.dtype() == torch::kFloat32, "add_bias must be float32");
    TORCH_CHECK(input.is_contiguous(), "input must be contiguous");
    TORCH_CHECK(weight.is_contiguous(), "weight must be contiguous");
    TORCH_CHECK(conv_bias.is_contiguous(), "conv_bias must be contiguous");
    TORCH_CHECK(add_bias.is_contiguous(), "add_bias must be contiguous");
    TORCH_CHECK(input.dim() == 4, "input must be 4D (N,C,H,W)");
    TORCH_CHECK(weight.dim() == 4, "weight must be 4D (K,C,R,S)");
    TORCH_CHECK(conv_bias.dim() == 1, "conv_bias must be 1D (K)");
    TORCH_CHECK(add_bias.dim() == 3 && add_bias.size(1) == 1 && add_bias.size(2) == 1, "add_bias must be 3D (K,1,1)");

    // Extract dimensions
    int N = input.size(0);
    int C = input.size(1);
    int H = input.size(2);
    int W = input.size(3);
    int K = weight.size(0);
    int R = kernel_size;
    int S = kernel_size;  // Assuming square kernel as in original model

    // Padding tuple: (pad_h, pad_w)
    int pad_h = std::get<0>(padding);
    int pad_w = std::get<1>(padding);

    // Check that weight dimensions match input channels and kernel size
    TORCH_CHECK(weight.size(1) == C, "weight input channels must match input tensor");
    TORCH_CHECK(weight.size(2) == R && weight.size(3) == S, "weight kernel size must match provided kernel_size");
    TORCH_CHECK(conv_bias.size(0) == K, "conv_bias size must match output channels");
    TORCH_CHECK(add_bias.size(0) == K, "add_bias size must match output channels");

    // Compute output spatial dimensions
    int outH = H + 2 * pad_h - R + 1;
