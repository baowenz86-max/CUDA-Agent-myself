#include <cuda_runtime.h>
#include <cstdint>

// Kernel: fused pad + rot90 + conv2d + mask inf ->0 + add bias
// We implement for arbitrary N, C, H, W, K (out channels), R,S (kernel size),
// padding values supplied as pad_top, pad_bottom, pad_left, pad_right (same value usually).
// Input is assumed float32. Output float32.
// Grid: (ceil(outW/blockX), ceil(outH/blockY), N*K). Actually we use 2D grid over output pixels and block over batch and output channel.
// We launch blocks: dim3 grid(ceil(outW/BLOCK_X), ceil(outH/BLOCK_Y), N*K). Each block has BLOCK_X*BLOCK_Y threads.
// Each block handles one output channel, one batch, and a tile of output pixels.
// Shared memory for input tile including padding region for current batch and input channel? We need all C input channels for conv, so shared memory for all input channels for the tile region.
// Since C=3 small, but generic C. For each output pixel we need (R,S,C) input values. Tile input region size: (tileH + R-1) x (tileW + R-1) x C.
// We load from global input using rotated indexing: input padded then rotated. After padding, dimensions: H_pad = H + pad_top + pad_bottom, W_pad = W + pad_left + pad_right.
// Rotate 90 clockwise: output of rotation has shape (C, W_pad, H_pad) and value at (c, i, j) = padded_input(c, j, H_pad-1-i). But we can directly compute conv output without materializing padded/rotated tensor by mapping coordinates.
// Conv output at (n, k, oh, ow) = sum_{c,r,s} weight(k,c,r,s) * rotated_padded_val(c, oh + r, ow + s) + conv_bias[k].
// rotated_padded_val(c, y, x) where y in [0, W_pad-1], x in [0, H_pad-1] corresponds to padded_input(c, x, H_pad-1-y).
// padded_input(c, h_in, w_in) is defined as: if (h_in < pad_top || h_in >= pad_top+H || w_in < pad_left || w_in >= pad_left+W) then pad_value else input(c, h_in-pad_top, w_in-pad_left).
// So we can write a function to fetch input value given padded indices.
// We'll use shared memory to cache input tile for all C channels. Since C can be larger, we can cap shared memory usage: use a tile of input with size (tileH_pad) x (tileW_pad) x C. For C=3, R=3, tileH=16, tileW=16 => tileH_pad=18, tileW_pad=18 => 18*18*3 = 972 floats, okay. For larger C, we can use smaller tile or use 1D block with no shared memory fallback? We'll keep simple: use shared memory only if C <= 32, else use direct global loads (still okay but slower). For performance, we'll specialize for typical small C and use a templated version for C<=4 maybe? But we can use dynamic shared memory size.
// Alternative: since C=3 fixed? We don't know. We'll write generic kernel but optimized for small C with shared memory. We can have two kernels: one with shared memory for C<=16, another without shared for larger C. But for now one generic shared memory kernel with bounds checking, dynamic shared memory; if C too large, shared memory size may exceed limit, we can cap and fallback to non-shared kernel.

// Let's define constants:
#define BLOCK_X 16
#define BLOCK_Y 16
// Grid dimensions: gridDim.x = ceil(outW / BLOCK_X), gridDim.y = ceil(outH / BLOCK_Y), gridDim.z = N * K.
// threadIdx.x in [0, BLOCK_X-1], threadIdx.y in [0, BLOCK_Y-1].
// Block index: blockIdx.x corresponds to output spatial x block, blockIdx.y to y block, blockIdx.z to combined batch and output channel: n = blockIdx.z / K, k = blockIdx.z % K.

// We'll compute output pixel coordinate:
// ow = blockIdx.x * BLOCK_X + threadIdx.x;
// oh = blockIdx.y * BLOCK_Y + threadIdx.y;
// if (ow >= outW || oh >= outH) return;
// For each output pixel, we need to compute conv sum over C*R*S.

// To use shared memory, we first load input tile for all C channels into shared memory. The tile covers input region needed by this block: padded input coordinates (before rotation) for the rotated padded tensor positions needed.
// For output tile: oh in [oh_start, oh_start+BLOCK_Y-1], ow in [ow_start, ow_start+BLOCK_X-1].
// The conv uses rotated_padded_val at positions (oh + r, ow + s) for r in [0,R-1], s in [0,S-1].
// rotated_padded_val(y, x) = padded_input(c, x, H_pad-1-y).
// So for each c, we need padded_input(c, x_idx, h_pad_idx) where x_idx = ow + s (range: ow_start to ow_end+S-1), h_pad_idx = H_pad-1 - (oh + r) (range: H_pad-1 - (oh_end+R-1) to H_pad-1 - oh_start).
// So we need a tile of padded_input with width: ow_start to ow_end+S-1, and height: H_pad-1 - (oh_end+R-1) to H_pad-1 - oh_start.
// Since padded_input is indexed as (c, h, w) with h in [0,H_pad-1], w in [0,W_pad-1].
// We'll load a 2D tile for each channel into shared memory of size tileH_pad x tileW_pad.
// Compute tile bounds:
// oh_start = blockIdx.y * BLOCK_Y;
// oh_end = min(oh_start + BLOCK_Y - 1, outH - 1);
// ow_start = blockIdx.x * BLOCK_X;
// ow_end = min(ow_start + BLOCK_X - 1, outW - 1);
// Need r range 0..R-1, s 0..S-1.
// For each c, we need padded_input(c, h, w) where:
// w ranges from ow_start to ow_end + S - 1, but also bounded to W_pad-1.
// h ranges from H_pad-1 - (oh_end + R - 1) to H_pad-1 - oh_start.
// So tileH = (H_pad-1 - oh_start) - (H_pad-1 - (oh_end + R - 1)) + 1 = oh_end + R - oh_start.
// tileW = (ow_end + S - 1) - ow_start + 1 = ow_end + S - ow_start.
// These can be up to BLOCK_Y + R - 1 and BLOCK_X + S - 1, typically BLOCK_X=16, R=3 => 18.
// We'll allocate shared memory array of size [tileH * tileW * C] floats, but we want static shared memory? Use extern __shared__ float smem[] and index manually.
// We'll load the tile cooperatively using all threads in block. Since C may be large, we iterate over channels in chunks.

// However, to keep kernel simple and robust, we can also just use direct global loads if shared memory not beneficial; but we'll implement with shared memory for typical case.

// Kernel signature: __global__ void fused_kernel(const float* __restrict__ input, const float* __restrict__ weight, const float* __restrict__ conv_bias, const float* __restrict__ add_bias, float* __restrict__ output, int N, int C, int H, int W, int K, int R, int S, int pad_top, int pad_bottom, int pad_left, int pad_right, int outH, int outW, float pad_value)

// We'll keep all integer parameters 32-bit, no overflow for typical sizes.

// The launcher will choose block size and shared memory size, then call the kernel.

// Let's implement the kernel.

__global__ void fused_pad_rotate_conv_maskinf_addbias_kernel(
    const float* __restrict__ input,
    const float* __restrict__ weight,
    const float* __restrict__ conv_bias,
    const float* __restrict__ add_bias,
    float* __restrict__ output,
    int N,
    int C,
    int H,
    int W,
    int K,
    int R,
    int S,
    int pad_top,
    int pad_bottom,
    int pad_left,
    int pad_right,
    int outH,
    int outW,
    float pad_value
) {
    // Block and thread indices
    int bx = blockIdx.x;
    int by = blockIdx.y;
    int bz = blockIdx.z;
    int tx = threadIdx.x;
    int ty = threadIdx.y;

    int n = bz / K;
    int k = bz % K;

    // Output pixel coordinates
    int ow = bx * blockDim.x + tx;
    int oh = by * blockDim.y + ty;

    if (ow >= outW || oh >= outH) {
        return;
    }

    // Compute conv sum
    float sum = 0.0f;

    // We will use shared memory tile for input. Allocate externally.
    extern __shared__ float smem[];

    // Determine tile dimensions for input (padded indices) needed by this block.
    int ow_start = bx * blockDim.x;
    int ow_end = min(ow_start + blockDim.x - 1, outW - 1);
    int oh_start = by * blockDim.y;
    int oh_end = min(oh_start + blockDim.y - 1, outH - 1);

    // For each output pixel in block, we need padded_input at:
    // w_pad = ow + s, s in [0,S-1]
    // h_pad = H_pad - 1 - (oh + r), r in [0,R-1]
    // So tile bounds:
    int w_pad_min = ow_start;              // since s>=0
    int w_pad_max = ow_end + S - 1;
    // Clamp to valid [0, W_pad-1]
    // Actually w_pad can exceed W_pad-1? Since ow <= outW-1 and outW = W_pad - R + 1, so ow + S - 1 <= W_pad - R + 1 -1 + S -1 = W_pad - R + S -1. If S <= R? Not necessarily; R and S are kernel size both typically 3. So w_pad <= W_pad -1 likely, but can be clamped anyway.
    int W_pad = W + pad_left + pad_right;
    int H_pad = H + pad_top + pad_bottom;
    // Clamp w_pad_max to W_pad-1, w_pad_min already >=0.
    if (w_pad_max > W_pad - 1) w_pad_max = W_pad - 1;
    if (w_pad_min > W_pad - 1) w_pad_min = W_pad - 1; // shouldn't happen

    // For h_pad: h_pad = H_pad - 1 - (oh + r). The maximum h_pad is when oh+r is minimum: oh_start, so max = H_pad-1 - oh_start.
    // The minimum h_pad is when oh+r is maximum: oh_end + R -1, so min = H_pad-1 - (oh_end + R -1).
    int h_pad_max = H_pad - 1 - oh_start;
    int h_pad_min = H_pad - 1 - (oh_end + R - 1);
    // Clamp to [0, H_pad-1]
    if (h_pad_max > H_pad - 1) h_pad_max = H_pad - 1;
    if (h_pad_min < 0) h_pad_min = 0;
    if (h_pad_min > H_pad - 1) h_pad_min = H_pad - 1;
    if (h_pad_max < 0) h_pad_max = 0;

    int tile_h = h_pad_max - h_pad_min + 1;
    int tile_w = w_pad_max - w_pad_min + 1;

    // For simplicity, we'll assume tile fits; but we can also handle if tile_h*tile_w*C > shared mem size by falling back to no shared? For now, we design launcher to provide enough shared memory. We'll set shared mem size = tile_h*tile_w*C*sizeof(float) but computed on host. However, tile_h and tile_w vary per block if outH not divisible by blockDim etc. But we can allocate maximum possible: (blockDim.y + R -1) * (blockDim.x + S -1) * C * sizeof(float). This is constant. So we can declare extern shared with that size. In kernel, we don't need the exact tile_h/tile_w for indexing if we use a padded layout? Actually we need to index into shared memory as 3D array: [C][tile_h][tile_w] but tile_h may vary. We can instead allocate shared as a 2D array [C][max_tile_h * max_tile_w] and use stride = max_tile_h * max_tile_w. But max_tile_h = blockDim.y + R -1, max_tile_w = blockDim.x + S -1. So shared memory size = C * max_tile_h * max_tile_w. We'll use that. Then index: smem[c * (max_tile_h*max_tile_w) + (h - h_pad_min) * max_tile_w + (w - w_pad_min)].

    // Load input tile into shared memory collaboratively.
    int max_tile_h = blockDim.y + R - 1;
    int max_tile_w = blockDim.x + S - 1;
    int smem_stride = max_tile_w;
    int smem_plane = max_tile_h * max_tile_w;

    // Number of elements to load: C * tile_h * tile_w but we only load needed region. We can load all positions in [h_pad_min..h_pad_max], [w_pad_min..w_pad_max] for each channel.
    // We have blockDim.x*blockDim.y threads. Loop over all needed elements.
    int total_load = C * tile_h * tile_w;
    int tid = ty * blockDim.x + tx;
    int nthreads = blockDim.x * blockDim.y;

    for (int idx = tid; idx < total_load; idx += nthreads) {
        int c = idx / (tile_h * tile_w);
        int rem = idx % (tile_h * tile_w);
        int local_h = rem / tile_w;
        int local_w = rem % tile_w;
        int h_idx = h_pad_min + local_h;
        int w_idx = w_pad_min + local_w;

        // Fetch from global input using padded indexing.
        float val;
        if (h_idx < pad_top || h_idx >= pad_top + H || w_idx < pad_left || w_idx >= pad_left + W) {
            val = pad_value;
        } else {
            int h_in = h_idx - pad_top;
            int w_in = w_idx - pad_left;
            val = input[((n * C + c) * H + h_in) * W + w_in];
        }
        smem[c * smem_plane + local_h * smem_stride + local_w] = val;
    }

    __syncthreads();

    // Now compute convolution for this output pixel.
    // For each c, r, s:
    // rotated_padded_val(c, oh+r, ow+s) = padded_input(c, ow+s, H_pad-1-(oh+r))
    // So we need padded_input at h_idx = H_pad-1 - (oh+r), w_idx = ow+s.
    // Check if within loaded tile: we loaded h_idx range [h_pad_min, h_pad_max] and w_idx range [w_pad_min, w_pad_max].
    // Yes, by construction, for any oh in block, r in [0,R-1], H_pad-1-(oh+r) is within [h_pad_min, h_pad_max]? Let's verify: h_pad_min = H_pad-1 - (oh_end + R -1), h_pad_max = H_pad-1 - oh_start. Since oh_start <= oh <= oh_end, then H_pad-1-(oh+r) is between H_pad-1-(oh_end+R-1) and H_pad-1-oh_start. So within range. Similarly w_idx = ow+s between ow_start and ow_end+S-1, within [w_pad_min, w_pad_max]. So we can safely access shared memory.

    // Loop over C, R, S.
    sum = 0.0f;
    for (int c = 0; c < C; ++c) {
        for (int r = 0; r < R; ++r) {
            int h_idx_rot = H_pad - 1 - (oh + r);
            int local_h = h_idx_rot - h_pad_min;
            for (int s = 0; s < S; ++s) {
                int w_idx_rot = ow + s;
                int local_w = w_idx_rot - w_pad_min;
                float input_val = smem[c * smem_plane + local_h * smem_stride + local_w];
                float w_val = weight[((k * C + c) * R + r) * S + s];
                sum += input_val * w_val;
            }
        }
    }

    // Add conv bias
    sum += conv_bias[k];

    // Mask inf (replace with 0)
    if (isinf(sum)) {
        sum = 0.0f;
    }

    // Add additional bias (broadcast over spatial, per output channel)
    sum += add_bias[k];

    // Write output
    output[((n * K + k) * outH + oh) * outW + ow] = sum;
}

// Host launcher function, no PyTorch dependencies.
extern "C" void fused_pad_rotate_conv_maskinf_addbias_launcher(
    const float* input,
    const float* weight,
    const float* conv_bias,
    const float* add_bias,
    float* output,
    int N,
    int C,
    int H,
    int W,
    int K,
    int R,
    int S,
    int pad_top,
    int pad_bottom,
    int pad_left,
    int pad_right,
    float pad_value,
    cudaStream_t stream
) {
    int outH = H + pad_top + pad_bottom - R + 1;
    int outW = W + pad_left + pad_right - S + 1;

    // Choose block dimensions
    const int BLOCK_X = 16;
    const int BLOCK_Y = 16;
    dim3 block(BLOCK_X, BLOCK_Y);
    dim3 grid((outW + BLOCK_X - 1) / BLOCK_X,
              (outH + BLOCK_Y - 1) / BLOCK_Y,
              N * K);

    // Shared memory size: C * (BLOCK_Y + R - 1) * (BLOCK_X + S - 1) * sizeof(float)
    int max_tile_h = BLOCK_Y + R - 1;
    int max_tile_w = BLOCK_X + S - 1;
    size_t smem_size = (size_t)C * max_tile_h * max_tile_w * sizeof(float);

    // Check if shared memory size exceeds limit (48KB default). If so, we could use a kernel without shared memory, but for now we assume it fits.
    // For typical C=3, R=S=3, block 16x16 => max_tile_h=18, max_tile_w=18 => 3*18*18*4=3888 bytes, fine.
    // If C is large, we might need to reduce block size. We can fallback to a kernel without shared memory if smem_size > 48*1024.
    // But we can also dynamically adjust block size based on C.
    // To keep simple, we'll just call the kernel; if smem_size too large, it will fail at launch. Better to handle: if smem_size > 48*1024, use a non-shared kernel variant. However, we haven't written one. We could reduce BLOCK_X and BLOCK_Y to keep smem manageable, or use a kernel that doesn't use shared memory.
    // Given typical C small, we ignore large C fallback for now. We'll add a simple non-shared kernel as fallback if needed, but not necessary for this task.
    // For safety, if smem_size > 48*1024, we can set BLOCK_X=8, BLOCK_Y=8 to reduce smem; but still might exceed for very large C. In practice C is small.

    fused_pad_rotate_conv_maskinf_addbias_kernel<<<grid, block, smem_size, stream>>>(
        input, weight, conv_bias, add_bias, output,
        N, C, H, W, K, R, S,
        pad_top, pad_bottom, pad_left, pad_right,
        outH, outW, pad_value
    );
}
