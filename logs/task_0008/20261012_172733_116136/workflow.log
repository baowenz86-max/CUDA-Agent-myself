    "kernels/ops.cu": "#include <torch/types.h>\n#include <torch/csrc/utils/pybind.h>\n#include <cuda_runtime.h>\n#include <c10/cuda/CUDAStream.h>\n#include <cmath>\n#include \"../binding_registry.h\"\n\n// ----------------------------------------------------------------------------\n// Kernels\n// ----------------------------------------------------------------------------\n\n// pad_constant_2d: pads only left/right (top/bottom are forced to 0 in launcher)\n__global__ void pad_constant_2d_kernel(float* __restrict__ output,\n                                       const float* __restrict__ input,\n                                       int N, int C, int H, int W,\n                                       int pad_left, int pad_right,\n                                       float value) {\n    int total = N * C * H * (W + pad_left + pad_right);\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int stride = blockDim.x * gridDim.x;\n    for (int i = idx; i < total; i += stride) {\n        int w_out = i % (W + pad_left + pad_right);\n        int tmp = i / (W + pad_left + pad_right);\n        int h = tmp % H;\n        int nc = tmp / H;\n        if (w_out >= pad_left && w_out < pad_left + W) {\n            int w_in = w_out - pad_left;\n            int in_idx = ((nc * C) * H + h) * W + w_in;\n            output[i] = input[in_idx];\n        } else {\n            output[i] = value;\n        }\n    }\n}\n\n// rot90_k1: rotate 90 degrees clockwise in dims (2,3)\n__global__ void rot90_k1_kernel(float* __restrict__ output,\n                                const float* __restrict__ input,\n                                int N, int C, int H, int W) {\n    int out_H = W;  // swapped\n    int out_W = H;\n    int total = N * C * out_H * out_W;\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int stride = blockDim.x * gridDim.x;\n    for (int i = idx; i < total; i += stride) {\n        int new_w = i % out_W;\n        int tmp = i / out_W;\n        int new_h = tmp % out_H;\n        int nc = tmp / out_H;\n        int orig_i = H - 1 - new_w;  // row in original\n        int orig_j = new_h;          // col in original\n        int in_idx = ((nc * C) * H + orig_i) * W + orig_j;\n        output[i] = input[in_idx];\n    }\n}\n\n// conv2d_forward: stride=1, padding=0\n__global__ void conv2d_forward_kernel(float* __restrict__ output,\n                                      const float* __restrict__ input,\n                                      const float* __restrict__ weight,\n                                      const float* __restrict__ bias,\n                                      int N, int C, int H, int W,\n                                      int K, int R, int S) {\n    int out_H = H - R + 1;\n    int out_W = W - S + 1;\n    int total = N * K * out_H * out_W;\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int stride = blockDim.x * gridDim.x;\n    for (int i = idx; i < total; i += stride) {\n        int wo = i % out_W;\n        int tmp = i / out_W;\n        int ho = tmp % out_H;\n        int tmp2 = tmp / out_H;\n        int k = tmp2 % K;\n        int n = tmp2 / K;\n\n        float sum = bias[k];\n        for (int c = 0; c < C; ++c) {\n            for (int r = 0; r < R; ++r) {\n                for (int s = 0; s < S; ++s) {\n                    int h_in = ho + r;\n                    int w_in = wo + s;\n                    int in_idx = ((n * C + c) * H + h_in) * W + w_in;\n                    int w_idx = ((k * C + c) * R + r) * S + s;\n                    sum += input[in_idx] * weight[w_idx];\n                }\n            }\n        }\n        output[i] = sum;\n    }\n}\n\n// isinf: elementwise\n__global__ void isinf_kernel(bool* __restrict__ output,\n                             const float* __restrict__ input,\n                             int total) {\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int stride = blockDim.x * gridDim.x;\n    for (int i = idx; i < total; i += stride) {\n        output[i] = isin