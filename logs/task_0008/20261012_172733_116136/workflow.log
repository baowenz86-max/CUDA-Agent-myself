t, value);\n}\n\nvoid rot90_k1_launcher(float* output, const float* input,\n                       int N, int C, int H, int W,\n                       cudaStream_t stream) {\n    int out_H = W;\n    int out_W = H;\n    int total = N * C * out_H * out_W;\n    int threads = 256;\n    int blocks = (total + threads - 1) / threads;\n    rot90_k1_kernel<<<blocks, threads, 0, stream>>>(output, input, N, C, H, W);\n}\n\nvoid conv2d_forward_launcher(float* output, const float* input,\n                             const float* weight, const float* bias,\n                             int N, int C, int H, int W,\n                             int K, int R, int S,\n                             cudaStream_t stream) {\n    int out_H = H - R + 1;\n    int out_W = W - S + 1;\n    int total = N * K * out_H * out_W;\n    int threads = 256;\n    int blocks = (total + threads - 1) / threads;\n    conv2d_forward_kernel<<<blocks, threads, 0, stream>>>(\n        output, input, weight, bias, N, C, H, W, K, R, S);\n}\n\nvoid isinf_launcher(bool* output, const float* input, int total,\n                    cudaStream_t stream) {\n    int threads = 256;\n    int blocks = (total + threads - 1) / threads;\n    isinf_kernel<<<blocks, threads, 0, stream>>>(output, input, total);\n}\n\nvoid masked_fill_zero_launcher(float* output, const float* input,\n                               const bool* mask, int total,\n                               cudaStream_t stream) {\n    int threads = 256;\n    int blocks = (total + threads - 1) / threads;\n    masked_fill_zero_kernel<<<blocks, threads, 0, stream>>>(\n        output, input, mask, total);\n}\n\nvoid add_bias_launcher(float* output, const float* input, const float* bias,\n                       int N, int C, int H, int W,\n                       cudaStream_t stream) {\n    int total = N * C * H * W;\n    int threads = 256;\n    int blocks = (total + threads - 1) / threads;\n    add_bias_kernel<<<blocks, threads, 0, stream>>>(\n        output, input, bias