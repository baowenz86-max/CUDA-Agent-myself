    "model_new.py": "import torch\nimport torch.nn as nn\nimport cuda_extension\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_channels, out_channels, kernel_size, padding, bias_shape):\n        super().__init__()\n        # Store parameters to mirror original model\n        self.in_channels = in_channels\n        self.out_channels = out_channels\n        self.kernel_size = kernel_size\n        self.padding = padding\n        self.bias_shape = bias_shape\n        # Create learnable parameters with same shape/init as original\n        self.conv_weight = nn.Parameter(torch.empty(out_channels, in_channels, kernel_size, kernel_size))\n        self.conv_bias = nn.Parameter(torch.empty(out_channels))\n        self.bias = nn.Parameter(torch.empty(bias_shape))\n        # Initialize parameters using same scheme as nn.Conv2d and original Model\n        # Match PyTorch default initialization\n        nn.init.kaiming_uniform_(self.conv_weight, a=math.sqrt(5))\n        fan_in, _ = nn.init._calculate_fan_in_and_fan_out(self.conv_weight)\n        bound = 1 / math.sqrt(fan_in) if fan_in > 0 else 0\n        nn.init.uniform_(self.conv_bias, -bound, bound)\n        nn.init.uniform_(self.bias, -bound, bound)\n\n    def forward(self, x):\n        # Step 1: constant pad 2D with value = padding[0]\n        # padding is tuple of length 2, convert to 4-tuple for custom op (left, right, top, bottom)\n        pad_left, pad_right, pad_top, pad_bottom = self.padding[0], self.padding[0], self.padding[1], self.padding[1]\n        x = cuda_extension.pad_constant_2d(x, [pad_left, pad_right, pad_top, pad_bottom], self.padding[0])\n        # Step 2: rotate 90 degrees clockwise in dims (2,3)\n        x = cuda_extension.rot90_k1(x)\n        # Step 3: convolution 2D with stride 1, no padding (already padded)\n        x = cuda_extension.conv2d_forward(x, self.conv_weight, self.conv_bias, 1, 0)\n        # Step 4: isinf mask\n        mask = cuda_extension.isinf(x)\n        # Step 5: masked fill with 0.0\n        x = cuda_extension.masked_fill_zero(x, mask)\n        # Step 6: add bias (broadcast over channels)\n        x = cuda_extension.add_bias(x, self.bias)\n        return x\n\n    def debug_forward(self, x):\n        # Trace each step as required by contract\n        pad_left, pad_right, pad_top, pad_bottom = self.padding[0], self.padding[0], self.padding[1], self.padding[1]\n        x_pad = cuda_extension.pad_constant_2d(x, [pad_left, pad_right, pad_top, pad_bottom], self.padding[0])\n        yield 'step_001', x_pad\n\n        x_rot = cuda_extension.rot90_k1(x_pad)\n        yield 'step_002', x_rot\n\n        x_conv = cuda_extension.conv2d_forward(x_rot, self.conv_weight, self.conv_bias, 1, 0)\n        yield 'step_003', x_conv\n\n        mask = cuda_extension.isinf(x_conv)\n        yield 'step_004', mask\n\n        x_masked = cuda_extension.masked_fill_zero(x_conv, mask)\n        yield 'step_005', x_masked\n\n        x_out = cuda_extension.add_bias(x_masked, self.bias)\n        yield 'step_006', x_out\n\n        yield 'step_007', x_out\n"
