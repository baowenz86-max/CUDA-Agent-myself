--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,59 @@
+#include <cuda_runtime.h>
+
+// Element-wise absolute value kernel.
+// Each thread processes one element. Grid-stride loop supports arbitrary numel.
+__global__ void abs_kernel(const float* input, float* output, long long numel) {
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    const long long stride = (long long)gridDim.x * blockDim.x;
+    for (; idx < numel; idx += stride) {
+        output[idx] = fabsf(input[idx]);
+    }
+}
+
+// Adaptive average pooling over the last dimension (width).
+// Assumes input_width is divisible by output_width (window_size = input_width / output_width).
+// Each thread computes one output element by averaging window_size consecutive inputs.
+__global__ void adaptive_avg_pool1d_kernel(const float* input, float* output,
+                                          int batch, int channels,
+                                          int input_width, int output_width,
+                                          int window_size) {
+    int total_outputs = batch * channels * output_width;
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= total_outputs) return;
+
+    // Decode output index: [b][c][ow]
+    int ow = idx % output_width;
+    int tmp = idx / output_width;
+    int c = tmp % channels;
+    int b = tmp / channels;
+
+    // Input start offset for this window
+    int in_start = ((b * channels + c) * input_width) + ow * window_size;
+
+    float sum = 0.0f;
+    for (int i = 0; i < window_size; ++i) {
+        sum += input[in_start + i];
+    }
+    output[idx] = sum / (float)window_size;
+}
+
+// Launcher for custom_abs_forward.
+extern "C" void custom_abs_forward_launcher(const float* input, float* output,
+                                             long long numel, cudaStream_t stream) {
+    const int block_size = 256;
+    const long long grid_size = (numel + block_size - 1) / block_size;
+    // Grid dimension limited to 2^31-1, but numel here is 104857600, well below limit.
+    abs_kernel<<<(unsigned int)grid_size, block_size, 0, stream>>>(input, output, numel);
+}
+
+// Launcher for custom_adaptive_avg_pool1d_forward.
+extern "C" void custom_adaptive_avg_pool1d_forward_launcher(
+        const float* input, float* output,
+        int batch, int channels, int input_width, int output_width,
+        int window_size, cudaStream_t stream) {
+    int total_outputs = batch * channels * output_width;
+    const int block_size = 256;
+    const int grid_size = (total_outputs + block_size - 1) / block_size;
+    adaptive_avg_pool1d_kernel<<<(unsigned int)grid_size, block_size, 0, stream>>>(
+        input, output, batch, channels, input_width, output_width, window_size);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,81 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void custom_abs_forward_launcher(const float* input, float* output,
+                                             long long numel, cudaStream_t stream);
+
+// Launcher for adaptive avg pool
+extern "C" void custom_adaptive_avg_pool1d_forward_launcher(
+        const float* input, float* output,
+        int batch, int channels, int input_width, int output_width,
+        int window_size, cudaStream_t stream);
+
+// Element-wise absolute value
+torch::Tensor custom_abs_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    
+    // Ensure contiguous
+    x = x.contiguous();
+    
+    auto output = torch::empty_like(x);
+    
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    
+    custom_abs_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<long long>(x.numel()),
+        stream
+    );
+    
+    return output;
+}
+
+// Adaptive average pooling 1d
+torch::Tensor custom_adaptive_avg_pool1d_forward(torch::Tensor x, int64_t output_size) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 3, "Input must be 3D (batch, channels, width)");
+    TORCH_CHECK(output_size > 0, "output_size must be positive");
+    
+    // Ensure contiguous
+    x = x.contiguous();
+    
+    int batch = x.size(0);
+    int channels = x.size(1);
+    int input_width = x.size(2);
+    
+    TORCH_CHECK(input_width % output_size == 0, "input_width must be divisible by output_size");
+    int window_size = input_width / output_size;
+    
+    auto output = torch::empty({batch, channels, output_size}, x.options());
+    
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    
+    custom_adaptive_avg_pool1d_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        batch, channels, input_width,
+        static_cast<int>(output_size), window_size,
+        stream
+    );
+    
+    return output;
+}
+
+// Registration
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_abs_forward", &custom_abs_forward,
+          "Element-wise absolute value",
+          py::arg("x"));
+    m.def("custom_adaptive_avg_pool1d_forward", &custom_adaptive_avg_pool1d_forward,
+          "Adaptive average pooling 1d",
+          py::arg("x"), py::arg("output_size") = 16);
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,22 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels: int, pooling_size: int):
+        super().__init__()
+        self.in_channels = in_channels
+        self.pooling_size = pooling_size
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        x = cuda_extension.custom_abs_forward(x)
+        x = cuda_extension.custom_adaptive_avg_pool1d_forward(x, self.pooling_size)
+        return x
+
+    def debug_forward(self, x: torch.Tensor):
+        x = cuda_extension.custom_abs_forward(x)
+        yield 'step_001', x
+        x = cuda_extension.custom_adaptive_avg_pool1d_forward(x, self.pooling_size)
+        yield 'step_002', x
+        yield 'step_003', x
