      "semantics": [
        "沿 dim=1 对两个相同张量进行堆叠。",
        "输入 [16, 3, 2050, 1026] -> 输出 [16, 2, 3, 2050, 1026]。",
        "输出为连续张量，步长 [12619800, 6309900, 2103300, 1026, 1]，dtype float32，设备 cuda:0。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回堆叠后的最终结果。",
        "形状 [16, 2, 3, 2050, 1026]，步长 [12619800, 6309900, 2103300, 1026, 1]，dtype float32，设备 cuda:0。"
      ]
