      "semantics": [
        "对应参考语句 x = F.pad(x, (1, 1, 1, 1), mode='constant', value=self.pad_value)。",
        "pad 参数固定为 [1,1,1,1]，表示在宽度两侧各填充 1 列，在高度两侧各填充 1 行。",
        "输出尺寸为 [16, 3, 2048+2, 1024+2] = [16, 3, 2050, 1026]。",
        "填充值为 self.pad_value（float 类型），与输入 dtype 一致。",
        "输出为连续内存布局，步长为 [6309900, 2103300, 1026, 1]。",
        "本算子仅处理四维输入，按 PyTorch F.pad 语义在最后两维进行常数填充。"
      ]
    },
    {
      "name": "stack_duplicate",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[16, 3, 2050, 1026]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[16, 2, 3, 2050, 1026]"
      },
      "semantics": [
        "对应参考语句 x = torch.stack([x, x], dim=1)。",
        "将输入张量在 dim=1 处堆叠两次，相当于复制一份并插入新维度。",
        "输入为 [16, 3, 2050, 1026]，输出为 [16, 2, 3, 2050, 1026]。",
        "输出为连续内存布局，步长为 [12619800, 6309900, 2103300, 1026, 1]。",
        "堆叠的两个切片完全相同，均为输入张量。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = F.pad(x, (1, 1, 1, 1), mode='constant', value=self.pad_value)",
