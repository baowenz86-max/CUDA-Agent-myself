--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,85 @@
+#include <cuda_runtime.h>
+
+// Constant padding along last two dimensions: pad[0]=left, pad[1]=right, pad[2]=top, pad[3]=bottom
+__global__ void constant_pad_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    int N, int C, int H, int W,
+    int pad_left, int pad_right, int pad_top, int pad_bottom,
+    float value)
+{
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = N * C * (H + pad_top + pad_bottom) * (W + pad_left + pad_right);
+    if (idx >= total) return;
+
+    int out_w = idx % (W + pad_left + pad_right);
+    int out_h = (idx / (W + pad_left + pad_right)) % (H + pad_top + pad_bottom);
+    int c = (idx / ((W + pad_left + pad_right) * (H + pad_top + pad_bottom))) % C;
+    int n = idx / ((W + pad_left + pad_right) * (H + pad_top + pad_bottom) * C);
+
+    if (out_h < pad_top || out_h >= pad_top + H || out_w < pad_left || out_w >= pad_left + W) {
+        output[idx] = value;
+    } else {
+        int in_h = out_h - pad_top;
+        int in_w = out_w - pad_left;
+        int input_idx = ((n * C + c) * H + in_h) * W + in_w;
+        output[idx] = input[input_idx];
+    }
+}
+
+// Stack duplicate along dim=1: output shape [N, 2, C, H, W]
+__global__ void stack_duplicate_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    int N, int C, int H, int W)
+{
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = 2 * N * C * H * W;
+    if (idx >= total) return;
+
+    int in_idx = idx % (N * C * H * W);
+    output[idx] = input[in_idx];
+}
+
+extern "C" void constant_pad_launcher(
+    float* output,
+    const float* input,
+    int64_t n,
+    int64_t c,
+    int64_t h,
+    int64_t w,
+    int64_t pad_left,
+    int64_t pad_right,
+    int64_t pad_top,
+    int64_t pad_bottom,
+    float value,
+    cudaStream_t stream)
+{
+    int out_h = h + pad_top + pad_bottom;
+    int out_w = w + pad_left + pad_right;
+    int64_t total = n * c * out_h * out_w;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    constant_pad_kernel<<<blocks, threads, 0, stream>>>(
+        output, input,
+        (int)n, (int)c, (int)h, (int)w,
+        (int)pad_left, (int)pad_right, (int)pad_top, (int)pad_bottom,
+        value);
+}
+
+extern "C" void stack_duplicate_launcher(
+    float* output,
+    const float* input,
+    int64_t n,
+    int64_t c,
+    int64_t h,
+    int64_t w,
+    cudaStream_t stream)
+{
+    int64_t total = 2 * n * c * h * w;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    stack_duplicate_kernel<<<blocks, threads, 0, stream>>>(
+        output, input,
+        (int)n, (int)c, (int)h, (int)w);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,95 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include <vector>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void constant_pad_launcher(
+    float* output,
+    const float* input,
+    int64_t n,
+    int64_t c,
+    int64_t h,
+    int64_t w,
+    int64_t pad_left,
+    int64_t pad_right,
+    int64_t pad_top,
+    int64_t pad_bottom,
+    float value,
+    cudaStream_t stream);
+
+extern "C" void stack_duplicate_launcher(
+    float* output,
+    const float* input,
+    int64_t n,
+    int64_t c,
+    int64_t h,
+    int64_t w,
+    cudaStream_t stream);
+
+torch::Tensor constant_pad_forward(torch::Tensor x, std::vector<int64_t> pad, double value) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D (N,C,H,W)");
+    TORCH_CHECK(pad.size() == 4, "pad must be a list of 4 integers [left, right, top, bottom]");
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+    int64_t pad_left = pad[0];
+    int64_t pad_right = pad[1];
+    int64_t pad_top = pad[2];
+    int64_t pad_bottom = pad[3];
+
+    int64_t out_H = H + pad_top + pad_bottom;
+    int64_t out_W = W + pad_left + pad_right;
+    auto output = torch::empty({N, C, out_H, out_W}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    constant_pad_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        N, C, H, W,
+        pad_left, pad_right, pad_top, pad_bottom,
+        static_cast<float>(value),
+        stream);
+
+    return output;
+}
+
+torch::Tensor stack_duplicate_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D (N,C,H,W)");
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+    auto output = torch::empty({N, 2, C, H, W}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    stack_duplicate_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        N, C, H, W,
+        stream);
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("constant_pad", &constant_pad_forward,
+          "constant_pad(x: Tensor, pad: List[int], value: float) -> Tensor",
+          pybind11::arg("x"), pybind11::arg("pad"), pybind11::arg("value"));
+    m.def("stack_duplicate", &stack_duplicate_forward,
+          "stack_duplicate(x: Tensor) -> Tensor",
+          pybind11::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,21 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, pad_value):
+        super().__init__()
+        self.pad_value = pad_value
+
+    def forward(self, x):
+        x = cuda_extension.constant_pad(x, pad=[1, 1, 1, 1], value=float(self.pad_value))
+        x = cuda_extension.stack_duplicate(x)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.constant_pad(x, pad=[1, 1, 1, 1], value=float(self.pad_value))
+        yield 'step_001', x
+        x = cuda_extension.stack_duplicate(x)
+        yield 'step_002', x
+        yield 'step_003', x
