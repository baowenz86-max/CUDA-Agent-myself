--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,285 @@
+#include <cuda_runtime.h>
+#include <cublas_v2.h>
+#include <math.h>
+
+// 确保 launcher 使用 C 链接，供绑定层调用
+extern "C" {
+
+// -----------------------------------------------------------------------------
+// linear_forward: output = input @ weight^T + bias (可选)
+// input: [N, S, E], weight: [E, E], bias: [E] 或 nullptr
+// 输出: [N, S, E]
+// 使用 cuBLAS Sgemm，输入非连续时先拷贝到临时连续缓冲
+void linear_forward_launcher(
+    const float* input,      // [N*S, E] 逻辑视图，步长 strided
+    const float* weight,     // [E, E] 连续
+    const float* bias,       // [E] 或 nullptr
+    float* output,           // [N*S, E] 连续
+    int N, int S, int E,
+    int input_stride_0,      // 行步长（元素数），通常是 S*E 或 E
+    int input_stride_1,      // 列步长，通常为 1
+    cudaStream_t stream)
+{
+    // 检查是否需要拷贝输入到连续缓冲区（如果 stride_1 != 1 或 stride_0 != E）
+    const bool need_copy = (input_stride_1 != 1 || input_stride_0 != E);
+    float* contiguous_input = nullptr;
+    if (need_copy) {
+        cudaMalloc(&contiguous_input, (size_t)N * S * E * sizeof(float));
+        // 拷贝 kernel，处理任意步长
+        dim3 block(256);
+        dim3 grid((N * S + 255) / 256);
+        // 使用 lambda 或内联 kernel，这里写一个拷贝 kernel
+        // 为避免复杂，在 host 端使用 cudaMemcpy2D 不合适，这里用自定义 kernel
+        // 定义在下方
+        copy_strided_kernel<<<grid, block, 0, stream>>>(
+            contiguous_input, input, N*S, E, input_stride_0, input_stride_1);
+    } else {
+        contiguous_input = const_cast<float*>(input); // 如果连续，直接使用
+    }
+
+    // cuBLAS 句柄
+    cublasHandle_t handle;
+    cublasCreate(&handle);
+    cublasSetStream(handle, stream);
+
+    // 计算 output = input @ weight^T
+    // 注意：PyTorch Linear 是 input @ weight.T
+    // cuBLAS column-major 表示：C = alpha * A * B + beta * C
+    // 这里我们想要 C(row-major, M x N) = A(row-major, M x K) * B(row-major, K x N)
+    // 其中 B = weight^T，即 weight 转置
+    // 等效于 column-major: C^T = B^T * A^T
+    // 使用 cublasSgemm 的 transa/transb 参数。
+    const float alpha = 1.0f;
+    const float beta = 0.0f;
+    int m = N * S;       // 行数
+    int n = E;           // 列数
+    int k = E;           // 内积维度
+
+    // 由于 weight 在内存中是 row-major [E,E]，但 cuBLAS 默认 column-major，
+    // 我们需要将 weight 解释为 column-major 的 [E,E] 转置矩阵，即 transb = CUBLAS_OP_T 或使用 weight.T。
+    // 常见做法：cublasSgemm(handle, CUBLAS_OP_N, CUBLAS_OP_T, m, n, k, &alpha,
+    //                input, m, weight, n, &beta, output, m);
+    // 其中 input 是 column-major 的 m x k，weight 是 column-major 的 n x k，取转置后得到 k x n。
+    // 由于内存 row-major，这等价于计算 input @ weight^T。
+    cublasSgemm(handle, CUBLAS_OP_N, CUBLAS_OP_T,
+                m, n, k,
+                &alpha,
+                contiguous_input, m,
+                weight, n,
+                &beta,
+                output, m);
+
+    cublasDestroy(handle);
+
+    // 加 bias
+    if (bias != nullptr) {
+        dim3 bias_block(256);
+        dim3 bias_grid((m + 255) / 256);
+        add_bias_kernel<<<bias_grid, bias_block, 0, stream>>>(
+            output, bias, m, E);
+    }
+
+    if (need_copy) {
+        cudaFree(contiguous_input);
+    }
+}
+
+// -----------------------------------------------------------------------------
+// scaled_dot_product_attention_forward
+// query: [N, S, E], key: [N, S, E], value: [N, S, E]
+// 输出 attn: [N, S, E]，但 stride 可能非连续（参考为 [512, 8192, 1]）
+// 我们需要输出张量由绑定层分配，其 stride 由绑定层设定。
+// launcher 接收输出指针和其 stride 信息，不负责分配。
+// 参数：
+//   query, key, value: 输入指针 (连续)
+//   output: 输出指针，stride 由 output_stride_0, output_stride_1, output_stride_2 给出
+//   N, S, E
+//   实际参考输出 stride: [512, 8192, 1] 奇怪，但我们必须遵循。
+//   我们将根据给定 stride 写入。
+void scaled_dot_product_attention_forward_launcher(
+    const float* query,   // [N, S, E]
+    const float* key,     // [N, S, E]
+    const float* value,   // [N, S, E]
+    float* output,        // [N, S, E]
+    int N, int S, int E,
+    int output_stride_0,  // 通常 S*E 或 512 (参考)
+    int output_stride_1,  // 通常 E 或 8192 (参考)
+    int output_stride_2,  // 通常 1
+    cudaStream_t stream)
+{
+    // 实现 scaled dot product attention，无 mask
+    // 每个 block 处理一个 (n,s) 位置，计算该行与所有 key 的相似度，softmax，加权 value
+    dim3 block(256);
+    dim3 grid(N * S);
+    const float scale = 1.0f / sqrtf((float)E);
+
+    // 每个线程块处理一对 (n, s)
+    attention_kernel<<<grid, block, 0, stream>>>(
+        query, key, value, output,
+        N, S, E, scale,
+        output_stride_0, output_stride_1, output_stride_2);
+}
+
+// -----------------------------------------------------------------------------
+// concat_forward: output = concat(x1, x2, dim=-1)
+// x1: [N, S, E], x2: [N, S, E], output: [N, S, 2E]
+// 输出连续，由绑定层分配。
+void concat_forward_launcher(
+    const float* x1,       // [N, S, E]
+    const float* x2,       // [N, S, E]
+    float* output,         // [N, S, 2E]
+    int N, int S, int E,
+    int x1_stride_0, int x1_stride_1,
+    int x2_stride_0, int x2_stride_1,
+    cudaStream_t stream)
+{
+    int total_elements = N * S * (2 * E);
+    int threads = 256;
+    int blocks = (total_elements + threads - 1) / threads;
+    concat_kernel<<<blocks, threads, 0, stream>>>(
+        x1, x2, output,
+        N, S, E,
+        x1_stride_0, x1_stride_1,
+        x2_stride_0, x2_stride_1);
+}
+
+} // extern "C"
+
+// -----------------------------------------------------------------------------
+// Kernel 定义
+// -----------------------------------------------------------------------------
+
+// 拷贝 strided 输入到连续缓冲区
+__global__ void copy_strided_kernel(
+    float* dst, const float* src,
+    int rows, int cols,
+    int src_stride_0, int src_stride_1)
+{
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= rows * cols) return;
+    int r = idx / cols;
+    int c = idx % cols;
+    dst[idx] = src[r * src_stride_0 + c * src_stride_1];
+}
+
+// 加 bias
+__global__ void add_bias_kernel(
+    float* output, const float* bias,
+    int rows, int cols)
+{
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= rows * cols) return;
+    int col = idx % cols;
+    output[idx] += bias[col];
+}
+
+// 注意力 kernel：每个 block 处理一个 (n,s)
+__global__ void attention_kernel(
+    const float* __restrict__ query,
+    const float* __restrict__ key,
+    const float* __restrict__ value,
+    float* __restrict__ output,
+    int N, int S, int E,
+    float scale,
+    int out_stride_0, int out_stride_1, int out_stride_2)
+{
+    int n = blockIdx.x / S;
+    int s = blockIdx.x % S;
+
+    // 共享内存用于存储该行的 scores 和 softmax 结果
+    extern __shared__ float scores[]; // size S
+    int tid = threadIdx.x;
+
+    // 计算 scores
+    const float* q_row = query + (n * S + s) * E;
+    const float* k_mat = key + n * S * E;
+
+    float local_score = 0.0f;
+    for (int i = tid; i < S; i += blockDim.x) {
+        const float* k_row = k_mat + i * E;
+        float dot = 0.0f;
+        for (int j = 0; j < E; ++j) {
+            dot += q_row[j] * k_row[j];
+        }
+        scores[i] = dot * scale;
+    }
+    __syncthreads();
+
+    // 计算 softmax（数值稳定）
+    // 求最大值
+    float max_val = -1e30f;
+    for (int i = tid; i < S; i += blockDim.x) {
+        if (scores[i] > max_val) max_val = scores[i];
+    }
+    // 块内归约求最大
+    __shared__ float block_max;
+    if (tid == 0) block_max = max_val;
+    __syncthreads();
+    // 简化：使用原子操作或者直接让一个线程做归约，S 最大 1024，block 256，可以用 warp shuffle 优化
+    // 这里使用简单的跨线程共享内存归约
+    for (int stride = blockDim.x/2; stride > 0; stride >>= 1) {
+        if (tid < stride) {
+            if (block_max < max_val) block_max = max_val;
+        }
+        __syncthreads();
+    }
+    max_val = block_max;
+
+    // 计算 exp 和 sum
+    float sum = 0.0f;
+    for (int i = tid; i < S; i += blockDim.x) {
+        scores[i] = expf(scores[i] - max_val);
+        sum += scores[i];
+    }
+    // 归约 sum
+    __shared__ float block_sum;
+    if (tid == 0) block_sum = 0.0f;
+    __syncthreads();
+    atomicAdd(&block_sum, sum);
+    __syncthreads();
+    sum = block_sum;
+
+    // 计算输出：out = sum_i scores[i] * value[i]
+    const float* v_mat = value + n * S * E;
+    float* out_row = output + n * out_stride_0 + s * out_stride_1;
+
+    for (int j = tid; j < E; j += blockDim.x) {
+        float acc = 0.0f;
+        for (int i = 0; i < S; ++i) {
+            acc += scores[i] * v_mat[i * E + j];
+        }
+        out_row[j * out_stride_2] = acc / sum;
+    }
+}
+
+// 拼接 kernel
+__global__ void concat_kernel(
+    const float* __restrict__ x1,
+    const float* __restrict__ x2,
+    float* __restrict__ output,
+    int N, int S, int E,
+    int x1_stride_0, int x1_stride_1,
+    int x2_stride_0, int x2_stride_1)
+{
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = N * S * (2 * E);
+    if (idx >= total) return;
+
+    int n = idx / (S * 2 * E);
+    int rem = idx % (S * 2 * E);
+    int s = rem / (2 * E);
+    int c = rem % (2 * E);
+
+    const float* src;
+    int src_index;
+    if (c < E) {
+        // 从 x1 复制
+        src = x1;
+        src_index = (n * S + s) * x1_stride_0 + c * x1_stride_1;
+    } else {
+        // 从 x2 复制
+        src = x2;
+        src_index = (n * S + s) * x2_stride_0 + (c - E) * x2_stride_1;
+    }
+    output[idx] = src[src_index];
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,217 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" {
+void linear_forward_launcher(
+    const float* input,
+    const float* weight,
+    const float* bias,
+    float* output,
+    int N, int S, int E,
+    int input_stride_0,
+    int input_stride_1,
+    cudaStream_t stream);
+
+void scaled_dot_product_attention_forward_launcher(
+    const float* query,
+    const float* key,
+    const float* value,
+    float* output,
+    int N, int S, int E,
+    int output_stride_0,
+    int output_stride_1,
+    int output_stride_2,
+    cudaStream_t stream);
+
+void concat_forward_launcher(
+    const float* x1,
+    const float* x2,
+    float* output,
+    int N, int S, int E,
+    int x1_stride_0, int x1_stride_1,
+    int x2_stride_0, int x2_stride_1,
+    cudaStream_t stream);
+}
+
+// Helper to check CUDA tensor properties
+static void check_cuda_float32(const torch::Tensor& tensor, const char* name) {
+    TORCH_CHECK(tensor.is_cuda(), name, " must be a CUDA tensor");
+    TORCH_CHECK(tensor.dtype() == torch::kFloat32, name, " must be float32");
+}
+
+// linear_forward binding
+static torch::Tensor linear_forward(
+    torch::Tensor input,
+    torch::Tensor weight,
+    c10::optional<torch::Tensor> bias) {
+    check_cuda_float32(input, "input");
+    check_cuda_float32(weight, "weight");
+    if (bias.has_value()) {
+        check_cuda_float32(bias.value(), "bias");
+    }
+
+    // Check shapes: input [N, S, E], weight [E, E]
+    TORCH_CHECK(input.dim() == 3, "input must be 3D [N, S, E]");
+    TORCH_CHECK(weight.dim() == 2, "weight must be 2D [E, E]");
+    int N = input.size(0);
+    int S = input.size(1);
+    int E = input.size(2);
+    TORCH_CHECK(weight.size(0) == E && weight.size(1) == E,
+                "weight shape must be [", E, ", ", E, "]");
+    if (bias.has_value()) {
+        TORCH_CHECK(bias.value().dim() == 1 && bias.value().size(0) == E,
+                    "bias must be 1D of size ", E);
+    }
+
+    // Ensure weight is contiguous for cuBLAS (will likely be contiguous already)
+    auto weight_contig = weight.contiguous();
+    auto bias_contig = bias.has_value() ? bias.value().contiguous() : torch::Tensor();
+
+    // Allocate output as contiguous [N, S, E]
+    auto output = torch::empty({N, S, E}, input.options());
+
+    // Get stream
+    auto stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Gather input stride info (element count)
+    int input_stride_0 = input.stride(0);
+    int input_stride_1 = input.stride(1);
+
+    // Call launcher
+    linear_forward_launcher(
+        input.data_ptr<float>(),
+        weight_contig.data_ptr<float>(),
+        bias.has_value() ? bias_contig.data_ptr<float>() : nullptr,
+        output.data_ptr<float>(),
+        N, S, E,
+        input_stride_0, input_stride_1,
+        stream);
+
+    // Check for kernel errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "linear_forward kernel launch failed: ",
+                cudaGetErrorString(err));
+
+    return output;
+}
+
+// scaled_dot_product_attention_forward binding
+static torch::Tensor scaled_dot_product_attention_forward(
+    torch::Tensor query,
+    torch::Tensor key,
+    torch::Tensor value) {
+    check_cuda_float32(query, "query");
+    check_cuda_float32(key, "key");
+    check_cuda_float32(value, "value");
+
+    // Shapes: [N, S, E]
+    TORCH_CHECK(query.dim() == 3 && key.dim() == 3 && value.dim() == 3,
+                "query/key/value must be 3D [N, S, E]");
+    int N = query.size(0);
+    int S = query.size(1);
+    int E = query.size(2);
+    TORCH_CHECK(key.size(0) == N && key.size(1) == S && key.size(2) == E,
+                "key shape mismatch");
+    TORCH_CHECK(value.size(0) == N && value.size(1) == S && value.size(2) == E,
+                "value shape mismatch");
+
+    // Ensure inputs are contiguous (launcher assumes contiguous query/key/value)
+    auto query_contig = query.contiguous();
+    auto key_contig = key.contiguous();
+    auto value_contig = value.contiguous();
+
+    // Allocate output with special strides [E, S*E, 1]
+    // Actually reference stride [512, 8192, 1] for shape [16, 1024, 512]
+    // stride[0] = E, stride[1] = S*E, stride[2] = 1
+    int out_stride_0 = E;
+    int out_stride_1 = S * E;
+    int out_stride_2 = 1;
+
+    // Create output tensor with these strides. Use torch::empty with sizes,
+    // then set strides via as_strided. Alternatively, create empty and then as_strided.
+    auto output = torch::empty({N, S, E}, query.options()).as_strided(
+        {N, S, E}, {out_stride_0, out_stride_1, out_stride_2});
+
+    // Get stream
+    auto stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    scaled_dot_product_attention_forward_launcher(
+        query_contig.data_ptr<float>(),
+        key_contig.data_ptr<float>(),
+        value_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, S, E,
+        out_stride_0, out_stride_1, out_stride_2,
+        stream);
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "scaled_dot_product_attention_forward kernel launch failed: ",
+                cudaGetErrorString(err));
+
+    return output;
+}
+
+// concat_forward binding
+static torch::Tensor concat_forward(
+    torch::Tensor x1,
+    torch::Tensor x2) {
+    check_cuda_float32(x1, "x1");
+    check_cuda_float32(x2, "x2");
+
+    // Shapes: [N, S, E]
+    TORCH_CHECK(x1.dim() == 3 && x2.dim() == 3,
+                "x1/x2 must be 3D [N, S, E]");
+    int N = x1.size(0);
+    int S = x1.size(1);
+    int E = x1.size(2);
+    TORCH_CHECK(x2.size(0) == N && x2.size(1) == S && x2.size(2) == E,
+                "x2 shape mismatch");
+
+    // Gather stride info (element count)
+    int x1_stride_0 = x1.stride(0);
+    int x1_stride_1 = x1.stride(1);
+    int x2_stride_0 = x2.stride(0);
+    int x2_stride_1 = x2.stride(1);
+
+    // Allocate output contiguous [N, S, 2E]
+    auto output = torch::empty({N, S, 2 * E}, x1.options());
+
+    // Get stream
+    auto stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    concat_forward_launcher(
+        x1.data_ptr<float>(),
+        x2.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, S, E,
+        x1_stride_0, x1_stride_1,
+        x2_stride_0, x2_stride_1,
+        stream);
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "concat_forward kernel launch failed: ",
+                cudaGetErrorString(err));
+
+    return output;
+}
+
+// Register bindings
+static void register_custom_ops(pybind11::module& m) {
+    m.def("linear_forward", &linear_forward,
+          "Linear forward (input @ weight.T + bias)",
+          py::arg("input"), py::arg("weight"), py::arg("bias") = py::none());
+    m.def("scaled_dot_product_attention_forward", &scaled_dot_product_attention_forward,
+          "Scaled dot-product attention forward",
+          py::arg("query"), py::arg("key"), py::arg("value"));
+    m.def("concat_forward", &concat_forward,
+          "Concatenate along last dimension",
+          py::arg("x1"), py::arg("x2"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,37 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, embed_dim, num_heads, batch_size, seq_length):
+        super().__init__()
+        self.embed_dim = embed_dim
+        self.num_heads = num_heads
+        self.batch_size = batch_size
+        self.seq_length = seq_length
+        # 保持与参考相同的参数结构和名称，确保 state_dict 兼容
+        self.query_linear = nn.Linear(embed_dim, embed_dim)
+        self.key_linear = nn.Linear(embed_dim, embed_dim)
+        self.value_linear = nn.Linear(embed_dim, embed_dim)
+
+    def forward(self, x1, x2):
+        q = cuda_extension.linear_forward(x1, self.query_linear.weight, self.query_linear.bias)
+        k = cuda_extension.linear_forward(x2, self.key_linear.weight, self.key_linear.bias)
+        v = cuda_extension.linear_forward(x2, self.value_linear.weight, self.value_linear.bias)
+        attn = cuda_extension.scaled_dot_product_attention_forward(q, k, v)
+        cat = cuda_extension.concat_forward(x1, attn)
+        return cat
+
+    def debug_forward(self, x1, x2):
+        q = cuda_extension.linear_forward(x1, self.query_linear.weight, self.query_linear.bias)
+        yield 'step_001', q
+        k = cuda_extension.linear_forward(x2, self.key_linear.weight, self.key_linear.bias)
+        yield 'step_002', k
+        v = cuda_extension.linear_forward(x2, self.value_linear.weight, self.value_linear.bias)
+        yield 'step_003', v
+        attn = cuda_extension.scaled_dot_product_attention_forward(q, k, v)
+        yield 'step_004', attn
+        cat = cuda_extension.concat_forward(x1, attn)
+        yield 'step_005', cat
+        yield 'step_006', cat
