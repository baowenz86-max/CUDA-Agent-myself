{
  "operators": [
    {
      "name": "linear_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, seq_length, embed_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[embed_dim, embed_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[embed_dim]",
          "layout": "supports strides",
          "nullable": true,
          "optional": true,
          "default": null
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, seq_length, embed_dim]"
      },
      "semantics": [
        "执行线性变换 output = input @ weight.T + bias，当 bias 为 None 时仅矩阵乘法。",
        "输入形状 [N, S, E]，weight [E, E]，输出 [N, S, E]。",
        "使用 cuBLAS GEMM 或等价 CUDA 内核，保持与 PyTorch nn.Linear 相同的数值精度（默认 TF32 策略可选，但不影响正确性容差）。",
        "支持任意 stride 输入，必要时内部保证数据访问正确。"
      ]
    },
    {
      "name": "scaled_dot_product_attention_forward",
      "parameters": [
        {
          "name": "query",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, seq_length, embed_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "key",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, seq_length, embed_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "value",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, seq_length, embed_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, seq_length, embed_dim]"
      },
      "semantics": [
        "计算 scaled dot-product attention: attention_scores = query @ key.transpose(-2, -1) / sqrt(embed_dim)，softmax 在最后一维执行，输出为 attention_scores @ value。",
        "无 mask、无 dropout。",
        "使用 (N, H, S, D) 的 cuDNN/cuBLAS 实现或自定义 kernel，输出形状与输入 query 相同。",
        "数值精度应满足验证容差（atol=1e-2, rtol=1e-2）。"
      ]
    },
    {
      "name": "concat_forward",
      "parameters": [
        {
          "name": "x1",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, seq_length, embed_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "x2",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, seq_length, embed_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, seq_length, 2*embed_dim]"
      },
      "semantics": [
        "沿最后一维拼接两个张量，等价于 torch.cat((x1, x2), dim=-1)。",
        "输出 shape [batch_size, seq_length, 2*embed_dim]，先复制 x1 的所有元素，再复制 x2 的元素。",
        "支持任意 stride 输入，输出为连续张量。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "q = self.query_linear(x1)",
      "semantics": [
        "线性层：q = x1 @ query_linear.weight.T + query_linear.bias",
        "输入 x1 shape [16,1024,512] float32 cuda，输出 q shape [16,1024,512] float32 cuda，stride [524288,512,1]"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "k = self.key_linear(x2)",
      "semantics": [
        "线性层：k = x2 @ key_linear.weight.T + key_linear.bias",
        "输入 x2 shape [16,1024,512] float32 cuda，输出 k shape [16,1024,512] float32 cuda，stride [524288,512,1]"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "v = self.value_linear(x2)",
      "semantics": [
        "线性层：v = x2 @ value_linear.weight.T + value_linear.bias",
        "输入 x2 shape [16,1024,512] float32 cuda，输出 v shape [16,1024,512] float32 cuda，stride [524288,512,1]"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "attn = F.scaled_dot_product_attention(q, k, v)",
      "semantics": [
        "缩放点积注意力：scores = q @ k^T / sqrt(512)，softmax 沿最后一维，输出 = scores @ v",
        "q/k/v shape [16,1024,512] float32 cuda，输出 attn shape [16,1024,512] float32 cuda（注意 checkpoint 中 stride 为 [512,8192,1]，并非标准连续）"
      ]
    },
    {
      "checkpoint": "step_005",
      "source": "cat = torch.cat((x1, attn), dim=-1)",
      "semantics": [
        "拼接：cat = concat(x1, attn, dim=-1)",
        "x1 shape [16,1024,512]，attn shape [16,1024,512]，输出 cat shape [16,1024,1024] float32 cuda，stride [1048576,1024,1]"
      ]
    },
    {
      "checkpoint": "step_006",
      "source": "return cat",
      "semantics": [
        "返回步骤 step_005 得到的 cat 张量"
      ]
    }
  ]
}