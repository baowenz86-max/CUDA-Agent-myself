        "shape": "x.shape with dim removed"
      },
      "semantics": [
        "对应参考语句 torch.amax(x_cat, dim=self.dim)，沿指定维度计算最大值。",
        "保持与 PyTorch amax 相同的语义，输出维度比输入少一维。",
        "不支持 keepdim 参数，仅实现默认行为。",
        "返回连续张量。"
      ]
    }
