+++ after/kernels/custom_ops.cu
@@ -0,0 +1,168 @@
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// Concatenate two float32 tensors along a given dimension (dim >= 0).
+// Inputs may have arbitrary strides; output must be contiguous.
+// This kernel processes each output linear index via grid-stride loop.
+__global__ void concat_kernel(
+    float* __restrict__ out,
+    const float* __restrict__ x1,
+    const float* __restrict__ x2,
+    int64_t out_numel,
+    int ndim,
+    int64_t concat_dim,
+    const int64_t* __restrict__ out_shape,
+    const int64_t* __restrict__ x1_shape,
+    const int64_t* __restrict__ x2_shape,
+    const int64_t* __restrict__ x1_strides,
+    const int64_t* __restrict__ x2_strides
+) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+
+    for (int64_t lin = idx; lin < out_numel; lin += stride) {
+        // Convert linear index to multidimensional coordinates in output
+        int64_t coords[8]; // support up to 8 dimensions (task uses 4)
+        int64_t rem = lin;
+        for (int d = ndim - 1; d >= 0; --d) {
+            coords[d] = rem % out_shape[d];
+            rem /= out_shape[d];
+        }
+
+        // Determine which input tensor and the coordinate within that tensor
+        const float* src_ptr;
+        int64_t src_coord[8];
+        const int64_t* src_shape;
+        const int64_t* src_strides;
+
+        if (coords[concat_dim] < x1_shape[concat_dim]) {
+            src_ptr = x1;
+            src_shape = x1_shape;
+            src_strides = x1_strides;
+            for (int d = 0; d < ndim; ++d) {
+                src_coord[d] = coords[d];
+            }
+        } else {
+            src_ptr = x2;
+            src_shape = x2_shape;
+            src_strides = x2_strides;
+            for (int d = 0; d < ndim; ++d) {
+                src_coord[d] = coords[d];
+            }
+            src_coord[concat_dim] -= x1_shape[concat_dim];
+        }
+
+        // Compute source offset using strides
+        int64_t src_offset = 0;
+        for (int d = 0; d < ndim; ++d) {
+            src_offset += src_coord[d] * src_strides[d];
+        }
+        out[lin] = src_ptr[src_offset];
+    }
+}
+
+// Compute max along a given dimension (dim >= 0), removing that dimension.
+// Input may have arbitrary strides; output is contiguous.
+// Each thread handles one output element (grid-stride loop).
+__global__ void amax_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ out,
+    int64_t out_numel,
+    int ndim,
+    int64_t reduce_dim,
+    const int64_t* __restrict__ in_shape,
+    const int64_t* __restrict__ in_strides,
+    const int64_t* __restrict__ out_shape
+) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+
+    for (int64_t lin = idx; lin < out_numel; lin += stride) {
+        // Convert output linear index to output coordinates (without reduce_dim)
+        int64_t out_coords[8];
+        int64_t rem = lin;
+        for (int d_out = ndim - 2; d_out >= 0; --d_out) {
+            out_coords[d_out] = rem % out_shape[d_out];
+            rem /= out_shape[d_out];
+        }
+
+        // Build input coordinates by inserting a variable index at reduce_dim
+        int64_t in_coords[8];
+        int d_in = 0;
+        for (int d_out = 0; d_out < ndim - 1; ++d_out) {
+            if (d_in == reduce_dim) {
+                // placeholder, will be filled inside loop
+                in_coords[d_in] = 0;
+                ++d_in;
+            }
+            in_coords[d_in] = out_coords[d_out];
+            ++d_in;
+        }
+        if (d_in == reduce_dim) {
+            in_coords[d_in] = 0;
+            ++d_in;
+        }
+
+        float max_val = -CUDART_INF_F;
+        int64_t reduce_size = in_shape[reduce_dim];
+        for (int64_t k = 0; k < reduce_size; ++k) {
+            in_coords[reduce_dim] = k;
+            // compute input offset
+            int64_t offset = 0;
+            for (int d = 0; d < ndim; ++d) {
+                offset += in_coords[d] * in_strides[d];
+            }
+            float val = x[offset];
+            if (val > max_val) max_val = val;
+        }
+        out[lin] = max_val;
+    }
+}
+
+// Helper: compute output shape for concat
+extern "C" void concat_forward_launcher(
+    float* out,
+    const float* x1,
+    const float* x2,
+    int ndim,
+    int64_t concat_dim,
+    const int64_t* out_shape,
+    const int64_t* x1_shape,
+    const int64_t* x2_shape,
+    const int64_t* x1_strides,
+    const int64_t* x2_strides,
+    int64_t out_numel,
+    cudaStream_t stream
+) {
+    constexpr int block = 256;
+    int64_t grid64 = (out_numel + block - 1) / block;
+    if (grid64 > 2147483647LL) grid64 = 2147483647LL;
+    int grid = static_cast<int>(grid64);
+    concat_kernel<<<grid, block, 0, stream>>>(
+        out, x1, x2, out_numel, ndim, concat_dim,
+        out_shape, x1_shape, x2_shape,
+        x1_strides, x2_strides
+    );
+}
+
+// Helper: compute output shape for amax (dim removed)
+extern "C" void amax_forward_launcher(
+    const float* x,
+    float* out,
+    int ndim,
+    int64_t reduce_dim,
+    const int64_t* in_shape,
+    const int64_t* in_strides,
+    const int64_t* out_shape,
+    int64_t out_numel,
+    cudaStream_t stream
+) {
+    constexpr int block = 256;
+    int64_t grid64 = (out_numel + block - 1) / block;
+    if (grid64 > 2147483647LL) grid64 = 2147483647LL;
+    int grid = static_cast<int>(grid64);
+    amax_kernel<<<grid, block, 0, stream>>>(
+        x, out, out_numel, ndim, reduce_dim,
+        in_shape, in_strides, out_shape
+    );
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,193 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include <vector>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void concat_forward_launcher(
+    float* out,
+    const float* x1,
+    const float* x2,
+    int ndim,
+    int64_t concat_dim,
+    const int64_t* out_shape,
+    const int64_t* x1_shape,
+    const int64_t* x2_shape,
+    const int64_t* x1_strides,
+    const int64_t* x2_strides,
+    int64_t out_numel,
+    cudaStream_t stream
+);
+
+extern "C" void amax_forward_launcher(
+    const float* x,
+    float* out,
+    int ndim,
+    int64_t reduce_dim,
+    const int64_t* in_shape,
+    const int64_t* in_strides,
+    const int64_t* out_shape,
+    int64_t out_numel,
+    cudaStream_t stream
+);
+
+static void check_cuda_float(const torch::Tensor& t, const std::string& name) {
+    TORCH_CHECK(t.is_cuda(), name, " must be a CUDA tensor");
+    TORCH_CHECK(t.scalar_type() == torch::kFloat32, name, " must be float32");
+}
+
+static std::vector<int64_t> get_int64_shape(const torch::Tensor& t) {
+    std::vector<int64_t> shape;
+    shape.reserve(t.dim());
+    for (int64_t i = 0; i < t.dim(); ++i) {
+        shape.push_back(t.size(i));
+    }
+    return shape;
+}
+
+static std::vector<int64_t> get_int64_strides(const torch::Tensor& t) {
+    std::vector<int64_t> strides;
+    strides.reserve(t.dim());
+    for (int64_t i = 0; i < t.dim(); ++i) {
+        strides.push_back(t.stride(i));
+    }
+    return strides;
+}
+
+static int64_t prod(const std::vector<int64_t>& v) {
+    int64_t result = 1;
+    for (auto x : v) result *= x;
+    return result;
+}
+
+torch::Tensor concat_forward(torch::Tensor x1, torch::Tensor x2, int64_t dim) {
+    check_cuda_float(x1, "x1");
+    check_cuda_float(x2, "x2");
+    TORCH_CHECK(x1.dim() == x2.dim(), "x1 and x2 must have same number of dimensions");
+    TORCH_CHECK(dim >= 0 && dim < x1.dim(), "dim out of range");
+    for (int64_t i = 0; i < x1.dim(); ++i) {
+        if (i != dim) {
+            TORCH_CHECK(x1.size(i) == x2.size(i), "x1 and x2 must match in all dims except concat dim");
+        }
+    }
+
+    auto x1_shape = get_int64_shape(x1);
+    auto x2_shape = get_int64_shape(x2);
+    std::vector<int64_t> out_shape = x1_shape;
+    out_shape[dim] += x2_shape[dim];
+    int64_t out_numel = prod(out_shape);
+
+    auto out = torch::empty(out_shape, x1.options());
+
+    auto x1_strides = get_int64_strides(x1);
+    auto x2_strides = get_int64_strides(x2);
+
+    TORCH_CHECK(x1_strides.size() == x1.dim() && x2_strides.size() == x2.dim());
+
+    // Allocate device memory for shape/stride arrays
+    int64_t* d_out_shape;
+    int64_t* d_x1_shape;
+    int64_t* d_x2_shape;
+    int64_t* d_x1_strides;
+    int64_t* d_x2_strides;
+    cudaMalloc(&d_out_shape, sizeof(int64_t) * out_shape.size());
+    cudaMalloc(&d_x1_shape, sizeof(int64_t) * x1_shape.size());
+    cudaMalloc(&d_x2_shape, sizeof(int64_t) * x2_shape.size());
+    cudaMalloc(&d_x1_strides, sizeof(int64_t) * x1_strides.size());
+    cudaMalloc(&d_x2_strides, sizeof(int64_t) * x2_strides.size());
+
+    cudaMemcpy(d_out_shape, out_shape.data(), sizeof(int64_t) * out_shape.size(), cudaMemcpyHostToDevice);
+    cudaMemcpy(d_x1_shape, x1_shape.data(), sizeof(int64_t) * x1_shape.size(), cudaMemcpyHostToDevice);
+    cudaMemcpy(d_x2_shape, x2_shape.data(), sizeof(int64_t) * x2_shape.size(), cudaMemcpyHostToDevice);
+    cudaMemcpy(d_x1_strides, x1_strides.data(), sizeof(int64_t) * x1_strides.size(), cudaMemcpyHostToDevice);
+    cudaMemcpy(d_x2_strides, x2_strides.data(), sizeof(int64_t) * x2_strides.size(), cudaMemcpyHostToDevice);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    concat_forward_launcher(
+        out.data_ptr<float>(),
+        x1.data_ptr<float>(),
+        x2.data_ptr<float>(),
+        static_cast<int>(x1.dim()),
+        dim,
+        d_out_shape,
+        d_x1_shape,
+        d_x2_shape,
+        d_x1_strides,
+        d_x2_strides,
+        out_numel,
+        stream
+    );
+
+    // Free device arrays
+    cudaFree(d_out_shape);
+    cudaFree(d_x1_shape);
+    cudaFree(d_x2_shape);
+    cudaFree(d_x1_strides);
+    cudaFree(d_x2_strides);
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA error in concat_forward: ", cudaGetErrorString(err));
+    return out;
+}
+
+torch::Tensor amax_forward(torch::Tensor x, int64_t dim) {
+    check_cuda_float(x, "x");
+    TORCH_CHECK(dim >= 0 && dim < x.dim(), "dim out of range");
+
+    auto in_shape = get_int64_shape(x);
+    std::vector<int64_t> out_shape;
+    out_shape.reserve(x.dim() - 1);
+    for (int64_t i = 0; i < x.dim(); ++i) {
+        if (i != dim) out_shape.push_back(in_shape[i]);
+    }
+    int64_t out_numel = prod(out_shape);
+
+    auto out = torch::empty(out_shape, x.options());
+
+    auto in_strides = get_int64_strides(x);
+
+    int64_t* d_in_shape;
+    int64_t* d_in_strides;
+    int64_t* d_out_shape;
+    cudaMalloc(&d_in_shape, sizeof(int64_t) * in_shape.size());
+    cudaMalloc(&d_in_strides, sizeof(int64_t) * in_strides.size());
+    cudaMalloc(&d_out_shape, sizeof(int64_t) * out_shape.size());
+
+    cudaMemcpy(d_in_shape, in_shape.data(), sizeof(int64_t) * in_shape.size(), cudaMemcpyHostToDevice);
+    cudaMemcpy(d_in_strides, in_strides.data(), sizeof(int64_t) * in_strides.size(), cudaMemcpyHostToDevice);
+    cudaMemcpy(d_out_shape, out_shape.data(), sizeof(int64_t) * out_shape.size(), cudaMemcpyHostToDevice);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    amax_forward_launcher(
+        x.data_ptr<float>(),
+        out.data_ptr<float>(),
+        static_cast<int>(x.dim()),
+        dim,
+        d_in_shape,
+        d_in_strides,
+        d_out_shape,
+        out_numel,
+        stream
+    );
+
+    cudaFree(d_in_shape);
+    cudaFree(d_in_strides);
+    cudaFree(d_out_shape);
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA error in amax_forward: ", cudaGetErrorString(err));
+    return out;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("concat_forward", &concat_forward,
+          "Concatenate two tensors along a dimension",
+          py::arg("x1"), py::arg("x2"), py::arg("dim"));
+    m.def("amax_forward", &amax_forward,
+          "Compute maximum along a dimension",
+          py::arg("x"), py::arg("dim"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,21 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, dim: int):
+        super().__init__()
+        self.dim = dim
+
+    def forward(self, x1: torch.Tensor, x2: torch.Tensor) -> torch.Tensor:
+        x_cat = cuda_extension.concat_forward(x1, x2, self.dim)
+        x_amax = cuda_extension.amax_forward(x_cat, self.dim)
+        return x_amax
+
+    def debug_forward(self, x1: torch.Tensor, x2: torch.Tensor):
+        x_cat = cuda_extension.concat_forward(x1, x2, self.dim)
+        yield 'step_001', x_cat
+        x_amax = cuda_extension.amax_forward(x_cat, self.dim)
+        yield 'step_002', x_amax
+        yield 'step_003', x_amax
