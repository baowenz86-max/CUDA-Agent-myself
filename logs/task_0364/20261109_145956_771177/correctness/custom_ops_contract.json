{
  "operators": [
    {
      "name": "custom_relu_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[512, 512, 32, 32]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[512, 512, 32, 32]"
      },
      "semantics": [
        "对应参考语句 x = torch.relu(x)。",
        "逐元素计算 max(x, 0)，输出与输入同 shape/dtype/device。",
        "保留输入连续布局，输出为新建连续张量。"
      ]
    },
    {
      "name": "custom_cumsum_dim1_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[512, 512, 32, 32]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[512, 512, 32, 32]"
      },
      "semantics": [
        "对应参考语句 x = torch.cumsum(x, dim=1)。",
        "沿维度 1（大小 512）做前缀和，输入为 relu 输出，float32 累加。",
        "输出与输入同 shape/dtype/device，为新建连续张量。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = torch.relu(x)",
      "semantics": [
        "对输入张量 x 执行逐元素 ReLU，输出 shape [512,512,32,32]，float32，cuda:0。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.cumsum(x, dim=1)",
      "semantics": [
        "对 step_001 输出沿 dim=1 做累加前缀和，任意位置 (b,c,h,w) 为 sum_{k<=c} x[b,k,h,w]。输出 shape [512,512,32,32]，float32，cuda:0。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回 step_002 计算的 cumsum 张量，shape/dtype/device 与 step_002 相同。"
      ]
    }
  ]
}