--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,99 @@
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// Kernel: compute log_softmax along dimension 1 for a 4D tensor
+// input shape: [batch, channels, height, width]
+// Each thread processes one (batch, spatial_index).
+template <int BLOCK_SIZE>
+__global__ void log_softmax_dim1_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int64_t batch,
+    int64_t channels,
+    int64_t spatial_size)
+{
+    int64_t total_positions = batch * spatial_size;
+    int64_t stride = (int64_t)gridDim.x * BLOCK_SIZE;
+    for (int64_t pos = blockIdx.x * BLOCK_SIZE + threadIdx.x; pos < total_positions; pos += stride) {
+        int64_t b = pos / spatial_size;
+        int64_t s = pos - b * spatial_size;
+
+        const float* in_base = input + b * channels * spatial_size + s;
+        float* out_base = output + b * channels * spatial_size + s;
+
+        // compute max over channels
+        float max_val = in_base[0];
+        #pragma unroll 4
+        for (int64_t c = 1; c < channels; ++c) {
+            float val = in_base[c * spatial_size];
+            if (val > max_val) max_val = val;
+        }
+
+        // compute sum of exp(x - max)
+        float sum_exp = 0.0f;
+        #pragma unroll 4
+        for (int64_t c = 0; c < channels; ++c) {
+            float val = in_base[c * spatial_size];
+            sum_exp += __expf(val - max_val);
+        }
+
+        float log_sum = logf(sum_exp);
+
+        // write results
+        #pragma unroll 4
+        for (int64_t c = 0; c < channels; ++c) {
+            float val = in_base[c * spatial_size];
+            out_base[c * spatial_size] = val - max_val - log_sum;
+        }
+    }
+}
+
+// Launcher for log_softmax_dim1
+// Expects input to be contiguous; binding layer should ensure this.
+// Buffer pointers are raw device pointers.
+extern "C" void log_softmax_dim1_launcher(
+    const float* input,
+    float* output,
+    int64_t batch,
+    int64_t channels,
+    int64_t spatial_size,
+    cudaStream_t stream)
+{
+    constexpr int BLOCK_SIZE = 256;
+    int64_t total_positions = batch * spatial_size;
+    int blocks = (int)((total_positions + BLOCK_SIZE - 1) / BLOCK_SIZE);
+    // Limit grid size; kernel uses grid-stride loop, so any grid size works.
+    if (blocks > 65535) blocks = 65535;
+    log_softmax_dim1_kernel<BLOCK_SIZE><<<blocks, BLOCK_SIZE, 0, stream>>>(
+        input, output, batch, channels, spatial_size);
+}
+
+// Kernel: element-wise scalar division: output[i] = input[i] / divisor
+template <int BLOCK_SIZE>
+__global__ void scalar_div_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int64_t numel,
+    float divisor)
+{
+    int64_t stride = (int64_t)gridDim.x * BLOCK_SIZE;
+    for (int64_t i = blockIdx.x * BLOCK_SIZE + threadIdx.x; i < numel; i += stride) {
+        output[i] = input[i] / divisor;
+    }
+}
+
+// Launcher for scalar_div
+extern "C" void scalar_div_launcher(
+    const float* input,
+    float* output,
+    int64_t numel,
+    double divisor,
+    cudaStream_t stream)
+{
+    constexpr int BLOCK_SIZE = 256;
+    int blocks = (int)((numel + BLOCK_SIZE - 1) / BLOCK_SIZE);
+    if (blocks > 65535) blocks = 65535;
+    float divisor_f = (float)divisor;
+    scalar_div_kernel<BLOCK_SIZE><<<blocks, BLOCK_SIZE, 0, stream>>>(
+        input, output, numel, divisor_f);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,90 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void log_softmax_dim1_launcher(
+    const float* input,
+    float* output,
+    int64_t batch,
+    int64_t channels,
+    int64_t spatial_size,
+    cudaStream_t stream);
+
+extern "C" void scalar_div_launcher(
+    const float* input,
+    float* output,
+    int64_t numel,
+    double divisor,
+    cudaStream_t stream);
+
+// Wrapper for log_softmax along dim=1
+torch::Tensor log_softmax_dim1(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4-dimensional");
+
+    // Ensure contiguous layout as launcher expects
+    if (!x.is_contiguous()) {
+        x = x.contiguous();
+    }
+
+    auto batch = x.size(0);
+    auto channels = x.size(1);
+    auto spatial_size = x.size(2) * x.size(3);
+
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    log_softmax_dim1_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        batch,
+        channels,
+        spatial_size,
+        stream
+    );
+
+    return output;
+}
+
+// Wrapper for scalar division
+torch::Tensor scalar_div(torch::Tensor x, double divisor) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+
+    // Ensure contiguous layout as launcher expects
+    if (!x.is_contiguous()) {
+        x = x.contiguous();
+    }
+
+    auto output = torch::empty_like(x);
+    auto numel = x.numel();
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    scalar_div_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        numel,
+        divisor,
+        stream
+    );
+
+    return output;
+}
+
+// Register bindings
+void register_custom_ops(pybind11::module& m) {
+    m.def("log_softmax_dim1", &log_softmax_dim1,
+          "Compute log_softmax along dimension 1",
+          py::arg("x"));
+    m.def("scalar_div", &scalar_div,
+          "Divide tensor by scalar",
+          py::arg("x"), py::arg("divisor"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,37 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, num_classes, divisor):
+        super().__init__()
+        self.divisor = divisor
+
+    def forward(self, x):
+        x = cuda_extension.log_softmax_dim1(x)
+        x = cuda_extension.scalar_div(x, self.divisor)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.log_softmax_dim1(x)
+        yield 'step_001', x
+        x = cuda_extension.scalar_div(x, self.divisor)
+        yield 'step_002', x
+        yield 'step_003', x
+
+
+batch_size = 64
+num_classes = 10
+height = 1024
+width = 256
+divisor = 0.5
+
+
+def get_inputs():
+    x = torch.randn(batch_size, num_classes, height, width)
+    return [x]
+
+
+def get_init_inputs():
+    return [num_classes, divisor]
