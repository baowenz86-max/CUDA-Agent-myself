      "semantics": [
        "Performs 1D transposed convolution exactly as F.conv_transpose1d with bias=None and given stride, padding, output_padding.",
        "Uses cuDNN backend with float32.",
        "Output tensor is allocated as torch::empty with same device as input, dtype float32.",
