          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "Adds bias vector to each channel of x: out[b, c, l] = x[b, c, l] + bias[c].",
