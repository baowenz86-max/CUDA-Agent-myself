      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "Applies torch.round element-wise: rounds half to even (bankers' rounding).",
        "Output is a new tensor, not in-place."
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = F.conv_transpose1d(x, self.conv_transpose.weight, bias=None, stride=self.conv_transpose.stride, padding=self.conv_transpose.padding, output_padding=self.conv_transpose.output_padding)",
      "semantics": [
        "Performs transposed convolution with no bias; implicit bias tensor is not used.",
        "Output shape [128, 8, 16384], dtype float32, device cuda:0."
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = x + self.params[0].view(1, -1, 1)",
      "semantics": [
        "Adds params[0] broadcast along batch and length to x.",
        "Same shape as previous x."
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = x + self.params[1].view(1, -1, 1)",
      "semantics": [
        "Adds params[1] broadcast along batch and length to x.",
        "Same shape."
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "x = x + self.params[2].view(1, -1, 1)",
      "semantics": [
        "Adds params[2] broadcast along batch and length to x.",
        "Same shape."
      ]
    },
    {
      "checkpoint": "step_005",
      "source": "x = torch.round(x)",
      "semantics": [
        "Rounds element-wise using half-to-even rule.",
        "Final output shape [128, 8, 16384], dtype float32, device cuda:0."
      ]
    }
  ]
