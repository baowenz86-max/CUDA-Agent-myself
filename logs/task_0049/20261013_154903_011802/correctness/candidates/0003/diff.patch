+// Device function for round half to even (bankers' rounding)
+__device__ float round_half_to_even(float x) {
+    float rounded = roundf(x);
+    float diff = x - floorf(x);
+    if (diff == 0.5f) {
+        // If x is exactly halfway between two integers, choose the even integer
+        float lower = floorf(x);
+        float upper = lower + 1.0f;
+        return (fmodf(lower, 2.0f) == 0.0f) ? lower : upper;
+    }
+    return rounded;
+}
 
