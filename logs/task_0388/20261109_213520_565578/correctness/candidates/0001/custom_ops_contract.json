{
  "operators": [
    {
      "name": "embedding_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.int64",
          "device": "cuda",
          "shape": "[batch_size, seq_length]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[num_embeddings, embedding_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, seq_length, embedding_dim]"
      },
      "semantics": [
        "等价于 nn.Embedding.forward：对输入中的每个整数索引，从 weight 中取出对应行，保持输入形状并在最后一维增加 embedding_dim 维。",
        "支持任意 batch_size 和 seq_length，输入为 int64，权重为 float32。",
        "输出 layout 与输入对应，即 row-major，stride 为 [seq_length*embedding_dim, embedding_dim, 1]。"
      ]
    },
    {
      "name": "mean_dim_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, seq_length, embedding_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, embedding_dim]"
      },
      "semantics": [
        "等价于 x.mean(dim=1)：沿 seq_length 维度求均值，保持 batch_size 和 embedding_dim。",
        "输出为 float32，layout 为 row-major，stride 为 [embedding_dim, 1]。",
        "dim 参数固定为 1，但作为参数传入以保持灵活性。"
      ]
    },
    {
      "name": "linear_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, in_features]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_features, in_features]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_features]",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, out_features]"
      },
      "semantics": [
        "等价于 nn.Linear.forward：计算 input @ weight.T + bias。",
        "bias 不能为 None，参考实现中 fc 有 bias。",
        "输出为 float32，layout 为 row-major，stride 为 [out_features, 1]。"
      ]
    },
    {
      "name": "bce_with_logits_forward",
      "parameters": [
        {
          "name": "logits",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, 1]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "target",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, 1]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[]"
      },
      "semantics": [
        "等价于 nn.BCEWithLogitsLoss()(logits, target)：对每个元素计算 BCEWithLogitsLoss，然后对所有元素取平均。",
        "默认 reduction='mean'，输出为标量张量（shape []）。",
        "输入 logits 和 target 形状相同，均为 [batch_size, 1]。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.embedding(x)",
      "semantics": [
        "使用 embedding.weight 对输入 x（int64，shape [512, 2000]）进行查表，输出 shape [512, 2000, 128] 的 float32 张量。",
        "输出 device 为 cuda:0，stride [256000, 128, 1]。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = x.mean(dim=1)",
      "semantics": [
        "沿 dim=1（seq_length 维）求均值，输出 shape [512, 128] 的 float32 张量。",
        "输出 device 为 cuda:0，stride [128, 1]。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "logits = self.fc(x)",
      "semantics": [
        "使用 fc.weight 和 fc.bias 进行线性变换，输出 shape [512, 1] 的 float32 张量。",
        "输出 device 为 cuda:0，stride [1, 1]。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "loss = nn.BCEWithLogitsLoss()(logits, target)",
      "semantics": [
        "计算 BCEWithLogitsLoss，默认 reduction='mean'，输出标量 shape [] 的 float32 张量。",
        "输出 device 为 cuda:0。"
      ]
    },
    {
      "checkpoint": "step_005",
      "source": "return (logits, loss)",
      "semantics": [
        "返回元组 (logits, loss)，第一个元素 shape [512, 1]，第二个元素 shape []。"
      ]
    }
  ]
}