--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,50 @@
+#include <cuda_runtime.h>
+
+// Kernel: applies torch.tril(x, offset) on the last two dimensions.
+// All leading dimensions are treated as batch.
+// Output must be preallocated with the same shape as input by the binding.
+__global__ void tril_kernel(const float* __restrict__ input,
+                            float* __restrict__ output,
+                            int64_t total_elements,
+                            int64_t rows,
+                            int64_t cols,
+                            int64_t offset) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+
+    for (int64_t i = idx; i < total_elements; i += stride) {
+        int64_t col = i % cols;
+        int64_t row = (i / cols) % rows;
+        if (row >= col - offset) {
+            output[i] = input[i];
+        } else {
+            output[i] = 0.0f;
+        }
+    }
+}
+
+// Host launcher for the tril operation. No PyTorch dependencies.
+// The caller (binding .cpp) is responsible for:
+//   - allocating output tensor with same shape as input
+//   - passing current CUDA stream
+//   - checking input is CUDA float32 (or ensuring pointer validity)
+extern "C" void tril_forward_launcher(const float* input,
+                                      float* output,
+                                      int64_t total_elements,
+                                      int64_t rows,
+                                      int64_t cols,
+                                      int64_t offset,
+                                      cudaStream_t stream) {
+    if (total_elements <= 0) {
+        return;  // nothing to write
+    }
+
+    int threads = 256;
+    int blocks = (int)((total_elements + threads - 1) / threads);
+    if (blocks > 65535) {
+        blocks = 65535;  // max grid dim x; kernel uses grid-stride loop
+    }
+
+    tril_kernel<<<blocks, threads, 0, stream>>>(input, output, total_elements,
+                                                rows, cols, offset);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,63 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declaration from custom_ops.cu
+extern "C" void tril_forward_launcher(
+    const float* input,
+    float* output,
+    int64_t total_elements,
+    int64_t rows,
+    int64_t cols,
+    int64_t offset,
+    cudaStream_t stream);
+
+// PyTorch wrapper for tril_forward
+torch::Tensor tril_forward(torch::Tensor x, int64_t offset) {
+    // Input validation
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() >= 2, "Input must have at least 2 dimensions");
+
+    // Ensure contiguous for kernel's linear indexing (also correct for strided inputs)
+    auto x_contig = x.contiguous();
+
+    // Allocate output with same shape and contiguous layout
+    auto output = torch::empty_like(x_contig);
+
+    int64_t rows = x_contig.size(-2);
+    int64_t cols = x_contig.size(-1);
+    int64_t total_elements = x_contig.numel();
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Launch CUDA kernel
+    tril_forward_launcher(
+        x_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        total_elements,
+        rows,
+        cols,
+        offset,
+        stream);
+
+    // Check for kernel launch errors
+    TORCH_CHECK(cudaGetLastError() == cudaSuccess, "tril_forward kernel launch failed");
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("tril_forward", &tril_forward,
+          "Lower triangular part of each matrix formed by the last two dimensions",
+          pybind11::arg("x"),
+          pybind11::arg("offset"));
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,16 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, n_channels, tril_offset):
+        super().__init__()
+        self.tril_offset = tril_offset
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return cuda_extension.tril_forward(x, self.tril_offset)
+
+    def debug_forward(self, x: torch.Tensor):
+        out = cuda_extension.tril_forward(x, self.tril_offset)
+        yield 'step_001', out
