--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,102 @@
+#include <cuda_runtime.h>
+
+// CUDA kernel for torch.nn.functional.unfold with stride=1
+// Input: (N, C, H, W) float32 contiguous
+// Output: (N, C * kernel_h * kernel_w, L) float32 contiguous
+// L = out_h * out_w, where out_h = H + 2*padding_h - dilation_h*(kernel_h-1)
+// out_w = W + 2*padding_w - dilation_w*(kernel_w-1)
+// Im2col ordering: for each n, for each c, for each kh, for each kw, then for each output spatial location
+// Output index = ((n * C + c) * kernel_h + kh) * kernel_w + kw) * L + (oh * out_w + ow)
+// Input index = ((n * C + c) * H + (oh + kh*dilation_h - padding_h)) * W + (ow + kw*dilation_w - padding_w)
+__global__ void unfold_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int N, int C, int H, int W,
+    int kernel_h, int kernel_w,
+    int dilation_h, int dilation_w,
+    int padding_h, int padding_w,
+    int out_h, int out_w, int L)
+{
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = N * C * kernel_h * kernel_w * L;
+    if (idx >= total) return;
+
+    // Decompose idx into (n, c, kh, kw, oh, ow)
+    int ow = idx % out_w;
+    int tmp = idx / out_w;
+    int oh = tmp % out_h;
+    tmp /= out_h;
+    int kw = tmp % kernel_w;
+    tmp /= kernel_w;
+    int kh = tmp % kernel_h;
+    tmp /= kernel_h;
+    int c = tmp % C;
+    tmp /= C;
+    int n = tmp;
+
+    int ih = oh + kh * dilation_h - padding_h;
+    int iw = ow + kw * dilation_w - padding_w;
+    float val = 0.0f;
+    if (ih >= 0 && ih < H && iw >= 0 && iw < W) {
+        val = input[((n * C + c) * H + ih) * W + iw];
+    }
+    output[idx] = val;
+}
+
+// CUDA kernel for elementwise sign (matching torch.sign for float32)
+__global__ void sign_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    long long numel)
+{
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    if (idx < numel) {
+        float v = input[idx];
+        // torch.sign returns 1.0 for positive, -1.0 for negative, 0.0 for zero, NaN for NaN
+        // Use comparisons and copysign to handle all cases including NaN
+        output[idx] = (v > 0.0f) ? 1.0f : ((v < 0.0f) ? -1.0f : copysignf(0.0f, v));
+    }
+}
+
+// Launcher for unfold_forward
+// All parameters are raw; the binding layer will allocate output and pass pointers.
+extern "C" void unfold_forward_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    int kernel_h, int kernel_w,
+    int dilation_h, int dilation_w,
+    int padding_h, int padding_w,
+    cudaStream_t stream)
+{
+    int out_h = H + 2 * padding_h - dilation_h * (kernel_h - 1);
+    int out_w = W + 2 * padding_w - dilation_w * (kernel_w - 1);
+    int L = out_h * out_w;
+    int total = N * C * kernel_h * kernel_w * L;
+
+    const int block_size = 256;
+    int grid_size = (total + block_size - 1) / block_size;
+
+    unfold_kernel<<<grid_size, block_size, 0, stream>>>(
+        input, output,
+        N, C, H, W,
+        kernel_h, kernel_w,
+        dilation_h, dilation_w,
+        padding_h, padding_w,
+        out_h, out_w, L);
+}
+
+// Launcher for sign_forward
+extern "C" void sign_forward_launcher(
+    const float* input,
+    float* output,
+    long long numel,
+    cudaStream_t stream)
+{
+    const int block_size = 256;
+    long long grid_size = (numel + block_size - 1) / block_size;
+    if (grid_size > 0) {
+        sign_kernel<<<(unsigned int)grid_size, block_size, 0, stream>>>(
+            input, output, numel);
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,128 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void unfold_forward_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    int kernel_h, int kernel_w,
+    int dilation_h, int dilation_w,
+    int padding_h, int padding_w,
+    cudaStream_t stream);
+
+extern "C" void sign_forward_launcher(
+    const float* input,
+    float* output,
+    long long numel,
+    cudaStream_t stream);
+
+// Helper to check CUDA errors after launch
+static inline void check_cuda_error(const char* msg) {
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, msg, ": ", cudaGetErrorString(err));
+}
+
+// PyTorch wrapper for unfold_forward
+torch::Tensor unfold_forward(
+    torch::Tensor input,
+    int64_t kernel_h,
+    int64_t kernel_w,
+    int64_t dilation_h,
+    int64_t dilation_w,
+    int64_t padding_h,
+    int64_t padding_w)
+{
+    // Input validation
+    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(input.dim() == 4, "Input must be a 4D tensor");
+    TORCH_CHECK(input.scalar_type() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
+
+    int64_t N = input.size(0);
+    int64_t C = input.size(1);
+    int64_t H = input.size(2);
+    int64_t W = input.size(3);
+
+    TORCH_CHECK(kernel_h > 0 && kernel_w > 0, "kernel sizes must be positive");
+    TORCH_CHECK(dilation_h > 0 && dilation_w > 0, "dilations must be positive");
+    TORCH_CHECK(padding_h >= 0 && padding_w >= 0, "padding must be non-negative");
+
+    int64_t out_h = H + 2 * padding_h - dilation_h * (kernel_h - 1);
+    int64_t out_w = W + 2 * padding_w - dilation_w * (kernel_w - 1);
+    TORCH_CHECK(out_h > 0 && out_w > 0, "unfold produces empty output");
+
+    int64_t L = out_h * out_w;
+    int64_t C_times_k = C * kernel_h * kernel_w;
+
+    // Allocate output tensor: [N, C_times_k, L]
+    auto output = torch::empty({N, C_times_k, L}, input.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    unfold_forward_launcher(
+        input.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int>(N),
+        static_cast<int>(C),
+        static_cast<int>(H),
+        static_cast<int>(W),
+        static_cast<int>(kernel_h),
+        static_cast<int>(kernel_w),
+        static_cast<int>(dilation_h),
+        static_cast<int>(dilation_w),
+        static_cast<int>(padding_h),
+        static_cast<int>(padding_w),
+        stream
+    );
+    check_cuda_error("unfold_forward launch failed");
+
+    return output;
+}
+
+// PyTorch wrapper for sign_forward
+torch::Tensor sign_forward(torch::Tensor input) {
+    // Input validation
+    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(input.scalar_type() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
+
+    int64_t numel = input.numel();
+    auto output = torch::empty_like(input);
+
+    if (numel > 0) {
+        cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+        sign_forward_launcher(
+            input.data_ptr<float>(),
+            output.data_ptr<float>(),
+            static_cast<long long>(numel),
+            stream
+        );
+        check_cuda_error("sign_forward launch failed");
+    }
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("unfold_forward", &unfold_forward,
+          "Unfold forward (im2col) with stride 1",
+          py::arg("input"),
+          py::arg("kernel_h"),
+          py::arg("kernel_w"),
+          py::arg("dilation_h"),
+          py::arg("dilation_w"),
+          py::arg("padding_h"),
+          py::arg("padding_w"));
+    m.def("sign_forward", &sign_forward,
+          "Elementwise sign",
+          py::arg("input"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,45 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, kernel_size, dilation, padding):
+        super().__init__()
+        self.kernel_size = kernel_size
+        self.dilation = dilation
+        self.padding = padding
+
+    def forward(self, x):
+        # Move input to CUDA if it is on CPU (reference execution device is CUDA)
+        if x.device.type != 'cuda':
+            x = x.cuda()
+        x = cuda_extension.unfold_forward(
+            x,
+            self.kernel_size[0],
+            self.kernel_size[1],
+            self.dilation[0],
+            self.dilation[1],
+            self.padding[0],
+            self.padding[1]
+        )
+        x = cuda_extension.sign_forward(x)
+        return x
+
+    def debug_forward(self, *inputs):
+        x = inputs[0]
+        if x.device.type != 'cuda':
+            x = x.cuda()
+        unfolded = cuda_extension.unfold_forward(
+            x,
+            self.kernel_size[0],
+            self.kernel_size[1],
+            self.dilation[0],
+            self.dilation[1],
+            self.padding[0],
+            self.padding[1]
+        )
+        yield ('step_001', unfolded)
+        signed = cuda_extension.sign_forward(unfolded)
+        yield ('step_002', signed)
+        yield ('step_003', signed)
