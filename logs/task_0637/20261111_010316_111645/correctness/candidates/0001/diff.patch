+#include <cuda_runtime.h>
+#include <cstdint>
+
+// CUDA kernel for computing max along a specified dimension for a contiguous tensor.
+// Each thread block handles a contiguous range of output elements (one per slice).
+// The input is assumed contiguous and of shape given by outer_size, reduce_size, inner_size.
+// The output (values) has shape outer_size * inner_size (if keepdim=false) or the same with reduced dim size 1.
+// The indices output has the same logical shape as values but with int64 type.
+//
+// We launch a 1D grid of blocks; each block processes chunks of output elements using grid-stride loop.
+// Within a block, threads cooperate to reduce one slice using shared memory.
+
+template <int BLOCK_SIZE>
+__global__ void max_reduce_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ values,
+    int64_t* __restrict__ indices,
+    int64_t outer_size,
+    int64_t reduce_size,
+    int64_t inner_size)
+{
+    // Each block is responsible for one or more output indices, depending on grid-stride.
+    // Total output elements = outer_size * inner_size.
+    int64_t total_outputs = outer_size * inner_size;
+    int64_t global_output_start = blockIdx.x * (int64_t)blockDim.x; // We'll use a block-level stride
+    int64_t block_stride = (int64_t)gridDim.x * blockDim.x;
+
+    // For each output element assigned to this block (using thread 0 as coordinator)
+    for (int64_t out_idx_linear = blockIdx.x * blockDim.x + threadIdx.x;
+         out_idx_linear < total_outputs;
+         out_idx_linear += block_stride)
+    {
+        // Decode outer and inner indices from linear output index
+        int64_t outer = out_idx_linear / inner_size;
+        int64_t inner = out_idx_linear - outer * inner_size;
+
+        // Start index in input for the first element of this reduction slice
+        int64_t base = (outer * reduce_size) * inner_size + inner;
+
+        // Initialize reduction in registers
+        float local_max = -CUDART_INF_F; // negative infinity
+        int64_t local_max_idx = 0;
+
+        // Thread-local reduction over the reduce dimension using grid-stride within the block?
+        // Simpler: each thread handles a subset of reduce elements and then we do shared memory reduction.
+        // Use shared memory for block reduction.
+        __shared__ float smem_values[BLOCK_SIZE];
+        __shared__ int64_t smem_indices[BLOCK_SIZE];
+
+        // Each thread processes multiple elements of the reduction dimension
+        for (int64_t r = threadIdx.x; r < reduce_size; r += BLOCK_SIZE)
+        {
+            float val = input[base + r * inner_size];
+            if (val > local_max || (val == local_max && r < local_max_idx)) {
+                local_max = val;
+                local_max_idx = r;
+            }
+        }
+
+        // Write thread-local results to shared memory
+        smem_values[threadIdx.x] = local_max;
+        smem_indices[threadIdx.x] = local_max_idx;
+        __syncthreads();
+
+        // Tree reduction in shared memory
+        for (int stride = BLOCK_SIZE / 2; stride > 0; stride >>= 1)
+        {
+            if (threadIdx.x < stride)
+            {
+                float other_val = smem_values[threadIdx.x + stride];
+                int64_t other_idx = smem_indices[threadIdx.x + stride];
+                if (other_val > smem_values[threadIdx.x] ||
+                    (other_val == smem_values[threadIdx.x] && other_idx < smem_indices[threadIdx.x]))
+                {
+                    smem_values[threadIdx.x] = other_val;
+                    smem_indices[threadIdx.x] = other_idx;
+                }
+            }
+            __syncthreads();
+        }
+
+        // Thread 0 writes the result
+        if (threadIdx.x == 0)
+        {
+            values[out_idx_linear] = smem_values[0];
+            indices[out_idx_linear] = smem_indices[0];
+        }
+        // Need to sync before next iteration to reuse shared memory safely.
+        __syncthreads();
+    }
+}
+
+// Launcher function: the binding layer will call this with contiguous inputs and allocated outputs.
+// dim: the dimension to reduce (0 <= dim < ndim)
+// keepdim: whether to keep the reduced dimension.
+// We assume input is contiguous, values and indices are allocated with the correct shape.
+// The caller provides pointers and the sizes of the input and output.
+extern "C" void max_forward_launcher(
+    const float* input,
+    float* values,
+    int64_t* indices,
+    int64_t* input_shape,
+    int64_t ndim,
+    int64_t dim,
+    bool keepdim,
+    cudaStream_t stream)
+{
+    if (ndim <= 0) return; // no elements
+
+    // Compute outer_size, reduce_size, inner_size based on dim.
+    int64_t outer_size = 1;
+    for (int64_t i = 0; i < dim; ++i) outer_size *= input_shape[i];
+    int64_t reduce_size = input_shape[dim];
+    int64_t inner_size = 1;
+    for (int64_t i = dim + 1; i < ndim; ++i) inner_size *= input_shape[i];
+
+    int64_t total_outputs = outer_size * inner_size;
+    if (total_outputs == 0) return;
+
+    constexpr int BLOCK_SIZE = 256;
+    // Choose grid size: enough blocks to cover total_outputs / BLOCK_SIZE (each block can process at least one output element),
+    // but not exceed a reasonable limit (e.g., 65535*2 or use grid-stride). We'll use enough blocks to ensure all outputs are covered,
+    // with each block capable of handling multiple outputs via grid-stride loop.
+    int64_t blocks_needed = (total_outputs + BLOCK_SIZE - 1) / BLOCK_SIZE;
+    int grid_size = (int)min(blocks_needed, (int64_t)65535 * 32); // cap to avoid excessive grid size; grid-stride handles the rest
+    if (grid_size < 1) grid_size = 1;
+
+    max_reduce_kernel<BLOCK_SIZE><<<grid_size, BLOCK_SIZE, 0, stream>>>(
+        input, values, indices, outer_size, reduce_size, inner_size);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,86 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_runtime.h>
+#include "../binding_registry.h"
+
+// Declaration of the launcher implemented in custom_ops.cu
+extern "C" void max_forward_launcher(
+    const float* input,
+    float* values,
+    int64_t* indices,
+    int64_t* input_shape,
+    int64_t ndim,
+    int64_t dim,
+    bool keepdim,
+    cudaStream_t stream);
+
+// Wrapper function matching the contract: torch.return_types.max max_forward(torch::Tensor x, int64_t dim, bool keepdim)
+torch::return_types::max max_forward(torch::Tensor x, int64_t dim, bool keepdim) {
+    TORCH_CHECK(x.is_cuda(), "Input tensor must be CUDA");
+    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "Input dtype must be float32");
+
+    // Ensure contiguous; the launcher assumes contiguous input.
+    auto x_contig = x.contiguous();
+
+    int64_t ndim = x_contig.dim();
+    TORCH_CHECK(ndim > 0, "Input tensor must have at least one dimension");
+
+    // Normalize dim
+    if (dim < 0) dim += ndim;
+    TORCH_CHECK(dim >= 0 && dim < ndim, "dim out of range");
+
+    // Compute output shape
+    std::vector<int64_t> out_shape;
+    for (int64_t i = 0; i < ndim; ++i) {
+        if (i == dim) {
+            if (keepdim) out_shape.push_back(1);
+        } else {
+            out_shape.push_back(x_contig.size(i));
+        }
+    }
+
+    auto values = torch::empty(out_shape, x_contig.options());
+    auto indices = torch::empty(out_shape, x_contig.options().dtype(torch::kInt64));
+
+    // Get input shape as int64_t array on host
+    std::vector<int64_t> input_shape(ndim);
+    for (int64_t i = 0; i < ndim; ++i) {
+        input_shape[i] = x_contig.size(i);
+    }
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    max_forward_launcher(
+        x_contig.data_ptr<float>(),
+        values.data_ptr<float>(),
+        indices.data_ptr<int64_t>(),
+        input_shape.data(),
+        ndim,
+        dim,
+        keepdim,
+        stream
+    );
+
+    // Check for kernel launch errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA kernel launch failed: ", cudaGetErrorString(err));
+
+    return {values, indices};
+}
+
+// Registration function
+void register_max_forward(pybind11::module& m) {
+    m.def("max_forward", &max_forward,
+          "Compute torch.max along a dimension (CUDA).\n"
+          "Args:\n"
+          "    x (Tensor): input CUDA float32 tensor\n"
+          "    dim (int): dimension to reduce\n"
+          "    keepdim (bool): whether to keep the reduced dimension\n"
+          "Returns:\n"
+          "    torch.return_types.max: (values, indices)",
+          py::arg("x"), py::arg("dim"), py::arg("keepdim"));
+}
+
+// Auto-register
+REGISTER_BINDING(max_forward, register_max_forward);
--- before/model_new.py
