--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,248 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cudnn.h>
+#include <cstdlib>
+#include <iostream>
+#include "../binding_registry.h"
+
+// Define error checking macros for cuDNN
+#define CUDNN_CHECK(call)                                                                  \
+    do {                                                                                   \
+        cudnnStatus_t status = call;                                                       \
+        if (status != CUDNN_STATUS_SUCCESS) {                                              \
+            std::cerr << "cuDNN error at " << __FILE__ << ":" << __LINE__ << " - "        \
+                      << cudnnGetErrorString(status) << std::endl;                          \
+            throw std::runtime_error("cuDNN error");                                       \
+        }                                                                                  \
+    } while (0)
+
+// Utility to compute conv output shape
+inline void compute_conv_output_shape(int N, int C, int H, int W, int K, int R, int S,
+                                      int pad_h, int pad_w, int stride_h, int stride_w,
+                                      int dilation_h, int dilation_w,
+                                      int& out_H, int& out_W) {
+    out_H = (H + 2 * pad_h - dilation_h * (R - 1) - 1) / stride_h + 1;
+    out_W = (W + 2 * pad_w - dilation_w * (S - 1) - 1) / stride_w + 1;
+}
+
+// Kernel: triu for 4D tensor (N, C, H, W) with diagonal 0, operates on float32
+__global__ void triu_kernel_float(const float* __restrict__ input, float* __restrict__ output,
+                                  int H, int W, long total_elements) {
+    long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long stride = gridDim.x * blockDim.x;
+    for (long i = idx; i < total_elements; i += stride) {
+        int w = i % W;
+        int h = (i / W) % H;
+        // other dimensions (n, c) not needed for condition; we use i directly.
+        if (h <= w) {
+            output[i] = input[i];
+        } else {
+            output[i] = 0.0f;
+        }
+    }
+}
+
+// Kernel: xor operation: input float32 (but should be after triu, values are float bits representing uint8? Actually reference does x.type(torch.uint8) which converts float to uint8 by truncation? PyTorch .type(torch.uint8) on float tensor does C-style cast (truncate towards zero). Then xor with uint8 bias, then .float() converts back to float. So we need to cast float to uint8, xor, then cast to float.
+__global__ void xor_kernel_uint8(const float* __restrict__ input, const float* __restrict__ bias,
+                                 unsigned char* __restrict__ output, int C, int H, int W,
+                                 long total_elements) {
+    long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long stride = gridDim.x * blockDim.x;
+    for (long i = idx; i < total_elements; i += stride) {
+        // Compute c index: (i / (H*W)) % C, but bias shape is (C,1,1) so we use c.
+        long c = (i / (H * W)) % C;
+        unsigned char x_val = static_cast<unsigned char>(input[i]);
+        unsigned char b_val = static_cast<unsigned char>(bias[c]);
+        output[i] = x_val ^ b_val;
+    }
+}
+
+// Kernel: convert uint8 to float
+__global__ void to_float_kernel(const unsigned char* __restrict__ input, float* __restrict__ output,
+                                long total_elements) {
+    long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long stride = gridDim.x * blockDim.x;
+    for (long i = idx; i < total_elements; i += stride) {
+        output[i] = static_cast<float>(input[i]);
+    }
+}
+
+// Conv2d binding function using cuDNN
+torch::Tensor conv2d_forward(torch::Tensor input, torch::Tensor weight, torch::Tensor bias) {
+    TORCH_CHECK(input.is_cuda(), "input must be CUDA");
+    TORCH_CHECK(weight.is_cuda(), "weight must be CUDA");
+    TORCH_CHECK(bias.is_cuda(), "bias must be CUDA");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(weight.dtype() == torch::kFloat32, "weight must be float32");
+    TORCH_CHECK(bias.dtype() == torch::kFloat32, "bias must be float32");
+    TORCH_CHECK(input.is_contiguous(), "input must be contiguous");
+    TORCH_CHECK(weight.is_contiguous(), "weight must be contiguous");
+    TORCH_CHECK(bias.is_contiguous(), "bias must be contiguous");
+
+    // Get dimensions
+    int N = input.size(0);      // batch
+    int C = input.size(1);      // input channels
+    int H = input.size(2);      // input height
+    int W = input.size(3);      // input width
+    int K = weight.size(0);     // output channels
+    int R = weight.size(2);     // kernel height
+    int S = weight.size(3);     // kernel width
+
+    // Conv parameters: stride=1, padding=0, dilation=1 (from model.py)
+    int stride_h = 1, stride_w = 1;
+    int pad_h = 0, pad_w = 0;
+    int dilation_h = 1, dilation_w = 1;
+
+    int out_H, out_W;
+    compute_conv_output_shape(N, C, H, W, K, R, S, pad_h, pad_w, stride_h, stride_w, dilation_h, dilation_w, out_H, out_W);
+
+    auto output = torch::empty({N, K, out_H, out_W}, input.options());
+
+    cudnnHandle_t handle;
+    CUDNN_CHECK(cudnnCreate(&handle));
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    CUDNN_CHECK(cudnnSetStream(handle, stream));
+
+    // Create tensor descriptors
+    cudnnTensorDescriptor_t input_desc, output_desc, bias_desc;
+    cudnnFilterDescriptor_t filter_desc;
+    CUDNN_CHECK(cudnnCreateTensorDescriptor(&input_desc));
+    CUDNN_CHECK(cudnnCreateTensorDescriptor(&output_desc));
+    CUDNN_CHECK(cudnnCreateTensorDescriptor(&bias_desc));
+    CUDNN_CHECK(cudnnCreateFilterDescriptor(&filter_desc));
+
+    // Set input descriptor (N, C, H, W)
+    CUDNN_CHECK(cudnnSetTensor4dDescriptor(input_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT, N, C, H, W));
+    // Set output descriptor (N, K, out_H, out_W)
+    CUDNN_CHECK(cudnnSetTensor4dDescriptor(output_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT, N, K, out_H, out_W));
+    // Set filter descriptor (K, C, R, S)
+    CUDNN_CHECK(cudnnSetFilter4dDescriptor(filter_desc, CUDNN_DATA_FLOAT, CUDNN_TENSOR_NCHW, K, C, R, S));
+    // Bias descriptor: one per output channel
+    CUDNN_CHECK(cudnnSetTensor4dDescriptor(bias_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT, 1, K, 1, 1));
+
+    // Convolution descriptor
+    cudnnConvolutionDescriptor_t conv_desc;
+    CUDNN_CHECK(cudnnCreateConvolutionDescriptor(&conv_desc));
+    CUDNN_CHECK(cudnnSetConvolution2dDescriptor(conv_desc, pad_h, pad_w, stride_h, stride_w, dilation_h, dilation_w,
+                                                CUDNN_CROSS_CORRELATION, CUDNN_DATA_FLOAT));
+
+    // Determine algorithm
+    cudnnConvolutionFwdAlgo_t algo;
+    CUDNN_CHECK(cudnnGetConvolutionForwardAlgorithm_v7(handle, input_desc, filter_desc, conv_desc, output_desc,
+                                                       1, 0, &algo));
+
+    // Workspace size
+    size_t workspace_size = 0;
+    CUDNN_CHECK(cudnnGetConvolutionForwardWorkspaceSize(handle, input_desc, filter_desc, conv_desc, output_desc,
+                                                        algo, &workspace_size));
+
+    void* workspace = nullptr;
+    if (workspace_size > 0) {
+        cudaError_t cuda_status = cudaMalloc(&workspace, workspace_size);
+        TORCH_CHECK(cuda_status == cudaSuccess, "cudaMalloc failed");
+    }
+
+    // Perform convolution
+    float alpha = 1.0f, beta = 0.0f;
+    CUDNN_CHECK(cudnnConvolutionForward(handle, &alpha, input_desc, input.data_ptr<float>(),
+                                        filter_desc, weight.data_ptr<float>(), conv_desc, algo,
+                                        workspace, workspace_size, &beta, output_desc, output.data_ptr<float>()));
+
+    // Add bias using cudnnAddTensor (broadcast along channel dimension)
+    CUDNN_CHECK(cudnnAddTensor(handle, &alpha, bias_desc, bias.data_ptr<float>(), &alpha, output_desc, output.data_ptr<float>()));
+
+    // Cleanup
+    if (workspace) cudaFree(workspace);
+    CUDNN_CHECK(cudnnDestroyConvolutionDescriptor(conv_desc));
+    CUDNN_CHECK(cudnnDestroyFilterDescriptor(filter_desc));
+    CUDNN_CHECK(cudnnDestroyTensorDescriptor(input_desc));
+    CUDNN_CHECK(cudnnDestroyTensorDescriptor(output_desc));
+    CUDNN_CHECK(cudnnDestroyTensorDescriptor(bias_desc));
+    CUDNN_CHECK(cudnnDestroy(handle));
+
+    return output;
+}
+
+// triu binding function
+torch::Tensor triu_forward(torch::Tensor input) {
+    TORCH_CHECK(input.is_cuda(), "input must be CUDA");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(input.dim() == 4, "input must be 4D (N,C,H,W)");
+    // For simplicity, assume contiguous; but we can also handle non-contiguous by making contiguous
+    if (!input.is_contiguous()) {
+        input = input.contiguous();
+    }
+    int N = input.size(0);
+    int C = input.size(1);
+    int H = input.size(2);
+    int W = input.size(3);
+    long total = N * C * H * W;
+    auto output = torch::empty_like(input);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    // Use grid-stride loop, cap blocks to a reasonable number if needed
+    if (blocks > 65535) blocks = 65535; // max grid dim x
+    triu_kernel_float<<<blocks, threads, 0, stream>>>(input.data_ptr<float>(), output.data_ptr<float>(), H, W, total);
+    return output;
+}
+
+// xor binding function
+torch::Tensor xor_forward(torch::Tensor input, torch::Tensor bias) {
+    TORCH_CHECK(input.is_cuda(), "input must be CUDA");
+    TORCH_CHECK(bias.is_cuda(), "bias must be CUDA");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(bias.dtype() == torch::kFloat32, "bias must be float32");
+    TORCH_CHECK(input.dim() == 4, "input must be 4D (N,C,H,W)");
+    // Bias shape should be (C,1,1)
+    TORCH_CHECK(bias.dim() == 3 && bias.size(0) == input.size(1) && bias.size(1) == 1 && bias.size(2) == 1,
+                "bias shape must be (C,1,1)");
+    if (!input.is_contiguous()) input = input.contiguous();
+    if (!bias.is_contiguous()) bias = bias.contiguous();
+
+    int N = input.size(0);
+    int C = input.size(1);
+    int H = input.size(2);
+    int W = input.size(3);
+    long total = N * C * H * W;
+    // Output dtype uint8
+    auto output = torch::empty({N, C, H, W}, input.options().dtype(torch::kUInt8));
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535;
+    xor_kernel_uint8<<<blocks, threads, 0, stream>>>(input.data_ptr<float>(), bias.data_ptr<float>(),
+                                                      output.data_ptr<unsigned char>(), C, H, W, total);
+    return output;
+}
+
+// to_float binding function
+torch::Tensor to_float_forward(torch::Tensor input) {
+    TORCH_CHECK(input.is_cuda(), "input must be CUDA");
+    TORCH_CHECK(input.dtype() == torch::kUInt8, "input must be uint8");
+    if (!input.is_contiguous()) input = input.contiguous();
+    long total = input.numel();
+    auto output = torch::empty_like(input, input.options().dtype(torch::kFloat32));
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535;
+    to_float_kernel<<<blocks, threads, 0, stream>>>(input.data_ptr<unsigned char>(), output.data_ptr<float>(), total);
+    return output;
+}
+
+// Register bindings
+void register_custom_ops(pybind11::module& m) {
+    m.def("conv2d_forward", &conv2d_forward, "Conv2d forward using cuDNN",
+          py::arg("input"), py::arg("weight"), py::arg("bias"));
+    m.def("triu_forward", &triu_forward, "Triu forward", py::arg("input"));
+    m.def("xor_forward", &xor_forward, "Xor forward", py::arg("input"), py::arg("bias"));
+    m.def("to_float_forward", &to_float_forward, "To float forward", py::arg("input"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,26 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, out_channels, kernel_size, bias_shape):
+        super().__init__()
+        self.conv2d = nn.Conv2d(in_channels, out_channels, kernel_size)
+        self.bias = nn.Parameter(torch.randn(bias_shape))
+
+    def forward(self, x):
+        x = cuda_extension.conv2d_forward(x, self.conv2d.weight, self.conv2d.bias)
+        x = cuda_extension.triu_forward(x)
+        x = cuda_extension.xor_forward(x, self.bias)
+        x = cuda_extension.to_float_forward(x)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.conv2d_forward(x, self.conv2d.weight, self.conv2d.bias)
+        yield "step_001", x
+        x = cuda_extension.triu_forward(x)
+        yield "step_002", x
+        x = cuda_extension.xor_forward(x, self.bias)
+        yield "step_003", x
+        x = cuda_extension.to_float_forward(x)
+        yield "step_004", x
