+extern "C" void cast_float_launcher(const uint8_t* input, float* output, int total, cudaStream_t stream);
+
+// Forward declarations of wrapper functions
+static torch::Tensor conv2d_forward(torch::Tensor input, torch::Tensor weight, torch::Tensor bias) {
+    TORCH_CHECK(input.is_cuda() && weight.is_cuda() && bias.is_cuda(), "All tensors must be CUDA");
+    TORCH_CHECK(input.dtype() == torch::kFloat32 && weight.dtype() == torch::kFloat32 && bias.dtype() == torch::kFloat32, "All tensors must be float32");
+    TORCH_CHECK(input.dim() == 4 && weight.dim() == 4 && bias.dim() == 1, "Invalid dimensions");
+    int N = input.size(0), C = input.size(1), H = input.size(2), W = input.size(3);
+    int K = weight.size(0), R = weight.size(2), S = weight.size(3);
+    TORCH_CHECK(weight.size(1) == C, "Weight input channels mismatch");
+    TORCH_CHECK(bias.size(0) == K, "Bias length mismatch");
+    int H_out = H - R + 1, W_out = W - S + 1;
+    auto output = torch::empty({N, K, H_out, W_out}, input.options());
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    conv2d_launcher(input.data_ptr<float>(), weight.data_ptr<float>(), bias.data_ptr<float>(),
+                    output.data_ptr<float>(), N, C, H, W, K, R, S, stream);
+    return output;
+}
+
+static torch::Tensor triu_forward(torch::Tensor input) {
+    TORCH_CHECK(input.is_cuda() && input.dtype() == torch::kFloat32, "Input must be CUDA float32");
+    TORCH_CHECK(input.dim() == 4, "Input must be 4D");
+    int N = input.size(0), C = input.size(1), H = input.size(2), W = input.size(3);
+    auto output = torch::empty_like(input);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    triu_launcher(input.data_ptr<float>(), output.data_ptr<float>(), N, C, H, W, stream);
+    return output;
+}
+
+static torch::Tensor bitwise_xor_forward(torch::Tensor input, torch::Tensor bias) {
+    TORCH_CHECK(input.is_cuda() && bias.is_cuda(), "Input and bias must be CUDA");
+    TORCH_CHECK(input.dtype() == torch::kUInt8, "Input must be uint8");
+    TORCH_CHECK(bias.dtype() == torch::kUInt8, "Bias must be uint8");
+    TORCH_CHECK(input.dim() == 4, "Input must be 4D");
+    int N = input.size(0), C = input.size(1), H = input.size(2), W = input.size(3);
+    // Accept bias of any shape as long as the number of elements equals C
+    TORCH_CHECK(bias.numel() == C, "Bias must have C elements");
+    auto output = torch::empty_like(input);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    // Ensure bias is contiguous
+    auto bias_contig = bias.contiguous();
+    bitwise_xor_launcher(input.data_ptr<uint8_t>(), bias_contig.data_ptr<uint8_t>(), output.data_ptr<uint8_t>(),
+                         N, C, H, W, stream);
+    return output;
+}
+
+static torch::Tensor cast_float_forward(torch::Tensor input) {
+    TORCH_CHECK(input.is_cuda() && input.dtype() == torch::kUInt8, "Input must be CUDA uint8");
+    auto output = torch::empty(input.sizes(), input.options().dtype(torch::kFloat32));
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    cast_float_launcher(input.data_ptr<uint8_t>(), output.data_ptr<float>(), input.numel(), stream);
+    return output;
+}
