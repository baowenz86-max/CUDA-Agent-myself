    "kernels/conv2d_binding.cpp": "#include <torch/types.h>\n#include <torch/csrc/utils/pybind.h>\n#include <cuda_runtime.h>\n#include <c10/cuda/CUDAStream.h>\n#include \"../binding_registry.h\"\n\n// Launcher defined in conv2d_forward.cu\nextern \"C\" void conv2d_launcher(\n    float* output,\n    const float* input,\n    const float* weight,\n    const float* bias,\n    int batch,\n    int in_channels,\n    int in_h,\n    int in_w,\n    int out_channels,\n    int kernel_h,\n    int kernel_w,\n    cudaStream_t stream\n);\n\ntorch::Tensor conv2d_forward(torch::Tensor input, torch::Tensor weight, torch::Tensor bias) {\n    // Input validation\n    TORCH_CHECK(input.is_cuda(), \"Input must be a CUDA tensor\");\n    TORCH_CHECK(weight.is_cuda(), \"Weight must be a CUDA tensor\");\n    TORCH_CHECK(bias.is_cuda(), \"Bias must be a CUDA tensor\");\n    TORCH_CHECK(input.is_contiguous(), \"Input must be contiguous\");\n    TORCH_CHECK(weight.is_contiguous(), \"Weight must be contiguous\");\n    TORCH_CHECK(bias.is_contiguous(), \"Bias must be contiguous\");\n    TORCH_CHECK(input.dtype() == torch::kFloat32, \"Input must be float32\");\n    TORCH_CHECK(weight.dtype() == torch::kFloat32, \"Weight must be float32\");\n    TORCH_CHECK(bias.dtype() == torch::kFloat32, \"Bias must be float32\");\n    TORCH_CHECK(input.dim() == 4, \"Input must be 4D (N,C,H,W)\");\n    TORCH_CHECK(weight.dim() == 4, \"Weight must be 4D (OC,IC,KH,KW)\");\n    TORCH_CHECK(bias.dim() == 1, \"Bias must be 1D\");\n\n    int batch = input.size(0);\n    int in_channels = input.size(1);\n    int in_h = input.size(2);\n    int in_w = input.size(3);\n    int out_channels = weight.size(0);\n    int kernel_h = weight.size(2);\n    int kernel_w = weight.size(3);\n    TORCH_CHECK(weight.size(1) == in_channels, \"weight channels mismatch\");\n    TORCH_CHECK(bias.size(0) == out_channels, \"bias size mismatch\");\n    TORCH_CHECK(kernel_h % 2 == 1 && kernel_w % 2 == 1, \"kernel must be odd\");\n    int out_h = (in_h + 2 * (kernel_h / 2) - kernel_h) + 1;\n    int out_w = (in_w + 2 * (kernel_w / 2) - kernel_w) + 1;\n\n    auto output = torch::empty({batch, out_channels, out_h, out_w}, input.options());\n\n    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n    conv2d_launcher(\n        output.data_ptr<float>(),\n        input.data_ptr<float>(),\n        weight.data_ptr<float>(),\n        bias.data_ptr<float>(),\n        batch,\n        in_channels,\n        in_h,\n        in_w,\n        out_channels,\n        kernel_h,\n        kernel_w,\n        stream\n    );\n\n    return output;\n}\n\nvoid register_conv2d_forward(pybind11::module& m) {\n    m.def(\"conv2d_forward\", &conv2d_forward, \"Conv2d forward using cuDNN\");\n}\n\nREGISTER_BINDING(conv2d_forward, register_conv2d_forward);\n",
    "kernels/triu_binding.cpp": "#include <torch/types.h>\n#include <torch/csrc/utils/pybind.h>\n#include <cuda_runtime.h>\n#include <c10/cuda/CUDAStream.h>\n#include \"../binding_registry.h\"\n\n// Launcher defined in triu_forward.cu\nextern \"C\" void triu_launcher(\n    float* output,\n    const float* input,\n    int batch,\n    int channels,\n    int height,\n    int width,\n    cudaStream_t stream\n);\n\ntorch::Tensor triu_forward(torch::Tensor input) {\n    TORCH_CHECK(input.is_cuda(), \"Input must be CUDA tensor\");\n    TORCH_CHECK(input.is_contiguous(), \"Input must be contiguous\");\n    TORCH_CHECK(input.dtype() == torch::kFloat32, \"Input must be float32\");\n    TORCH_CHECK(input.dim() == 4, \"Input must be 4D (N,C,H,W)\");\n\n    auto output = torch::empty_like(input);\n    int batch = input.size(0);\n    int channels = input.size(1);\n    int height = input.size(2);\n    int width = input.size(3);\n\n    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n    triu_launcher(\n        output.data_ptr<float>(),\n        input.data_ptr<float>(),\n        batch,\n        channels,\n        height,\n        width,\n        stream\n    );\n\n    return output;\n}\n\nvoid register_triu_forward(pybind11::module& m) {\n    m.def(\"triu_forward\", &triu_forward, \"Upper triangular operation\");\n}\n\nREGISTER_BINDING(triu_forward, register_triu_forward);\n",
    "kernels/bitwise_xor_binding.cpp": "#include <torch/types.h>\n#include <torch/csrc/utils/pybind.h>\n#include <cuda_runtime.h>\n#include <c10/cuda/CUDAStream.h>\n#include \"../binding_registry.h\"\n\n// Launcher defined in bitwise_xor_forward.cu\nextern \"C\" void bitwise_xor_launcher(\n    unsigned char* output,\n    const unsigned char* input,\n    const unsigned char* bias,\n    int batch,\n    int channels,\n    int height,\n    int width,\n    cudaStream_t stream\n);\n\ntorch::Tensor bitwise_xor_forward(torch::Tensor input, torch::Tensor bias) {\n    TORCH_CHECK(input.is_cuda(), \"Input must be CUDA tensor\");\n    TORCH_CHECK(bias.is_cuda(), \"Bias must be CUDA tensor\");\n    TORCH_CHECK(input.is_contiguous(), \"Input must be contiguous\");\n    TORCH_CHECK(bias.is_contiguous(), \"Bias must be contiguous\");\n    TORCH_CHECK(input.dtype() == torch::kUInt8, \"Input must be uint8\");\n    TORCH_CHECK(bias.dtype() == torch::kUInt8, \"Bias must be uint8\");\n    TORCH_CHECK(input.dim() == 4, \"Input must be 4D (N,C,H,W)\");\n    TORCH_CHECK(bias.dim() == 3 && bias.size(1) == 1 && bias.size(2) == 1, \"Bias must be shape (C,1,1)\");\n\n    int batch = input.size(0);\n    int channels = input.size(1);\n    int height = input.size(2);\n    int width = input.size(3);\n    TORCH_CHECK(bias.size(0) == channels, \"Bias channels mismatch\");\n\n    auto output = torch::empty_like(input);\n    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n    bitwise_xor_launcher(\n        output.data_ptr<unsigned char>(),\n        input.data_ptr<unsigned char>(),\n        bias.data_ptr<unsigned char>(),\n        batch,\n        channels,\n        height,\n        width,\n        stream\n    );\n\n    return output;\n}\n\nvoid register_bitwise_xor_forward(pybind11::module& m) {\n    m.def(\"bitwise_xor_forward\", &bitwise_xor_forward, \"Bitwise XOR with broadcast bias\");\n}\n\nREGISTER_BINDING(bitwise_xor_forward, register_bitwise_xor_forward);\n",
