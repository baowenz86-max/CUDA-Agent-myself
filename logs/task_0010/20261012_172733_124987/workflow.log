    "model_new.py": "import torch\nimport torch.nn as nn\nimport cuda_extension\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_channels, out_channels, kernel_size, bias_shape):\n        super().__init__()\n        self.conv2d = nn.Conv2d(in_channels, out_channels, kernel_size)\n        self.bias = nn.Parameter(torch.randn(bias_shape))\n\n    def forward(self, x):\n        x = cuda_extension.conv2d_forward(x, self.conv2d.weight, self.conv2d.bias)\n        x = cuda_extension.triu_forward(x)\n        x = cuda_extension.bitwise_xor_forward(x, self.bias)\n        x = cuda_extension.cast_float_forward(x)\n        return x\n\n    def debug_forward(self, x):\n        x = cuda_extension.conv2d_forward(x, self.conv2d.weight, self.conv2d.bias)\n        yield 'step_001', x\n        x = cuda_extension.triu_forward(x)\n        yield 'step_002', x\n        x = cuda_extension.bitwise_xor_forward(x, self.bias)\n        yield 'step_003', x\n        x = cuda_extension.cast_float_forward(x)\n        yield 'step_004', x\n",
    "kernels/conv2d_forward.cu": "#include <torch/types.h>\n#include <torch/csrc/utils/pybind.h>\n#include <cuda_runtime.h>\n#include <c10/cuda/CUDAStream.h>\n#include \"../binding_registry.h\"\n\n// Custom conv2d forward kernel with bias.\n// Assumes input, weight, bias are contiguous float32 tensors.\n// Input layout: NCHW, weight layout: OC,IC,KH,KW.\n__global__ void conv2d_forward_kernel(\n    float* __restrict__ output,\n    const float* __restrict__ input,\n    const float* __restrict__ weight,\n    const float* __restrict__ bias,\n    int batch,\n    int in_channels,\n    int in_h,\n    int in_w,\n    int out_channels,\n    int kernel_h,\n    int kernel_w,\n    int out_h,\n    int out_w\n) {\n    int total_elements = batch * out_channels * out_h * out_w;\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    if (idx >= total_elements) return;\n\n    // Decompose linear index into (n, oc, oh, ow)\n    int ow = idx % out_w;\n    int oh = (idx / out_w) % out_h;\n    int oc = (idx / (out_w * out_h)) % out_channels;\n    int n = idx / (out_w * out_h * out_channels);\n\n    float acc = bias[oc];\n    int pad_h = kernel_h / 2;\n    int pad_w = kernel_w / 2;\n\n    for (int ic = 0; ic < in_channels; ++ic) {\n        for (int kh = 0; kh < kernel_h; ++kh) {\n            int ih = oh + kh - pad_h;\n            if (ih < 0 || ih >= in_h) continue;\n            for (int kw = 0; kw < kernel_w; ++kw) {\n                int iw = ow + kw - pad_w;\n                if (iw < 0 || iw >= in_w) continue;\n                int input_idx = ((n * in_channels + ic) * in_h + ih) * in_w + iw;\n                int weight_idx = ((oc * in_channels + ic) * kernel_h + kh) * kernel_w + kw;\n                acc += input[input_idx] * weight[weight_idx];\n            }\n        }\n    }\n    output[idx] = acc;\n}\n\n// C-style launcher function called from conv2d_binding.cpp\nextern \"C\" void conv2d_launcher(\n    float* output,\n    const float* input,\n    const float* weight,\n    const float* bias,\n    int batch,\n    int in_channels,\n    int in_h,\n    int in_w,\n    int out_channels,\n    int kernel_h,\n    int kernel_w,\n    cudaStream_t stream\n) {\n    int pad_h = kernel_h / 2;\n    int pad_w = kernel_w / 2;\n    int out_h = (in_h + 2 * pad_h - kernel_h) + 1;\n    int out_w = (in_w + 2 * pad_w - kernel_w) + 1;\n    int total_elements = batch * out_channels * out_h * out_w;\n    int threads = 256;\n    int blocks = (total_elements + threads - 1) / threads;\n    conv2d_forward_kernel<<<blocks, threads, 0, stream>>>(\n        output, input, weight, bias,\n        batch, in_channels, in_h, in_w, out_channels, kernel_h, kernel_w, out_h, out_w\n    );\n}\n"
