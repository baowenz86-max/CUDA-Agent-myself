// Cast uint8 tensor to float32.
__global__ void cast_float_forward_kernel(
    const uint8_t* __restrict__ input,
    float* __restrict__ output,
    int total)
{
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= total) return;
    output[idx] = (float)input[idx];
}

