extern "C" void bitwise_xor_launcher(
    const uint8_t* input1,
    const uint8_t* bias,
    uint8_t* output,
    int N, int C, int H, int W,
    cudaStream_t stream);

torch::Tensor bitwise_xor_forward(torch::Tensor input, torch::Tensor bias) {
    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
    TORCH_CHECK(bias.is_cuda(), "Bias must be a CUDA tensor");
    TORCH_CHECK(input.dtype() == torch::kUInt8, "Input must be uint8");
    TORCH_CHECK(bias.dtype() == torch::kUInt8, "Bias must be uint8");
    TORCH_CHECK(input.dim() == 4, "Input must be 4D (N, C, H, W)");
    TORCH_CHECK(bias.dim() == 3, "Bias must be 3D (K, 1, 1)");

    int N = input.size(0);
    int C = input.size(1);
    int H = input.size(2);
    int W = input.size(3);
    int K = bias.size(0);

    TORCH_CHECK(C == K, "Bias size must match channel dimension");
    TORCH_CHECK(bias.size(1) == 1 && bias.size(2) == 1, "Bias must be (K, 1, 1)");

    auto output = torch::empty_like(input);

    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    bitwise_xor_launcher(
        input.data_ptr<uint8_t>(),
        bias.data_ptr<uint8_t>(),
        output.data_ptr<uint8_t>(),
        N, C, H, W,
        stream
    );

    return output;
}

void register_bitwise_xor_forward(pybind11::module& m) {
    m.def("bitwise_xor_forward", &bitwise_xor_forward, "Bitwise XOR forward");
}

REGISTER_BINDING(bitwise_xor, register_bitwise_xor_forward);

===== kernels/bitwise_xor_forward.cu =====
#include <cuda_runtime.h>
#include <stdint.h>

// Bitwise XOR between two uint8 tensors of same shape.
// Input1: (N, C, H, W) uint8 (from triu output cast to uint8)
// Input2: (K, 1, 1) uint8, expanded to (N, C, H, W) via broadcasting along channel dimension.
// Output: (N, C, H, W) uint8.
__global__ void bitwise_xor_forward_kernel(
    const uint8_t* __restrict__ input1,
    const uint8_t* __restrict__ bias, // shape (K,1,1)
    uint8_t* __restrict__ output,
    int N, int C, int H, int W)
{
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int total = N * C * H * W;
    if (idx >= total) return;

    // Compute channel index c = (idx / (H*W)) % C
    int c = (idx / (H * W)) % C;
    uint8_t b = bias[c]; // bias is contiguous size C
    output[idx] = input1[idx] ^ b;
}

extern "C" void bitwise_xor_launcher(
    const uint8_t* input1,
    const uint8_t* bias,
    uint8_t* output,
    int N, int C, int H, int W,
    cudaStream_t stream)
{
    int total = N * C * H * W;
    int threads = 256;
    int blocks = (total + threads - 1) / threads;
    bitwise_xor_forward_kernel<<<blocks, threads, 0, stream>>>(
        input1, bias, output, N, C, H, W);
}

