hen we need to add bias manually.\n    // We'll do a separate elementwise kernel for bias addition.\n    // We'll add a simple kernel in this file for bias addition.\n    // Actually, to keep this file clean, we can launch a simple bias addition kernel here.\n    // But we need output data pointer, bias pointer, etc.\n    // We'll implement a small kernel here.\n\n    // Launch bias addition kernel\n    int total_elements = batch * out_channels * out_h * out_w;\n    int threads = 256;\n    int blocks = (total_elements + threads - 1) / threads;\n    auto bias_add_kernel = [=] __global__ (float* data, const float* bias, int bias_size, int elements_per_channel) {\n        int idx = blockIdx.x * blockDim.x + threadIdx.x;\n        if (idx < total_elements) {\n            int channel = (idx / elements_per_channel) % bias_size;\n            data[idx] += bias[channel];\n        }\n    };\n    bias_add_kernel<<<blocks, threads, 0, stream>>>(output.data_ptr<float>(), bias.data_ptr<float>(),\n                                                    out_channels, out_h * out_w);\n\n    if (workspace) cudaFree(workspace);\n    CHECK_CUDNN(cudnnDestroyTensorDescriptor(in_desc));\n    CHECK_CUDNN(cudnnDestroyTensorDescriptor(out_desc));\n    CHECK_CUDNN(cudnnDestroyFilterDescriptor(filt_desc));\n    CHECK_CUDNN(cudnnDestroyConvolutionDescriptor(conv_desc));\n\n    return output;\n}\n\nvoid register_conv2d_forward(pybind11::module& m) {\n    m.def(\"conv2d_forward\", &conv2d_forward, \"Conv2d forward using cuDNN\");\n}\n\nREGISTER_BINDING(conv2d_forward, register_conv2d_forward);\n",
