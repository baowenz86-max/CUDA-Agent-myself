    "kernels/bitwise_xor_forward.cu": "#include <cuda_runtime.h>\n\n__global__ void bitwise_xor_kernel(unsigned char* output, const unsigned char* input, const unsigned char* bias,\n                                   int channels, int height, int width, int total) {\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    if (idx >= total) return;\n    // Compute channel index for bias broadcast\n    int channel = (idx / (height * width)) % channels;\n    output[idx] = input[idx] ^ bias[channel];\n}\n\nextern \"C\" void bitwise_xor_launcher(\n    unsigned char* output,\n    const unsigned char* input,\n    const unsigned char* bias,\n    int batch,\n    int channels,\n    int height,\n    int width,\n    cudaStream_t stream)\n{\n    int total = batch * channels * height * width;\n    int threads = 256;\n    int blocks = (total + threads - 1) / threads;\n    bitwise_xor_kernel<<<blocks, threads, 0, stream>>>(output, input, bias, channels, height, width, total);\n}\n",
    "kernels/bitwise_xor_binding.cpp": "#include <torch/types.h>\n#include <torch/csrc/utils/pybind.h>\n#include <cuda_runtime.h>\n#include <c10/cuda/CUDAStream.h>\n#include \"../binding_registry.h\"\n\n// Launcher defined in bitwise_xor_forward.cu\nextern \"C\" void bitwise_xor_launcher(\n    unsigned char* output,\n    const unsigned char* input,\n    const unsigned char* bias,\n    int batch,\n    int channels,\n    int height,\n    int width,\n    cudaStream_t stream\n);\n\ntorch::Tensor bitwise_xor_forward(torch::Tensor input, torch::Tensor bias) {\n    TORCH_CHECK(input.is_cuda(), \"Input must be CUDA tensor\");\n    TORCH_CHECK(bias.is_cuda(), \"Bias must be CUDA tensor\");\n    TORCH_CHECK(input.is_contiguous(), \"Input must be contiguous\");\n    TORCH_CHECK(bias.is_contiguous(), \"Bias must be contiguous\");\n    TORCH_CHECK(input.dtype() == torch::kUInt8, \"Input must be uint8\");\n    TORCH_CHECK(bias.dtype() == torch::kUInt8, \"Bias must be uint8\");\n    TORCH_CHECK(input.dim() == 4, \"Input must be 4D (N,C,H,W)\");\n    TORCH_CHECK(bias.dim() == 3 && bias.size(1) == 1 && bias.size(2) == 1, \"Bias must be shape (C,1,1)\");\n\n    int batch = input.size(0);\n    int channels = input.size(1);\n    int height = input.size(2);\n    int width = input.size(3);\n    TORCH_CHECK(bias.size(0) == channels, \"Bias channels mismatch\");\n\n    auto output = torch::empty_like(input);\n    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n    bitwise_xor_launcher(\n        output.data_ptr<unsigned char>(),\n        input.data_ptr<unsigned char>(),\n        bias.data_ptr<unsigned char>(),\n        batch,\n        channels,\n        height,\n        width,\n        stream\n    );\n\n    return output;\n}\n\nvoid register_bitwise_xor_forward(pybind11::module& m) {\n    m.def(\"bitwise_xor_forward\", &bitwise_xor_forward, \"Bitwise XOR with broadcast bias\");\n}\n\nREGISTER_BINDING(bitwise_xor_forward, register_bitwise_xor_forward);\n",
    "kernels/cast_float_forward.cu": "#include <cuda_runtime.h>\n\n__global__ void cast_float_kernel(float* output, const unsigned char* input, int total) {\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    if (idx >= total) return;\n    output[idx] = static_cast<float>(input[idx]);\n}\n\nextern \"C\" void cast_float_launcher(\n    float* output,\n    const unsigned char* input,\n    int total,\n    cudaStream_t stream)\n{\n    int threads = 256;\n    int blocks = (total + threads - 1) / threads;\n    cast_float_kernel<<<blocks, threads, 0, stream>>>(output, input, total);\n}\n",
    "kernels/cast_float_binding.cpp": "#include <torch/types.h>\n#include <torch/csrc/utils/pybind.h>\n#include <cuda_runtime.h>\n#include <c10/cuda/CUDAStream.h>\n#include \"../binding_registry.h\"\n\n// Launcher defined in cast_float_forward.cu\nextern \"C\" void cast_float_launcher(\n    float* output,\n    const unsigned char* input,\n    int total,\n    cudaStream_t stream\n);\n\ntorch::Tensor cast_float_forward(torch::Tensor input) {\n    TORCH_CHECK(input.is_cuda(), \"Input must be CUDA tensor\");\n    TORCH_CHECK(input.is_contiguous(), \"Input must be contiguous\");\n    TORCH_CHECK(input.dtype() == torch::kUInt8, \"Input must be uint8\");\n    TORCH_CHECK(input.dim() == 4, \"Input must be 4D (N,C,H,W)\");\n\n    auto output = torch::empty(input.sizes(), input.options().dtype(torch::kFloat32));\n    int total = input.numel();\n    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n    cast_float_launcher(\n        output.data_ptr<float>(),\n        input.data_ptr<unsigned char>(),\n        total,\n        stream\n    );\n\n    return output;\n}\n\nvoid register_cast_float_forward(pybind11::module& m) {\n    m.def(\"cast_float_forward\", &cast_float_forward, \"Cast uint8 to float32\");\n}\n\nREGISTER_BINDING(cast_float_forward, register_cast_float_forward);\n",
    "kernels/conv2d_forward.cu": "#include <cuda_runtime.h>\n\n__global__ void conv2d_kernel(float* output, const float* input, const float* weight, const float* bias,\n                              int in_channels, int in_h, int in_w, int out_channels, int kernel_h, int kernel_w,\n                              int out_h, int out_w) {\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int total = gridDim.x * blockDim.x; // placeholder, will compute proper total outside\n    // This kernel is not used; conv2d uses cuDNN. Placeholder to avoid compilation issues.\n}\n\nextern \"C\" void conv2d_launcher(\n    float* output,\n    const float* input,\n    const float* weight,\n    const float* bias,\n    int batch,\n    int in_channels,\n    int in_h,\n    int in_w,\n    int out_channels,\n    int kernel_h,\n    int kernel_w,\n    cudaStream_t stream)\n{\n    // Conv2d is handled in conv2d_binding.cpp using cuDNN; this launcher is unused.\n}\n",
    "kernels/conv2d_binding.cpp": "#include <torch/types.h>\n#include <torch/csrc/utils/pybind.h>\n#include <cuda_runtime.h>\n#include <c10/cuda/CUDAStream.h>\n#include <cudnn.h>\n#include <stdexcept>\n#include <vector>\n#include \"../binding_registry.h\"\n\n#define CHECK_CUDNN(expr)                                                                 \\\n    do {                                                                                 \\\n        cudnnStatus_t status = (expr);                                                   \\\n        if (status != CUDNN_STATUS_SUCCESS) {                                            \\\n            throw std::runtime_error(std::string(\"cuDNN error: \") +                     \\\n                                     cudnnGetErrorString(status));                       \\\n        }                                                                                \\\n    } while (0)\n\nextern \"C\" void conv2d_launcher(\n    float* output,\n    const float* input,\n    const float* weight,\n    const float* bias,\n    int batch,\n    int in_channels,\n    int in_h,\n    int in_w,\n    int out_channels,\n    int kernel_h,\n    int kernel_w,\n    cudaStream_t stream\n);\n\nstatic cudnnHandle_t cudnn_handle = nullptr;\n\nstatic void ensure_cudnn_handle() {\n    if (!cudnn_handle) {\n        CHECK_CUDNN(cudnnCreate(&cudnn_handle));\n    }\n}\n\ntorch::Tensor conv2d_forward(torch::Tensor input, torch::Tensor weight, torch::Tensor bias) {\n    // Input validation\n    TORCH_CHECK(input.is_cuda(), \"Input must be a CUDA tensor\");\n    TORCH_CHECK(weight.is_cuda(), \"Weight must be a CUDA tensor\");\n    TORCH_CHECK(bias.is_cuda(), \"Bias must be a CUDA tensor\");\n    TORCH_CHECK(input.is_contiguous(), \"Input must be contiguous\");\n    TORCH_CHECK(weight.is_contiguous(), \"Weight must be contiguous\");\n    TORCH_CHECK(bias.is_contiguous(), \"Bias must be contiguous\");\n    TORCH_CHECK(input.dtype() == torch::kFloat32, \"Input must be float32\");\n    TORCH_CHECK(weight.dtype() == torch::kFloat32, \"Weight must be float32\");\n    TORCH_CHECK(bias.dtype() == torch::kFloat32, \"Bias must be float32\");\n    TORCH_CHECK(input.dim() == 4, \"Input must be 4D (N,C,H,W)\");\n    TORCH_CHECK(weight.dim() == 4, \"Weight must be 4D (OC,IC,KH,KW)\");\n    TORCH_CHECK(bias.dim() == 1, \"Bias must be 1D\");\n\n    int batch = input.size(0);\n    int in_channels = input.size(1);\n    int in_h = input.size(2);\n    int in_w = input.size(3);\n    int out_channels = weight.size(0);\n    int kernel_h = weight.size(2);\n    int kernel_w = weight.size(3);\n    TORCH_CHECK(weight.size(1) == in_channels, \"weight channels mismatch\");\n    TORCH_CHECK(bias.size(0) == out_channels, \"bias size mismatch\");\n    TORCH_CHECK(kernel_h % 2 == 1 && kernel_w % 2 == 1, \"kernel must be odd\");\n    int out_h = (in_h + 2 * (kernel_h / 2) - kernel_h) + 1;\n    int out_w = (in_w + 2 * (kernel_w / 2) - kernel_w) + 1;\n\n    auto output = torch::empty({batch, out_channels, out_h, out_w}, input.options());\n\n    ensure_cudnn_handle();\n    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n    CHECK_CUDNN(cudnnSetStream(cudnn_handle, stream));\n\n    cudnnTensorDescriptor_t in_desc, out_desc;\n    cudnnFilterDescriptor_t filt_desc;\n    cudnnConvolutionDescriptor_t conv_desc;\n    CHECK_CUDNN(cudnnCreateTensorDescriptor(&in_desc));\n    CHECK_CUDNN(cudnnCreateTensorDescriptor(&out_desc));\n    CHECK_CUDNN(cudnnCreateFilterDescriptor(&filt_desc));\n    CHECK_CUDNN(cudnnCreateConvolutionDescriptor(&conv_desc));\n\n    CHECK_CUDNN(cudnnSetTensor4dDescriptor(in_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT,\n                                           batch, in_channels, in_h, in_w));\n    CHECK_CUDNN(cudnnSetTensor4dDescriptor(out_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT,\n                                           batch, out_channels, out_h, out_w));\n    CHECK_CUDNN(cudnnSetFilter4dDescriptor(filt_desc, CUDNN_DATA_FLOAT, CUDNN_TENSOR_NCHW,\n                                           out_channels, in_channels, kernel_h, kernel_w));\n    CHECK_CUDNN(cudnnSetConvolution2dDescriptor(conv_desc, kernel_h / 2, kernel_w / 2, 1, 1, 1, 1,\n                                                CUDNN_CROSS_CORRELATION, CUDNN_DATA_FLOAT));\n\n    cudnnConvolutionFwdAlgo_t algo;\n    CHECK_CUDNN(cudnnGetConvolutionForwardAlgorithm(cudnn_handle, in_desc, filt_desc, conv_desc,\n                                                    out_desc, CUDNN_CONVOLUTION_FWD_PREFER_FASTEST,\n                                                    0, &algo));\n\n    size_t workspace_size = 0;\n    CHECK_CUDNN(cudnnGetConvolutionForwardWorkspaceSize(cudnn_handle, in_desc, filt_desc, conv_desc,\n                                                        out_desc, algo, &workspace_size));\n    void* workspace = nullptr;\n    if (workspace_size > 0) {\n        cudaMalloc(&workspace, workspace_size);\n    }\n\n    float alpha = 1.0f, beta = 0.0f;\n    CHECK_CUDNN(cudnnConvolutionForward(cudnn_handle, &alpha, in_desc, input.data_ptr<float>(),\n                                        filt_desc, weight.data_ptr<float>(), conv_desc, algo,\n                                        workspace, workspace_size, &beta, out_desc, output.data_ptr<float>()));\n\n    // Add bias using cuDNN's tensor add\n    cudnnTensorDescriptor_t bias_desc;\n    CHECK_CUDNN(cudnnCreateTensorDescriptor(&bias_desc));\n    CHECK_CUDNN(cudnnSetTensor4dDescriptor(bias_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT,\n                                           1, out_channels, 1, 1));\n    CHECK_CUDNN(cudnnAddTensor(cudnn_handle, &alpha, bias_desc, bias.data_ptr<float>(),\n                               &alpha, out_desc, output.data_ptr<float>()));\n\n    if (workspace) cudaFree(workspace);\n    CHECK_CUDNN(cudnnDestroyTensorDescriptor(in_desc));\n    CHECK_CUDNN(cudnnDestroyTensorDescriptor(out_desc));\n    CHECK_CUDNN(cudnnDestroyFilterDescriptor(filt_desc));\n    CHECK_CUDNN(cudnnDestroyConvolutionDescriptor(conv_desc));\n    CHECK_CUDNN(cudnnDestroyTensorDescriptor(bias_desc));\n\n    return output;\n}\n\nvoid register_conv2d_forward(pybind11::module& m) {\n    m.def(\"conv2d_forward\", &conv2d_forward, \"Conv2d forward using cuDNN\");\n}\n\nREGISTER_BINDING(conv2d_forward, register_conv2d_forward);\n",
    "kernels/triu_forward.cu": "#include <cuda_runtime.h>\n\n__global__ void triu_kernel(float* output, const float* input, int batch, int channels, int height, int width) {\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int total = batch * channels * height * width;\n    if (idx >= total) return;\n\n    int w = idx % width;\n    int h = (idx / width) % height;\n    output[idx] = (w >= h) ? input[idx] : 0.0f;\n}\n\nextern \"C\" void triu_launcher(\n    float* output,\n    const float* input,\n    int batch,\n    int channels,\n    int height,\n    int width,\n    cudaStream_t stream)\n{\n    int total = batch * channels * height * width;\n    int threads = 256;\n    int blocks = (total + threads - 1) / threads;\n    triu_kernel<<<blocks, threads, 0, stream>>>(output, input, batch, channels, height, width);\n}\n",
    "kernels/triu_binding.cpp": "#include <torch/types.h>\n#include <torch/csrc/utils/pybind.h>\n#include <cuda_runtime.h>\n#include <c10/cuda/CUDAStream.h>\n#include \"../binding_registry.h\"\n\n// Launcher defined in triu_forward.cu\nextern \"C\" void triu_launcher(\n    float* output,\n    const float* input,\n    int batch,\n    int channels,\n    int height,\n    int width,\n    cudaStream_t stream\n);\n\ntorch::Tensor triu_forward(torch::Tensor input) {\n    TORCH_CHECK(input.is_cuda(), \"Input must be CUDA tensor\");\n    TORCH_CHECK(input.is_contiguous(), \"Input must be contiguous\");\n    TORCH_CHECK(input.dtype() == torch::kFloat32, \"Input must be float32\");\n    TORCH_CHECK(input.dim() == 4, \"Input must be 4D (N,C,H,W)\");\n\n    auto output = torch::empty_like(input);\n    int batch = input.size(0);\n    int channels = input.size(1);\n    int height = input.size(2);\n    int width = input.size(3);\n\n    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n    triu_launcher(\n        output.data_ptr<float>(),\n        input.data_ptr<float>(),\n        batch,\n        channels,\n        height,\n        width,\n        stream\n    );\n\n    return output;\n}\n\nvoid register_triu_forward(pybind11::module& m) {\n    m.def(\"triu_forward\", &triu_forward, \"Upper triangular operation\");\n}\n\nREGISTER_BINDING(triu_forward, register_triu_forward);\n"
  }
