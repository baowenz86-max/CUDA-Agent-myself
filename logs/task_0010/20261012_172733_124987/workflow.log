#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>
#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

extern "C" void conv2d_launcher(
    const float* input,
    const float* weight,
    const float* bias,
    float* output,
    int N, int C, int H, int W,
    int K, int R, int S,
    cudaStream_t stream);

torch::Tensor conv2d_forward(torch::Tensor input, torch::Tensor weight, torch::Tensor bias) {
    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
    TORCH_CHECK(weight.is_cuda(), "Weight must be a CUDA tensor");
    TORCH_CHECK(bias.is_cuda(), "Bias must be a CUDA tensor");
    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
    TORCH_CHECK(weight.dtype() == torch::kFloat32, "Weight must be float32");
    TORCH_CHECK(bias.dtype() == torch::kFloat32, "Bias must be float32");
    TORCH_CHECK(input.dim() == 4, "Input must be 4D (N, C, H, W)");
    TORCH_CHECK(weight.dim() == 4, "Weight must be 4D (K, C, R, S)");
    TORCH_CHECK(bias.dim() == 1, "Bias must be 1D (K)");

    int N = input.size(0);
    int C = input.size(1);
    int H = input.size(2);
    int W = input.size(3);
    int K = weight.size(0);
    int R = weight.size(2);
    int S = weight.size(3);

    TORCH_CHECK(weight.size(1) == C, "Weight input channels must match input channels");
    TORCH_CHECK(bias.size(0) == K, "Bias size must match output channels");
    TORCH_CHECK(H >= R && W >= S, "Input spatial dimensions must be >= kernel size");

    int H_out = H - R + 1;
    int W_out = W - S + 1;
    auto output = torch::empty({N, K, H_out, W_out}, input.options());

    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    conv2d_launcher(
        input.data_ptr<float>(),
        weight.data_ptr<float>(),
        bias.data_ptr<float>(),
        output.data_ptr<float>(),
        N, C, H, W,
        K, R, S,
        stream
    );

    return output;
}

void register_conv2d_forward(pybind11::module& m) {
    m.def("conv2d_forward", &conv2d_forward, "Conv2d forward");
}

REGISTER_BINDING(conv2d, register_conv2d_forward);

===== kernels/conv2d_forward.cu =====
#include <cuda_runtime.h>

// Custom Conv2d forward kernel for small filter (3x3) and large batch.
// Each thread computes one output element.
// Input: (N, C, H, W) float32, weight: (K, C, R, S) float32, bias: (K,) float32
// Output: (N, K, H_out, W_out) float32
// Padding is implicit: output size = H - R + 1, W - S + 1 (valid convolution).
// The reference uses nn.Conv2d with default padding=0.
__global__ void conv2d_forward_kernel(
    const float* __restrict__ input,
    const float* __restrict__ weight,
    const float* __restrict__ bias,
    float* __restrict__ output,
    int N, int C, int H, int W,
    int K, int R, int S)
{
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int total = N * K * (H - R + 1) * (W - S + 1);
    if (idx >= total) return;

    int H_out = H - R + 1;
    int W_out = W - S + 1;
    int out_per_batch_k = H_out * W_out;
    // Decompose linear index to n, k, h_out, w_out
    int n = idx / (K * out_per_batch_k);
    int rem = idx % (K * out_per_batch_k);
    int k = rem / out_per_batch_k;
    int spatial = rem % out_per_batch_k;
    int h_out = spatial / W_out;
    int w_out = spatial % W_out;

    float sum = bias[k];
    for (int c = 0; c < C; ++c) {
        for (int r = 0; r < R; ++r) {
            for (int s = 0; s < S; ++s) {
                int h_in = h_out + r;
                int w_in = w_out + s;
                sum += input[((n * C + c) * H + h_in) * W + w_in] *
                       weight[((k * C + c) * R + r) * S + s];
            }
        }
    }
    output[idx] = sum;
}

extern "C" void conv2d_launcher(
    const float* input,
    const float* weight,
    const float* bias,
    float* output,
    int N, int C, int H, int W,
    int K, int R, int S,
    cudaStream_t stream)
{
    int H_out = H - R + 1;
    int W_out = W - S + 1;
    int total = N * K * H_out * W_out;
    int threads = 256;
    int blocks = (total + threads - 1) / threads;
    conv2d_forward_kernel<<<blocks, threads, 0, stream>>>(
        input, weight, bias, output,
        N, C, H, W, K, R, S);
}

