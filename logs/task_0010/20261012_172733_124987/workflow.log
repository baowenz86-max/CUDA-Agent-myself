        self.conv2d = nn.Conv2d(in_channels, out_channels, kernel_size)
        self.bias = nn.Parameter(torch.randn(bias_shape))

    def forward(self, x):
        x = cuda_extension.conv2d_forward(x, self.conv2d.weight, self.conv2d.bias)
        x = cuda_extension.triu_forward(x)
        x_uint8 = x.to(torch.uint8)  # cast to uint8 (custom op will be implemented as a kernel)
        bias_uint8 = self.bias.to(torch.uint8)
        x_uint8 = cuda_extension.bitwise_xor_forward(x_uint8, bias_uint8)
        x = cuda_extension.cast_float_forward(x_uint8)
        return x

    def debug_forward(self, x):
        x = cuda_extension.conv2d_forward(x, self.conv2d.weight, self.conv2d.bias)
        yield "step_001", x
        x = cuda_extension.triu_forward(x)
        yield "step_002", x
        x_uint8 = x.to(torch.uint8)
        bias_uint8 = self.bias.to(torch.uint8)
        x_uint8 = cuda_extension.bitwise_xor_forward(x_uint8, bias_uint8)
        yield "step_003", x_uint8
        x = cuda_extension.cast_float_forward(x_uint8)
        yield "step_004", x


