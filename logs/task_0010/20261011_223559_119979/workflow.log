#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>

#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include <stdint.h>
#include "../binding_registry.h"

// Declaration of the launcher from bitwise_xor_uint8_forward.cu
extern "C" void bitwise_xor_uint8_forward_launcher(
    uint8_t* output,
    const uint8_t* x,
    const uint8_t* bias,
    int64_t num_elements,
    int64_t HW,
    int64_t C,
    cudaStream_t stream);

// PyTorch wrapper
at::Tensor bitwise_xor_uint8_forward(at::Tensor x, at::Tensor bias) {
    // Validate inputs
    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
    TORCH_CHECK(bias.is_cuda(), "bias must be a CUDA tensor");
    TORCH_CHECK(x.dtype() == at::kByte, "x must be uint8");
    TORCH_CHECK(bias.dtype() == at::kByte, "bias must be uint8");
    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
    TORCH_CHECK(bias.is_contiguous(), "bias must be contiguous");

    // x shape: (N, C, H, W)
    // bias shape: (C, 1, 1)
    auto x_sizes = x.sizes();
    auto bias_sizes = bias.sizes();
    TORCH_CHECK(x_sizes.size() == 4, "x must be 4D");
    TORCH_CHECK(bias_sizes.size() == 3, "bias must be 3D");
    TORCH_CHECK(bias_sizes[0] == x_sizes[1], "bias size[0] must match x's channel dimension");
    TORCH_CHECK(bias_sizes[1] == 1 && bias_sizes[2] == 1, "bias must have shape (C, 1, 1)");

    int64_t N = x_sizes[0];
    int64_t C = x_sizes[1];
    int64_t H = x_sizes[2];
    int64_t W = x_sizes[3];
    int64_t HW = H * W;
    int64_t num_elements = x.numel();

    // Allocate output tensor with same shape as x
    auto output = at::empty_like(x);

    // Get current CUDA stream
    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    // Call launcher
    bitwise_xor_uint8_forward_launcher(
        output.data_ptr<uint8_t>(),
        x.data_ptr<uint8_t>(),
        bias.data_ptr<uint8_t>(),
        num_elements,
        HW,
        C,
        stream);

    return output;
}

// Registration function
void register_bitwise_xor_uint8_forward(pybind11::module& m) {
    m.def("bitwise_xor_uint8_forward", &bitwise_xor_uint8_forward,
          "Bitwise XOR with broadcasting for uint8 tensors",
          pybind11::arg("x"), pybind11::arg("bias"));
}

// Auto-register
REGISTER_BINDING(bitwise_xor_uint8_forward, register_bitwise_xor_uint8_forward);

===== kernels/triu_forward.cu =====
#include <cuda_runtime.h>
#include <stdint.h>
#include <cuda_fp16.h>

// Kernel to zero out elements below the diagonal in each 2D slice of the input tensor.
// Input tensor shape: (N, C, H, W), treated as N*C matrices of size H x W (row-major).
// For each matrix, elements with col index < row index + diagonal are set to zero.
template<typename T>
__global__ void triu_kernel(T* output, const T* input, int num_elements, int rows, int cols, int diagonal) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= num_elements) return;

    // Map linear index to (batch, row, col)
    int matrix_stride = rows * cols;
    int in_matrix = idx % matrix_stride;
    int row = in_matrix / cols;
    int col = in_matrix % cols;

    // Apply upper triangular mask: keep if col >= row + diagonal
    output[idx] = (col >= (row + diagonal)) ? input[idx] : T(0);
}

// Launcher function exported for binding
extern "C" void triu_forward_launcher(
    void* output,
    const void* input,
    int64_t num_elements,
    int64_t rows,
    int64_t cols,
    int64_t diagonal,
    int64_t dtype,
    cudaStream_t stream) {

    int threads = 256;
    int blocks = (int)((num_elements + threads - 1) / threads);

    // dtype: 0=float32, 1=float64, 2=half, 3=uint8, 4=int32, 5=int64, 6=bool
    switch(dtype) {
        case 0: triu_kernel<float><<<blocks, threads, 0, stream>>>(
                    (float*)output, (const float*)input, (int)num_elements, (int)rows, (int)cols, (int)diagonal); break;
        case 1: triu_kernel<double><<<blocks, threads, 0, stream>>>(
                    (double*)output, (const double*)input, (int)num_elements, (int)rows, (int)cols, (int)diagonal); break;
        case 2: triu_kernel<__half><<<blocks, threads, 0, stream>>>(
                    (__half*)output, (const __half*)input, (int)num_elements, (int)rows, (int)cols, (int)diagonal); break;
        case 3: triu_kernel<uint8_t><<<blocks, threads, 0, stream>>>(
                    (uint8_t*)output, (const uint8_t*)input, (int)num_elements, (int)rows, (int)cols, (int)diagonal); break;
        case 4: triu_kernel<int><<<blocks, threads, 0, stream>>>(
                    (int*)output, (const int*)input, (int)num_elements, (int)rows, (int)cols, (int)diagonal); break;
        case 5: triu_kernel<int64_t><<<blocks, threads, 0, stream>>>(
                    (int64_t*)output, (const int64_t*)input, (int)num_elements, (int)rows, (int)cols, (int)diagonal); break;
        case 6: triu_kernel<bool><<<blocks, threads, 0, stream>>>(
                    (bool*)output, (const bool*)input, (int)num_elements, (int)rows, (int)cols, (int)diagonal); break;
    }
}

===== kernels/triu_forward_binding.cpp =====
#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>

#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include <stdint.h>
#include "../binding_registry.h"

// Declaration of the launcher from triu_forward.cu
extern "C" void triu_forward_launcher(
    void* output,
    const void* input,
    int64_t num_elements,
    int64_t rows,
    int64_t cols,
    int64_t diagonal,
    int64_t dtype,
    cudaStream_t stream);

// Helper to map torch dtype to dtype code used in launcher
static int64_t get_dtype_code(const at::Tensor& t) {
    auto dtype = t.scalar_type();
    if (dtype == at::kFloat) return 0;
    if (dtype == at::kDouble) return 1;
    if (dtype == at::kHalf) return 2;
    if (dtype == at::kByte) return 3;
    if (dtype == at::kInt) return 4;
    if (dtype == at::kLong) return 5;
    if (dtype == at::kBool) return 6;
    TORCH_CHECK(false, "Unsupported dtype for triu_forward");
}

// PyTorch wrapper
at::Tensor triu_forward(at::Tensor input, int64_t diagonal = 0) {
    // Validate input
    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
    TORCH_CHECK(input.is_contiguous(), "input must be contiguous");
    TORCH_CHECK(input.dim() >= 2, "input must have at least 2 dimensions");

    // For triu, we treat the last two dimensions as matrix dimensions.
    // The input shape is (N, C, H, W) -> N*C matrices of size H x W.
    int64_t rows = input.size(-2);
    int64_t cols = input.size(-1);
    int64_t num_matrices = 1;
    for (int64_t i = 0; i < input.dim() - 2; ++i) {
        num_matrices *= input.size(i);
    }
    int64_t num_elements = input.numel();

    // Allocate output tensor with same shape as input
    auto output = at::empty_like(input);

    // Get current CUDA stream
    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    // Get dtype code
    int64_t dtype_code = get_dtype_code(input);

    // Call launcher
    triu_forward_launcher(
        output.data_ptr(),
        input.data_ptr(),
        num_elements,
        rows,
        cols,
        diagonal,
        dtype_code,
        stream);

    return output;
}

// Registration function
void register_triu_forward(pybind11::module& m) {
    m.def("triu_forward", &triu_forward,
          "Upper triangular mask operation",
          pybind11::arg("input"), pybind11::arg("diagonal") = 0);
}

// Auto-register
REGISTER_BINDING(triu_forward, register_triu_forward);
