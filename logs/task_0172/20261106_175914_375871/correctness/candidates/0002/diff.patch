+// ------------------ Conv2d custom kernel implementation ------------------
+// Since cuDNN is unavailable, we implement a straightforward 2D convolution.
+// This kernel assumes input and weight are contiguous.
+// Parameters: stride_h, stride_w, pad_h, pad_w, dilation_h, dilation_w.
+__global__ void conv2d_kernel(
+    const float* __restrict__ input,
+    const float* __restrict__ weight,
+    float* __restrict__ output,
+    int batch,
+    int in_channels,
+    int in_h,
+    int in_w,
+    int out_channels,
+    int out_h,
+    int out_w,
+    int k_h,
+    int k_w,
+    int stride_h,
+    int stride_w,
+    int pad_h,
+    int pad_w,
+    int dilation_h,
+    int dilation_w
+) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = batch * out_channels * out_h * out_w;
+    if (idx >= total) return;
+
+    // Decompose idx into n, oc, oh, ow
+    int ow = idx % out_w;
+    int tmp = idx / out_w;
+    int oh = tmp % out_h;
+    tmp /= out_h;
+    int oc = tmp % out_channels;
+    int n = tmp / out_channels;
+
+    float sum = 0.0f;
+    for (int ic = 0; ic < in_channels; ++ic) {
+        for (int kh = 0; kh < k_h; ++kh) {
+            for (int kw = 0; kw < k_w; ++kw) {
+                int ih = oh * stride_h - pad_h + kh * dilation_h;
+                int iw = ow * stride_w - pad_w + kw * dilation_w;
+                if (ih >= 0 && ih < in_h && iw >= 0 && iw < in_w) {
+                    int input_idx = ((n * in_channels + ic) * in_h + ih) * in_w + iw;
+                    int weight_idx = ((oc * in_channels + ic) * k_h + kh) * k_w + kw;
+                    sum += input[input_idx] * weight[weight_idx];
+                }
+            }
+        }
+    }
+    output[idx] = sum;
+}
+
+// Launcher for conv2d.
+extern "C" void conv2d_launcher(
+    const float* input,
+    const float* weight,
+    float* output,
+    int batch,
+    int in_channels,
+    int in_h,
+    int in_w,
+    int out_channels,
+    int out_h,
+    int out_w,
+    int k_h,
+    int k_w,
+    int stride_h,
+    int stride_w,
+    int pad_h,
+    int pad_w,
+    int dilation_h,
+    int dilation_w,
+    cudaStream_t stream
+) {
+    int total = batch * out_channels * out_h * out_w;
+    if (total == 0) return;
+
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+
+    conv2d_kernel<<<blocks, threads, 0, stream>>>(
+        input, weight, output,
+        batch, in_channels, in_h, in_w,
+        out_channels, out_h, out_w,
+        k_h, k_w,
+        stride_h, stride_w, pad_h, pad_w,
+        dilation_h, dilation_w
+    );
+
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // leave for binding to check
+    }
+}
