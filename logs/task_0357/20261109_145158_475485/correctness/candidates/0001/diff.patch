--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,131 @@
+#include <cuda_runtime.h>
+#include <math.h>
+
+// Maximum pooling 2D kernel with arbitrary strides.
+// Output shape: [N, C, outH, outW]
+// Input shape: [N, C, inH, inW]
+// Input strides: in_N_stride, in_C_stride, in_H_stride, in_W_stride
+// Output is contiguous, but we can use index calculation from output coordinates.
+__global__ void maxpool2d_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int N, int C, int inH, int inW,
+    int outH, int outW,
+    int kernelH, int kernelW,
+    int strideH, int strideW,
+    int paddingH, int paddingW,
+    int dilationH, int dilationW,
+    long long in_N_stride, long long in_C_stride, long long in_H_stride, long long in_W_stride
+) {
+    int total = N * C * outH * outW;
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+
+    for (int i = idx; i < total; i += stride) {
+        int ow = i % outW;
+        int tmp = i / outW;
+        int oh = tmp % outH;
+        tmp /= outH;
+        int c = tmp % C;
+        int n = tmp / C;
+
+        int start_h = oh * strideH - paddingH;
+        int start_w = ow * strideW - paddingW;
+
+        float max_val = -FLT_MAX;
+        for (int kh = 0; kh < kernelH; ++kh) {
+            int ih = start_h + kh * dilationH;
+            if (ih < 0 || ih >= inH) continue;
+            for (int kw = 0; kw < kernelW; ++kw) {
+                int iw = start_w + kw * dilationW;
+                if (iw < 0 || iw >= inW) continue;
+
+                long long input_offset = (long long)n * in_N_stride
+                                      + (long long)c * in_C_stride
+                                      + (long long)ih * in_H_stride
+                                      + (long long)iw * in_W_stride;
+                float val = input[input_offset];
+                if (val > max_val) max_val = val;
+            }
+        }
+        output[i] = max_val;
+    }
+}
+
+// ELU kernel. output[i] = x > 0 ? x : alpha * (expf(x) - 1)
+__global__ void elu_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    long long numel,
+    float alpha
+) {
+    long long idx = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+
+    for (long long i = idx; i < numel; i += stride) {
+        float x = input[i];
+        output[i] = x > 0.0f ? x : alpha * (expf(x) - 1.0f);
+    }
+}
+
+// Launcher for custom_maxpool2d.
+// Signature matches binding expectations: (const float*, float*, int N, int C, int inH, int inW,
+//   int outH, int outW, int kernelH, int kernelW, int strideH, int strideW, int paddingH, int paddingW,
+//   int dilationH, int dilationW, long long in_N_stride, long long in_C_stride, long long in_H_stride, long long in_W_stride,
+//   cudaStream_t stream)
+extern "C" void custom_maxpool2d_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int inH, int inW,
+    int outH, int outW,
+    int kernelH, int kernelW,
+    int strideH, int strideW,
+    int paddingH, int paddingW,
+    int dilationH, int dilationW,
+    long long in_N_stride, long long in_C_stride, long long in_H_stride, long long in_W_stride,
+    cudaStream_t stream
+) {
+    int total = N * C * outH * outW;
+    const int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    if (blocks < 1) blocks = 1;
+
+    maxpool2d_kernel<<<blocks, threads, 0, stream>>>(
+        input, output,
+        N, C, inH, inW,
+        outH, outW,
+        kernelH, kernelW,
+        strideH, strideW,
+        paddingH, paddingW,
+        dilationH, dilationW,
+        in_N_stride, in_C_stride, in_H_stride, in_W_stride
+    );
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // In a library we cannot throw exceptions directly; the binding should check on next cuda op.
+        // But we can call cudaDeviceSynchronize? Better to leave as is; binding should handle errors.
+    }
+}
+
+// Launcher for custom_elu.
+extern "C" void custom_elu_launcher(
+    const float* input,
+    float* output,
+    long long numel,
+    float alpha,
+    cudaStream_t stream
+) {
+    const int threads = 256;
+    long long blocks_ll = (numel + threads - 1) / threads;
+    if (blocks_ll < 1) blocks_ll = 1;
+    if (blocks_ll > 2147483647LL) blocks_ll = 2147483647LL; // grid dimension limit
+    int blocks = (int)blocks_ll;
+
+    elu_kernel<<<blocks, threads, 0, stream>>>(
+        input, output, numel, alpha
+    );
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // Ignore error; binding should use cudaDeviceSynchronize and check.
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,135 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void custom_maxpool2d_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int inH, int inW,
+    int outH, int outW,
+    int kernelH, int kernelW,
+    int strideH, int strideW,
+    int paddingH, int paddingW,
+    int dilationH, int dilationW,
+    long long in_N_stride, long long in_C_stride, long long in_H_stride, long long in_W_stride,
+    cudaStream_t stream
+);
+
+extern "C" void custom_elu_launcher(
+    const float* input,
+    float* output,
+    long long numel,
+    float alpha,
+    cudaStream_t stream
+);
+
+torch::Tensor custom_maxpool2d(
+    torch::Tensor x,
+    int64_t kernel_h, int64_t kernel_w,
+    int64_t stride_h, int64_t stride_w,
+    int64_t padding_h, int64_t padding_w,
+    int64_t dilation_h, int64_t dilation_w,
+    bool ceil_mode
+) {
+    TORCH_CHECK(x.is_cuda(), "custom_maxpool2d: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "custom_maxpool2d: input must be float32");
+    TORCH_CHECK(x.dim() == 4, "custom_maxpool2d: input must be 4D (N, C, H, W)");
+    TORCH_CHECK(kernel_h > 0 && kernel_w > 0, "custom_maxpool2d: kernel sizes must be positive");
+    TORCH_CHECK(stride_h > 0 && stride_w > 0, "custom_maxpool2d: strides must be positive");
+    TORCH_CHECK(dilation_h > 0 && dilation_w > 0, "custom_maxpool2d: dilations must be positive");
+    // ceil_mode is not implemented in the CUDA kernel, but contract says false; we ignore it (and maybe warn in future)
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t inH = x.size(2);
+    int64_t inW = x.size(3);
+
+    int64_t outH, outW;
+    if (ceil_mode) {
+        outH = (inH + 2 * padding_h - dilation_h * (kernel_h - 1) - 1 + stride_h - 1) / stride_h + 1;
+        outW = (inW + 2 * padding_w - dilation_w * (kernel_w - 1) - 1 + stride_w - 1) / stride_w + 1;
+    } else {
+        outH = (inH + 2 * padding_h - dilation_h * (kernel_h - 1) - 1) / stride_h + 1;
+        outW = (inW + 2 * padding_w - dilation_w * (kernel_w - 1) - 1) / stride_w + 1;
+    }
+    TORCH_CHECK(outH > 0 && outW > 0, "custom_maxpool2d: invalid output size");
+
+    auto output = torch::empty({N, C, outH, outW}, x.options());
+
+    // Handle strides: input might be non-contiguous; get strides in elements
+    auto strides = x.strides();
+    long long in_N_stride = strides[0];
+    long long in_C_stride = strides[1];
+    long long in_H_stride = strides[2];
+    long long in_W_stride = strides[3];
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_maxpool2d_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        (int)N, (int)C, (int)inH, (int)inW,
+        (int)outH, (int)outW,
+        (int)kernel_h, (int)kernel_w,
+        (int)stride_h, (int)stride_w,
+        (int)padding_h, (int)padding_w,
+        (int)dilation_h, (int)dilation_w,
+        in_N_stride, in_C_stride, in_H_stride, in_W_stride,
+        stream
+    );
+
+    // Check for kernel launch errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "custom_maxpool2d: kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+torch::Tensor custom_elu(torch::Tensor x, double alpha) {
+    TORCH_CHECK(x.is_cuda(), "custom_elu: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "custom_elu: input must be float32");
+
+    // ELU is elementwise, output shape same as input
+    auto output = torch::empty_like(x);
+
+    long long numel = x.numel();
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_elu_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        numel,
+        (float)alpha,
+        stream
+    );
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "custom_elu: kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_maxpool2d", &custom_maxpool2d,
+          "Custom 2D max pooling",
+          py::arg("x"),
+          py::arg("kernel_h") = 3,
+          py::arg("kernel_w") = 5,
+          py::arg("stride_h") = 2,
+          py::arg("stride_w") = 2,
+          py::arg("padding_h") = 0,
+          py::arg("padding_w") = 0,
+          py::arg("dilation_h") = 1,
+          py::arg("dilation_w") = 1,
+          py::arg("ceil_mode") = false);
+
+    m.def("custom_elu", &custom_elu,
+          "Custom ELU activation",
+          py::arg("x"),
+          py::arg("alpha") = 1.0);
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
