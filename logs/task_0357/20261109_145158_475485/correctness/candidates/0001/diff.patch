+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, kernel_size, pooling_size):
+        super().__init__()
+        # 不创建可学习参数，保持 state_dict 与参考一致（为空）
+
+    def forward(self, x):
+        pooled = cuda_extension.custom_maxpool2d(
+            x,
+            kernel_h=3,
+            kernel_w=5,
+            stride_h=2,
+            stride_w=2,
+            padding_h=0,
+            padding_w=0,
+            dilation_h=1,
+            dilation_w=1,
+            ceil_mode=False,
+        )
+        out = cuda_extension.custom_elu(pooled, alpha=1.0)
+        return out
+
+    def debug_forward(self, x):
+        pooled = cuda_extension.custom_maxpool2d(
+            x,
+            kernel_h=3,
+            kernel_w=5,
+            stride_h=2,
+            stride_w=2,
+            padding_h=0,
+            padding_w=0,
+            dilation_h=1,
+            dilation_w=1,
+            ceil_mode=False,
+        )
+        out = cuda_extension.custom_elu(pooled, alpha=1.0)
+        yield 'step_001', out
+        yield 'step_002', out
