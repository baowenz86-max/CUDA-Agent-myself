      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "对应参考语句 F.elu(x)，执行 element-wise ELU 激活。",
        "公式：x > 0 ? x : alpha * (exp(x) - 1)，默认 alpha=1.0。",
        "不改变 shape、dtype、device 和 stride。"
      ]
    }
  ],
  "reference_steps": [
