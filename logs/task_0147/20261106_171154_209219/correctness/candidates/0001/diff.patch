--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,54 @@
+#include <cuda_runtime.h>
+
+// ELU forward kernel with arbitrary strides.
+// Each thread processes one or more linear indices via grid-stride loop.
+// Computes out = x if x > 0 else exp(x) - 1 (alpha=1.0).
+__global__ void elu_forward_kernel(
+    float* output,
+    const float* input,
+    int rank,
+    const int64_t* shape,
+    const int64_t* input_strides,
+    const int64_t* output_strides,
+    int64_t numel)
+{
+    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)blockDim.x * gridDim.x;
+    for (; idx < numel; idx += stride) {
+        // Convert linear index to multidimensional indices using input strides
+        int64_t rem = idx;
+        int64_t in_offset = 0;
+        int64_t out_offset = 0;
+        for (int d = 0; d < rank; ++d) {
+            int64_t dim_size = shape[d];
+            int64_t coord = rem % dim_size;
+            rem /= dim_size;
+            in_offset += coord * input_strides[d];
+            out_offset += coord * output_strides[d];
+        }
+        float val = input[in_offset];
+        output[out_offset] = (val > 0.0f) ? val : (expf(val) - 1.0f);
+    }
+}
+
+extern "C" void elu_forward_launcher(
+    float* output,
+    const float* input,
+    int rank,
+    const int64_t* shape,
+    const int64_t* input_strides,
+    const int64_t* output_strides,
+    int64_t numel,
+    cudaStream_t stream)
+{
+    const int block_size = 256;
+    int64_t grid_size = (numel + block_size - 1) / block_size;
+    // Cap grid size to avoid excessive blocks (e.g., 2^31-1 limit)
+    const int64_t max_grid_size = 32768; // safe for most GPUs
+    if (grid_size > max_grid_size) {
+        grid_size = max_grid_size;
+    }
+    if (grid_size == 0) return;
+    elu_forward_kernel<<<(int)grid_size, block_size, 0, stream>>>(
+        output, input, rank, shape, input_strides, output_strides, numel);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,67 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Launcher declaration from custom_ops.cu
+extern "C" void elu_forward_launcher(
+    float* output,
+    const float* input,
+    int rank,
+    const int64_t* shape,
+    const int64_t* input_strides,
+    const int64_t* output_strides,
+    int64_t numel,
+    cudaStream_t stream
+);
+
+static torch::Tensor elu_forward(torch::Tensor x) {
+    // Input validation
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() >= 1, "Input must have at least one dimension");
+
+    // Ensure contiguous (kernel handles arbitrary strides, but for simplicity and performance
+    // we make it contiguous; however, launcher supports strides so we could also pass non-contig
+    // but here we follow common pattern of contiguous input)
+    auto input = x.contiguous();
+    auto output = torch::empty_like(input);
+
+    int64_t numel = input.numel();
+    int rank = input.dim();
+
+    // Prepare shape and strides arrays on CPU (small tensors)
+    auto shape_cpu = input.sizes().vec();  // std::vector<int64_t>
+    auto input_strides_cpu = input.strides().vec();
+    auto output_strides_cpu = output.strides().vec();
+
+    // Allocate device memory for shape and strides
+    auto shape_tensor = torch::from_blob(shape_cpu.data(), {rank}, torch::TensorOptions().dtype(torch::kInt64).device(torch::kCPU)).to(torch::kCUDA);
+    auto input_strides_tensor = torch::from_blob(input_strides_cpu.data(), {rank}, torch::TensorOptions().dtype(torch::kInt64).device(torch::kCPU)).to(torch::kCUDA);
+    auto output_strides_tensor = torch::from_blob(output_strides_cpu.data(), {rank}, torch::TensorOptions().dtype(torch::kInt64).device(torch::kCPU)).to(torch::kCUDA);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    elu_forward_launcher(
+        output.data_ptr<float>(),
+        input.data_ptr<float>(),
+        rank,
+        shape_tensor.data_ptr<int64_t>(),
+        input_strides_tensor.data_ptr<int64_t>(),
+        output_strides_tensor.data_ptr<int64_t>(),
+        numel,
+        stream
+    );
+
+    return output;
+}
+
+void register_elu_forward(pybind11::module& m) {
+    m.def("elu_forward", &elu_forward, "ELU forward (alpha=1.0)",
+          pybind11::arg("x"));
+}
+
+REGISTER_BINDING(elu_forward, register_elu_forward);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,32 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x):
+        x = cuda_extension.elu_forward(x)
+        return x
+
+    def debug_forward(self, *inputs):
+        x = inputs[0]
+        x = cuda_extension.elu_forward(x)
+        yield ('step_001', x)
+        yield ('step_002', x)
+
+
+batch_size = 5000
+width = 512
+height = 128
+
+
+def get_inputs():
+    x = torch.randn(batch_size, height, width)
+    return [x]
+
+
+def get_init_inputs():
+    return []
