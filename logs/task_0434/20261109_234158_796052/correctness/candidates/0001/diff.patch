--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,61 @@
+#include <cuda_runtime.h>
+
+// Elementwise absolute value
+__global__ void custom_abs_kernel(const float* __restrict__ input,
+                                  float* __restrict__ output,
+                                  int64_t total_elements) {
+    int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    int64_t stride = static_cast<int64_t>(blockDim.x) * gridDim.x;
+    for (int64_t i = idx; i < total_elements; i += stride) {
+        output[i] = fabsf(input[i]);
+    }
+}
+
+// Cumulative sum along dimension 0.
+// Each thread handles one index in the flattened (dim1*dim2*...*dimN) space.
+// It loops over dim0, accumulating values from input at position [d0, inner_idx].
+__global__ void custom_cumsum_dim0_kernel(const float* __restrict__ input,
+                                           float* __restrict__ output,
+                                           int64_t dim0,
+                                           int64_t inner_size) {
+    int64_t inner_idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    int64_t stride = static_cast<int64_t>(blockDim.x) * gridDim.x;
+    if (inner_idx >= inner_size) return;
+
+    for (int64_t idx = inner_idx; idx < inner_size; idx += stride) {
+        float acc = 0.0f;
+        for (int64_t d0 = 0; d0 < dim0; ++d0) {
+            acc += input[d0 * inner_size + idx];
+            output[d0 * inner_size + idx] = acc;
+        }
+    }
+}
+
+// Launcher for custom_abs
+extern "C" void custom_abs_launcher(const float* input,
+                                     float* output,
+                                     int64_t total_elements,
+                                     cudaStream_t stream) {
+    int threads = 256;
+    int blocks = static_cast<int>((total_elements + threads - 1) / threads);
+    const int max_blocks_per_grid = 65535;
+    if (blocks > max_blocks_per_grid) {
+        blocks = max_blocks_per_grid;
+    }
+    custom_abs_kernel<<<blocks, threads, 0, stream>>>(input, output, total_elements);
+}
+
+// Launcher for custom_cumsum along dim=0
+extern "C" void custom_cumsum_launcher(const float* input,
+                                         float* output,
+                                         int64_t dim0,
+                                         int64_t inner_size,
+                                         cudaStream_t stream) {
+    int threads = 256;
+    int blocks = static_cast<int>((inner_size + threads - 1) / threads);
+    const int max_blocks_per_grid = 65535;
+    if (blocks > max_blocks_per_grid) {
+        blocks = max_blocks_per_grid;
+    }
+    custom_cumsum_dim0_kernel<<<blocks, threads, 0, stream>>>(input, output, dim0, inner_size);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,89 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void custom_abs_launcher(const float* input,
+                                     float* output,
+                                     int64_t total_elements,
+                                     cudaStream_t stream);
+
+extern "C" void custom_cumsum_launcher(const float* input,
+                                         float* output,
+                                         int64_t dim0,
+                                         int64_t inner_size,
+                                         cudaStream_t stream);
+
+// PyTorch wrapper for element-wise absolute value
+torch::Tensor custom_abs(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "custom_abs: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "custom_abs: input must be float32");
+
+    // Ensure contiguous for the kernel's flat indexing
+    auto x_contig = x.contiguous();
+    auto output = torch::empty_like(x_contig);
+
+    int64_t total_elements = x_contig.numel();
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_abs_launcher(
+        x_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        total_elements,
+        stream
+    );
+
+    // Return view with original strides if possible; otherwise return contiguous output
+    if (x.is_contiguous()) {
+        return output;
+    } else {
+        return output.as_strided(x.sizes(), x.strides());
+    }
+}
+
+// PyTorch wrapper for cumulative sum along specified dimension
+torch::Tensor custom_cumsum(torch::Tensor x, int64_t dim) {
+    TORCH_CHECK(x.is_cuda(), "custom_cumsum: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "custom_cumsum: input must be float32");
+    TORCH_CHECK(dim >= 0 && dim < x.dim(), "custom_cumsum: dim out of range");
+
+    // Only dim=0 is implemented in the kernel; contract expects dim=0
+    TORCH_CHECK(dim == 0, "custom_cumsum: only dim=0 is supported by this kernel");
+
+    // Ensure contiguous for the kernel's row-major assumption
+    auto x_contig = x.contiguous();
+    auto output = torch::empty_like(x_contig);
+
+    int64_t dim0 = x_contig.size(0);
+    int64_t inner_size = x_contig.numel() / dim0;
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_cumsum_launcher(
+        x_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        dim0,
+        inner_size,
+        stream
+    );
+
+    // Return view with original strides if possible
+    if (x.is_contiguous()) {
+        return output;
+    } else {
+        return output.as_strided(x.sizes(), x.strides());
+    }
+}
+
+// Register functions
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_abs", &custom_abs, "Element-wise absolute value",
+          py::arg("x"));
+    m.def("custom_cumsum", &custom_cumsum, "Cumulative sum along dimension 0",
+          py::arg("x"), py::arg("dim"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
