--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,99 @@
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// Custom max over dimension 1 with keepdim=True
+// Input: x shape [N, C, H, W], stored in any strides (we only accept contiguous for now, but use strides for generality)
+// Output: values [N, 1, H, W] float32, indices [N, 1, H, W] int64
+// Reduction over C with tie-breaking to first occurrence.
+__global__ void max_dim1_kernel(const float* __restrict__ x,
+                                float* __restrict__ values,
+                                int64_t* __restrict__ indices,
+                                int N, int C, int H, int W,
+                                int64_t stride_n, int64_t stride_c, int64_t stride_h, int64_t stride_w) {
+    int total = N * H * W;
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= total) return;
+
+    int n = idx / (H * W);
+    int rem = idx % (H * W);
+    int h = rem / W;
+    int w = rem % W;
+
+    const float* x_n = x + n * stride_n;
+    float max_val = x_n[0 * stride_c + h * stride_h + w * stride_w];
+    int64_t max_idx = 0;
+    for (int c = 1; c < C; ++c) {
+        float val = x_n[c * stride_c + h * stride_h + w * stride_w];
+        if (val > max_val) {
+            max_val = val;
+            max_idx = c;
+        }
+    }
+    int out_idx = n * (H * W) + h * W + w;
+    values[out_idx] = max_val;
+    indices[out_idx] = max_idx;
+}
+
+// Custom layer normalization over last dimension (C)
+// Input x shape [N, 1, H, W] interpreted as [N, H, W, C]
+// weight and bias shape [C]. Output same shape.
+// We assume contiguous layout for x: N*H*W*C elements, where C = W dimension? Actually we know from contract:
+// Input to layer_norm is max output shape [512,1,1024,64], so N=512, H=1024, W=64, and normalized_shape is [64] = W.
+// We treat last dim size as C_norm = W = 64. For general, we accept C_norm as W.
+__global__ void layer_norm_kernel(const float* __restrict__ x,
+                                  const float* __restrict__ weight,
+                                  const float* __restrict__ bias,
+                                  float* __restrict__ y,
+                                  int N, int H, int W, int C_norm,
+                                  double eps) {
+    int total = N * H * W; // number of normalization groups
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= total) return;
+
+    const float* x_group = x + idx * C_norm; // contiguous assumption
+    float sum = 0.0f;
+    for (int i = 0; i < C_norm; ++i) {
+        sum += x_group[i];
+    }
+    float mean = sum / C_norm;
+    float sq_sum = 0.0f;
+    for (int i = 0; i < C_norm; ++i) {
+        float diff = x_group[i] - mean;
+        sq_sum += diff * diff;
+    }
+    float var = sq_sum / C_norm;
+    float inv_std = rsqrtf(var + (float)eps);
+
+    float* y_group = y + idx * C_norm;
+    for (int i = 0; i < C_norm; ++i) {
+        y_group[i] = (x_group[i] - mean) * inv_std * weight[i] + bias[i];
+    }
+}
+
+// Launcher for custom_max_dim1_keepdim
+extern "C" void custom_max_dim1_keepdim_launcher(const float* x,
+                                                float* values,
+                                                int64_t* indices,
+                                                int N, int C, int H, int W,
+                                                int64_t stride_n, int64_t stride_c, int64_t stride_h, int64_t stride_w,
+                                                cudaStream_t stream) {
+    int total = N * H * W;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    max_dim1_kernel<<<blocks, threads, 0, stream>>>(x, values, indices, N, C, H, W,
+                                                    stride_n, stride_c, stride_h, stride_w);
+}
+
+// Launcher for custom_layer_norm
+extern "C" void custom_layer_norm_launcher(const float* x,
+                                          const float* weight,
+                                          const float* bias,
+                                          float* y,
+                                          int N, int H, int W, int C_norm,
+                                          double eps,
+                                          cudaStream_t stream) {
+    int total = N * H * W;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    layer_norm_kernel<<<blocks, threads, 0, stream>>>(x, weight, bias, y, N, H, W, C_norm, eps);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,109 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void custom_max_dim1_keepdim_launcher(const float* x,
+                                                float* values,
+                                                int64_t* indices,
+                                                int N, int C, int H, int W,
+                                                int64_t stride_n, int64_t stride_c, int64_t stride_h, int64_t stride_w,
+                                                cudaStream_t stream);
+
+extern "C" void custom_layer_norm_launcher(const float* x,
+                                          const float* weight,
+                                          const float* bias,
+                                          float* y,
+                                          int N, int H, int W, int C_norm,
+                                          double eps,
+                                          cudaStream_t stream);
+
+// Wrapper for custom_max_dim1_keepdim
+std::tuple<torch::Tensor, torch::Tensor> custom_max_dim1_keepdim(torch::Tensor x) {
+    // Input validation
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(x.dim() == 4, "x must be 4D (N,C,H,W)");
+    TORCH_CHECK(x.size(1) > 0, "channel dimension must be positive");
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+
+    // Output tensors
+    auto values = torch::empty({N, 1, H, W}, x.options());
+    auto indices = torch::empty({N, 1, H, W}, x.options().dtype(torch::kInt64));
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Launcher uses strides (even if x is non-contiguous)
+    custom_max_dim1_keepdim_launcher(
+        x.data_ptr<float>(),
+        values.data_ptr<float>(),
+        indices.data_ptr<int64_t>(),
+        N, C, H, W,
+        x.stride(0), x.stride(1), x.stride(2), x.stride(3),
+        stream
+    );
+
+    return {values, indices};
+}
+
+// Wrapper for custom_layer_norm
+torch::Tensor custom_layer_norm(torch::Tensor x,
+                                torch::Tensor weight,
+                                torch::Tensor bias,
+                                double eps) {
+    // Input validation
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(weight.is_cuda() && weight.dtype() == torch::kFloat32, "weight must be CUDA float32");
+    TORCH_CHECK(bias.is_cuda() && bias.dtype() == torch::kFloat32, "bias must be CUDA float32");
+    TORCH_CHECK(x.dim() == 4, "x must be 4D");
+    TORCH_CHECK(x.size(3) == weight.numel(), "normalized shape must match last dimension of x");
+    TORCH_CHECK(weight.numel() == bias.numel(), "weight and bias must have same size");
+    TORCH_CHECK(weight.is_contiguous() && bias.is_contiguous(), "weight and bias must be contiguous");
+
+    int N = x.size(0);
+    int H = x.size(2);
+    int W = x.size(3);
+    int C_norm = W;  // last dim = normalized size
+
+    // Output tensor (same shape as x)
+    auto output = torch::empty_like(x);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Launcher assumes x is contiguous (as contracted for layer_norm)
+    TORCH_CHECK(x.is_contiguous(), "x must be contiguous for layer_norm");
+    custom_layer_norm_launcher(
+        x.data_ptr<float>(),
+        weight.data_ptr<float>(),
+        bias.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, H, W, C_norm,
+        eps,
+        stream
+    );
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_max_dim1_keepdim", &custom_max_dim1_keepdim,
+          "Custom max over dimension 1 with keepdim=True",
+          py::arg("x"));
+    m.def("custom_layer_norm", &custom_layer_norm,
+          "Custom layer normalization over last dimension",
+          py::arg("x"), py::arg("weight"), py::arg("bias"), py::arg("eps") = 1e-05);
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,20 @@
+import torch
+import torch.nn as nn
+
+
+class ModelNew(nn.Module):
+    def __init__(self, num_channels, eps):
+        super().__init__()
+        self.layer_norm = nn.LayerNorm(num_channels, eps=eps)
+
+    def forward(self, x):
+        x_max, _ = cuda_extension.custom_max_dim1_keepdim(x)
+        x = cuda_extension.custom_layer_norm(x_max, self.layer_norm.weight, self.layer_norm.bias, self.layer_norm.eps)
+        return x
+
+    def debug_forward(self, x):
+        x_max, indices = cuda_extension.custom_max_dim1_keepdim(x)
+        yield 'step_001', (x_max, indices)
+        x_norm = cuda_extension.custom_layer_norm(x_max, self.layer_norm.weight, self.layer_norm.bias, self.layer_norm.eps)
+        yield 'step_002', x_norm
+        yield 'step_003', x_norm
