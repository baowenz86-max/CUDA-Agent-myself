{
  "operators": [
    {
      "name": "custom_acos",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference step",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "对应参考语句 x = torch.acos(x)。",
        "按元素计算反余弦，输入限制在 [-0.999, 0.999] 以避免 NaN。",
        "返回与输入同 shape、dtype 的张量。"
      ]
    },
    {
      "name": "custom_reflection_pad2d",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference step",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "padding",
          "kind": "int",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as reference step"
      },
      "semantics": [
        "对应参考语句 x = self.reflection_pad(x)。",
        "执行 4D 反射填充，padding 为 (3,3,3,3) 对应左右上下各 3。",
        "输出 shape 为 (N, C, H+6, W+6)，dtype 与输入相同。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = torch.acos(x)",
      "semantics": [
        "输入张量 x 形状 (128,3,512,512) float32，在 CUDA 上按元素计算 acos。",
        "输出形状相同，无广播，无 dtype 变化。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.reflection_pad(x)",
      "semantics": [
        "对 float32 CUDA 张量进行反射填充，padding=3。",
        "输出形状 (128,3,518,518)。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回经过反射填充后的张量。",
        "最终输出与 step_002 相同。"
      ]
    }
  ]
}