--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,118 @@
+#include <cuda_runtime.h>
+
+// Constant padding kernel: fills output with value, and copies input to appropriate interior region
+// Assumes input and output are contiguous 4D tensors with dimensions N,C,H,W and padded output N,C,H+top+bottom, W+left+right
+// padding: left, right, top, bottom
+__global__ void constant_pad2d_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int N, int C, int H, int W,
+    int outH, int outW,
+    int left, int right, int top, int bottom,
+    float value)
+{
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = N * C * outH * outW;
+    int stride = blockDim.x * gridDim.x;
+
+    for (int i = idx; i < total; i += stride) {
+        // Compute output coordinates
+        int ow = i % outW;
+        int oh = (i / outW) % outH;
+        int oc = (i / (outW * outH)) % C;
+        int on = i / (outW * outH * C);
+
+        // Check if inside original region
+        if (oh >= top && oh < top + H && ow >= left && ow < left + W) {
+            int ih = oh - top;
+            int iw = ow - left;
+            int input_idx = ((on * C + oc) * H + ih) * W + iw;
+            output[i] = input[input_idx];
+        } else {
+            output[i] = value;
+        }
+    }
+}
+
+// Reflection padding kernel: output dimensions outH = H + top + bottom, outW = W + left + right
+// Reflection without repeating edge: input index maps as i -> reflect(i)
+__device__ __forceinline__ int reflect_index(int idx, int len) {
+    // len > 1 always for valid inputs; for safety handle len==1
+    if (len == 1) return 0;
+    int period = 2 * (len - 1);
+    int mod = idx % period;
+    if (mod < 0) mod += period;
+    return (mod < len) ? mod : (period - mod);
+}
+
+__global__ void reflection_pad2d_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int N, int C, int H, int W,
+    int outH, int outW,
+    int left, int right, int top, int bottom)
+{
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = N * C * outH * outW;
+    int stride = blockDim.x * gridDim.x;
+
+    for (int i = idx; i < total; i += stride) {
+        int ow = i % outW;
+        int oh = (i / outW) % outH;
+        int oc = (i / (outW * outH)) % C;
+        int on = i / (outW * outH * C);
+
+        // Map output position to input position using reflection
+        int ih = reflect_index(oh - top, H);
+        int iw = reflect_index(ow - left, W);
+        int input_idx = ((on * C + oc) * H + ih) * W + iw;
+        output[i] = input[input_idx];
+    }
+}
+
+// Launcher for constant_pad2d
+// Input and output pointers must be CUDA pointers (device memory)
+extern "C" void constant_pad2d_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    int left, int right, int top, int bottom,
+    float value,
+    cudaStream_t stream)
+{
+    int outH = H + top + bottom;
+    int outW = W + left + right;
+    int total = N * C * outH * outW;
+
+    // Choose block size and grid size (grid-stride loop covers all)
+    const int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    // Cap blocks to a reasonable number for grid-stride loop overhead, but ensure enough
+    if (blocks > 65535) blocks = 65535;
+    // Minimum 1 block for non-empty output (empty handled by binding)
+    if (blocks < 1) blocks = 1;
+
+    constant_pad2d_kernel<<<blocks, threads, 0, stream>>>(
+        input, output, N, C, H, W, outH, outW, left, right, top, bottom, value);
+}
+
+// Launcher for reflection_pad2d
+extern "C" void reflection_pad2d_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    int left, int right, int top, int bottom,
+    cudaStream_t stream)
+{
+    int outH = H + top + bottom;
+    int outW = W + left + right;
+    int total = N * C * outH * outW;
+
+    const int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535;
+    if (blocks < 1) blocks = 1;
+
+    reflection_pad2d_kernel<<<blocks, threads, 0, stream>>>(
+        input, output, N, C, H, W, outH, outW, left, right, top, bottom);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,140 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_runtime.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void constant_pad2d_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    int left, int right, int top, int bottom,
+    float value,
+    cudaStream_t stream);
+
+extern "C" void reflection_pad2d_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    int left, int right, int top, int bottom,
+    cudaStream_t stream);
+
+// Helper to convert Python padding tuple or int to left, right, top, bottom
+static void parse_padding(const pybind11::object& padding, int& left, int& right, int& top, int& bottom) {
+    if (pybind11::isinstance<pybind11::int_>(padding)) {
+        int p = padding.cast<int>();
+        left = right = top = bottom = p;
+    } else if (pybind11::isinstance<pybind11::tuple>(padding)) {
+        auto t = padding.cast<pybind11::tuple>();
+        TORCH_CHECK(t.size() == 4, "padding must be an int or a tuple of 4 ints");
+        left = t[0].cast<int>();
+        right = t[1].cast<int>();
+        top = t[2].cast<int>();
+        bottom = t[3].cast<int>();
+    } else {
+        TORCH_CHECK(false, "padding must be an int or a tuple of 4 ints");
+    }
+    TORCH_CHECK(left >= 0 && right >= 0 && top >= 0 && bottom >= 0, "padding values must be non-negative");
+}
+
+// constant_pad2d: input is CPU float32, output is CUDA float32
+torch::Tensor constant_pad2d(torch::Tensor x, pybind11::object padding) {
+    // Check input tensor
+    TORCH_CHECK(x.is_cpu(), "constant_pad2d input must be a CPU tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "constant_pad2d input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "constant_pad2d input must be contiguous");
+    TORCH_CHECK(x.dim() == 4, "constant_pad2d input must be 4D (N,C,H,W)");
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+    TORCH_CHECK(N > 0 && C > 0 && H > 0 && W > 0, "input dimensions must be positive");
+    TORCH_CHECK(N <= INT_MAX && C <= INT_MAX && H <= INT_MAX && W <= INT_MAX, "dimensions too large");
+
+    int left, right, top, bottom;
+    parse_padding(padding, left, right, top, bottom);
+    int64_t outH = H + top + bottom;
+    int64_t outW = W + left + right;
+    TORCH_CHECK(outH <= INT_MAX && outW <= INT_MAX, "output dimensions too large");
+
+    // Allocate CUDA output tensor
+    auto output = torch::empty({N, C, outH, outW}, x.options().device(torch::kCUDA));
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    constant_pad2d_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int>(N), static_cast<int>(C),
+        static_cast<int>(H), static_cast<int>(W),
+        left, right, top, bottom,
+        0.0f,  // constant pad value is 0
+        stream
+    );
+
+    // Check for kernel launch errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "constant_pad2d kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// reflection_pad2d: input is CUDA float32, output is CUDA float32
+torch::Tensor reflection_pad2d(torch::Tensor x, pybind11::object padding) {
+    // Check input tensor
+    TORCH_CHECK(x.is_cuda(), "reflection_pad2d input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "reflection_pad2d input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "reflection_pad2d input must be contiguous");
+    TORCH_CHECK(x.dim() == 4, "reflection_pad2d input must be 4D (N,C,H,W)");
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+    TORCH_CHECK(N > 0 && C > 0 && H > 0 && W > 0, "input dimensions must be positive");
+    TORCH_CHECK(N <= INT_MAX && C <= INT_MAX && H <= INT_MAX && W <= INT_MAX, "dimensions too large");
+    TORCH_CHECK(H >= 1 && W >= 1, "reflection padding requires H,W >= 1");
+
+    int left, right, top, bottom;
+    parse_padding(padding, left, right, top, bottom);
+    int64_t outH = H + top + bottom;
+    int64_t outW = W + left + right;
+    TORCH_CHECK(outH <= INT_MAX && outW <= INT_MAX, "output dimensions too large");
+
+    // Allocate CUDA output tensor
+    auto output = torch::empty({N, C, outH, outW}, x.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    reflection_pad2d_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int>(N), static_cast<int>(C),
+        static_cast<int>(H), static_cast<int>(W),
+        left, right, top, bottom,
+        stream
+    );
+
+    // Check for kernel launch errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "reflection_pad2d kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("constant_pad2d", &constant_pad2d,
+          "ConstantPad2d with CPU input and CUDA output",
+          pybind11::arg("x"), pybind11::arg("padding"));
+    m.def("reflection_pad2d", &reflection_pad2d,
+          "ReflectionPad2d with CUDA input and CUDA output",
+          pybind11::arg("x"), pybind11::arg("padding"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,23 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, padding_constant: int, padding_reflection: tuple):
+        super().__init__()
+        self.padding_constant = padding_constant
+        self.padding_reflection = padding_reflection
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        x = cuda_extension.constant_pad2d(x, self.padding_constant)
+        x = cuda_extension.reflection_pad2d(x, self.padding_reflection)
+        return x
+
+    def debug_forward(self, inputs):
+        x = inputs[0]
+        x = cuda_extension.constant_pad2d(x, self.padding_constant)
+        yield 'step_001', x
+        x = cuda_extension.reflection_pad2d(x, self.padding_reflection)
+        yield 'step_002', x
+        yield 'step_003', x
