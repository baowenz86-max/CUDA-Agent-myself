+// CUDA kernels and launchers for model_new.py custom ops
+// This file contains only CUDA C++ code (no torch/ATen/pybind dependencies)
+// All launchers use raw pointers, scalar parameters, and cudaStream_t.
+#include <cuda_runtime.h>
+#include <cstdint>
+#include <cfloat>
+
+// -----------------------------------------------------------------------------
+// custom_pad
+// Reference: x = self.pad(x) with ConstantPad2d(padding=(left,right,top,bottom), value=value)
+// Input: 4D tensor [N, C, H, W] (here C=1), float32, arbitrary strides
+// Output: 4D contiguous tensor [N, C, H+top+bottom, W+left+right]
+// The kernel writes one output element per thread, using grid-stride loop.
+// Boundary regions are filled with the constant value; interior is copied from input.
+// -----------------------------------------------------------------------------
+__global__ void custom_pad_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    int N, int C, int H_in, int W_in,
+    int H_out, int W_out,
+    int pad_left, int pad_right, int pad_top, int pad_bottom,
+    float pad_value,
+    long long input_n_stride, long long input_c_stride,
+    long long input_h_stride, long long input_w_stride)
+{
+    long long total = (long long)N * C * H_out * W_out;
+    for (long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+         idx < total;
+         idx += (long long)gridDim.x * blockDim.x)
+    {
+        int w = idx % W_out;
+        long long tmp = idx / W_out;
+        int h = tmp % H_out;
+        tmp /= H_out;
+        int c = tmp % C;
+        int n = tmp / C;
+
+        int h_in = h - pad_top;
+        int w_in = w - pad_left;
+
+        float val;
+        if (h_in >= 0 && h_in < H_in && w_in >= 0 && w_in < W_in) {
+            // Inside original input region
+            const float* src = input + n * input_n_stride + c * input_c_stride
+                               + h_in * input_h_stride + w_in * input_w_stride;
+            val = *src;
+        } else {
+            val = pad_value;
+        }
+        output[idx] = val;
+    }
+}
+
+extern "C" void custom_pad_launcher(
+    float* output,
+    const float* input,
+    int N, int C, int H_in, int W_in,
+    int H_out, int W_out,
+    int pad_left, int pad_right, int pad_top, int pad_bottom,
+    float pad_value,
+    long long input_n_stride, long long input_c_stride,
+    long long input_h_stride, long long input_w_stride,
+    cudaStream_t stream)
+{
+    long long total = (long long)N * C * H_out * W_out;
+    if (total == 0) return;
+
+    int block_size = 256;
+    long long grid_size = (total + block_size - 1) / block_size;
+    if (grid_size > 2147483647LL) grid_size = 2147483647LL; // grid size limit
+
+    custom_pad_kernel<<<(unsigned int)grid_size, block_size, 0, stream>>>(
+        output, input,
+        N, C, H_in, W_in, H_out, W_out,
+        pad_left, pad_right, pad_top, pad_bottom,
+        pad_value,
+        input_n_stride, input_c_stride, input_h_stride, input_w_stride);
+}
+
+// -----------------------------------------------------------------------------
+// custom_max_dim1
+// Reference: x = torch.max(x, dim=1)[0]
+// Input: 4D tensor [N, 1, H, W] (dim=1 size is 1), float32, arbitrary strides
+// Output: 3D contiguous tensor [N, H, W], containing same values (since max over size-1 dim is identity)
+// This is effectively a squeeze along dim=1.
+// -----------------------------------------------------------------------------
+__global__ void custom_max_dim1_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    int N, int H, int W,
+    long long input_n_stride, long long input_c_stride,
+    long long input_h_stride, long long input_w_stride)
+{
+    long long total = (long long)N * H * W;
+    for (long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+         idx < total;
+         idx += (long long)gridDim.x * blockDim.x)
+    {
+        int w = idx % W;
+        long long tmp = idx / W;
+        int h = tmp % H;
+        int n = tmp / H;
+
+        // Since C=1, only copy index c=0
+        const float* src = input + n * input_n_stride + 0 * input_c_stride
+                           + h * input_h_stride + w * input_w_stride;
+        output[idx] = *src;
+    }
+}
+
+extern "C" void custom_max_dim1_launcher(
+    float* output,
+    const float* input,
+    int N, int H, int W,
+    long long input_n_stride, long long input_c_stride,
+    long long input_h_stride, long long input_w_stride,
+    cudaStream_t stream)
+{
+    long long total = (long long)N * H * W;
+    if (total == 0) return;
+
+    int block_size = 256;
+    long long grid_size = (total + block_size - 1) / block_size;
+    if (grid_size > 2147483647LL) grid_size = 2147483647LL;
+
+    custom_max_dim1_kernel<<<(unsigned int)grid_size, block_size, 0, stream>>>(
+        output, input,
+        N, H, W,
+        input_n_stride, input_c_stride, input_h_stride, input_w_stride);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,130 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void custom_pad_launcher(
+    float* output,
+    const float* input,
+    int N, int C, int H_in, int W_in,
+    int H_out, int W_out,
+    int pad_left, int pad_right, int pad_top, int pad_bottom,
+    float pad_value,
+    long long input_n_stride, long long input_c_stride,
+    long long input_h_stride, long long input_w_stride,
+    cudaStream_t stream);
+
+extern "C" void custom_max_dim1_launcher(
+    float* output,
+    const float* input,
+    int N, int H, int W,
+    long long input_n_stride, long long input_c_stride,
+    long long input_h_stride, long long input_w_stride,
+    cudaStream_t stream);
+
+// Wrapper for custom_pad
+torch::Tensor custom_pad(torch::Tensor input,
+                         int64_t pad_left,
+                         int64_t pad_right,
+                         int64_t pad_top,
+                         int64_t pad_bottom,
+                         double value) {
+    // Check tensor properties
+    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(input.dim() == 4, "Input must be 4D [N, C, H, W]");
+
+    // Make input contiguous if needed (stride handling done via explicit strides in launcher,
+    // but contiguous ensures better performance and simplifies pointer arithmetic)
+    auto input_contig = input.contiguous();
+
+    int N = input_contig.size(0);
+    int C = input_contig.size(1);
+    int H_in = input_contig.size(2);
+    int W_in = input_contig.size(3);
+
+    int H_out = H_in + pad_top + pad_bottom;
+    int W_out = W_in + pad_left + pad_right;
+
+    // Allocate output tensor
+    auto output = torch::empty({N, C, H_out, W_out}, input_contig.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Use contiguous strides for both input and output (output is contiguous by creation)
+    long long input_n_stride = input_contig.stride(0);
+    long long input_c_stride = input_contig.stride(1);
+    long long input_h_stride = input_contig.stride(2);
+    long long input_w_stride = input_contig.stride(3);
+
+    // Call launcher
+    custom_pad_launcher(
+        output.data_ptr<float>(),
+        input_contig.data_ptr<float>(),
+        N, C, H_in, W_in,
+        H_out, W_out,
+        static_cast<int>(pad_left),
+        static_cast<int>(pad_right),
+        static_cast<int>(pad_top),
+        static_cast<int>(pad_bottom),
+        static_cast<float>(value),
+        input_n_stride, input_c_stride, input_h_stride, input_w_stride,
+        stream);
+
+    return output;
+}
+
+// Wrapper for custom_max_dim1
+torch::Tensor custom_max_dim1(torch::Tensor input) {
+    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(input.dim() == 4, "Input must be 4D [N, C, H, W]");
+    TORCH_CHECK(input.size(1) == 1, "dim=1 size must be 1 for current implementation");
+
+    // Make input contiguous (launcher uses strides, but contiguous ensures correctness)
+    auto input_contig = input.contiguous();
+
+    int N = input_contig.size(0);
+    int C = input_contig.size(1); // should be 1
+    int H = input_contig.size(2);
+    int W = input_contig.size(3);
+
+    // Allocate output tensor [N, H, W]
+    auto output = torch::empty({N, H, W}, input_contig.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    long long input_n_stride = input_contig.stride(0);
+    long long input_c_stride = input_contig.stride(1);
+    long long input_h_stride = input_contig.stride(2);
+    long long input_w_stride = input_contig.stride(3);
+
+    custom_max_dim1_launcher(
+        output.data_ptr<float>(),
+        input_contig.data_ptr<float>(),
+        N, H, W,
+        input_n_stride, input_c_stride, input_h_stride, input_w_stride,
+        stream);
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_pad", &custom_pad,
+          "ConstantPad2d forward (CUDA)",
+          py::arg("input"),
+          py::arg("pad_left"),
+          py::arg("pad_right"),
+          py::arg("pad_top"),
+          py::arg("pad_bottom"),
+          py::arg("value"));
+    m.def("custom_max_dim1", &custom_max_dim1,
+          "Max over dim=1 (size 1) forward (CUDA)",
+          py::arg("input"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,24 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, pad_width, pad_value):
+        super().__init__()
+        self.pad_width = pad_width
+        self.pad_value = pad_value
+
+    def forward(self, x):
+        pad_left, pad_right, pad_top, pad_bottom = self.pad_width
+        x = cuda_extension.custom_pad(x, pad_left, pad_right, pad_top, pad_bottom, self.pad_value)
+        x = cuda_extension.custom_max_dim1(x)
+        return x
+
+    def debug_forward(self, x):
+        pad_left, pad_right, pad_top, pad_bottom = self.pad_width
+        pad_out = cuda_extension.custom_pad(x, pad_left, pad_right, pad_top, pad_bottom, self.pad_value)
+        max_out = cuda_extension.custom_max_dim1(pad_out)
+        yield 'step_001', pad_out
+        yield 'step_002', max_out
+        yield 'step_003', max_out
