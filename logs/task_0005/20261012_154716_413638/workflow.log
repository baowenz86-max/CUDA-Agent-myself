#include <cuda_runtime.h>
#include <cstdint>

// Kernel: fused log10(x), less_than(0.5), conv_transpose1d, add bias
// Input tensor x shape: (N, C_in, L_in)
// Weight shape: (C_in, C_out, K) for ConvTranspose1d
// conv_bias shape: (C_out,)
// out_bias shape: (C_out, 1) add to each output channel
// stride, padding, output_padding as ints
// Output shape: (N, C_out, L_out) where L_out = (L_in - 1) * stride - 2 * padding + kernel_size + output_padding

__global__ void fused_log_lt_convt_bias_kernel(
    const float* __restrict__ input,
    const float* __restrict__ weight,
    const float* __restrict__ conv_bias,
    const float* __restrict__ out_bias,
    float* __restrict__ output,
    int N, int C_in, int L_in,
    int C_out, int K,
    int stride, int padding, int output_padding,
    int L_out
) {
    // Each thread computes one output element (n, co, l)
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int total_elements = N * C_out * L_out;
    if (idx >= total_elements) return;

    // Decompose idx into n, co, l
    int l = idx % L_out;
    int tmp = idx / L_out;
    int co = tmp % C_out;
    int n = tmp / C_out;

    float acc = (conv_bias != nullptr) ? conv_bias[co] : 0.0f;

    // Iterate over input channels and kernel positions
    for (int ci = 0; ci < C_in; ++ci) {
        for (int k = 0; k < K; ++k) {
            // Output position l corresponds to input position i = (l + padding - k) / stride if divisible
            int numerator = l + padding - k;
            if (numerator % stride != 0) continue;
            int i = numerator / stride;
            if (i < 0 || i >= L_in) continue;

            // Load input value at (n, ci, i)
            float x_val = input[((n * C_in + ci) * L_in) + i];

            // Apply log10 and less_than(0.5)
            // log10(x) computed as logf(x) / logf(10.0f)
            // Guard against x <= 0: log10 undefined, but original PyTorch would produce nan;
            // we'll mimic by using logf directly which produces nan or -inf, but we don't call torch ops.
            float log_val = (x_val > 0.0f) ? (logf(x_val) / 2.302585092994046f) : -INFINITY;
            // less_than 0.5: boolean true -> 1.0f, false -> 0.0f
            float lt_val = (log_val < 0.5f) ? 1.0f : 0.0f;

            // Get weight for (ci, co, k)
            // Weight layout: (C_in, C_out, K) stride: ci * C_out * K + co * K + k
            float w = weight[(ci * C_out + co) * K + k];

            acc += lt_val * w;
        }
    }

    // Add out_bias[co] (out_bias shape: (C_out,1) so index co)
    if (out_bias != nullptr) {
        acc += out_bias[co];
    }

    output[idx] = acc;
}

extern "C" void fused_log_lt_convt_bias_launcher(
    const float* input,
    const float* weight,
    const float* conv_bias,
    const float* out_bias,
    float* output,
    int N, int C_in, int L_in,
    int C_out, int K,
    int stride, int padding, int output_padding,
    int L_out,
    cudaStream_t stream
) {
    constexpr int threads = 256;
    int total = N * C_out * L_out;
    int blocks = (total + threads - 1) / threads;

    fused_log_lt_convt_bias_kernel<<<blocks, threads, 0, stream>>>(
        input, weight, conv_bias, out_bias, output,
        N, C_in, L_in, C_out, K,
        stride, padding, output_padding, L_out);
}
