===== kernels/conv_transpose1d_custom.cu =====
// This file implements a custom ConvTranspose1d CUDA kernel.
// It is designed to be used from PyTorch via a C++ binding.
// The launcher function is declared extern "C" to avoid C++ name mangling.

#include <cuda_runtime.h>
#include <cstdint>

// Compute ConvTranspose1d output for a batch of 1D signals.
// Input: (N, C_in, L_in) float32
// Weight: (C_in, C_out, K) float32
// Bias: (C_out) float32
// Output: (N, C_out, L_out) float32
// where L_out = (L_in - 1) * stride - 2*padding + kernel_size + output_padding
//
// Each thread computes one output element.
// Kernel is optimized for typical ConvTranspose1d configurations.
// Uses grid-stride loop for robustness.
// No shared memory, as each output accesses a limited set of input and weight elements.
// Memory accesses are coalesced when consecutive threads correspond to consecutive L_out positions (which is likely).
//
// Template parameters are not needed for this simple kernel, but we keep it non-template for simplicity.

__global__ void conv_transpose1d_kernel(
    const float* __restrict__ input,
    const float* __restrict__ weight,
    const float* __restrict__ bias,
    float* __restrict__ output,
    int N, int C_in, int L_in, int C_out, int L_out, int K,
    int stride, int padding, int output_padding) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int total = N * C_out * L_out;
    int stride_grid = gridDim.x * blockDim.x;

    // Loop over all output elements assigned to this thread (grid-stride loop)
    for (int linear_idx = idx; linear_idx < total; linear_idx += stride_grid) {
        // Decompose linear index into n, c_out, l_out
        int n = linear_idx / (C_out * L_out);
        int rem = linear_idx % (C_out * L_out);
        int c_out = rem / L_out;
        int l_out = rem % L_out;

        float acc = bias[c_out]; // initialize with bias

        // For each input channel and kernel position that contributes to this output
        // The formula: output[n, c_out, l_out] = sum_{c_in, k} input[n,c_in, l_in] * weight[c_in, c_out, k]
        // where l_in = l_out * stride - padding + k, and 0 <= l_in < L_in
        for (int c_in = 0; c_in < C_in; ++c_in) {
            int base_l_in = l_out * stride - padding;
            for (int k = 0; k < K; ++k) {
                int l_in = base_l_in + k;
                if (l_in >= 0 && l_in < L_in) {
                    float input_val = input[(n * C_in + c_in) * L_in + l_in];
                    float weight_val = weight[(c_in * C_out + c_out) * K + k];
                    acc += input_val * weight_val;
                }
            }
        }

        output[linear_idx] = acc;
    }
}

// Host launcher function
// Parameters:
//   input: pointer to input tensor (N, C_in, L_in) float32, contiguous
//   weight: pointer to weight tensor (C_in, C_out, K) float32, contiguous
//   bias: pointer to bias tensor (C_out) float32, contiguous
//   output: pointer to pre-allocated output tensor (N, C_out, L_out) float32
//   N, C_in, L_in, C_out, L_out, K: dimensions
//   stride, padding, output_padding: ConvTranspose1d parameters
//   stream: CUDA stream to launch the kernel on
extern "C" void conv_transpose1d_custom_launcher(
    const float* input,
    const float* weight,
    const float* bias,
    float* output,
    int N, int C_in, int L_in, int C_out, int L_out, int K,
    int stride, int padding, int output_padding,
    cudaStream_t stream) {

    int total = N * C_out * L_out;
    // Choose block size and grid size to cover all elements.
    // For simplicity, use 256 threads per block.
    int threads = 256;
    int blocks = (total + threads - 1) / threads;
    // Cap blocks to a reasonable number to avoid excessive grid launches; but grid-stride loop handles any.
    if (blocks == 0) {
        // If total is 0, nothing to do.
        return;
    }

    conv_transpose1d_kernel<<<blocks, threads, 0, stream>>>(
        input, weight, bias, output,
        N, C_in, L_in, C_out, L_out, K,
        stride, padding, output_padding);
}

===== kernels/conv_transpose1d_custom_binding.cpp =====
#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>
#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

// Declare launcher from .cu file
extern "C" void conv_transpose1d_custom_launcher(
    const float* input,
    const float* weight,
    const float* bias,
    float* output,
    int N, int C_in, int L_in, int C_out, int L_out, int K,
    int stride, int padding, int output_padding,
    cudaStream_t stream);

// PyTorch binding function
// Arguments:
//   input: (N, C_in, L_in) float32 tensor, contiguous
//   weight: (C_in, C_out, K) float32 tensor, contiguous
//   bias: (C_out) float32 tensor, contiguous
//   stride: int
//   padding: int
//   output_padding: int
// Returns:
//   output: (N, C_out, L_out) float32 tensor
at::Tensor conv_transpose1d_custom_forward(
    const at::Tensor& input,
    const at::Tensor& weight,
    const at::Tensor& bias,
    int64_t stride,
    int64_t padding,
    int64_t output_padding) {
    // ===== Input checks =====
    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
    TORCH_CHECK(weight.is_cuda(), "weight must be a CUDA tensor");
    TORCH_CHECK(bias.is_cuda(), "bias must be a CUDA tensor");
    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
    TORCH_CHECK(weight.dtype() == torch::kFloat32, "weight must be float32");
    TORCH_CHECK(bias.dtype() == torch::kFloat32, "bias must be float32");
    TORCH_CHECK(input.is_contiguous(), "input must be contiguous");
    TORCH_CHECK(weight.is_contiguous(), "weight must be contiguous");
    TORCH_CHECK(bias.is_contiguous(), "bias must be contiguous");

    // ===== Shape checks =====
    // input: (N, C_in, L_in)
    TORCH_CHECK(input.dim() == 3, "input must be 3D (N, C_in, L_in)");
    // weight: (C_in, C_out, K)
    TORCH_CHECK(weight.dim() == 3, "weight must be 3D (C_in, C_out, K)");
    // bias: (C_out)
    TORCH_CHECK(bias.dim() == 1, "bias must be 1D (C_out)");

    int64_t N = input.size(0);
    int64_t C_in = input.size(1);
    int64_t L_in = input.size(2);
    int64_t C_out = weight.size(1);
    int64_t K = weight.size(2);

    TORCH_CHECK(weight.size(0) == C_in, "weight first dimension must match input channels");
    TORCH_CHECK(bias.size(0) == C_out, "bias size must match output channels");

    // ===== Output shape calculation =====
    int64_t L_out = (L_in - 1) * stride - 2 * padding + K + output_padding;
    TORCH_CHECK(L_out > 0, "computed output length must be positive");

    // ===== Allocate output =====
    auto output = torch::empty({N, C_out, L_out}, input.options());

    // ===== Get CUDA stream =====
    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    // ===== Call launcher =====
    conv_transpose1d_custom_launcher(
        input.data_ptr<float>(),
        weight.data_ptr<float>(),
        bias.data_ptr<float>(),
        output.data_ptr<float>(),
        static_cast<int>(N),
        static_cast<int>(C_in),
        static_cast<int>(L_in),
        static_cast<int>(C_out),
        static_cast<int>(L_out),
        static_cast<int>(K),
        static_cast<int>(stride),
        static_cast<int>(padding),
        static_cast<int>(output_padding),
        stream);

    return output;
}

// Registration
void register_conv_transpose1d_custom(pybind11::module& m) {
    m.def("conv_transpose1d_custom", &conv_transpose1d_custom_forward,
          "Custom ConvTranspose1d forward",
          pybind11::arg("input"),
          pybind11::arg("weight"),
          pybind11::arg("bias"),
          pybind11::arg("stride"),
          pybind11::arg("padding"),
          pybind11::arg("output_padding"));
}

REGISTER_BINDING(conv_transpose1d_custom, register_conv_transpose1d_custom);
