import torch
import torch.nn as nn


class Model(nn.Module):
    def __init__(self, in_channels, out_channels, kernel_size, stride, padding, output_padding, bias_shape):
        super().__init__()
        self.conv_transpose1d = nn.ConvTranspose1d(
            in_channels, out_channels, kernel_size, stride=stride, padding=padding, output_padding=output_padding
        )
        self.bias = nn.Parameter(torch.randn(bias_shape))

    def forward(self, x):
        x = torch.log10(x)
        x = torch.lt(x, 0.5)
        x = self.conv_transpose1d(x.float())  # Convert boolean tensor to float tensor before passing to ConvTranspose1d
        x = x + self.bias
        return x


batch_size = 128
in_channels = 64
out_channels = 32
length = 4096  # Increased from 1024 to increase computation time
kernel_size = 3
stride = 2
padding = 1
output_padding = 1
bias_shape = (out_channels, 1)


def get_inputs():
    return [torch.randn(batch_size, in_channels, length)]


def get_init_inputs():
    return [in_channels, out_channels, kernel_size, stride, padding, output_padding, bias_shape]

===== model_new.py =====
import torch
import torch.nn as nn
import cuda_extension


class ModelNew(nn.Module):
    def __init__(self, in_channels, out_channels, kernel_size, stride, padding, output_padding, bias_shape):
        super().__init__()
        self.conv_transpose1d = nn.ConvTranspose1d(
            in_channels, out_channels, kernel_size, stride=stride, padding=padding, output_padding=output_padding
        )
        self.bias = nn.Parameter(torch.randn(bias_shape))

    def forward(self, x):
        # Custom fused op: log10 then less-than 0.5 -> boolean mask
        mask = cuda_extension.fused_log10_lt_forward(x, threshold=0.5)
        # Convert boolean mask to float
        x_float = cuda_extension.bool_to_float_forward(mask)
        # ConvTranspose1d uses cuDNN (provided by custom op)
        x = cuda_extension.conv_transpose1d_forward(
            x_float,
            self.conv_transpose1d.weight,
            self.conv_transpose1d.bias,
            stride=self.conv_transpose1d.stride,
            padding=self.conv_transpose1d.padding,
            output_padding=self.conv_transpose1d.output_padding,
        )
        # Add bias broadcast over length (out_channels, 1) -> (batch, out_channels, length)
        x = cuda_extension.add_bias_forward(x, self.bias)
        return x


===== 现有 CUDA/C++ kernel 文件 =====

===== kernels/fused_ops.cu =====
// fused_ops.cu
#include <cuda_runtime.h>
#include <cmath>

// Fused kernel: compute log10(x) and output boolean mask (x<0.5)
__global__ void fused_log10_lt_kernel(const float* __restrict__ input,
                                      bool* __restrict__ output,
                                      int numel,
                                      float threshold) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx < numel) {
        float val = input[idx];
        float log_val = log10f(val);
        output[idx] = log_val < threshold;
    }
}

// Kernel to convert bool to float (output = input ? 1.0f : 0.0f)
__global__ void bool_to_float_kernel(const bool* __restrict__ input,
                                     float* __restrict__ output,
                                     int numel) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx < numel) {
        output[idx] = input[idx] ? 1.0f : 0.0f;
    }
}

// Kernel to add bias of shape (out_channels, 1) to tensor (batch, out_channels, length)
__global__ void add_bias_kernel(const float* __restrict__ input,
                                const float* __restrict__ bias,
                                float* __restrict__ output,
                                int batch_size,
                                int out_channels,
                                int length) {
    // gridDim.x = batch_size, blockDim.x = 256
    int batch = blockIdx.x;
    int tid = threadIdx.x;
    int total_per_batch = out_channels * length;
    
    for (int offset = tid; offset < total_per_batch; offset += blockDim.x) {
        int channel = offset / length;
        int pos = offset - channel * length;
        int index = batch * total_per_batch + offset;
        output[index] = input[index] + bias[channel];
    }
}

extern "C" void fused_log10_lt_forward_launcher(
        const float* input,
        bool* output,
        int numel,
        float threshold,
        cudaStream_t stream) {
    int block_size = 256;
    int grid_size = (numel + block_size - 1) / block_size;
    fused_log10_lt_kernel<<<grid_size, block_size, 0, stream>>>(input, output, numel, threshold);
}

extern "C" void bool_to_float_forward_launcher(
        const bool* input,
        float* output,
        int numel,
        cudaStream_t stream) {
    int block_size = 256;
    int grid_size = (numel + block_size - 1) / block_size;
    bool_to_float_kernel<<<grid_size, block_size, 0, stream>>>(input, output, numel);
}

extern "C" void add_bias_forward_launcher(
        const float* input,
        const float* bias,
        float* output,
        int batch_size,
        int out_channels,
        int length,
        cudaStream_t stream) {
    int block_size = 256;
    int grid_size = batch_size;
    add_bias_kernel<<<grid_size, block_size, 0, stream>>>(input, bias, output, batch_size, out_channels, length);
}

===== kernels/fused_ops_binding.cpp =====
#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>
#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

// Declare launchers from fused_ops.cu
extern "C" void fused_log10_lt_forward_launcher(
    const float* input,
    bool* output,
    int numel,
    float threshold,
    cudaStream_t stream);

extern "C" void bool_to_float_forward_launcher(
    const bool* input,
    float* output,
    int numel,
    cudaStream_t stream);

extern "C" void add_bias_forward_launcher(
    const float* input,
    const float* bias,
    float* output,
    int batch_size,
    int out_channels,
    int length,
    cudaStream_t stream);

// Wrapper for fused log10 and less-than threshold
at::Tensor fused_log10_lt_forward(at::Tensor input, double threshold) {
    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(input.dtype() == at::kFloat, "Input must be float32");

    auto output = at::empty(input.sizes(), input.options().dtype(at::kBool));
    cudaStream_t stream = at::cuda::getCurrentCUDAStream();
    fused_log10_lt_forward_launcher(
        input.data_ptr<float>(),
        output.data_ptr<bool>(),
        input.numel(),
        static_cast<float>(threshold),
        stream);
    return output;
}

// Wrapper for bool to float conversion
at::Tensor bool_to_float_forward(at::Tensor input) {
    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(input.dtype() == at::kBool, "Input must be bool");

    auto output = at::empty(input.sizes(), input.options().dtype(at::kFloat));
    cudaStream_t stream = at::cuda::getCurrentCUDAStream();
    bool_to_float_forward_launcher(
        input.data_ptr<bool>(),
        output.data_ptr<float>(),
        input.numel(),
        stream);
    return output;
}

// Wrapper for bias addition with shape (out_channels, 1)
// Input tensor shape: (batch_size, out_channels, length)
// Bias tensor shape: (out_channels, 1)
at::Tensor add_bias_forward(at::Tensor input, at::Tensor bias) {
    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(input.dtype() == at::kFloat, "Input must be float32");
    TORCH_CHECK(input.dim() == 3, "Input must be 3D (batch, channels, length)");

    TORCH_CHECK(bias.is_cuda(), "Bias must be a CUDA tensor");
    TORCH_CHECK(bias.is_contiguous(), "Bias must be contiguous");
    TORCH_CHECK(bias.dtype() == at::kFloat, "Bias must be float32");
    TORCH_CHECK(bias.dim() == 2, "Bias must be 2D (channels, 1)");

    int batch_size = input.size(0);
    int out_channels = input.size(1);
    int length = input.size(2);

    TORCH_CHECK(bias.size(0) == out_channels, "Bias channel dimension must match input channels");
    TORCH_CHECK(bias.size(1) == 1, "Bias second dimension must be 1");

    auto output = at::empty_like(input);
    cudaStream_t stream = at::cuda::getCurrentCUDAStream();
    add_bias_forward_launcher(
        input.data_ptr<float>(),
        bias.data_ptr<float>(),
        output.data_ptr<float>(),
        batch_size,
        out_channels,
        length,
        stream);
    return output;
}

// Registration function
void register_fused_ops(pybind11::module& m) {
    m.def("fused_log10_lt_forward", &fused_log10_lt_forward,
          "Fused log10 and less-than threshold",
          py::arg("input"), py::arg("threshold") = 0.5);
    m.def("bool_to_float_forward", &bool_to_float_forward,
          "Convert bool tensor to float (1.0/0.0)",
          py::arg("input"));
    m.def("add_bias_forward", &add_bias_forward,
          "Add bias of shape (channels,1) to 3D tensor",
          py::arg("input"), py::arg("bias"));
}

REGISTER_BINDING(fused_ops, register_fused_ops);
