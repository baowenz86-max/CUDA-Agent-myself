+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    custom_conv_transpose1d_launcher(
+        input.data_ptr<float>(), weight.data_ptr<float>(), bias.data_ptr<float>(), output.data_ptr<float>(),
