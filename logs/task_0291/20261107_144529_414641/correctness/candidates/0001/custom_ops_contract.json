  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = torch.tril(x)",
      "semantics": [
        "对输入 x 做下三角操作，保留最后两维的下三角（含对角线），其余维度不变。",
        "输出 shape、dtype、device 与输入相同。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "return F.relu(x)",
      "semantics": [
        "对 tril 结果逐元素应用 ReLU 激活函数，即 max(0, x)。",
