        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[512, 16, 256, 256]"
      },
      "semantics": [
        "对应 F.relu(x)，逐元素 max(0, x)。",
        "输出与输入同 shape、dtype、device。",
        "输入必须为 CUDA float32 张量。"
      ]
