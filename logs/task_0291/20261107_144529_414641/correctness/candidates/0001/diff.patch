--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,57 @@
+#include <cuda_runtime.h>
+
+// CUDA kernel for torch.tril on last two dimensions
+// Input is a 4D tensor of shape [N, C, H, W], contiguous float32.
+// For each element at (n, c, h, w), output = input if w <= h else 0.
+// All other dimensions map to linear index using row-major order.
+__global__ void tril_kernel(const float* __restrict__ input,
+                            float* __restrict__ output,
+                            int N, int C, int H, int W) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= N * C * H * W) return;
+
+    // Compute 4D indices from linear index (row-major)
+    int w = idx % W;
+    int h = (idx / W) % H;
+    // n and c are not needed for the mask
+    // int c = (idx / (W * H)) % C;
+    // int n = idx / (W * H * C);
+
+    if (w <= h) {
+        output[idx] = input[idx];
+    } else {
+        output[idx] = 0.0f;
+    }
+}
+
+// CUDA kernel for F.relu: element-wise max(0, x)
+__global__ void relu_kernel(const float* __restrict__ input,
+                            float* __restrict__ output,
+                            int total_elements) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= total_elements) return;
+
+    float val = input[idx];
+    output[idx] = val > 0.0f ? val : 0.0f;
+}
+
+// Launcher for tril operation
+// Parameters: input/output pointers, shape N,C,H,W, CUDA stream
+extern "C" void tril_launcher(const float* input, float* output,
+                              int N, int C, int H, int W,
+                              cudaStream_t stream) {
+    int total = N * C * H * W;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    tril_kernel<<<blocks, threads, 0, stream>>>(input, output, N, C, H, W);
+}
+
+// Launcher for relu operation
+// Parameters: input/output pointers, total elements, CUDA stream
+extern "C" void relu_launcher(const float* input, float* output,
+                              int total_elements,
+                              cudaStream_t stream) {
+    int threads = 256;
+    int blocks = (total_elements + threads - 1) / threads;
+    relu_kernel<<<blocks, threads, 0, stream>>>(input, output, total_elements);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,62 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void tril_launcher(const float* input, float* output,
+                              int N, int C, int H, int W,
+                              cudaStream_t stream);
+
+extern "C" void relu_launcher(const float* input, float* output,
+                              int total_elements,
+                              cudaStream_t stream);
+
+// Wrapper for torch.tril on last two dimensions
+torch::Tensor tril(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+
+    // Expected 4D tensor: [N, C, H, W]
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D, got ", x.dim());
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    tril_launcher(x.data_ptr<float>(), output.data_ptr<float>(),
+                  N, C, H, W, stream);
+
+    return output;
+}
+
+// Wrapper for F.relu (element-wise max(0, x))
+torch::Tensor relu(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    relu_launcher(x.data_ptr<float>(), output.data_ptr<float>(),
+                  x.numel(), stream);
+
+    return output;
+}
+
+// Register both operators with pybind11
+void register_custom_ops(pybind11::module& m) {
+    m.def("tril", &tril, "Apply torch.tril on last two dimensions",
+          py::arg("x"));
+    m.def("relu", &relu, "Apply ReLU activation",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,19 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, input_shape):
+        super().__init__()
+        self.input_shape = input_shape
+
+    def forward(self, x):
+        x = cuda_extension.tril(x)
+        return cuda_extension.relu(x)
+
+    def debug_forward(self, x):
+        x = cuda_extension.tril(x)
+        yield 'step_001', x
+        x = cuda_extension.relu(x)
+        yield 'step_002', x
