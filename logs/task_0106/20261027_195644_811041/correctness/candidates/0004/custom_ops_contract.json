{
  "operators": [
    {
      "name": "hardswish_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, in_channels, length]",
          "layout": "supports strides; call .contiguous() if needed",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "y = x * relu6(x + 3) / 6, elementwise, matching torch.nn.Hardswish"
      ]
    },
    {
      "name": "softplus_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, in_channels, length]",
          "layout": "supports strides; call .contiguous() if needed",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "y = log(1 + exp(x)) for x <= threshold, else x, elementwise, matching torch.nn.Softplus with beta=1.0, threshold=20.0"
      ]
    },
    {
      "name": "conv_transpose1d_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, in_channels, length_in]",
          "layout": "supports strides; call .contiguous() if needed",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[in_channels, out_channels, kernel_size]",
          "layout": "supports strides; call .contiguous() if needed",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels]",
          "layout": "supports strides; call .contiguous() if needed",
          "nullable": false,
          "optional": false
        },
        {
          "name": "stride",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "padding",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "output_padding",
          "kind": "int",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, out_channels, length_out] where length_out = (length_in - 1) * stride - 2 * padding + kernel_size + output_padding"
      },
      "semantics": [
        "Uses cuDNN ConvTranspose1d with exact bias, stride, padding, output_padding as reference F.conv_transpose1d call; bias is the module bias and must be used",
        "Preserves axes, strides, and numerical behavior of reference conv_transpose1d"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.hardswish(x)",
      "semantics": [
        "Apply Hardswish activation elementwise: y = x * relu6(x + 3) / 6"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.softplus(x)",
      "semantics": [
        "Apply Softplus activation elementwise: y = log(1 + exp(x)) for x <= 20, else x"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = F.conv_transpose1d(x, self.conv_transpose1d.weight, self.conv_transpose1d.bias, stride=self.conv_transpose1d.stride, padding=self.conv_transpose1d.padding, output_padding=self.conv_transpose1d.output_padding)",
      "semantics": [
        "Perform 1D transposed convolution with given stride, padding, output_padding, and bias; output length computed as (input_length - 1) * stride - 2 * padding + kernel_size + output_padding"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return x",
      "semantics": [
        "Return the final tensor"
      ]
    }
  ]
}