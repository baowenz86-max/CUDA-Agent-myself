--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,164 @@
+#include <cuda_runtime.h>
+
+/*
+ * conv2d_forward 由第三阶段的 C++ 绑定文件使用 cuDNN 实现，不在本文件实现。
+ * 本文件仅包含非卷积 CUDA kernel 和 launcher。
+ */
+
+// ---------------- reflection_pad2d_forward ----------------
+// 输入: input (N, C, H, W), pad_left_right, pad_top_bottom
+// 输出: output (N, C, H+2*pad_top_bottom, W+2*pad_left_right)
+// 支持任意 strides，输出连续。
+__global__ void reflection_pad2d_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int N, int C, int H, int W,
+    int pad_lr, int pad_tb,
+    int in_stride_n, int in_stride_c, int in_stride_h, int in_stride_w,
+    int out_H, int out_W)
+{
+    int out_hw = blockIdx.x * blockDim.x + threadIdx.x;
+    int out_nc = blockIdx.y * blockDim.y + threadIdx.y;
+    if (out_nc >= N * C) return;
+    if (out_hw >= out_H * out_W) return;
+
+    int n = out_nc / C;
+    int c = out_nc % C;
+    int out_h = out_hw / out_W;
+    int out_w = out_hw % out_W;
+
+    int in_h = out_h - pad_tb;
+    int in_w = out_w - pad_lr;
+
+    // 反射索引计算，不重复边缘值
+    if (in_h < 0) in_h = -in_h;
+    else if (in_h >= H) in_h = 2 * (H - 1) - in_h;
+
+    if (in_w < 0) in_w = -in_w;
+    else if (in_w >= W) in_w = 2 * (W - 1) - in_w;
+
+    // 边界情况：当 H=1 时，反射索引可能仍为0，公式仍成立。
+    if (H == 1) in_h = 0;
+    if (W == 1) in_w = 0;
+
+    const float* in_ptr = input + n * in_stride_n + c * in_stride_c + in_h * in_stride_h + in_w * in_stride_w;
+    float* out_ptr = output + n * C * out_H * out_W + c * out_H * out_W + out_h * out_W + out_w;
+    *out_ptr = *in_ptr;
+}
+
+extern "C" void reflection_pad2d_forward_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    int pad_lr, int pad_tb,
+    int in_stride_n, int in_stride_c, int in_stride_h, int in_stride_w,
+    cudaStream_t stream)
+{
+    int out_H = H + 2 * pad_tb;
+    int out_W = W + 2 * pad_lr;
+    int total_hw = out_H * out_W;
+    int total_nc = N * C;
+
+    dim3 block(16, 16);
+    dim3 grid((total_hw + block.x - 1) / block.x, (total_nc + block.y - 1) / block.y);
+
+    reflection_pad2d_kernel<<<grid, block, 0, stream>>>(
+        input, output, N, C, H, W, pad_lr, pad_tb,
+        in_stride_n, in_stride_c, in_stride_h, in_stride_w,
+        out_H, out_W);
+}
+
+// ---------------- glu_forward ----------------
+// 输入: input (..., C, ...) 连续? 支持 strides
+// dim: 分割维度
+// 输出: 形状与输入相同但 dim 维度减半，连续。
+// 该实现将输入视为任意维度，但使用 strides 进行索引。
+// 由于 GLU 通常用于4维，且 dim=1，这里实现通用但针对性能优化为4维 dim=1 情况，也支持其他情况。
+// 注意：输出为连续，因此可以利用线性索引，但为简单起见使用嵌套循环。
+__global__ void glu_kernel_general(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int total_outer, // 外层循环长度
+    int C, // dim 维度大小
+    int inner, // 内层循环长度
+    int input_stride_outer, int input_stride_dim, int input_stride_inner,
+    int output_stride_outer, int output_stride_dim, int output_stride_inner)
+{
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= total_outer * inner) return;
+
+    int outer = idx / inner;
+    int inner_idx = idx % inner;
+
+    int half_C = C / 2;
+
+    const float* a_ptr = input + outer * input_stride_outer + inner_idx * input_stride_inner;
+    const float* b_ptr = a_ptr + half_C * input_stride_dim;
+
+    float a = *a_ptr;
+    float b = *b_ptr;
+    float out = a / (1.0f + expf(-b)); // sigmoid(b) = 1/(1+exp(-b))
+
+    float* out_ptr = output + outer * output_stride_outer + inner_idx * output_stride_inner;
+    *out_ptr = out;
+}
+
+extern "C" void glu_forward_launcher(
+    const float* input,
+    float* output,
+    int total_outer, int C, int inner,
+    int input_stride_outer, int input_stride_dim, int input_stride_inner,
+    int output_stride_outer, int output_stride_dim, int output_stride_inner,
+    cudaStream_t stream)
+{
+    int total = total_outer * inner;
+    int block = 256;
+    int grid = (total + block - 1) / block;
+    glu_kernel_general<<<grid, block, 0, stream>>>(
+        input, output, total_outer, C, inner,
+        input_stride_outer, input_stride_dim, input_stride_inner,
+        output_stride_outer, output_stride_dim, output_stride_inner);
+}
+
+// ---------------- min_dim_forward ----------------
+// 输入: input 任意维，dim 指定维度。
+// 输出: 形状与输入相同但 dim 维度移除，连续。
+// 实现为每个输出元素独立计算，使用 grid-stride loop。
+// 假设输出连续，但支持输入任意 strides。
+__global__ void min_dim_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int total_outer, int D, int inner,
+    int input_stride_outer, int input_stride_dim, int input_stride_inner)
+{
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+    for (int i = idx; i < total_outer * inner; i += stride) {
+        int outer = i / inner;
+        int inner_idx = i % inner;
+        const float* base = input + outer * input_stride_outer + inner_idx * input_stride_inner;
+        float min_val = base[0];
+        for (int d = 1; d < D; ++d) {
+            float v = base[d * input_stride_dim];
+            if (v < min_val) min_val = v;
+        }
+        output[i] = min_val;
+    }
+}
+
+extern "C" void min_dim_forward_launcher(
+    const float* input,
+    float* output,
+    int total_outer, int D, int inner,
+    int input_stride_outer, int input_stride_dim, int input_stride_inner,
+    cudaStream_t stream)
+{
+    int total = total_outer * inner;
+    int block = 256;
+    int grid = (total + block - 1) / block;
+    // 限制 grid 大小，使用 grid-stride loop
+    if (grid > 4096) grid = 4096;
+    min_dim_kernel<<<grid, block, 0, stream>>>(
+        input, output, total_outer, D, inner,
+        input_stride_outer, input_stride_dim, input_stride_inner);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,379 @@
+// Binding file for custom ops: reflection_pad2d, conv2d (cuDNN), glu, min_dim
+// Includes appropriate headers, validates tensors, calls launchers from custom_ops.cu
+// Registers all functions with pybind.
+
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cudnn.h>
+
+#include "../binding_registry.h"
+
+// Forward declarations of launchers from custom_ops.cu
+extern "C" void reflection_pad2d_forward_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    int pad_lr, int pad_tb,
+    int in_stride_n, int in_stride_c, int in_stride_h, int in_stride_w,
+    cudaStream_t stream);
+
+extern "C" void glu_forward_launcher(
+    const float* input,
+    float* output,
+    int total_outer, int C, int inner,
+    int input_stride_outer, int input_stride_dim, int input_stride_inner,
+    int output_stride_outer, int output_stride_dim, int output_stride_inner,
+    cudaStream_t stream);
+
+extern "C" void min_dim_forward_launcher(
+    const float* input,
+    float* output,
+    int total_outer, int D, int inner,
+    int input_stride_outer, int input_stride_dim, int input_stride_inner,
+    cudaStream_t stream);
+
+// Helper to check CUDA error after kernel launch
+static void check_cuda_error() {
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        TORCH_CHECK(false, "CUDA error: ", cudaGetErrorString(err));
+    }
+}
+
+// ---------------- reflection_pad2d_forward ----------------
+torch::Tensor reflection_pad2d_forward(torch::Tensor input, int64_t pad_left_right, int64_t pad_top_bottom) {
+    TORCH_CHECK(input.is_cuda(), "reflection_pad2d input must be a CUDA tensor");
+    TORCH_CHECK(input.scalar_type() == torch::kFloat32, "reflection_pad2d input must be float32");
+    TORCH_CHECK(input.dim() == 4, "reflection_pad2d input must be 4D (N, C, H, W)");
+
+    int N = input.size(0);
+    int C = input.size(1);
+    int H = input.size(2);
+    int W = input.size(3);
+
+    int out_H = H + 2 * (int)pad_top_bottom;
+    int out_W = W + 2 * (int)pad_left_right;
+
+    auto output = torch::empty({N, C, out_H, out_W}, input.options());
+
+    int64_t in_stride_n = input.stride(0);
+    int64_t in_stride_c = input.stride(1);
+    int64_t in_stride_h = input.stride(2);
+    int64_t in_stride_w = input.stride(3);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    reflection_pad2d_forward_launcher(
+        input.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C, H, W,
+        (int)pad_left_right, (int)pad_top_bottom,
+        (int)in_stride_n, (int)in_stride_c, (int)in_stride_h, (int)in_stride_w,
+        stream
+    );
+
+    check_cuda_error();
+    return output;
+}
+
+// ---------------- conv2d_forward using cuDNN ----------------
+torch::Tensor conv2d_forward(
+    torch::Tensor input,
+    torch::Tensor weight,
+    torch::Tensor bias,
+    int64_t stride,
+    int64_t padding,
+    int64_t dilation,
+    int64_t groups) {
+
+    TORCH_CHECK(input.is_cuda(), "conv2d input must be a CUDA tensor");
+    TORCH_CHECK(weight.is_cuda(), "conv2d weight must be a CUDA tensor");
+    TORCH_CHECK(input.scalar_type() == torch::kFloat32, "conv2d input must be float32");
+    TORCH_CHECK(weight.scalar_type() == torch::kFloat32, "conv2d weight must be float32");
+    TORCH_CHECK(input.dim() == 4, "conv2d input must be 4D (N, C, H, W)");
+    TORCH_CHECK(weight.dim() == 4, "conv2d weight must be 4D (C_out, C_in/groups, kH, kW)");
+
+    if (bias.numel() > 0) {
+        TORCH_CHECK(bias.is_cuda(), "conv2d bias must be a CUDA tensor");
+        TORCH_CHECK(bias.scalar_type() == torch::kFloat32, "conv2d bias must be float32");
+        TORCH_CHECK(bias.dim() == 1, "conv2d bias must be 1D");
+        TORCH_CHECK(bias.size(0) == weight.size(0), "conv2d bias size must match output channels");
+    }
+
+    int N = input.size(0);
+    int C_in = input.size(1);
+    int H = input.size(2);
+    int W = input.size(3);
+    int C_out = weight.size(0);
+    int kH = weight.size(2);
+    int kW = weight.size(3);
+
+    int stride_h = (int)stride;
+    int stride_w = (int)stride;
+    int pad_h = (int)padding;
+    int pad_w = (int)padding;
+    int dilation_h = (int)dilation;
+    int dilation_w = (int)dilation;
+
+    int H_out = (H + 2 * pad_h - dilation_h * (kH - 1) - 1) / stride_h + 1;
+    int W_out = (W + 2 * pad_w - dilation_w * (kW - 1) - 1) / stride_w + 1;
+
+    auto output = torch::empty({N, C_out, H_out, W_out}, input.options());
+
+    cudnnHandle_t cudnn_handle;
+    cudnnStatus_t status = cudnnCreate(&cudnn_handle);
+    TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cuDNN create failed");
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    status = cudnnSetStream(cudnn_handle, stream);
+    TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cuDNN set stream failed");
+
+    cudnnTensorDescriptor_t input_desc, output_desc;
+    cudnnFilterDescriptor_t filter_desc;
+    cudnnConvolutionDescriptor_t conv_desc;
+
+    status = cudnnCreateTensorDescriptor(&input_desc);
+    TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cuDNN create input tensor descriptor failed");
+    status = cudnnCreateTensorDescriptor(&output_desc);
+    TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cuDNN create output tensor descriptor failed");
+    status = cudnnCreateFilterDescriptor(&filter_desc);
+    TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cuDNN create filter descriptor failed");
+    status = cudnnCreateConvolutionDescriptor(&conv_desc);
+    TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cuDNN create convolution descriptor failed");
+
+    status = cudnnSetTensor4dDescriptor(input_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT, N, C_in, H, W);
+    TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cuDNN set input tensor descriptor failed");
+    status = cudnnSetTensor4dDescriptor(output_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT, N, C_out, H_out, W_out);
+    TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cuDNN set output tensor descriptor failed");
+    status = cudnnSetFilter4dDescriptor(filter_desc, CUDNN_DATA_FLOAT, CUDNN_TENSOR_NCHW, C_out, C_in / (int)groups, kH, kW);
+    TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cuDNN set filter descriptor failed");
+
+    status = cudnnSetConvolution2dDescriptor(
+        conv_desc,
+        pad_h, pad_w,
+        stride_h, stride_w,
+        dilation_h, dilation_w,
+        CUDNN_CROSS_CORRELATION,  // PyTorch uses cross-correlation
+        CUDNN_DATA_FLOAT
+    );
+    TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cuDNN set convolution descriptor failed");
+
+    if ((int)groups > 1) {
+        status = cudnnSetConvolutionGroupCount(conv_desc, (int)groups);
+        TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cuDNN set group count failed");
+    }
+
+    cudnnConvolutionFwdAlgo_t algo;
+    int requested_algo_count = 1;
+    cudnnConvolutionFwdAlgoPerf_t perf_results[1];
+    status = cudnnFindConvolutionForwardAlgorithm(
+        cudnn_handle,
+        input_desc,
+        filter_desc,
+        conv_desc,
+        output_desc,
+        requested_algo_count,
+        &requested_algo_count,
+        perf_results
+    );
+    if (status == CUDNN_STATUS_SUCCESS && requested_algo_count > 0) {
+        algo = perf_results[0].algo;
+    } else {
+        // fallback to a default algorithm
+        algo = CUDNN_CONVOLUTION_FWD_ALGO_IMPLICIT_GEMM;
+    }
+
+    size_t workspace_size = 0;
+    status = cudnnGetConvolutionForwardWorkspaceSize(
+        cudnn_handle,
+        input_desc,
+        filter_desc,
+        conv_desc,
+        output_desc,
+        algo,
+        &workspace_size
+    );
+    TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cuDNN get workspace size failed");
+
+    void* workspace = nullptr;
+    if (workspace_size > 0) {
+        cudaMalloc(&workspace, workspace_size);
+        TORCH_CHECK(workspace != nullptr, "cudaMalloc failed for cuDNN workspace");
+    }
+
+    float alpha = 1.0f;
+    float beta = 0.0f;
+
+    status = cudnnConvolutionForward(
+        cudnn_handle,
+        &alpha,
+        input_desc,
+        input.data_ptr<float>(),
+        filter_desc,
+        weight.data_ptr<float>(),
+        conv_desc,
+        algo,
+        workspace,
+        workspace_size,
+        &beta,
+        output_desc,
+        output.data_ptr<float>()
+    );
+
+    // Add bias if provided
+    if (bias.numel() > 0) {
+        cudnnTensorDescriptor_t bias_desc;
+        status = cudnnCreateTensorDescriptor(&bias_desc);
+        TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cuDNN create bias descriptor failed");
+        status = cudnnSetTensor4dDescriptor(bias_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT, 1, C_out, 1, 1);
+        TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cuDNN set bias descriptor failed");
+
+        beta = 1.0f;
+        status = cudnnAddTensor(
+            cudnn_handle,
+            &alpha,
+            bias_desc,
+            bias.data_ptr<float>(),
+            &beta,
+            output_desc,
+            output.data_ptr<float>()
+        );
+
+        cudnnDestroyTensorDescriptor(bias_desc);
+    }
+
+    TORCH_CHECK(status == CUDNN_STATUS_SUCCESS, "cuDNN convolution forward or bias add failed");
+
+    if (workspace) cudaFree(workspace);
+    cudnnDestroyTensorDescriptor(input_desc);
+    cudnnDestroyTensorDescriptor(output_desc);
+    cudnnDestroyFilterDescriptor(filter_desc);
+    cudnnDestroyConvolutionDescriptor(conv_desc);
+    cudnnDestroy(cudnn_handle);
+
+    check_cuda_error();
+    return output;
+}
+
+// ---------------- glu_forward ----------------
+torch::Tensor glu_forward(torch::Tensor input, int64_t dim) {
+    TORCH_CHECK(input.is_cuda(), "glu input must be a CUDA tensor");
+    TORCH_CHECK(input.scalar_type() == torch::kFloat32, "glu input must be float32");
+
+    int64_t dim_size = input.size(dim);
+    TORCH_CHECK(dim_size % 2 == 0, "glu split dimension must be even");
+
+    // Normalize dim to positive
+    if (dim < 0) dim += input.dim();
+    TORCH_CHECK(dim >= 0 && dim < input.dim(), "glu dim out of range");
+
+    int C = (int)dim_size;
+    int half_C = C / 2;
+
+    int total_outer = 1;
+    for (int i = 0; i < (int)dim; ++i) {
+        total_outer *= input.size(i);
+    }
+    int inner = 1;
+    for (int i = (int)dim + 1; i < input.dim(); ++i) {
+        inner *= input.size(i);
+    }
+
+    std::vector<int64_t> output_sizes;
+    output_sizes.reserve(input.dim());
+    for (int i = 0; i < input.dim(); ++i) {
+        if (i == (int)dim) {
+            output_sizes.push_back(half_C);
+        } else {
+            output_sizes.push_back(input.size(i));
+        }
+    }
+    auto output = torch::empty(output_sizes, input.options());
+
+    int64_t input_stride_outer = input.stride(0);  // Need to adjust if dim != 1; for our use dim=1, outer stride is stride(0), dim stride is stride(1), inner stride is stride(2)
+    int64_t input_stride_dim = input.stride((int)dim);
+    int64_t input_stride_inner = (dim + 1 < input.dim()) ? input.stride((int)dim + 1) : 0;
+
+    int64_t output_stride_outer = (dim > 0) ? output.stride(0) : 0; // If dim=0, output_stride_outer not used? We handle generic but our usage dim=1 so this works.
+    int64_t output_stride_dim = output.stride((int)dim);
+    int64_t output_stride_inner = (dim + 1 < output.dim()) ? output.stride((int)dim + 1) : 0;
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    glu_forward_launcher(
+        input.data_ptr<float>(),
+        output.data_ptr<float>(),
+        total_outer, C, inner,
+        (int)input_stride_outer, (int)input_stride_dim, (int)input_stride_inner,
+        (int)output_stride_outer, (int)output_stride_dim, (int)output_stride_inner,
+        stream
+    );
+
+    check_cuda_error();
+    return output;
+}
+
+// ---------------- min_dim_forward ----------------
+torch::Tensor min_dim_forward(torch::Tensor input, int64_t dim) {
+    TORCH_CHECK(input.is_cuda(), "min_dim input must be a CUDA tensor");
+    TORCH_CHECK(input.scalar_type() == torch::kFloat32, "min_dim input must be float32");
+
+    if (dim < 0) dim += input.dim();
+    TORCH_CHECK(dim >= 0 && dim < input.dim(), "min_dim dim out of range");
+
+    int D = (int)input.size(dim);
+    TORCH_CHECK(D > 0, "min_dim dimension size must be positive");
+
+    int total_outer = 1;
+    for (int i = 0; i < (int)dim; ++i) {
+        total_outer *= input.size(i);
+    }
+    int inner = 1;
+    for (int i = (int)dim + 1; i < input.dim(); ++i) {
+        inner *= input.size(i);
+    }
+
+    std::vector<int64_t> output_sizes;
+    output_sizes.reserve(input.dim() - 1);
+    for (int i = 0; i < input.dim(); ++i) {
+        if (i != (int)dim) {
+            output_sizes.push_back(input.size(i));
+        }
+    }
+    auto output = torch::empty(output_sizes, input.options());
+
+    int64_t input_stride_outer = (dim > 0) ? input.stride(0) : 0;
+    int64_t input_stride_dim = input.stride((int)dim);
+    int64_t input_stride_inner = (dim + 1 < input.dim()) ? input.stride((int)dim + 1) : 0;
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    min_dim_forward_launcher(
+        input.data_ptr<float>(),
+        output.data_ptr<float>(),
+        total_outer, D, inner,
+        (int)input_stride_outer, (int)input_stride_dim, (int)input_stride_inner,
+        stream
+    );
+
+    check_cuda_error();
+    return output;
+}
+
+// ---------------- Registration ----------------
+void register_custom_ops(pybind11::module& m) {
+    m.def("reflection_pad2d_forward", &reflection_pad2d_forward, "ReflectionPad2d forward",
+          pybind11::arg("input"), pybind11::arg("pad_left_right"), pybind11::arg("pad_top_bottom"));
+    m.def("conv2d_forward", &conv2d_forward, "Conv2d forward using cuDNN",
