{
  "operators": [
    {
      "name": "reflection_pad2d_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "pad_left_right",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "pad_top_bottom",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C, H+2*pad_top_bottom, W+2*pad_left_right]"
      },
      "semantics": [
        "Corresponds to nn.ReflectionPad2d((pad_left, pad_right, pad_top, pad_bottom)).",
        "Reflects elements across the specified padding boundaries without repeating the edge value.",
        "Supports arbitrary strides; output is contiguous."
      ]
    },
    {
      "name": "conv2d_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C_in, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C_out, C_in/groups, kH, kW]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C_out]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "stride",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "padding",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "dilation",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "groups",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C_out, H_out, W_out]"
      },
      "semantics": [
        "Corresponds to torch.nn.Conv2d with bias, using cuDNN backend in later implementation.",
        "H_out = floor((H + 2*padding - dilation*(kH-1) - 1)/stride) + 1, similarly for W.",
        "Bias is added if provided; if bias is None, no bias addition.",
        "Supports groups for grouped convolution.",
        "Output is contiguous."
      ]
    },
    {
      "name": "glu_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[..., C, ...]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[..., C/2, ...] with dim reduced"
      },
      "semantics": [
        "Corresponds to torch.nn.GLU(dim).",
        "Splits input along dim into two equal halves a and b.",
        "Computes a * sigmoid(b).",
        "Output has half the channels along dim."
      ]
    },
    {
      "name": "min_dim_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[..., ...]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input with dim removed"
      },
      "semantics": [
        "Corresponds to torch.min(input, dim=dim)[0].",
        "Returns the minimum value along the specified dimension.",
        "No indices returned."
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.reflection_pad(x)",
      "semantics": [
        "ReflectionPad2d with padding=(1,1,1,1) applied to input [512,3,128,128].",
        "Produces [512,3,130,130] on CUDA."
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.conv(x)",
      "semantics": [
        "Conv2d with weight [32,3,3,3], bias [32], stride=2, padding=0, dilation=1, groups=1.",
        "Input [512,3,130,130] produces [512,32,64,64]."
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = self.glu(x)",
      "semantics": [
        "GLU(dim=1) splits [512,32,64,64] into [512,16,64,64] halves.",
        "Computes a*sigmoid(b), output [512,16,64,64]."
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "x = torch.min(x, dim=1)[0]",
      "semantics": [
        "Min reduction over channel dim of [512,16,64,64].",
        "Produces [512,64,64]."
      ]
    },
    {
      "checkpoint": "step_005",
      "source": "return x",
      "semantics": [
        "Final output [512,64,64]."
      ]
    }
  ]
}