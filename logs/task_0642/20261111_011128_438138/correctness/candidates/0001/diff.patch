--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,79 @@
+#include <cuda_runtime.h>
+
+// Sum over dimension 1 (channels) with keepdim=True.
+// Input: x of shape [N, C, H, W] contiguous float32.
+// Output: y of shape [N, 1, H, W] contiguous float32.
+// Each thread handles one output element (n,0,h,w), looping over C.
+__global__ void sum_dim1_keepdim_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ y,
+    int N, int C, int H, int W)
+{
+    int64_t total_elements = (int64_t)N * H * W;
+    int64_t idx = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)gridDim.x * blockDim.x;
+
+    for (int64_t i = idx; i < total_elements; i += stride) {
+        int n = i / ((int64_t)H * W);
+        int64_t rem = i - n * (int64_t)H * W;
+        int h = rem / W;
+        int w = rem - h * W;
+
+        float sum = 0.0f;
+        const float* x_base = x + ((int64_t)n * C) * H * W;
+        for (int c = 0; c < C; ++c) {
+            sum += x_base[((int64_t)c * H + h) * W + w];
+        }
+        y[i] = sum;
+    }
+}
+
+// Replace NaN with zero, keep other values.
+__global__ void nan_to_num_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ y,
+    int64_t numel)
+{
+    int64_t idx = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)gridDim.x * blockDim.x;
+
+    for (int64_t i = idx; i < numel; i += stride) {
+        float v = x[i];
+        y[i] = isnan(v) ? 0.0f : v;
+    }
+}
+
+// Launcher for custom_sum_dim1_keepdim
+extern "C" void sum_dim1_keepdim_launcher(
+    const float* x,
+    float* y,
+    int N, int C, int H, int W,
+    cudaStream_t stream)
+{
+    int64_t total_elements = (int64_t)N * H * W;
+    int threads = 256;
+    int blocks = (int)((total_elements + threads - 1) / threads);
+    // Cap grid to avoid exceeding max grid dimension (2^31-1).
+    const int max_blocks = 1048576; // 2^20, safe for all GPUs
+    if (blocks > max_blocks) blocks = max_blocks;
+
+    sum_dim1_keepdim_kernel<<<blocks, threads, 0, stream>>>(
+        x, y, N, C, H, W);
+}
+
+// Launcher for custom_nan_to_num
+extern "C" void nan_to_num_launcher(
+    const float* x,
+    float* y,
+    int64_t numel,
+    cudaStream_t stream)
+{
+    int threads = 256;
+    int64_t blocks64 = (numel + threads - 1) / threads;
+    // Cap blocks to avoid overflow and excessive grid size.
+    const int64_t max_blocks = 1048576;
+    int blocks = (int)(blocks64 < max_blocks ? blocks64 : max_blocks);
+
+    nan_to_num_kernel<<<blocks, threads, 0, stream>>>(
+        x, y, numel);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,75 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+extern "C" void sum_dim1_keepdim_launcher(
+    const float* x,
+    float* y,
+    int N, int C, int H, int W,
+    cudaStream_t stream);
+
+extern "C" void nan_to_num_launcher(
+    const float* x,
+    float* y,
+    int64_t numel,
+    cudaStream_t stream);
+
+torch::Tensor custom_sum_dim1_keepdim(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D (N,C,H,W)");
+
+    auto sizes = x.sizes();
+    int64_t N = sizes[0];
+    int64_t C = sizes[1];
+    int64_t H = sizes[2];
+    int64_t W = sizes[3];
+
+    auto y = torch::empty({N, 1, H, W}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    sum_dim1_keepdim_launcher(
+        x.data_ptr<float>(),
+        y.data_ptr<float>(),
+        static_cast<int>(N),
+        static_cast<int>(C),
+        static_cast<int>(H),
+        static_cast<int>(W),
+        stream);
+
+    return y;
+}
+
+torch::Tensor custom_nan_to_num(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+
+    auto y = torch::empty_like(x);
+    int64_t numel = x.numel();
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    nan_to_num_launcher(
+        x.data_ptr<float>(),
+        y.data_ptr<float>(),
+        numel,
+        stream);
+
+    return y;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_sum_dim1_keepdim", &custom_sum_dim1_keepdim,
+          "Sum over dimension 1 (channels) with keepdim=True",
+          py::arg("x"));
+    m.def("custom_nan_to_num", &custom_nan_to_num,
+          "Replace NaN values with zero",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,22 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x):
+        x = cuda_extension.custom_sum_dim1_keepdim(x)
+        x = cuda_extension.custom_nan_to_num(x)
+        return x
+
+    def debug_forward(self, *inputs):
+        if len(inputs) != 1:
+            raise ValueError("Expected exactly 1 input tensor")
+        x = inputs[0]
+        yield "step_001", cuda_extension.custom_sum_dim1_keepdim(x)
+        x = cuda_extension.custom_nan_to_num(x)
+        yield "step_002", x
+        yield "step_003", x
