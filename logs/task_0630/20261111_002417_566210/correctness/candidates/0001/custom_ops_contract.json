{
  "operators": [
    {
      "name": "custom_abs",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference step input: [B, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对应参考语句 x = torch.abs(x)",
        "逐元素计算绝对值，不改变 shape、stride、dtype",
        "输出与输入同一设备"
      ]
    },
    {
      "name": "custom_reduce_lastdim",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, C, H, W]",
          "layout": "contiguous or as provided; launcher handles strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[B, C, H]"
      },
      "semantics": [
        "对应参考语句 x = torch.einsum('bixy->biy', x)",
        "沿最后一维（W 维度）求和，输出形状为 [B, C, H]",
        "不改变其他维度顺序，输出连续张量"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = torch.abs(x)",
      "semantics": [
        "计算输入张量每个元素的绝对值，保持 shape 和 stride",
        "dtype 保持不变，输出设备为 cuda"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.einsum('bixy->biy', x)",
      "semantics": [
        "沿最后一个维度（索引 y）求和，输出形状 [B, C, H]",
        "输出为连续张量，device cuda"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回求和后的张量"
      ]
    }
  ]
