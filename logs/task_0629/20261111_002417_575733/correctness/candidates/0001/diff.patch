--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,77 @@
+#include <cuda_runtime.h>
+
+// CUDA kernel for concatenating two tensors along dim=1.
+// Each tensor has shape [N, C, H, W] with C = 8, concatenated C_out = 16.
+// Since tensors are contiguous, output is contiguous.
+// We assume both inputs are contiguous, otherwise binding layer should make contiguous copies.
+// For arbitrary shapes, we can launch a 1D kernel with total elements = N*C_out*H*W.
+// The kernel computes output index and copies from appropriate input.
+__global__ void cat_kernel(float* __restrict__ output,
+                           const float* __restrict__ input1,
+                           const float* __restrict__ input2,
+                           int N, int C_in, int C_out, int H, int W) {
+    int total = N * C_out * H * W;
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+    int plane = H * W;
+    int in_plane_offset = C_in * plane;
+    for (int i = idx; i < total; i += stride) {
+        // Compute coordinates
+        int w = i % W;
+        int h = (i / W) % H;
+        int c = (i / (W * H)) % C_out;
+        int n = i / (W * H * C_out);
+        if (c < C_in) {
+            int src_idx = ((n * C_in + c) * H + h) * W + w;
+            output[i] = input1[src_idx];
+        } else {
+            int c2 = c - C_in;
+            int src_idx = ((n * C_in + c2) * H + h) * W + w;
+            output[i] = input2[src_idx];
+        }
+    }
+}
+
+// CUDA kernel for element-wise multiplication with scalar multiplier.
+// multiplier is expected to have at least one element, we read multiplier[0].
+__global__ void mul_scalar_kernel(float* __restrict__ output,
+                                  const float* __restrict__ input,
+                                  const float* __restrict__ multiplier,
+                                  int total) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+    float scalar = multiplier[0];
+    for (int i = idx; i < total; i += stride) {
+        output[i] = input[i] * scalar;
+    }
+}
+
+// Launcher for concatenation: out = cat([in1, in2], dim=1)
+// Inputs are pointer to contiguous float arrays, sizes: in1 and in2 have same shape [N, C_in, H, W]
+// Output shape [N, C_out, H, W] with C_out = 2*C_in.
+// N, C_in, H, W are int.
+extern "C" void custom_cat_launcher(float* output,
+                                   const float* input1,
+                                   const float* input2,
+                                   int N, int C_in, int H, int W,
+                                   cudaStream_t stream) {
+    int C_out = 2 * C_in;
+    int total = N * C_out * H * W;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535; // grid limit
+    cat_kernel<<<blocks, threads, 0, stream>>>(output, input1, input2, N, C_in, C_out, H, W);
+}
+
+// Launcher for multiplication: out = x * multiplier (broadcast scalar)
+// x shape: [N, C, H, W] total = N*C*H*W
+extern "C" void custom_mul_launcher(float* output,
+                                    const float* input,
+                                    const float* multiplier,
+                                    int total,
+                                    cudaStream_t stream) {
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535;
+    mul_scalar_kernel<<<blocks, threads, 0, stream>>>(output, input, multiplier, total);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,99 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_runtime.h>
+#include <vector>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void custom_cat_launcher(float* output,
+                                   const float* input1,
+                                   const float* input2,
+                                   int N, int C_in, int H, int W,
+                                   cudaStream_t stream);
+
+extern "C" void custom_mul_launcher(float* output,
+                                    const float* input,
+                                    const float* multiplier,
+                                    int total,
+                                    cudaStream_t stream);
+
+// Utility to check that a tensor is a CUDA float32 contiguous tensor
+torch::Tensor custom_cat_forward(const std::vector<torch::Tensor>& inputs, int64_t dim) {
+    TORCH_CHECK(dim == 1, "custom_cat_forward only supports dim=1");
+    TORCH_CHECK(inputs.size() == 2, "custom_cat_forward expects exactly 2 input tensors");
+    
+    const auto& input1 = inputs[0];
+    const auto& input2 = inputs[1];
+    
+    TORCH_CHECK(input1.is_cuda() && input2.is_cuda(), "Input tensors must be CUDA");
+    TORCH_CHECK(input1.dtype() == torch::kFloat32 && input2.dtype() == torch::kFloat32,
+                "Input tensors must be float32");
+    TORCH_CHECK(input1.is_contiguous() && input2.is_contiguous(),
+                "Input tensors must be contiguous");
+    
+    // Expected shape: [N, C_in, H, W]
+    const auto sizes1 = input1.sizes();
+    const auto sizes2 = input2.sizes();
+    TORCH_CHECK(sizes1.size() == 4 && sizes2.size() == 4, "Input tensors must be 4D");
+    TORCH_CHECK(sizes1 == sizes2, "Input tensors must have identical shapes");
+    
+    int N = sizes1[0];
+    int C_in = sizes1[1];
+    int H = sizes1[2];
+    int W = sizes1[3];
+    int C_out = 2 * C_in;
+    
+    // Allocate output tensor of shape [N, C_out, H, W]
+    auto output = torch::empty({N, C_out, H, W}, input1.options());
+    
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    
+    custom_cat_launcher(
+        output.data_ptr<float>(),
+        input1.data_ptr<float>(),
+        input2.data_ptr<float>(),
+        N, C_in, H, W,
+        stream
+    );
+    
+    return output;
+}
+
+torch::Tensor custom_mul_forward(const torch::Tensor& x, const torch::Tensor& multiplier) {
+    TORCH_CHECK(x.is_cuda() && multiplier.is_cuda(), "Input tensors must be CUDA");
+    TORCH_CHECK(x.dtype() == torch::kFloat32 && multiplier.dtype() == torch::kFloat32,
+                "Input tensors must be float32");
+    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
+    TORCH_CHECK(multiplier.is_contiguous(), "multiplier must be contiguous");
+    TORCH_CHECK(x.dim() == 4, "x must be 4D");
+    TORCH_CHECK(multiplier.numel() == 1, "multiplier must have exactly 1 element");
+    
+    int total = x.numel();
+    
+    auto output = torch::empty_like(x);
+    
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    
+    custom_mul_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        multiplier.data_ptr<float>(),
+        total,
+        stream
+    );
+    
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_cat_forward", &custom_cat_forward,
+          "Concatenate two float32 CUDA tensors along dim 1",
+          py::arg("inputs"), py::arg("dim") = 1);
+    m.def("custom_mul_forward", &custom_mul_forward,
+          "Multiply tensor x by scalar multiplier",
+          py::arg("x"), py::arg("multiplier"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,21 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, num_inputs, num_outputs, multiplier_shape):
+        super().__init__()
+        self.multiplier = nn.Parameter(torch.randn(multiplier_shape))
+
+    def forward(self, *inputs):
+        concatenated = cuda_extension.custom_cat_forward(list(inputs), dim=1)
+        multiplied = cuda_extension.custom_mul_forward(concatenated, self.multiplier)
+        return multiplied
+
+    def debug_forward(self, *inputs):
+        concatenated = cuda_extension.custom_cat_forward(list(inputs), dim=1)
+        yield 'step_001', concatenated
+        multiplied = cuda_extension.custom_mul_forward(concatenated, self.multiplier)
+        yield 'step_002', multiplied
+        yield 'step_003', multiplied
