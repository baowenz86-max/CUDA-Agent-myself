--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,52 @@
+#include <cuda_runtime.h>
+
+// Elementwise isnan: output[i] = (input[i] != input[i]) ? 1.0f : 0.0f
+__global__ void isnan_kernel(const float* __restrict__ input,
+                             float* __restrict__ output,
+                             long long numel) {
+    long long idx = static_cast<long long>(blockIdx.x) * blockDim.x + threadIdx.x;
+    long long stride = static_cast<long long>(blockDim.x) * gridDim.x;
+    for (long long i = idx; i < numel; i += stride) {
+        float val = input[i];
+        output[i] = (val != val) ? 1.0f : 0.0f;
+    }
+}
+
+// Elementwise ReLU6: output[i] = min(max(input[i], 0.0f), 6.0f)
+__global__ void relu6_kernel(const float* __restrict__ input,
+                             float* __restrict__ output,
+                             long long numel) {
+    long long idx = static_cast<long long>(blockIdx.x) * blockDim.x + threadIdx.x;
+    long long stride = static_cast<long long>(blockDim.x) * gridDim.x;
+    for (long long i = idx; i < numel; i += stride) {
+        float val = input[i];
+        float clamped = val < 0.0f ? 0.0f : (val > 6.0f ? 6.0f : val);
+        output[i] = clamped;
+    }
+}
+
+extern "C" void custom_isnan_launcher(float* output,
+                                      const float* input,
+                                      long long numel,
+                                      cudaStream_t stream) {
+    if (numel <= 0) return;
+    const int threads = 256;
+    const int max_blocks = 65535 * 32; // conservative, allows large grid
+    int blocks = static_cast<int>((numel + threads - 1) / threads);
+    if (blocks > max_blocks) blocks = max_blocks;
+    if (blocks <= 0) blocks = 1;
+    isnan_kernel<<<blocks, threads, 0, stream>>>(input, output, numel);
+}
+
+extern "C" void custom_relu6_launcher(float* output,
+                                       const float* input,
+                                       long long numel,
+                                       cudaStream_t stream) {
+    if (numel <= 0) return;
+    const int threads = 256;
+    const int max_blocks = 65535 * 32;
+    int blocks = static_cast<int>((numel + threads - 1) / threads);
+    if (blocks > max_blocks) blocks = max_blocks;
+    if (blocks <= 0) blocks = 1;
+    relu6_kernel<<<blocks, threads, 0, stream>>>(input, output, numel);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,65 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void custom_isnan_launcher(float* output,
+                                      const float* input,
+                                      long long numel,
+                                      cudaStream_t stream);
+
+extern "C" void custom_relu6_launcher(float* output,
+                                       const float* input,
+                                       long long numel,
+                                       cudaStream_t stream);
+
+// PyTorch wrapper for isnan
+torch::Tensor custom_isnan_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "custom_isnan: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "custom_isnan: input must be float32");
+
+    auto output = torch::empty_like(x);
+    long long numel = static_cast<long long>(x.numel());
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_isnan_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        numel,
+        stream
+    );
+
+    return output;
+}
+
+// PyTorch wrapper for relu6
+torch::Tensor custom_relu6_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "custom_relu6: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "custom_relu6: input must be float32");
+
+    auto output = torch::empty_like(x);
+    long long numel = static_cast<long long>(x.numel());
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_relu6_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        numel,
+        stream
+    );
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_isnan", &custom_isnan_forward, "Elementwise isnan",
+          py::arg("x"));
+    m.def("custom_relu6", &custom_relu6_forward, "Elementwise ReLU6",
+          py::arg("x"));
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,24 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, has_nan):
+        super().__init__()
+        self.has_nan = has_nan
+
+    def forward(self, x):
+        if self.has_nan:
+            x = cuda_extension.custom_isnan(x)
+        else:
+            x = cuda_extension.custom_relu6(x)
+        return x
+
+    def debug_forward(self, x):
+        if self.has_nan:
+            y = cuda_extension.custom_isnan(x)
+            yield 'output', y
+        else:
+            y = cuda_extension.custom_relu6(x)
+            yield 'output', y
