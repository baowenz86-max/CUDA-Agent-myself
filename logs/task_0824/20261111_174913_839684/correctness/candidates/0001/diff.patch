@@ -0,0 +1,47 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+class ModelNew(nn.Module):
+    def __init__(self, num_features, kernel_size, stride, padding, dilation):
+        super().__init__()
+        # 保存 batch_norm 参数，保持 state_dict 键一致
+        self.batch_norm_weight = nn.Parameter(torch.ones(num_features))
+        self.batch_norm_bias = nn.Parameter(torch.zeros(num_features))
+        self.register_buffer('batch_norm_running_mean', torch.zeros(num_features))
+        self.register_buffer('batch_norm_running_var', torch.ones(num_features))
+        self.register_buffer('batch_norm_num_batches_tracked', torch.tensor(0, dtype=torch.long))
+        self.kernel_size = kernel_size
+        self.stride = stride
+        self.padding = padding
+        self.dilation = dilation
+
+    def forward(self, x):
+        x = cuda_extension.batch_norm2d_inference(
+            x, self.batch_norm_weight, self.batch_norm_bias,
+            self.batch_norm_running_mean, self.batch_norm_running_var, 1e-5
+        )
+        x = cuda_extension.permute_contiguous(x, (0, 2, 1, 3))
+        x = cuda_extension.view(x, (x.size(0), x.size(1), -1))
+        x = cuda_extension.max_pool1d(x, self.kernel_size, self.stride, self.padding, self.dilation)
+        x = cuda_extension.view(x, (x.size(0), x.size(1), -1, 1))
+        x = cuda_extension.permute_contiguous(x, (0, 2, 1, 3))
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.batch_norm2d_inference(
+            x, self.batch_norm_weight, self.batch_norm_bias,
+            self.batch_norm_running_mean, self.batch_norm_running_var, 1e-5
+        )
+        yield 'step_001', x
+        x = cuda_extension.permute_contiguous(x, (0, 2, 1, 3))
+        yield 'step_002', x
+        x = cuda_extension.view(x, (x.size(0), x.size(1), -1))
+        yield 'step_003', x
