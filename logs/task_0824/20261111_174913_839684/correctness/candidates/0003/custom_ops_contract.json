{
  "operators": [
    {
      "name": "batch_norm2d_inference",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, C, H, W]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "default": 1e-05,
          "nullable": false,
          "optional": true
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "对应参考 self.batch_norm(x)，推理模式使用 running_mean 和 running_var。",
        "输出形状与输入相同，按通道归一化：y = (x - running_mean[c]) / sqrt(running_var[c] + eps) * weight[c] + bias[c]。",
        "权重、偏置和统计量均为 1D 张量，应用逐通道广播。"
      ]
    },
    {
      "name": "permute_contiguous",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "any",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dims",
          "kind": "tensor",
          "dtype": "torch.int64",
          "device": "cpu",
          "shape": "[4]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "permuted and contiguous"
      },
      "semantics": [
        "对应参考 x.permute(dims).contiguous()，先按 dims 转置，然后强制连续内存布局。",
        "输出为新的连续张量，值为原张量按指定维度顺序索引的结果。",
        "dims 是 CPU int64 张量，长度为 4。"
      ]
    },
    {
      "name": "view",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "any",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "shape",
          "kind": "tensor",
          "dtype": "torch.int64",
          "device": "cpu",
          "shape": "[n]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as shape argument"
      },
      "semantics": [
        "对应参考 x.view(*shape)，要求输入连续，返回指定形状的视图。",
        "因为输入总是连续的，view 不复制数据，仅改变元数据。",
        "shape 是 CPU int64 张量，可包含 -1。"
      ]
    },
    {
      "name": "max_pool1d",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, L, C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "kernel_size",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "stride",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "padding",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dilation",
          "kind": "int",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[B, L_out, C]"
      },
      "semantics": [
        "对应参考 self.max_pool(x)，在最后一维（长度 L）上做一维最大池化，C 视为通道维度。",
        "池化窗口大小为 kernel_size，步长为 stride，填充 padding，膨胀为 dilation。",
        "输出长度 L_out = floor((L + 2*padding - dilation*(kernel_size-1) - 1)/stride + 1)。",
        "ceil_mode=False，与参考一致。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.batch_norm(x)",
      "semantics": [
        "使用 batch_norm 模块的推理模式，对输入 x 进行批量归一化。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = x.permute(0, 2, 1, 3).contiguous()",
      "semantics": [
        "将维度从 [B,C,H,W] 转置为 [B,H,C,W]，并强制连续。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = x.view(x.size(0), x.size(1), -1)",
      "semantics": [
        "将 [B,H,C,W] 重塑为 [B,H,C*W]。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "x = self.max_pool(x)",
      "semantics": [
        "对 [B,H,C*W] 的最后一个维度进行 1D 最大池化。"
      ]
    },
    {
      "checkpoint": "step_005",
      "source": "x = x.view(x.size(0), x.size(1), -1, 1)",
      "semantics": [
        "将池化结果重塑为 [B,H,C,1]。"
      ]
    },
    {
      "checkpoint": "step_006",
      "source": "x = x.permute(0, 2, 1, 3).contiguous()",
      "semantics": [
        "将维度从 [B,H,C,1] 转置为 [B,C,H,1]，并强制连续。"
      ]
    },
    {
      "checkpoint": "step_007",
      "source": "return x",
      "semantics": [
        "返回最终张量。"
      ]
    }
  ]
}