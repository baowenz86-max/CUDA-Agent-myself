  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.batch_norm(x)",
      "semantics": [
        "Applies BatchNorm2d in inference mode using running_mean and running_var.",
        "Input shape [512,3,128,128] -> output same shape.",
        "Uses batch_norm.weight and batch_norm.bias."
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = x.permute(0, 2, 1, 3).contiguous()",
      "semantics": [
        "Permutes dimensions from [B,C,H,W] to [B,H,C,W] then makes contiguous.",
        "Input [512,3,128,128] -> output [512,128,3,128]."
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = x.view(x.size(0), x.size(1), -1)",
      "semantics": [
        "Reshapes [B,H,C,W] to [B,H,C*W].",
        "Input [512,128,3,128] -> output [512,128,384]."
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "x = self.max_pool(x)",
      "semantics": [
        "Applies MaxPool1d with kernel_size=3, stride=2, padding=1, dilation=1, ceil_mode=False.",
        "Input [512,128,384] -> output [512,128,192]."
      ]
    },
    {
      "checkpoint": "step_005",
      "source": "x = x.view(x.size(0), x.size(1), -1, 1)",
      "semantics": [
        "Reshapes [B,H,L_out] to [B,H,L_out,1].",
        "Input [512,128,192] -> output [512,128,192,1]."
      ]
    },
    {
      "checkpoint": "step_006",
      "source": "x = x.permute(0, 2, 1, 3).contiguous()",
      "semantics": [
        "Permutes dimensions from [B,H,L_out,1] to [B,L_out,H,1] then makes contiguous.",
        "Input [512,128,192,1] -> output [512,192,128,1]."
      ]
    },
    {
      "checkpoint": "step_007",
      "source": "return x",
      "semantics": [
        "Returns final output tensor [512,192,128,1]."
      ]
    }
