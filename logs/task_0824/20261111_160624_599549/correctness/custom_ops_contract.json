        "Parameters match torch.nn.MaxPool1d: kernel_size, stride, padding, dilation, ceil_mode.",
        "Output has same batch and height dimensions, and length computed as floor((L + 2*padding - dilation*(kernel_size-1) - 1)/stride + 1) or ceil if ceil_mode True.",
        "Input must be contiguous."
      ]
    },
