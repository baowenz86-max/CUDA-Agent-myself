      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "Computes batch normalization over channels C for 4D input (B,C,H,W) using provided running_mean, running_var, weight, bias, eps, and training flag.",
        "If training is True, updates running statistics; in inference mode (training=False), uses running_mean and running_var directly.",
        "Formula: y = (x - running_mean) / sqrt(running_var + eps) * weight + bias.",
        "If weight is None, treated as ones; if bias is None, treated as zeros.",
        "Input must be contiguous; output has same shape as input."
      ]
    },
