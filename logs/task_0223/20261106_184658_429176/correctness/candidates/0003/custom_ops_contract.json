{
  "operators": [
    {
      "name": "custom_conv_transpose1d",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, in_channels, length_in]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[in_channels, out_channels, kernel_size]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "stride",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "padding",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "output_padding",
          "kind": "int",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, out_channels, length_out]"
      },
      "semantics": [
        "执行与 torch.nn.functional.conv_transpose1d 相同的转置卷积计算。",
        "使用 cuDNN 后端。",
        "输出长度 length_out = (length_in - 1) * stride - 2 * padding + kernel_size + output_padding。",
        "bias 若不为 None 则按通道加到输出上。",
        "权重布局与 PyTorch ConvTranspose1d 相同：[in_channels, out_channels, kernel_size]。"
      ]
    },
    {
      "name": "custom_minimum",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, out_channels, length_out]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "y",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels, 1]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, out_channels, length_out]"
      },
      "semantics": [
        "计算 torch.minimum(x, y)，逐元素取两个输入的最小值。",
        "y 的形状为 [out_channels, 1]，会广播到 x 的形状 [batch, out_channels, length_out]。",
        "返回张量形状与 x 相同。"
      ]
    },
    {
      "name": "custom_floor",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, out_channels, length_out]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, out_channels, length_out]"
      },
      "semantics": [
        "计算 torch.floor(x)，逐元素向下取整。",
        "返回张量形状与 x 相同。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.conv_transpose(x)",
      "semantics": [
        "调用 nn.ConvTranspose1d 的 forward，输出形状 [128, 16, 20000]。",
        "参数：in_channels=3, out_channels=16, kernel_size=3, stride=2, padding=1, output_padding=1。",
        "计算线性插值输出长度：L_out = (10000 - 1) * 2 - 2 * 1 + 3 + 1 = 20000。",
        "包含可学习卷积权重和偏置，输出为 float32 CUDA 张量。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.minimum(x, self.bias)",
      "semantics": [
        "self.bias 形状 [16, 1]，广播到 [128, 16, 20000] 后逐元素取最小值。",
        "返回 float32 CUDA 张量，形状 [128, 16, 20000]。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = torch.floor(x)",
      "semantics": [
        "对每个元素向下取整，返回 float32 CUDA 张量，形状 [128, 16, 20000]。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return x",
      "semantics": [
        "返回经过 floor 后的张量，形状 [128, 16, 20000]，dtype float32，device cuda:0。"
      ]
    }
  ]
}