--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,68 @@
+#include <cuda_runtime.h>
+#include <math_functions.h>
+
+// MaxPool1d kernel: 计算窗口内最大值
+__global__ void maxpool1d_kernel(const float* input, float* output,
+                                 int N, int C, int L, int L_out,
+                                 int kernel_size, int stride, int padding) {
+    int total_output = N * C * L_out;
+    int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride_total = blockDim.x * gridDim.x;
+
+    for (int idx = tid; idx < total_output; idx += stride_total) {
+        int l_out = idx % L_out;
+        int nc = idx / L_out;
+        int c = nc % C;
+        int n = nc / C;
+
+        int l_start = l_out * stride - padding;
+        float max_val = -INFINITY;
+        for (int k = 0; k < kernel_size; ++k) {
+            int l_in = l_start + k;
+            if (l_in >= 0 && l_in < L) {
+                float val = input[((size_t)n * C + c) * L + l_in];
+                if (val > max_val) max_val = val;
+            }
+        }
+        output[idx] = max_val;
+    }
+}
+
+// Tanh kernel: 逐元素计算 tanh
+__global__ void tanh_kernel(const float* input, float* output, size_t total) {
+    size_t tid = (size_t)blockIdx.x * blockDim.x + threadIdx.x;
+    size_t stride = (size_t)blockDim.x * gridDim.x;
+    for (size_t i = tid; i < total; i += stride) {
+        output[i] = tanhf(input[i]);
+    }
+}
+
+// Launcher for MaxPool1d forward
+extern "C" void maxpool1d_forward_launcher(
+    const float* input, float* output,
+    int N, int C, int L, int L_out,
+    int kernel_size, int stride, int padding,
+    cudaStream_t stream) {
+
+    int total_output = N * C * L_out;
+    int block_size = 256;
+    int grid_size = (total_output + block_size - 1) / block_size;
+    if (grid_size > 65535) grid_size = 65535; // 限制 grid size，实际使用 grid-stride loop 处理
+
+    maxpool1d_kernel<<<grid_size, block_size, 0, stream>>>(
+        input, output, N, C, L, L_out, kernel_size, stride, padding);
+}
+
+// Launcher for Tanh forward
+extern "C" void tanh_forward_launcher(
+    const float* input, float* output,
+    size_t total,
+    cudaStream_t stream) {
+
+    int block_size = 256;
+    size_t grid_size = (total + block_size - 1) / block_size;
+    if (grid_size > 65535) grid_size = 65535;
+
+    tanh_kernel<<<grid_size, block_size, 0, stream>>>(
+        input, output, total);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,95 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// 声明来自 custom_ops.cu 的 launcher 函数
+extern "C" void maxpool1d_forward_launcher(
+    const float* input, float* output,
+    int N, int C, int L, int L_out,
+    int kernel_size, int stride, int padding,
+    cudaStream_t stream);
+
+extern "C" void tanh_forward_launcher(
+    const float* input, float* output,
+    size_t total,
+    cudaStream_t stream);
+
+// MaxPool1d 前向包装
+static torch::Tensor maxpool1d_forward(
+    torch::Tensor x,
+    int64_t kernel_size,
+    int64_t stride,
+    int64_t padding) {
+
+    TORCH_CHECK(x.is_cuda(), "Input tensor must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input tensor must have dtype torch.float32");
+    TORCH_CHECK(x.dim() == 3, "Input tensor must be 3D (N, C, L)");
+
+    // 确保输入是连续的，如果需要则显式拷贝；
+    // 转置输入按实际 stride 处理或显式连续化，此处连续化保证 launcher 使用简单指针索引。
+    torch::Tensor x_contig = x.contiguous();
+
+    int64_t N = x_contig.size(0);
+    int64_t C = x_contig.size(1);
+    int64_t L = x_contig.size(2);
+
+    // 计算输出长度，与 PyTorch MaxPool1d 公式一致
+    int64_t L_out = (L + 2 * padding - kernel_size) / stride + 1;
+    TORCH_CHECK(L_out > 0, "Invalid output length: kernel_size, stride, padding combination produces non-positive L_out");
+
+    auto output = torch::empty({N, C, L_out}, x_contig.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    maxpool1d_forward_launcher(
+        x_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int>(N),
+        static_cast<int>(C),
+        static_cast<int>(L),
+        static_cast<int>(L_out),
+        static_cast<int>(kernel_size),
+        static_cast<int>(stride),
+        static_cast<int>(padding),
+        stream);
+
+    return output;
+}
+
+// Tanh 前向包装
+static torch::Tensor tanh_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input tensor must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input tensor must have dtype torch.float32");
+
+    torch::Tensor x_contig = x.contiguous();
+    auto output = torch::empty_like(x_contig);
+
+    size_t total = static_cast<size_t>(x_contig.numel());
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    tanh_forward_launcher(
+        x_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        total,
+        stream);
+
+    return output;
+}
+
+// 注册函数
+static void register_custom_ops(pybind11::module& m) {
+    m.def("maxpool1d_forward", &maxpool1d_forward,
+          "MaxPool1d forward (CUDA)",
+          py::arg("x"),
+          py::arg("kernel_size"),
+          py::arg("stride"),
+          py::arg("padding"));
+
+    m.def("tanh_forward", &tanh_forward,
+          "Tanh forward (CUDA)",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,27 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels: int, out_channels: int, kernel_size: int, stride: int = 1, padding: int = 0):
+        super().__init__()
+        # 保存超参数；out_channels 未参与 forward 计算，但保留签名兼容
+        self.in_channels = in_channels
+        self.out_channels = out_channels
+        self.kernel_size = kernel_size
+        self.stride = stride
+        self.padding = padding
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        x = cuda_extension.maxpool1d_forward(x, self.kernel_size, self.stride, self.padding)
+        x = cuda_extension.tanh_forward(x)
+        return x
+
+    def debug_forward(self, *inputs):
+        x = inputs[0]
+        step_001 = cuda_extension.maxpool1d_forward(x, self.kernel_size, self.stride, self.padding)
+        yield ('step_001', step_001)
+        step_002 = cuda_extension.tanh_forward(step_001)
+        yield ('step_002', step_002)
+        yield ('step_003', step_002)
