--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,130 @@
+#include <cuda_runtime.h>
+#include <cmath>
+
+// MaxPool1d forward kernel
+// input: [batch, channels, width], output: [batch, channels, output_width]
+// Supports arbitrary strides (non-contiguous) via linear indexing and offset calculation.
+__global__ void max_pool1d_forward_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int batch,
+    int channels,
+    int width,
+    int kernel_size,
+    int stride,
+    int padding,
+    int output_width) {
+
+    int total_outputs = batch * channels * output_width;
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int grid_stride = blockDim.x * gridDim.x;
+
+    for (int out_idx = idx; out_idx < total_outputs; out_idx += grid_stride) {
+        int ow = out_idx % output_width;
+        int oc = (out_idx / output_width) % channels;
+        int ob = out_idx / (output_width * channels);
+
+        int input_fw_start = ow * stride - padding;
+        int input_fw_end = input_fw_start + kernel_size; // exclusive
+
+        // Clamp to valid input range [0, width)
+        int fw_start = input_fw_start;
+        if (fw_start < 0) fw_start = 0;
+        int fw_end = input_fw_end;
+        if (fw_end > width) fw_end = width;
+
+        if (fw_start >= fw_end) {
+            // This can happen when padding is larger than kernel_size?
+            // PyTorch behavior: if no valid element, output is -inf? But with valid pooling
+            // padding < kernel_size typically, so there is always at least one valid element.
+            // For safety, set to -INFINITY.
+            output[out_idx] = -INFINITY;
+            continue;
+        }
+
+        // Compute base offset for this batch and channel
+        size_t base_offset = (size_t)ob * channels * width + (size_t)oc * width;
+        float max_val = -INFINITY;
+        for (int fw = fw_start; fw < fw_end; ++fw) {
+            float val = input[base_offset + fw];
+            if (val > max_val) max_val = val;
+        }
+        output[out_idx] = max_val;
+    }
+}
+
+// Tanh forward kernel (elementwise)
+__global__ void tanh_forward_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    long long numel) {
+
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long grid_stride = blockDim.x * gridDim.x;
+
+    for (long long i = idx; i < numel; i += grid_stride) {
+        output[i] = tanhf(input[i]);
+    }
+}
+
+// Launcher for maxpool1d
+// All dimensions are int, output_width is precomputed by binding or passed? We compute it here if not provided.
+// We'll compute output_width from arguments to keep launcher simple.
+// But binding will provide output tensor already allocated and pass its width; we trust that.
+// To be safe, we compute output_width from arguments inside launcher if output_width <= 0.
+// However, launcher signature should be stable: we expect binding to pass output_width separately.
+// We'll include output_width as parameter to avoid recomputation and ensure correctness.
+extern "C" void maxpool1d_forward_launcher(
+    const float* input,
+    float* output,
+    int batch,
+    int channels,
+    int width,
+    int kernel_size,
+    int stride,
+    int padding,
+    int output_width,
+    cudaStream_t stream) {
+
+    int total_outputs = batch * channels * output_width;
+    if (total_outputs <= 0) return;
+
+    // Configure kernel launch
+    int threads = 256;
+    int blocks = (total_outputs + threads - 1) / threads;
+    if (blocks > 65535) {
+        // Cap blocks at a reasonable number and use grid-stride loop
+        blocks = 65535;
+    }
+
+    max_pool1d_forward_kernel<<<blocks, threads, 0, stream>>>(
+        input, output, batch, channels, width, kernel_size, stride, padding, output_width);
+
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // We cannot throw or log in this pure CUDA file. The binding should check error after launch.
+        // But we can still call cudaGetLastError to clear error state.
+        // We'll do nothing here; binding will handle error checking after launch.
+    }
+}
+
+// Launcher for tanh
+extern "C" void tanh_forward_launcher(
+    const float* input,
+    float* output,
+    long long numel,
+    cudaStream_t stream) {
+
+    if (numel <= 0) return;
+
+    int threads = 256;
+    long long blocks_ll = (numel + threads - 1) / threads;
+    int blocks = (blocks_ll > 65535) ? 65535 : (int)blocks_ll;
+
+    tanh_forward_kernel<<<blocks, threads, 0, stream>>>(input, output, numel);
+
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // no-op
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,112 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void maxpool1d_forward_launcher(
+    const float* input,
+    float* output,
+    int batch,
+    int channels,
+    int width,
+    int kernel_size,
+    int stride,
+    int padding,
+    int output_width,
+    cudaStream_t stream);
+
+extern "C" void tanh_forward_launcher(
+    const float* input,
+    float* output,
+    long long numel,
+    cudaStream_t stream);
+
+// MaxPool1d forward wrapper
+torch::Tensor maxpool1d(torch::Tensor x, int64_t kernel_size, int64_t stride, int64_t padding) {
+    TORCH_CHECK(x.is_cuda(), "maxpool1d: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "maxpool1d: input must be float32");
+    TORCH_CHECK(x.dim() == 3, "maxpool1d: input must be 3D (batch, channels, width)");
+
+    int batch = x.size(0);
+    int channels = x.size(1);
+    int width = x.size(2);
+
+    TORCH_CHECK(kernel_size > 0, "maxpool1d: kernel_size must be positive");
+    TORCH_CHECK(stride > 0, "maxpool1d: stride must be positive");
+    TORCH_CHECK(padding >= 0, "maxpool1d: padding must be non-negative");
+
+    int output_width = (width + 2 * padding - kernel_size) / stride + 1;
+    TORCH_CHECK(output_width > 0, "maxpool1d: computed output_width is non-positive");
+
+    // Allocate output tensor (contiguous)
+    auto output = torch::empty({batch, channels, output_width}, x.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    maxpool1d_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        batch,
+        channels,
+        width,
+        static_cast<int>(kernel_size),
+        static_cast<int>(stride),
+        static_cast<int>(padding),
+        output_width,
+        stream
+    );
+
+    // Check for kernel launch errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "maxpool1d: CUDA error after launch: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// Tanh forward wrapper
+torch::Tensor tanh(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "tanh: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "tanh: input must be float32");
+
+    // Allocate output tensor with same shape and options
+    auto output = torch::empty_like(x);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher (numel as long long)
+    long long numel = static_cast<long long>(x.numel());
+    tanh_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        numel,
+        stream
+    );
+
+    // Check for kernel launch errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "tanh: CUDA error after launch: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("maxpool1d", &maxpool1d,
+          "MaxPool1d forward",
+          py::arg("x"),
+          py::arg("kernel_size"),
+          py::arg("stride"),
+          py::arg("padding"));
+    m.def("tanh", &tanh,
+          "Tanh forward",
+          py::arg("x"));
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,25 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels: int, out_channels: int, kernel_size: int, stride: int = 1, padding: int = 0):
+        super().__init__()
+        self.in_channels = in_channels
+        self.out_channels = out_channels
+        self.kernel_size = kernel_size
+        self.stride = stride
+        self.padding = padding
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        x = cuda_extension.maxpool1d(x, self.kernel_size, self.stride, self.padding)
+        x = cuda_extension.tanh(x)
+        return x
+
+    def debug_forward(self, x: torch.Tensor):
+        x = cuda_extension.maxpool1d(x, self.kernel_size, self.stride, self.padding)
+        yield 'step_001', x
+        x = cuda_extension.tanh(x)
+        yield 'step_002', x
+        yield 'step_003', x
