--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -1,5 +1,15 @@
 #include <cuda_runtime.h>
 #include <cstdint>
+
+// Helper for floor division of possibly negative numerator by positive stride
+__device__ __forceinline__ int64_t floor_div(int64_t a, int64_t b) {
+    int64_t q = a / b;
+    int64_t r = a % b;
+    if (r != 0 && ((r < 0) != (b < 0))) {
+        q -= 1;
+    }
+    return q;
+}
 
 // Element-wise greater-than-or-equal kernel: output[i] = (input[i] >= threshold)
 __global__ void ge_kernel(const float* __restrict__ input,
@@ -39,7 +49,8 @@
 }
 
 // ConvTranspose1d kernel: output[b, oc, ol] = bias[oc] + sum_{ic, k} input[b, ic, il] * weight[ic, oc, k]
-// where il = (ol + padding - k) / stride, if (ol + padding - k) % stride == 0 and 0 <= il < input_length.
+// where il = floor((ol + padding - k) / stride), and the contribution is valid only if
+// (ol + padding - k) is exactly divisible by stride, and 0 <= il < input_length.
 __global__ void conv_transpose1d_kernel(const float* __restrict__ input,
                                         const float* __restrict__ weight,
                                         const float* __restrict__ bias,
@@ -63,8 +74,10 @@
         float acc = bias[oc];
         for (int ic = 0; ic < in_channels; ++ic) {
             for (int k = 0; k < kernel_size; ++k) {
-                int il = (ol + padding - k) / stride;
-                if ((ol + padding - k) % stride == 0 && il >= 0 && il < input_length) {
+                int64_t numerator = static_cast<int64_t>(ol) + padding - k;
+                int64_t il = floor_div(numerator, stride);
+                // Check exact divisibility using multiplication to avoid modulo with negative
+                if (il >= 0 && il < input_length && (numerator - il * stride) == 0) {
                     acc += input[(static_cast<int64_t>(b) * in_channels + ic) * input_length + il] *
                            weight[(static_cast<int64_t>(ic) * out_channels + oc) * kernel_size + k];
                 }
