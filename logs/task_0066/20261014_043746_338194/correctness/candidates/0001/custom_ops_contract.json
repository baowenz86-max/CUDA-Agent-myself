  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = F.conv_transpose1d(x, self.conv_transpose1d.weight, bias=self.conv_transpose1d.bias, stride=self.conv_transpose1d.stride, padding=self.conv_transpose1d.padding, output_padding=self.conv_transpose1d.output_padding)",
      "semantics": [
        "使用 ConvTranspose1d 权重和 bias 进行转置卷积。",
        "输入 shape [512,3,2048]，权重 [3,16,3]，bias [16]，stride=2, padding=1, output_padding=1。",
        "输出 shape [512,16,4096]。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "mask = torch.ge(x, self.threshold)",
      "semantics": [
        "生成布尔掩码，形状同 x，值为 x >= 0.5。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = self.relu6(x)",
      "semantics": [
        "对 x 逐元素应用 ReLU6 激活，范围 [0,6]。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "x = x * mask.float()",
      "semantics": [
        "将 ReLU6 结果与浮点掩码逐元素相乘，得到阈值屏蔽后的输出。"
      ]
    },
    {
      "checkpoint": "step_005",
      "source": "return x",
      "semantics": [
        "返回最终张量。"
      ]
