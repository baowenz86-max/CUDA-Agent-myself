+// Helper for floor division (C++ integer division truncates toward zero)
+__device__ __forceinline__ int floor_div(int a, int b) {
+    int q = a / b;
+    int r = a % b;
+    if ((r != 0) && ((r < 0) != (b < 0))) {
+        --q;
+    }
+    return q;
+}
