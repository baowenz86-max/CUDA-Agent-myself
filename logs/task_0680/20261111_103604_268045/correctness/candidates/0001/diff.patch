+// custom_ops.cu
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// Kernel for concatenating two tensors along a given dimension.
+// Assumes dim is 1 for this task, but general implementation for any dim is provided.
+// Inputs are contiguous float32 tensors.
+__global__ void custom_cat_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input1,
+    const float* __restrict__ input2,
+    int64_t total_output_size,
+    int64_t dim,
+    int64_t size1, int64_t size2,
+    int64_t stride1, int64_t stride2,
+    int64_t outer_size,
+    int64_t inner_size
+) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < total_output_size; i += stride) {
+        // Decompose output index into (outer, channel, inner)
+        int64_t inner = i % inner_size;
+        int64_t tmp = i / inner_size;
+        int64_t channel = tmp % (size1 + size2);
+        int64_t outer = tmp / (size1 + size2);
+
+        float val;
+        if (channel < size1) {
+            int64_t input_idx = outer * (stride1 * size1) + channel * stride1 + inner;
+            val = input1[input_idx];
+        } else {
+            int64_t channel2 = channel - size1;
+            int64_t input_idx = outer * (stride2 * size2) + channel2 * stride2 + inner;
+            val = input2[input_idx];
+        }
+        output[i] = val;
+    }
+}
+
+// Kernel for nansum along a given dimension (dim=1 in this task).
+// Each thread handles one output element (batch, spatial).
+// Input is assumed contiguous float32 with shape [outer_size, reduction_size, inner_size].
+__global__ void custom_nansum_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    int64_t outer_size,
+    int64_t reduction_size,
+    int64_t inner_size
+) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t total = outer_size * inner_size;
+    if (idx >= total) return;
+
+    int64_t inner = idx % inner_size;
+    int64_t outer = idx / inner_size;
+
+    float sum = 0.0f;
+    const float* base = input + outer * reduction_size * inner_size + inner;
+    for (int64_t c = 0; c < reduction_size; ++c) {
+        float val = base[c * inner_size];
+        if (!isnan(val)) {
+            sum += val;
+        }
+    }
+    output[outer * inner_size + inner] = sum;
+}
+
+// Host launcher for custom_cat
+extern "C" void custom_cat_launcher(
+    float* output,
+    const float* input1,
+    const float* input2,
+    int64_t dim,
+    int64_t size1,
+    int64_t size2,
+    int64_t outer_size,
+    int64_t inner_size,
+    int64_t total_output_size,
+    cudaStream_t stream
+) {
+    int block_size = 256;
+    int grid_size = (int)((total_output_size + block_size - 1) / block_size);
+    if (grid_size > 65535) {
+        grid_size = 65535;
+    }
+    custom_cat_kernel<<<grid_size, block_size, 0, stream>>>(
+        output, input1, input2, total_output_size, dim,
+        size1, size2, inner_size, inner_size,  // stride1 = stride2 = inner_size for contiguous
+        outer_size, inner_size
+    );
+}
+
+// Host launcher for custom_nansum
+extern "C" void custom_nansum_launcher(
+    float* output,
+    const float* input,
+    int64_t outer_size,
+    int64_t reduction_size,
+    int64_t inner_size,
+    cudaStream_t stream
+) {
+    int64_t total = outer_size * inner_size;
+    int block_size = 256;
+    int grid_size = (int)((total + block_size - 1) / block_size);
+    if (grid_size > 65535) {
+        grid_size = 65535;
+    }
+    custom_nansum_kernel<<<grid_size, block_size, 0, stream>>>(
+        output, input, outer_size, reduction_size, inner_size
+    );
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,131 @@
+#include <torch/types.h>
+#include <pybind11/pybind11.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+namespace py = pybind11;
+
+// Declare launchers from custom_ops.cu
+extern "C" void custom_cat_launcher(
+    float* output,
+    const float* input1,
+    const float* input2,
+    int64_t dim,
+    int64_t size1,
+    int64_t size2,
+    int64_t outer_size,
+    int64_t inner_size,
+    int64_t total_output_size,
+    cudaStream_t stream
+);
+
+extern "C" void custom_nansum_launcher(
+    float* output,
+    const float* input,
+    int64_t outer_size,
+    int64_t reduction_size,
+    int64_t inner_size,
+    cudaStream_t stream
+);
+
+// custom_cat: concat two tensors along dim=1
+torch::Tensor custom_cat(torch::Tensor x1, torch::Tensor x2, int64_t dim) {
+    // Validate inputs
+    TORCH_CHECK(x1.is_cuda(), "custom_cat: x1 must be a CUDA tensor");
+    TORCH_CHECK(x2.is_cuda(), "custom_cat: x2 must be a CUDA tensor");
+    TORCH_CHECK(x1.is_contiguous(), "custom_cat: x1 must be contiguous");
+    TORCH_CHECK(x2.is_contiguous(), "custom_cat: x2 must be contiguous");
+    TORCH_CHECK(x1.dtype() == torch::kFloat32, "custom_cat: x1 must be float32");
+    TORCH_CHECK(x2.dtype() == torch::kFloat32, "custom_cat: x2 must be float32");
+    TORCH_CHECK(x1.sizes() == x2.sizes(), "custom_cat: x1 and x2 must have the same shape");
+    TORCH_CHECK(dim == 1, "custom_cat: only dim=1 is supported for this model");
+
+    // Get shapes: x1 and x2 are [B, C, H, W] with B=32, C=3, H=1024, W=1024
+    int64_t B = x1.size(0);
+    int64_t C1 = x1.size(1);
+    int64_t C2 = x2.size(1); // same as C1 since sizes equal
+    int64_t H = x1.size(2);
+    int64_t W = x1.size(3);
+
+    // Prepare launcher parameters
+    int64_t outer_size = B;
+    int64_t size1 = C1;
+    int64_t size2 = C2;
+    int64_t inner_size = H * W;
+    int64_t total_output_size = outer_size * (size1 + size2) * inner_size;
+
+    // Allocate output tensor [B, C1+C2, H, W]
+    auto output = torch::empty({B, size1 + size2, H, W}, x1.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    custom_cat_launcher(
+        output.data_ptr<float>(),
+        x1.data_ptr<float>(),
+        x2.data_ptr<float>(),
+        dim,
+        size1,
+        size2,
+        outer_size,
+        inner_size,
+        total_output_size,
+        stream
+    );
+
+    return output;
+}
+
+// custom_nansum: sum along dim=1 ignoring NaNs
+torch::Tensor custom_nansum(torch::Tensor x, int64_t dim) {
+    // Validate input
+    TORCH_CHECK(x.is_cuda(), "custom_nansum: x must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "custom_nansum: x must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "custom_nansum: x must be float32");
+    TORCH_CHECK(dim == 1, "custom_nansum: only dim=1 is supported for this model");
+
+    // Expected input shape [B, C, H, W] with C=6, B=32, H=1024, W=1024
+    TORCH_CHECK(x.dim() == 4, "custom_nansum: expected 4D tensor");
+    int64_t B = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+    TORCH_CHECK(C == 6, "custom_nansum: expected reduction size 6");
+
+    // Prepare launcher parameters
+    int64_t outer_size = B;
+    int64_t reduction_size = C;
+    int64_t inner_size = H * W;
+
+    // Allocate output tensor [B, H, W]
+    auto output = torch::empty({B, H, W}, x.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    custom_nansum_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        outer_size,
+        reduction_size,
+        inner_size,
+        stream
+    );
+
+    return output;
+}
+
+// Register both operators
+void register_custom_ops(py::module& m) {
+    m.def("custom_cat", &custom_cat,
+          "Concatenate two tensors along dimension 1",
+          py::arg("x1"), py::arg("x2"), py::arg("dim"));
+    m.def("custom_nansum", &custom_nansum,
+          "Sum along dimension 1 ignoring NaNs",
+          py::arg("x"), py::arg("dim"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
