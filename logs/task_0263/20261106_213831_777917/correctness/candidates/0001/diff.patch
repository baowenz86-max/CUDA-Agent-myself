--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,90 @@
+#include <cuda_runtime.h>
+#include <stdint.h>
+
+// Computes average and max pooling over non-overlapping windows for 4D tensors.
+// Input: x with shape [N, C, H, W], strides [sN, sC, sH, sW]
+// Outputs: avg and max with shape [N, C, H_out, W_out], contiguous
+// kernel: kh x kw, stride = kernel (non-overlapping), padding 0, dilation 1
+extern "C" __global__ void pool2d_avgmax_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ avg,
+    float* __restrict__ max,
+    int64_t N,
+    int64_t C,
+    int64_t H,
+    int64_t W,
+    int64_t sN,
+    int64_t sC,
+    int64_t sH,
+    int64_t sW,
+    int64_t kh,
+    int64_t kw
+) {
+    int64_t H_out = H / kh;
+    int64_t W_out = W / kw;
+    int64_t total = N * C * H_out * W_out;
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)gridDim.x * blockDim.x;
+
+    for (int64_t linear = idx; linear < total; linear += stride) {
+        int64_t wo = linear % W_out;
+        int64_t tmp = linear / W_out;
+        int64_t ho = tmp % H_out;
+        tmp /= H_out;
+        int64_t c = tmp % C;
+        int64_t n = tmp / C;
+
+        const float* base = x + n * sN + c * sC + ho * kh * sH + wo * kw * sW;
+        float sum = 0.0f;
+        float mx = -3.402823466e+38f; // -FLT_MAX, but use C float minimum? We'll initialize with first value.
+
+        for (int64_t i = 0; i < kh; ++i) {
+            const float* row = base + i * sH;
+            for (int64_t j = 0; j < kw; ++j) {
+                float val = row[j * sW];
+                sum += val;
+                if (i == 0 && j == 0) {
+                    mx = val;
+                } else if (val > mx) {
+                    mx = val;
+                }
+            }
+        }
+
+        float avg_val = sum / (float)(kh * kw);
+        int64_t out_idx = linear;
+        avg[out_idx] = avg_val;
+        max[out_idx] = mx;
+    }
+}
+
+// Host C-interface launcher (no PyTorch dependencies)
+extern "C" void pool2d_avgmax_launcher(
+    const float* x,
+    float* avg,
+    float* max,
+    int64_t N,
+    int64_t C,
+    int64_t H,
+    int64_t W,
+    int64_t sN,
+    int64_t sC,
+    int64_t sH,
+    int64_t sW,
+    int64_t kh,
+    int64_t kw,
+    cudaStream_t stream
+) {
+    int64_t H_out = H / kh;
+    int64_t W_out = W / kw;
+    int64_t total = N * C * H_out * W_out;
+    if (total <= 0) return;
+
+    const int block_size = 256;
+    // grid cap for safety, use grid-stride loop inside kernel
+    int64_t grid = (total + block_size - 1) / block_size;
+    if (grid > 65535) grid = 65535;
+
+    pool2d_avgmax_kernel<<<(unsigned int)grid, block_size, 0, stream>>>(
+        x, avg, max, N, C, H, W, sN, sC, sH, sW, kh, kw);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,86 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launcher from custom_ops.cu
+extern "C" void pool2d_avgmax_launcher(
+    const float* x,
+    float* avg,
+    float* max,
+    int64_t N,
+    int64_t C,
+    int64_t H,
+    int64_t W,
+    int64_t sN,
+    int64_t sC,
+    int64_t sH,
+    int64_t sW,
+    int64_t kh,
+    int64_t kw,
+    cudaStream_t stream
+);
+
+// PyTorch wrapper for combined avg/max pooling
+torch::Tensor pool2d_avgmax_forward(
+    torch::Tensor x,
+    int64_t kernel_h,
+    int64_t kernel_w
+) {
+    // Input validation
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D (N, C, H, W)");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(kernel_h > 0 && kernel_w > 0, "kernel sizes must be positive");
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+
+    TORCH_CHECK(H % kernel_h == 0 && W % kernel_w == 0,
+                "Spatial dimensions must be divisible by kernel sizes");
+
+    int64_t H_out = H / kernel_h;
+    int64_t W_out = W / kernel_w;
+
+    // Allocate contiguous outputs
+    auto avg = torch::empty({N, C, H_out, W_out}, x.options());
+    auto max = torch::empty({N, C, H_out, W_out}, x.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Get strides (note: x may be non-contiguous)
+    int64_t sN = x.stride(0);
+    int64_t sC = x.stride(1);
+    int64_t sH = x.stride(2);
+    int64_t sW = x.stride(3);
+
+    // Call launcher
+    pool2d_avgmax_launcher(
+        x.data_ptr<float>(),
+        avg.data_ptr<float>(),
+        max.data_ptr<float>(),
+        N, C, H, W,
+        sN, sC, sH, sW,
+        kernel_h, kernel_w,
+        stream
+    );
+
+    // Return tuple (avg, max)
+    return torch::tuple(avg, max);
+}
+
+// Registration function
+void register_pool2d_avgmax(pybind11::module& m) {
+    m.def("pool2d_avgmax", &pool2d_avgmax_forward,
+          "Compute average and max pooling over non-overlapping windows",
+          py::arg("x"),
+          py::arg("kernel_h"),
+          py::arg("kernel_w"));
+}
+
+// Auto-register
+REGISTER_BINDING(pool2d_avgmax, register_pool2d_avgmax);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,30 @@
+import torch
+import torch.nn as nn
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, kernel_size):
+        super().__init__()
+        # Store kernel_size as tuple for reference, but forward will use custom op.
+        if isinstance(kernel_size, int):
+            self.kernel_size = (kernel_size, kernel_size)
+        else:
+            self.kernel_size = tuple(kernel_size)
+        self.in_channels = in_channels
+        # No buffers or parameters; ensure state_dict is empty.
+
+    def forward(self, x):
+        # Use custom extension operator that computes both avg and max pooling
+        # with the same kernel/stride. kernel_size is passed as ints.
+        x_avg, x_max = torch.ops.cuda_extension.pool2d_avgmax(
+            x, self.kernel_size[0], self.kernel_size[1]
+        )
+        return x_avg, x_max
+
+    def debug_forward(self, x):
+        # Must yield exactly the checkpoints in order.
+        x_avg, x_max = torch.ops.cuda_extension.pool2d_avgmax(
+            x, self.kernel_size[0], self.kernel_size[1]
+        )
+        yield "step_001", x_avg
+        yield "step_002", x_max
+        yield "step_003", (x_avg, x_max)
