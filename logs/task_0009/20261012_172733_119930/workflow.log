import torch
import torch.nn as nn


class Model(nn.Module):
    def __init__(self, start, end, steps, padding):
        super().__init__()
        self.start = start
        self.end = end
        self.steps = steps
        self.reflection_pad = nn.ReflectionPad2d(padding)

    def forward(self, x):
