  "files": {
    "kernels/reflection_pad2d_binding.cpp": "// PyTorch binding for reflection_pad2d custom op\n#include <torch/types.h>\n#include <pybind11/pybind11.h>\n#include <cuda_runtime.h>\n#include <c10/cuda/CUDAStream.h>\n#include \"../binding_registry.h\"\n\nnamespace py = pybind11;\n\n// Declaration of launcher from reflection_pad2d.cu\nextern \"C\" void launch_reflection_pad2d(\n    float* output,\n    const float* input,\n    int N, int C, int H, int W,\n    int pad_h, int pad_w,\n    cudaStream_t stream);\n\ntorch::Tensor reflection_pad2d_forward(torch::Tensor input, int64_t padding) {\n    TORCH_CHECK(input.is_cuda(), \"Input must be a CUDA tensor\");\n    TORCH_CHECK(input.dim() == 4, \"Input must be 4D (N,C,H,W)\");\n    TORCH_CHECK(input.dtype() == torch::kFloat32, \"Input must be float32\");\n    TORCH_CHECK(input.is_contiguous(), \"Input must be contiguous\");\n    TORCH_CHECK(padding >= 0, \"Padding must be non-negative\");\n\n    int N = static_cast<int>(input.size(0));\n    int C = static_cast<int>(input.size(1));\n    int H = static_cast<int>(input.size(2));\n    int W = static_cast<int>(input.size(3));\n    int pad_h = static_cast<int>(padding);\n    int pad_w = static_cast<int>(padding);\n    int out_H = H + 2 * pad_h;\n    int out_W = W + 2 * pad_w;\n\n    auto output = torch::empty({N, C, out_H, out_W}, input.options());\n\n    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n    launch_reflection_pad2d(\n        output.data_ptr<float>(),\n        input.data_ptr<float>(),\n        N, C, H, W,\n        pad_h, pad_w,\n        stream);\n\n    return output;\n}\n\nvoid register_reflection_pad2d(py::module& m) {\n    m.def(\"reflection_pad2d_forward\", &reflection_pad2d_forward,\n          \"ReflectionPad2d forward\",\n          py::arg(\"input\"), py::arg(\"padding\"));\n}\n\nREGISTER_BINDING(reflection_pad2d, register_reflection_pad2d);\n",
    "kernels/histc_binding.cpp": "// PyTorch binding for histc custom op\n#include <torch/types.h>\n#include <pybind11/pybind11.h>\n#include <cuda_runtime.h>\n#include <c10/cuda/CUDAStream.h>\n#include \"../binding_registry.h\"\n\nnamespace py = pybind11;\n\n// Declaration of launcher from histc.cu\nextern \"C\" void histc_forward_launcher(\n    float* hist,\n    const float* input,\n    int64_t numel,\n    int bins,\n    float min,\n    float max,\n    cudaStream_t stream);\n\ntorch::Tensor histc_forward(torch::Tensor input, int64_t bins, double min, double max) {\n    TORCH_CHECK(input.is_cuda(), \"Input must be a CUDA tensor\");\n    TORCH_CHECK(input.dim() >= 1, \"Input must have at least 1 dimension\");\n    TORCH_CHECK(input.dtype() == torch::kFloat32, \"Input must be float32\");\n    TORCH_CHECK(input.is_contiguous(), \"Input must be contiguous\");\n    TORCH_CHECK(bins > 0, \"bins must be positive\");\n\n    auto output = torch::zeros({bins}, input.options());\n\n    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n    histc_forward_launcher(\n        output.data_ptr<float>(),\n        input.data_ptr<float>(),\n        input.numel(),\n        static_cast<int>(bins),\n        static_cast<float>(min),\n        static_cast<float>(max),\n        stream);\n\n    return output;\n}\n\nvoid register_histc(py::module& m) {\n    m.def(\"histc_forward\", &histc_forward,\n          \"Histogram forward\",\n          py::arg(\"input\"), py::arg(\"bins\"), py::arg(\"min\"), py::arg(\"max\"));\n}\n\nREGISTER_BINDING(histc, register_histc);\n"
