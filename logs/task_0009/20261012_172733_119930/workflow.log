===== 现有 CUDA/C++ kernel 文件 =====

===== kernels/histc.cu =====
#include <cuda_runtime.h>

// Kernel to compute histogram via atomic additions to integer bins (scaled for float output).
__global__ void histc_kernel(
    const float* __restrict__ input,
    float* __restrict__ output,
    int num_elements,
    int bins,
    float min,
    float max
) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= num_elements) return;

    float val = input[idx];
    if (val < min || val > max) return;
    // NaN check: NaN is unordered, so val >= min && val <= max will be false if NaN? Actually comparisons with NaN return false, so NaN will be ignored automatically.
    // But to be explicit, we can skip if isnan(val)
    if (isnan(val)) return;

    float range = max - min;
    if (range <= 0.0f) return; // degenerate bins; reference may have behavior but treat as empty

    float bin_f = (val - min) / range * bins;
    int bin = (int)floorf(bin_f);
    if (bin >= bins) bin = bins - 1; // handle max exactly
    if (bin < 0) bin = 0;

    atomicAdd(&output[bin], 1.0f);
}

// Launcher for histc. Output must be zero-initialized. Input assumed contiguous float32 CUDA tensor.
extern "C" void histc_forward_launcher(
    const float* input,
    float* output,
    int num_elements,
    int bins,
    float min,
    float max,
    cudaStream_t stream
) {
    if (num_elements == 0 || bins <= 0) return;
    const int threads = 256;
    int blocks = (num_elements + threads - 1) / threads;
    histc_kernel<<<blocks, threads, 0, stream>>>(
        input, output, num_elements, bins, min, max);
}

===== kernels/reflection_pad2d.cu =====
#include <cuda_runtime.h>

// 2D reflection padding kernel: supports arbitrary padding on last two dims.
__global__ void reflection_pad2d_kernel(
    float* __restrict__ output,
    const float* __restrict__ input,
    int batch,
    int channels,
    int in_h,
    int in_w,
    int out_h,
    int out_w,
    int pad_left,
    int pad_top
) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int total = batch * channels * out_h * out_w;
    if (idx >= total) return;

    // Decode linear index to output coordinates: (b, c, oh, ow)
    int ow = idx % out_w;
    int tmp = idx / out_w;
    int oh = tmp % out_h;
    tmp /= out_h;
    int c = tmp % channels;
    int b = tmp / channels;

    // Map output position to input position with reflection
    int iw = ow - pad_left;
    if (iw < 0) iw = -iw;
    if (iw >= in_w) iw = 2 * (in_w - 1) - iw;

    int ih = oh - pad_top;
    if (ih < 0) ih = -ih;
    if (ih >= in_h) ih = 2 * (in_h - 1) - ih;

    // Input is assumed contiguous, stride simple
    int input_idx = ((b * channels + c) * in_h + ih) * in_w + iw;
    output[idx] = input[input_idx];
}

// Launcher for reflection pad 2d. Assumes input is contiguous float32 CUDA tensor.
extern "C" void reflection_pad2d_forward_launcher(
    float* output,
    const float* input,
    int batch,
    int channels,
    int in_h,
    int in_w,
    int out_h,
    int out_w,
    int pad_left,
    int pad_top,
    cudaStream_t stream
) {
    int total = batch * channels * out_h * out_w;
    if (total == 0) return;
    const int threads = 256;
    int blocks = (total + threads - 1) / threads;
    reflection_pad2d_kernel<<<blocks, threads, 0, stream>>>(
        output, input, batch, channels, in_h, in_w, out_h, out_w, pad_left, pad_top);
}


