import torch
import torch.nn as nn
import cuda_extension


class ModelNew(nn.Module):
    def __init__(self, start, end, steps, padding):
        super().__init__()
        self.start = start
        self.end = end
        self.steps = steps
        self.padding = padding
        self.reflection_pad = nn.ReflectionPad2d(padding)

    def forward(self, x):
        # Pad input using built-in reflection pad (allowed as it's not a custom heavy op;
        # can be replaced later if needed).
        x = self.reflection_pad(x)

        # Pack scalar parameters into a tensor for custom kernel
        # Custom op signature:
        # histc_forward(input, start, end, bins) -> (hist, computation) where hist is 1D tensor of length bins
        # Return type: torch.Tensor (only histogram, no extraneous values)
        # NOTE: cuda_extension must provide histc_custom_forward
        return cuda_extension.histc_custom_forward(
            x,
            float(self.start),
            float(self.end),
            int(self.steps)
        )


