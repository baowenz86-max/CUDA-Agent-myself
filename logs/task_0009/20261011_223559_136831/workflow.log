#include <cuda_runtime.h>
#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>
#include <c10/cuda/CUDAStream.h>

// Kernel: compute histogram with linear scaling of values to bins
// Each thread processes one element of the input tensor (contiguous required).
// Bins are counted in global memory using atomicAdd, which is correct but may be slow for high contention.
// For better performance, a two-stage approach with privatized histograms in shared memory could be used,
// but this is sufficient for the required tensor sizes (typically ~25M elements, 20 bins).
__global__ void histc_linear_kernel(
    const float* __restrict__ input,
    float* __restrict__ output,
    int num_elements,
    int bins,
    float min_val,
    float max_val,
    float bin_width)
{
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= num_elements) return;

    float val = input[idx];
    // Clamp to [min_val, max_val] as per torch.clamp
    val = fminf(fmaxf(val, min_val), max_val);

    // Scale linearly: index = floor((val - min_val) / bin_width)
    int bin = (int)floorf((val - min_val) / bin_width);

    // Ensure bin is in [0, bins-1] (due to floating point and max_val case)
    if (bin < 0) bin = 0;
    if (bin >= bins) bin = bins - 1;

    atomicAdd(&output[bin], 1.0f);
}

// Host launcher function with C linkage for binding
// Input: pointer to contiguous float tensor (input), pointer to output histogram (float*), num_elements, bins, min_val, max_val, stream
// Output: histogram counts (floats, for torch.float32 output)
extern "C" void histc_custom_launcher(
    const float* input,
    float* output,
    int num_elements,
    int bins,
    float min_val,
    float max_val,
    cudaStream_t stream)
{
    // Compute bin width assuming uniform spacing
    if (bins <= 0) return;
    float bin_width = (max_val - min_val) / bins;

    // Launch kernel with grid-stride loop? We simply launch enough blocks to cover all elements.
    // Use 256 threads per block, grid size = ceil(num_elements/256)
    int block_size = 256;
    int grid_size = (num_elements + block_size - 1) / block_size;

    histc_linear_kernel<<<grid_size, block_size, 0, stream>>>(
        input, output, num_elements, bins, min_val, max_val, bin_width);
}

// PyTorch binding function that takes a tensor and returns histogram tensor
// This is a simple wrapper needed for Python API. The actual launcher is C-style.
// The binding file will include this .cu and call the launcher directly; however,
// we can also define a binding function here for convenience, but per instructions we should not generate .cpp.
// The user said not to modify .cpp, so this .cu must provide the launcher only.
// The binding file will call histc_custom_launcher.
// Provide a Python-visible function? The binding is in _binding.cpp; it will call the launcher.
// No additional code needed.

===== kernels/histc_custom_binding.cpp =====
#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>
#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

// Declare launcher from .cu file
extern "C" void histc_custom_launcher(
    const float* input,
    float* output,
    int num_elements,
    int bins,
    float min_val,
    float max_val,
    cudaStream_t stream
);

// PyTorch binding function
torch::Tensor histc_custom_forward(
    torch::Tensor input,
    double start,
    double end,
    int64_t bins)
{
    // Input validation
    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
    TORCH_CHECK(bins > 0, "bins must be positive");
    TORCH_CHECK(start < end, "start must be less than end");

    // Allocate output histogram tensor
    auto output = torch::zeros({bins}, input.options());

    // Get current CUDA stream
    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    // Call CUDA launcher
    histc_custom_launcher(
        input.data_ptr<float>(),
        output.data_ptr<float>(),
        static_cast<int>(input.numel()),
        static_cast<int>(bins),
        static_cast<float>(start),
        static_cast<float>(end),
        stream
    );

    return output;
}

// Registration function
void register_histc_custom(pybind11::module& m) {
    m.def("histc_custom_forward", &histc_custom_forward,
          "Custom histogram forward (CUDA)",
          py::arg("input"),
          py::arg("start"),
          py::arg("end"),
          py::arg("bins"));
}

// Auto-register
REGISTER_BINDING(histc_custom, register_histc_custom);

===== kernels/reflection_pad_histc.cu =====
#include <cuda_runtime.h>

__global__ void reflection_pad_histc_kernel(
    const float* __restrict__ input,
    float* __restrict__ output,
    int N, int C, int H, int W,
    int pad,
    int bins,
    float min_val,
    float max_val,
    float bin_width)
{
    int total = N * C * H * W;
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= total) return;

    // Decompose index
    int w = idx % W;
    int h = (idx / W) % H;
    int c = (idx / (W * H)) % C;
    int n = idx / (W * H * C);

    // Reflection padding indices
    int src_h = h - pad;
    if (src_h < 0) src_h = -src_h;
    if (src_h >= H) src_h = 2 * H - 2 - src_h;

    int src_w = w - pad;
    if (src_w < 0) src_w = -src_w;
    if (src_w >= W) src_w = 2 * W - 2 - src_w;

    // Clamp src indices to be safe (should be within bounds for valid padding)
    src_h = min(max(src_h, 0), H - 1);
    src_w = min(max(src_w, 0), W - 1);

    float val = input[((n * C + c) * H + src_h) * W + src_w];

    // Histogram computation
    val = fminf(fmaxf(val, min_val), max_val);
    int bin = (int)floorf((val - min_val) / bin_width);
    if (bin < 0) bin = 0;
    if (bin >= bins) bin = bins - 1;
    atomicAdd(&output[bin], 1.0f);
}

extern "C" void reflection_pad_histc_launcher(
    const float* input,
    float* output,
    int N, int C, int H, int W,
    int pad,
    int bins,
    float min_val,
    float max_val,
    cudaStream_t stream)
{
    if (bins <= 0) return;
    float bin_width = (max_val - min_val) / bins;

    int total = N * C * H * W;
    int block_size = 256;
    int grid_size = (total + block_size - 1) / block_size;

    reflection_pad_histc_kernel<<<grid_size, block_size, 0, stream>>>(
        input, output, N, C, H, W, pad, bins, min_val, max_val, bin_width);
}

===== kernels/reflection_pad_histc_binding.cpp =====
#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>
#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

extern "C" void reflection_pad_histc_launcher(
    const float* input,
    float* output,
    int N, int C, int H, int W,
    int pad,
    int bins,
    float min_val,
    float max_val,
    cudaStream_t stream);

torch::Tensor reflection_pad_histc_forward(
    torch::Tensor input,
    int64_t padding,
    double start,
    double end,
    int64_t bins)
{
    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
    TORCH_CHECK(input.dim() == 4, "Input must be 4D (N,C,H,W)");
    TORCH_CHECK(bins > 0, "bins must be positive");
    TORCH_CHECK(start < end, "start must be less than end");

    int N = input.size(0);
    int C = input.size(1);
    int H = input.size(2);
    int W = input.size(3);
    int pad = static_cast<int>(padding);

    TORCH_CHECK(pad < H && pad < W, "padding size must be less than input dimensions");

    auto output = torch::zeros({bins}, input.options());

    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    reflection_pad_histc_launcher(
        input.data_ptr<float>(),
        output.data_ptr<float>(),
        N, C, H, W,
        pad,
        static_cast<int>(bins),
        static_cast<float>(start),
        static_cast<float>(end),
        stream
    );

    return output;
}

void register_reflection_pad_histc(pybind11::module& m) {
    m.def("reflection_pad_histc_forward", &reflection_pad_histc_forward,
          "Fused reflection padding and histogram",
          py::arg("input"),
          py::arg("padding"),
          py::arg("start"),
          py::arg("end"),
          py::arg("bins"));
}

REGISTER_BINDING(reflection_pad_histc, register_reflection_pad_histc);
