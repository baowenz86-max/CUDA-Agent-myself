{
  "operators": [
    {
      "name": "tril_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W] (any 2D+ batch)",
          "layout": "strided (supports non-contiguous)",
          "nullable": false,
          "optional": false
        },
        {
          "name": "diagonal",
          "kind": "int",
          "dtype": null,
          "device": null,
          "shape": null,
          "layout": null,
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "对应模型语句 torch.tril(x, diagonal=self.tensor)；self.tensor 值为 -2，因此 diagonal 传入 -2。",
        "对于输入张量的最后两个维度（H, W），对于每个批次和通道，仅保留行索引 j >= 列索引 i + diagonal（即 j >= i - 2）的元素，其余位置置为 0。",
        "输入支持任意步长，输出步长与输入相同。",
        "输出 dtype 与输入相同（float32），device 为 CUDA。",
        "此算子在不同批次/通道上独立处理，无跨通道交互。"
      ]
    },
    {
      "name": "mean_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W] (any dims >= 2)",
          "layout": "strided (supports non-contiguous)",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dims",
          "kind": "int",
          "dtype": null,
          "device": null,
          "shape": null,
          "layout": null,
          "nullable": false,
          "optional": false
        },
        {
          "name": "keepdim",
          "kind": "bool",
          "dtype": null,
          "device": null,
          "shape": null,
          "layout": null,
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "对应模型语句 torch.mean(x, dim=(2,3), keepdim=True)；这里 dims 参数传递整数列表 [2,3]，keepdim 为 True。",
        "计算指定维度上的算术平均值，保持维度，输出 shape 为 [N, C, 1, 1]（对于此任务）。",
        "由于后续会乘以 self.mean=0.5 并加回 tril 结果，本算子只输出均值张量，不包含乘法。",
        "输出将广播到与 x 相同的 shape。",
        "输出 dtype 为 float32，device 为 CUDA。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "return torch.tril(x, diagonal=self.tensor) + self.mean * torch.mean(x, dim=(2, 3), keepdim=True)",
      "semantics": [
        "torch.tril(x, diagonal=-2) 生成下三角矩阵（保留 j >= i-2）",
        "torch.mean(x, dim=(2,3), keepdim=True) 生成 [N,C,1,1] 均值张量",
        "self.mean=0.5 乘以均值张量",
        "将 tril 结果与缩放后的均值相加",
        "输出 shape [512,3,256,256]，dtype float32，device cuda:0"
      ]
    }
  ]
}