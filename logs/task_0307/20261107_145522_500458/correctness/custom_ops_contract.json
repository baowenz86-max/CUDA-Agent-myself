        "按照通道重排规则将通道维拆分为空间维。",
        "无浮点计算，纯内存重排。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = self.upsample(x)",
      "semantics": [
        "执行 Upsample(scale_factor=2, mode='bilinear', align_corners=None)。",
        "align_corners=None 等价于 align_corners=False。",
        "输入 [512,4,128,128] -> 输出 [512,4,256,256]。",
        "使用双线性插值放大两倍。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return x",
      "semantics": [
        "返回上采样后的张量，shape [512,4,256,256]。"
      ]
    }
  ]
}