          "device": "cuda",
          "shape": "[512, 16, 64, 64]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[512, 16, 64, 64]"
      },
      "semantics": [
        "计算 F.gelu(x)（精确公式为 x * 0.5 * (1 + erf(x / sqrt(2)))。",
        "输入为 CUDA float32 张量，输出与输入同 shape。",
        "保持逐元素计算，无广播或轴变化。"
      ]
    },
    {
      "name": "pixel_shuffle_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[512, 16, 64, 64]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "upscale_factor",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[512, 4, 128, 128]"
      },
      "semantics": [
        "执行 nn.PixelShuffle(upscale_factor) 的 forward。",
        "输入 shape [N, C, H, W]，输出 shape [N, C/(r^2), H*r, W*r]。",
        "本任务中 r=2，C=16 -> 输出通道为 4，空间尺寸翻倍。",
        "按照 PyTorch PixelShuffle 的重排规则：输出[n, c, h, w] = 输入[n, (c*r^2 + (h%r)*r + (w%r)), h//r, w//r]。",
        "不需要额外浮点计算，仅内存重排。"
      ]
    },
    {
      "name": "upsample_bilinear2x_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[512, 4, 128, 128]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "align_corners",
          "kind": "bool",
          "optional": true,
          "nullable": true,
          "default": null
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[512, 4, 256, 256]"
      },
      "semantics": [
        "执行 nn.Upsample(scale_factor=2, mode='bilinear', align_corners=None) 的 forward。",
        "align_corners=None 时 PyTorch 使用 align_corners=False，因此实际采用 align_corners=False 的坐标映射。",
        "输出尺寸为输入尺寸的 2 倍。",
        "双线性插值公式符合 PyTorch 的 upsample_bilinear2d 语义。",
        "输入为 CUDA float32 连续张量。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.gelu(x)",
      "semantics": [
        "对输入张量 x 逐元素应用 GELU 激活函数。",
        "公式: x * 0.5 * (1 + erf(x / sqrt(2)))。",
        "输入 shape [512,16,64,64]，输出同 shape。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.pixel_shuffle(x)",
      "semantics": [
