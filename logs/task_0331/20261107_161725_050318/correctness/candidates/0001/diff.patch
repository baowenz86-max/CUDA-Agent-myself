+// Helper macro for CUDA error checking
+#define CUDA_CHECK(call)                                                       \
+  do {                                                                          \
+    cudaError_t err = call;                                                     \
+    if (err != cudaSuccess) {                                                   \
+      return;                                                                   \
+    }                                                                           \
