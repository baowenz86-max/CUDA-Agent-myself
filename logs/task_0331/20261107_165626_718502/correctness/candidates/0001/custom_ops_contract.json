{
  "operators": [
    {
      "name": "linear_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, in_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[in_features, in_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[in_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, in_features]"
      },
      "semantics": [
        "对应参考语句 x = self.fc(x)，即 y = x @ weight.T + bias，其中 x 形状 [batch, in_features]，weight 形状 [in_features, in_features]，bias 形状 [in_features]，输出形状 [batch, in_features]。",
        "实际调用时传入 x、weight、bias 均需在 CUDA 设备上，输出为新的 CUDA 张量。"
      ]
    },
    {
      "name": "gelu_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, in_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, in_features]"
      },
      "semantics": [
        "对应参考语句 x = F.gelu(x)，使用 PyTorch 默认 approximate='none' 的 GELU 激活函数，对每个元素计算 x * Phi(x)，其中 Phi 为标准正态 CDF。",
        "输入和输出均为 CUDA float32 张量，形状不变。"
      ]
    },
    {
      "name": "gt_scalar_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, in_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "threshold",
          "kind": "float",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.bool",
        "device": "cuda",
        "shape": "[batch, in_features]"
      },
      "semantics": [
        "对应参考语句 threshold = torch.tensor(0.5); x = torch.gt(x, threshold)，逐元素比较 x > 0.5，输出 bool 张量。",
        "threshold 为 Python float，在 C++ 中转换为 double 或 float 后用于比较。"
      ]
    },
    {
      "name": "bool_add_bias_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.bool",
          "device": "cuda",
          "shape": "[batch, in_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[in_features, 1, 1]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[in_features, batch, in_features]"
      },
      "semantics": [
        "对应参考语句 x = x + self.bias，x 为 bool 形状 [batch, in_features]，bias 为 float32 形状 [in_features, 1, 1]，广播后结果形状 [in_features, batch, in_features]，dtype 提升为 float32。",
        "广播规则：结果第0维来自 bias 的第0维（in_features），第1维来自 x 的第0维（batch），第2维来自 x 的第1维（in_features）。bias 的第1、2维为1，广播到 batch 和 in_features。",
        "bool 值 True 转换为 1.0，False 转换为 0.0，然后加上 bias 对应元素。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.fc(x)",
      "semantics": [
        "Linear 变换，y = x @ weight.T + bias，输入 [128,1536]，输出 [128,1536] float32 cuda。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = F.gelu(x)",
      "semantics": [
        "GELU 激活，形状不变。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "threshold = torch.tensor(0.5)",
      "semantics": [
        "创建标量 CPU 张量，值为 0.5。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "x = torch.gt(x, threshold)",
      "semantics": [
        "逐元素比较 x > 0.5，输出 bool 张量 [128,1536] cuda。"
      ]
    },
    {
      "checkpoint": "step_005",
      "source": "x = x + self.bias",
      "semantics": [
        "bool 张量 [128,1536] 与 bias [1536,1,1] 广播相加，输出 float32 [1536,128,1536] cuda。"
      ]
    },
    {
      "checkpoint": "step_006",
      "source": "return x",
      "semantics": [
        "返回最终结果。"
      ]
    }
  ]
}