--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,105 @@
+#include <cuda_runtime.h>
+
+// Helper to compute ceiling division for grid size
+__host__ __device__ inline int ceil_div(int a, int b) {
+    return (a + b - 1) / b;
+}
+
+// Kernel for max over dim=1 with keepdim=True.
+// Input: x (float*) with shape [N, C, H, W] (contiguous)
+// Output: out with shape [N, 1, H, W]
+// Each thread computes one output element (n, 0, h, w) by iterating over c.
+__global__ void max_dim1_keepdim_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ out,
+    int N, int C, int H, int W
+) {
+    int total = N * H * W;  // number of output elements
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+
+    for (int i = idx; i < total; i += stride) {
+        // Decompose i into (n, h, w)
+        int w = i % W;
+        int tmp = i / W;
+        int h = tmp % H;
+        int n = tmp / H;
+
+        const float* base = x + ((long long)n * C * H * W) + ((long long)h * W) + w;
+        float max_val = base[0];
+        // Loop over C dimensions, using stride H*W to jump between channels
+        for (int c = 1; c < C; ++c) {
+            float val = base[(long long)c * H * W];
+            if (val > max_val) {
+                max_val = val;
+            }
+        }
+        // Output index: n*1*H*W + 0*H*W + h*W + w = n*H*W + h*W + w = i
+        out[i] = max_val;
+    }
+}
+
+// Launcher for max_dim_1_keepdim. Assumes contiguous float32 input.
+extern "C" void max_dim_1_keepdim_launcher(
+    const float* x,
+    float* out,
+    int N, int C, int H, int W,
+    cudaStream_t stream
+) {
+    if (N == 0 || C == 0 || H == 0 || W == 0) {
+        return;
+    }
+    int total = N * H * W;
+    int threads = 256;
+    int blocks = std::min(65535, ceil_div(total, threads));
+    max_dim1_keepdim_kernel<<<blocks, threads, 0, stream>>>(x, out, N, C, H, W);
+}
+
+// Kernel for triu on last two dimensions.
+// Input: x (float*) with shape [batch, ..., rows, cols] (contiguous)
+// Output: out same shape.
+// We iterate over all elements, checking whether col >= row + diagonal in the last two dims.
+__global__ void triu_last_two_dims_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ out,
+    long long total_elements,
+    int rows,
+    int cols,
+    int diagonal
+) {
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+
+    for (long long i = idx; i < total_elements; i += stride) {
+        // Determine position within last two dims
+        long long pos = i % (long long)(rows * cols);
+        int row = pos / cols;
+        int col = pos - (long long)row * cols;  // remainder
+        if (col >= row + diagonal) {
+            out[i] = x[i];
+        } else {
+            out[i] = 0.0f;
+        }
+    }
+}
+
+// Launcher for triu_last_two_dims. Assumes contiguous float32 input.
+extern "C" void triu_last_two_dims_launcher(
+    const float* x,
+    float* out,
+    long long total_elements,
+    int rows,
+    int cols,
+    int diagonal,
+    cudaStream_t stream
+) {
+    if (total_elements == 0 || rows == 0 || cols == 0) {
+        return;
+    }
+    int threads = 256;
+    long long num_blocks_ll = ceil_div((long long)total_elements, (long long)threads);
+    int blocks = (num_blocks_ll > 65535) ? 65535 : (int)num_blocks_ll;
+    triu_last_two_dims_kernel<<<blocks, threads, 0, stream>>>(
+        x, out, total_elements, rows, cols, diagonal
+    );
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,112 @@
+// Binding file for custom_ops.cu
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void max_dim_1_keepdim_launcher(
+    const float* x,
+    float* out,
+    int N, int C, int H, int W,
+    cudaStream_t stream
+);
+
+extern "C" void triu_last_two_dims_launcher(
+    const float* x,
+    float* out,
+    long long total_elements,
+    int rows,
+    int cols,
+    int diagonal,
+    cudaStream_t stream
+);
+
+// Wrapper for max along dimension 1 with keepdim
+torch::Tensor max_dim_1_keepdim(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() >= 2, "Input must have at least 2 dimensions");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+
+    auto sizes = x.sizes();
+    long long N = sizes[0];
+    long long C = sizes[1];
+    long long H = 1, W = 1;
+    for (int i = 2; i < sizes.size(); ++i) {
+        H *= sizes[i];
+    }
+    if (sizes.size() >= 3) {
+        H = sizes[2];
+    }
+    if (sizes.size() >= 4) {
+        W = sizes[3];
+    }
+
+    // Create output shape: same as input but with dim 1 = 1
+    std::vector<int64_t> out_sizes(sizes.begin(), sizes.end());
+    out_sizes[1] = 1;
+    auto output = torch::empty(out_sizes, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    max_dim_1_keepdim_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int>(N),
+        static_cast<int>(C),
+        static_cast<int>(H),
+        static_cast<int>(W),
+        stream
+    );
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// Wrapper for triu on last two dimensions
+torch::Tensor triu_last_two_dims(torch::Tensor x, int64_t diagonal = 0) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() >= 2, "Input must have at least 2 dimensions");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+
+    auto sizes = x.sizes();
+    long long total_elements = x.numel();
+    int rows = static_cast<int>(sizes[sizes.size() - 2]);
+    int cols = static_cast<int>(sizes[sizes.size() - 1]);
+
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    triu_last_two_dims_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        total_elements,
+        rows,
+        cols,
+        static_cast<int>(diagonal),
+        stream
+    );
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("max_dim_1_keepdim", &max_dim_1_keepdim,
+          "Compute max along dimension 1 with keepdim",
+          pybind11::arg("x"));
+    m.def("triu_last_two_dims", &triu_last_two_dims,
+          "Apply upper triangular mask on last two dimensions",
+          pybind11::arg("x"),
+          pybind11::arg("diagonal") = 0);
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,21 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, input_dim, window_size):
+        super(ModelNew, self).__init__()
+        self.window_size = window_size
+
+    def forward(self, x):
+        x_max = cuda_extension.max_dim_1_keepdim(x)
+        x_triu = cuda_extension.triu_last_two_dims(x, diagonal=0)
+        return x_max, x_triu
+
+    def debug_forward(self, x):
+        x_max = cuda_extension.max_dim_1_keepdim(x)
+        yield 'step_001', x_max
+        x_triu = cuda_extension.triu_last_two_dims(x, diagonal=0)
+        yield 'step_002', x_triu
+        yield 'step_003', (x_max, x_triu)
