{
  "operators": [
    {
      "name": "custom_linear",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, seq_len, in_features]",
          "layout": "strided",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_features, in_features]",
          "layout": "strided",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_features]",
          "layout": "strided",
          "nullable": true,
          "optional": true,
          "default": null
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, seq_len, out_features]"
      },
      "semantics": [
        "计算 output = input @ weight.T + bias，其中 input 形状 [batch, seq_len, in_features]，weight 形状 [out_features, in_features]，bias 形状 [out_features]（可为 None）。",
        "输出形状为 [batch, seq_len, out_features]。",
        "输入和权重必须位于 CUDA 上。",
        "广播：bias 广播到最后一个维度。",
        "支持任意 strides，必要时内部处理。"
      ]
    },
    {
      "name": "custom_gelu",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "任意形状",
          "layout": "strided",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "与 input 相同"
      },
      "semantics": [
        "逐元素计算 F.gelu，使用 PyTorch 的默认近似：0.5 * x * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))",
        "输入输出形状相同。"
      ]
    },
    {
      "name": "custom_softmax",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, seq_len, features]",
          "layout": "strided",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "default": -1,
          "optional": true,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "与 input 相同"
      },
      "semantics": [
        "沿指定维度计算 softmax。",
        "输出与输入具有相同的形状和 dtype。",
        "数值上与 torch.softmax 等价。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.linear(x)",
      "semantics": [
        "对输入张量应用线性变换：y = x @ weight.T + bias",
        "输入形状 [512, 1000, 128]，输出形状 [512, 1000, 64]"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = F.gelu(x)",
      "semantics": [
        "对线性层输出逐元素应用 GELU 激活函数",
        "输出形状不变 [512, 1000, 64]"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = torch.softmax(x, dim=1)",
      "semantics": [
        "沿第二个维度（seq_len）应用 softmax",
        "输出形状不变 [512, 1000, 64]"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return x",
      "semantics": [
        "返回最终输出张量，形状 [512, 1000, 64]"
      ]
    }
  ]
}