--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,156 @@
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// BatchNorm inference kernel: y = (x - mean) / sqrt(var + eps) * weight + bias
+// Input x: shape [N, C, H, W] with arbitrary strides (but typically contiguous)
+// Output: same shape and strides as input, but we will allocate contiguous in binding, so can ignore strides for output if we write to same linear index based on input strides.
+// However, binding may allocate contiguous output and pass output strides. For correctness, launcher will accept output strides as well and compute output offset with output strides.
+__global__ void batch_norm_inference_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ y,
+    const float* __restrict__ weight,
+    const float* __restrict__ bias,
+    const float* __restrict__ running_mean,
+    const float* __restrict__ running_var,
+    float eps,
+    int64_t N,
+    int64_t C,
+    int64_t H,
+    int64_t W,
+    const int64_t* __restrict__ x_strides, // [4]
+    const int64_t* __restrict__ y_strides  // [4]
+) {
+    int64_t total = N * C * H * W;
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (; idx < total; idx += stride) {
+        // recover n,c,h,w from linear idx assuming row-major over (N,C,H,W) in index space
+        int64_t tmp = idx;
+        int64_t w = tmp % W;
+        tmp /= W;
+        int64_t h = tmp % H;
+        tmp /= H;
+        int64_t c = tmp % C;
+        int64_t n = tmp / C;
+
+        int64_t x_idx = n * x_strides[0] + c * x_strides[1] + h * x_strides[2] + w * x_strides[3];
+        int64_t y_idx = n * y_strides[0] + c * y_strides[1] + h * y_strides[2] + w * y_strides[3];
+
+        float val = x[x_idx];
+        float mean = running_mean[c];
+        float var = running_var[c];
+        float wgt = weight[c];
+        float b = bias[c];
+        float inv_std = rsqrtf(var + eps);
+        y[y_idx] = (val - mean) * inv_std * wgt + b;
+    }
+}
+
+// Max reduce along dimension 1 (channels) for float32.
+// Input x: shape [N, C, H, W] with strides x_strides[4].
+// Output: shape [N, H, W] contiguous, effectively output_strides = [H*W, W, 1].
+// We use one block per output element (n,h,w), with threads cooperating over C.
+// C may be up to a few hundred, so blockDim <= 1024.
+__global__ void max_reduce_dim1_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ out,
+    int64_t N,
+    int64_t C,
+    int64_t H,
+    int64_t W,
+    const int64_t* __restrict__ x_strides // [4]
+) {
+    // One block per output element: n, h, w
+    int64_t out_idx = blockIdx.x; // linear index over N*H*W
+    if (out_idx >= N * H * W) return;
+
+    int64_t n = out_idx / (H * W);
+    int64_t rem = out_idx - n * H * W;
+    int64_t h = rem / W;
+    int64_t w = rem % W;
+
+    // Base offset for this n,h,w at channel 0
+    int64_t base = n * x_strides[0] + h * x_strides[2] + w * x_strides[3];
+
+    float max_val = -CUDART_INF_F;
+    // Not using shared memory since C is small and simple loop is fine. But shared memory reduction is possible.
+    // We'll do a strided loop that each thread handles a subset of channels, then warp shuffle reduction and then block reduction.
+    // Since C can be e.g. 64, and blockDim.x chosen to be e.g. 256, many threads idle. More efficient: one warp per output element, but that would require multiple output elements per block.
+    // Alternative: each thread computes max over a subset of C, then reduce across block using shared memory.
+    extern __shared__ float sdata[];
+    int tid = threadIdx.x;
+    int block_size = blockDim.x;
+
+    // Loop over channels with stride block_size, accumulate local max
+    float local_max = -CUDART_INF_F;
+    for (int64_t c = tid; c < C; c += block_size) {
+        float val = x[base + c * x_strides[1]];
+        local_max = fmaxf(local_max, val);
+    }
+    sdata[tid] = local_max;
+    __syncthreads();
+
+    // Reduction in shared memory
+    for (int s = block_size / 2; s > 0; s >>= 1) {
+        if (tid < s) {
+            sdata[tid] = fmaxf(sdata[tid], sdata[tid + s]);
+        }
+        __syncthreads();
+    }
+
+    if (tid == 0) {
+        out[out_idx] = sdata[0];
+    }
+}
+
+// Launcher for batch_norm_inference. The binding will allocate the output tensor with the same shape and strides as input (or contiguous if requested).
+// We pass both x and y strides.
+extern "C" void batch_norm_inference_launcher(
+    const float* x,
+    float* y,
+    const float* weight,
+    const float* bias,
+    const float* running_mean,
+    const float* running_var,
+    float eps,
+    int64_t N,
+    int64_t C,
+    int64_t H,
+    int64_t W,
+    const int64_t* x_strides,
+    const int64_t* y_strides,
+    cudaStream_t stream
+) {
+    int64_t total = N * C * H * W;
+    const int threads = 256;
+    int blocks = (int)((total + threads - 1) / threads);
+    // Grid-stride loop so no need to cap exactly, but cap to a reasonable number to avoid too many blocks? Cannot exceed int max, but total ~134M / 256 ~ 524288 blocks, which is huge but may be okay? Actually maximum grid x dimension is 2^31-1, so 524288 is fine.
+    batch_norm_inference_kernel<<<blocks, threads, 0, stream>>>(
+        x, y, weight, bias, running_mean, running_var, eps,
+        N, C, H, W, x_strides, y_strides);
+}
+
+// Launcher for max_reduce. output is contiguous shape [N,H,W].
+extern "C" void max_reduce_launcher(
+    const float* x,
+    float* out,
+    int64_t N,
+    int64_t C,
+    int64_t H,
+    int64_t W,
+    const int64_t* x_strides,
+    cudaStream_t stream
+) {
+    int64_t out_numel = N * H * W;
+    // block size: choose based on C. Typically C=64, use 64 or 128? Use 256 threads to handle future larger C, but for C < block size many threads idle. We'll choose block size as min(next_power_of_two(C), 256) maybe.
+    int block_size = 256;
+    while (block_size > 1 && block_size / 2 >= C) {
+        block_size /= 2;
+    }
+    if (block_size > 1024) block_size = 1024;
+    int blocks = (int)out_numel; // one block per output element, may be up to 16*1024*128 = 2,097,152 blocks, okay but grid.x max 2^31-1 so fine.
+    // shared memory size: block_size floats
+    size_t shared_mem = block_size * sizeof(float);
+    max_reduce_dim1_kernel<<<blocks, block_size, shared_mem, stream>>>(
+        x, out, N, C, H, W, x_strides);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,179 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void batch_norm_inference_launcher(
+    const float* x,
+    float* y,
+    const float* weight,
+    const float* bias,
+    const float* running_mean,
+    const float* running_var,
+    float eps,
+    int64_t N,
+    int64_t C,
+    int64_t H,
+    int64_t W,
+    const int64_t* x_strides,
+    const int64_t* y_strides,
+    cudaStream_t stream
+);
+
+extern "C" void max_reduce_launcher(
+    const float* x,
+    float* out,
+    int64_t N,
+    int64_t C,
+    int64_t H,
+    int64_t W,
+    const int64_t* x_strides,
+    cudaStream_t stream
+);
+
+torch::Tensor batch_norm_inference(
+    torch::Tensor x,
+    torch::Tensor weight,
+    torch::Tensor bias,
+    torch::Tensor running_mean,
+    torch::Tensor running_var,
+    double eps
+) {
+    // Input validation
+    TORCH_CHECK(x.is_cuda(), "batch_norm_inference: x must be a CUDA tensor");
+    TORCH_CHECK(weight.is_cuda(), "batch_norm_inference: weight must be a CUDA tensor");
+    TORCH_CHECK(bias.is_cuda(), "batch_norm_inference: bias must be a CUDA tensor");
+    TORCH_CHECK(running_mean.is_cuda(), "batch_norm_inference: running_mean must be a CUDA tensor");
+    TORCH_CHECK(running_var.is_cuda(), "batch_norm_inference: running_var must be a CUDA tensor");
+
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "batch_norm_inference: x must be float32");
+    TORCH_CHECK(weight.dtype() == torch::kFloat32, "batch_norm_inference: weight must be float32");
+    TORCH_CHECK(bias.dtype() == torch::kFloat32, "batch_norm_inference: bias must be float32");
+    TORCH_CHECK(running_mean.dtype() == torch::kFloat32, "batch_norm_inference: running_mean must be float32");
+    TORCH_CHECK(running_var.dtype() == torch::kFloat32, "batch_norm_inference: running_var must be float32");
+
+    TORCH_CHECK(x.dim() == 4, "batch_norm_inference: x must be 4D (N,C,H,W)");
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+
+    TORCH_CHECK(weight.numel() == C, "batch_norm_inference: weight size mismatch");
+    TORCH_CHECK(bias.numel() == C, "batch_norm_inference: bias size mismatch");
+    TORCH_CHECK(running_mean.numel() == C, "batch_norm_inference: running_mean size mismatch");
+    TORCH_CHECK(running_var.numel() == C, "batch_norm_inference: running_var size mismatch");
+
+    // Allocate output tensor: same shape as input, contiguous
+    auto y = torch::empty_like(x);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Prepare strides arrays on host (these are int64_t)
+    int64_t x_strides[4] = {x.stride(0), x.stride(1), x.stride(2), x.stride(3)};
+    int64_t y_strides[4] = {y.stride(0), y.stride(1), y.stride(2), y.stride(3)};
+
+    // Copy strides to device? The launcher expects pointer to const int64_t* (device pointer).
+    // The .cu kernel dereferences x_strides and y_strides in device code.
+    // Therefore we need to allocate device memory for strides and copy them.
+    // But this would introduce a cudaMalloc/cudaMemcpy overhead per call.
+    // Alternative: pass the strides as kernel arguments by value (within the launcher) and modify the launcher,
+    // but we cannot modify .cu now. However, the launcher signature currently takes pointers to int64_t arrays.
+    // In the original .cu, the launcher just passes those pointers directly to the kernel without dereferencing on host.
+    // So they must be device pointers. We need to allocate device memory for stride arrays and copy host values.
+    // To avoid per-call allocation overhead, we could use a static cache, but simplest is to allocate small buffers each time.
+    // This is acceptable for correctness; performance can be improved later by modifying .cu.
+
+    int64_t* d_x_strides = nullptr;
+    int64_t* d_y_strides = nullptr;
+    cudaMalloc(&d_x_strides, 4 * sizeof(int64_t));
+    cudaMalloc(&d_y_strides, 4 * sizeof(int64_t));
+    cudaMemcpyAsync(d_x_strides, x_strides, 4 * sizeof(int64_t), cudaMemcpyHostToDevice, stream);
+    cudaMemcpyAsync(d_y_strides, y_strides, 4 * sizeof(int64_t), cudaMemcpyHostToDevice, stream);
+
+    // Call launcher
+    batch_norm_inference_launcher(
+        x.data_ptr<float>(),
+        y.data_ptr<float>(),
+        weight.data_ptr<float>(),
+        bias.data_ptr<float>(),
+        running_mean.data_ptr<float>(),
+        running_var.data_ptr<float>(),
+        static_cast<float>(eps),
+        N, C, H, W,
+        d_x_strides,
+        d_y_strides,
+        stream
+    );
+
+    // Free device stride buffers after kernel completes (stream ordered)
+    cudaFreeAsync(d_x_strides, stream);
+    cudaFreeAsync(d_y_strides, stream);
+
+    // Check for kernel launch errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "batch_norm_inference kernel launch failed: ", cudaGetErrorString(err));
+
+    return y;
+}
+
+torch::Tensor max_reduce(torch::Tensor x, int64_t dim) {
+    // Input validation
+    TORCH_CHECK(x.is_cuda(), "max_reduce: x must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "max_reduce: x must be float32");
+    TORCH_CHECK(x.dim() == 4, "max_reduce: x must be 4D (N,C,H,W)");
+    TORCH_CHECK(dim == 1, "max_reduce: only dim=1 is supported");
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+
+    // Ensure input is contiguous; the .cu kernel expects x_strides to be provided,
+    // but the reduction kernel assumes contiguous access pattern? Actually it uses x_strides,
+    // so it can handle strides. But to be safe and match the expected output, we make input contiguous
+    // if needed. However, batch_norm_inference returns contiguous, so x is contiguous here.
+    x = x.contiguous();
+
+    // Allocate output tensor: [N, H, W] contiguous, float32
+    auto out = torch::empty({N, H, W}, x.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Prepare strides array on host (input is contiguous, so strides are [C*H*W, H*W, W, 1])
+    int64_t x_strides[4] = {x.stride(0), x.stride(1), x.stride(2), x.stride(3)};
+    int64_t* d_x_strides = nullptr;
+    cudaMalloc(&d_x_strides, 4 * sizeof(int64_t));
+    cudaMemcpyAsync(d_x_strides, x_strides, 4 * sizeof(int64_t), cudaMemcpyHostToDevice, stream);
+
+    // Call launcher
+    max_reduce_launcher(
+        x.data_ptr<float>(),
+        out.data_ptr<float>(),
+        N, C, H, W,
+        d_x_strides,
+        stream
+    );
+
+    cudaFreeAsync(d_x_strides, stream);
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "max_reduce kernel launch failed: ", cudaGetErrorString(err));
+
+    return out;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("batch_norm_inference", &batch_norm_inference,
+          "BatchNorm inference forward",
+          py::arg("x"), py::arg("weight"), py::arg("bias"),
+          py::arg("running_mean"), py::arg("running_var"), py::arg("eps"));
+    m.def("max_reduce", &max_reduce,
+          "Max reduce along dim",
+          py::arg("x"), py::arg("dim"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,38 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, num_features, dim, max_value):
+        super().__init__()
+        self.batch_norm = nn.BatchNorm2d(num_features)
+        self.dim = dim
+        self.max_value = max_value
+
+    def forward(self, x):
+        x = cuda_extension.batch_norm_inference(
+            x,
+            self.batch_norm.weight,
+            self.batch_norm.bias,
+            self.batch_norm.running_mean,
+            self.batch_norm.running_var,
+            self.batch_norm.eps
+        )
+        max_vals = cuda_extension.max_reduce(x, self.dim)
+        return max_vals * self.max_value
+
+    def debug_forward(self, *inputs):
+        x = inputs[0]
+        x = cuda_extension.batch_norm_inference(
+            x,
+            self.batch_norm.weight,
+            self.batch_norm.bias,
+            self.batch_norm.running_mean,
+            self.batch_norm.running_var,
+            self.batch_norm.eps
+        )
+        yield 'step_001', x
+        max_vals = cuda_extension.max_reduce(x, self.dim)
+        final = max_vals * self.max_value
+        yield 'step_002', final
