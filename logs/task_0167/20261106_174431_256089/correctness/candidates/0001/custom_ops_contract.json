{
  "operators": [
    {
      "name": "batch_norm_inference",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "strided",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "strided",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "strided",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "strided",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x [N, C, H, W]"
      },
      "semantics": [
        "对应 self.batch_norm(x) 在推理模式下的计算：对每个通道 c，y = (x - running_mean[c]) / sqrt(running_var[c] + eps) * weight[c] + bias[c]，其中 running_mean/running_var 是推理时使用的统计量，不更新。",
        "形状与输入 x 完全一致，保留原始 stride 或按需连续化，输出为 float32。",
        "所有张量均在 CUDA 上，batch_norm_inference 返回新的张量。"
      ]
    },
    {
      "name": "max_reduce",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "沿 dim 约减后的形状，例如 dim=1 时 [N, H, W]"
      },
      "semantics": [
        "对应 torch.max(x, dim)[0]，沿指定维度 dim 取最大值，返回最大值张量（不返回索引）。",
        "仅支持 dim=1 的通道约减；输出形状为输入去掉该维度，例如 [N,C,H,W] -> [N,H,W]。",
        "保持原有遍历顺序，输出每个位置的最大值。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.batch_norm(x)",
      "semantics": [
        "对输入 x 执行 BatchNorm2d 推理：利用 running_mean/running_var 和可学习 weight/bias 进行逐通道线性变换，输出形状与输入相同。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "return torch.max(x, self.dim)[0] * self.max_value",
      "semantics": [
        "沿 dim=1 对 batch_norm 输出取最大值，得到 [N,H,W] 张量，再乘以标量 max_value=0.5，返回最终结果。"
      ]
    }
  ]
}