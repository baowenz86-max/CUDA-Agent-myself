{
  "operators": [
    {
      "name": "batchnorm2d_eval_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input [N, C, H, W]"
      },
      "semantics": [
        "对应参考语句 x = self.bn(x)，在 eval 模式下使用 running_mean 和 running_var 进行归一化。",
        "输出 y = weight * (x - running_mean) / sqrt(running_var + eps) + bias，其中 weight 和 bias 可缺省。",
        "归一化沿通道轴 C 进行，对每个通道 c 使用标量 running_mean[c]、running_var[c]、weight[c]、bias[c]。",
        "广播遵循 [N, C, H, W] 与 [C] 的规则，即每个通道的标量应用到该通道的所有空间位置。",
        "输出形状与输入相同，dtype 为 float32，device 为 cuda。"
      ]
    },
    {
      "name": "relu_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对应参考语句 x = F.relu(x)，默认 inplace=False。",
        "逐元素计算 max(input, 0)，输出 dtype/device/shape 与输入相同。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.bn(x)",
      "semantics": [
        "在 eval 模式下执行 BatchNorm2d 推理归一化，使用 running_mean 和 running_var，无 momentum 更新。",
        "若 affine=True，则应用可学习权重 weight 和 bias；否则 weight=None, bias=None。",
        "输出形状与输入相同 [16, 3, 512, 512]，dtype float32，device cuda:0。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = F.relu(x)",
      "semantics": [
        "对 BatchNorm2d 输出逐元素应用 ReLU 激活函数，输出形状 [16, 3, 512, 512]，dtype float32，device cuda:0。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "最终返回 ReLU 输出张量，与 step_002 相同。"
      ]
    }
  ]
}