+                // hidden contribution: h_l1_cur
+                for (int k = 0; k < H; ++k) {
+                    float hk = h_l1_cur[k];
+                    sum_i += w_hh_l1[j * H + k] * hk;
+                    sum_f += w_hh_l1[(H + j) * H + k] * hk;
+                    sum_g += w_hh_l1[(2*H + j) * H + k] * hk;
+                    sum_o += w_hh_l1[(3*H + j) * H + k] * hk;
+                }
+
+                float i_gate = sigmoidf(sum_i);
+                float f_gate = sigmoidf(sum_f);
+                float g_gate = tanhf(sum_g);
+                float o_gate = sigmoidf(sum_o);
+                float c_new = f_gate * c_l1_cur[j] + i_gate * g_gate;
+                float h_new = o_gate * tanhf(c_new);
+
+                h_l1_next[j] = h_new;
+                c_l1_next[j] = c_new;
+                // Write final output for this layer (time t, batch b, unit j)
+                output[t * batch_size * H + b * H + j] = h_new;
+            }
+            __syncthreads();
+
+            // Swap layer1 current and next
+            for (int i = tid; i < H; i += num_threads) {
+                h_l1_cur[i] = h_l1_next[i];
+                c_l1_cur[i] = c_l1_next[i];
+            }
+            __syncthreads();
+        } else {
+            // If num_layers == 1, output from layer0
+            if (tid < H) {
+                output[t * batch_size * H + b * H + tid] = h_l0_next[tid];
+            }
+            __syncthreads();
+        }
+    }
+
+    // Write final h_n and c_n for both layers.
+    // For layer0:
+    for (int i = tid; i < H; i += num_threads) {
+        h_n[0 * batch_size * H + b * H + i] = h_l0_cur[i];
+        c_n[0 * batch_size * H + b * H + i] = c_l0_cur[i];
+    }
+    if (num_layers > 1) {
+        for (int i = tid; i < H; i += num_threads) {
+            h_n[1 * batch_size * H + b * H + i] = h_l1_cur[i];
+            c_n[1 * batch_size * H + b * H + i] = c_l1_cur[i];
+        }
+    }
+    // If num_layers > 2, we would need additional layers, but contract says exactly 2.
+    // For generality, we could loop over layers, but we'll assume num_layers <= 2.
+    // The launcher will check num_layers.
+}
+
+// ---------------------------------------------------------------------------
+// Launcher functions (extern "C")
+
+extern "C" void zeros_like_alloc_launcher(
+    float* output,
+    int64_t num_layers,
+    int64_t batch_size,
+    int64_t hidden_size,
+    cudaStream_t stream
+) {
+    int64_t total = num_layers * batch_size * hidden_size;
+    int threads = 256;
+    int blocks = (int)((total + threads - 1) / threads);
+    if (blocks > 65535) blocks = 65535; // grid limit, will use grid-stride loop
+    zeros_kernel<<<blocks, threads, 0, stream>>>(output, total);
+}
+
+extern "C" void linear_fc_launcher(
+    const float* input,
+    const float* weight,
+    const float* bias,
+    float* output,
+    int batch_size,
+    int in_features,
+    int out_features,
+    cudaStream_t stream
+) {
+    dim3 threads(16, 16); // 256 threads
+    dim3 blocks((out_features + threads.x - 1) / threads.x,
+                (batch_size + threads.y - 1) / threads.y);
+    linear_fc_kernel<<<blocks, threads, 0, stream>>>(
+        input, weight, bias, output, batch_size, in_features, out_features);
+}
+
+extern "C" void lstm_forward_launcher(
+    const float* x,
+    const float* h0,
+    const float* c0,
+    const float* w_ih_l0,
+    const float* w_hh_l0,
+    const float* b_ih_l0,
+    const float* b_hh_l0,
+    const float* w_ih_l1,
+    const float* w_hh_l1,
+    const float* b_ih_l1,
+    const float* b_hh_l1,
+    float* output,
+    float* h_n,
+    float* c_n,
+    int seq_len,
+    int batch_size,
+    int input_size,
+    int hidden_size,
+    int num_layers,
+    cudaStream_t stream
+) {
+    // Check that num_layers == 2 (or 1) as we only implemented up to 2 layers.
+    // Contract always passes 2, but be safe.
+    if (num_layers != 2 && num_layers != 1) {
+        // Not supported, but binding should prevent this.
+        // We'll still launch for 1 or 2; for >2, kernel won't compute correctly.
+        // For now, assume valid.
+    }
+
+    int threads = 256; // enough for hidden_size up to 256.
+    int blocks = batch_size;
+    int shared_mem = (9 * hidden_size + input_size) * sizeof(float);
+    lstm_forward_kernel<<<blocks, threads, shared_mem, stream>>>(
+        x, h0, c0, w_ih_l0, w_hh_l0, b_ih_l0, b_hh_l0,
+        w_ih_l1, w_hh_l1, b_ih_l1, b_hh_l1,
+        output, h_n, c_n, seq_len, batch_size, input_size, hidden_size, num_layers);
+}
+
+// Note: The binding.cpp will call these launchers after allocating output tensors.
+// The .cu file contains no PyTorch dependencies, as required.
