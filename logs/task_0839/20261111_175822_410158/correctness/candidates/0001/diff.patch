+// CUDA kernels for LSTM model optimization
+#include <cuda_runtime.h>
+#include <cmath>
+
+// ---------------------------------------------------------------------------
+// Helper: sigmoid and tanh
+__device__ __forceinline__ float sigmoidf(float x) {
+    return 1.0f / (1.0f + expf(-x));
+}
+
+__device__ __forceinline__ float tanhf(float x) {
+    return tanhf(x);
+}
+
+// ---------------------------------------------------------------------------
+// Kernel: zeros_like_alloc
+// Fills a contiguous float array with zeros.
+// total_elements = num_layers * batch_size * hidden_size
+__global__ void zeros_kernel(float* data, int64_t total_elements) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < total_elements; i += stride) {
+        data[i] = 0.0f;
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Kernel: linear_fc
+// Computes y = input @ weight.T + bias
+// input: [batch_size, in_features] contiguous
+// weight: [out_features, in_features] contiguous
+// bias: [out_features] contiguous
+// output: [batch_size, out_features] contiguous
+// We use one thread per output element.
+// grid: (out_features, batch_size) blocks? Actually use 2D grid.
+__global__ void linear_fc_kernel(const float* input, const float* weight, const float* bias,
+                                 float* output, int batch_size, int in_features, int out_features) {
+    int row = blockIdx.y; // batch index
+    int col = blockIdx.x * blockDim.x + threadIdx.x; // out feature index
+    if (row >= batch_size || col >= out_features) return;
+
+    const float* input_row = input + row * in_features;
+    const float* weight_row = weight + col * in_features;
+    float sum = bias ? bias[col] : 0.0f;
+    for (int k = 0; k < in_features; ++k) {
+        sum += input_row[k] * weight_row[k];
+    }
+    output[row * out_features + col] = sum;
+}
