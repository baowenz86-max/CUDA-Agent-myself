--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,94 @@
+#include <cuda_runtime.h>
+
+// Adaptive average pooling 1D kernel
+// Computes average pooling over last dimension for each element in batch and channels.
+// Input: 3D tensor of shape [b, c, l_in]
+// Output: 3D tensor of shape [b, c, l_out]
+// The bin boundaries follow torch.nn.AdaptiveAvgPool1d: start = floor(i*l_in/l_out), end = ceil((i+1)*l_in/l_out)
+__global__ void adaptive_avg_pool1d_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int l_in,
+    int l_out)
+{
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = gridDim.x * blockDim.x;
+    int c = l_in;
+    int plane = c * l_out; // number of elements per (b, c) plane in output
+    int total_output = plane; // will be multiplied by b in loop
+    // Actually we need b, c, l_out dimensions; loop over all output elements
+    for (int i = idx; i < total_output; i += total) {
+        int b = i / plane;
+        int rem = i % plane;
+        int ch = rem / l_out;
+        int out_idx = rem % l_out;
+
+        int start_idx = (int)((long long)out_idx * l_in / l_out);
+        int end_idx = (int)(((long long)(out_idx + 1) * l_in + l_out - 1) / l_out); // ceil
+        if (end_idx > l_in) end_idx = l_in;
+        if (start_idx >= end_idx) {
+            output[i] = 0.0f;
+            continue;
+        }
+
+        float sum = 0.0f;
+        const float* in_ptr = input + (long long)b * c * l_in + (long long)ch * l_in + start_idx;
+        for (int j = start_idx; j < end_idx; ++j) {
+            sum += in_ptr[j];
+        }
+        output[i] = sum / (float)(end_idx - start_idx);
+    }
+}
+
+// Launcher for adaptive_avg_pool1d
+// Input and output are contiguous float tensors on CUDA.
+extern "C" void adaptive_avg_pool1d_launcher(
+    const float* input,
+    float* output,
+    int b,
+    int c,
+    int l_in,
+    int l_out,
+    cudaStream_t stream)
+{
+    int total_output = b * c * l_out;
+    int block = 256;
+    int grid = (total_output + block - 1) / block;
+    if (grid > 65535) grid = 65535;
+    adaptive_avg_pool1d_kernel<<<grid, block, 0, stream>>>(input, output, l_in, l_out);
+}
+
+// Repeat interleave (stack along new dimension) kernel
+// Output is contiguous with shape [batch, repeats, channels, length].
+// We simply copy input data repeats times into output; output flat size = input_flat_size * repeats.
+__global__ void repeat_interleave_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    long long input_size,
+    int repeats)
+{
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long total = (long long)gridDim.x * blockDim.x;
+    long long output_size = input_size * repeats;
+    for (long long i = idx; i < output_size; i += total) {
+        long long src_idx = i % input_size;
+        output[i] = input[src_idx];
+    }
+}
+
+// Launcher for repeat_interleave_like
+// input is contiguous flat buffer, output is contiguous buffer of size input_size * repeats.
+extern "C" void repeat_interleave_like_launcher(
+    const float* input,
+    float* output,
+    long long input_size,
+    int repeats,
+    cudaStream_t stream)
+{
+    long long output_size = input_size * repeats;
+    int block = 256;
+    long long grid_ll = (output_size + block - 1) / block;
+    int grid = (int)grid_ll;
+    if (grid_ll > 65535) grid = 65535;
+    repeat_interleave_kernel<<<grid, block, 0, stream>>>(input, output, input_size, repeats);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,108 @@
+// Binding for adaptive_avg_pool1d and repeat_interleave_like
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void adaptive_avg_pool1d_launcher(
+    const float* input,
+    float* output,
+    int b,
+    int c,
+    int l_in,
+    int l_out,
+    cudaStream_t stream
+);
+
+extern "C" void repeat_interleave_like_launcher(
+    const float* input,
+    float* output,
+    long long input_size,
+    int repeats,
+    cudaStream_t stream
+);
+
+// Wrapper for adaptive_avg_pool1d
+torch::Tensor adaptive_avg_pool1d(torch::Tensor input, int64_t output_size) {
+    // Parameter checks
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(input.dim() == 3, "input must be 3D (batch, channels, length)");
+    TORCH_CHECK(output_size > 0, "output_size must be positive");
+
+    // Ensure contiguity
+    input = input.contiguous();
+
+    int b = input.size(0);
+    int c = input.size(1);
+    int l_in = input.size(2);
+    int l_out = static_cast<int>(output_size);
+
+    auto output = torch::empty({b, c, l_out}, input.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    adaptive_avg_pool1d_launcher(
+        input.data_ptr<float>(),
+        output.data_ptr<float>(),
+        b,
+        c,
+        l_in,
+        l_out,
+        stream
+    );
+
+    return output;
+}
+
+// Wrapper for repeat_interleave_like
+torch::Tensor repeat_interleave_like(torch::Tensor input, int64_t repeats, int64_t dim) {
+    // Parameter checks
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(repeats > 0, "repeats must be positive");
+
+    // Normalize dim
+    int ndim = input.dim();
+    if (dim < 0) {
+        dim = dim + ndim + 1;
+    }
+    // The launcher only supports stack-like copy in contiguous layout for dim=1 on 3D input,
+    // which is exactly the model usage. We enforce that here to avoid silent incorrectness.
+    TORCH_CHECK(ndim == 3, "repeat_interleave_like currently supports only 3D input");
+    TORCH_CHECK(dim == 1, "repeat_interleave_like currently supports only dim=1");
+
+    // Ensure contiguity
+    input = input.contiguous();
+
+    long long input_size = static_cast<long long>(input.numel());
+    auto output = torch::empty({input.size(0), repeats, input.size(1), input.size(2)}, input.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    repeat_interleave_like_launcher(
+        input.data_ptr<float>(),
+        output.data_ptr<float>(),
+        input_size,
+        static_cast<int>(repeats),
+        stream
+    );
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("adaptive_avg_pool1d", &adaptive_avg_pool1d,
+          "Adaptive average pooling 1D",
+          py::arg("input"), py::arg("output_size"));
+
+    m.def("repeat_interleave_like", &repeat_interleave_like,
+          "Repeat interleave like torch.stack",
+          py::arg("input"), py::arg("repeats"), py::arg("dim"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
