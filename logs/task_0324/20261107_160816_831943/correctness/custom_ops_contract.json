{
  "operators": [
    {
      "name": "adaptive_avg_pool2d",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "output_size",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C, output_size, output_size]"
      },
      "semantics": [
        "对应参考语句 x = self.adaptive_avg_pool(x)，output_size 为 (2,2)。",
        "对每个 (n,c) 平面，将 H×W 自适应划分为 2×2 个区域，每个区域计算平均值。",
        "输出 shape 为 [512,3,2,2]，dtype 保持 float32，device 为 cuda。"
      ]
    },
    {
      "name": "conv2d",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C_in, H_in, W_in]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C_out, C_in, kernel_size[0], kernel_size[1]]",
          "layout": "strided",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C_out]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "stride",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "padding",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C_out, H_out, W_out]"
      },
      "semantics": [
        "对应参考语句 x = self.conv(x)，其中 self.conv 是 nn.Conv2d(3, 16, kernel_size=(2,2), stride=(2,2), padding=(0,0), bias=False)。",
        "输入 x 为 adaptive_avg_pool2d 的输出 [512,3,2,2]，weight 形状 [16,3,2,2]，无 bias（bias=False 时 bias 参数传 None）。",
        "输出形状为 [512,16,1,1]，计算公式为 out[n,co,ho,wo] = sum_{ci,kh,kw} x[n,ci,ho*stride+kh, wo*stride+kw] * weight[co,ci,kh,kw]",
        "stride=(2,2)，padding=(0,0)，kernel_size=(2,2)，输出尺寸 floor((2 - 2 + 0*2)/2) + 1 = 1"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.adaptive_avg_pool(x)",
      "semantics": [
        "对输入 [512,3,256,256] 使用 AdaptiveAvgPool2d(output_size=(2,2))，每个通道池化为 2×2，输出 [512,3,2,2]。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.conv(x)",
      "semantics": [
        "对 [512,3,2,2] 使用 Conv2d(3,16,kernel_size=(2,2),stride=(2,2),padding=(0,0),bias=False) 卷积，输出 [512,16,1,1]。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回卷积结果，shape [512,16,1,1]，dtype float32，device cuda:0。"
      ]
    }
  ]
