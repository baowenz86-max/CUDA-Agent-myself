--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,89 @@
+#include <cuda_runtime.h>
+
+// Helper to compute ceiling division
+template <typename T>
+__device__ __forceinline__ T ceil_div(T a, T b) {
+    return (a + b - 1) / b;
+}
+
+// Softmax along dim=1 for a 3D tensor of shape [B, D, C]
+// Input and output are contiguous float32 arrays.
+// Each (b, d, c) element is indexed as ((b * D + d) * C + c)
+__global__ void softmax1d_kernel(const float* __restrict__ input,
+                                 float* __restrict__ output,
+                                 int B, int D, int C) {
+    int total = B * D * C;
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+
+    for (int linear = idx; linear < total; linear += stride) {
+        int c = linear % C;
+        int tmp = linear / C;
+        int d = tmp % D;
+        int b = tmp / D;
+
+        // Compute max over d' for this (b, c)
+        float max_val = -INFINITY;
+        for (int dd = 0; dd < D; ++dd) {
+            float val = input[((b * D + dd) * C + c)];
+            if (val > max_val) max_val = val;
+        }
+
+        // Compute sum of exp(x - max) over d'
+        float sum = 0.0f;
+        for (int dd = 0; dd < D; ++dd) {
+            float val = input[((b * D + dd) * C + c)];
+            sum += __expf(val - max_val);
+        }
+
+        float x_val = input[((b * D + d) * C + c)];
+        output[linear] = __expf(x_val - max_val) / sum;
+    }
+}
+
+// Simple elementwise copy kernel
+template <typename T>
+__global__ void copy_kernel(const T* __restrict__ input, T* __restrict__ output, size_t numel) {
+    size_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    size_t stride = blockDim.x * gridDim.x;
+    for (size_t i = idx; i < numel; i += stride) {
+        output[i] = input[i];
+    }
+}
+
+// Elementwise add scalar kernel
+template <typename T, typename Scalar>
+__global__ void add_scalar_kernel(const T* __restrict__ input, T* __restrict__ output, Scalar value, size_t numel) {
+    size_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    size_t stride = blockDim.x * gridDim.x;
+    for (size_t i = idx; i < numel; i += stride) {
+        output[i] = input[i] + static_cast<T>(value);
+    }
+}
+
+// Launchers (extern "C" to be callable from C++ binding)
+extern "C" void softmax1d_launcher(const float* input, float* output,
+                                    int B, int D, int C, cudaStream_t stream) {
+    int total = B * D * C;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    // Grid-stride loop handles large arrays; we could also use a fixed grid.
+    // Cap blocks to avoid exceeding grid dimension limits (optional).
+    int max_blocks = 65535;
+    if (blocks > max_blocks) blocks = max_blocks;
+    softmax1d_kernel<<<blocks, threads, 0, stream>>>(input, output, B, D, C);
+}
+
+extern "C" void squeeze_launcher(const float* input, float* output, size_t numel, cudaStream_t stream) {
+    int threads = 256;
+    int blocks = (int)ceil_div<size_t>(numel, threads);
+    if (blocks > 65535) blocks = 65535;
+    copy_kernel<float><<<blocks, threads, 0, stream>>>(input, output, numel);
+}
+
+extern "C" void add_scalar_launcher(const float* input, float* output, double value, size_t numel, cudaStream_t stream) {
+    int threads = 256;
+    int blocks = (int)ceil_div<size_t>(numel, threads);
+    if (blocks > 65535) blocks = 65535;
+    add_scalar_kernel<float, double><<<blocks, threads, 0, stream>>>(input, output, value, numel);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,120 @@
+// Binding file for custom_ops.cu launchers
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void softmax1d_launcher(const float* input, float* output, int B, int D, int C, cudaStream_t stream);
+extern "C" void squeeze_launcher(const float* input, float* output, size_t numel, cudaStream_t stream);
+extern "C" void add_scalar_launcher(const float* input, float* output, double value, size_t numel, cudaStream_t stream);
+
+// Wrapper for softmax1d_forward
+torch::Tensor softmax1d_forward(torch::Tensor x, int64_t dim) {
+    // Check input
+    TORCH_CHECK(x.is_cuda(), "softmax1d_forward: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "softmax1d_forward: input must be float32");
+    TORCH_CHECK(x.dim() == 3, "softmax1d_forward: input must be 3D");
+    TORCH_CHECK(dim == 1, "softmax1d_forward: only dim=1 supported");
+    TORCH_CHECK(x.is_contiguous(), "softmax1d_forward: input must be contiguous");
+
+    auto sizes = x.sizes();
+    int B = static_cast<int>(sizes[0]);
+    int D = static_cast<int>(sizes[1]);
+    int C = static_cast<int>(sizes[2]);
+
+    // Allocate output with same shape and options
+    auto output = torch::empty_like(x);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    softmax1d_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        B, D, C,
+        stream
+    );
+
+    // Check for errors after launch
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "softmax1d_forward: CUDA error: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// Wrapper for squeeze_forward
+torch::Tensor squeeze_forward(torch::Tensor x) {
+    // Check input
+    TORCH_CHECK(x.is_cuda(), "squeeze_forward: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "squeeze_forward: input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "squeeze_forward: input must be contiguous");
+
+    size_t numel = x.numel();
+
+    // Allocate output with same shape and options
+    auto output = torch::empty_like(x);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    squeeze_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        numel,
+        stream
+    );
+
+    // Check for errors after launch
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "squeeze_forward: CUDA error: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// Wrapper for add_scalar_forward
+torch::Tensor add_scalar_forward(torch::Tensor x, double value) {
+    // Check input
+    TORCH_CHECK(x.is_cuda(), "add_scalar_forward: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "add_scalar_forward: input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "add_scalar_forward: input must be contiguous");
+
+    size_t numel = x.numel();
+
+    // Allocate output with same shape and options
+    auto output = torch::empty_like(x);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    add_scalar_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        value,
+        numel,
+        stream
+    );
+
+    // Check for errors after launch
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "add_scalar_forward: CUDA error: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("softmax1d_forward", &softmax1d_forward,
+          py::arg("x"), py::arg("dim"));
+    m.def("squeeze_forward", &squeeze_forward,
+          py::arg("x"));
+    m.def("add_scalar_forward", &add_scalar_forward,
+          py::arg("x"), py::arg("value"));
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,25 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, dim, epsilon=1e-8):
+        super().__init__()
+        self.dim = dim
+        self.epsilon = epsilon
+
+    def forward(self, x):
+        x = cuda_extension.softmax1d_forward(x, self.dim)
+        x = cuda_extension.squeeze_forward(x)
+        x = cuda_extension.add_scalar_forward(x, self.epsilon)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.softmax1d_forward(x, self.dim)
+        yield 'step_001', x
+        x = cuda_extension.squeeze_forward(x)
+        yield 'step_002', x
+        x = cuda_extension.add_scalar_forward(x, self.epsilon)
+        yield 'step_003', x
+        yield 'step_004', x
