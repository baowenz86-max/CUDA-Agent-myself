          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, out_channels, out_width]"
      },
      "semantics": [
        "对应参考语句 x = self.conv_transpose(x)",
        "使用 cuDNN 执行 ConvTranspose1d，实际 bias 参数来自 conv_transpose.bias，可为 None",
        "stride、padding、output_padding 与参考一致，输出宽度 out_width = (in_width - 1) * stride - 2 * padding + kernel_size + output_padding",
        "返回 float32 CUDA tensor"
      ]
    },
    {
      "name": "bias_add_broadcast",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, out_channels, out_width]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels, 1]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, out_channels, out_width]"
      },
      "semantics": [
        "对应参考语句 x = x + self.bias",
        "bias shape 为 [out_channels, 1]，广播在 batch 和 width 维度：输出[b, c, w] = 输入[b, c, w] + bias[c]",
        "返回 float32 CUDA tensor，shape 不变"
      ]
    },
    {
      "name": "std_batch_width_unbiased",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, out_channels, out_width]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[out_channels]"
      },
      "semantics": [
        "对应参考语句 x = torch.std(x, dim=[0, 2], unbiased=True)",
        "在 batch 和 width 维度求无偏标准差，输出长度 out_channels",
        "数值语义使用参考 torch.std 的无偏估计公式，分母为 n-1（n = batch * out_width）",
        "返回 float32 CUDA tensor"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.conv_transpose(x)",
      "semantics": [
        "ConvTranspose1d 前向计算，使用模块参数 conv_transpose.weight 和 conv_transpose.bias",
        "输出 shape [batch, out_channels, out_width]，dtype float32"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = x + self.bias",
      "semantics": [
        "将 conv 输出与单独 bias 参数相加，bias shape [out_channels, 1] 广播到 [batch, out_channels, out_width]"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = torch.std(x, dim=[0, 2], unbiased=True)",
      "semantics": [
        "对输入在 batch 和 width 维度计算无偏标准差，输出 shape [out_channels]"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return x",
      "semantics": [
        "返回最终标准差 tensor"
      ]
    }
  ]
