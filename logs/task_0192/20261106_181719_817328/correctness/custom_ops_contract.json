          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[in_channels, out_channels, kernel_size]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "stride",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "padding",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "output_padding",
          "kind": "int",
