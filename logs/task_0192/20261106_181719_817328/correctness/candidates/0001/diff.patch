+// Helper to get cuDNN handle from CUDA stream
+static cudnnHandle_t get_cudnn_handle() {
+    static cudnnHandle_t handle = nullptr;
+    if (handle == nullptr) {
+        cudnnCreate(&handle);
+    }
+    return handle;
+}
+
+// Helper to set cuDNN stream
+static void set_cudnn_stream(cudnnHandle_t handle, cudaStream_t stream) {
+    cudnnSetStream(handle, stream);
+}
