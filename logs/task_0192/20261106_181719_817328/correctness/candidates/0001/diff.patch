+    cudnnTensorDescriptor_t temp_output_desc;
+    cudnnCreateTensorDescriptor(&temp_output_desc);
+    cudnnSetTensor4dDescriptor(temp_output_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT,
+                               static_cast<int>(batch), static_cast<int>(out_channels), 1, static_cast<int>(width_no_pad));
+
+    // Run convolution backward data
+    float alpha_conv = 1.0f, beta_conv = 0.0f;
+    cudnnConvolutionBackwardData(cudnn_handle,
+                                 &alpha_conv,
+                                 filter_desc, weight_transposed.data_ptr<float>(),
+                                 input_desc, input_contig.data_ptr<float>(),
+                                 conv_desc,
+                                 CUDNN_CONVOLUTION_BWD_DATA_ALGO_0,  // choose default, could tune later
+                                 nullptr, 0,
+                                 &beta_conv,
+                                 temp_output_desc, temp_output.data_ptr<float>());
+
+    // If bias defined, add bias to temp_output
+    if (bias_contig.defined()) {
+        cudnnAddTensor(cudnn_handle, &alpha, bias_desc, bias_contig.data_ptr<float>(),
+                       &alpha_conv, temp_output_desc, temp_output.data_ptr<float>());
+    }
+
+    // Copy temp_output to full output with zero padding for output_padding
+    // First zero the entire output
+    cudaMemsetAsync(output.data_ptr<float>(), 0, batch * out_channels * out_width * sizeof(float), stream);
+
+    // Copy each row: height = batch * out_channels, width_no_pad columns
+    cudaMemcpy2DAsync(output.data_ptr<float>(), out_width * sizeof(float),
+                      temp_output.data_ptr<float>(), width_no_pad * sizeof(float),
+                      width_no_pad * sizeof(float),
+                      batch * out_channels,
+                      cudaMemcpyDeviceToDevice,
+                      stream);
+
+    // Cleanup
+    cudnnDestroyTensorDescriptor(input_desc);
+    cudnnDestroyTensorDescriptor(output_desc);
+    cudnnDestroyTensorDescriptor(bias_desc);
+    cudnnDestroyTensorDescriptor(temp_output_desc);
+    cudnnDestroyTensorDescriptor(src_weight_desc);
+    cudnnDestroyTensorDescriptor(dst_weight_desc);
+    cudnnDestroyFilterDescriptor(filter_desc);
+    cudnnDestroyConvolutionDescriptor(conv_desc);
+
+    return output;
+}
+
+// Bias add broadcast
+torch::Tensor bias_add_broadcast(torch::Tensor input, torch::Tensor bias) {
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(bias.is_cuda(), "bias must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(bias.dtype() == torch::kFloat32, "bias must be float32");
+
+    auto input_sizes = input.sizes();
+    TORCH_CHECK(input_sizes.size() == 3, "input must be 3D");
+    int64_t batch = input_sizes[0];
+    int64_t out_channels = input_sizes[1];
+    int64_t out_width = input_sizes[2];
+
+    auto bias_sizes = bias.sizes();
+    TORCH_CHECK(bias_sizes.size() == 2, "bias must be 2D");
+    TORCH_CHECK(bias_sizes[0] == out_channels, "bias channel mismatch");
+    TORCH_CHECK(bias_sizes[1] == 1, "bias second dim must be 1");
+
+    auto input_contig = input.contiguous();
+    auto bias_contig = bias.contiguous();
+
+    auto output = torch::empty_like(input_contig);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    bias_add_broadcast_forward_launcher(
+        input_contig.data_ptr<float>(),
+        bias_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int>(batch),
+        static_cast<int>(out_channels),
+        static_cast<int>(out_width),
+        static_cast<long long>(input_contig.stride(0)),
+        static_cast<long long>(input_contig.stride(1)),
+        static_cast<long long>(input_contig.stride(2)),
+        stream);
+
+    return output;
+}
+
+// Std batch width unbiased
+torch::Tensor std_batch_width_unbiased(torch::Tensor input) {
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(input.dim() == 3, "input must be 3D");
+
+    auto input_sizes = input.sizes();
+    int64_t batch = input_sizes[0];
+    int64_t out_channels = input_sizes[1];
+    int64_t out_width = input_sizes[2];
+
+    auto input_contig = input.contiguous();
+
+    auto output = torch::empty({out_channels}, input.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    std_batch_width_unbiased_forward_launcher(
+        input_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int>(batch),
+        static_cast<int>(out_channels),
+        static_cast<int>(out_width),
+        static_cast<long long>(input_contig.stride(0)),
+        static_cast<long long>(input_contig.stride(1)),
+        static_cast<long long>(input_contig.stride(2)),
+        stream);
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("conv_transpose1d_forward", &conv_transpose1d_forward,
+          "ConvTranspose1d forward using cuDNN",
+          py::arg("input"), py::arg("weight"), py::arg("bias"), py::arg("stride"), py::arg("padding"), py::arg("output_padding"));
+    m.def("bias_add_broadcast", &bias_add_broadcast,
+          "Broadcast add bias [C,1] to [B,C,W]",
+          py::arg("input"), py::arg("bias"));
+    m.def("std_batch_width_unbiased", &std_batch_width_unbiased,
+          "Unbiased std over batch and width dimensions",
+          py::arg("input"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
