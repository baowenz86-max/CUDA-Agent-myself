+class ModelNew(nn.Module):
+    def __init__(self, in_channels, out_channels, kernel_size, stride, padding, output_padding, bias_shape):
+        super().__init__()
+        self.conv_transpose = nn.ConvTranspose1d(
+            in_channels, out_channels, kernel_size, stride=stride, padding=padding, output_padding=output_padding
+        )
+        self.bias = nn.Parameter(torch.randn(bias_shape))
+
+    def forward(self, x):
+        x = cuda_extension.conv_transpose1d_forward(
+            x, self.conv_transpose.weight, self.conv_transpose.bias,
+            self.conv_transpose.stride[0], self.conv_transpose.padding[0],
+            self.conv_transpose.output_padding[0]
+        )
+        x = cuda_extension.bias_add_broadcast(x, self.bias)
+        x = cuda_extension.std_batch_width_unbiased(x)
+        return x
+
+    def debug_forward(self, x):
