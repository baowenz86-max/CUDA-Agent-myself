{
  "operators": [
    {
      "name": "leaky_relu_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[16, 64, 512, 288]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "negative_slope",
          "kind": "float",
          "optional": true,
          "default": 0.01,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对应参考语句 x = F.leaky_relu(x)，实际 negative_slope 为 0.01",
        "逐元素计算：output = input > 0 ? input : negative_slope * input",
        "保留输入 shape 和 stride"
      ]
    },
    {
      "name": "instance_norm_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[16, 64, 512, 288]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[64]",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[64]",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对应参考语句 x = self.instance_norm(x)，实例归一化对每个样本每个通道独立计算均值方差",
        "归一化轴为 spatial 维度 (H, W)，对每个 (N, C) 计算 mean 和 var，使用有偏方差",
        "标准化后应用 affine 变换：output = (input - mean) / sqrt(var + eps) * weight[C] + bias[C]",
        "weight 和 bias 形状为 [C]，可空，实际为 None 时跳过对应仿射变换",
        "保持输入 shape 与 stride"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = F.leaky_relu(x)",
      "semantics": [
        "使用负斜率 0.01 的 Leaky ReLU 激活"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.instance_norm(x)",
      "semantics": [
        "InstanceNorm2d 前向，使用训练模式统计量（track_running_stats=False）"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回归一化后的张量"
      ]
    }
  ]
}