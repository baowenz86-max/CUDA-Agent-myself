{
  "operators": [
    {
      "name": "custom_conv1d",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, in_channels, in_len]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels, in_channels // groups, kernel_size]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "stride",
          "kind": "int",
          "default": null,
          "optional": false,
          "nullable": false
        },
        {
          "name": "padding",
          "kind": "int",
          "default": null,
          "optional": false,
          "nullable": false
        },
        {
          "name": "dilation",
          "kind": "int",
          "default": null,
          "optional": false,
          "nullable": false
        },
        {
          "name": "groups",
          "kind": "int",
          "default": null,
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, out_channels, out_len]"
      },
      "semantics": [
        "Performs 1D convolution exactly as torch.nn.functional.conv1d with the given input, weight, bias, stride, padding, dilation, groups",
        "Uses cuDNN for convolution, parameters passed as raw tensors",
        "bias may be None; if None, no bias is added",
        "Output length computed as floor((in_len + 2*padding - dilation*(kernel_size-1) - 1)/stride + 1)"
      ]
    },
    {
      "name": "custom_adaptive_avg_pool1d",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, channels, in_len]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "output_size",
          "kind": "int",
          "default": null,
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, channels, output_size]"
      },
      "semantics": [
        "Performs adaptive average pooling over the last dimension exactly as torch.nn.functional.adaptive_avg_pool1d with output_size",
        "For each output position, computes the mean over the corresponding input window determined by start = floor(i * in_len / output_size), end = ceil((i+1) * in_len / output_size)",
        "If input length is less than output_size, some windows may be empty and the output is computed by averaging the available elements (matching PyTorch behavior)"
      ]
    },
    {
      "name": "custom_slice",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, channels, in_len]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "default": null,
          "optional": false,
          "nullable": false
        },
        {
          "name": "start",
          "kind": "int",
          "default": null,
          "optional": false,
          "nullable": false
        },
        {
          "name": "end",
          "kind": "int",
          "default": null,
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input except dim size = end - start"
      },
      "semantics": [
        "Returns a view (or copy) of input along dimension dim from start to end, exclusive of end",
        "Equivalent to torch.narrow(input, dim, start, end - start)",
        "No computation, just data movement/view creation"
      ]
    },
    {
      "name": "custom_std",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, channels, in_len]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "default": null,
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, channels]"
      },
      "semantics": [
        "Computes the unbiased standard deviation along dimension dim exactly as torch.std(input, dim=dim, unbiased=True)",
        "Reduces over the specified dimension, keeping the other dimensions",
        "The result has the same shape as input except the reduced dimension is removed"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.conv1d(x)",
      "semantics": [
        "Applies Conv1d with bias=True, stride=1, padding=0, dilation=1, groups=1",
        "Output shape [512, 16, 9996]"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.pooling(x)",
      "semantics": [
        "Applies AdaptiveAvgPool1d with output_size=200",
        "Output shape [512, 16, 200]"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = x[:, :, :self.reduction_factor]",
      "semantics": [
        "Slices the last dimension from 0 to reduction_factor=50",
        "Output shape [512, 16, 50]"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "x = torch.std(x, dim=2)",
      "semantics": [
        "Computes unbiased standard deviation along the last dimension",
        "Output shape [512, 16]"
      ]
    },
    {
      "checkpoint": "step_005",
      "source": "return x",
      "semantics": [
        "Returns the computed standard deviation tensor"
      ]
    }
  ]
