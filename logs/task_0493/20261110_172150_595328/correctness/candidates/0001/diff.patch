--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,73 @@
+#include <cuda_runtime.h>
+
+// Hardshrink kernel: out = x if x > lambd else x if x < -lambd else 0
+__global__ void hardshrink_kernel(const float* __restrict__ x, float* __restrict__ out, float lambd, int total_elements) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx < total_elements) {
+        float val = x[idx];
+        out[idx] = (val > lambd || val < -lambd) ? val : 0.0f;
+    }
+}
+
+// MaxPool2d kernel: one thread per output element
+// Supports arbitrary strides via input tensor shape and stride parameters passed as integers (contiguous decomposition)
+// Input assumed to be contiguous in memory; if not, binding should ensure contiguous copy.
+// However, launcher receives raw pointer and strides as int64_t for generality,
+// but for simplicity we assume contiguous in the kernel below; we'll adapt launcher to handle non-contiguous via strides.
+// Actually, to support non-contiguous input as per contract, we can pass full stride array or flatten in binding.
+// Binding will ensure contiguous by calling .contiguous() if needed, so kernel can assume contiguous.
+// Thus kernel uses linear index mapping with regular strides from shape.
+__global__ void max_pool2d_kernel(const float* __restrict__ input, float* __restrict__ output,
+                                  int N, int C, int H_in, int W_in,
+                                  int kernel_h, int kernel_w, int stride_h, int stride_w,
+                                  int pad_h, int pad_w, int H_out, int W_out) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total_outputs = N * C * H_out * W_out;
+    if (idx >= total_outputs) return;
+
+    // Decode linear index to (n,c,h_out,w_out)
+    int w_out = idx % W_out;
+    int tmp = idx / W_out;
+    int h_out = tmp % H_out;
+    tmp /= H_out;
+    int c = tmp % C;
+    int n = tmp / C;
+
+    int h_start = h_out * stride_h - pad_h;
+    int w_start = w_out * stride_w - pad_w;
+    float max_val = -3.402823466e+38f; // -FLT_MAX
+
+    for (int kh = 0; kh < kernel_h; ++kh) {
+        int h_in = h_start + kh;
+        if (h_in < 0 || h_in >= H_in) continue;
+        for (int kw = 0; kw < kernel_w; ++kw) {
+            int w_in = w_start + kw;
+            if (w_in < 0 || w_in >= W_in) continue;
+            int input_idx = ((n * C + c) * H_in + h_in) * W_in + w_in;
+            float val = input[input_idx];
+            if (val > max_val) max_val = val;
+        }
+    }
+    output[idx] = max_val;
+}
+
+// Launcher for hard shrink
+extern "C" void hardshrink_launcher(float* x, float lambd, int total_elements, cudaStream_t stream) {
+    const int block_size = 256;
+    int grid_size = (total_elements + block_size - 1) / block_size;
+    hardshrink_kernel<<<grid_size, block_size, 0, stream>>>(x, x, lambd, total_elements);
+}
+
+// Launcher for max pool 2D
+extern "C" void max_pool2d_launcher(const float* x, float* out,
+                                    int N, int C, int H_in, int W_in,
+                                    int kernel_h, int kernel_w, int stride_h, int stride_w,
+                                    int pad_h, int pad_w, int H_out, int W_out,
+                                    cudaStream_t stream) {
+    int total_outputs = N * C * H_out * W_out;
+    const int block_size = 256;
+    int grid_size = (total_outputs + block_size - 1) / block_size;
+    max_pool2d_kernel<<<grid_size, block_size, 0, stream>>>(
+        x, out, N, C, H_in, W_in, kernel_h, kernel_w,
+        stride_h, stride_w, pad_h, pad_w, H_out, W_out);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,95 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void hardshrink_launcher(float* x, float lambd, int total_elements, cudaStream_t stream);
+extern "C" void max_pool2d_launcher(const float* x, float* out,
+                                    int N, int C, int H_in, int W_in,
+                                    int kernel_h, int kernel_w, int stride_h, int stride_w,
+                                    int pad_h, int pad_w, int H_out, int W_out,
+                                    cudaStream_t stream);
+
+// Hardshrink forward wrapper
+torch::Tensor hardshrink_forward(torch::Tensor x, double lambd) {
+    TORCH_CHECK(x.is_cuda(), "Input tensor must be on CUDA device");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input tensor must be float32");
+    TORCH_CHECK(x.numel() > 0, "Input tensor must not be empty");
+    
+    // Ensure contiguous; if not, make a copy
+    if (!x.is_contiguous()) {
+        x = x.contiguous();
+    }
+    
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    
+    // Call launcher (in-place operation on x)
+    hardshrink_launcher(x.data_ptr<float>(), static_cast<float>(lambd), x.numel(), stream);
+    
+    // Check for kernel launch errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA error in hardshrink_launcher: ", cudaGetErrorString(err));
+    
+    return x;
+}
+
+// MaxPool2d forward wrapper
+torch::Tensor max_pool2d_forward(torch::Tensor x, int64_t kernel_size, int64_t stride, int64_t padding) {
+    TORCH_CHECK(x.is_cuda(), "Input tensor must be on CUDA device");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input tensor must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input tensor must be 4D (N,C,H,W)");
+    TORCH_CHECK(x.size(0) > 0 && x.size(1) > 0 && x.size(2) > 0 && x.size(3) > 0, "Input dimensions must be positive");
+    TORCH_CHECK(kernel_size > 0, "kernel_size must be positive");
+    TORCH_CHECK(stride > 0, "stride must be positive");
+    TORCH_CHECK(padding >= 0, "padding must be non-negative");
+    
+    // Contiguous check (launcher assumes contiguous input)
+    if (!x.is_contiguous()) {
+        x = x.contiguous();
+    }
+    
+    int N = x.size(0);
+    int C = x.size(1);
+    int H_in = x.size(2);
+    int W_in = x.size(3);
+    int H_out = (H_in + 2 * padding - kernel_size) / stride + 1;
+    int W_out = (W_in + 2 * padding - kernel_size) / stride + 1;
+    
+    TORCH_CHECK(H_out > 0 && W_out > 0, "Output dimensions must be positive");
+    
+    // Allocate output tensor
+    auto output = torch::empty({N, C, H_out, W_out}, x.options());
+    
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    
+    // Call launcher
+    max_pool2d_launcher(x.data_ptr<float>(), output.data_ptr<float>(),
+                        N, C, H_in, W_in,
+                        static_cast<int>(kernel_size), static_cast<int>(kernel_size),
+                        static_cast<int>(stride), static_cast<int>(stride),
+                        static_cast<int>(padding), static_cast<int>(padding),
+                        H_out, W_out,
+                        stream);
+    
+    // Check for kernel launch errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA error in max_pool2d_launcher: ", cudaGetErrorString(err));
+    
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("hardshrink_forward", &hardshrink_forward,
+          "HardShrink forward (CUDA)",
+          py::arg("x"), py::arg("lambd"));
+    m.def("max_pool2d_forward", &max_pool2d_forward,
+          "MaxPool2d forward (CUDA)",
+          py::arg("x"), py::arg("kernel_size"), py::arg("stride"), py::arg("padding"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,31 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, out_channels, kernel_size, stride, padding, hard_shrink_lambd):
+        super().__init__()
+        self.hard_shrink_lambd = hard_shrink_lambd
+        # 未使用 out_channels，但保留参数以保持签名一致
+        # 不创建 nn.MaxPool2d 模块，因为池化将通过自定义扩展实现，且 state_dict 需要为空
+        # 存储 kernel_size、stride、padding 供 forward 使用
+        self.kernel_size = kernel_size
+        self.stride = stride
+        self.padding = padding
+
+    def forward(self, x):
+        x = cuda_extension.hardshrink_forward(x, self.hard_shrink_lambd)
+        x = cuda_extension.max_pool2d_forward(
+            x, self.kernel_size, self.stride, self.padding
+        )
+        return x
+
+    def debug_forward(self, x):
+        x_shrink = cuda_extension.hardshrink_forward(x, self.hard_shrink_lambd)
+        yield "step_001", x_shrink
+        x_pool = cuda_extension.max_pool2d_forward(
+            x_shrink, self.kernel_size, self.stride, self.padding
+        )
+        yield "step_002", x_pool
+        yield "step_003", x_pool
