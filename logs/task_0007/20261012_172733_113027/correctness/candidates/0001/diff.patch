+    linear_forward_launcher(
+        output.data_ptr<float>(),
+        input.data_ptr<float>(),
+        weight.data_ptr<float>(),
+        bias.data_ptr<float>(),
+        batch_size, seq_len, in_features, out_features,
+        stream
+    );
+
+    return output;
