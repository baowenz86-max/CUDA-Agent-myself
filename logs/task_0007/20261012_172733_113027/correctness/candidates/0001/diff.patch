+    float* h_partial = new float[blocks];
+    cudaMemcpy(h_partial, d_partial, blocks * sizeof(float), cudaMemcpyDeviceToHost);
+    cudaFree(d_partial);
+    float loss = 0.0f;
+    for (int i = 0; i < blocks; ++i) {
+        loss += h_partial[i];
+    }
+    delete[] h_partial;
+    return loss / (float)numel;
+}
