+torch::Tensor baddbmm_forward(torch::Tensor input, torch::Tensor batch1, torch::Tensor batch2) {
+    TORCH_CHECK(input.is_cuda() && batch1.is_cuda() && batch2.is_cuda(), "all inputs must be CUDA");
