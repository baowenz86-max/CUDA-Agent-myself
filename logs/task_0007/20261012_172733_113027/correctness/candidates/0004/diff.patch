+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    add_pos_enc_launcher(output.data_ptr<float>(), input.data_ptr<float>(), pos_enc.data_ptr<float>(),
+                         B, S, E, stream);
+    return output;
+}
