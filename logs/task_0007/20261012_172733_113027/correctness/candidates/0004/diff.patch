+    TORCH_CHECK(k.sizes() == q_sizes && v.sizes() == q_sizes, "q,k,v shapes must match");
+    TORCH_CHECK(attn_mask.dim() == 2 && attn_mask.size(0) == S && attn_mask.size(1) == S, "attn_mask must be [S,S]");
