cks * sizeof(float), cudaMemcpyDeviceToHost);\n    cudaFree(d_partial);\n    float loss = 0.0f;\n    for (int i = 0; i < blocks; ++i) {\n        loss += h_partial[i];\n    }\n    delete[] h_partial;\n    return loss / (float)numel;\n}\n"
  }
}
