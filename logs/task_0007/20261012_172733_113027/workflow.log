// Binding for scaled_dot_product_attention_forward
// Only float32, contiguous, CUDA tensors supported.

#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>
#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include <pybind11/pybind11.h>
#include "../binding_registry.h"

namespace py = pybind11;

// Declaration of launcher from sdpa_kernel.cu
extern "C" void sdpa_forward_launcher(
    float* output,
    const float* query,
    const float* key,
    const float* value,
    const float* attn_mask,
    int batch_size,
    int seq_len,
    int head_dim,
    cudaStream_t stream
);

torch::Tensor scaled_dot_product_attention_forward(
    torch::Tensor query, torch::Tensor key, torch::Tensor value, torch::Tensor attn_mask) {
    TORCH_CHECK(query.is_cuda(), "query must be a CUDA tensor");
    TORCH_CHECK(key.is_cuda(), "key must be a CUDA tensor");
    TORCH_CHECK(value.is_cuda(), "value must be a CUDA tensor");
    TORCH_CHECK(attn_mask.is_cuda(), "attn_mask must be a CUDA tensor");
    TORCH_CHECK(query.dtype() == torch::kFloat32, "query must be float32");
    TORCH_CHECK(key.dtype() == torch::kFloat32, "key must be float32");
    TORCH_CHECK(value.dtype() == torch::kFloat32, "value must be float32");
    TORCH_CHECK(attn_mask.dtype() == torch::kFloat32, "attn_mask must be float32");
    TORCH_CHECK(query.is_contiguous(), "query must be contiguous");
    TORCH_CHECK(key.is_contiguous(), "key must be contiguous");
    TORCH_CHECK(value.is_contiguous(), "value must be contiguous");
    TORCH_CHECK(attn_mask.is_contiguous(), "attn_mask must be contiguous");
    TORCH_CHECK(query.dim() == 3, "query must be 3D (batch, seq_len, head_dim)");
    TORCH_CHECK(key.dim() == 3, "key must be 3D (batch, seq_len, head_dim)");
    TORCH_CHECK(value.dim() == 3, "value must be 3D (batch, seq_len, head_dim)");
    TORCH_CHECK(attn_mask.dim() == 2, "attn_mask must be 2D (seq_len, seq_len)");
    TORCH_CHECK(query.size(0) == key.size(0) && query.size(0) == value.size(0), "batch size mismatch");
    TORCH_CHECK(query.size(1) == key.size(1) && query.size(1) == value.size(1), "seq_len mismatch");
    TORCH_CHECK(query.size(2) == key.size(2) && query.size(2) == value.size(2), "head_dim mismatch");
    TORCH_CHECK(attn_mask.size(0) == query.size(1) && attn_mask.size(1) == query.size(1), "attn_mask shape mismatch");

    int batch_size = query.size(0);
    int seq_len = query.size(1);
    int head_dim = query.size(2);

    auto output = torch::empty_like(query);

    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
    sdpa_forward_launcher(
        output.data_ptr<float>(),
        query.data_ptr<float>(),
        key.data_ptr<float>(),
        value.data_ptr<float>(),
        attn_mask.data_ptr<float>(),
        batch_size, seq_len, head_dim,
        stream
    );

    return output;
}

void register_sdpa(py::module& m) {
    m.def("scaled_dot_product_attention_forward", &scaled_dot_product_attention_forward,
          "Scaled dot product attention forward",
          py::arg("query"), py::arg("key"), py::arg("value"), py::arg("attn_mask"));
}

REGISTER_BINDING(sdpa, register_sdpa);

===== kernels/sdpa_kernel.cu =====
// Scaled dot-product attention forward: attn = softmax((Q @ K^T) * scale + attn_mask) @ V
// Q: [batch, seq_len_q, head_dim], K: [batch, seq_len_k, head_dim], V: [batch, seq_len_k, head_dim]
// attn_mask: [seq_len_q, seq_len_k] (broadcast over batch) of additive mask, typically upper triangular -inf.
// Output: [batch, seq_len_q, head_dim]
// Only float32, contiguous, CUDA.

#include <cuda_runtime.h>
#include <math.h>

// This implementation uses per-batch processing: each block handles one query position for a given batch, computes attention over all keys, then accumulates weighted V.
// This is not the most efficient for large seq_len but should be correct and reasonably fast given the dimensions (seq_len=1024, head_dim=64).
// To improve performance, we could tile over query positions with shared memory caching of K and V, but for simplicity we start with a straightforward kernel.
// We use one thread per output element (batch, q_idx, head_dim). Each thread computes the full attention row and dot product with V column.

__global__ void sdpa_forward_kernel(
    float* __restrict__ output,
    const float* __restrict__ query,
    const float* __restrict__ key,
    const float* __restrict__ value,
    const float* __restrict__ attn_mask,
    int batch_size,
    int seq_len,
    int head_dim,
    float scale
) {
    int total = batch_size * seq_len * head_dim;
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int stride = blockDim.x * gridDim.x;

    for (int i = idx; i < total; i += stride) {
        int head = i % head_dim;
        int q_idx = (i / head_dim) % seq_len;
        int batch = i / (head_dim * seq_len);

        // Compute attention scores for this query against all keys
        float max_score = -INFINITY;
        float sum_exp = 0.0f;
        float acc = 0.0f;

        // We need to store scores? We can do two passes: first find max, then compute softmax and weighted sum.
        // Since head_dim is small, we can do two passes over keys.
        // First pass: compute max score for numerical stability.
        const float* q_row = query + (batch * seq_len + q_idx) * head_dim;
        for (int k_idx = 0; k_idx < seq_len; ++k_idx) {
            const float* k_row = key + (batch * seq_len + k_idx) * head_dim;
            float score = 0.0f;
            for (int d = 0; d < head_dim; ++d) {
                score += q_row[d] * k_row[d];
            }
            score *= scale;
            // Add mask
            float mask_val = attn_mask[q_idx * seq_len + k_idx]; // mask is [seq_len, seq_len]
            score += mask_val;
            if (score > max_score) max_score = score;
        }

        // Second pass: compute softmax and weighted sum with V
        for (int k_idx = 0; k_idx < seq_len; ++k_idx) {
            const float* k_row = key + (batch * seq_len + k_idx) * head_dim;
            float score = 0.0f;
            for (int d = 0; d < head_dim; ++d) {
                score += q_row[d] * k_row[d];
            }
            score = (score * scale) + attn_mask[q_idx * seq_len + k_idx];
            float exp_score = expf(score - max_score);
            sum_exp += exp_score;
            const float* v_row = value + (batch * seq_len + k_idx) * head_dim;
            acc += exp_score * v_row[head];
        }

        output[i] = acc / sum_exp;
    }
}

extern "C" void sdpa_forward_launcher(
    float* output,
    const float* query,
    const float* key,
    const float* value,
    const float* attn_mask,
    int batch_size,
    int seq_len,
    int head_dim,
    cudaStream_t stream
) {
    float scale = rsqrtf((float)head_dim); // 1/sqrt(head_dim)
    int total = batch_size * seq_len * head_dim;
    int threads = 256;
    int blocks = (total + threads - 1) / threads;
    sdpa_forward_kernel<<<blocks, threads, 0, stream>>>(
        output, query, key, value, attn_mask, batch_size, seq_len, head_dim, scale);
}


