import torch
import torch.nn as nn
import cuda_extension


class ModelNew(nn.Module):
    def __init__(self, embed_dim, num_heads, bias, pos_dim):
        super().__init__()
        self.embed_dim = embed_dim
        self.num_heads = num_heads
        self.bias = bias
        # 参数初始化与参考一致，保证 state_dict 键
        self.W_q_weight = nn.Parameter(torch.empty(embed_dim, embed_dim))
        self.W_q_bias = nn.Parameter(torch.empty(embed_dim)) if bias else None
        self.W_k_weight = nn.Parameter(torch.empty(embed_dim, embed_dim))
        self.W_k_bias = nn.Parameter(torch.empty(embed_dim)) if bias else None
        self.W_v_weight = nn.Parameter(torch.empty(embed_dim, embed_dim))
        self.W_v_bias = nn.Parameter(torch.empty(embed_dim)) if bias else None
        self.pos_enc = nn.Parameter(torch.empty(1, pos_dim, embed_dim))
        # 初始化以匹配参考模型（参考使用默认初始化，即 kaiming_uniform 等）
        # 为保持完全一致，这里使用与 nn.Linear 相同的初始化
        self.reset_parameters()

    def reset_parameters(self):
        # 模拟 nn.Linear 的默认初始化
        nn.init.kaiming_uniform_(self.W_q_weight, a=math.sqrt(5))
        if self.bias:
            fan_in, _ = nn.init._calculate_fan_in_and_fan_out(self.W_q_weight)
            bound = 1 / math.sqrt(fan_in) if fan_in > 0 else 0
            nn.init.uniform_(self.W_q_bias, -bound, bound)
        nn.init.kaiming_uniform_(self.W_k_weight, a=math.sqrt(5))
        if self.bias:
            fan_in, _ = nn.init._calculate_fan_in_and_fan_out(self.W_k_weight)
            bound = 1 / math.sqrt(fan_in) if fan_in > 0 else 0
            nn.init.uniform_(self.W_k_bias, -bound, bound)
        nn.init.kaiming_uniform_(self.W_v_weight, a=math.sqrt(5))
        if self.bias:
            fan_in, _ = nn.init._calculate_fan_in_and_fan_out(self.W_v_weight)
            bound = 1 / math.sqrt(fan_in) if fan_in > 0 else 0
            nn.init.uniform_(self.W_v_bias, -bound, bound)
        nn.init.normal_(self.pos_enc, mean=0.0, std=1.0)

    def forward(self, query, key, value, attn_mask, target):
        # 线性投影 q, k, v
        q = cuda_extension.linear_forward(query, self.W_q_weight, self.W_q_bias)
        k = cuda_extension.linear_forward(key, self.W_k_weight, self.W_k_bias)
        v = cuda_extension.linear_forward(value, self.W_v_weight, self.W_v_bias)

        # 添加位置编码
        q = cuda_extension.add_pos_enc(q, self.pos_enc)
        k = cuda_extension.add_pos_enc(k, self.pos_enc)
        v = cuda_extension.add_pos_enc(v, self.pos_enc)

        # 注意力
        attn_output = cuda_extension.scaled_dot_product_attention_forward(q, k, v, attn_mask)

        # logits = baddbmm(zeros_like(target), attn_output, attn_output^T)
        logits = cuda_extension.baddbmm_forward(torch.zeros_like(target), attn_output, attn_output.transpose(-2, -1))

        # 损失
        loss = cuda_extension.bce_with_logits_loss(logits, target)
        return loss

    def debug_forward(self, query, key, value, attn_mask, target):
        # 逐步计算并 yield 每个 checkpoint
        q = cuda_extension.linear_forward(query, self.W_q_weight, self.W_q_bias)
        q = cuda_extension.add_pos_enc(q, self.pos_enc)
        yield "step_001", q

        k = cuda_extension.linear_forward(key, self.W_k_weight, self.W_k_bias)
        k = cuda_extension.add_pos_enc(k, self.pos_enc)
        yield "step_002", k

        v = cuda_extension.linear_forward(value, self.W_v_weight, self.W_v_bias)
        v = cuda_extension.add_pos_enc(v, self.pos_enc)
        yield "step_003", v

        attn_output = cuda_extension.scaled_dot_product_attention_forward(q, k, v, attn_mask)
        yield "step_004", attn_output

        logits = cuda_extension.baddbmm_forward(torch.zeros_like(target), attn_output, attn_output.transpose(-2, -1))
        yield "step_005", logits

        loss = cuda_extension.bce_with_logits_loss(logits, target)
        yield "step_006", loss

        yield "step_007", loss

    # 为了保持 state_dict 的键与参考一致，注册子模块名称
    # 参考中 self.W_q = nn.Linear(...)，其参数为 W_q.weight 和 W_q.bias
