    sum_k += k_val * wk[e * E + tid];\n            sum_v += v_val * wv[e * E + tid];\n        }\n\n        q_out[idx] = sum_q + pe;\n        k_out[idx] = sum_k + pe;\n        v_out[idx] = sum_v + pe;\n    }\n}\n\n// ============================================================================\n// Scaled Dot-Product Attention (SDPA) Kernel\n// Computes: out = softmax(QK^T / sqrt(E) + mask) V\n// Q, K, V: [B, T, E], mask: [T, T] (broadcast over batch)\n// Output: [B, T, E]\n// ============================================================================\ntemplate<int BLOCK_SIZE>\n__global__ void sdpa_forward_kernel(\n    const float* __restrict__ q,\n    const float* __restrict__ k,\n    const float* __restrict__ v,\n    const float* __restrict__ mask,\n    int B, int T, int E,\n    float* __restrict__ out\n) {\n    // Each block computes one attention row (batch, row)\n    int batch = blockIdx.x;\n    int row = blockIdx.y;\n    int tid = threadIdx.x;\n\n    if (batch >= B || row >= T) return;\n\n    // Load q row into shared memory\n    extern __shared__ float smem[];\n    float* s_q = smem;              // [E]\n    float* s_k = &s_q[E];           // [E]\n    float* s_v = &s_k[E];           // [E] (will be placed after s_k)\n\n    for (int e = tid; e < E; e += BLOCK_SIZE) {\n        s_q[e] = q[(batch * T + row) * E + e];\n    }\n    __syncthreads();\n\n    // Initialize accumulator for output elements (each thread handles one element if tid < E)\n    float acc = 0.0f;\n    float max_score = -FLT_MAX;\n    float sum_exp = 0.0f;\n\n    for (int j = 0; j < T; ++j) {\n        // Load K_j and V_j into shared memory\n        for (int e = tid; e < E; e += BLOCK_SIZE) {\n            s_k[e] = k[(batch * T + j) * E + e];\n            s_v[e] = v[(batch * T + j) * E + e];\n        }\n        __syncthreads();\n\n        // Compute dot product Q·K_j (all threads participate)\n        float dot = 0.0f;\n        for (int e = 0; e < E; ++e) {\n            dot += s_q[e] * s_k[e];\n        }\n        dot /= sqrtf((float)E);\n\n        // Add mask if provided (broadcast over batch)\n        if (mask != nullptr) {\n            dot += mask[row * T + j];\n        }\n\n        // Online softmax update\n        float new_max = fmaxf(max_score, dot);\n        float correction = __expf(max_score - new_max);\n        sum_exp = sum_exp * correction + __expf(dot - new_max);\n        max_score = new_max;\n\n        // Accumulate V_j * exp(dot - max_score) for this thread's output element\n        float weight = __expf(dot - max_score);\n        if (tid < E) {\n            acc = acc * correction + weight * s_v[tid];\n        }\n        __syncthreads();\n    }\n\n    // Normalize and write out\n    if (tid < E) {\n        out[(batch * T + row) * E + tid] = acc / sum_exp;\n    }\n}\n\n// ============================================================================\n// Attention Output Times Its Transpose (baddbmm with beta=0)\n// Computes: logits = attn_output @ attn_output^T, [B, T, E] -> [B, T, T]\n// ============================================================================\ntemplate<int BLOCK_SIZE>\n__global__ void attn_bias_baddbmm_kernel(\n    const float* __restrict__ attn_output,\n    int B, int T, int E,\n    float* __restrict__ logits\n) {\n    int batch = blockIdx.x;\n    int row = blockIdx.y;\n    int col = blockIdx.z;\n\n    if (batch >= B || row >= T || col >= T) return;\n\n    int tid = threadIdx.x;\n\n    // One block computes one output element (row, col) by summing over E\n    float sum = 0.0f;\n    for (int e = tid; e < E; e += BLOCK_SIZE) {\n        sum += attn_output[(batch * T + row) * E + e] *\n               attn_output[(batch * T + col) * E + e];\n    }\n\n    // Reduce within block\n    __shared__ float s_partials[BLOCK_SIZE];\n    s_partials[tid] = sum;\n    __syncthreads();\n\n    for (int offset = BLOCK_SIZE / 2; offset > 0; offset >>= 1) {\n        if (tid < offset) {\n            s_partials[tid] += s_partials[tid + offset];\n        }\n        __syncthreads();\n    }\n\n    if (tid == 0) {\n        logits[(batch * T + row) * T + col] = s_partials[0];\n    }\n}\n\n// ============================================================================\n// BCE With Logits Loss Kernel\n// Computes: loss = mean over all elements of max(x,0) - x*y + log(1+exp(-|x|))\n// ============================================================================\ntemplate<int BLOCK_SIZE>\n__global__ void bce_with_logits_kernel(\n    const float* __restrict__ logits,\n    const float* __restrict__ target,\n    int B, int T,\n    float* __restrict__ loss\n) {\n    int N = B * T * T;\n    int i = blockIdx.x * blockDim.x + threadIdx.x;\n    float sum = 0.0f;\n\n    for (int idx = i; idx < N; idx += gridDim.x * blockDim.x) {\n        float x = logits[idx];\n        float y = target[idx];\n        // Stable BCE with logits: max(x,0) - x*y + log(1+exp(-abs(x)))\n        float loss_val = fmaxf(x, 0.0f) - x * y + log1pf(expf(-fabsf(x)));\n        sum += loss_val;\n    }\n\n    // Block reduction\n    __shared__ float s_partials[BLOCK_SIZE];\n    int tid = threadIdx.x;\n    s_partials[tid] = sum;\n    __syncthreads();\n\n    for (int offset = blockDim.x / 2; offset > 0; offset >>= 1) {\n        if (tid < offset) {\n            s_partials[tid] += s_partials[tid + offset];\n        }\n        __syncthreads();\n    }\n\n    if (tid == 0) {\n        atomicAdd(loss, s_partials[0] / N);\n    }\n}\n\n// ============================================================================\n// Launcher functions (extern \"C\")\n// ============================================================================\nextern \"C\" void qkv_proj_pos_launcher(\n    const float* query,\n    const float* key,\n    const float* value,\n    const float* pos_enc,\n    const float* wq,\n    const float* wk,\n    const float* wv,\n    const float* bq,\n    const float* bk,\n    const float* bv,\n    int B,\n    int T,\n    int E,\n    int P,\n    float* q_out,\n    float* k_out,\n    float* v_out,\n    cudaStream_t stream\n) {\n    dim3 blocks(B, T);\n    int threads = 64; // E=64, use 64 threads\n    qkv_proj_pos_kernel<64><<<blocks, threads, 0, stream>>>(\n        query, key, value, pos_enc, wq, wk, wv, bq, bk, bv,\n        B, T, E, P, q_out, k_out, v_out\n    );\n}\n\nextern \"C\" void sdpa_forward_launcher(\n    const float* q,\n    const float* k,\n    const float* v,\n    const float* mask,\n    int B,\n    int T,\n    int E,\n    float* out,\n    cudaStream_t stream\n) {\n    // Use one block per (batch, row), 64 threads\n    dim3 blocks(B, T);\n    int threads = 64;\n    int shared_mem = 3 * E * sizeof(float); // q, k, v in shared\n    sdpa_forward_kernel<64><<<blocks, threads, shared_mem, stream>>>(\n        q, k, v, mask, B, T, E, out\n    );\n}\n\nextern \"C\" void attn_bias_baddbmm_launcher(\n    const float* attn_output,\n    int B,\n    int T,\n    int E,\n    float* logits,\n    cudaStream_t stream\n) {\n    // One block per output element, 64 threads\n    dim3 blocks(B, T, T);\n    int threads = 64;\n    attn_bias_baddbmm_kernel<64><<<blocks, threads, 0, stream>>>(\n        attn_output, B, T, E, logits\n    );\n}\n\nextern \"C\" void bce_with_logits_launcher(\n    const float* logits,\n    const float* target,\n    int B,\n    int T,\n    float* loss,\n    cudaStream_t stream\n) {\n    int threads = 256;\n    int blocks = (B * T * T + threads - 1) / threads;\n    // Initialize loss to 0 before reduction\n    cudaMemsetAsync(loss, 0, sizeof(float), stream);\n    bce_with_logits_kernel<256><<<blocks, threads, 0, stream>>>(\n        logits, target, B, T, loss\n    );\n}\n",
    "kernels/attention_kernels_binding.cpp": "#include <torch/types.h>\n#include <torch/csrc/utils/pybind.h>\n\n#include <cuda_runtime.h>\n#include <c10/cuda/CUDAStream.h>\n#include \"../binding_registry.h\"\n\n// Launcher declarations from attention_kernels.cu\nextern \"C\" void qkv_proj_pos_launcher(\n    const float* query,\n    const float* key,\n    const float* value,\n    const float* pos_enc,\n    const float* wq,\n    const float* wk,\n    const float* wv,\n    const float* bq,\n    const float* bk,\n    const float* bv,\n    int B,\n    int T,\n    int E,\n    int P,\n    float* q_out,\n    float* k_out,\n    float* v_out,\n    cudaStream_t stream\n);\n\nextern \"C\" void sdpa_forward_launcher(\n    const float* q,\n    const float* k,\n    const float* v,\n    const float* mask,\n    int B,\n    int T,\n    int E,\n    float* out,\n    cudaStream_t stream\n);\n\nextern \"C\" void attn_bias_baddbmm_launcher(\n    const float* attn_output,\n    int B,\n    int T,\n    int E,\n    float* logits,\n    cudaStream_t stream\n);\n\nextern \"C\" void bce_with_logits_launcher(\n    const float* logits,\n    const float* target,\n    int B,\n    int T,\n    float* loss,\n    cudaStream_t stream\n);\n\n// Helper to check common tensor requirements\nstatic void check_cuda_float32_contiguous(const torch::Tensor& t, const char* name) {\n    TORCH_CHECK(t.is_cuda(), name, \" must be a CUDA tensor\");\n    TORCH_CHECK(t.dtype() == torch::kFloat32, name, \" must be float32\");\n    TORCH_CHECK(t.is_contiguous(), name, \" must be contiguous\");\n}\n\npy::tuple qkv_proj_pos_forward(\n    torch::Tensor query,\n    torch::Tensor key,\n    torch::Tensor value,\n    torch::Tensor pos_enc,\n    torch::Tensor wq,\n    torch::Tensor wk,\n    torch::Tensor wv,\n    c10::optional<torch::Tensor> bq,\n    c10::optional<torch::Tensor> bk,\n    c10::optional<torch::Tensor> bv\n) {\n    // Validate inputs\n    check_cuda_float32_contiguous(query, \"query\");\n    check_cuda_float32_contiguous(key, \"key\");\n    check_cuda_float32_contiguous(value, \"value\");\n    check_cuda_float32_contiguous(pos_enc, \"pos_enc\");\n    check_cuda_float32_contiguous(wq, \"wq\");\n    check_cuda_float32_contiguous(wk, \"wk\");\n    check_cuda_float32_contiguous(wv, \"wv\");\n\n    TORCH_CHECK(query.dim() == 3, \"query must be 3D [B, T, E]\");\n    TORCH_CHECK(key.dim() == 3, \"key must be 3D [B, T, E]\");\n    TORCH_CHECK(value.dim() == 3, \"value must be 3D [B, T, E]\");\n    TORCH_CHECK(pos_enc.dim() == 3, \"pos_enc must be 3D [1, P, E]\");\n    TORCH_CHECK(wq.dim() == 2, \"wq must be 2D [E, E]\");\n    TORCH_CHECK(wk.dim() == 2, \"wk must be 2D [E, E]\");\n    TORCH_CHECK(wv.dim() == 2, \"wv must be 2D [E, E]\");\n\n    int B = query.size(0);\n    int T = query.size(1);\n    int E = query.size(2);\n    int P = pos_enc.size(1);\n\n    TORCH_CHECK(key.size(0) == B && key.size(1) == T && key.size(2) == E, \"key shape mismatch\");\n    TORCH_CHECK(value.size(0) == B && value.size(1) == T && value.size(2) == E, \"value shape mismatch\");\n    TORCH_CHECK(pos_enc.size(0) == 1 && pos_enc.size(1) == P && pos_enc.size(2) == E, \"pos_enc shape must be [1, P, E]\");\n    TORCH_CHECK(P >= T, \"pos_enc length P must be >= T\");\n    TORCH_CHECK(wq.size(0) == E && wq.size(1) == E, \"wq shape must be [E, E]\");\n    TORCH_CHECK(wk.size(0) == E && wk.size(1) == E, \"wk shape must be [E, E]\");\n    TORCH_CHECK(wv.size(0) == E && wv.size(1) == E, \"wv shape must be [E, E]\");\n\n    // Optional bias validation\n    const float* bq_ptr = nullptr;\n    const float* bk_ptr = nullptr;\n    const float* bv_ptr = nullptr;\n    if (bq.has_value()) {\n        auto bias = bq.value();\n        check_cuda_float32_contiguous(bias, \"bq\");\n        TORCH_CHECK(bias.dim() == 1 && bias.size(0) == E, \"bq must be 1D [E]\");\n        bq_ptr = bias.data_ptr<float>();\n    }\n    if (bk.has_value()) {\n        auto bias = bk.value();\n        check_cuda_float32_contiguous(bias, \"bk\");\n        TORCH_CHECK(bias.dim() == 1 && bias.size(0) == E, \"bk must be 1D [E]\");\n        bk_ptr = bias.data_ptr<float>();\n    }\n    if (bv.has_value()) {\n        auto bias = bv.value();\n        check_cuda_float32_contiguous(bias, \"bv\");\n        TORCH_CHECK(bias.dim() == 1 && bias.size(0) == E, \"bv must be 1D [E]\");\n        bv_ptr = bias.data_ptr<float>();\n    }\n\n    // Allocate outputs\n    auto q_out = torch::empty({B, T, E}, query.options());\n    auto k_out = torch::empty({B, T, E}, query.options());\n    auto v_out = torch::empty({B, T, E}, query.options());\n\n    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n\n    qkv_proj_pos_launcher(\n        query.data_ptr<float>(),\n        key.data_ptr<float>(),\n        value.data_ptr<float>(),\n        pos_enc.data_ptr<float>(),\n        wq.data_ptr<float>(),\n        wk.data_ptr<float>(),\n        wv.data_ptr<float>(),\n        bq_ptr,\n        bk_ptr,\n        bv_ptr,\n        B, T, E, P,\n        q_out.data_ptr<float>(),\n        k_out.data_ptr<float>(),\n        v_out.data_ptr<float>(),\n        stream\n    );\n\n    return py::make_tuple(q_out, k_out, v_out);\n}\n\ntorch::Tensor sdpa_forward(\n    torch::Tensor q,\n    torch::Tensor k,\n    torch::Tensor v,\n    torch::Tensor mask\n) {\n    check_cuda_float32_contiguous(q, \"q\");\n    check_cuda_float32_contiguous(k, \"k\");\n    check_cuda_float32_contiguous(v, \"v\");\n    check_cuda_float32_contiguous(mask, \"mask\");\n\n    TORCH_CHECK(q.dim() == 3, \"q must be 3D [B, T, E]\");\n    TORCH_CHECK(k.dim() == 3, \"k must be 3D [B, T, E]\");\n    TORCH_CHECK(v.dim() == 3, \"v must be 3D [B, T, E]\");\n    TORCH_CHECK(mask.dim() == 2, \"mask must be 2D [T, T]\");\n\n    int B = q.size(0);\n    int T = q.size(1);\n    int E = q.size(2);\n    TORCH_CHECK(k.size(0) == B && k.size(1) == T && k.size(2) == E, \"k shape mismatch\");\n    TORCH_CHECK(v.size(0) == B && v.size(1) == T && v.size(2) == E, \"v shape mismatch\");\n    TORCH_CHECK(mask.size(0) == T && mask.size(1) == T, \"mask shape must be [T, T]\");\n\n    auto out = torch::empty({B, T, E}, q.options());\n    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n\n    sdpa_forward_launcher(\n        q.data_ptr<float>(),\n        k.data_ptr<float>(),\n        v.data_ptr<float>(),\n        mask.data_ptr<float>(),\n        B, T, E,\n        out.data_ptr<float>(),\n        stream\n    );\n\n    return out;\n}\n\ntorch::Tensor attn_bias_baddbmm_forward(torch::Tensor attn_output) {\n    check_cuda_float32_contiguous(attn_output, \"attn_output\");\n    TORCH_CHECK(attn_output.dim() == 3, \"attn_output must be 3D [B, T, E]\");\n\n    int B = attn_output.size(0);\n    int T = attn_output.size(1);\n    int E = attn_output.size(2);\n\n    auto logits = torch::empty({B, T, T}, attn_output.options());\n    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n\n    attn_bias_baddbmm_launcher(\n        attn_output.data_ptr<float>(),\n        B, T, E,\n        logits.data_ptr<float>(),\n        stream\n    );\n\n    return logits;\n}\n\ntorch::Tensor bce_with_logits_forward(\n    torch::Tensor logits,\n    torch::Tensor target\n) {\n    check_cuda_float32_contiguous(logits, \"logits\");\n    check_cuda_float32_contiguous(target, \"target\");\n\n    TORCH_CHECK(logits.dim() == 3, \"logits must be 3D [B, T, T]\");\n    TORCH_CHECK(target.dim() == 3, \"target must be 3D [B, T, T]\");\n    TORCH_CHECK(logits.size(0) == target.size(0) &&\n                logits.size(1) == target.size(1) &&\n                logits.size(2) == target.size(2),\n                \"logits and target shape mismatch\");\n\n    int B = logits.size(0);\n    int T = logits.size(1);\n\n    // Allocate scalar loss output; we'll return a 0-dim tensor\n    auto loss = torch::empty({}, logits.options());\n    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n\n    bce_with_logits_launcher(\n        logits.data_ptr<float>(),\n        target.data_ptr<float>(),\n        B, T,\n        loss.data_ptr<float>(),\n        stream\n    );\n\n    return loss;\n}\n\nvoid register_attention_kernels(pybind11::module& m) {\n    m.def(\"qkv_proj_pos\", &qkv_proj_pos_forward,\n          \"Project QKV with linear layers and add positional encoding\",\n          py::arg(\"query\"),\n          py::arg(\"key\"),\n          py::arg(\"value\"),\n          py::arg(\"pos_enc\"),\n          py::arg(\"wq\"),\n          py::arg(\"wk\"),\n          py::arg(\"wv\"),\n          py::arg(\"bq\") = py::none(),\n          py::arg(\"bk\") = py::none(),\n          py::arg(\"bv\") = py::none());\n    m.def(\"sdpa\", &sdpa_forward,\n          \"Scaled Dot-Product Attention\",\n          py::arg(\"q\"), py::arg(\"k\"), py::arg(\"v\"), py::arg(\"mask\"));\n    m.def(\"attn_bias_baddbmm\", &attn_bias_baddbmm_forward,\n          \"Compute logits = attn_output @ attn_output^T (baddbmm with zero beta)\",\n          py::arg(\"attn_output\"));\n    m.def(\"bce_with_logits\", &bce_with_logits_forward,\n          \"Binary Cross-Entropy with logits loss\",\n          py::arg(\"logits\"), py::arg(\"target\"));\n}\n\nREGISTER_BINDING(attention_kernels, register_attention_kernels);\n",
    "model_new.py": "import torch\nimport torch.nn as nn\nimport cuda_extension\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, embed_dim, num_heads, bias, pos_dim):\n        super().__init__()\n        self.embed_dim = embed_dim\n        self.num_heads = num_heads\n        self.bias = bias\n        self.pos_dim = pos_dim\n        self.W_q = nn.Linear(embed_dim, embed_dim, bias=bias)\n        self.W_k = nn.Linear(embed_dim, embed_dim, bias=bias)\n        self.W_v = nn.Linear(embed_dim, embed_dim, bias=bias)\n        self.bce_loss = nn.BCEWithLogitsLoss()\n        self.pos_enc = nn.Parameter(torch.randn(1, pos_dim, embed_dim))\n\n    def forward(self, query, key, value, attn_mask, target):\n        # Ensure inputs are contiguous and on CUDA (custom ops assume this)\n        query = query.contiguous()\n        key = key.contiguous()\n        value = value.contiguous()\n        attn_mask = attn_mask.contiguous()\n        target = target.contiguous()\n\n        # Custom ops\n        qkv = cuda_extension.qkv_proj_pos(\n            query, key, value, self.pos_enc,\n            self.W_q.weight, self.W_k.weight, self.W_v.weight,\n            self.W_q.bias if self.bias else None,\n            self.W_k.bias if self.bias else None,\n            self.W_v.bias if self.bias else None\n        )\n        q, k, v = qkv  # each [B, T, E]\n\n        attn_output = cuda_extension.sdpa(q, k, v, attn_mask)\n\n        logits = cuda_extension.attn_bias_baddbmm(attn_output)\n\n        loss = cuda_extension.bce_with_logits(logits, target)\n        return loss\n"
  }
