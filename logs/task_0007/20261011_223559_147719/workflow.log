    const float* query,
    const float* key,
    const float* value,
    const float* pos_enc,
    const float* wq,
    const float* wk,
    const float* wv,
    const float* bq,
    const float* bk,
    const float* bv,
    int B,
    int T,
    int E,
    int P,
    float* q_out,
    float* k_out,
    float* v_out,
    cudaStream_t stream
);

extern "C" void sdpa_forward_launcher(
    const float* q,
    const float* k,
    const float* v,
    const float* mask,
    int B,
    int T,
    int E,
    float* out,
    cudaStream_t stream
