          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference step",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "对应参考语句 x = torch.digamma(x)",
        "对输入张量的每个元素计算 digamma 函数（gamma 函数的对数导数）",
        "保持输入 shape、dtype、device；支持 strides 输入，逐元素计算"
      ]
    },
    {
      "name": "triu_forward",
