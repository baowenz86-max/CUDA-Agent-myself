          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "对应参考语句 x = torch.triu(x)，默认 diagonal=0",
        "保留方阵/矩阵上三角部分（包括主对角线），下三角部分置为零",
        "输入为二维张量，输出同样形状、dtype、device；支持 strides 输入"
      ]
    }
