--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,106 @@
+#include <cuda_runtime.h>
+#include <cmath>
+
+// Exact GELU: 0.5 * x * (1 + erf(x / sqrt(2)))
+__global__ void gelu_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    int64_t total_elements,
+    int ndim,
+    const int64_t* __restrict__ sizes,
+    const int64_t* __restrict__ input_strides,
+    const int64_t* __restrict__ output_strides)
+{
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)blockDim.x * gridDim.x;
+
+    for (int64_t linear_idx = idx; linear_idx < total_elements; linear_idx += stride) {
+        // 将线性索引转换为多维坐标
+        int64_t offset_in = 0;
+        int64_t offset_out = 0;
+        int64_t remaining = linear_idx;
+        for (int dim = ndim - 1; dim >= 0; --dim) {
+            int64_t coord = remaining % sizes[dim];
+            remaining /= sizes[dim];
+            offset_in += coord * input_strides[dim];
+            offset_out += coord * output_strides[dim];
+        }
+
+        float x = input[offset_in];
+        float y = 0.5f * x * (1.0f + erff(x / sqrtf(2.0f)));
+        output[offset_out] = y;
+    }
+}
+
+// SELU: scale * (max(x,0) + min(0, alpha * (exp(x) - 1)))
+__global__ void selu_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    int64_t total_elements,
+    int ndim,
+    const int64_t* __restrict__ sizes,
+    const int64_t* __restrict__ input_strides,
+    const int64_t* __restrict__ output_strides)
+{
+    const float alpha = 1.6732632423543772848170429916717f;
+    const float scale = 1.0507009873554804934193349852946f;
+
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)blockDim.x * gridDim.x;
+
+    for (int64_t linear_idx = idx; linear_idx < total_elements; linear_idx += stride) {
+        int64_t offset_in = 0;
+        int64_t offset_out = 0;
+        int64_t remaining = linear_idx;
+        for (int dim = ndim - 1; dim >= 0; --dim) {
+            int64_t coord = remaining % sizes[dim];
+            remaining /= sizes[dim];
+            offset_in += coord * input_strides[dim];
+            offset_out += coord * output_strides[dim];
+        }
+
+        float x = input[offset_in];
+        float val = x > 0.0f ? x : alpha * (expf(x) - 1.0f);
+        output[offset_out] = scale * val;
+    }
+}
+
+extern "C" void gelu_forward_launcher(
+    float* output,
+    const float* input,
+    int64_t total_elements,
+    int ndim,
+    const int64_t* sizes,
+    const int64_t* input_strides,
+    const int64_t* output_strides,
+    cudaStream_t stream)
+{
+    if (total_elements == 0) return;
+
+    const int block_size = 256;
+    int grid_size = (int)((total_elements + block_size - 1) / block_size);
+    if (grid_size > 65535) grid_size = 65535; // grid-stride loop will handle rest
+
+    gelu_kernel<<<grid_size, block_size, 0, stream>>>(
+        output, input, total_elements, ndim, sizes, input_strides, output_strides);
+}
+
+extern "C" void selu_forward_launcher(
+    float* output,
+    const float* input,
+    int64_t total_elements,
+    int ndim,
+    const int64_t* sizes,
+    const int64_t* input_strides,
+    const int64_t* output_strides,
+    cudaStream_t stream)
+{
+    if (total_elements == 0) return;
+
+    const int block_size = 256;
+    int grid_size = (int)((total_elements + block_size - 1) / block_size);
+    if (grid_size > 65535) grid_size = 65535;
+
+    selu_kernel<<<grid_size, block_size, 0, stream>>>(
+        output, input, total_elements, ndim, sizes, input_strides, output_strides);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,89 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void gelu_forward_launcher(
+    float* output,
+    const float* input,
+    int64_t total_elements,
+    int ndim,
+    const int64_t* sizes,
+    const int64_t* input_strides,
+    const int64_t* output_strides,
+    cudaStream_t stream);
+
+extern "C" void selu_forward_launcher(
+    float* output,
+    const float* input,
+    int64_t total_elements,
+    int ndim,
+    const int64_t* sizes,
+    const int64_t* input_strides,
+    const int64_t* output_strides,
+    cudaStream_t stream);
+
+torch::Tensor gelu_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.numel() > 0, "Input tensor must not be empty");
+
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    int ndim = x.dim();
+    auto sizes = x.sizes();
+    auto input_strides = x.strides();
+    auto output_strides = output.strides();
+
+    gelu_forward_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        x.numel(),
+        ndim,
+        sizes.data(),
+        input_strides.data(),
+        output_strides.data(),
+        stream);
+
+    return output;
+}
+
+torch::Tensor selu_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.numel() > 0, "Input tensor must not be empty");
+
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    int ndim = x.dim();
+    auto sizes = x.sizes();
+    auto input_strides = x.strides();
+    auto output_strides = output.strides();
+
+    selu_forward_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        x.numel(),
+        ndim,
+        sizes.data(),
+        input_strides.data(),
+        output_strides.data(),
+        stream);
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("gelu_forward", &gelu_forward, "GELU forward (exact erf)",
+          py::arg("x"));
+    m.def("selu_forward", &selu_forward, "SELU forward",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,20 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x):
+        x = cuda_extension.gelu_forward(x)
+        x = cuda_extension.selu_forward(x)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.gelu_forward(x)
+        yield ('step_001', x)
+        x = cuda_extension.selu_forward(x)
+        yield ('step_002', x)
+        yield ('step_003', x)
