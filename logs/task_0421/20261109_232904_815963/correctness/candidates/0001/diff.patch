--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,109 @@
+// CUDA kernels and launchers for the custom ops required by model_new.py
+// embedding_forward: look up embeddings from an int64 index tensor
+// bitwise_xor_int64: float32 -> int64 truncation, bitwise XOR with broadcasting, -> float32
+
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// -----------------------------------------------------------------------------
+// embedding_forward
+// -----------------------------------------------------------------------------
+// Each input index maps to a row of the weight tensor.
+// input shape: [batch_size, sequence_length], int64
+// weight shape: [num_embeddings, embedding_dim], float32
+// output shape: [batch_size, sequence_length, embedding_dim], float32, contiguous
+__global__ void embedding_lookup_kernel(
+    const int64_t* __restrict__ input,
+    const float* __restrict__ weight,
+    float* __restrict__ output,
+    int total_indices,
+    int embedding_dim,
+    int64_t num_embeddings) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= total_indices) return;
+
+    int64_t token = input[idx];
+    // PyTorch Embedding without padding: out-of-range indices are undefined, but
+    // avoid illegal memory access by clamping (behavior matches typical undefined read).
+    if (token < 0 || token >= num_embeddings) {
+        token = 0;  // safe fallback, results are not guaranteed for invalid indices
+    }
+
+    const float* src = weight + token * embedding_dim;
+    float* dst = output + (int64_t)idx * embedding_dim;
+    for (int d = 0; d < embedding_dim; ++d) {
+        dst[d] = src[d];
+    }
+}
+
+extern "C" void embedding_forward_launcher(
+    const int64_t* input,
+    const float* weight,
+    float* output,
+    int batch_size,
+    int sequence_length,
+    int embedding_dim,
+    int64_t num_embeddings,
+    cudaStream_t stream) {
+    int total_indices = batch_size * sequence_length;
+    if (total_indices <= 0 || embedding_dim <= 0) {
+        return;
+    }
+
+    const int block_size = 256;
+    int grid_size = (total_indices + block_size - 1) / block_size;
+    embedding_lookup_kernel<<<grid_size, block_size, 0, stream>>>(
+        input, weight, output, total_indices, embedding_dim, num_embeddings);
+}
+
+// -----------------------------------------------------------------------------
+// bitwise_xor_int64
+// -----------------------------------------------------------------------------
+// Both x and y are float32 in memory, but the reference first converts to int64
+// with truncation, then performs bitwise XOR on the int64 bits, then converts
+// back to float32.
+// x shape: [batch_size, sequence_length, embedding_dim]
+// y shape: [sequence_length, embedding_dim]
+// Output shape: [batch_size, sequence_length, embedding_dim]
+__global__ void bitwise_xor_int64_kernel(
+    const float* __restrict__ x,
+    const float* __restrict__ y,
+    float* __restrict__ output,
+    int total_elements,
+    int embedding_dim,
+    int seq_len) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= total_elements) return;
+
+    // Convert x element to int64 via truncation (C-style cast from float to int64
+    // truncates toward zero, matching PyTorch .to(torch.int64)).
+    int64_t xi = static_cast<int64_t>(x[idx]);
+
+    // Compute broadcast index into y: y has shape [seq_len, embedding_dim].
+    // The linear idx in x is (b * seq_len + s) * emb_dim + d.
+    int s = (idx / embedding_dim) % seq_len;
+    int d = idx % embedding_dim;
+    int64_t yi = static_cast<int64_t>(y[s * embedding_dim + d]);
+
+    int64_t res = xi ^ yi;
+    output[idx] = static_cast<float>(res);
+}
+
+extern "C" void bitwise_xor_int64_launcher(
+    const float* x,
+    const float* y,
+    float* output,
+    int batch_size,
+    int sequence_length,
+    int embedding_dim,
+    cudaStream_t stream) {
+    int total_elements = batch_size * sequence_length * embedding_dim;
+    if (total_elements <= 0) {
+        return;
+    }
+
+    const int block_size = 256;
+    int grid_size = (total_elements + block_size - 1) / block_size;
+    bitwise_xor_int64_kernel<<<grid_size, block_size, 0, stream>>>(
+        x, y, output, total_elements, embedding_dim, sequence_length);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,127 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void embedding_forward_launcher(
+    const int64_t* input,
+    const float* weight,
+    float* output,
+    int batch_size,
+    int sequence_length,
+    int embedding_dim,
+    int64_t num_embeddings,
+    cudaStream_t stream);
+
+extern "C" void bitwise_xor_int64_launcher(
+    const float* x,
+    const float* y,
+    float* output,
+    int batch_size,
+    int sequence_length,
+    int embedding_dim,
+    cudaStream_t stream);
+
+// embedding_forward tensor wrapper
+torch::Tensor embedding_forward(torch::Tensor input, torch::Tensor weight) {
+    // Check device
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(weight.is_cuda(), "weight must be a CUDA tensor");
+    // Check dtype
+    TORCH_CHECK(input.dtype() == torch::kInt64, "input must be int64");
+    TORCH_CHECK(weight.dtype() == torch::kFloat32, "weight must be float32");
+    // Check contiguity
+    TORCH_CHECK(input.is_contiguous(), "input must be contiguous");
+    TORCH_CHECK(weight.is_contiguous(), "weight must be contiguous");
+    // Check dimensions
+    TORCH_CHECK(input.dim() == 2, "input must be 2D [batch_size, sequence_length]");
+    TORCH_CHECK(weight.dim() == 2, "weight must be 2D [num_embeddings, embedding_dim]");
+
+    int64_t batch_size = input.size(0);
+    int64_t sequence_length = input.size(1);
+    int64_t num_embeddings = weight.size(0);
+    int64_t embedding_dim = weight.size(1);
+
+    TORCH_CHECK(batch_size > 0 && sequence_length > 0 && num_embeddings > 0 && embedding_dim > 0,
+                "dimensions must be positive");
+
+    // Allocate output tensor [batch_size, sequence_length, embedding_dim]
+    auto output = torch::empty(
+        {batch_size, sequence_length, embedding_dim},
+        input.options().dtype(torch::kFloat32));
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    embedding_forward_launcher(
+        input.data_ptr<int64_t>(),
+        weight.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int>(batch_size),
+        static_cast<int>(sequence_length),
+        static_cast<int>(embedding_dim),
+        num_embeddings,
+        stream
+    );
+
+    return output;
+}
+
+// bitwise_xor_int64 tensor wrapper
+torch::Tensor bitwise_xor_int64(torch::Tensor x, torch::Tensor y) {
+    // Check device
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(y.is_cuda(), "y must be a CUDA tensor");
+    // Check dtype
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(y.dtype() == torch::kFloat32, "y must be float32");
+    // Check contiguity
+    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
+    TORCH_CHECK(y.is_contiguous(), "y must be contiguous");
+    // Check dimensions
+    TORCH_CHECK(x.dim() == 3, "x must be 3D [batch_size, sequence_length, embedding_dim]");
+    TORCH_CHECK(y.dim() == 2, "y must be 2D [sequence_length, embedding_dim]");
+
+    int64_t batch_size = x.size(0);
+    int64_t sequence_length = x.size(1);
+    int64_t embedding_dim = x.size(2);
+
+    TORCH_CHECK(y.size(0) == sequence_length && y.size(1) == embedding_dim,
+                "y shape must match [sequence_length, embedding_dim]");
+    TORCH_CHECK(batch_size > 0 && sequence_length > 0 && embedding_dim > 0,
+                "dimensions must be positive");
+
+    // Allocate output tensor [batch_size, sequence_length, embedding_dim]
+    auto output = torch::empty_like(x);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    bitwise_xor_int64_launcher(
+        x.data_ptr<float>(),
+        y.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int>(batch_size),
+        static_cast<int>(sequence_length),
+        static_cast<int>(embedding_dim),
+        stream
+    );
+
+    return output;
+}
+
+// Register bindings
+void register_custom_ops(pybind11::module& m) {
+    m.def("embedding_forward", &embedding_forward,
+          "Embedding lookup forward",
+          py::arg("input"), py::arg("weight"));
+    m.def("bitwise_xor_int64", &bitwise_xor_int64,
+          "Bitwise XOR int64 forward",
+          py::arg("x"), py::arg("y"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,22 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, num_embeddings, embedding_dim, xor_tensor_shape):
+        super().__init__()
+        self.embedding = nn.Embedding(num_embeddings, embedding_dim)
+        self.xor_tensor = nn.Parameter(torch.randn(xor_tensor_shape))
+
+    def forward(self, x):
+        x = cuda_extension.embedding_forward(x, self.embedding.weight)
+        x = cuda_extension.bitwise_xor_int64(x, self.xor_tensor)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.embedding_forward(x, self.embedding.weight)
+        yield 'step_001', x
+        x = cuda_extension.bitwise_xor_int64(x, self.xor_tensor)
+        yield 'step_002', x
+        yield 'step_003', x
