+#include <cuda_runtime.h>
+
+// Custom embedding lookup: output[b, t, :] = weight[input[b, t], :]
+// input: int64 [B, T], weight: float32 [num_embeddings, E]
+// output: float32 [B, T, E]
+__global__ void embedding_forward_kernel(
+    const int64_t* __restrict__ input,
+    const float* __restrict__ weight,
+    float* __restrict__ output,
+    int64_t total_input_elements,
+    int64_t embedding_dim,
+    int64_t num_embeddings)
+{
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= total_input_elements) return;
+
+    int64_t token = input[idx];
+    // 越界索引在 PyTorch Embedding 中会触发错误，但这里假定有效
+    const float* weight_row = weight + token * embedding_dim;
+    float* out_row = output + idx * embedding_dim;
+
+    for (int64_t e = 0; e < embedding_dim; ++e) {
+        out_row[e] = weight_row[e];
+    }
+}
+
+// Custom gather along dim=1: output[b, i, e] = input[b, index_value, e]
+// input: float32 [B, T, E], index: int64 [B, I, E] (possibly with 0 stride on E or I)
+// output: float32 [B, I, E]
+// dim is fixed to 1, but launcher takes dim for generality (only dim=1 supported)
+__global__ void gather_dim1_forward_kernel(
+    const float* __restrict__ input,
+    const int64_t* __restrict__ index,
+    float* __restrict__ output,
+    int64_t B,
+    int64_t T,
+    int64_t I,
+    int64_t E,
+    int64_t input_stride_b,
+    int64_t input_stride_t,
+    int64_t input_stride_e,
+    int64_t index_stride_b,
+    int64_t index_stride_i,
+    int64_t index_stride_e)
+{
+    int64_t total = B * I * E;
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= total) return;
+
+    // 从线性索引推算 b, i, e
+    int64_t e = idx % E;
+    int64_t tmp = idx / E;
+    int64_t i = tmp % I;
+    int64_t b = tmp / I;
+
+    // 计算 index 和 input 的偏移
+    int64_t index_offset = b * index_stride_b + i * index_stride_i + e * index_stride_e;
+    int64_t selected_t = index[index_offset];
+
+    // 访问 input[b, selected_t, e]
+    int64_t input_offset = b * input_stride_b + selected_t * input_stride_t + e * input_stride_e;
+    output[idx] = input[input_offset];
+}
+
+// Launcher for embedding
+extern "C" void custom_embedding_launcher(
+    const int64_t* input,
+    const float* weight,
+    float* output,
+    int64_t B,
+    int64_t T,
+    int64_t E,
+    int64_t num_embeddings,
+    cudaStream_t stream)
+{
+    int64_t total = B * T;
+    const int64_t block_size = 256;
+    int64_t grid_size = (total + block_size - 1) / block_size;
+    embedding_forward_kernel<<<grid_size, block_size, 0, stream>>>(
+        input, weight, output, total, E, num_embeddings);
+}
+
+// Launcher for gather along dim=1 (generic strides)
+extern "C" void custom_gather_launcher(
+    const float* input,
+    const int64_t* index,
+    float* output,
+    int64_t B,
+    int64_t T,
+    int64_t I,
+    int64_t E,
+    int64_t input_stride_b,
+    int64_t input_stride_t,
+    int64_t input_stride_e,
+    int64_t index_stride_b,
+    int64_t index_stride_i,
+    int64_t index_stride_e,
+    int64_t dim,
+    cudaStream_t stream)
+{
+    // 仅支持 dim == 1
+    if (dim != 1) return; // 实际调用应保证 dim=1
+
+    int64_t total = B * I * E;
+    const int64_t block_size = 256;
+    int64_t grid_size = (total + block_size - 1) / block_size;
+    gather_dim1_forward_kernel<<<grid_size, block_size, 0, stream>>>(
+        input, index, output, B, T, I, E,
+        input_stride_b, input_stride_t, input_stride_e,
+        index_stride_b, index_stride_i, index_stride_e);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,128 @@
+// Custom ops binding for embedding and gather
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Launcher declarations from custom_ops.cu
+extern "C" void custom_embedding_launcher(
+    const int64_t* input,
+    const float* weight,
+    float* output,
+    int64_t B,
+    int64_t T,
+    int64_t E,
+    int64_t num_embeddings,
+    cudaStream_t stream);
+
+extern "C" void custom_gather_launcher(
+    const float* input,
+    const int64_t* index,
+    float* output,
+    int64_t B,
+    int64_t T,
+    int64_t I,
+    int64_t E,
+    int64_t input_stride_b,
+    int64_t input_stride_t,
+    int64_t input_stride_e,
+    int64_t index_stride_b,
+    int64_t index_stride_i,
+    int64_t index_stride_e,
+    int64_t dim,
+    cudaStream_t stream);
+
+// Custom embedding: output[b,t,:] = weight[input[b,t],:]
+torch::Tensor custom_embedding(torch::Tensor input, torch::Tensor weight) {
+    // Check device and dtype
+    TORCH_CHECK(input.is_cuda(), "input must be CUDA tensor");
+    TORCH_CHECK(weight.is_cuda(), "weight must be CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kInt64, "input must be int64");
+    TORCH_CHECK(weight.dtype() == torch::kFloat32, "weight must be float32");
+    TORCH_CHECK(input.is_contiguous(), "input must be contiguous");
+    TORCH_CHECK(weight.is_contiguous(), "weight must be contiguous");
+
+    int64_t B = input.size(0);
+    int64_t T = input.size(1);
+    int64_t num_embeddings = weight.size(0);
+    int64_t E = weight.size(1);
+
+    // Allocate output [B, T, E]
+    auto output = torch::empty({B, T, E}, input.options().dtype(torch::kFloat32));
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_embedding_launcher(
+        input.data_ptr<int64_t>(),
+        weight.data_ptr<float>(),
+        output.data_ptr<float>(),
+        B, T, E, num_embeddings,
+        stream
+    );
+
+    return output;
+}
+
+// Custom gather along dim=1: output[b,i,e] = input[b, index[b,i,e], e]
+torch::Tensor custom_gather(torch::Tensor input, torch::Tensor index, int64_t dim = 1) {
+    // Check device and dtype
+    TORCH_CHECK(input.is_cuda(), "input must be CUDA tensor");
+    TORCH_CHECK(index.is_cuda(), "index must be CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(index.dtype() == torch::kInt64, "index must be int64");
+    TORCH_CHECK(dim == 1, "only dim=1 supported");
+
+    // input must be contiguous (as given by embedding output)
+    TORCH_CHECK(input.is_contiguous(), "input must be contiguous");
+    // index can be strided (from expand), so allow non-contiguous but handle strides.
+    // We need at least 3 dimensions.
+    TORCH_CHECK(input.dim() == 3, "input must be 3D");
+    TORCH_CHECK(index.dim() == 3, "index must be 3D");
+
+    int64_t B = input.size(0);
+    int64_t T = input.size(1);
+    int64_t E = input.size(2);
+    int64_t I = index.size(1);
+
+    // Validate shapes: index size(0) must be B, index size(2) must be E
+    TORCH_CHECK(index.size(0) == B, "index batch dim mismatch");
+    TORCH_CHECK(index.size(2) == E, "index embedding dim mismatch");
+
+    // Allocate output [B, I, E] (contiguous, like gather result)
+    auto output = torch::empty({B, I, E}, input.options());
+
+    // Get strides for input (contiguous)
+    int64_t input_stride_b = input.stride(0);
+    int64_t input_stride_t = input.stride(1);
+    int64_t input_stride_e = input.stride(2);
+
+    // Get strides for index (may be non-contiguous)
+    int64_t index_stride_b = index.stride(0);
+    int64_t index_stride_i = index.stride(1);
+    int64_t index_stride_e = index.stride(2);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_gather_launcher(
+        input.data_ptr<float>(),
+        index.data_ptr<int64_t>(),
+        output.data_ptr<float>(),
+        B, T, I, E,
+        input_stride_b, input_stride_t, input_stride_e,
+        index_stride_b, index_stride_i, index_stride_e,
+        dim,
+        stream
+    );
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_embedding", &custom_embedding, "Custom embedding lookup",
+          py::arg("input"), py::arg("weight"));
+    m.def("custom_gather", &custom_gather, "Custom gather along dim=1",
+          py::arg("input"), py::arg("index"), py::arg("dim") = 1);
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,27 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, num_embeddings, embedding_dim, index_dim):
+        super().__init__()
+        self.embedding = nn.Embedding(num_embeddings, embedding_dim)
+        self.index_dim = index_dim
+
+    def forward(self, x, indices):
+        x = cuda_extension.custom_embedding(x, self.embedding.weight)
+        indices = indices.unsqueeze(-1).expand(-1, -1, x.size(-1))
+        x = cuda_extension.custom_gather(x, indices, 1)
+        return x
+
+    def debug_forward(self, *inputs):
+        x, indices = inputs
+        x = cuda_extension.custom_embedding(x, self.embedding.weight)
+        yield 'step_001', x
+        indices = indices.unsqueeze(-1).expand(-1, -1, x.size(-1))
+        yield 'step_002', indices
+        x = cuda_extension.custom_gather(x, indices, 1)
+        yield 'step_003', x
+        yield 'step_004', x
+        return
