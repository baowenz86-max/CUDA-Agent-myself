{
  "operators": [
    {
      "name": "custom_embedding",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.int64",
          "device": "cuda",
          "shape": "[B, T]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[num_embeddings, E]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[B, T, E]"
      },
      "semantics": [
        "等价于 torch.nn.functional.embedding(input, weight)，无 padding_idx、无 scale_grad_by_freq、无 sparse。",
        "对于 input 中每个 int64 索引 idx，output[b,t,:] = weight[idx,:]，越界索引行为由嵌入层决定（通常报错或未定义，这里参考实现 nn.Embedding 默认无 padding_idx，验证输入均在有效范围内）。",
        "输出 shape [B,T,E]，其中 B,T 为 input 形状，E 为 weight 的第二维。"
      ]
    },
    {
      "name": "custom_gather",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, T, E]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "index",
          "kind": "tensor",
          "dtype": "torch.int64",
          "device": "cuda",
          "shape": "[B, I, E]",
          "layout": "strided (可能包含 0 stride)",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "default": 1,
          "nullable": false,
          "optional": true
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[B, I, E]"
      },
      "semantics": [
        "等价于 torch.gather(input, dim, index)，dim 为 1。",
        "output[b,i,e] = input[b, index[b,i,e], e]，索引沿 dim=1 选取。",
        "index 与 input 除 dim 维度外形状必须广播兼容；参考实现中 index 形状 [B,4,1024]，input 形状 [B,4096,1024]，dim=1。",
        "输出形状与 index 形状相同。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.embedding(x)",
      "semantics": [
        "输入 x: int64 [32,4096] (CPU -> CUDA 后)，self.embedding.weight: float32 [1000,1024]。",
        "执行 nn.Embedding 查表，输出 x: float32 [32,4096,1024]，device cuda:0，stride [4194304,1024,1]。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "indices = indices.unsqueeze(-1).expand(-1, -1, x.size(-1))",
      "semantics": [
        "indices 原始形状 [32,4] int64，unsqueeze(-1) 得到 [32,4,1]，expand 到 [32,4,1024]。",
        "结果 indices 为视图，stride [4,1,0]，device cuda:0，dtype int64，shape [32,4,1024]。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = torch.gather(x, 1, indices)",
      "semantics": [
        "对 x [32,4096,1024] 沿 dim=1 按照 indices [32,4,1024] 选取。",
        "输出 x: float32 [32,4,1024]，device cuda:0，stride [4096,1024,1]。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return x",
      "semantics": [
        "最终返回 gather 结果，类型 torch.Tensor，shape [32,4,1024]，dtype float32，device cuda:0。"
      ]
    }
  ]
}