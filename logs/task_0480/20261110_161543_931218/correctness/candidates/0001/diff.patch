--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,42 @@
+#include <cuda_runtime.h>
+#include <math.h>
+
+// Elementwise ReLU: y = max(0, x)
+__global__ void relu_kernel(const float* __restrict__ input, float* __restrict__ output, int64_t n) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < n; i += stride) {
+        output[i] = fmaxf(input[i], 0.0f);
+    }
+}
+
+// Elementwise softplus with numerical stability: y = log1p(exp(x)), for x > threshold use x
+__global__ void softplus_kernel(const float* __restrict__ input, float* __restrict__ output, int64_t n) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < n; i += stride) {
+        float x = input[i];
+        // PyTorch default beta=1, threshold=20
+        if (x > 20.0f) {
+            output[i] = x;
+        } else {
+            output[i] = log1pf(expf(x));
+        }
+    }
+}
+
+// Launcher for relu_forward
+extern "C" void relu_forward_launcher(const float* input, float* output, int64_t n, cudaStream_t stream) {
+    int threads = 256;
+    int blocks = (int)((n + threads - 1) / threads);
+    if (blocks > 65535) blocks = 65535; // grid-stride loop handles rest
+    relu_kernel<<<blocks, threads, 0, stream>>>(input, output, n);
+}
+
+// Launcher for softplus_forward
+extern "C" void softplus_forward_launcher(const float* input, float* output, int64_t n, cudaStream_t stream) {
+    int threads = 256;
+    int blocks = (int)((n + threads - 1) / threads);
+    if (blocks > 65535) blocks = 65535;
+    softplus_kernel<<<blocks, threads, 0, stream>>>(input, output, n);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,62 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void relu_forward_launcher(const float* input, float* output, int64_t n, cudaStream_t stream);
+extern "C" void softplus_forward_launcher(const float* input, float* output, int64_t n, cudaStream_t stream);
+
+// Wrapper for relu_forward
+torch::Tensor relu_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    if (!x.is_contiguous()) {
+        x = x.contiguous();
+    }
+
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    relu_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int64_t>(x.numel()),
+        stream
+    );
+
+    return output;
+}
+
+// Wrapper for softplus_forward
+torch::Tensor softplus_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    if (!x.is_contiguous()) {
+        x = x.contiguous();
+    }
+
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    softplus_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int64_t>(x.numel()),
+        stream
+    );
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("relu_forward", &relu_forward, "ReLU forward", py::arg("x"));
+    m.def("softplus_forward", &softplus_forward, "Softplus forward", py::arg("x"));
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,21 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        x = cuda_extension.relu_forward(x)
+        x = cuda_extension.softplus_forward(x)
+        return x
+
+    def debug_forward(self, *inputs):
+        x = inputs[0]
+        x = cuda_extension.relu_forward(x)
+        yield 'step_001', x
+        x = cuda_extension.softplus_forward(x)
+        yield 'step_002', x
+        yield 'step_003', x
