{
  "operators": [
    {
      "name": "custom_reduce_mean_channel",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, C, H, W] with C=3",
          "layout": "contiguous or supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[B, H, W]"
      },
      "semantics": [
        "Reduces the input tensor over dimension 1 (channel) computing the mean, output has the same batch and spatial dimensions.",
        "Output is contiguous with stride [H*W, W, 1].",
        "Equivalent to torch.mean(x, dim=1)."
      ]
    },
    {
      "name": "custom_add_scalar",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, H, W]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "scalar",
          "kind": "float",
          "default": null,
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "Adds a scalar to every element of the input tensor and returns the result.",
        "Equivalent to x + scalar."
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = torch.mean(x, dim=self.mean)",
      "semantics": [
        "Mean reduction over dimension 1.",
        "Input float32, output float32.",
        "Output shape [512, 512, 512]."
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = x + self.mean",
      "semantics": [
        "Addition of scalar self.mean (1) to every element.",
        "Output shape unchanged."
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "Return the result of the addition."
      ]
    }
  ]
}