--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,112 @@
+#include <cuda_runtime.h>
+
+// Kernel to compute mean over channel dimension (C=3)
+// Input: x with shape [B, C, H, W] and strides (stride_b, stride_c, stride_h, stride_w)
+// Output: y with shape [B, H, W] contiguous
+__global__ void reduce_mean_channel_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ y,
+    long long total_elements,  // B * H * W
+    int C,
+    long long stride_b,
+    long long stride_c,
+    long long stride_h,
+    long long stride_w,
+    long long out_stride_b,
+    long long out_stride_h,
+    long long out_stride_w)
+{
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+
+    for (; idx < total_elements; idx += stride) {
+        // Decompose idx into (b, h, w) assuming output contiguous [B, H, W]
+        long long w = idx % out_stride_w;
+        long long tmp = idx / out_stride_w;
+        long long h = tmp % out_stride_h;
+        long long b = tmp / out_stride_h;
+
+        const float* base = x + (long long)b * stride_b + (long long)h * stride_h + w * stride_w;
+        float sum = 0.0f;
+        // Unroll for C=3 (known constant) for performance
+        #pragma unroll
+        for (int c = 0; c < C; ++c) {
+            sum += base[c * stride_c];
+        }
+        y[idx] = sum / (float)C;
+    }
+}
+
+// Kernel to add scalar to every element
+__global__ void add_scalar_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ y,
+    long long total_elements,
+    float scalar)
+{
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+
+    for (; idx < total_elements; idx += stride) {
+        y[idx] = x[idx] + scalar;
+    }
+}
+
+// Launcher for reduce_mean_channel
+// Assumes input is float32 CUDA tensor, output allocated as contiguous [B,H,W]
+// Input may be non-contiguous; strides provided.
+// Returns cudaError_t for easy error checking in binding.
+extern "C" cudaError_t launch_reduce_mean_channel(
+    const float* x,
+    float* y,
+    long long B,
+    long long C,
+    long long H,
+    long long W,
+    long long stride_b,
+    long long stride_c,
+    long long stride_h,
+    long long stride_w,
+    cudaStream_t stream)
+{
+    long long total_elements = B * H * W;
+    if (total_elements <= 0) {
+        return cudaSuccess; // nothing to do
+    }
+
+    const int block_size = 256;
+    // Calculate grid size (capped to avoid excessive blocks, grid-stride loop handles rest)
+    int grid_size = (int)((total_elements + block_size - 1) / block_size);
+    if (grid_size > 1024) grid_size = 1024; // common max grid limit for 1D
+
+    reduce_mean_channel_kernel<<<grid_size, block_size, 0, stream>>>(
+        x, y, total_elements, (int)C,
+        stride_b, stride_c, stride_h, stride_w,
+        H * W, W, 1  // output contiguous strides: out_stride_b=H*W, out_stride_h=W, out_stride_w=1
+    );
+
+    return cudaGetLastError();
+}
+
+// Launcher for add_scalar
+// Input and output are contiguous float32 tensors with same shape
+extern "C" cudaError_t launch_add_scalar(
+    const float* x,
+    float* y,
+    long long total_elements,
+    float scalar,
+    cudaStream_t stream)
+{
+    if (total_elements <= 0) {
+        return cudaSuccess;
+    }
+
+    const int block_size = 256;
+    int grid_size = (int)((total_elements + block_size - 1) / block_size);
+    if (grid_size > 1024) grid_size = 1024;
+
+    add_scalar_kernel<<<grid_size, block_size, 0, stream>>>(
+        x, y, total_elements, scalar);
+
+    return cudaGetLastError();
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,91 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" cudaError_t launch_reduce_mean_channel(
+    const float* x,
+    float* y,
+    long long B,
+    long long C,
+    long long H,
+    long long W,
+    long long stride_b,
+    long long stride_c,
+    long long stride_h,
+    long long stride_w,
+    cudaStream_t stream
+);
+
+extern "C" cudaError_t launch_add_scalar(
+    const float* x,
+    float* y,
+    long long total_elements,
+    float scalar,
+    cudaStream_t stream
+);
+
+// Wrapper for custom_reduce_mean_channel
+torch::Tensor custom_reduce_mean_channel(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input tensor must be on CUDA");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input tensor must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input tensor must be 4-dimensional [B, C, H, W]");
+    TORCH_CHECK(x.size(1) == 3, "Channel dimension must be 3");
+
+    const long long B = x.size(0);
+    const long long C = x.size(1);
+    const long long H = x.size(2);
+    const long long W = x.size(3);
+
+    // Output tensor shape [B, H, W] contiguous
+    auto y = torch::empty({B, H, W}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    cudaError_t err = launch_reduce_mean_channel(
+        x.data_ptr<float>(),
+        y.data_ptr<float>(),
+        B, C, H, W,
+        x.stride(0), x.stride(1), x.stride(2), x.stride(3),
+        stream
+    );
+    TORCH_CHECK(err == cudaSuccess, "launch_reduce_mean_channel failed with error: ", cudaGetErrorString(err));
+
+    return y;
+}
+
+// Wrapper for custom_add_scalar
+torch::Tensor custom_add_scalar(torch::Tensor x, double scalar) {
+    TORCH_CHECK(x.is_cuda(), "Input tensor must be on CUDA");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input tensor must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input tensor must be contiguous");
+
+    auto y = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    cudaError_t err = launch_add_scalar(
+        x.data_ptr<float>(),
+        y.data_ptr<float>(),
+        x.numel(),
+        static_cast<float>(scalar),
+        stream
+    );
+    TORCH_CHECK(err == cudaSuccess, "launch_add_scalar failed with error: ", cudaGetErrorString(err));
+
+    return y;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_reduce_mean_channel", &custom_reduce_mean_channel,
+          "Compute mean over channel dimension (C=3)",
+          pybind11::arg("x"));
+    m.def("custom_add_scalar", &custom_add_scalar,
+          "Add scalar to every element",
+          pybind11::arg("x"), pybind11::arg("scalar"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,20 @@
+import torch
+import cuda_extension
+
+
+class ModelNew(torch.nn.Module):
+    def __init__(self, input_size, mean_value):
+        super().__init__()
+        self.mean = mean_value
+
+    def forward(self, x):
+        x = cuda_extension.custom_reduce_mean_channel(x)
+        x = cuda_extension.custom_add_scalar(x, self.mean)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.custom_reduce_mean_channel(x)
+        yield 'step_001', x
+        x = cuda_extension.custom_add_scalar(x, self.mean)
+        yield 'step_002', x
+        yield 'step_003', x
