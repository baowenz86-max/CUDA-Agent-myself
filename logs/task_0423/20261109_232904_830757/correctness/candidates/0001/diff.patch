--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,75 @@
+#include <cuda_runtime.h>
+
+// Custom clamp kernel: clamps each element to [0,1]
+__global__ void clamp_min_max_kernel(float* out, const float* in, long long n) {
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = gridDim.x * blockDim.x;
+    for (long long i = idx; i < n; i += stride) {
+        float v = in[i];
+        out[i] = fminf(fmaxf(v, 0.0f), 1.0f);
+    }
+}
+
+// Custom triu kernel: for each batch, zero out elements below main diagonal
+__global__ void triu_kernel(float* out, const float* in,
+                            int batch, int rows, int cols) {
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = gridDim.x * blockDim.x;
+    long long total = (long long)batch * rows * cols;
+    for (long long i = idx; i < total; i += stride) {
+        int col = i % cols;
+        long long tmp = i / cols;
+        int row = tmp % rows;
+        // batch index not needed for mask, only row and col matter
+        if (row <= col) {
+            out[i] = in[i];
+        } else {
+            out[i] = 0.0f;
+        }
+    }
+}
+
+// Custom add bias kernel: broadcast bias over batch dimension
+__global__ void add_bias_kernel(float* out, const float* in, const float* bias,
+                                int batch, int rows, int cols) {
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = gridDim.x * blockDim.x;
+    long long total = (long long)batch * rows * cols;
+    for (long long i = idx; i < total; i += stride) {
+        int col = i % cols;
+        long long tmp = i / cols;
+        int row = tmp % rows;
+        out[i] = in[i] + bias[(long long)row * cols + col];
+    }
+}
+
+// Launcher for custom_clamp_min_max
+extern "C" void custom_clamp_min_max_launcher(float* out, const float* in,
+                                              long long n, cudaStream_t stream) {
+    int threads = 256;
+    int blocks = (n + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535; // grid cap, grid-stride loop handles rest
+    clamp_min_max_kernel<<<blocks, threads, 0, stream>>>(out, in, n);
+}
+
+// Launcher for custom_triu
+extern "C" void custom_triu_launcher(float* out, const float* in,
+                                     int batch, int rows, int cols,
+                                     cudaStream_t stream) {
+    int threads = 256;
+    long long total = (long long)batch * rows * cols;
+    int blocks = (total + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535;
+    triu_kernel<<<blocks, threads, 0, stream>>>(out, in, batch, rows, cols);
+}
+
+// Launcher for custom_add_bias
+extern "C" void custom_add_bias_launcher(float* out, const float* in, const float* bias,
+                                         int batch, int rows, int cols,
+                                         cudaStream_t stream) {
+    int threads = 256;
+    long long total = (long long)batch * rows * cols;
+    int blocks = (total + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535;
+    add_bias_kernel<<<blocks, threads, 0, stream>>>(out, in, bias, batch, rows, cols);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,77 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+extern "C" void custom_clamp_min_max_launcher(float* out, const float* in,
+                                              long long n, cudaStream_t stream);
+extern "C" void custom_triu_launcher(float* out, const float* in,
+                                     int batch, int rows, int cols,
+                                     cudaStream_t stream);
+extern "C" void custom_add_bias_launcher(float* out, const float* in, const float* bias,
+                                         int batch, int rows, int cols,
+                                         cudaStream_t stream);
+
+torch::Tensor custom_clamp_min_max(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+
+    auto out = torch::empty_like(x);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    custom_clamp_min_max_launcher(out.data_ptr<float>(), x.data_ptr<float>(),
+                                  x.numel(), stream);
+    return out;
+}
+
+torch::Tensor custom_triu(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 3, "Input must be 3D (batch, rows, cols)");
+
+    int batch = x.size(0);
+    int rows = x.size(1);
+    int cols = x.size(2);
+
+    auto out = torch::empty_like(x);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    custom_triu_launcher(out.data_ptr<float>(), x.data_ptr<float>(),
+                         batch, rows, cols, stream);
+    return out;
+}
+
+torch::Tensor custom_add_bias(torch::Tensor x, torch::Tensor bias) {
+    TORCH_CHECK(x.is_cuda(), "Input x must be a CUDA tensor");
+    TORCH_CHECK(bias.is_cuda(), "bias must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "Input x must be contiguous");
+    TORCH_CHECK(bias.is_contiguous(), "bias must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input x must be float32");
+    TORCH_CHECK(bias.dtype() == torch::kFloat32, "bias must be float32");
+    TORCH_CHECK(x.dim() == 3, "Input x must be 3D (batch, rows, cols)");
+    TORCH_CHECK(bias.dim() == 2, "bias must be 2D (rows, cols)");
+
+    int batch = x.size(0);
+    int rows = x.size(1);
+    int cols = x.size(2);
+    TORCH_CHECK(bias.size(0) == rows && bias.size(1) == cols,
+                "bias shape mismatch with x's rows and cols");
+
+    auto out = torch::empty_like(x);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    custom_add_bias_launcher(out.data_ptr<float>(), x.data_ptr<float>(), bias.data_ptr<float>(),
+                             batch, rows, cols, stream);
+    return out;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_clamp_min_max", &custom_clamp_min_max, "Clamp each element to [0,1]",
+          py::arg("x"));
+    m.def("custom_triu", &custom_triu, "Upper triangular mask for each batch",
+          py::arg("x"));
+    m.def("custom_add_bias", &custom_add_bias, "Add bias broadcast over batch",
+          py::arg("x"), py::arg("bias"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,24 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, bias_shape):
+        super().__init__()
+        self.bias = nn.Parameter(torch.randn(bias_shape))
+
+    def forward(self, x):
+        x = cuda_extension.custom_clamp_min_max(x)
+        x = cuda_extension.custom_triu(x)
+        x = cuda_extension.custom_add_bias(x, self.bias)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.custom_clamp_min_max(x)
+        yield 'step_001', x
+        x = cuda_extension.custom_triu(x)
+        yield 'step_002', x
+        x = cuda_extension.custom_add_bias(x, self.bias)
+        yield 'step_003', x
+        yield 'step_004', x
