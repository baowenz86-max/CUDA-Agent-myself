+#include <cuda_runtime.h>
+#include <cstdint>
+
+// Helper to compute index from multi-dimensional strides
+template <typename T>
+__device__ __forceinline__ T get_strided_index(const T* strides, const T* shape, int ndim, const T* indices) {
+    T idx = 0;
+    for (int i = 0; i < ndim; ++i) {
+        idx += indices[i] * strides[i];
+    }
+    return idx;
+}
+
+// Kernel for view_as_real: complex64 (float2) input to float32 output with last dim size 2.
+// Input: complex64 tensor with shape [B, C, H, W] (or any dimensions) on CPU. We copy to CUDA memory.
+// Output: float32 tensor with shape [..., 2].
+// The launcher will allocate output on CUDA and call this kernel.
+// We use a 1D grid: each thread handles one element of the original complex tensor (all except last dim).
+// For each complex element at flat index i, we write output[2*i] = real, output[2*i+1] = imag.
+// This assumes input is contiguous? But contract says supports strides. We need to handle general strides.
+// However, the input is on CPU, and we need to copy data to GPU. The binding will likely use a contiguous copy or pass raw pointer with strides.
+// For simplicity and performance, we assume the input is contiguous, but we can handle strides by using a kernel that iterates over logical linear index and computes multi-dimensional indices.
+// Since input is complex64 on CPU, we must first copy to GPU. The binding will handle that; launcher expects a GPU pointer for complex input.
+// We'll create a kernel that reads from GPU complex data with strides and writes to GPU output contiguous.
+__global__ void view_as_real_kernel(const float2* __restrict__ input,
+                                    float* __restrict__ output,
+                                    const int64_t total_complex_elements,
+                                    const int64_t* __restrict__ input_strides,
+                                    const int64_t* __restrict__ input_shape,
+                                    int ndim) {
+    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < total_complex_elements; i += stride) {
+        // Compute multi-dimensional indices for this linear index over the non-last dimensions.
+        int64_t remainder = i;
+        int64_t flat_input_idx = 0;
+        // ndim is the number of dimensions of the original complex tensor (e.g., B, C, H, W)
+        for (int d = ndim - 1; d >= 0; --d) {
+            int64_t dim_size = input_shape[d];
+            int64_t coord = remainder % dim_size;
+            remainder /= dim_size;
+            flat_input_idx += coord * input_strides[d];
+        }
+        float2 val = input[flat_input_idx];
+        output[2 * i] = val.x;
+        output[2 * i + 1] = val.y;
+    }
+}
+
+// Kernel for einsum bchw->bhwc on a 5D tensor where last dim size is 2.
+// Input shape: [B, C, H, W, 2], output shape: [B, H, W, C, 2].
+// We treat the last dimension (size 2) as a unit and copy both elements.
+// We'll use a 1D grid over total number of output elements excluding the last dim? Actually output total = B*H*W*C*2.
+// We can have each thread handle one output element (flat index).
+// General strides supported via input and output strides.
+__global__ void einsum_permute_kernel(const float* __restrict__ input,
+                                      float* __restrict__ output,
+                                      const int64_t total_output_elements,
+                                      const int64_t* __restrict__ input_strides, // 5 strides
+                                      const int64_t* __restrict__ output_strides, // 5 strides
+                                      const int64_t* __restrict__ output_shape, // 5 dims
+                                      int ndim) {
+    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < total_output_elements; i += stride) {
+        // Compute output multi-dimensional index from flat i.
+        int64_t remainder = i;
+        int64_t input_idx = 0;
+        for (int d = ndim - 1; d >= 0; --d) {
+            int64_t coord = remainder % output_shape[d];
+            remainder /= output_shape[d];
+            // Map output coord to input coord: b->b, h->c, w->h, c->w, 2->2
+            int input_dim;
+            if (d == 0) input_dim = 0; // b
+            else if (d == 1) input_dim = 2; // output h -> input h (since input order: b,c,h,w)
+            else if (d == 2) input_dim = 3; // output w -> input w
+            else if (d == 3) input_dim = 1; // output c -> input c
+            else input_dim = 4; // last 2
+            input_idx += coord * input_strides[input_dim];
+        }
+        output[i] = input[input_idx];
+    }
+}
+
+// Kernel for clip
+__global__ void clip_kernel(float* __restrict__ data,
+                            int64_t total_elements,
+                            float min_val,
+                            float max_val) {
+    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < total_elements; i += stride) {
+        float val = data[i];
+        val = fminf(fmaxf(val, min_val), max_val);
+        data[i] = val;
+    }
+}
+
+// Launchers (extern "C" for binding)
+extern "C" void view_as_real_launcher(const float2* input, float* output,
+                                      int64_t total_complex_elements,
+                                      const int64_t* input_strides,
+                                      const int64_t* input_shape,
+                                      int ndim,
+                                      cudaStream_t stream) {
+    const int block_size = 256;
+    int64_t grid_size = (total_complex_elements + block_size - 1) / block_size;
+    if (grid_size > 2147483647) grid_size = 2147483647;
+    view_as_real_kernel<<<(int)grid_size, block_size, 0, stream>>>(
+        input, output, total_complex_elements, input_strides, input_shape, ndim);
+}
+
+extern "C" void einsum_permute_launcher(const float* input, float* output,
+                                        int64_t total_output_elements,
+                                        const int64_t* input_strides,
+                                        const int64_t* output_strides,
+                                        const int64_t* output_shape,
+                                        int ndim,
+                                        cudaStream_t stream) {
+    const int block_size = 256;
+    int64_t grid_size = (total_output_elements + block_size - 1) / block_size;
+    if (grid_size > 2147483647) grid_size = 2147483647;
+    einsum_permute_kernel<<<(int)grid_size, block_size, 0, stream>>>(
+        input, output, total_output_elements, input_strides, output_strides, output_shape, ndim);
+}
+
+extern "C" void clip_launcher(float* data, int64_t total_elements,
+                              float min_val, float max_val,
+                              cudaStream_t stream) {
+    const int block_size = 256;
+    int64_t grid_size = (total_elements + block_size - 1) / block_size;
+    if (grid_size > 2147483647) grid_size = 2147483647;
+    clip_kernel<<<(int)grid_size, block_size, 0, stream>>>(data, total_elements, min_val, max_val);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,195 @@
+// Binding for custom non-convolution kernels defined in custom_ops.cu
+#include <torch/types.h>
+#include <pybind11/pybind11.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+namespace py = pybind11;
+
+// Declare launchers from custom_ops.cu
+extern "C" void view_as_real_launcher(const float2* input, float* output,
+                                      int64_t total_complex_elements,
+                                      const int64_t* input_strides,
+                                      const int64_t* input_shape,
+                                      int ndim,
+                                      cudaStream_t stream);
+
+extern "C" void einsum_permute_launcher(const float* input, float* output,
+                                        int64_t total_output_elements,
+                                        const int64_t* input_strides,
+                                        const int64_t* output_strides,
+                                        const int64_t* output_shape,
+                                        int ndim,
+                                        cudaStream_t stream);
+
+extern "C" void clip_launcher(float* data, int64_t total_elements,
+                              float min_val, float max_val,
+                              cudaStream_t stream);
+
+// Helper to check CUDA errors after kernel launches
+static void check_cuda_error(const char* name) {
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, name, " failed with error: ", cudaGetErrorString(err));
+}
+
+// view_as_real_forward: CPU complex64 -> CUDA float32 with extra trailing dim of size 2
+torch::Tensor view_as_real_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cpu(), "view_as_real_forward: input must be CPU tensor");
+    TORCH_CHECK(x.scalar_type() == torch::kComplex64, "view_as_real_forward: input must be complex64");
+    TORCH_CHECK(!x.is_complex(), "view_as_real_forward: input should be complex64 but got ", x.scalar_type());
+
+    // Original shape
+    auto sizes = x.sizes();
+    int64_t ndim = x.dim();
+    TORCH_CHECK(ndim > 0, "view_as_real_forward: input must have at least one dimension");
+
+    // Output shape: input shape + [2]
+    std::vector<int64_t> out_sizes(sizes.begin(), sizes.end());
+    out_sizes.push_back(2);
+
+    // Allocate contiguous CUDA output
+    auto out = torch::empty(out_sizes, torch::dtype(torch::kFloat32).device(torch::kCUDA));
+
+    // Ensure input is contiguous for easier copying to GPU; if not, make contiguous
+    if (!x.is_contiguous()) {
+        x = x.contiguous();
+    }
+
+    // Copy complex tensor to GPU (as float2). Total number of complex elements = numel of input.
+    int64_t total_complex_elements = x.numel();
+    auto x_gpu = torch::empty_like(x, torch::dtype(torch::kComplex64).device(torch::kCUDA));
+    x_gpu.copy_(x);
+
+    // For input strides, we pass the strides of the complex tensor (in units of float2 elements)
+    // Convert to int64_t array on host; kernel expects strides in terms of complex elements.
+    auto stride_opt = x.strides();
+    std::vector<int64_t> input_strides(stride_opt.begin(), stride_opt.end());
+    auto shape_opt = x.sizes();
+    std::vector<int64_t> input_shape(shape_opt.begin(), shape_opt.end());
+
+    // Move strides and shape to GPU? The launcher expects device pointers to int64 arrays.
+    // In our .cu, the kernel takes const int64_t* __restrict__ input_strides and input_shape,
+    // which are declared as device pointers (kernel memory space). So we need to copy them to GPU.
+    // Alternatively, modify launcher to accept host pointers? But .cu cannot be modified in this stage.
+    // We must allocate device memory for these arrays and copy them.
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    int64_t* d_input_strides = nullptr;
+    int64_t* d_input_shape = nullptr;
+    cudaMalloc(&d_input_strides, ndim * sizeof(int64_t));
+    cudaMalloc(&d_input_shape, ndim * sizeof(int64_t));
+    cudaMemcpyAsync(d_input_strides, input_strides.data(), ndim * sizeof(int64_t), cudaMemcpyHostToDevice, stream);
+    cudaMemcpyAsync(d_input_shape, input_shape.data(), ndim * sizeof(int64_t), cudaMemcpyHostToDevice, stream);
+
+    // Call launcher with GPU complex pointer
+    view_as_real_launcher(
+        reinterpret_cast<const float2*>(x_gpu.data_ptr<c10::complex<float>>()),
+        out.data_ptr<float>(),
+        total_complex_elements,
+        d_input_strides,
+        d_input_shape,
+        static_cast<int>(ndim),
+        stream
+    );
+    check_cuda_error("view_as_real_launcher");
+
+    // Free device arrays
+    cudaFree(d_input_strides);
+    cudaFree(d_input_shape);
+
+    return out;
+}
+
+// einsum_bchw_to_bhwc_forward: CUDA float32 [B,C,H,W,2] -> [B,H,W,C,2]
+torch::Tensor einsum_bchw_to_bhwc_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "einsum_bchw_to_bhwc_forward: input must be CUDA tensor");
+    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "einsum_bchw_to_bhwc_forward: input must be float32");
+
+    auto sizes = x.sizes();
+    TORCH_CHECK(sizes.size() == 5, "einsum_bchw_to_bhwc_forward: input must be 5D [B,C,H,W,2]");
+    int64_t B = sizes[0];
+    int64_t C = sizes[1];
+    int64_t H = sizes[2];
+    int64_t W = sizes[3];
+    int64_t R = sizes[4]; // == 2
+    TORCH_CHECK(R == 2, "einsum_bchw_to_bhwc_forward: last dim must be 2");
+
+    // Output shape [B,H,W,C,2]
+    std::vector<int64_t> out_sizes = {B, H, W, C, R};
+    auto out = torch::empty(out_sizes, torch::dtype(torch::kFloat32).device(torch::kCUDA));
+
+    // Input and output strides
+    auto in_strides = x.strides(); // 5 strides, may be non-contiguous
+    auto out_strides = out.strides();
+
+    // Total output elements = B*H*W*C*2
+    int64_t total_out = out.numel();
+
+    // Prepare strides and shape for launcher (device arrays)
+    int ndim = 5;
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    int64_t* d_input_strides = nullptr;
+    int64_t* d_output_strides = nullptr;
+    int64_t* d_output_shape = nullptr;
+    cudaMalloc(&d_input_strides, ndim * sizeof(int64_t));
+    cudaMalloc(&d_output_strides, ndim * sizeof(int64_t));
+    cudaMalloc(&d_output_shape, ndim * sizeof(int64_t));
+
+    std::vector<int64_t> input_strides(in_strides.begin(), in_strides.end());
+    std::vector<int64_t> output_strides(out_strides.begin(), out_strides.end());
+    std::vector<int64_t> output_shape(out_sizes.begin(), out_sizes.end());
+
+    cudaMemcpyAsync(d_input_strides, input_strides.data(), ndim * sizeof(int64_t), cudaMemcpyHostToDevice, stream);
+    cudaMemcpyAsync(d_output_strides, output_strides.data(), ndim * sizeof(int64_t), cudaMemcpyHostToDevice, stream);
+    cudaMemcpyAsync(d_output_shape, output_shape.data(), ndim * sizeof(int64_t), cudaMemcpyHostToDevice, stream);
+
+    einsum_permute_launcher(
+        x.data_ptr<float>(),
+        out.data_ptr<float>(),
+        total_out,
+        d_input_strides,
+        d_output_strides,
+        d_output_shape,
+        ndim,
+        stream
+    );
+    check_cuda_error("einsum_permute_launcher");
+
+    cudaFree(d_input_strides);
+    cudaFree(d_output_strides);
+    cudaFree(d_output_shape);
+
+    return out;
+}
+
+// clip_forward: in-place clamp on CUDA float32 tensor
+torch::Tensor clip_forward(torch::Tensor x, float min = 0.0f, float max = 1.0f) {
+    TORCH_CHECK(x.is_cuda(), "clip_forward: input must be CUDA tensor");
+    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "clip_forward: input must be float32");
+
+    // We will modify in-place to preserve any strides and avoid extra memory.
+    // The launcher modifies data in-place.
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    int64_t total_elements = x.numel();
+
+    clip_launcher(x.data_ptr<float>(), total_elements, min, max, stream);
+    check_cuda_error("clip_launcher");
+
+    return x;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("view_as_real_forward", &view_as_real_forward,
+          "Convert CPU complex64 tensor to CUDA float32 tensor with extra trailing dim of 2",
+          py::arg("x"));
+    m.def("einsum_bchw_to_bhwc_forward", &einsum_bchw_to_bhwc_forward,
+          "Permute bchw->bhwc for a 5D tensor where last dim is 2",
+          py::arg("x"));
+    m.def("clip_forward", &clip_forward,
+          "Clamp tensor element-wise to [min, max]",
+          py::arg("x"), py::arg("min") = 0.0f, py::arg("max") = 1.0f);
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
