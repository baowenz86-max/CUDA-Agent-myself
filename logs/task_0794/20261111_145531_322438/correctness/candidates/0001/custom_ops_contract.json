{
  "operators": [
    {
      "name": "custom_logical_or",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[512, 3, 256, 256]",
          "layout": "contiguous",
          "optional": false,
          "nullable": false
        },
        {
          "name": "y",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[512, 3, 256, 256]",
          "layout": "contiguous",
          "optional": false,
          "nullable": false
        },
        {
          "name": "threshold",
          "kind": "float",
          "default": 0.5,
          "optional": true,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.bool",
        "device": "cuda",
        "shape": "[512, 3, 256, 256]"
      },
      "semantics": [
        "Computes elementwise logical OR of (x > 0.5) and (y > 0.5), matching torch.logical_or(x > 0.5, y > 0.5).",
        "Input tensors are float32 on CUDA with contiguous layout; output is bool on same device and shape.",
        "Supports arbitrary strides: kernel assumes linear indexing over contiguous tensors; input must be contiguous as per contract.",
        "Returns a new tensor; does not modify inputs."
      ]
    },
    {
      "name": "custom_cast_float",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.bool",
          "device": "cuda",
          "shape": "[512, 3, 256, 256]",
          "layout": "contiguous",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[512, 3, 256, 256]"
      },
      "semantics": [
        "Casts each element from bool to float32, equivalent to x.float() in reference.",
        "Input is bool tensor on CUDA with contiguous layout; output is float32 same shape and device.",
        "Values: True -> 1.0, False -> 0.0."
      ]
    },
    {
      "name": "custom_mse_loss_mean",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[512, 3, 256, 256]",
          "layout": "contiguous",
          "optional": false,
          "nullable": false
        },
        {
          "name": "target",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[512, 3, 256, 256]",
          "layout": "contiguous",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[]"
      },
      "semantics": [
        "Computes mean squared error loss over all elements, matching F.mse_loss(input, target) with default reduction='mean'.",
        "Input and target are float32 CUDA tensors of same shape; output is a scalar float32 CUDA tensor.",
        "Formula: sum((input_i - target_i)^2) / numel.",
        "Assumes numel > 0; no size_average or reduce arguments used in reference."
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = torch.logical_or(x > 0.5, y > 0.5)",
      "semantics": [
        "Elementwise OR of x>0.5 and y>0.5, output bool tensor same shape as inputs.",
        "Broadcast not needed: x and y same shape.",
        "Preserves device (CUDA) and layout."
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = x.float()",
      "semantics": [
        "Cast bool tensor to float32, values 0.0 or 1.0.",
        "Same shape and device."
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "loss = F.mse_loss(x, target)",
      "semantics": [
        "Mean squared error over all elements, output scalar tensor.",
        "Default reduction='mean', no weighting."
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return loss",
      "semantics": [
        "Returns the scalar loss tensor from step_003 unchanged."
      ]
    }
  ]
