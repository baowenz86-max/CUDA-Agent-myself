{
  "operators": [
    {
      "name": "embedding_forward",
      "parameters": [
        {
          "name": "indices",
          "kind": "tensor",
          "dtype": "torch.int64",
          "device": "cuda",
          "shape": "[batch_size, seq_len]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[num_embeddings, embedding_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, seq_len, embedding_dim]"
      },
      "semantics": [
        "实现 nn.Embedding 前向查找。",
        "对 indices 中每个元素 i，输出对应行 weight[i]。",
        "indices 形状为 [batch_size, seq_len]，输出形状为 [batch_size, seq_len, embedding_dim]。",
        "无 padding_idx、max_norm、norm_type、scale_grad_by_freq、sparse 行为。",
        "输出 dtype 与 weight 一致（float32），device 为 cuda。"
      ]
    },
    {
      "name": "baddbmm_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, seq_len, embedding_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "batch1",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, seq_len, input_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "batch2",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, input_dim, embedding_dim]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, seq_len, embedding_dim]"
      },
      "semantics": [
        "实现 torch.baddbmm(input, batch1, batch2) 的默认行为：beta=1.0, alpha=1.0。",
        "输出 = 1.0 * input + 1.0 * (batch1 @ batch2)。",
        "输入张量形状为 [batch_size, seq_len, input_dim] 和 [batch_size, input_dim, embedding_dim]。",
        "输出形状为 [batch_size, seq_len, embedding_dim]。",
        "所有张量为 float32，device 为 cuda。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.embedding(indices)",
      "semantics": [
        "对 indices 中每个整数执行 embedding 查找。",
        "输出形状 [batch_size, seq_len, embedding_dim]，dtype float32，device cuda。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.baddbmm(x, batch1, batch2)",
      "semantics": [
        "执行批量矩阵乘法 batch1 @ batch2 并加上 x。",
        "输出形状 [batch_size, seq_len, embedding_dim]，dtype float32，device cuda。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回 step_002 的计算结果。"
      ]
    }
  ]
}