{
  "operators": [
    {
      "name": "custom_ge_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference input [1800,3,512,256]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "threshold",
          "kind": "float",
          "default": null,
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.bool",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "对输入张量 x 的每个元素执行 x >= threshold 的比较，返回布尔张量，形状与 x 相同。",
        "对应参考语句 torch.ge(x, self.threshold)，广播规则无额外广播，threshold 为标量。",
        "输出 device 为 CUDA，dtype 为 torch.bool，stride 与输入一致。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "return torch.ge(x, self.threshold)",
      "semantics": [
        "执行逐元素大于等于比较 x >= threshold，输出布尔张量，形状 [1800,3,512,256]，dtype torch.bool，device cuda:0。"
      ]
    }
  ]
}