--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,35 @@
+#include <cuda_runtime.h>
+
+// 逐元素比较 kernel: out[i] = (in[i] >= threshold)
+__global__ void ge_forward_kernel(
+    const float* __restrict__ input,
+    bool* __restrict__ output,
+    int64_t numel,
+    float threshold
+) {
+    int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    int64_t stride = static_cast<int64_t>(blockDim.x) * gridDim.x;
+    for (; idx < numel; idx += stride) {
+        output[idx] = (input[idx] >= threshold);
+    }
+}
+
+// C 接口 launcher，供 binding.cpp 调用
+extern "C" void custom_ge_forward_launcher(
+    const float* input,
+    bool* output,
+    int64_t numel,
+    float threshold,
+    cudaStream_t stream
+) {
+    if (numel == 0) {
+        return;
+    }
+    const int threads = 256;
+    int blocks = static_cast<int>((numel + threads - 1) / threads);
+    // grid 上限保护，使用 grid-stride loop 处理超大张量
+    if (blocks > 65535) {
+        blocks = 65535;
+    }
+    ge_forward_kernel<<<blocks, threads, 0, stream>>>(input, output, numel, threshold);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,42 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// 声明 .cu 中的 launcher
+extern "C" void custom_ge_forward_launcher(
+    const float* input,
+    bool* output,
+    int64_t numel,
+    float threshold,
+    cudaStream_t stream
+);
+
+// PyTorch 包装函数
+static torch::Tensor custom_ge_forward(torch::Tensor x, double threshold) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+
+    auto output = torch::empty_like(x, x.options().dtype(torch::kBool));
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    custom_ge_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<bool>(),
+        x.numel(),
+        static_cast<float>(threshold),
+        stream
+    );
+
+    return output;
+}
+
+void register_custom_ge(pybind11::module& m) {
+    m.def("custom_ge_forward", &custom_ge_forward,
+          "Custom elementwise greater-equal forward (CUDA)",
+          py::arg("x"), py::arg("threshold"));
+}
+
+REGISTER_BINDING(custom_ge, register_custom_ge);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,20 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, threshold):
+        super().__init__()
+        self.threshold = threshold
+
+    def forward(self, x):
+        if not x.is_cuda:
+            x = x.cuda()
+        return cuda_extension.custom_ge_forward(x, self.threshold)
+
+    def debug_forward(self, x):
+        if not x.is_cuda:
+            x = x.cuda()
+        out = cuda_extension.custom_ge_forward(x, self.threshold)
+        yield 'step_001', out
