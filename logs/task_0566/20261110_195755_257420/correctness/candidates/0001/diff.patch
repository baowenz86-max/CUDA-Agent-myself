--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,70 @@
+#include <cuda_runtime.h>
+
+// Element-wise absolute value kernel for float32 input.
+// Uses float4 vectorized loads for contiguous data and a grid-stride loop.
+__global__ void abs_kernel(const float* __restrict__ input,
+                           float* __restrict__ output,
+                           size_t total_elements) {
+    size_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    size_t stride = blockDim.x * gridDim.x;
+    const float4* in4 = reinterpret_cast<const float4*>(input);
+    float4* out4 = reinterpret_cast<float4*>(output);
+    size_t num_vec = total_elements / 4;
+
+    // Vectorized path
+    for (size_t i = idx; i < num_vec; i += stride) {
+        float4 val = in4[i];
+        val.x = fabsf(val.x);
+        val.y = fabsf(val.y);
+        val.z = fabsf(val.z);
+        val.w = fabsf(val.w);
+        out4[i] = val;
+    }
+
+    // Tail elements
+    for (size_t i = num_vec * 4 + idx; i < total_elements; i += stride) {
+        output[i] = fabsf(input[i]);
+    }
+}
+
+// Element-wise greater-than-scalar kernel: output = (input > threshold)
+// Input is float32, output is bool (stored as unsigned char).
+__global__ void gt_scalar_kernel(const float* __restrict__ input,
+                                 bool* __restrict__ output,
+                                 float threshold,
+                                 size_t total_elements) {
+    size_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    size_t stride = blockDim.x * gridDim.x;
+    for (size_t i = idx; i < total_elements; i += stride) {
+        output[i] = (input[i] > threshold);
+    }
+}
+
+// C interface launcher for abs_forward.
+// total_elements is number of float elements.
+extern "C" void abs_forward_launcher(const float* input,
+                                     float* output,
+                                     size_t total_elements,
+                                     cudaStream_t stream) {
+    const int threads = 256;
+    // Grid size limited to 65535 in x dimension; use grid-stride loop.
+    // For total_elements / 4, cap blocks to something reasonable like 1024*64.
+    size_t num_vec = total_elements / 4;
+    size_t blocks = (num_vec + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535;
+    if (blocks == 0) blocks = 1;
+    abs_kernel<<<blocks, threads, 0, stream>>>(input, output, total_elements);
+}
+
+// C interface launcher for gt_scalar_forward.
+extern "C" void gt_scalar_forward_launcher(const float* input,
+                                           bool* output,
+                                           float threshold,
+                                           size_t total_elements,
+                                           cudaStream_t stream) {
+    const int threads = 256;
+    size_t blocks = (total_elements + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535;
+    if (blocks == 0) blocks = 1;
+    gt_scalar_kernel<<<blocks, threads, 0, stream>>>(input, output, threshold, total_elements);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,73 @@
+// Binding for abs_forward and gt_scalar_forward
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Launcher declarations from custom_ops.cu
+extern "C" void abs_forward_launcher(const float* input,
+                                     float* output,
+                                     size_t total_elements,
+                                     cudaStream_t stream);
+
+extern "C" void gt_scalar_forward_launcher(const float* input,
+                                           bool* output,
+                                           float threshold,
+                                           size_t total_elements,
+                                           cudaStream_t stream);
+
+// Wrapper for abs_forward
+torch::Tensor abs_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+
+    auto output = torch::empty_like(x);
+    size_t total_elements = static_cast<size_t>(x.numel());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    abs_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        total_elements,
+        stream
+    );
+
+    return output;
+}
+
+// Wrapper for gt_scalar_forward
+torch::Tensor gt_scalar_forward(torch::Tensor x, double threshold) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+
+    auto output = torch::empty(x.sizes(), x.options().dtype(torch::kBool));
+    size_t total_elements = static_cast<size_t>(x.numel());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    gt_scalar_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<bool>(),
+        static_cast<float>(threshold),
+        total_elements,
+        stream
+    );
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("abs_forward", &abs_forward,
+          "Element-wise absolute value",
+          py::arg("x"));
+    m.def("gt_scalar_forward", &gt_scalar_forward,
+          "Element-wise greater-than scalar comparison",
+          py::arg("x"),
+          py::arg("threshold") = 0.5);
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,21 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, input_size):
+        super().__init__()
+        self.input_size = input_size
+
+    def forward(self, x):
+        x = cuda_extension.abs_forward(x)
+        x = cuda_extension.gt_scalar_forward(x, 0.5)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.abs_forward(x)
+        yield 'step_001', x
+        y = cuda_extension.gt_scalar_forward(x, 0.5)
+        yield 'step_002', y
+        yield 'step_003', y
