--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,73 @@
+#include <cuda_runtime.h>
+
+// Kernel for mean reduction over dims (1,2,3) with keepdim=True.
+// Each block handles one batch element, iterating over the 12582912 float values.
+// Input is float32 contiguous; output float32.
+template <int BLOCK_SIZE>
+__global__ void mean_reduce_kernel(const float* __restrict__ input,
+                                  float* __restrict__ output,
+                                  int batch_size,
+                                  long long elements_per_batch) {
+    int batch_idx = blockIdx.x;
+    if (batch_idx >= batch_size) return;
+
+    const float* batch_ptr = input + (long long)batch_idx * elements_per_batch;
+    float sum = 0.0f;
+
+    // Grid-stride loop within this block for the current batch element
+    for (long long i = threadIdx.x; i < elements_per_batch; i += BLOCK_SIZE) {
+        sum += batch_ptr[i];
+    }
+
+    // Shared memory reduction
+    __shared__ float shared_sum[BLOCK_SIZE];
+    shared_sum[threadIdx.x] = sum;
+    __syncthreads();
+
+    for (int stride = BLOCK_SIZE / 2; stride > 0; stride >>= 1) {
+        if (threadIdx.x < stride) {
+            shared_sum[threadIdx.x] += shared_sum[threadIdx.x + stride];
+        }
+        __syncthreads();
+    }
+
+    if (threadIdx.x == 0) {
+        output[batch_idx] = shared_sum[0] / (float)elements_per_batch;
+    }
+}
+
+// Kernel for elementwise tangent. Each thread handles one element.
+__global__ void tan_kernel(const float* __restrict__ input,
+                           float* __restrict__ output,
+                           int numel) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx < numel) {
+        output[idx] = tanf(input[idx]);
+    }
+}
+
+// Launcher for custom_mean_reduce.
+// input: contiguous float32 CUDA tensor with shape [batch_size, 3, 2048, 2048]
+// output: contiguous float32 CUDA tensor with shape [batch_size, 1, 1, 1]
+// batch_size: 128
+extern "C" void custom_mean_reduce_launcher(const float* input,
+                                           float* output,
+                                           int batch_size,
+                                           long long elements_per_batch,
+                                           cudaStream_t stream) {
+    const int block_size = 256;
+    int grid_size = batch_size; // one block per batch
+    mean_reduce_kernel<block_size><<<grid_size, block_size, 0, stream>>>(
+        input, output, batch_size, elements_per_batch);
+}
+
+// Launcher for custom_tan.
+// input/output: contiguous float32 CUDA tensor with numel elements
+extern "C" void custom_tan_launcher(const float* input,
+                                    float* output,
+                                    int numel,
+                                    cudaStream_t stream) {
+    const int block_size = 256;
+    int grid_size = (numel + block_size - 1) / block_size;
+    tan_kernel<<<grid_size, block_size, 0, stream>>>(input, output, numel);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,75 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void custom_mean_reduce_launcher(const float* input,
+                                           float* output,
+                                           int batch_size,
+                                           long long elements_per_batch,
+                                           cudaStream_t stream);
+
+extern "C" void custom_tan_launcher(const float* input,
+                                    float* output,
+                                    int numel,
+                                    cudaStream_t stream);
+
+// custom_mean_reduce: torch.mean(x, dim=(1,2,3), keepdim=True)
+torch::Tensor custom_mean_reduce(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "custom_mean_reduce: input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "custom_mean_reduce: input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "custom_mean_reduce: input must be float32");
+    TORCH_CHECK(x.dim() == 4, "custom_mean_reduce: input must be 4D");
+    TORCH_CHECK(x.size(1) == 3 && x.size(2) == 2048 && x.size(3) == 2048,
+                "custom_mean_reduce: input shape must be [N, 3, 2048, 2048]");
+
+    int batch_size = static_cast<int>(x.size(0));
+    long long elements_per_batch = static_cast<long long>(x.size(1)) * x.size(2) * x.size(3);
+
+    auto output = torch::empty({batch_size, 1, 1, 1}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_mean_reduce_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        batch_size,
+        elements_per_batch,
+        stream
+    );
+
+    return output;
+}
+
+// custom_tan: torch.tan(x)
+torch::Tensor custom_tan(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "custom_tan: input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "custom_tan: input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "custom_tan: input must be float32");
+
+    auto output = torch::empty_like(x);
+
+    int numel = static_cast<int>(x.numel());
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_tan_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        numel,
+        stream
+    );
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_mean_reduce", &custom_mean_reduce, "Mean reduction over dims (1,2,3) with keepdim=True",
+          py::arg("x"));
+    m.def("custom_tan", &custom_tan, "Elementwise tangent",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
