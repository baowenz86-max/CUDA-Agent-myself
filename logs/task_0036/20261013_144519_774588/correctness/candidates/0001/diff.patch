--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,293 @@
+// custom_ops.cu - CUDA kernels and launchers for add, argmin, STFT
+#include <cuda_runtime.h>
+#include <cufft.h>
+#include <cmath>
+
+// -----------------------------------------------------------------------------
+// Add: output = x + y elementwise
+// -----------------------------------------------------------------------------
+template <typename T>
+__global__ void add_kernel(const T* __restrict__ x,
+                           const T* __restrict__ y,
+                           T* __restrict__ out,
+                           long long n) {
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (; idx < n; idx += stride) {
+        out[idx] = x[idx] + y[idx];
+    }
+}
+
+extern "C" cudaError_t add_forward_launcher(const float* x,
+                                            const float* y,
+                                            float* out,
+                                            long long n,
+                                            cudaStream_t stream) {
+    if (n == 0) return cudaSuccess;
+    const int threads = 256;
+    int blocks = (int)std::min<long long>((n + threads - 1) / threads, 1048576);
+    add_kernel<float><<<blocks, threads, 0, stream>>>(x, y, out, n);
+    cudaError_t err = cudaGetLastError();
+    return err;
+}
+
+// -----------------------------------------------------------------------------
+// Argmin over last dimension, keepdim=True. Input [B, N] -> output [B, 1] int64.
+// -----------------------------------------------------------------------------
+template <typename T>
+__global__ void argmin_lastdim_kernel(const T* __restrict__ x,
+                                      long long* __restrict__ out,
+                                      int N,
+                                      long long B) {
+    long long b = blockIdx.x;
+    if (b >= B) return;
+    const T* row = x + b * (long long)N;
+    int tid = threadIdx.x;
+    int stride = blockDim.x;
+    int best_idx = 0;
+    T best_val = row[0];
+    for (int i = tid; i < N; i += stride) {
+        T val = row[i];
+        if (val < best_val) {
+            best_val = val;
+            best_idx = i;
+        }
+    }
+    // Reduce within block using shared memory
+    extern __shared__ int s_indices[];
+    extern __shared__ float s_values[];
+    s_indices[tid] = best_idx;
+    s_values[tid] = (float)best_val;
+    __syncthreads();
+    for (int s = blockDim.x / 2; s > 0; s >>= 1) {
+        if (tid < s) {
+            if (s_values[tid + s] < s_values[tid]) {
+                s_values[tid] = s_values[tid + s];
+                s_indices[tid] = s_indices[tid + s];
+            }
+        }
+        __syncthreads();
+    }
+    if (tid == 0) out[b] = (long long)s_indices[0];
+}
+
+extern "C" cudaError_t argmin_launcher(const float* x,
+                                       long long* out,
+                                       int N,
+                                       long long B,
+                                       cudaStream_t stream) {
+    if (B == 0 || N == 0) return cudaSuccess;
+    int threads = std::min(1024, N);
+    int shared_bytes = threads * (sizeof(int) + sizeof(float));
+    dim3 grid((unsigned int)std::min<long long>(B, 1048576));
+    argmin_lastdim_kernel<float><<<grid, threads, shared_bytes, stream>>>(x, out, N, B);
+    cudaError_t err = cudaGetLastError();
+    return err;
+}
+
+// -----------------------------------------------------------------------------
+// STFT with cuFFT, center=True, reflect padding, Hann window, onesided output.
+// Input: [B, N] float32, output: [B, F, T] complex64 (interleaved float2).
+// F = n_fft/2 + 1, T = 1 + floor(N / hop_length).
+// -----------------------------------------------------------------------------
+extern "C" cudaError_t stft_forward_launcher(const float* x,
+                                            int B,
+                                            int N,
+                                            int n_fft,
+                                            int hop_length,
+                                            int win_length,
+                                            cufftComplex* out,
+                                            cudaStream_t stream) {
+    if (B == 0 || N == 0) return cudaSuccess;
+    const int F = n_fft / 2 + 1;
+    const int T = 1 + N / hop_length;
+    const int L = n_fft;
+
+    cufftHandle plan;
+    cufftResult result = cufftCreate(&plan);
+    if (result != CUFFT_SUCCESS) return cudaErrorUnknown;
+    result = cufftSetStream(plan, stream);
+    if (result != CUFFT_SUCCESS) { cufftDestroy(plan); return cudaErrorUnknown; }
+    // We will perform C2C transforms of size n_fft for each frame.
+    result = cufftPlan1d(&plan, n_fft, CUFFT_C2C, B * T);
+    if (result != CUFFT_SUCCESS) { cufftDestroy(plan); return cudaErrorUnknown; }
+
+    // Allocate workspace for windowed frames: complex input to C2C.
+    cufftComplex* d_frames;
+    cudaError_t err = cudaMallocAsync(&d_frames, (size_t)B * T * L * sizeof(cufftComplex), stream);
+    if (err != cudaSuccess) { cufftDestroy(plan); return err; }
+
+    // We need a Hann window of length win_length, centered, with zeros padding to n_fft.
+    // For simplicity, we compute the window on CPU and copy to device in a small buffer.
+    // This is a one-time per-call setup (could be cached, but bound by launcher simplicity).
+    float* h_window = new float[n_fft]();
+    int left = (n_fft - win_length) / 2;
+    for (int i = 0; i < win_length; ++i) {
+        h_window[left + i] = 0.5f * (1.0f - std::cos(2.0f * M_PI * i / (win_length - 1)));
+    }
+    float* d_window;
+    err = cudaMallocAsync(&d_window, n_fft * sizeof(float), stream);
+    if (err != cudaSuccess) { delete[] h_window; cudaFreeAsync(d_frames, stream); cufftDestroy(plan); return err; }
+    err = cudaMemcpyAsync(d_window, h_window, n_fft * sizeof(float), cudaMemcpyHostToDevice, stream);
+    if (err != cudaSuccess) {
+        delete[] h_window;
+        cudaFreeAsync(d_window, stream);
+        cudaFreeAsync(d_frames, stream);
+        cufftDestroy(plan);
+        return err;
+    }
+    delete[] h_window;
+
+    // Kernel to build frames: for each (b,t), extract a windowed segment with reflection padding.
+    // We launch a 2D grid: blockIdx.x for t, blockIdx.y for b.
+    {
+        dim3 block(256);
+        dim3 grid(T, B);
+        // Shared memory not needed; each thread handles one element of one frame.
+        auto build_frames = [] __device__ (int b, int t, const float* x, int N, int n_fft,
+                                          int hop_length, int win_length, const float* window,
+                                          cufftComplex* frames) {
+            int L = n_fft;
+            int start = t * hop_length - n_fft / 2;
+            for (int i = threadIdx.x; i < L; i += blockDim.x) {
+                int src_idx = b * N + start + i;
+                float val = 0.0f;
+                bool valid = (start + i >= 0) && (start + i < N);
+                if (!valid) {
+                    // reflect padding
+                    int idx = start + i;
+                    if (idx < 0) idx = -idx - 1;
+                    else if (idx >= N) idx = 2 * N - 1 - idx;
+                    if (idx >= 0 && idx < N) {
+                        idx = b * N + idx;
+                        val = x[idx];
+                    }
+                } else {
+                    val = x[src_idx];
+                }
+                frames[(b * T + t) * L + i].x = val * window[i];
+                frames[(b * T + t) * L + i].y = 0.0f;
+            }
+        };
+        // We can't use lambdas with __device__ in a kernel easily; create a proper kernel.
+        // Define a separate kernel below.
+    }
+
+    // Define the frame building kernel at file scope.
+    // For now, we'll define a global function below and call it here.
+    // (see stft_build_frames_kernel)
+    // Launch the kernel:
+    extern __global__ void stft_build_frames_kernel(const float* __restrict__ x,
+                                                   int B,
+                                                   int N,
+                                                   int n_fft,
+                                                   int hop_length,
+                                                   int win_length,
+                                                   const float* __restrict__ window,
+                                                   cufftComplex* __restrict__ frames,
+                                                   int T);
+
+    dim3 blockBuild(256);
+    dim3 gridBuild(T, B);
+    stft_build_frames_kernel<<<gridBuild, blockBuild, 0, stream>>>(
+        x, B, N, n_fft, hop_length, win_length, d_window, d_frames, T);
+    err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        cudaFreeAsync(d_window, stream);
+        cudaFreeAsync(d_frames, stream);
+        cufftDestroy(plan);
+        return err;
+    }
+
+    // Perform batched C2C FFT.
+    result = cufftExecC2C(plan, d_frames, d_frames, CUFFT_FORWARD);
+    if (result != CUFFT_SUCCESS) {
+        cudaFreeAsync(d_window, stream);
+        cudaFreeAsync(d_frames, stream);
+        cufftDestroy(plan);
+        return cudaErrorUnknown;
+    }
+
+    // Now output only positive frequencies (onesided) into out as interleaved complex.
+    // Out shape: [B, F, T], with F = n_fft/2 + 1. We need to copy from d_frames.
+    // d_frames layout: (b*T + t) * L + f for complex index f=0..n_fft-1 (only f=0..F-1 needed).
+    // We launch a kernel to extract and arrange.
+    extern __global__ void stft_extract_onesided_kernel(const cufftComplex* __restrict__ frames,
+                                                        cufftComplex* __restrict__ out,
+                                                        int B,
+                                                        int T,
+                                                        int L,
+                                                        int F);
+    dim3 blockExtract(256);
+    dim3 gridExtract((F * T + blockExtract.x - 1) / blockExtract.x, B);
+    stft_extract_onesided_kernel<<<gridExtract, blockExtract, 0, stream>>>(
+        d_frames, out, B, T, L, F);
+    err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        cudaFreeAsync(d_window, stream);
+        cudaFreeAsync(d_frames, stream);
+        cufftDestroy(plan);
+        return err;
+    }
+
+    // Free temporary buffers and destroy plan.
+    cudaFreeAsync(d_window, stream);
+    cudaFreeAsync(d_frames, stream);
+    cufftDestroy(plan);
+
+    return cudaSuccess;
+}
+
+// -----------------------------------------------------------------------------
+// Frame building kernel for STFT.
+// -----------------------------------------------------------------------------
+__global__ void stft_build_frames_kernel(const float* __restrict__ x,
+                                         int B,
+                                         int N,
+                                         int n_fft,
+                                         int hop_length,
+                                         int win_length,
+                                         const float* __restrict__ window,
+                                         cufftComplex* __restrict__ frames,
+                                         int T) {
+    int t = blockIdx.x;
+    int b = blockIdx.y;
+    if (t >= T || b >= B) return;
+    int L = n_fft;
+    int start = t * hop_length - n_fft / 2;
+    for (int i = threadIdx.x; i < L; i += blockDim.x) {
+        int idx = start + i;
+        float val = 0.0f;
+        if (idx >= 0 && idx < N) {
+            val = x[b * N + idx];
+        } else {
+            int reflected = idx;
+            if (reflected < 0) reflected = -reflected - 1;
+            else if (reflected >= N) reflected = 2 * N - 1 - reflected;
+            if (reflected >= 0 && reflected < N) {
+                val = x[b * N + reflected];
+            }
+        }
+        frames[(b * T + t) * L + i].x = val * window[i];
+        frames[(b * T + t) * L + i].y = 0.0f;
+    }
+}
+
+// -----------------------------------------------------------------------------
+// Extraction kernel: copy F positive frequencies for each (b,t) to output.
+// -----------------------------------------------------------------------------
+__global__ void stft_extract_onesided_kernel(const cufftComplex* __restrict__ frames,
+                                             cufftComplex* __restrict__ out,
+                                             int B,
+                                             int T,
+                                             int L,
+                                             int F) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int b = blockIdx.y;
+    if (b >= B) return;
+    int total = F * T;
+    if (idx >= total) return;
+    int f = idx % F;
+    int t = idx / F;
+    out[(b * F + f) * T + t] = frames[(b * T + t) * L + f];
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,134 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cufft.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" cudaError_t add_forward_launcher(const float* x,
+                                            const float* y,
+                                            float* out,
+                                            long long n,
+                                            cudaStream_t stream);
+
+extern "C" cudaError_t argmin_launcher(const float* x,
+                                       long long* out,
+                                       int N,
+                                       long long B,
+                                       cudaStream_t stream);
+
+extern "C" cudaError_t stft_forward_launcher(const float* x,
+                                            int B,
+                                            int N,
+                                            int n_fft,
+                                            int hop_length,
+                                            int win_length,
+                                            cufftComplex* out,
+                                            cudaStream_t stream);
+
+// -----------------------------------------------------------------------------
+// add_forward: elementwise x + y
+// -----------------------------------------------------------------------------
+torch::Tensor add_forward(torch::Tensor x, torch::Tensor y) {
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(y.is_cuda(), "y must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(y.dtype() == torch::kFloat32, "y must be float32");
+    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
+    TORCH_CHECK(y.is_contiguous(), "y must be contiguous");
+    TORCH_CHECK(x.sizes() == y.sizes(), "x and y must have the same shape");
+
+    auto output = torch::empty_like(x);
+    long long n = x.numel();
+    if (n == 0) return output;
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    cudaError_t err = add_forward_launcher(
+        x.data_ptr<float>(),
+        y.data_ptr<float>(),
+        output.data_ptr<float>(),
+        n,
+        stream
+    );
+    TORCH_CHECK(err == cudaSuccess, "add_forward_launcher failed with error: ", cudaGetErrorString(err));
+    return output;
+}
+
+// -----------------------------------------------------------------------------
+// argmin_lastdim_keepdim: argmin over last dim, keepdim=True
+// -----------------------------------------------------------------------------
+torch::Tensor argmin_lastdim_keepdim(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
+    TORCH_CHECK(x.dim() >= 1, "x must have at least 1 dimension");
+
+    int64_t N = x.size(-1);
+    TORCH_CHECK(N > 0, "last dimension size must be positive");
+    int64_t B = x.numel() / N;
+
+    auto options = torch::TensorOptions().dtype(torch::kInt64).device(x.device());
+    auto output = torch::empty({B, 1}, options);
+    if (B == 0) return output;
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    cudaError_t err = argmin_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<int64_t>(),
+        static_cast<int>(N),
+        static_cast<long long>(B),
+        stream
+    );
+    TORCH_CHECK(err == cudaSuccess, "argmin_launcher failed with error: ", cudaGetErrorString(err));
+    return output;
+}
+
+// -----------------------------------------------------------------------------
+// stft_forward: STFT with default center=True, pad_mode='reflect', onesided=True
+// -----------------------------------------------------------------------------
+torch::Tensor stft_forward(torch::Tensor x, int64_t n_fft, int64_t hop_length, int64_t win_length) {
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
+    TORCH_CHECK(x.dim() == 2, "x must be 2D [B, N]");
+    TORCH_CHECK(n_fft > 0 && hop_length > 0 && win_length > 0, "n_fft, hop_length, win_length must be positive");
+    TORCH_CHECK(win_length <= n_fft, "win_length must be <= n_fft");
+
+    int64_t B = x.size(0);
+    int64_t N = x.size(1);
+    int64_t F = n_fft / 2 + 1;
+    int64_t T = 1 + N / hop_length;
+
+    auto options = torch::TensorOptions().dtype(torch::kComplex64).device(x.device());
+    auto output = torch::empty({B, F, T}, options);
+    if (B == 0 || N == 0) return output;
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    cudaError_t err = stft_forward_launcher(
+        x.data_ptr<float>(),
+        static_cast<int>(B),
+        static_cast<int>(N),
+        static_cast<int>(n_fft),
+        static_cast<int>(hop_length),
+        static_cast<int>(win_length),
+        reinterpret_cast<cufftComplex*>(output.data_ptr<c10::complex<float>>()),
+        stream
+    );
+    TORCH_CHECK(err == cudaSuccess, "stft_forward_launcher failed with error: ", cudaGetErrorString(err));
+    return output;
+}
+
+// -----------------------------------------------------------------------------
+// Registration
+// -----------------------------------------------------------------------------
+void register_custom_ops(pybind11::module& m) {
+    m.def("add_forward", &add_forward, "Elementwise addition (x + y)",
+          py::arg("x"), py::arg("y"));
+    m.def("argmin_lastdim_keepdim", &argmin_lastdim_keepdim, "Argmin over last dimension with keepdim",
+          py::arg("x"));
+    m.def("stft_forward", &stft_forward, "STFT with Hann window, center=True, reflect padding, onesided",
+          py::arg("x"), py::arg("n_fft") = 1024, py::arg("hop_length") = 256, py::arg("win_length") = 1024);
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,26 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, n_fft, hop_length, win_length):
+        super().__init__()
+        self.n_fft = n_fft
+        self.hop_length = hop_length
+        self.win_length = win_length
+
+    def forward(self, x, y):
+        x = cuda_extension.add_forward(x, y)
+        argmin = cuda_extension.argmin_lastdim_keepdim(x)
+        stft = cuda_extension.stft_forward(x, self.n_fft, self.hop_length, self.win_length)
+        return x, argmin, stft
+
+    def debug_forward(self, x, y):
+        x = cuda_extension.add_forward(x, y)
+        yield 'step_001', x
+        argmin = cuda_extension.argmin_lastdim_keepdim(x)
+        yield 'step_002', argmin
+        stft = cuda_extension.stft_forward(x, self.n_fft, self.hop_length, self.win_length)
+        yield 'step_003', stft
+        yield 'step_004', (x, argmin, stft)
