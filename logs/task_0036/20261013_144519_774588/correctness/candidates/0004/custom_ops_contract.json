          "optional": false
        },
        {
          "name": "y",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, L]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
