      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[B, L]"
      },
      "semantics": [
        "对应参考语句 x = torch.add(x, y)。",
        "执行逐元素加法，输出 shape 与输入相同。",
        "输入为 CUDA float32 连续张量。"
      ]
    },
    {
      "name": "custom_argmin",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, L]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.int64",
        "device": "cuda",
        "shape": "[B, 1]"
      },
      "semantics": [
        "对应参考语句 argmin = torch.argmin(x, dim=-1, keepdim=True)。",
        "沿最后一维求最小值的索引，保持维度，输出 shape 为 [B, 1]，dtype 为 int64。",
        "输入为 CUDA float32 连续张量。"
      ]
    },
    {
      "name": "custom_stft",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, L]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "n_fft",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "hop_length",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "win_length",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "return_complex",
          "kind": "bool",
          "nullable": false,
          "optional": true,
          "default": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.complex64",
        "device": "cuda",
        "shape": "[B, N_freq, T_frames]"
      },
      "semantics": [
        "对应参考语句 stft = torch.stft(x, n_fft=self.n_fft, hop_length=self.hop_length, win_length=self.win_length, return_complex=True)。",
        "执行短时傅里叶变换，返回复数张量。",
        "输入为 CUDA float32 连续张量，参数 n_fft, hop_length, win_length 为整数。",
        "return_complex 参数默认值为 false，但在模型中固定传入 True。",
        "输出 shape 根据 stft 规则计算：频率维度为 n_fft//2+1，时间维度由输入长度、n_fft、hop_length 等决定，具体为 [B, 513, 782]。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = torch.add(x, y)",
      "semantics": [
        "逐元素加法，输入 x 和 y 都是 CUDA float32 连续张量，shape 相同，输出为相同 shape 的 CUDA float32 张量。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "argmin = torch.argmin(x, dim=-1, keepdim=True)",
