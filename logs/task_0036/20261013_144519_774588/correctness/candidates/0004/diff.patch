+// Device function: reflect padding index beyond boundaries
+__device__ int reflect_index(int idx, int len) {
+    if (idx < 0) idx = -idx;
+    if (idx >= len) {
+        int period = 2 * (len - 1);
+        idx = idx % period;
+        if (idx >= len) idx = period - idx;
+    }
+    return idx;
+}
