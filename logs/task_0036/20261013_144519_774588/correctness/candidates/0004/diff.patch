+    n_frames = 1 + (L + n_fft - n_fft) / hop_length; // center=True with reflect pad effectively adds n_fft/2 each side.
+    // Actually formula: n_frames = 1 + (L + n_fft/2 + n_fft/2 - n_fft) / hop_length = 1 + L / hop_length.
