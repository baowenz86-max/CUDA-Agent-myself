{
  "operators": [
    {
      "name": "custom_add",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[128, 200000]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "y",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[128, 200000]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[128, 200000]"
      },
      "semantics": [
        "对应 torch.add(x, y)，逐元素相加，无广播，输出形状与输入相同。",
        "输入张量必须为 CUDA float32 且连续。"
      ]
    },
    {
      "name": "custom_argmin",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[128, 200000]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.int64",
        "device": "cuda",
        "shape": "[128, 1]"
      },
      "semantics": [
        "对应 torch.argmin(x, dim=-1, keepdim=True)，沿最后一维求最小值的索引。",
        "输出形状 [128, 1]，dtype int64。"
      ]
    },
    {
      "name": "custom_stft",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[128, 200000]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "n_fft",
          "kind": "int",
          "default": 1024,
          "optional": false,
          "nullable": false
        },
        {
          "name": "hop_length",
          "kind": "int",
          "default": 256,
          "optional": false,
          "nullable": false
        },
        {
          "name": "win_length",
          "kind": "int",
          "default": 1024,
          "optional": false,
          "nullable": false
        },
        {
          "name": "return_complex",
          "kind": "bool",
          "default": true,
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.complex64",
        "device": "cuda",
        "shape": "[128, 513, 782]"
      },
      "semantics": [
        "对应 torch.stft(x, n_fft=n_fft, hop_length=hop_length, win_length=win_length, return_complex=True)。",
        "默认 center=True, pad_mode='reflect', normalized=False, onesided=True。",
        "输出为复数张量，形状 [batch, n_fft//2+1, num_frames]。",
        "num_frames 由输入长度、hop_length 等计算，此处为 782。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = torch.add(x, y)",
      "semantics": [
        "逐元素相加，输出 dtype float32，形状 [128, 200000]，设备 cuda。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "argmin = torch.argmin(x, dim=-1, keepdim=True)",
      "semantics": [
        "沿 dim=-1 求最小索引，keepdim=True 保留维度，形状 [128, 1]，dtype int64。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "stft = torch.stft(x, n_fft=self.n_fft, hop_length=self.hop_length, win_length=self.win_length, return_complex=True)",
      "semantics": [
        "STFT 返回复数张量，形状 [128, 513, 782]，dtype complex64。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return (x, argmin, stft)",
      "semantics": [
        "返回元组 (x, argmin, stft)，结构与参考一致。"
      ]
    }
  ]
}