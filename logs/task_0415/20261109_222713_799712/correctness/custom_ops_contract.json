          "name": "eps",
          "kind": "float",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C, H, W]"
      },
      "semantics": [
        "对应参考语句 return self.group_norm(x)，实现 GroupNorm：将输入张量 x 按通道分为 num_groups 组，每组内计算 (N, C_per_group, H, W) 上的均值和方差（有偏方差，使用 eps 稳定），然后对每组内每个元素执行 (x - mean) / sqrt(var + eps) 归一化，最后按通道乘以 weight 加上 bias。",
        "权重和偏置形状为 [C]，每个通道对应一个缩放和偏移。",
        "输出形状、dtype、device 与输入 x 保持一致。",
        "计算顺序：先计算每组逐元素均值，再计算有偏方差，然后归一化并应用 affine。"
      ]
    }
  ],
  "reference_steps": [
