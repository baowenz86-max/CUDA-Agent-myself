{
  "operators": [
    {
      "name": "custom_transpose",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda:0",
          "shape": "[512, 3, 256, 256]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda:0",
        "shape": "[512, 256, 256, 3]"
      },
      "semantics": [
        "对应于 torch.transpose(x, dim, -1)，交换维度 dim 与最后一维，返回新张量。",
        "保持原始 stride 关系，输出为非连续视图，不改变元素数据。",
        "输入必须为 CUDA float32 张量，dim 为整数。"
      ]
    },
    {
      "name": "custom_cat_2x",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda:0",
          "shape": "[512, 256, 256, 3]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda:0",
        "shape": "[512, 256, 256, 6]"
      },
      "semantics": [
        "对应于 torch.cat([x, x], dim=-1)，沿最后一维将同一张量拼接两次。",
        "输出形状在最后一维翻倍，其他维度不变。",
        "输出内存连续，拼接顺序为先原始 x 后复制 x。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = torch.transpose(x, self.dim, -1)",
      "semantics": [
        "执行转置操作，交换 dim 维度和最后一维。",
        "输出形状为 [512, 256, 256, 3]，stride 为 [196608, 1, 256, 65536]。",
        "返回新张量，保持数据不变。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.cat([x, x], dim=-1)",
      "semantics": [
        "沿最后一维拼接两个相同的转置后张量。",
        "输出形状为 [512, 256, 256, 6]，stride 为 [393216, 1536, 6, 1]。",
        "返回新连续张量，前半部分为原始数据，后半部分为复制数据。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回拼接后的张量，与 step_002 相同。"
      ]
    }
  ]
}