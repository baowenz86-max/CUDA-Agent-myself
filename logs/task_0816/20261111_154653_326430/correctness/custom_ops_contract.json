{
  "operators": [
    {
      "name": "upsample_bilinear2d",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, channels, in_h, in_w]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "scale_factor",
          "kind": "float",
          "default": 2.0,
          "nullable": false,
          "optional": true
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, channels, floor(in_h*scale_factor), floor(in_w*scale_factor)]"
      },
      "semantics": [
        "对应参考语句 x = self.upsample(x)，实际使用 nn.Upsample(scale_factor=2.0, mode='bilinear') 上采样；scale_factor 统一作用于空间维度。",
        "采用 bilinear 插值，align_corners=False，输出尺寸为 floor(input_h*scale_factor), floor(input_w*scale_factor)。",
        "支持多通道 4D 输入，保持 batch 和 channel 维度，仅缩放最后两个空间维度。",
        "实现算法应与 PyTorch F.interpolate(mode='bilinear') 计算结果一致（atol=1e-2/rtol=1e-2）。"
      ]
    },
    {
      "name": "mean_dim1_keepdim",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, channels, height, width]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, 1, height, width]"
      },
      "semantics": [
        "对应参考语句 x = torch.mean(x, dim=1, keepdim=True)，在通道维度 dim=1 上计算均值并保持维度。",
        "输出形状为 [batch, 1, height, width]，每个空间位置为输入所有通道的平均值。",
        "归约顺序为逐 batch、逐 height、逐 width，对 channel 求和后除以 channels。",
        "无偏差校正，直接平均值。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.upsample(x)",
      "semantics": [
        "对输入 [128,3,512,256] 进行 bilinear 上采样，scale_factor=2.0，输出 [128,3,1024,512]，dtype 和 device 不变。",
        "插值模式为 bilinear，align_corners=False。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.mean(x, dim=1, keepdim=True)",
      "semantics": [
        "对 [128,3,1024,512] 在 dim=1 计算均值，保持维度，输出 [128,1,1024,512]。",
        "每个 batch 和空间位置计算通道均值。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回上一步的均值结果 [128,1,1024,512]。"
      ]
    }
  ]
}