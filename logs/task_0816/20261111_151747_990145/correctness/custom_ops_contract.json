{
  "operators": [
    {
      "name": "custom_upsample_bilinear2d",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "scale_factor",
          "kind": "float",
          "optional": false,
          "nullable": false
        },
        {
          "name": "align_corners",
          "kind": "bool",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C, H*scale_factor, W*scale_factor]"
      },
      "semantics": [
        "对输入 x 执行双线性上采样，scale_factor 为浮点数，align_corners=False",
        "输出高度 = floor(H * scale_factor)，输出宽度 = floor(W * scale_factor)，参考 nn.Upsample 行为",
        "输入必须为 CUDA float32 连续张量"
      ]
    },
    {
      "name": "custom_mean_dim1_keepdim",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, 1, H, W]"
      },
      "semantics": [
        "沿 dim=1（通道维）计算均值，并保持维度（keepdim=True）",
        "输出形状为 [N, 1, H, W]，每个空间位置计算所有通道的平均值"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.upsample(x)",
      "semantics": [
        "对输入 x 应用 nn.Upsample(scale_factor=2, mode='bilinear')，align_corners 默认为 False",
        "输出形状 [128, 3, 1024, 512]，dtype float32，device cuda"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.mean(x, dim=1, keepdim=True)",
      "semantics": [
        "沿通道维 dim=1 计算均值，keepdim=True，输出形状 [128, 1, 1024, 512]",
        "输出 dtype float32，device cuda"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回最终张量，形状 [128, 1, 1024, 512]，dtype float32，device cuda"
      ]
    }
  ]
}