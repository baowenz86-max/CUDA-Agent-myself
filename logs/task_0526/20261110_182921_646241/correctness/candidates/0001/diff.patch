--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,45 @@
+// CUDA kernel for element-wise subtraction of a scalar.
+// Only float32 dtype is implemented, as required by the contract.
+#include <cuda_runtime.h>
+
+// Kernel: out[i] = in[i] - scalar
+// grid-stride loop to handle arbitrary number of elements
+__global__ void scalar_subtract_kernel(const float* __restrict__ input,
+                                       float* __restrict__ output,
+                                       float scalar,
+                                       long long num_elements) {
+    long long idx = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (long long i = idx; i < num_elements; i += stride) {
+        output[i] = input[i] - scalar;
+    }
+}
+
+// Launcher function to be called from the binding layer.
+// Parameters:
+//   - input: pointer to input tensor data (CUDA float*)
+//   - output: pointer to output tensor data (CUDA float*)
+//   - scalar: the scalar value (float)
+//   - num_elements: total number of elements
+//   - stream: CUDA stream to launch kernel on
+extern "C" void subtract_scalar_launcher(const float* input,
+                                         float* output,
+                                         float scalar,
+                                         long long num_elements,
+                                         cudaStream_t stream) {
+    // Use 256 threads per block.
+    const int threads = 256;
+    // Compute number of blocks, but cap to reasonable number to avoid launch failure
+    // while still ensuring coverage via grid-stride loop.
+    long long blocks_ll = (num_elements + threads - 1) / threads;
+    // Limit blocks to 65535 (max gridDim.x for older GPUs), but since we use grid-stride,
+    // a smaller grid still covers all elements. Choose min(blocks_ll, 65535).
+    int blocks = (int)(blocks_ll < 65535 ? blocks_ll : 65535);
+    if (blocks == 0) {
+        blocks = 1;  // launch at least one block even for empty tensors? 
+        // Actually for empty tensor num_elements=0, we can skip launch.
+        // But to be safe, if num_elements==0, return without launching.
+        return;
+    }
+    scalar_subtract_kernel<<<blocks, threads, 0, stream>>>(input, output, scalar, num_elements);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,57 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declaration of launcher from custom_ops.cu
+extern "C" void subtract_scalar_launcher(const float* input,
+                                         float* output,
+                                         float scalar,
+                                         long long num_elements,
+                                         cudaStream_t stream);
+
+// Wrapper function for subtract_scalar
+torch::Tensor subtract_scalar(torch::Tensor x, torch::Tensor scalar) {
+    // Check x is CUDA float32
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+
+    // Check scalar is CPU float32 scalar tensor
+    TORCH_CHECK(scalar.is_cpu(), "scalar must be a CPU tensor");
+    TORCH_CHECK(scalar.dtype() == torch::kFloat32, "scalar must be float32");
+    TORCH_CHECK(scalar.numel() == 1, "scalar must have exactly one element");
+
+    // Ensure x is contiguous; if not, make contiguous copy
+    torch::Tensor x_contig = x.contiguous();
+
+    // Allocate output with same shape and options as x_contig
+    torch::Tensor output = torch::empty_like(x_contig);
+
+    // Extract scalar value
+    float scalar_value = scalar.item<float>();
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    subtract_scalar_launcher(
+        x_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        scalar_value,
+        x_contig.numel(),
+        stream
+    );
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("subtract_scalar", &subtract_scalar,
+          "Subtract a scalar from a tensor",
+          py::arg("x"), py::arg("scalar"));
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,17 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, input_size, subtract_value):
+        super().__init__()
+        self.subtract_value = subtract_value
+
+    def forward(self, x):
+        return cuda_extension.subtract_scalar(x, self.subtract_value)
+
+    def debug_forward(self, *inputs):
+        x = inputs[0]
+        result = cuda_extension.subtract_scalar(x, self.subtract_value)
+        yield 'step_001', result
