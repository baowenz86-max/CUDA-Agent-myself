      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[B, L, embedding_dim]"
      },
      "semantics": [
        "对应模型中的 self.embedding(x)：根据索引 input 从 weight 中查表，输出 shape 为 [输入 shape..., embedding_dim]。",
        "索引越界行为与 PyTorch embedding 一致（不校验，由 CUDA 实际访问决定）。",
        "输入应为 CUDA int64 张量；若 CPU 输入，由调用方在 Python 侧移动或由 binding 检查。",
        "输出为连续的 float32 CUDA 张量，shape 由输入 shape + embedding_dim 组成。"
      ]
    },
    {
      "name": "scalar_mul_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "任意浮点张量",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "scalar",
          "kind": "float",
          "dtype": null,
          "device": null,
          "shape": null,
          "layout": null,
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "同 input"
      },
      "semantics": [
        "对应模型中的 x = x * self.scalar，执行逐元素标量乘法。",
        "scalar 为 Python float/double，内存中的张量元素均与其相乘。",
        "输出为新的 float32 CUDA 张量，shape/stride 与 input 一致。",
        "不会修改原输入张量。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.embedding(x)",
      "semantics": [
        "输入 x 为 int64 张量，shape [128,4096]，执行查表，输出 float32 张量，shape [128,4096,256]，device cuda:0。",
        "embedding 权重为 [1000,256] float32，查表按最后一维扩展。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = x * self.scalar",
      "semantics": [
        "对 embedding 输出进行逐元素标量乘法，scalar_value 为 0.5，输出 shape 不变，dtype float32。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "最终返回 shape [128,4096,256] 的 float32 CUDA 张量。"
      ]
    }
  ]
}