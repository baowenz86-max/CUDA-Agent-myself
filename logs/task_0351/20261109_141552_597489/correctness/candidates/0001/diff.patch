--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,113 @@
+// CUDA kernels for embedding_forward and scalar_mul_forward
+// This file contains only CUDA kernels and launchers with raw pointers,
+// scalars and cudaStream_t. No torch/ATen/pybind dependencies.
+
+#include <cuda_runtime.h>
+#include <stdint.h>
+
+// Embedding lookup kernel:
+// input: int64 indices of shape [B, L] (total elements = batch * length)
+// weight: float32 embedding table of shape [num_embeddings, embedding_dim]
+// output: float32 tensor of shape [B, L, embedding_dim], contiguous
+// Each thread processes one output element.
+__global__ void embedding_forward_kernel(
+    const int64_t* __restrict__ input,
+    const float* __restrict__ weight,
+    float* __restrict__ output,
+    int64_t total_input_elements,
+    int64_t embedding_dim) {
+
+    int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    int64_t stride = static_cast<int64_t>(blockDim.x) * gridDim.x;
+
+    for (; idx < total_input_elements * embedding_dim; idx += stride) {
+        // Determine which input index and which embedding component this thread handles
+        int64_t input_offset = idx / embedding_dim;
+        int64_t dim_offset = idx - input_offset * embedding_dim;
+
+        int64_t token_idx = input[input_offset];
+        // No bounds checking: mimics PyTorch behavior, undefined for out-of-range indices.
+        output[input_offset * embedding_dim + dim_offset] = weight[token_idx * embedding_dim + dim_offset];
+    }
+}
+
+// Scalar multiplication kernel:
+// input: float32 contiguous tensor of total numel elements
+// output: float32 contiguous tensor of same shape
+// Each thread processes one element.
+__global__ void scalar_mul_forward_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    float scalar,
+    int64_t numel) {
+
+    int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    int64_t stride = static_cast<int64_t>(blockDim.x) * gridDim.x;
+
+    for (; idx < numel; idx += stride) {
+        output[idx] = input[idx] * scalar;
+    }
+}
+
+// Launcher for embedding_forward
+// Parameters:
+//   input: pointer to int64 indices (size = B*L)
+//   weight: pointer to float32 embedding table (size = num_embeddings * embedding_dim)
+//   output: pointer to float32 output (size = B*L*embedding_dim), already allocated
+//   batch: number of rows in input (not used directly except for total elements)
+//   length: number of columns in input
+//   embedding_dim: dimension of each embedding vector
+//   stream: CUDA stream to launch kernel on
+// Note: total input elements = batch * length. The caller must ensure pointers are valid.
+extern "C" void embedding_forward_launcher(
+    const int64_t* input,
+    const float* weight,
+    float* output,
+    int64_t batch,
+    int64_t length,
+    int64_t embedding_dim,
+    cudaStream_t stream) {
+
+    int64_t total_input_elements = batch * length;
+    int64_t total_output_elements = total_input_elements * embedding_dim;
+
+    if (total_input_elements == 0 || embedding_dim == 0 || total_output_elements == 0) {
+        return;
+    }
+
+    // Use a 1D grid. Choose threads and blocks to cover all output elements.
+    int threads = 256;
+    // Ensure grid does not exceed limits (use int for grid dim, cast from int64_t)
+    int64_t blocks_64 = (total_output_elements + threads - 1) / threads;
+    // Cap blocks to a reasonable value; grid-stride loop handles excess work.
+    int blocks = (blocks_64 > 65535) ? 65535 : static_cast<int>(blocks_64);
+
+    embedding_forward_kernel<<<blocks, threads, 0, stream>>>(
+        input, weight, output, total_input_elements, embedding_dim);
+}
+
+// Launcher for scalar_mul_forward
+// Parameters:
+//   input: pointer to float32 input tensor (numel elements)
+//   output: pointer to float32 output tensor (same numel), already allocated
+//   scalar: float multiplier
+//   numel: number of elements in input/output
+//   stream: CUDA stream to launch kernel on
+extern "C" void scalar_mul_forward_launcher(
+    const float* input,
+    float* output,
+    float scalar,
+    int64_t numel,
+    cudaStream_t stream) {
+
+    if (numel == 0) {
+        return;
+    }
+
+    int threads = 256;
+    int64_t blocks_64 = (numel + threads - 1) / threads;
+    int blocks = (blocks_64 > 65535) ? 65535 : static_cast<int>(blocks_64);
+
+    scalar_mul_forward_kernel<<<blocks, threads, 0, stream>>>(
+        input, output, scalar, numel);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,102 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void embedding_forward_launcher(
+    const int64_t* input,
+    const float* weight,
+    float* output,
+    int64_t batch,
+    int64_t length,
+    int64_t embedding_dim,
+    cudaStream_t stream);
+
+extern "C" void scalar_mul_forward_launcher(
+    const float* input,
+    float* output,
+    float scalar,
+    int64_t numel,
+    cudaStream_t stream);
+
+// Embedding forward wrapper
+torch::Tensor embedding_forward(torch::Tensor input, torch::Tensor weight) {
+    // Check input tensor
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kInt64, "input must be int64");
+    TORCH_CHECK(input.dim() >= 1, "input must have at least 1 dimension");
+    TORCH_CHECK(input.is_contiguous(), "input must be contiguous");
+
+    // Check weight tensor
+    TORCH_CHECK(weight.is_cuda(), "weight must be a CUDA tensor");
+    TORCH_CHECK(weight.dtype() == torch::kFloat32, "weight must be float32");
+    TORCH_CHECK(weight.dim() == 2, "weight must be 2D");
+    TORCH_CHECK(weight.is_contiguous(), "weight must be contiguous");
+
+    // Get dimensions
+    auto input_sizes = input.sizes(); // vector<int64_t>
+    int64_t num_input_elements = input.numel();
+    int64_t embedding_dim = weight.size(1);
+
+    // Allocate output: shape = input_sizes + [embedding_dim]
+    std::vector<int64_t> output_sizes(input_sizes.begin(), input_sizes.end());
+    output_sizes.push_back(embedding_dim);
+    auto output = torch::empty(output_sizes, input.options().dtype(torch::kFloat32));
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // The launcher expects batch and length as separate dimensions.
+    // For arbitrary input shape, we pass num_input_elements as batch and length=1,
+    // but the kernel uses total_input_elements = batch * length.
+    // To ensure correct indexing, we can pass batch = num_input_elements, length = 1.
+    // The kernel output is then total_input_elements * embedding_dim.
+    // Note: For shape [B, L], this works as expected because the output is flattened
+    // and contiguous. The kernel's indexing uses (input_offset * embedding_dim + dim_offset),
+    // so it works regardless of input rank, as long as total output elements match.
+    embedding_forward_launcher(
+        input.data_ptr<int64_t>(),
+        weight.data_ptr<float>(),
+        output.data_ptr<float>(),
+        num_input_elements, // batch
+        1,                 // length
+        embedding_dim,
+        stream
+    );
+
+    return output;
+}
+
+// Scalar multiplication wrapper
+torch::Tensor scalar_mul_forward(torch::Tensor input, double scalar) {
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(input.is_contiguous(), "input must be contiguous");
+
+    auto output = torch::empty_like(input);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    scalar_mul_forward_launcher(
+        input.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<float>(scalar),
+        input.numel(),
+        stream
+    );
+
+    return output;
+}
+
+// Register both functions
+void register_custom_ops(pybind11::module& m) {
+    m.def("embedding_forward", &embedding_forward, "Embedding lookup forward",
+          py::arg("input"), py::arg("weight"));
+    m.def("scalar_mul_forward", &scalar_mul_forward, "Scalar multiplication forward",
+          py::arg("input"), py::arg("scalar"));
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,31 @@
+import torch
+import torch.nn as nn
+
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, num_embeddings, embedding_dim, scalar_value):
+        super().__init__()
+        self.embedding = nn.Embedding(num_embeddings, embedding_dim)
+        self.scalar = torch.scalar_tensor(scalar_value)
+
+    def forward(self, x):
+        # Move input to CUDA if needed (binding can also enforce)
+        if not x.is_cuda:
+            x = x.cuda()
+        x = cuda_extension.embedding_forward(x, self.embedding.weight)
+        x = cuda_extension.scalar_mul_forward(x, float(self.scalar))
+        return x
+
+    def debug_forward(self, *inputs):
+        # Unpack inputs; expected single tensor
+        x = inputs[0]
+        if not x.is_cuda:
+            x = x.cuda()
+        x = cuda_extension.embedding_forward(x, self.embedding.weight)
+        yield 'step_001', x
+        x = cuda_extension.scalar_mul_forward(x, float(self.scalar))
+        yield 'step_002', x
+        yield 'step_003', x
+        return
