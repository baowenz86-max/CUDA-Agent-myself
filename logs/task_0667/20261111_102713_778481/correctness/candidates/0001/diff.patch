--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,249 @@
+#include <cuda_runtime.h>
+
+// Kernel: concatenate two tensors along dim=1.
+// Inputs: x1, x2 are 4D tensors of shape [N, C1, H, W] and [N, C2, H, W]
+// Output: out of shape [N, C1+C2, H, W]
+// All tensors are float32, contiguous is not assumed; strides passed as parameters.
+// dim fixed to 1 (but general structure could extend).
+__global__ void cat_kernel(
+    float* __restrict__ out,
+    const float* __restrict__ x1,
+    const float* __restrict__ x2,
+    int N, int C1, int C2, int H, int W,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h,
+    long long x1_stride_n, long long x1_stride_c, long long x1_stride_h,
+    long long x2_stride_n, long long x2_stride_c, long long x2_stride_h,
+    long long total_elements
+) {
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= total_elements) return;
+
+    // Decompose linear output index into (n, c, h, w)
+    int w = idx % W;
+    long long tmp = idx / W;
+    int h = tmp % H;
+    tmp /= H;
+    int c = tmp % (C1 + C2);
+    int n = tmp / (C1 + C2);
+
+    const float* src;
+    long long src_stride_n, src_stride_c, src_stride_h;
+    int src_c;
+    if (c < C1) {
+        src = x1;
+        src_stride_n = x1_stride_n;
+        src_stride_c = x1_stride_c;
+        src_stride_h = x1_stride_h;
+        src_c = c;
+    } else {
+        src = x2;
+        src_stride_n = x2_stride_n;
+        src_stride_c = x2_stride_c;
+        src_stride_h = x2_stride_h;
+        src_c = c - C1;
+    }
+
+    long long src_idx = n * src_stride_n + src_c * src_stride_c + h * src_stride_h + w;
+    long long out_idx = n * out_stride_n + c * out_stride_c + h * out_stride_h + w;
+    out[out_idx] = src[src_idx];
+}
+
+// Kernel: compute mean squared error over all elements.
+// Each block reduces partial sums in shared memory, then atomically adds to global accumulator.
+// After all blocks finish, a separate kernel divides by num_elements.
+__global__ void mse_loss_partial_kernel(
+    const float* __restrict__ input,
+    const float* __restrict__ target,
+    float* __restrict__ accumulator,
+    long long total_elements
+) {
+    extern __shared__ float sdata[];
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = blockDim.x * gridDim.x;
+    float local_sum = 0.0f;
+    for (long long i = idx; i < total_elements; i += stride) {
+        float diff = input[i] - target[i];
+        local_sum += diff * diff;
+    }
+    sdata[threadIdx.x] = local_sum;
+    __syncthreads();
+
+    // Reduction within block
+    for (int s = blockDim.x / 2; s > 0; s >>= 1) {
+        if (threadIdx.x < s) {
+            sdata[threadIdx.x] += sdata[threadIdx.x + s];
+        }
+        __syncthreads();
+    }
+
+    if (threadIdx.x == 0) {
+        atomicAdd(accumulator, sdata[0]);
+    }
+}
+
+__global__ void mse_loss_finalize_kernel(
+    float* __restrict__ result,
+    const float* __restrict__ accumulator,
+    float inv_num_elements
+) {
+    if (threadIdx.x == 0 && blockIdx.x == 0) {
+        *result = (*accumulator) * inv_num_elements;
+    }
+}
+
+// Launcher for cat_forward.
+// Contract: x1, x2 are CUDA float32 tensors; dim=1.
+// Returns output tensor (float32, same shape as torch.cat((x1,x2), dim=1)).
+extern "C" void cat_forward_launcher(
+    float* out,
+    const float* x1,
+    const float* x2,
+    int N, int C1, int C2, int H, int W,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h,
+    long long x1_stride_n, long long x1_stride_c, long long x1_stride_h,
+    long long x2_stride_n, long long x2_stride_c, long long x2_stride_h,
+    cudaStream_t stream
+) {
+    long long total_elements = (long long)N * (C1 + C2) * H * W;
+    if (total_elements <= 0) return;
+
+    const int block_size = 256;
+    int grid_size = (int)((total_elements + block_size - 1) / block_size);
+    if (grid_size > 65535) {
+        // Cap grid and use grid-stride loop? Kernel currently uses one element per thread in cat_kernel.
+        // For simplicity, keep grid_stride loop for cat as well (or use large grid). Modify cat_kernel to support grid-stride.
+        // Actually cat_kernel currently does one element per thread; if grid>65535, we need grid-stride loop.
+        // Since total_elements = 512*32*128*128 = 268,435,456, grid_size=1,048,576 > 65535.
+        // So we must implement grid-stride loop in cat_kernel. Rewrite cat_kernel to loop.
+        // We'll fix cat_kernel accordingly (see code below).
+    }
+
+    // For now, we use a grid-stride loop in cat_kernel over the total elements.
+    // Need to pass total_elements and stride between elements (1) for grid-stride.
+    // Actually, grid-stride loop requires each thread to handle multiple elements, so we need a loop in kernel.
+    // We'll implement cat_kernel with grid-stride and use a fixed grid size <= 65535 (e.g., 4096 blocks * 256 threads = 1,048,576 threads, still more than max elements? Actually total elements is 268M, so grid-stride loop needed).
+    // We will set grid = min(65535, ceil(total_elements/block_size)) and use grid-stride in kernel.
+    // But grid-stride loop needs total_elements. So we add total_elements as parameter.
+    // However, cat_kernel above currently has total_elements as parameter but no loop. We'll modify.
+}
+
+// Actual implementation with grid-stride loop for cat.
+__global__ void cat_kernel_grid_stride(
+    float* __restrict__ out,
+    const float* __restrict__ x1,
+    const float* __restrict__ x2,
+    int N, int C1, int C2, int H, int W,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h,
+    long long x1_stride_n, long long x1_stride_c, long long x1_stride_h,
+    long long x2_stride_n, long long x2_stride_c, long long x2_stride_h,
+    long long total_elements
+) {
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = blockDim.x * gridDim.x;
+    for (long long i = idx; i < total_elements; i += stride) {
+        int w = i % W;
+        long long tmp = i / W;
+        int h = tmp % H;
+        tmp /= H;
+        int c = tmp % (C1 + C2);
+        int n = tmp / (C1 + C2);
+
+        const float* src;
+        long long src_stride_n, src_stride_c, src_stride_h;
+        int src_c;
+        if (c < C1) {
+            src = x1;
+            src_stride_n = x1_stride_n;
+            src_stride_c = x1_stride_c;
+            src_stride_h = x1_stride_h;
+            src_c = c;
+        } else {
+            src = x2;
+            src_stride_n = x2_stride_n;
+            src_stride_c = x2_stride_c;
+            src_stride_h = x2_stride_h;
+            src_c = c - C1;
+        }
+
+        long long src_idx = n * src_stride_n + src_c * src_stride_c + h * src_stride_h + w;
+        long long out_idx = n * out_stride_n + c * out_stride_c + h * out_stride_h + w;
+        out[out_idx] = src[src_idx];
+    }
+}
+
+// Launcher for cat_forward (grid-stride version)
+extern "C" void cat_forward_launcher(
+    float* out,
+    const float* x1,
+    const float* x2,
+    int N, int C1, int C2, int H, int W,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h,
+    long long x1_stride_n, long long x1_stride_c, long long x1_stride_h,
+    long long x2_stride_n, long long x2_stride_c, long long x2_stride_h,
+    cudaStream_t stream
+) {
+    long long total_elements = (long long)N * (C1 + C2) * H * W;
+    if (total_elements <= 0) return;
+
+    const int block_size = 256;
+    // Compute grid size capped at 65535 (max grid dimension in x).
+    int grid_size = (int)min((long long)65535, (total_elements + block_size - 1) / block_size);
+    if (grid_size <= 0) grid_size = 1;
+
+    cat_kernel_grid_stride<<<grid_size, block_size, 0, stream>>>(
+        out, x1, x2,
+        N, C1, C2, H, W,
+        out_stride_n, out_stride_c, out_stride_h,
+        x1_stride_n, x1_stride_c, x1_stride_h,
+        x2_stride_n, x2_stride_c, x2_stride_h,
+        total_elements
+    );
+}
+
+// Launcher for mse_loss_forward.
+// Contract: input, target are CUDA float32 tensors of same shape.
+// Output is scalar float32 tensor (mean squared error).
+extern "C" void mse_loss_forward_launcher(
+    float* result,
+    const float* input,
+    const float* target,
+    long long total_elements,
+    cudaStream_t stream
+) {
+    if (total_elements <= 0) {
+        // For empty tensors, PyTorch mse_loss returns nan? Actually F.mse_loss on empty returns nan.
+        // But contract likely not used with empty. We'll handle by setting result to nan.
+        // However, we cannot call nan without CUDA; we can launch a kernel to write nan or use cudaMemsetAsync with bits.
+        // We'll assume non-empty for now.
+        return;
+    }
+
+    // Allocate temporary accumulator on device (one float).
+    float* d_accumulator;
+    cudaMalloc(&d_accumulator, sizeof(float));
+    // Initialize to zero.
+    cudaMemsetAsync(d_accumulator, 0, sizeof(float), stream);
+
+    const int block_size = 256;
+    // Use 1024 blocks (enough parallelism).
+    int grid_size = 1024;
+    // Shared memory size per block: block_size * sizeof(float)
+    size_t shmem_size = block_size * sizeof(float);
+
+    mse_loss_partial_kernel<<<grid_size, block_size, shmem_size, stream>>>(
+        input, target, d_accumulator, total_elements
+    );
+
+    // Finalize: divide by total_elements, write to result.
+    // We use a single block kernel with one thread.
+    mse_loss_finalize_kernel<<<1, 1, 0, stream>>>(
+        result, d_accumulator, 1.0f / (float)total_elements
+    );
+
+    // Ensure accumulator memory freed after kernel completion.
+    // We can use cudaFree after synchronization, but stream is asynchronous.
+    // For simplicity, use cudaStreamSynchronize(stream) before cudaFree.
+    // But this will block host; acceptable for correctness.
+    cudaStreamSynchronize(stream);
+    cudaFree(d_accumulator);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,105 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void cat_forward_launcher(
+    float* out,
+    const float* x1,
+    const float* x2,
+    int N, int C1, int C2, int H, int W,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h,
+    long long x1_stride_n, long long x1_stride_c, long long x1_stride_h,
+    long long x2_stride_n, long long x2_stride_c, long long x2_stride_h,
+    cudaStream_t stream
+);
+
+extern "C" void mse_loss_forward_launcher(
+    float* result,
+    const float* input,
+    const float* target,
+    long long total_elements,
+    cudaStream_t stream
+);
+
+// PyTorch wrapper for cat_forward
+torch::Tensor cat_forward(torch::Tensor x1, torch::Tensor x2, int64_t dim) {
+    TORCH_CHECK(x1.is_cuda(), "x1 must be a CUDA tensor");
+    TORCH_CHECK(x2.is_cuda(), "x2 must be a CUDA tensor");
+    TORCH_CHECK(x1.dtype() == torch::kFloat32, "x1 must be float32");
+    TORCH_CHECK(x2.dtype() == torch::kFloat32, "x2 must be float32");
+    TORCH_CHECK(x1.dim() == 4, "x1 must be 4D");
+    TORCH_CHECK(x2.dim() == 4, "x2 must be 4D");
+    TORCH_CHECK(x1.size(0) == x2.size(0), "batch dim mismatch");
+    TORCH_CHECK(x1.size(2) == x2.size(2) && x1.size(3) == x2.size(3), "spatial dims mismatch");
+    TORCH_CHECK(dim == 1, "only dim=1 is supported");
+
+    int N = x1.size(0);
+    int C1 = x1.size(1);
+    int C2 = x2.size(1);
+    int H = x1.size(2);
+    int W = x1.size(3);
+    int C_out = C1 + C2;
+
+    // Allocate output tensor on CUDA, float32, contiguous
+    auto out = torch::empty({N, C_out, H, W}, x1.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher with pointers and strides
+    cat_forward_launcher(
+        out.data_ptr<float>(),
+        x1.data_ptr<float>(),
+        x2.data_ptr<float>(),
+        N, C1, C2, H, W,
+        out.stride(0), out.stride(1), out.stride(2),
+        x1.stride(0), x1.stride(1), x1.stride(2),
+        x2.stride(0), x2.stride(1), x2.stride(2),
+        stream
+    );
+
+    return out;
+}
+
+torch::Tensor mse_loss_forward(torch::Tensor input, torch::Tensor target) {
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(target.is_cuda(), "target must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(target.dtype() == torch::kFloat32, "target must be float32");
+    TORCH_CHECK(input.sizes() == target.sizes(), "input and target must have the same shape");
+
+    long long total_elements = input.numel();
+    if (total_elements == 0) {
+        // Return nan scalar tensor to mimic PyTorch behavior for empty MSE
+        return torch::full({}, NAN, input.options());
+    }
+
+    // Allocate scalar output tensor on CUDA
+    auto result = torch::empty({}, input.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    mse_loss_forward_launcher(
+        result.data_ptr<float>(),
+        input.data_ptr<float>(),
+        target.data_ptr<float>(),
+        total_elements,
+        stream
+    );
+
+    return result;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("cat_forward", &cat_forward,
+          "Concatenate two tensors along dim=1",
+          py::arg("x1"), py::arg("x2"), py::arg("dim"));
+    m.def("mse_loss_forward", &mse_loss_forward,
+          "Mean squared error loss",
+          py::arg("input"), py::arg("target"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
