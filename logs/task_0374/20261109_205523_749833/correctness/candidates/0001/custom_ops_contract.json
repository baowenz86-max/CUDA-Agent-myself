{
  "operators": [
    {
      "name": "custom_embedding_layernorm",
      "parameters": [
        {
          "name": "indices",
          "kind": "tensor",
          "dtype": "torch.int64",
          "device": "cuda",
          "shape": "[batch_size, seq_length]",
          "layout": "contiguous or supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "embedding_weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[num_embeddings, embedding_dim]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "gamma",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[embedding_dim]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "beta",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[embedding_dim]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "optional": false,
          "nullable": false
        },
        {
          "name": "num_embeddings",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "embedding_dim",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, seq_length, embedding_dim]",
        "layout": "contiguous"
      },
      "semantics": [
        "For each index in indices (shape [B, L]), gather row embedding_weight[index] of shape [D].",
        "Compute per-token mean and variance over the D-dimensional embedding vector (unbiased=False).",
        "Normalize: (x - mean) / sqrt(var + eps).",
        "Apply affine transformation: result * gamma + beta.",
        "Output shape [B, L, D] with dtype float32 on CUDA."
      ]
    },
    {
      "name": "custom_bucketize",
      "parameters": [
        {
          "name": "input_values",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch_size, seq_length]",
          "layout": "contiguous or supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "boundaries",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[num_boundaries]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.int64",
        "device": "cuda",
        "shape": "[batch_size, seq_length]",
        "layout": "contiguous"
      },
      "semantics": [
        "For each element in input_values, compute the index of the first boundary in boundaries that is greater than the element.",
        "Equivalent to torch.bucketize(input_values, boundaries) with default right=False.",
        "boundaries must be non-decreasing as in reference (created by torch.linspace).",
        "Return int64 tensor of same shape as input_values."
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "embedded = self.embedding(indices)",
      "semantics": [
        "Applies nn.Embedding followed by nn.LayerNorm.",
        "Input indices shape [128,2048] dtype int64, moved to CUDA.",
        "Embedding weight shape [2048,512] dtype float32.",
        "LayerNorm weight (gamma) shape [512], bias (beta) shape [512], eps=1e-05.",
        "Output shape [128,2048,512] dtype float32 CUDA, contiguous."
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "bucketized = torch.bucketize(input_values, self.bucketize_values)",
      "semantics": [
        "input_values shape [128,2048] dtype float32, moved to CUDA.",
        "boundaries (bucketize_values) shape [1000] dtype float32, moved to CUDA, non-decreasing.",
        "Output shape [128,2048] dtype int64 CUDA, contiguous."
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return (embedded, bucketized)",
      "semantics": [
        "Returns tuple of tensors: embedded [128,2048,512] float32 CUDA and bucketized [128,2048] int64 CUDA."
      ]
    }
  ]
}