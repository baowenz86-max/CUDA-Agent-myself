{
  "operators": [
    {
      "name": "conv2d_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C_in, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C_out, C_in, kH, kW]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C_out]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "stride",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "padding",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C_out, H_out, W_out] where H_out = floor((H + 2*padding - kH)/stride)+1, W_out similarly"
      },
      "semantics": [
        "Performs 2D convolution as in reference self.conv(x).",
        "Uses cuDNN convolution forward.",
        "Adds bias after convolution if bias is not None.",
        "stride and padding are integers; kernel_size is derived from weight shape.",
        "Output shape is [512, 16, 62, 62] for the given task inputs."
      ]
    },
    {
      "name": "add_bias_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C, 1, 1]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "Adds the bias tensor to input using broadcasting along channel dimension.",
        "Bias shape [C,1,1] broadcasts to [N,C,H,W].",
        "Equivalent to x + self.bias in reference."
      ]
    },
    {
      "name": "batch_norm_eval_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "Applies BatchNorm2d in evaluation mode using running statistics.",
        "For each channel c: y = (x - running_mean[c]) / sqrt(running_var[c] + eps) * weight[c] + bias[c].",
        "If weight or bias is None, corresponding term is omitted.",
        "eps is a scalar float.",
        "Normalization is per channel, spatial dimensions shared."
      ]
    },
    {
      "name": "avg_pool2d_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "kernel_size",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "stride",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "padding",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C, H_out, W_out] where H_out = floor((H + 2*padding - kernel_size)/stride)+1, W_out similarly"
      },
      "semantics": [
        "Performs average pooling as in reference self.pool(x).",
        "kernel_size, stride, padding are integers.",
        "For the given task, output shape is [512, 16, 62, 62]."
      ]
    },
    {
      "name": "sigmoid_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "any",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "Applies sigmoid function element-wise: y = 1 / (1 + exp(-x)).",
        "Equivalent to torch.sigmoid(x) in reference."
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.conv(x)",
      "semantics": [
        "Conv2d with kernel_size=3, stride=1, padding=1, bias=True.",
        "Input [512,3,64,64], output [512,16,62,62]."
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = x + self.bias",
      "semantics": [
        "Adds bias tensor of shape [16,1,1] broadcast across spatial and batch dims."
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = self.bn(x)",
      "semantics": [
        "BatchNorm2d in eval mode uses running stats and affine parameters.",
        "Normalization per channel."
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "x = self.pool(x)",
      "semantics": [
        "AvgPool2d with kernel_size=3, stride=1, padding=1.",
        "Output shape [512,16,62,62]."
      ]
    },
    {
      "checkpoint": "step_005",
      "source": "x = torch.sigmoid(x)",
      "semantics": [
        "Element-wise sigmoid activation."
      ]
    },
    {
      "checkpoint": "step_006",
      "source": "return x",
      "semantics": [
        "Final tensor [512,16,62,62] float32 cuda."
      ]
    }
  ]
}