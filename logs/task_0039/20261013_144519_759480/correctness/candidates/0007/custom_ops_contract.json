  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.conv(x)",
      "semantics": [
        "Conv2d，输入 [512,3,64,64]，卷积核 3x3，out_channels=16，stride=1，padding=0，输出 [512,16,62,62]"
