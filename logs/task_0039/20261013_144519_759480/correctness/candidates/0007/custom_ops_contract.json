      ]
    },
    {
      "checkpoint": "step_005",
      "source": "x = torch.sigmoid(x)",
      "semantics": [
        "sigmoid 逐元素计算，输出范围 (0,1)"
      ]
    },
    {
      "checkpoint": "step_006",
