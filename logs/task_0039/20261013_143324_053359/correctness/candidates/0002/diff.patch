 // -----------------------------------------------------------------------------
+// conv2d: direct convolution, output[n,oc,oh,ow] = sum_{ic,kh,kw}
+//          input[n,ic,oh*stride - padding + kh, ow*stride - padding + kw] * weight[oc,ic,kh,kw]
+//          + bias[oc] (if bias provided)
+// -----------------------------------------------------------------------------
+__global__ void conv2d_kernel(
+    const float* __restrict__ input,
+    const float* __restrict__ weight,
+    const float* __restrict__ bias,
+    float* __restrict__ output,
+    int N, int C_in, int H, int W,
+    int C_out, int R, int S,
+    int stride, int padding,
+    int H_out, int W_out)
+{
+    int64_t total = (int64_t)N * C_out * H_out * W_out;
+    int64_t idx = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride_total = (int64_t)blockDim.x * gridDim.x;
+
+    for (int64_t i = idx; i < total; i += stride_total) {
+        int ow = i % W_out;
+        int64_t tmp = i / W_out;
+        int oh = tmp % H_out;
+        tmp /= H_out;
+        int oc = tmp % C_out;
+        int n = tmp / C_out;
+
+        float sum = 0.0f;
+        for (int ic = 0; ic < C_in; ++ic) {
+            for (int kh = 0; kh < R; ++kh) {
+                int ih = oh * stride - padding + kh;
+                if (ih < 0 || ih >= H) continue;
+                for (int kw = 0; kw < S; ++kw) {
+                    int iw = ow * stride - padding + kw;
+                    if (iw < 0 || iw >= W) continue;
+                    int64_t in_idx = ((int64_t)n * C_in + ic) * H * W + (int64_t)ih * W + iw;
+                    int64_t w_idx = (((int64_t)oc * C_in + ic) * R + kh) * S + kw;
+                    sum += input[in_idx] * weight[w_idx];
+                }
+            }
+        }
+        if (bias != nullptr) {
+            sum += bias[oc];
+        }
+        output[i] = sum;
+    }
+}
+
+extern "C" void conv2d_launcher(
+    const float* input,
+    const float* weight,
+    const float* bias,
+    float* output,
+    int N, int C_in, int H, int W,
+    int C_out, int R, int S,
+    int stride, int padding,
+    cudaStream_t stream)
+{
+    if (N <= 0 || C_in <= 0 || C_out <= 0 || H <= 0 || W <= 0 || R <= 0 || S <= 0) return;
+    int H_out = (H + 2 * padding - R) / stride + 1;
+    int W_out = (W + 2 * padding - S) / stride + 1;
+    if (H_out <= 0 || W_out <= 0) return;
+
+    int64_t total = (int64_t)N * C_out * H_out * W_out;
+    int block = 256;
+    int grid = (int)((total + block - 1) / block);
+    if (grid > 65535) grid = 65535;
+
+    conv2d_kernel<<<grid, block, 0, stream>>>(
+        input, weight, bias, output,
+        N, C_in, H, W, C_out, R, S, stride, padding, H_out, W_out);
+
+    cudaError_t err = cudaGetLastError();
+    // caller checks
+}
