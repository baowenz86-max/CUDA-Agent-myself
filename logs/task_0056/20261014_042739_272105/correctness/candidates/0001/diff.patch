--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,107 @@
+#include <cuda_runtime.h>
+#include <cmath>
+
+// Sigmoid forward kernel: y = 1 / (1 + exp(-x))
+// Supports arbitrary strides via 4D indexing.
+__global__ void sigmoid_forward_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ y,
+    int N, int C, int H, int W,
+    int stride_n, int stride_c, int stride_h, int stride_w) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = N * C * H * W;
+    if (idx >= total) return;
+
+    // Decompose linear index into coordinates
+    int n = idx / (C * H * W);
+    int rem = idx % (C * H * W);
+    int c = rem / (H * W);
+    rem = rem % (H * W);
+    int h = rem / W;
+    int w = rem % W;
+
+    int offset = n * stride_n + c * stride_c + h * stride_h + w * stride_w;
+    float val = x[offset];
+    y[offset] = 1.0f / (1.0f + expf(-val));
+}
+
+// BatchNorm2d inference kernel: y = (x - mean[c]) / sqrt(var[c] + eps) * weight[c] + bias[c]
+// Supports arbitrary strides via 4D indexing.
+__global__ void batch_norm2d_inference_kernel(
+    const float* __restrict__ x,
+    const float* __restrict__ weight,
+    const float* __restrict__ bias,
+    const float* __restrict__ running_mean,
+    const float* __restrict__ running_var,
+    float eps,
+    float* __restrict__ y,
+    int N, int C, int H, int W,
+    int stride_n, int stride_c, int stride_h, int stride_w) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = N * C * H * W;
+    if (idx >= total) return;
+
+    int n = idx / (C * H * W);
+    int rem = idx % (C * H * W);
+    int c = rem / (H * W);
+    rem = rem % (H * W);
+    int h = rem / W;
+    int w = rem % W;
+
+    int offset = n * stride_n + c * stride_c + h * stride_h + w * stride_w;
+    float mean = running_mean[c];
+    float var = running_var[c];
+    float scale = weight[c] / sqrtf(var + eps);
+    float shift = bias[c] - mean * scale;
+    y[offset] = x[offset] * scale + shift;
+}
+
+// Launcher for sigmoid_forward
+// x: input tensor data pointer, y: output tensor data pointer
+// N,C,H,W: dimensions
+// stride_n, stride_c, stride_h, stride_w: strides in elements
+// stream: CUDA stream
+extern "C" void sigmoid_forward_launcher(
+    const float* x,
+    float* y,
+    int N, int C, int H, int W,
+    int stride_n, int stride_c, int stride_h, int stride_w,
+    cudaStream_t stream) {
+    int total = N * C * H * W;
+    if (total <= 0) return;
+
+    int block_size = 256;
+    int grid_size = (total + block_size - 1) / block_size;
+    // Optional: cap grid size to avoid too many blocks, use grid-stride loop if needed.
+    // For simplicity here, we launch exactly enough blocks; current maximum total is ~25M, grid size ~98K, okay.
+    sigmoid_forward_kernel<<<grid_size, block_size, 0, stream>>>(
+        x, y, N, C, H, W, stride_n, stride_c, stride_h, stride_w);
+}
+
+// Launcher for batch_norm2d_inference
+// x, weight, bias, running_mean, running_var: input tensors (float32)
+// eps: epsilon
+// y: output tensor
+// N,C,H,W: dimensions
+// stride_n, stride_c, stride_h, stride_w: strides of x in elements
+// stream: CUDA stream
+extern "C" void batch_norm2d_inference_launcher(
+    const float* x,
+    const float* weight,
+    const float* bias,
+    const float* running_mean,
+    const float* running_var,
+    float eps,
+    float* y,
+    int N, int C, int H, int W,
+    int stride_n, int stride_c, int stride_h, int stride_w,
+    cudaStream_t stream) {
+    int total = N * C * H * W;
+    if (total <= 0) return;
+
+    int block_size = 256;
+    int grid_size = (total + block_size - 1) / block_size;
+    batch_norm2d_inference_kernel<<<grid_size, block_size, 0, stream>>>(
+        x, weight, bias, running_mean, running_var, eps, y,
+        N, C, H, W, stride_n, stride_c, stride_h, stride_w);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,128 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void sigmoid_forward_launcher(
+    const float* x,
+    float* y,
+    int N, int C, int H, int W,
+    int stride_n, int stride_c, int stride_h, int stride_w,
+    cudaStream_t stream);
+
+extern "C" void batch_norm2d_inference_launcher(
+    const float* x,
+    const float* weight,
+    const float* bias,
+    const float* running_mean,
+    const float* running_var,
+    float eps,
+    float* y,
+    int N, int C, int H, int W,
+    int stride_n, int stride_c, int stride_h, int stride_w,
+    cudaStream_t stream);
+
+// PyTorch wrapper for sigmoid_forward
+torch::Tensor sigmoid_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(x.dim() == 4, "x must be 4D (N,C,H,W)");
+
+    auto y = torch::empty_like(x);
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    sigmoid_forward_launcher(
+        x.data_ptr<float>(),
+        y.data_ptr<float>(),
+        N, C, H, W,
+        x.stride(0), x.stride(1), x.stride(2), x.stride(3),
+        stream
+    );
+
+    return y;
+}
+
+// PyTorch wrapper for batch_norm2d_inference_forward
+torch::Tensor batch_norm2d_inference_forward(
+    torch::Tensor x,
+    torch::Tensor weight,
+    torch::Tensor bias,
+    torch::Tensor running_mean,
+    torch::Tensor running_var,
+    double eps) {
+
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(weight.is_cuda(), "weight must be a CUDA tensor");
+    TORCH_CHECK(bias.is_cuda(), "bias must be a CUDA tensor");
+    TORCH_CHECK(running_mean.is_cuda(), "running_mean must be a CUDA tensor");
+    TORCH_CHECK(running_var.is_cuda(), "running_var must be a CUDA tensor");
+
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(weight.dtype() == torch::kFloat32, "weight must be float32");
+    TORCH_CHECK(bias.dtype() == torch::kFloat32, "bias must be float32");
+    TORCH_CHECK(running_mean.dtype() == torch::kFloat32, "running_mean must be float32");
+    TORCH_CHECK(running_var.dtype() == torch::kFloat32, "running_var must be float32");
+
+    TORCH_CHECK(x.dim() == 4, "x must be 4D (N,C,H,W)");
+    TORCH_CHECK(weight.dim() == 1 && weight.size(0) == x.size(1), "weight must be 1D with size C");
+    TORCH_CHECK(bias.dim() == 1 && bias.size(0) == x.size(1), "bias must be 1D with size C");
+    TORCH_CHECK(running_mean.dim() == 1 && running_mean.size(0) == x.size(1), "running_mean must be 1D with size C");
+    TORCH_CHECK(running_var.dim() == 1 && running_var.size(0) == x.size(1), "running_var must be 1D with size C");
+
+    // Ensure contiguous for the 1D parameter tensors
+    auto weight_contig = weight.contiguous();
+    auto bias_contig = bias.contiguous();
+    auto running_mean_contig = running_mean.contiguous();
+    auto running_var_contig = running_var.contiguous();
+
+    auto y = torch::empty_like(x);
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    batch_norm2d_inference_launcher(
+        x.data_ptr<float>(),
+        weight_contig.data_ptr<float>(),
+        bias_contig.data_ptr<float>(),
+        running_mean_contig.data_ptr<float>(),
+        running_var_contig.data_ptr<float>(),
+        static_cast<float>(eps),
+        y.data_ptr<float>(),
+        N, C, H, W,
+        x.stride(0), x.stride(1), x.stride(2), x.stride(3),
+        stream
+    );
+
+    return y;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("sigmoid_forward", &sigmoid_forward,
+          "Sigmoid forward (CUDA)",
+          pybind11::arg("x"));
+
+    m.def("batch_norm2d_inference_forward", &batch_norm2d_inference_forward,
+          "BatchNorm2d inference forward (CUDA)",
+          pybind11::arg("x"),
+          pybind11::arg("weight"),
+          pybind11::arg("bias"),
+          pybind11::arg("running_mean"),
+          pybind11::arg("running_var"),
+          pybind11::arg("eps"));
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,34 @@
+import torch
+import torch.nn as nn
+
+
+class ModelNew(nn.Module):
+    def __init__(self, input_features, eps):
+        super().__init__()
+        self.batch_norm = nn.BatchNorm2d(input_features, eps=eps)
+
+    def forward(self, x):
+        x = cuda_extension.sigmoid_forward(x)
+        x = cuda_extension.batch_norm2d_inference_forward(
+            x,
+            self.batch_norm.weight,
+            self.batch_norm.bias,
+            self.batch_norm.running_mean,
+            self.batch_norm.running_var,
+            self.batch_norm.eps
+        )
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.sigmoid_forward(x)
+        yield 'step_001', x
+        x = cuda_extension.batch_norm2d_inference_forward(
+            x,
+            self.batch_norm.weight,
+            self.batch_norm.bias,
+            self.batch_norm.running_mean,
+            self.batch_norm.running_var,
+            self.batch_norm.eps
+        )
+        yield 'step_002', x
+        yield 'step_003', x
