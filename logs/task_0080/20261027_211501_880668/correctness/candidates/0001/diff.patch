+extern "C" void prelu_forward_launcher(
+    const float* input,
+    float* output,
+    float weight,
+    int64_t numel,
+    cudaStream_t stream)
+{
+    int threads = 256;
+    int blocks = (int)((numel + threads - 1) / threads);
+    prelu_kernel<<<blocks, threads, 0, stream>>>(input, output, weight, numel);
+    check_cuda_error_("prelu_forward_launcher");
+}
