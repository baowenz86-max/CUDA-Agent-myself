+// Kernel to count selected per block and store block_counts
+// gridDim = numBlocks; each block processes a contiguous range of flattened input indices
+// start = blockIdx.x * block_tile_size; end = min(start + block_tile_size, total_elements)
+// The range is fixed based on blockIdx, independent of loop? We'll assign each block an equal tile (except last).
+__global__ void count_selected_kernel(
+    const float* __restrict__ input,
+    const bool* __restrict__ mask,
+    int64_t* __restrict__ block_counts,
+    int64_t total_elements,
+    int input_ndim,
+    const int64_t* __restrict__ input_shape,
+    const int64_t* __restrict__ input_strides,
+    int mask_ndim,
+    const int64_t* __restrict__ mask_shape,
+    const int64_t* __restrict__ mask_strides)
+{
+    // Block processes tile size = blockDim.x * ITEMS_PER_THREAD
+    constexpr int ITEMS_PER_THREAD = 8;
+    int64_t block_start = blockIdx.x * (int64_t)blockDim.x * ITEMS_PER_THREAD;
+    int64_t block_end = min(block_start + (int64_t)blockDim.x * ITEMS_PER_THREAD, total_elements);
+    int64_t local_count = 0;
+
+    for (int64_t base = block_start + threadIdx.x; base < block_end; base += blockDim.x) {
+        // For each handled element, compute multi-index and mask offset
+        int64_t idx = base;
+        int64_t coords[4]; // support up to 4 dims; increase if needed
+        for (int d = input_ndim - 1; d >= 0; --d) {
+            coords[d] = idx % input_shape[d];
+            idx /= input_shape[d];
+        }
+        int64_t mask_offset = compute_mask_offset(coords, input_ndim, input_shape, mask_shape, mask_strides);
+        if (mask[mask_offset]) {
+            local_count++;
+        }
+    }
+
+    // Reduce within block using shared memory
+    __shared__ int64_t sdata[256];
+    sdata[threadIdx.x] = local_count;
+    __syncthreads();
+
+    // Tree reduction
+    for (int s = blockDim.x / 2; s > 0; s >>= 1) {
+        if (threadIdx.x < s) {
+            sdata[threadIdx.x] += sdata[threadIdx.x + s];
+        }
+        __syncthreads();
+    }
+
+    if (threadIdx.x == 0) {
+        block_counts[blockIdx.x] = sdata[0];
+    }
+}
