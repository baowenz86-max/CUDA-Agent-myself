+// Gather selected elements using block_offsets.
+// Each block processes same tile as before, but now has base offset.
+__global__ void gather_selected_kernel(
+    const float* __restrict__ input,
+    const bool* __restrict__ mask,
+    float* __restrict__ output,
+    const int64_t* __restrict__ block_offsets,
+    int64_t total_elements,
+    int input_ndim,
+    const int64_t* __restrict__ input_shape,
+    const int64_t* __restrict__ input_strides,
+    int mask_ndim,
+    const int64_t* __restrict__ mask_shape,
+    const int64_t* __restrict__ mask_strides)
+{
+    constexpr int ITEMS_PER_THREAD = 8;
+    int64_t block_start = blockIdx.x * (int64_t)blockDim.x * ITEMS_PER_THREAD;
+    int64_t block_end = min(block_start + (int64_t)blockDim.x * ITEMS_PER_THREAD, total_elements);
+    int64_t base_offset = block_offsets[blockIdx.x];
+
+    // Each thread processes elements in a contiguous chunk with stride blockDim.x? Actually in count kernel we used base = block_start + threadIdx.x; base += blockDim.x.
+    // That means each thread handles elements separated by blockDim.x, not contiguous, but the order across threads is not strictly row-major. For stable order, we need elements processed in increasing linear index across threads. If thread 0 handles indices 0,256,512,... and thread 1 handles 1,257,..., the combined order is not monotonic. To preserve row-major order, we need each block to process contiguous elements in a way that the output order follows linear index. However, the scan within block can account for interleaving if we do a proper prefix sum over all per-thread local flags with a particular ordering: we want output positions to follow linear index order. The simple approach of having each thread process a contiguous subrange is better. Let's modify: each block processes a contiguous range of elements [block_start, block_end). We can assign each thread a contiguous sub-range of size (block_end - block_start + blockDim.x - 1)/blockDim.x. Then each thread loops over its sub-range sequentially, counting selected. After local counts, we can compute prefix across threads using shared memory. Then each thread writes its selected elements in order using its prefix plus local count. This preserves order because threads are ordered by threadIdx and within thread by loop order, which corresponds to increasing linear index. However, the sub-ranges may not divide equally; we can handle boundaries.
+
+    // Let's implement with this scheme:
+    int64_t range_length = block_end - block_start;
+    int64_t per_thread = (range_length + blockDim.x - 1) / blockDim.x;
+    int64_t start = block_start + threadIdx.x * per_thread;
+    int64_t end = min(start + per_thread, block_end);
+
+    // First, count selected in local sub-range
+    int64_t local_count = 0;
+    for (int64_t idx = start; idx < end; ++idx) {
+        // compute mask offset
+        int64_t coords[4];
+        int64_t tmp = idx;
+        for (int d = input_ndim - 1; d >= 0; --d) {
+            coords[d] = tmp % input_shape[d];
+            tmp /= input_shape[d];
+        }
+        int64_t mask_offset = compute_mask_offset(coords, input_ndim, input_shape, mask_shape, mask_strides);
+        if (mask[mask_offset]) {
+            local_count++;
+        }
+    }
+
+    // Prefix sum across threads to get global base for each thread's contributions
+    __shared__ int64_t s_counts[256];
+    __shared__ int64_t s_prefix[256];
+    s_counts[threadIdx.x] = local_count;
+    __syncthreads();
+
+    // Exclusive scan on s_counts to get prefix for each thread
+    int64_t temp = 0;
+    for (int offset = 1; offset < blockDim.x; offset <<= 1) {
+        if (threadIdx.x >= offset) {
+            temp = s_counts[threadIdx.x - offset];
+        }
+        __syncthreads();
+        if (threadIdx.x >= offset) {
+            s_counts[threadIdx.x] += temp;
+        }
+        __syncthreads();
+    }
+    // Now s_counts[threadIdx.x] contains inclusive prefix
+    if (threadIdx.x == 0) {
+        s_prefix[0] = 0;
+    } else {
+        s_prefix[threadIdx.x] = s_counts[threadIdx.x - 1];
+    }
+    __syncthreads();
+
+    // Now each thread writes its selected elements starting at base_offset + s_prefix[threadIdx.x]
+    int64_t out_pos = base_offset + s_prefix[threadIdx.x];
+    for (int64_t idx = start; idx < end; ++idx) {
+        int64_t coords[4];
+        int64_t tmp = idx;
+        for (int d = input_ndim - 1; d >= 0; --d) {
+            coords[d] = tmp % input_shape[d];
+            tmp /= input_shape[d];
+        }
+        int64_t mask_offset = compute_mask_offset(coords, input_ndim, input_shape, mask_shape, mask_strides);
+        if (mask[mask_offset]) {
+            output[out_pos++] = input[idx];
+        }
+    }
+}
