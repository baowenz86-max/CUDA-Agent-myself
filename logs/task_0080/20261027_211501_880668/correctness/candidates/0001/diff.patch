+
+// We'll create a device function to compute mask offset given input multi-index.
+
+__device__ __forceinline__ int64_t compute_mask_offset(int64_t* input_coords, int input_ndim, const int64_t* input_shape, const int64_t* mask_shape, const int64_t* mask_strides) {
+    int mask_ndim = input_ndim; // assume mask_shape has same ndim after alignment? Instead, we can pass mask_ndim and align trailing dims.
+    // We'll assume mask_shape and mask_strides already broadcast to input_ndim (i.e., leading ones prepended). Then use same ndim.
+    // But to be safe, we pass mask_ndim and align trailing.
+    // For our case, input_ndim=4, mask_ndim=3, broadcast means mask applied to last 3 dims.
+    int offset = 0;
+    int mask_dim = mask_ndim - 1;
+    for (int d = input_ndim - 1; d >= 0 && mask_dim >= 0; --d) {
+        int64_t coord = input_coords[d];
+        int64_t mask_extent = mask_shape[mask_dim];
+        if (mask_extent != 1 && coord >= mask_extent) {
+            // broadcast error, shouldn't happen
+        }
+        int64_t idx = (mask_extent == 1) ? 0 : coord;
+        offset += idx * mask_strides[mask_dim];
+        --mask_dim;
+    }
+    // For leading input dims where mask_dim <0, we ignore (broadcast over them).
+    return offset;
+}
