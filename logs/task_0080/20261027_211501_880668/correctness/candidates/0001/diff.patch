+// Update compute_mask_offset to accept mask_meta struct
+__device__ __forceinline__ int64_t compute_mask_offset(const int64_t* coords, int input_ndim, const int64_t* input_shape, const TensorMeta& mask_meta) {
+    int64_t offset = 0;
+    int mask_dim = mask_meta.ndim - 1;
+    for (int d = input_ndim - 1; d >= 0 && mask_dim >= 0; --d) {
+        int64_t coord = coords[d];
+        int64_t mask_extent = mask_meta.shape[mask_dim];
+        int64_t idx = (mask_extent == 1) ? 0 : coord;
+        offset += idx * mask_meta.strides[mask_dim];
+        --mask_dim;
+    }
+    return offset;
+}
+
+// Scan kernel now operates on block_counts of length numBlocks.
+// We'll still use a single block single thread loop for simplicity.
+__global__ void block_exclusive_scan_kernel(
+    const int64_t* __restrict__ block_counts,
+    int64_t* __restrict__ block_offsets,
+    int64_t* __restrict__ total_count,
+    int numBlocks)
+{
+    if (threadIdx.x == 0) {
+        int64_t sum = 0;
+        for (int i = 0; i < numBlocks; ++i) {
+            block_offsets[i] = sum;
+            sum += block_counts[i];
+        }
+        *total_count = sum;
+    }
+}
+
+__global__ void gather_selected_kernel(
+    const float* __restrict__ input,
+    const bool* __restrict__ mask,
+    float* __restrict__ output,
+    const int64_t* __restrict__ block_offsets,
+    int64_t total_elements,
+    TensorMeta input_meta,
+    TensorMeta mask_meta)
+{
+    constexpr int ITEMS_PER_THREAD = 8;
+    int64_t block_start = blockIdx.x * (int64_t)blockDim.x * ITEMS_PER_THREAD;
+    int64_t block_end = min(block_start + (int64_t)blockDim.x * ITEMS_PER_THREAD, total_elements);
+    int64_t base_offset = block_offsets[blockIdx.x];
+
+    int64_t range_length = block_end - block_start;
+    int64_t per_thread = (range_length + blockDim.x - 1) / blockDim.x;
+    int64_t start = block_start + threadIdx.x * per_thread;
+    int64_t end = min(start + per_thread, block_end);
+
+    int64_t local_count = 0;
+    for (int64_t idx = start; idx < end; ++idx) {
+        int64_t coords[4];
+        int64_t tmp = idx;
+        for (int d = input_meta.ndim - 1; d >= 0; --d) {
+            coords[d] = tmp % input_meta.shape[d];
+            tmp /= input_meta.shape[d];
+        }
+        int64_t mask_offset = compute_mask_offset(coords, input_meta.ndim, input_meta.shape, mask_meta);
+        if (mask[mask_offset]) {
+            local_count++;
+        }
+    }
+
+    __shared__ int64_t s_counts[256];
+    __shared__ int64_t s_prefix[256];
+    s_counts[threadIdx.x] = local_count;
+    __syncthreads();
+
+    // Hillis-Steele inclusive scan
+    for (int offset = 1; offset < blockDim.x; offset <<= 1) {
+        int64_t temp = 0;
+        if (threadIdx.x >= offset) {
+            temp = s_counts[threadIdx.x - offset];
+        }
+        __syncthreads();
+        if (threadIdx.x >= offset) {
+            s_counts[threadIdx.x] += temp;
+        }
+        __syncthreads();
+    }
+
+    if (threadIdx.x == 0) {
+        s_prefix[0] = 0;
+    } else {
+        s_prefix[threadIdx.x] = s_counts[threadIdx.x - 1];
+    }
+    __syncthreads();
+
+    int64_t out_pos = base_offset + s_prefix[threadIdx.x];
+    for (int64_t idx = start; idx < end; ++idx) {
+        int64_t coords[4];
+        int64_t tmp = idx;
+        for (int d = input_meta.ndim - 1; d >= 0; --d) {
+            coords[d] = tmp % input_meta.shape[d];
+            tmp /= input_meta.shape[d];
+        }
+        int64_t mask_offset = compute_mask_offset(coords, input_meta.ndim, input_meta.shape, mask_meta);
+        if (mask[mask_offset]) {
+            output[out_pos++] = input[idx];
+        }
+    }
+}
+
+// Host launchers for count and gather phases.
+// The binding will allocate block_counts and block_offsets device buffers of size numBlocks.
+// numBlocks = ceil(total_elements / (blockDim.x * ITEMS_PER_THREAD))
+
+extern "C" void masked_select_count_launcher(
+    const float* input,
+    const bool* mask,
+    int64_t total_elements,
+    TensorMeta input_meta,
+    TensorMeta mask_meta,
+    int64_t* block_counts,
+    int64_t* block_offsets,
+    int64_t* total_count,
+    int num_blocks,
+    cudaStream_t stream)
+{
+    int threads = 256;
+    constexpr int ITEMS_PER_THREAD = 8;
+    // ensure num_blocks matches expected
+    count_selected_kernel<<<num_blocks, threads, 0, stream>>>(
+        input, mask, block_counts, total_elements, input_meta, mask_meta);
+    check_cuda_error_("count_selected_kernel");
+
+    block_exclusive_scan_kernel<<<1, 32, 0, stream>>>(
+        block_counts, block_offsets, total_count, num_blocks);
+    check_cuda_error_("block_exclusive_scan_kernel");
+}
+
+extern "C" void masked_select_gather_launcher(
+    const float* input,
+    const bool* mask,
+    float* output,
+    int64_t total_elements,
+    TensorMeta input_meta,
+    TensorMeta mask_meta,
+    const int64_t* block_offsets,
+    int num_blocks,
+    cudaStream_t stream)
+{
+    int threads = 256;
+    constexpr int ITEMS_PER_THREAD = 8;
+    gather_selected_kernel<<<num_blocks, threads, 0, stream>>>(
+        input, mask, output, block_offsets, total_elements, input_meta, mask_meta);
+    check_cuda_error_("gather_selected_kernel");
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,186 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cstdint>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void prelu_forward_launcher(
+    const float* input,
+    float* output,
+    float weight,
+    int64_t numel,
+    cudaStream_t stream);
+
+extern "C" void masked_select_count_launcher(
+    const float* input,
+    const bool* mask,
+    int64_t total_elements,
+    TensorMeta input_meta,
+    TensorMeta mask_meta,
+    int64_t* block_counts,
+    int64_t* block_offsets,
+    int64_t* total_count,
+    int num_blocks,
+    cudaStream_t stream);
+
+extern "C" void masked_select_gather_launcher(
+    const float* input,
+    const bool* mask,
+    float* output,
+    int64_t total_elements,
+    TensorMeta input_meta,
+    TensorMeta mask_meta,
+    const int64_t* block_offsets,
+    int num_blocks,
+    cudaStream_t stream);
+
+// Define TensorMeta (must match .cu definition)
+struct TensorMeta {
+    int ndim;
+    int64_t shape[4];
+    int64_t strides[4];
+};
+
+// Helper: fill TensorMeta from a torch::Tensor
+TensorMeta get_meta(const torch::Tensor& t) {
+    TensorMeta meta;
+    meta.ndim = t.dim();
+    TORCH_CHECK(meta.ndim <= 4, "Only up to 4D tensors are supported");
+    for (int i = 0; i < 4; ++i) {
+        meta.shape[i] = 0;
+        meta.strides[i] = 0;
+    }
+    for (int i = 0; i < meta.ndim; ++i) {
+        meta.shape[i] = t.size(i);
+        meta.strides[i] = t.stride(i);
+    }
+    return meta;
+}
+
+// masked_select_forward
+// Returns 1D tensor of selected values in row-major order.
+torch::Tensor masked_select_forward(torch::Tensor input, torch::Tensor mask) {
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(mask.is_cuda(), "mask must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(mask.dtype() == torch::kBool, "mask must be bool");
+
+    // Broadcast check: mask shape must be broadcastable to input shape.
+    // PyTorch broadcasting rules: trailing dims must be equal or one of them is 1.
+    int input_ndim = input.dim();
+    int mask_ndim = mask.dim();
+    TORCH_CHECK(mask_ndim <= input_ndim, "mask dims cannot exceed input dims");
+    for (int i = 1; i <= mask_ndim; ++i) {
+        int64_t in_dim = input.size(input_ndim - i);
+        int64_t mask_dim = mask.size(mask_ndim - i);
+        TORCH_CHECK(in_dim == mask_dim || in_dim == 1 || mask_dim == 1,
+                    "mask shape not broadcastable to input shape");
+    }
+
+    // Ensure input and mask are contiguous for kernel simplicity?
+    // The .cu kernels assume linear index over input and use strides to compute mask offset,
+    // but they access input[idx] directly, which requires input contiguous. We'll make contiguous copies.
+    auto input_contig = input.contiguous();
+    auto mask_contig = mask.contiguous();
+
+    int64_t total_elements = input_contig.numel();
+    TensorMeta input_meta = get_meta(input_contig);
+    TensorMeta mask_meta = get_meta(mask_contig);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Choose block size and items per thread to match .cu kernels
+    const int threads = 256;
+    constexpr int ITEMS_PER_THREAD = 8;
+    int64_t num_blocks = (total_elements + (int64_t)threads * ITEMS_PER_THREAD - 1) /
+                         ((int64_t)threads * ITEMS_PER_THREAD);
+    TORCH_CHECK(num_blocks > 0, "input must not be empty");
+
+    // Allocate block_counts and block_offsets on device
+    auto block_counts = torch::empty({num_blocks},
+                                     torch::dtype(torch::kInt64).device(input.device()));
+    auto block_offsets = torch::empty({num_blocks},
+                                      torch::dtype(torch::kInt64).device(input.device()));
+    auto total_count_tensor = torch::empty({1},
+                                           torch::dtype(torch::kInt64).device(input.device()));
+
+    // First launcher: count and scan
+    masked_select_count_launcher(
+        input_contig.data_ptr<float>(),
+        mask_contig.data_ptr<bool>(),
+        total_elements,
+        input_meta,
+        mask_meta,
+        block_counts.data_ptr<int64_t>(),
+        block_offsets.data_ptr<int64_t>(),
+        total_count_tensor.data_ptr<int64_t>(),
+        (int)num_blocks,
+        stream);
+
+    // Copy total count to CPU
+    int64_t total_count_cpu;
+    cudaMemcpyAsync(&total_count_cpu, total_count_tensor.data_ptr<int64_t>(),
+                    sizeof(int64_t), cudaMemcpyDeviceToHost, stream);
+    cudaStreamSynchronize(stream); // ensure copy complete
+
+    // Allocate output
+    auto output = torch::empty({total_count_cpu},
+                               torch::dtype(torch::kFloat32).device(input.device()));
+
+    // Second launcher: gather
+    masked_select_gather_launcher(
+        input_contig.data_ptr<float>(),
+        mask_contig.data_ptr<bool>(),
+        output.data_ptr<float>(),
+        total_elements,
+        input_meta,
+        mask_meta,
+        block_offsets.data_ptr<int64_t>(),
+        (int)num_blocks,
+        stream);
+
+    return output;
+}
+
+// prelu_forward
+// Applies PReLU with a single weight (num_parameters=1).
+torch::Tensor prelu_forward(torch::Tensor input, torch::Tensor weight) {
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(weight.is_cuda(), "weight must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(weight.dtype() == torch::kFloat32, "weight must be float32");
+    TORCH_CHECK(weight.numel() == 1, "weight must have exactly one element");
+
+    auto input_contig = input.contiguous();
+    auto output = torch::empty_like(input_contig);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Copy weight to CPU to pass as scalar (simple, one element)
+    float weight_cpu;
+    cudaMemcpyAsync(&weight_cpu, weight.data_ptr<float>(), sizeof(float),
+                    cudaMemcpyDeviceToHost, stream);
+    cudaStreamSynchronize(stream);
+
+    prelu_forward_launcher(
+        input_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        weight_cpu,
+        input_contig.numel(),
+        stream);
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("masked_select_forward", &masked_select_forward,
+          "Stable masked_select implementation (CUDA)",
+          pybind11::arg("input"), pybind11::arg("mask"));
+    m.def("prelu_forward", &prelu_forward,
+          "PReLU with single weight (CUDA)",
+          pybind11::arg("input"), pybind11::arg("weight"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
