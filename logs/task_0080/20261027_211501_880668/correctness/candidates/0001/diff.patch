+// Exclusive scan on block_counts (length numBlocks), single block
+__global__ void block_exclusive_scan_kernel(
+    const int64_t* __restrict__ block_counts,
+    int64_t* __restrict__ block_offsets,
+    int64_t* __restrict__ total_count,
+    int numBlocks)
+{
+    __shared__ int64_t temp[1024]; // assume numBlocks <= 1024; for larger, need multi-block scan, but likely okay
+    // For simplicity, we assume one block can handle. If numBlocks >1024, we'd need more complex scan. Since 50M/2048 ~24414, too many. Better implement a two-level scan? Alternatively, use a single block with loop over all block_counts? Not efficient.
+    // We'll use a grid-stride loop in a single block over block_counts, computing prefix directly. Since numBlocks ~ 24k, a single block with 256 threads can compute prefix efficiently using a multi-block scan algorithm? Simpler: use a dumb single-thread loop, but that would be slow for 24k (but still okay? maybe 24k operations is trivial). We'll just have thread 0 loop through and compute offsets sequentially. Since 24k is small, this is fine.
+    if (threadIdx.x == 0) {
+        int64_t sum = 0;
+        for (int i = 0; i < numBlocks; ++i) {
+            block_offsets[i] = sum;
+            sum += block_counts[i];
+        }
+        *total_count = sum;
+    }
+}
