--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,59 @@
+#include <cuda_runtime.h>
+
+// CUDA kernel for embedding lookup and division by 2.0
+// indices: int64_t*  (CPU->GPU copied by binding)
+// weight: const float*  (CUDA float32)
+// output: float*  (CUDA float32)
+// total_indices: number of indices = batch_size * seq_length
+// embedding_dim: dimension of each embedding vector
+__global__ void embedding_div_kernel(
+    const int64_t* __restrict__ indices,
+    const float* __restrict__ weight,
+    float* __restrict__ output,
+    int total_indices,
+    int embedding_dim)
+{
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+    for (int i = idx; i < total_indices; i += stride) {
+        int64_t token = indices[i];
+        // The reference embedding uses nn.Embedding without padding_idx, so all tokens
+        // are in [0, num_embeddings-1]. We assume valid indices, but add a guard to
+        // prevent out-of-bounds reads; in practice indices are valid.
+        if (token < 0) token = 0;
+        // The weight size is [num_embeddings, embedding_dim]; num_embeddings not needed.
+        // Access row token * embedding_dim.
+        const float* row = weight + token * embedding_dim;
+        float* out_row = output + i * embedding_dim;
+        for (int j = 0; j < embedding_dim; ++j) {
+            out_row[j] = row[j] / 2.0f;
+        }
+    }
+}
+
+// Launcher function (C linkage for binding)
+// Arguments:
+//   indices_ptr: pointer to int64 indices (already copied to GPU by binding)
+//   weight_ptr: pointer to float weight (contiguous)
+//   output_ptr: pointer to preallocated output (float32)
+//   total_indices: number of indices
+//   embedding_dim: dimension of embedding vectors
+//   stream: CUDA stream
+// Note: Binding must allocate output with size total_indices * embedding_dim * sizeof(float)
+//       and copy indices to GPU before calling this.
+extern "C" void embedding_div_launcher(
+    const int64_t* indices_ptr,
+    const float* weight_ptr,
+    float* output_ptr,
+    int total_indices,
+    int embedding_dim,
+    cudaStream_t stream)
+{
+    if (total_indices <= 0 || embedding_dim <= 0) return;
+    const int threads = 256;
+    const int blocks = (total_indices + threads - 1) / threads;
+    // Grid-stride loop handles any size; we can also use a fixed grid cap for large inputs.
+    // For total_indices up to 524288, blocks=2048, which is within limits.
+    embedding_div_kernel<<<blocks, threads, 0, stream>>>(
+        indices_ptr, weight_ptr, output_ptr, total_indices, embedding_dim);
+}
--- before/kernels/embedding_div_binding.cpp
+++ after/kernels/embedding_div_binding.cpp
@@ -0,0 +1,71 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launcher from custom_ops.cu
+extern "C" void embedding_div_launcher(
+    const int64_t* indices_ptr,
+    const float* weight_ptr,
+    float* output_ptr,
+    int total_indices,
+    int embedding_dim,
+    cudaStream_t stream);
+
+// PyTorch wrapper: takes CPU int64 indices and CUDA float32 weight,
+// returns CUDA float32 tensor of shape [*indices.shape, embedding_dim].
+torch::Tensor embedding_div_forward(torch::Tensor indices, torch::Tensor weight) {
+    // Validate indices
+    TORCH_CHECK(indices.is_cpu(), "indices must be a CPU tensor");
+    TORCH_CHECK(indices.scalar_type() == torch::kInt64, "indices must be int64");
+    TORCH_CHECK(indices.is_contiguous(), "indices must be contiguous");
+
+    // Validate weight
+    TORCH_CHECK(weight.is_cuda(), "weight must be a CUDA tensor");
+    TORCH_CHECK(weight.scalar_type() == torch::kFloat32, "weight must be float32");
+    TORCH_CHECK(weight.is_contiguous(), "weight must be contiguous");
+    TORCH_CHECK(weight.dim() == 2, "weight must be 2D [num_embeddings, embedding_dim]");
+
+    const int64_t total_indices = indices.numel();
+    const int64_t embedding_dim = weight.size(1);
+    TORCH_CHECK(total_indices > 0, "indices cannot be empty");
+    TORCH_CHECK(embedding_dim > 0, "embedding_dim must be positive");
+
+    // Allocate output on CUDA; shape is indices.shape + [embedding_dim]
+    std::vector<int64_t> output_shape(indices.sizes().begin(), indices.sizes().end());
+    output_shape.push_back(embedding_dim);
+    auto output = torch::empty(output_shape, weight.options());
+
+    // Copy indices to GPU contiguous int64 tensor
+    auto indices_gpu = indices.to(torch::Device(torch::kCUDA, weight.get_device()), torch::kInt64);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    embedding_div_launcher(
+        indices_gpu.data_ptr<int64_t>(),
+        weight.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int>(total_indices),
+        static_cast<int>(embedding_dim),
+        stream
+    );
+
+    // Check for kernel launch errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "embedding_div_forward kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// Registration function
+void register_embedding_div(pybind11::module& m) {
+    m.def("embedding_div_forward", &embedding_div_forward,
+          "Embedding lookup and division by 2.0",
+          py::arg("indices"), py::arg("weight"));
+}
+
+// Auto-register
+REGISTER_BINDING(embedding_div, register_embedding_div);
