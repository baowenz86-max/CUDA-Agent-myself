{
  "operators": [
    {
      "name": "batchnorm_eval_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W] where N=512, C=16, H=128, W=128 for reference",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "default": 1e-05,
          "nullable": false,
          "optional": true
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "Performs batch normalization in evaluation mode: y = (x - running_mean) / sqrt(running_var + eps) * weight + bias",
        "Normalization is per channel, broadcasting over N, H, W",
        "Uses running_mean and running_var, not batch statistics",
        "weight and bias can be None (if affine=False, but in this task affine=True so they are provided)",
        "eps is a scalar float used to avoid division by zero",
        "Input x may have arbitrary strides; launcher handles by explicit contiguous conversion if necessary"
      ]
    },
    {
      "name": "abs_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as input tensor",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "Computes elementwise absolute value: y = |x|",
        "Preserves shape, dtype, and device",
        "Supports arbitrary strides; launcher handles by strided kernel or contiguous conversion"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.batchnorm(x)",
      "semantics": [
        "BatchNorm2d in eval mode using running statistics",
        "Output shape same as input",
        "Per-channel affine transformation with weight and bias"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.abs(x)",
      "semantics": [
        "Elementwise absolute value",
        "Output shape same as input"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "Returns the final tensor after batchnorm and abs"
      ]
    }
  ]
}