--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,65 @@
+// kernels/custom_ops.cu
+// CUDA kernel for BatchNorm2d inference mode.
+// Contract: output[n,c,h,w] = (input[n,c,h,w] - running_mean[c]) / sqrt(running_var[c] + eps) * weight[c] + bias[c]
+// Weight and bias are optional; if null, use 1 and 0 respectively.
+// Supports contiguous NCHW input. Kernel uses grid-stride loop to handle arbitrary size.
+
+#include <cuda_runtime.h>
+#include <math.h>
+
+// Kernel: one thread per element, grid-stride loop
+template <typename scalar_t>
+__global__ void batchnorm2d_eval_kernel(
+    scalar_t* __restrict__ output,
+    const scalar_t* __restrict__ input,
+    const scalar_t* __restrict__ weight,
+    const scalar_t* __restrict__ bias,
+    const scalar_t* __restrict__ running_mean,
+    const scalar_t* __restrict__ running_var,
+    int N, int C, int H, int W,
+    scalar_t eps) {
+    int64_t total = (int64_t)N * C * H * W;
+    int64_t HW = (int64_t)H * W;
+    int64_t stride = (int64_t)blockDim.x * gridDim.x;
+    for (int64_t idx = blockIdx.x * blockDim.x + threadIdx.x; idx < total; idx += stride) {
+        int64_t c = (idx / HW) % C;
+        scalar_t mean = running_mean[c];
+        scalar_t var = running_var[c];
+        scalar_t invstd = rsqrtf(var + eps);
+        scalar_t gamma = (weight != nullptr) ? weight[c] : (scalar_t)1.0f;
+        scalar_t beta = (bias != nullptr) ? bias[c] : (scalar_t)0.0f;
+        output[idx] = (input[idx] - mean) * invstd * gamma + beta;
+    }
+}
+
+// Host launcher: raw pointers and scalars only, no PyTorch dependencies.
+extern "C" void batchnorm2d_eval_launcher(
+    float* output,
+    const float* input,
+    const float* weight,   // may be nullptr
+    const float* bias,     // may be nullptr
+    const float* running_mean,
+    const float* running_var,
+    int N, int C, int H, int W,
+    float eps,
+    cudaStream_t stream) {
+
+    int64_t total = (int64_t)N * C * H * W;
+    if (total == 0) return;
+
+    const int threads = 256;
+    int64_t max_blocks = (total + threads - 1) / threads;
+    // Cap grid to avoid excessive launch overhead; use grid-stride loop
+    int blocks = (max_blocks > 65535) ? 65535 : (int)max_blocks;
+
+    batchnorm2d_eval_kernel<float><<<blocks, threads, 0, stream>>>(
+        output, input, weight, bias, running_mean, running_var,
+        N, C, H, W, eps);
+
+    // Error check (optional but useful; caller may also synchronize later)
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // Do not throw; just record. The binding should check stream errors.
+        // We leave this as no-op for simplicity; binding may use cudaStreamSynchronize.
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,114 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declaration of the CUDA launcher from custom_ops.cu
+extern "C" void batchnorm2d_eval_launcher(
+    float* output,
+    const float* input,
+    const float* weight,   // may be nullptr
+    const float* bias,     // may be nullptr
+    const float* running_mean,
+    const float* running_var,
+    int N, int C, int H, int W,
+    float eps,
+    cudaStream_t stream);
+
+// PyTorch wrapper for eval-mode BatchNorm2d.
+// Parameters mirror model_new.py call: input, weight, bias, running_mean, running_var, eps.
+torch::Tensor batchnorm2d_eval(
+    torch::Tensor input,
+    c10::optional<torch::Tensor> weight,
+    c10::optional<torch::Tensor> bias,
+    torch::Tensor running_mean,
+    torch::Tensor running_var,
+    double eps) {
+    // Input validation
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(input.dim() == 4, "input must have shape [N, C, H, W]");
+    int64_t N = input.size(0);
+    int64_t C = input.size(1);
+    int64_t H = input.size(2);
+    int64_t W = input.size(3);
+    TORCH_CHECK(N > 0 && C > 0 && H > 0 && W > 0, "input dimensions must be positive");
+
+    // Validate running_mean and running_var
+    TORCH_CHECK(running_mean.is_cuda(), "running_mean must be a CUDA tensor");
+    TORCH_CHECK(running_mean.dtype() == torch::kFloat32, "running_mean must be float32");
+    TORCH_CHECK(running_mean.is_contiguous(), "running_mean must be contiguous");
+    TORCH_CHECK(running_mean.numel() == C, "running_mean must have exactly C elements");
+
+    TORCH_CHECK(running_var.is_cuda(), "running_var must be a CUDA tensor");
+    TORCH_CHECK(running_var.dtype() == torch::kFloat32, "running_var must be float32");
+    TORCH_CHECK(running_var.is_contiguous(), "running_var must be contiguous");
+    TORCH_CHECK(running_var.numel() == C, "running_var must have exactly C elements");
+
+    // Optional weight and bias
+    const float* weight_ptr = nullptr;
+    if (weight.has_value()) {
+        torch::Tensor w = weight.value();
+        TORCH_CHECK(w.is_cuda(), "weight must be a CUDA tensor");
+        TORCH_CHECK(w.dtype() == torch::kFloat32, "weight must be float32");
+        TORCH_CHECK(w.is_contiguous(), "weight must be contiguous");
+        TORCH_CHECK(w.numel() == C, "weight must have exactly C elements");
+        weight_ptr = w.data_ptr<float>();
+    }
+
+    const float* bias_ptr = nullptr;
+    if (bias.has_value()) {
+        torch::Tensor b = bias.value();
+        TORCH_CHECK(b.is_cuda(), "bias must be a CUDA tensor");
+        TORCH_CHECK(b.dtype() == torch::kFloat32, "bias must be float32");
+        TORCH_CHECK(b.is_contiguous(), "bias must be contiguous");
+        TORCH_CHECK(b.numel() == C, "bias must have exactly C elements");
+        bias_ptr = b.data_ptr<float>();
+    }
+
+    // Allocate output with same shape, dtype, device, and strides as input
+    auto output = torch::empty_like(input);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Launch the CUDA kernel via launcher
+    batchnorm2d_eval_launcher(
+        output.data_ptr<float>(),
+        input.data_ptr<float>(),
+        weight_ptr,
+        bias_ptr,
+        running_mean.data_ptr<float>(),
+        running_var.data_ptr<float>(),
+        static_cast<int>(N),
+        static_cast<int>(C),
+        static_cast<int>(H),
+        static_cast<int>(W),
+        static_cast<float>(eps),
+        stream);
+
+    // Check for launch errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// Registration function
+void register_batchnorm2d_eval(pybind11::module& m) {
+    m.def(
+        "batchnorm2d_eval",
+        &batchnorm2d_eval,
+        "Eval-mode BatchNorm2d: y = (x - running_mean) / sqrt(running_var + eps) * weight + bias",
+        pybind11::arg("input"),
+        pybind11::arg("weight"),
+        pybind11::arg("bias"),
+        pybind11::arg("running_mean"),
+        pybind11::arg("running_var"),
+        pybind11::arg("eps") = 1e-05);
+}
+
+// Automatic registration via binding registry
+REGISTER_BINDING(batchnorm2d_eval, register_batchnorm2d_eval);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,25 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, num_channels, eps_val=1e-05, momentum_val=0.1):
+        super().__init__()
+        self.arange_tensor = torch.arange(num_channels)
+        self.batchnorm = nn.BatchNorm2d(num_channels, eps=eps_val, momentum=momentum_val)
+
+    def forward(self, x):
+        x = cuda_extension.batchnorm2d_eval(
+            x,
+            self.batchnorm.weight,
+            self.batchnorm.bias,
+            self.batchnorm.running_mean,
+            self.batchnorm.running_var,
+            self.batchnorm.eps,
+        )
+        return x
+
+    def debug_forward(self, x):
+        x = self.forward(x)
+        return [("step_001", x), ("step_002", x)]
