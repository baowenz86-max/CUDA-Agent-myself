{
  "operators": [
    {
      "name": "batchnorm2d_eval",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "default": 1e-05,
          "optional": true,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C, H, W]"
      },
      "semantics": [
        "Performs eval-mode BatchNorm2d: output[n,c,h,w] = (input[n,c,h,w] - running_mean[c]) / sqrt(running_var[c] + eps) * weight[c] + bias[c].",
        "weight and bias can be None; if None, default to 1 and 0 respectively.",
        "Broadcast parameters over channel dimension; computation is elementwise per channel.",
        "Input may be non-contiguous but is expected to be on CUDA; output has same shape and strides as input.",
        "Should be implemented as a CUDA kernel with one thread per element or vectorized loads.",
        "The launcher must allocate output tensor of same shape as input and launch kernel on current stream."
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.batchnorm(x)",
      "semantics": [
        "Applies BatchNorm2d in inference mode using running statistics.",
        "Output shape [16,3,512,512], dtype float32, on CUDA.",
        "Equivalent to cuda_extension.batchnorm2d_eval with weight, bias, running_mean, running_var and eps."
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "return x",
      "semantics": [
        "Returns the output of BatchNorm2d.",
        "Same shape, dtype, device as step_001."
      ]
    }
  ]
}