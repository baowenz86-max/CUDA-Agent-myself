--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,171 @@
+#include <cuda_runtime.h>
+
+// Helper to compute index offset given linear index and strides/dims, handling stride-0 broadcast
+template <typename T>
+__device__ __forceinline__ int64_t compute_offset(
+    int64_t linear_idx,
+    const int64_t* dims,
+    const int64_t* strides,
+    int ndim) {
+    int64_t offset = 0;
+    for (int d = ndim - 1; d >= 0; --d) {
+        int64_t stride = strides[d];
+        int64_t dim = dims[d];
+        int64_t idx = linear_idx % dim;
+        linear_idx /= dim;
+        if (stride != 0) {
+            offset += idx * stride;
+        }
+    }
+    return offset;
+}
+
+// ReLU6 elementwise kernel, supports arbitrary strides
+__global__ void relu6_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int64_t total_elements,
+    int ndim,
+    const int64_t* __restrict__ dims,
+    const int64_t* __restrict__ input_strides,
+    const int64_t* __restrict__ output_strides) {
+
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)blockDim.x * gridDim.x;
+
+    for (; idx < total_elements; idx += stride) {
+        int64_t in_offset = compute_offset(idx, dims, input_strides, ndim);
+        int64_t out_offset = compute_offset(idx, dims, output_strides, ndim);
+        float val = input[in_offset];
+        val = val > 6.0f ? 6.0f : (val < 0.0f ? 0.0f : val);
+        output[out_offset] = val;
+    }
+}
+
+// Sum over dimension 1 (channels), output has shape [B,1,H,W]
+// We parallelize over output elements: each thread computes sum for one (b,1,h,w)
+__global__ void sum_dim1_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int64_t B,
+    int64_t C,
+    int64_t H,
+    int64_t W,
+    const int64_t* __restrict__ input_strides, // input stride array [B_stride, C_stride, H_stride, W_stride]
+    const int64_t* __restrict__ output_strides) { // output stride array [B_stride, 1_stride, H_stride, W_stride]
+
+    int64_t total = B * H * W;
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)blockDim.x * gridDim.x;
+
+    for (; idx < total; idx += stride) {
+        int64_t w = idx % W;
+        int64_t tmp = idx / W;
+        int64_t h = tmp % H;
+        int64_t b = tmp / H;
+
+        float sum = 0.0f;
+        for (int64_t c = 0; c < C; ++c) {
+            int64_t in_offset = b * input_strides[0] + c * input_strides[1] +
+                                h * input_strides[2] + w * input_strides[3];
+            sum += input[in_offset];
+        }
+        int64_t out_offset = b * output_strides[0] + h * output_strides[2] + w * output_strides[3];
+        // output_strides[1] is the stride for the singleton dimension, but it's not needed since we write to one position
+        // We ignore stride[1] for the singleton dimension, but the output shape has that dim size 1, offset is correct.
+        // If stride[1] is not zero, the above formula missing term: 1 * stride[1] which equals stride[1].
+        // But since dim size is 1, the index is always 0, so offset = b*s0 + 0*s1 + h*s2 + w*s3. So we should include + 0*stride which is 0.
+        // The above expression is b*s0 + h*s2 + w*s3, which is correct.
+        output[out_offset] = sum;
+    }
+}
+
+// Expand kernel: replicate input along dimension 1.
+// Input shape is [B,1,H,W], output is [B,out_features,H,W] with output_stride[1] possibly 0 (broadcast).
+// We iterate over output elements; for each output element we compute input offset using broadcast rules on the second dimension.
+__global__ void expand_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int64_t B,
+    int64_t out_features,
+    int64_t H,
+    int64_t W,
+    const int64_t* __restrict__ input_strides,  // [s_B, s_1, s_H, s_W] for input shape [B,1,H,W], s_1 can be anything but dim=1
+    const int64_t* __restrict__ output_strides) {
+
+    int64_t total = B * out_features * H * W;
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)blockDim.x * gridDim.x;
+
+    for (; idx < total; idx += stride) {
+        int64_t w = idx % W;
+        int64_t tmp = idx / W;
+        int64_t h = tmp % H;
+        tmp /= H;
+        int64_t b = tmp / out_features;
+        // out_feat = tmp % out_features, but input always uses dimension 1 index 0
+        // input offset: b * s0 + 0 * s1 + h * s2 + w * s3
+        int64_t in_offset = b * input_strides[0] + h * input_strides[2] + w * input_strides[3];
+        int64_t out_offset = b * output_strides[0] + (idx / (H * W)) % out_features * output_strides[1] +
+                             h * output_strides[2] + w * output_strides[3];
+        output[out_offset] = input[in_offset];
+    }
+}
+
+// Launcher for ReLU6
+extern "C" void relu6_forward_launcher(
+    const float* input,
+    float* output,
+    int64_t total_elements,
+    int ndim,
+    const int64_t* dims,
+    const int64_t* input_strides,
+    const int64_t* output_strides,
+    cudaStream_t stream) {
+
+    int threads = 256;
+    int64_t blocks64 = (total_elements + threads - 1) / threads;
+    int blocks = (blocks64 > 2147483647) ? 2147483647 : (int)blocks64;
+    relu6_kernel<<<blocks, threads, 0, stream>>>(
+        input, output, total_elements, ndim, dims, input_strides, output_strides);
+}
+
+// Launcher for sum_dim1
+extern "C" void sum_dim1_forward_launcher(
+    const float* input,
+    float* output,
+    int64_t B,
+    int64_t C,
+    int64_t H,
+    int64_t W,
+    const int64_t* input_strides,
+    const int64_t* output_strides,
+    cudaStream_t stream) {
+
+    int threads = 256;
+    int64_t total = B * H * W;
+    int64_t blocks64 = (total + threads - 1) / threads;
+    int blocks = (blocks64 > 2147483647) ? 2147483647 : (int)blocks64;
+    sum_dim1_kernel<<<blocks, threads, 0, stream>>>(
+        input, output, B, C, H, W, input_strides, output_strides);
+}
+
+// Launcher for expand
+extern "C" void expand_forward_launcher(
+    const float* input,
+    float* output,
+    int64_t B,
+    int64_t out_features,
+    int64_t H,
+    int64_t W,
+    const int64_t* input_strides,
+    const int64_t* output_strides,
+    cudaStream_t stream) {
+
+    int threads = 256;
+    int64_t total = B * out_features * H * W;
+    int64_t blocks64 = (total + threads - 1) / threads;
+    int blocks = (blocks64 > 2147483647) ? 2147483647 : (int)blocks64;
+    expand_kernel<<<blocks, threads, 0, stream>>>(
+        input, output, B, out_features, H, W, input_strides, output_strides);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,162 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include <vector>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void relu6_forward_launcher(
+    const float* input,
+    float* output,
+    int64_t total_elements,
+    int ndim,
+    const int64_t* dims,
+    const int64_t* input_strides,
+    const int64_t* output_strides,
+    cudaStream_t stream);
+
+extern "C" void sum_dim1_forward_launcher(
+    const float* input,
+    float* output,
+    int64_t B,
+    int64_t C,
+    int64_t H,
+    int64_t W,
+    const int64_t* input_strides,
+    const int64_t* output_strides,
+    cudaStream_t stream);
+
+extern "C" void expand_forward_launcher(
+    const float* input,
+    float* output,
+    int64_t B,
+    int64_t out_features,
+    int64_t H,
+    int64_t W,
+    const int64_t* input_strides,
+    const int64_t* output_strides,
+    cudaStream_t stream);
+
+static std::vector<int64_t> get_contiguous_strides(const std::vector<int64_t>& shape) {
+    std::vector<int64_t> strides(shape.size());
+    int64_t acc = 1;
+    for (int i = shape.size() - 1; i >= 0; --i) {
+        strides[i] = acc;
+        acc *= shape[i];
+    }
+    return strides;
+}
+
+torch::Tensor relu6_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "relu6_forward: input must be CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "relu6_forward: input must be float32");
+    TORCH_CHECK(x.dim() >= 1, "relu6_forward: input must have at least 1 dimension");
+
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    int64_t total_elements = x.numel();
+    int ndim = x.dim();
+    std::vector<int64_t> dims(x.sizes().begin(), x.sizes().end());
+    std::vector<int64_t> input_strides(x.strides().begin(), x.strides().end());
+    std::vector<int64_t> output_strides(output.strides().begin(), output.strides().end());
+
+    relu6_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        total_elements,
+        ndim,
+        dims.data(),
+        input_strides.data(),
+        output_strides.data(),
+        stream
+    );
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "relu6_forward kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+torch::Tensor sum_dim1_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "sum_dim1_forward: input must be CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "sum_dim1_forward: input must be float32");
+    TORCH_CHECK(x.dim() == 4, "sum_dim1_forward: input must be 4D [B, C, H, W]");
+
+    int64_t B = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+
+    // Output shape [B, 1, H, W], contiguous
+    auto output = torch::empty({B, 1, H, W}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    std::vector<int64_t> input_strides(x.strides().begin(), x.strides().end());
+    std::vector<int64_t> output_strides(output.strides().begin(), output.strides().end());
+
+    sum_dim1_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        B,
+        C,
+        H,
+        W,
+        input_strides.data(),
+        output_strides.data(),
+        stream
+    );
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "sum_dim1_forward kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+torch::Tensor expand_forward(torch::Tensor x, int64_t out_features) {
+    TORCH_CHECK(x.is_cuda(), "expand_forward: input must be CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "expand_forward: input must be float32");
+    TORCH_CHECK(x.dim() == 4, "expand_forward: input must be 4D [B, 1, H, W]");
+    TORCH_CHECK(x.size(1) == 1, "expand_forward: dimension 1 must be size 1");
+
+    int64_t B = x.size(0);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+
+    // Create output shape [B, out_features, H, W] with stride[1] = 0 (broadcast view)
+    std::vector<int64_t> output_shape = {B, out_features, H, W};
+    std::vector<int64_t> output_strides = {x.stride(0), 0, x.stride(2), x.stride(3)};
+    auto output = torch::empty_strided(output_shape, output_strides, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    std::vector<int64_t> input_strides(x.strides().begin(), x.strides().end());
+
+    expand_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        B,
+        out_features,
+        H,
+        W,
+        input_strides.data(),
+        output_strides.data(),
+        stream
+    );
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "expand_forward kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("relu6_forward", &relu6_forward, "ReLU6 activation", py::arg("x"));
+    m.def("sum_dim1_forward", &sum_dim1_forward, "Sum over dimension 1", py::arg("x"));
+    m.def("expand_forward", &expand_forward, "Expand dimension 1", py::arg("x"), py::arg("out_features"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
