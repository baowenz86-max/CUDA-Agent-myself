+    else if (dim0 == 2 && dim1 == 3) { tmp=o2; o2=o3; o3=tmp; }
+
+    long long out_idx = ((long long)o0 * out1 * out2 * out3 +
+                         (long long)o1 * out2 * out3 +
+                         (long long)o2 * out3 +
+                         o3);
+    output[out_idx] = input[idx];
