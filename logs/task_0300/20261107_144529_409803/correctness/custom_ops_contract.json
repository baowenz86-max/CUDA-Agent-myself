{
  "operators": [
    {
      "name": "layer_norm_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[1024, 512, 64]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[64]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[64]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "normalized_shape",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "eps",
          "kind": "float",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[1024, 512, 64]"
      },
      "semantics": [
        "对应参考语句 x = self.layer_norm(x)，对输入最后一个维度（64）进行 Layer Normalization。",
        "先计算每个样本在最后一维上的均值和方差（有偏方差，即除以 N 而非 N-1），然后执行 (x - mean) / sqrt(var + eps) * weight + bias。",
        "weight 和 bias 形状均为 [64]，elementwise_affine=True 时参与计算。",
        "输出形状与输入相同，dtype 为 float32，device 为 cuda。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.layer_norm(x)",
      "semantics": [
        "对输入张量 x 在最后一个维度（长度 64）上进行 Layer Normalization，使用 weight 和 bias 进行仿射变换，eps=1e-5。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "return x",
      "semantics": [
        "返回归一化后的张量，形状 [1024, 512, 64]，dtype float32，设备 cuda。"
      ]
    }
  ]
}