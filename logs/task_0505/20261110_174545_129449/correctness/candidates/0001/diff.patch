--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,96 @@
+#include <cuda_runtime.h>
+
+// GroupNorm forward kernel: one block per (n, group)
+// x is assumed contiguous with shape [N, C, HW] where HW = product of spatial dims
+// weight, bias are [C] contiguous
+template <int BLOCK_SIZE>
+__global__ void group_norm_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ y,
+    const float* __restrict__ weight,
+    const float* __restrict__ bias,
+    int C_per_group,
+    int HW,
+    float eps)
+{
+    extern __shared__ float smem[];
+    float* s_mean = smem;                    // group mean accumulator
+    float* s_var = smem + BLOCK_SIZE;        // group variance accumulator (sum of squares)
+
+    int group = blockIdx.x;
+    int n = blockIdx.y;
+    int tid = threadIdx.x;
+
+    int channels_per_group = C_per_group;
+    int total_elems = channels_per_group * HW;
+
+    // local accumulation
+    float local_sum = 0.0f;
+    float local_sq = 0.0f;
+
+    const float* x_base = x + (long long)n * (channels_per_group * group * HW) + (long long)group * channels_per_group * HW;
+    // Actually x layout: [N, C, HW], for group g, channels start at group * channels_per_group
+    // The above base is incorrect; fix:
+    const float* x_group_base = x + (long long)n * (channels_per_group * (blockIdx.y == 0 ? 0 : 0));
+    // Simpler: compute offset
+    int C_total = channels_per_group * gridDim.x; // not known here, pass as parameter
+
+    // We'll use loop over elements with grid-stride for accumulation
+    for (int i = tid; i < total_elems; i += BLOCK_SIZE) {
+        int c_local = i / HW;
+        int s = i - c_local * HW;
+        int c_global = group * channels_per_group + c_local;
+        float val = x[(long long)n * C_total * HW + (long long)c_global * HW + s];
+        local_sum += val;
+        local_sq += val * val;
+    }
+
+    // block reduction
+    s_mean[tid] = local_sum;
+    s_var[tid] = local_sq;
+    __syncthreads();
+
+    for (int stride = BLOCK_SIZE / 2; stride > 0; stride >>= 1) {
+        if (tid < stride) {
+            s_mean[tid] += s_mean[tid + stride];
+            s_var[tid] += s_var[tid + stride];
+        }
+        __syncthreads();
+    }
+
+    float mean = s_mean[0] / total_elems;
+    float var = s_var[0] / total_elems - mean * mean;
+    float invstd = rsqrtf(var + eps);
+
+    // write output
+    for (int i = tid; i < total_elems; i += BLOCK_SIZE) {
+        int c_local = i / HW;
+        int s = i - c_local * HW;
+        int c_global = group * channels_per_group + c_local;
+        float val = x[(long long)n * C_total * HW + (long long)c_global * HW + s];
+        y[(long long)n * C_total * HW + (long long)c_global * HW + s] =
+            (val - mean) * invstd * weight[c_global] + bias[c_global];
+    }
+}
+
+// Launcher function (extern "C" for binding)
+extern "C" void group_norm_forward_launcher(
+    const float* x,
+    float* y,
+    const float* weight,
+    const float* bias,
+    int64_t N,
+    int64_t C,
+    int64_t HW,
+    int64_t num_groups,
+    double eps,
+    cudaStream_t stream)
+{
+    int channels_per_group = (int)(C / num_groups);
+    dim3 grid(num_groups, N);
+    dim3 block(256); // tune later
+    int smem_size = 2 * block.x * sizeof(float);
+
+    group_norm_kernel<256><<<grid, block, smem_size, stream>>>(
+        x, y, weight, bias, channels_per_group, (int)HW, (float)eps);
+}
--- before/kernels/group_norm_binding.cpp
+++ after/kernels/group_norm_binding.cpp
@@ -0,0 +1,85 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Launcher declaration from custom_ops.cu
+extern "C" void group_norm_forward_launcher(
+    const float* x,
+    float* y,
+    const float* weight,
+    const float* bias,
+    int64_t N,
+    int64_t C,
+    int64_t HW,
+    int64_t num_groups,
+    double eps,
+    cudaStream_t stream);
+
+// PyTorch binding function
+torch::Tensor group_norm_forward(
+    torch::Tensor x,
+    torch::Tensor weight,
+    torch::Tensor bias,
+    int64_t num_groups,
+    double eps) {
+    // Input validation
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(weight.is_cuda(), "weight must be a CUDA tensor");
+    TORCH_CHECK(bias.is_cuda(), "bias must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(weight.dtype() == torch::kFloat32, "weight must be float32");
+    TORCH_CHECK(bias.dtype() == torch::kFloat32, "bias must be float32");
+
+    // Ensure tensors are contiguous (the kernel assumes contiguous memory layout)
+    auto x_contig = x.contiguous();
+    auto weight_contig = weight.contiguous();
+    auto bias_contig = bias.contiguous();
+
+    // Dimensions
+    int64_t N = x_contig.size(0);
+    int64_t C = x_contig.size(1);
+    int64_t total = x_contig.numel();
+    int64_t HW = total / (N * C);
+
+    TORCH_CHECK(C % num_groups == 0, "C must be divisible by num_groups");
+
+    // Allocate output with same shape as input (contiguous)
+    auto y = torch::empty_like(x_contig);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    group_norm_forward_launcher(
+        x_contig.data_ptr<float>(),
+        y.data_ptr<float>(),
+        weight_contig.data_ptr<float>(),
+        bias_contig.data_ptr<float>(),
+        N,
+        C,
+        HW,
+        num_groups,
+        eps,
+        stream);
+
+    // Check for CUDA errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA kernel launch failed: ", cudaGetErrorString(err));
+
+    return y;
+}
+
+// Registration
+void register_group_norm(pybind11::module& m) {
+    m.def("group_norm_forward", &group_norm_forward,
+          "Group Normalization forward (CUDA)",
+          py::arg("x"),
+          py::arg("weight"),
+          py::arg("bias"),
+          py::arg("num_groups"),
+          py::arg("eps"));
+}
+
+REGISTER_BINDING(group_norm, register_group_norm);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,30 @@
+import torch
+import cuda_extension
+
+
+class ModelNew(torch.nn.Module):
+    def __init__(self, feature_size, num_groups, eps=1e-5, affine=True):
+        super().__init__()
+        self.group_norm = torch.nn.GroupNorm(num_groups=num_groups, num_channels=feature_size, eps=eps, affine=affine)
+
+    def forward(self, x):
+        x = cuda_extension.group_norm_forward(
+            x,
+            self.group_norm.weight,
+            self.group_norm.bias,
+            self.group_norm.num_groups,
+            self.group_norm.eps
+        )
+        return x
+
+    def debug_forward(self, *inputs):
+        x = inputs[0]
+        out = cuda_extension.group_norm_forward(
+            x,
+            self.group_norm.weight,
+            self.group_norm.bias,
+            self.group_norm.num_groups,
+            self.group_norm.eps
+        )
+        yield 'step_001', out
+        yield 'step_002', out
