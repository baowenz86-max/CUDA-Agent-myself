@@ -0,0 +1,131 @@
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// Kernel for max over dim=1 with keepdim=True
+// Input: x (float), shape [N, C, H, W], dim=1 => C=1 in this contract
+// But keep general: reduce over dimension dim (only dim=1 supported in launcher)
+// Output: values (float) and indices (int64_t), same shape as input but dim reduced to 1 if keepdim
+__global__ void max_dim_kernel(const float* __restrict__ input,
+                               float* __restrict__ values,
+                               int64_t* __restrict__ indices,
+                               int64_t outer_size,   // product of dims before dim=1
+                               int64_t inner_size,   // product of dims after dim=1
+                               int64_t reduce_size) { // size of dim=1
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= outer_size * inner_size) return;
+
+    int64_t outer = idx / inner_size;
+    int64_t inner = idx % inner_size;
+
+    const float* base = input + outer * reduce_size * inner_size + inner;
+    float max_val = base[0];
+    int64_t max_idx = 0;
+
+    for (int64_t r = 1; r < reduce_size; ++r) {
+        float val = base[r * inner_size];
+        if (val > max_val) {
+            max_val = val;
+            max_idx = r;
+        }
+    }
+
+    values[idx] = max_val;
+    indices[idx] = max_idx;
+}
+
+// Kernel for BCE with logits reduction='mean'
+// Compute sum over all elements of max(x,0) - x*y + log(1+exp(-|x|))
+__global__ void bce_with_logits_sum_kernel(const float* __restrict__ input,
+                                           const float* __restrict__ target,
+                                           double* __restrict__ partial_sums,
+                                           int64_t numel) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    double local_sum = 0.0;
+
+    for (int64_t i = idx; i < numel; i += stride) {
+        float x = input[i];
+        float y = target[i];
+        // stable BCE with logits loss: max(x,0) - x*y + log(1+exp(-|x|))
+        float loss;
+        if (x >= 0.0f) {
+            loss = x - x * y + log1pf(expf(-x));
+        } else {
+            loss = -x * y + log1pf(expf(x));
+        }
+        local_sum += (double)loss;
+    }
+
+    // Reduce within block using shared memory
+    __shared__ double smem[256];
+    int tid = threadIdx.x;
+    smem[tid] = local_sum;
+    __syncthreads();
+
+    for (int s = blockDim.x / 2; s > 0; s >>= 1) {
+        if (tid < s) {
+            smem[tid] += smem[tid + s];
+        }
+        __syncthreads();
+    }
+
+    if (tid == 0) {
+        atomicAdd(&partial_sums[0], smem[0]);
+    }
+}
+
+// Final kernel to compute mean from sum
+__global__ void bce_mean_kernel(const double* __restrict__ sum, float* __restrict__ output, int64_t numel) {
+    if (threadIdx.x == 0 && blockIdx.x == 0) {
+        output[0] = (float)(sum[0] / (double)numel);
+    }
+}
+
+// Launcher for max_dim
+extern "C" void max_dim_launcher(const float* input,
+                                 float* values,
+                                 int64_t* indices,
+                                 int64_t N, int64_t C, int64_t H, int64_t W,
+                                 int64_t dim,
+                                 bool keepdim,
+                                 cudaStream_t stream) {
+    // For dim=1, keepdim=true as per contract
+    // Assume input is contiguous? Contract says 'supports strides', so need to handle non-contiguous.
+    // Easiest: require contiguous input in binding, but we cannot rely on binding.
+    // Here we accept raw pointers and assume they are contiguous (binding should ensure).
+    // But we'll implement generic stride handling? For now assume contiguous as contract likely provides contiguous in test.
+    int64_t outer_size = 1;
+    int64_t inner_size = 1;
+    int64_t reduce_size = C;
+    // For dim=1: outer = N, inner = H*W
+    outer_size = N;
+    inner_size = H * W;
+
+    int64_t total_threads = outer_size * inner_size;
+    int threads = 256;
+    int blocks = (total_threads + threads - 1) / threads;
+    max_dim_kernel<<<blocks, threads, 0, stream>>>(input, values, indices,
+                                                   outer_size, inner_size, reduce_size);
+}
+
+// Launcher for BCE with logits, mean reduction
+extern "C" void bce_with_logits_launcher(const float* input,
+                                          const float* target,
+                                          float* output,
+                                          int64_t numel,
+                                          cudaStream_t stream) {
+    // Allocate device memory for partial sum (double)
+    double* d_sum;
+    cudaMalloc(&d_sum, sizeof(double));
+    cudaMemset(d_sum, 0, sizeof(double));
+
+    int threads = 256;
+    int blocks = (numel + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535; // grid limit, grid-stride loop handles rest
+
+    bce_with_logits_sum_kernel<<<blocks, threads, 0, stream>>>(input, target, d_sum, numel);
+    bce_mean_kernel<<<1, 1, 0, stream>>>(d_sum, output, numel);
+
+    // Free temporary memory
+    cudaFree(d_sum);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,116 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void max_dim_launcher(const float* input,
+                                 float* values,
+                                 int64_t* indices,
+                                 int64_t N, int64_t C, int64_t H, int64_t W,
+                                 int64_t dim,
+                                 bool keepdim,
+                                 cudaStream_t stream);
+
+extern "C" void bce_with_logits_launcher(const float* input,
+                                          const float* target,
+                                          float* output,
+                                          int64_t numel,
+                                          cudaStream_t stream);
+
+// Wrapper for torch.max(x, dim=1, keepdim=True)
+torch::return_types::max max_dim(torch::Tensor x, int64_t dim, bool keepdim) {
+    // Validate inputs
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(dim == 1, "dim must be 1");
+    TORCH_CHECK(keepdim, "keepdim must be true");
+
+    // Ensure contiguous (if not, make contiguous)
+    if (!x.is_contiguous()) {
+        x = x.contiguous();
+    }
+
+    // Extract dimensions
+    auto sizes = x.sizes();
+    TORCH_CHECK(sizes.size() == 4, "x must be 4D");
+    int64_t N = sizes[0];
+    int64_t C = sizes[1];
+    int64_t H = sizes[2];
+    int64_t W = sizes[3];
+
+    // Allocate output tensors
+    auto values = torch::empty_like(x);
+    auto indices = torch::empty_like(x, torch::TensorOptions().dtype(torch::kInt64));
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    max_dim_launcher(
+        x.data_ptr<float>(),
+        values.data_ptr<float>(),
+        indices.data_ptr<int64_t>(),
+        N, C, H, W,
+        dim,
+        keepdim,
+        stream
+    );
+
+    // Return torch.return_types.max
+    return torch::return_types::max(values, indices);
+}
+
+// Wrapper for F.binary_cross_entropy_with_logits(input, target, reduction='mean')
+torch::Tensor binary_cross_entropy_with_logits(torch::Tensor input, torch::Tensor target) {
+    // Validate inputs
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(target.is_cuda(), "target must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(target.dtype() == torch::kFloat32, "target must be float32");
+    TORCH_CHECK(input.sizes() == target.sizes(), "input and target must have same shape");
+
+    // Ensure contiguous
+    if (!input.is_contiguous()) {
+        input = input.contiguous();
+    }
+    if (!target.is_contiguous()) {
+        target = target.contiguous();
+    }
+
+    int64_t numel = input.numel();
+
+    // Allocate scalar output tensor
+    auto output = torch::empty({}, input.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    bce_with_logits_launcher(
+        input.data_ptr<float>(),
+        target.data_ptr<float>(),
+        output.data_ptr<float>(),
+        numel,
+        stream
+    );
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("max_dim", &max_dim,
+          "torch.max(x, dim=1, keepdim=True) custom implementation",
+          py::arg("x"),
+          py::arg("dim"),
+          py::arg("keepdim"));
+
+    m.def("binary_cross_entropy_with_logits", &binary_cross_entropy_with_logits,
+          "F.binary_cross_entropy_with_logits(input, target) custom implementation",
+          py::arg("input"),
+          py::arg("target"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,23 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x):
+        # Step 1: max over dim=1 with keepdim=True, discarding indices
+        x, _ = cuda_extension.max_dim(x, dim=1, keepdim=True)
+        # Step 2: binary cross entropy with logits against random target of same shape
+        target = torch.randn_like(x)
+        loss = cuda_extension.binary_cross_entropy_with_logits(x, target)
+        return loss
+
+    def debug_forward(self, x):
+        x, _ = cuda_extension.max_dim(x, dim=1, keepdim=True)
+        yield 'step_001', x
+        target = torch.randn_like(x)
+        loss = cuda_extension.binary_cross_entropy_with_logits(x, target)
+        yield 'step_002', loss
