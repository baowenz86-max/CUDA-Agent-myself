--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,61 @@
+#include <cuda_runtime.h>
+
+// Mean over dimension 0 for input shape [B, C, H, W] with B=16.
+// Output shape [C, H, W]. Each thread computes one output element by accumulating over B.
+__global__ void mean_dim0_kernel(const float* __restrict__ input,
+                                 float* __restrict__ output,
+                                 int B, int C, int H, int W) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = C * H * W;
+    if (idx >= total) return;
+
+    int w = idx % W;
+    int h = (idx / W) % H;
+    int c = idx / (H * W);
+
+    float sum = 0.0f;
+    // input is contiguous with shape [B,C,H,W]
+    // offset = (((b * C + c) * H + h) * W + w)
+    const float* base = input + ((long long)c * H + h) * W + w;
+    for (int b = 0; b < B; ++b) {
+        sum += base[(long long)b * C * H * W];
+    }
+    output[idx] = sum / (float)B;
+}
+
+// Hardswish elementwise: x * min(max(x+3,0),6)/6
+__global__ void hardswish_kernel(const float* __restrict__ input,
+                                 float* __restrict__ output,
+                                 long long total) {
+    long long idx = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+    for (long long i = idx; i < total; i += stride) {
+        float x = input[i];
+        float relu6 = fminf(fmaxf(x + 3.0f, 0.0f), 6.0f);
+        output[i] = x * relu6 * (1.0f / 6.0f);
+    }
+}
+
+// Launcher for mean over dim 0
+extern "C" void mean_dim0_launcher(const float* input,
+                                   float* output,
+                                   int B, int C, int H, int W,
+                                   cudaStream_t stream) {
+    int total = C * H * W;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    mean_dim0_kernel<<<blocks, threads, 0, stream>>>(input, output, B, C, H, W);
+}
+
+// Launcher for hardswish
+extern "C" void hardswish_launcher(const float* input,
+                                    float* output,
+                                    long long total,
+                                    cudaStream_t stream) {
+    int threads = 256;
+    // Use grid stride, cap blocks to avoid overflow and adjust for large total
+    int blocks = (int)min((long long)((total + threads - 1) / threads), (long long)65535);
+    // If total is huge, grid-stride loop handles it; ensure blocks > 0 if total >0
+    if (blocks == 0) blocks = 1;
+    hardswish_kernel<<<blocks, threads, 0, stream>>>(input, output, total);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,82 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_runtime.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void mean_dim0_launcher(const float* input,
+                                   float* output,
+                                   int B, int C, int H, int W,
+                                   cudaStream_t stream);
+
+extern "C" void hardswish_launcher(const float* input,
+                                    float* output,
+                                    long long total,
+                                    cudaStream_t stream);
+
+// Helper to check CUDA errors after launch
+static void check_cuda_error(const char* msg) {
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, msg, ": ", cudaGetErrorString(err));
+}
+
+// mean over dimension 0
+static torch::Tensor mean_dim0(torch::Tensor x) {
+    // Input checks: CUDA, float32, 4D
+    TORCH_CHECK(x.is_cuda(), "mean_dim0: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "mean_dim0: input must be float32");
+    TORCH_CHECK(x.dim() == 4, "mean_dim0: input must be 4D [B,C,H,W]");
+
+    // The kernel currently assumes contiguous input; make contiguous
+    auto x_contig = x.contiguous();
+
+    int B = x_contig.size(0);
+    int C = x_contig.size(1);
+    int H = x_contig.size(2);
+    int W = x_contig.size(3);
+    TORCH_CHECK(B > 0 && C > 0 && H > 0 && W > 0, "mean_dim0: non-positive dimensions");
+
+    // Output shape [C,H,W]
+    auto output = torch::empty({C, H, W}, x_contig.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    mean_dim0_launcher(x_contig.data_ptr<float>(),
+                       output.data_ptr<float>(),
+                       B, C, H, W,
+                       stream);
+    check_cuda_error("mean_dim0 launch failed");
+
+    return output;
+}
+
+// hardswish elementwise
+static torch::Tensor hardswish(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "hardswish: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "hardswish: input must be float32");
+
+    auto x_contig = x.contiguous();
+    auto output = torch::empty_like(x_contig);
+
+    long long total = x_contig.numel();
+    if (total > 0) {
+        cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+        hardswish_launcher(x_contig.data_ptr<float>(),
+                           output.data_ptr<float>(),
+                           total,
+                           stream);
+        check_cuda_error("hardswish launch failed");
+    }
+
+    return output;
+}
+
+// Registration
+static void register_custom_ops(pybind11::module& m) {
+    m.def("mean_dim0", &mean_dim0, "Mean over dimension 0 (float32 CUDA)",
+          pybind11::arg("x"));
+    m.def("hardswish", &hardswish, "Hardswish activation (float32 CUDA)",
+          pybind11::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
