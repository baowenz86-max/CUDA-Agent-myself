--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,85 @@
+#include <cuda_runtime.h>
+
+// Kernel: compute mean over batch dimension (dim=0)
+// Input: x shape [batch, channels, height, width]
+// Output: out shape [channels, height, width]
+// Each thread computes one or more output elements (grid-stride loop).
+__global__ void mean_reduce_kernel(const float* __restrict__ input,
+                                   float* __restrict__ output,
+                                   int batch,
+                                   int channels,
+                                   int height,
+                                   int width) {
+    // Output element index: c * height * width + h * width + w
+    int out_idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+    int total_out = channels * height * width;
+
+    for (int idx = out_idx; idx < total_out; idx += stride) {
+        int w = idx % width;
+        int tmp = idx / width;
+        int h = tmp % height;
+        int c = tmp / height;
+
+        // Accumulate over batch dimension
+        float sum = 0.0f;
+        for (int b = 0; b < batch; ++b) {
+            // Input is assumed contiguous or at least accessible with standard strides.
+            // Use pointer arithmetic matching contiguous layout; binding should ensure contiguous or provide strides.
+            // Since tensor is contiguous in task (stride [50331648, 16777216, 4096, 1]), we use this simple indexing.
+            // To support arbitrary strides, launcher would need stride info. For now, contract says supports strides,
+            // but actual input is contiguous. We'll require contiguous in binding, or make launcher handle via strides not possible with only pointer and dims.
+            // We'll note that this kernel assumes contiguous input. If non-contiguous, caller must make contiguous before call.
+            // This is acceptable for current task.
+            int in_idx = ((b * channels + c) * height + h) * width + w;
+            sum += input[in_idx];
+        }
+        output[idx] = sum / static_cast<float>(batch);
+    }
+}
+
+// Kernel: Hardswish elementwise
+__global__ void hardswish_kernel(const float* __restrict__ input,
+                                 float* __restrict__ output,
+                                 int total_elements) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+
+    for (int i = idx; i < total_elements; i += stride) {
+        float x = input[i];
+        float relu6 = fminf(fmaxf(x + 3.0f, 0.0f), 6.0f);
+        output[i] = x * relu6 / 6.0f;
+    }
+}
+
+// Launcher for mean reduction (extern "C" for binding)
+extern "C" void custom_mean_launcher(const float* input,
+                                      float* output,
+                                      int batch,
+                                      int channels,
+                                      int height,
+                                      int width,
+                                      cudaStream_t stream) {
+    int total_out = channels * height * width;
+    int threads = 256;
+    int blocks = (total_out + threads - 1) / threads;
+    // Limit blocks to avoid excessive grid size? grid-stride loop handles large sizes.
+    // Max blocks for current GPUs is large enough, but we can cap at 65535*? For safety, we use a moderate number.
+    // Actually we can just compute blocks = min((total_out + threads -1)/threads, 1024*?)
+    // Use grid size that covers all elements with at most 256 threads per block.
+    // For 50M output elements, blocks ~ 196608, which is okay on most GPUs (max grid dim x = 2^31-1 for 1D).
+    // But to improve occupancy, we can use a fixed grid like 256 blocks * 256 threads = 65536 threads, enough with grid-stride.
+    // We'll set blocks to a configurable number? Use min(blocks, 65535) but max blocks in x dimension is 2^31-1 for compute capability >=3.0.
+    // So no worry.
+    mean_reduce_kernel<<<blocks, threads, 0, stream>>>(input, output, batch, channels, height, width);
+}
+
+// Launcher for Hardswish (extern "C" for binding)
+extern "C" void custom_hardswish_launcher(const float* input,
+                                          float* output,
+                                          int total_elements,
+                                          cudaStream_t stream) {
+    int threads = 256;
+    int blocks = (total_elements + threads - 1) / threads;
+    hardswish_kernel<<<blocks, threads, 0, stream>>>(input, output, total_elements);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,99 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void custom_mean_launcher(
+    const float* input,
+    float* output,
+    int batch,
+    int channels,
+    int height,
+    int width,
+    cudaStream_t stream);
+
+extern "C" void custom_hardswish_launcher(
+    const float* input,
+    float* output,
+    int total_elements,
+    cudaStream_t stream);
+
+// PyTorch binding for custom_mean
+torch::Tensor custom_mean_forward(torch::Tensor x, int64_t dim) {
+    // Input validation
+    TORCH_CHECK(x.is_cuda(), "custom_mean: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "custom_mean: input must be float32");
+    TORCH_CHECK(dim == 0, "custom_mean: only dim=0 is supported");
+    TORCH_CHECK(x.dim() == 4, "custom_mean: input must be 4D");
+
+    // Make input contiguous to match launcher's assumed memory layout
+    auto x_contig = x.contiguous();
+
+    // Extract dimensions
+    int64_t batch = x_contig.size(0);
+    int64_t channels = x_contig.size(1);
+    int64_t height = x_contig.size(2);
+    int64_t width = x_contig.size(3);
+
+    // Allocate output tensor: shape [channels, height, width]
+    auto output = torch::empty({channels, height, width}, x_contig.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    custom_mean_launcher(
+        x_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int>(batch),
+        static_cast<int>(channels),
+        static_cast<int>(height),
+        static_cast<int>(width),
+        stream
+    );
+
+    return output;
+}
+
+// PyTorch binding for custom_hardswish
+torch::Tensor custom_hardswish_forward(torch::Tensor x) {
+    // Input validation
+    TORCH_CHECK(x.is_cuda(), "custom_hardswish: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "custom_hardswish: input must be float32");
+
+    // Make input contiguous to match launcher's elementwise access
+    auto x_contig = x.contiguous();
+
+    // Allocate output tensor with same shape
+    auto output = torch::empty_like(x_contig);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    custom_hardswish_launcher(
+        x_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int>(x_contig.numel()),
+        stream
+    );
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_mean", &custom_mean_forward,
+          "Compute mean over dim=0",
+          pybind11::arg("x"),
+          pybind11::arg("dim"));
+    m.def("custom_hardswish", &custom_hardswish_forward,
+          "Apply Hardswish activation",
+          pybind11::arg("x"));
+}
+
+// Auto-register
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,20 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        x = cuda_extension.custom_mean(x, 0)
+        x = cuda_extension.custom_hardswish(x)
+        return x
+
+    def debug_forward(self, x: torch.Tensor):
+        x_mean = cuda_extension.custom_mean(x, 0)
+        yield 'step_001', x_mean
+        x_hardswish = cuda_extension.custom_hardswish(x_mean)
+        yield 'step_002', x_hardswish
+        yield 'step_003', x_hardswish
