      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, out_features]"
      },
      "semantics": [
        "计算 a @ b_t.T，即矩阵乘",
        "对应参考语句 input_t @ weight_ih.T 和 h_t @ weight_hh.T",
        "cuBLAS 默认 sgemm，使用 column-major 技巧"
      ]
    },
    {
      "name": "add_bias_forward",
