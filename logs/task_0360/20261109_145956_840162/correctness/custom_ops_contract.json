        {
          "name": "bias_hh",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[hidden_size]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, hidden_size]"
      },
      "semantics": [
        "输出 = tanh(gemm_ih + gemm_hh + bias_ih + bias_hh)",
        "对应参考步骤 h_{t+1} = tanh(...)"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "return self.rnn(x)",
