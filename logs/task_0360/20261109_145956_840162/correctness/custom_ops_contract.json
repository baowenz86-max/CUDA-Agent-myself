        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, hidden_size]"
      },
      "semantics": [
        "计算 h_{t+1} = tanh(input_t @ weight_ih.T + h_t @ weight_hh.T + bias_ih + bias_hh)",
        "对应参考步骤 torch._C._VariableFunctions.rnn_tanh 的内部 single-layer single-step 计算",
        "输入和输出均为 float32 CUDA tensor",
        "GEMM 使用 cuBLAS，加偏置和激活在融合 kernel 中完成"
      ]
    },
    {
      "name": "gemm_forward",
      "parameters": [
        {
          "name": "a",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
