--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,39 @@
+#include <cuda_runtime.h>
+
+// 融合 leaky_relu 和 relu：先 leaky_relu(x, negative_slope) 再 relu，等价于 max(0, leaky_relu(x, negative_slope))
+// 由于 leaky_relu(x, negative_slope) = x if x>=0 else negative_slope*x
+// 然后 relu 作用后，对于 x>=0 结果不变仍为 x；对于 x<0，leaky_relu 输出为 negative_slope*x (负数)，relu 后为 0
+// 因此最终结果就是 max(x, 0)，与 negative_slope 无关！但为了严格遵循语义，我们仍然按照先 leaky 后 relu 计算。
+// 考虑到性能，直接计算最终结果：output = x >= 0 ? x : 0.0f
+// 但如果未来 negative_slope 变化，此融合仍适用。我们保留 negative_slope 参数，但计算时利用数学等价性。
+__global__ void leaky_then_relu_kernel(const float* __restrict__ input,
+                                      float* __restrict__ output,
+                                      int64_t numel,
+                                      float negative_slope) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        float x = input[i];
+        float y = x >= 0.0f ? x : negative_slope * x;
+        y = y > 0.0f ? y : 0.0f;
+        output[i] = y;
+    }
+}
+
+// C 接口 launcher，供 binding.cpp 调用
+extern "C" void leaky_then_relu_launcher(const float* input,
+                                         float* output,
+                                         int64_t numel,
+                                         float negative_slope,
+                                         cudaStream_t stream) {
+    if (numel <= 0) return;
+    const int block_size = 256;
+    int64_t blocks = (numel + block_size - 1) / block_size;
+    // 限制 grid 大小，使用 grid-stride loop 处理大张量
+    int max_blocks = 65535; // 针对较旧的 GPU，现代 GPU 允许更大，但使用 grid-stride loop 更安全
+    if (blocks > max_blocks) {
+        blocks = max_blocks;
+    }
+    leaky_then_relu_kernel<<<(int)blocks, block_size, 0, stream>>>(
+        input, output, numel, negative_slope);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,55 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// 声明 .cu 文件中的 launcher
+extern "C" void leaky_then_relu_launcher(const float* input,
+                                         float* output,
+                                         int64_t numel,
+                                         float negative_slope,
+                                         cudaStream_t stream);
+
+// PyTorch 包装函数
+torch::Tensor leaky_then_relu(torch::Tensor x, double negative_slope = 0.01) {
+    // 检查输入
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.numel() > 0, "Input tensor is empty");
+
+    // 处理 non-contiguous 输入：显式连续化
+    auto x_contig = x.contiguous();
+
+    // 分配输出，匹配输入形状和 dtype
+    auto output = torch::empty_like(x_contig);
+
+    // 获取当前 CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // 调用 launcher
+    leaky_then_relu_launcher(
+        x_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        x_contig.numel(),
+        static_cast<float>(negative_slope),
+        stream
+    );
+
+    // 检查 kernel 启动错误（cudaGetLastError）
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// 注册函数
+void register_custom_ops(pybind11::module& m) {
+    m.def("leaky_then_relu", &leaky_then_relu,
+          "Fused leaky_relu followed by relu",
+          pybind11::arg("x"),
+          pybind11::arg("negative_slope") = 0.01);
+}
+
+// 自动注册
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,19 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x):
+        x = cuda_extension.leaky_then_relu(x, negative_slope=0.01)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.leaky_then_relu(x, negative_slope=0.01)
+        yield 'step_001', x
+        x = cuda_extension.leaky_then_relu(x, negative_slope=0.01)
+        yield 'step_002', x
+        yield 'step_003', x
