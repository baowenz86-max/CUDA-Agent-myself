{
  "operators": [
    {
      "name": "custom_mean",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference step: [128, 512, 512]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "default": 1,
          "optional": true,
          "nullable": false
        },
        {
          "name": "keepdim",
          "kind": "bool",
          "default": false,
          "optional": true,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as reference mean output: [128, 512]"
      },
      "semantics": [
        "对应参考语句 x = torch.mean(x, dim=1, keepdim=False)",
        "在 dim=1 维度上计算算术平均值，keepdim=False 因此输出 shape 为 [128,512]",
        "输入为 CUDA float32 张量，支持任意 stride，输出为连续张量",
        "与 torch.mean 数值语义一致，输出 dtype 保持 float32"
      ]
    },
    {
      "name": "custom_addmm",
      "parameters": [
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference bias: [128, 262144]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "mat1",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference mean output: [128, 512]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "mat2",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference mat2: [512, 262144]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as reference addmm output: [128, 262144]"
      },
      "semantics": [
        "对应参考语句 x = torch.addmm(self.bias, x, self.mat2)",
        "计算 beta*bias + alpha*(mat1 @ mat2)，其中 beta=1, alpha=1，bias 作为矩阵相加",
        "mat1 形状为 [128,512]，mat2 形状为 [512,262144]，输出形状为 [128,262144]",
        "所有张量均为 CUDA float32，支持任意 stride，输出为连续张量",
        "数值结果与 PyTorch addmm 一致"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = torch.mean(x, dim=1, keepdim=False)",
      "semantics": [
        "对输入 x [128,512,512] 沿 dim=1 求均值，keepdim=False，输出 [128,512]",
        "使用浮点累加的平均值，与 torch.mean 相同"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.addmm(self.bias, x, self.mat2)",
      "semantics": [
        "矩阵乘法 x @ mat2 后加上 bias，输出 [128,262144]",
        "bias 形状 [128,262144]，mat1 为均值输出 [128,512]，mat2 [512,262144]"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回最终张量，形状 [128,262144]，与 step_002 相同"
      ]
    }
  ]
}