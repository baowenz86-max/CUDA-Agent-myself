--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,183 @@
+// CUDA kernels for model_new.py custom ops
+#include <cuda_runtime.h>
+
+// -----------------------------------------------------------------------------
+// BatchNorm eval forward kernel
+// -----------------------------------------------------------------------------
+__global__ void batchnorm_eval_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    const float* __restrict__ weight,
+    const float* __restrict__ bias,
+    const float* __restrict__ running_mean,
+    const float* __restrict__ running_var,
+    float eps,
+    int N,          // total number of elements
+    int C,          // number of channels
+    int HW          // height * width
+) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+    for (int i = idx; i < N; i += stride) {
+        int c = (i / HW) % C;
+        float inv_std = rsqrtf(running_var[c] + eps);
+        output[i] = (input[i] - running_mean[c]) * inv_std * weight[c] + bias[c];
+    }
+}
+
+extern "C" void batchnorm_eval_launcher(
+    float* output,
+    const float* input,
+    const float* weight,
+    const float* bias,
+    const float* running_mean,
+    const float* running_var,
+    float eps,
+    int N,
+    int C,
+    int HW,
+    cudaStream_t stream
+) {
+    int threads = 256;
+    int blocks = (N + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535;
+    batchnorm_eval_kernel<<<blocks, threads, 0, stream>>>(
+        output, input, weight, bias, running_mean, running_var, eps, N, C, HW);
+}
+
+// -----------------------------------------------------------------------------
+// BMM kernel: out[b,i,j] = sum_k mat1[b,i,k] * mat2[b,k,j]
+// -----------------------------------------------------------------------------
+__global__ void bmm_naive_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ mat1,
+    const float* __restrict__ mat2,
+    int batch,
+    int M,
+    int N,
+    int K
+) {
+    int j = blockIdx.x * blockDim.x + threadIdx.x;
+    int i = blockIdx.y * blockDim.y + threadIdx.y;
+    if (i >= M || j >= N) return;
+    int b = blockIdx.z;
+    if (b >= batch) return;
+
+    float sum = 0.0f;
+    const float* a = mat1 + (b * M + i) * K;
+    const float* bmat = mat2 + b * K * N + j;
+    for (int k = 0; k < K; ++k) {
+        sum += a[k] * bmat[k * N];
+    }
+    output[(b * M + i) * N + j] = sum;
+}
+
+extern "C" void bmm_launcher(
+    float* output,
+    const float* mat1,
+    const float* mat2,
+    int batch,
+    int M,
+    int N,
+    int K,
+    cudaStream_t stream
+) {
+    dim3 block(16, 16);
+    dim3 grid((N + block.x - 1) / block.x, (M + block.y - 1) / block.y, batch);
+    bmm_naive_kernel<<<grid, block, 0, stream>>>(output, mat1, mat2, batch, M, N, K);
+}
+
+// -----------------------------------------------------------------------------
+// ConvTranspose2d forward kernel
+// Config: in_channels=128, out_channels=64, kernel=2, stride=1, padding=0, output_padding=0
+// Input: (batch, in_channels, 1, seq_len) ; seq_len should be 256 => output H=2, W=257
+// -----------------------------------------------------------------------------
+__global__ void conv_transpose2d_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    const float* __restrict__ weight,
+    const float* __restrict__ bias,
+    int batch,
+    int in_channels,
+    int out_channels,
+    int in_H,
+    int in_W,
+    int kernel_H,
+    int kernel_W,
+    int stride_H,
+    int stride_W,
+    int padding_H,
+    int padding_W,
+    int output_padding_H,
+    int output_padding_W,
+    int out_H,
+    int out_W
+) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = batch * out_channels * out_H * out_W;
+    int stride = blockDim.x * gridDim.x;
+
+    for (int linear = idx; linear < total; linear += stride) {
+        int w = linear % out_W;
+        int h = (linear / out_W) % out_H;
+        int oc = (linear / (out_W * out_H)) % out_channels;
+        int b = linear / (out_W * out_H * out_channels);
+
+        float sum = bias[oc];
+        for (int ic = 0; ic < in_channels; ++ic) {
+            for (int kh = 0; kh < kernel_H; ++kh) {
+                for (int kw = 0; kw < kernel_W; ++kw) {
+                    int in_h = h + padding_H - kh;
+                    int in_w = w + padding_W - kw;
+                    if (in_h >= 0 && in_h < in_H && in_w >= 0 && in_w < in_W) {
+                        // Check divisibility for this specific stride=1 only; general stride would need modulo
+                        if ((in_h % stride_H == 0) && (in_w % stride_W == 0)) {
+                            int actual_in_h = in_h / stride_H;
+                            int actual_in_w = in_w / stride_W;
+                            float input_val = input[((b * in_channels + ic) * in_H + actual_in_h) * in_W + actual_in_w];
+                            float w_val = weight[((ic * out_channels + oc) * kernel_H + kh) * kernel_W + kw];
+                            sum += input_val * w_val;
+                        }
+                    }
+                }
+            }
+        }
+        output[((b * out_channels + oc) * out_H + h) * out_W + w] = sum;
+    }
+}
+
+extern "C" void conv_transpose2d_launcher(
+    float* output,
+    const float* input,
+    const float* weight,
+    const float* bias,
+    int batch,
+    int in_channels,
+    int out_channels,
+    int kernel_H,
+    int kernel_W,
+    int stride_H,
+    int stride_W,
+    int padding_H,
+    int padding_W,
+    int output_padding_H,
+    int output_padding_W,
+    int seq_len,
+    cudaStream_t stream
+) {
+    int in_H = 1;
+    int in_W = seq_len;
+    int out_H = (in_H - 1) * stride_H - 2 * padding_H + kernel_H + output_padding_H;
+    int out_W = (in_W - 1) * stride_W - 2 * padding_W + kernel_W + output_padding_W;
+
+    int total = batch * out_channels * out_H * out_W;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535;
+
+    conv_transpose2d_kernel<<<blocks, threads, 0, stream>>>(
+        output, input, weight, bias,
+        batch, in_channels, out_channels, in_H, in_W,
+        kernel_H, kernel_W, stride_H, stride_W, padding_H, padding_W,
+        output_padding_H, output_padding_W, out_H, out_W);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,221 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void batchnorm_eval_launcher(
+    float* output,
+    const float* input,
+    const float* weight,
+    const float* bias,
+    const float* running_mean,
+    const float* running_var,
+    float eps,
+    int N,
+    int C,
+    int HW,
+    cudaStream_t stream
+);
+
+extern "C" void bmm_launcher(
+    float* output,
+    const float* mat1,
+    const float* mat2,
+    int batch,
+    int M,
+    int N,
+    int K,
+    cudaStream_t stream
+);
+
+extern "C" void conv_transpose2d_launcher(
+    float* output,
+    const float* input,
+    const float* weight,
+    const float* bias,
+    int batch,
+    int in_channels,
+    int out_channels,
+    int kernel_H,
+    int kernel_W,
+    int stride_H,
+    int stride_W,
+    int padding_H,
+    int padding_W,
+    int output_padding_H,
+    int output_padding_W,
+    int seq_len,
+    cudaStream_t stream
+);
+
+// Helper to get current CUDA stream
+static inline cudaStream_t getCurrentCUDAStream() {
+    return c10::cuda::getCurrentCUDAStream().stream();
+}
+
+// BatchNorm eval forward wrapper
+torch::Tensor batchnorm_eval_forward(
+    torch::Tensor input,
+    torch::Tensor weight,
+    torch::Tensor bias,
+    torch::Tensor running_mean,
+    torch::Tensor running_var,
+    double eps
+) {
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(input.is_contiguous(), "input must be contiguous");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(weight.is_cuda() && weight.is_contiguous() && weight.dtype() == torch::kFloat32,
+                "weight must be a contiguous float32 CUDA tensor");
+    TORCH_CHECK(bias.is_cuda() && bias.is_contiguous() && bias.dtype() == torch::kFloat32,
+                "bias must be a contiguous float32 CUDA tensor");
+    TORCH_CHECK(running_mean.is_cuda() && running_mean.is_contiguous() && running_mean.dtype() == torch::kFloat32,
+                "running_mean must be a contiguous float32 CUDA tensor");
+    TORCH_CHECK(running_var.is_cuda() && running_var.is_contiguous() && running_var.dtype() == torch::kFloat32,
+                "running_var must be a contiguous float32 CUDA tensor");
+
+    TORCH_CHECK(input.dim() == 4, "input must be 4D (N,C,H,W)");
+    int N = input.size(0);
+    int C = input.size(1);
+    int HW = input.size(2) * input.size(3);
+    TORCH_CHECK(weight.numel() == C, "weight size must match channels");
+    TORCH_CHECK(bias.numel() == C, "bias size must match channels");
+    TORCH_CHECK(running_mean.numel() == C, "running_mean size must match channels");
+    TORCH_CHECK(running_var.numel() == C, "running_var size must match channels");
+
+    auto output = torch::empty_like(input);
+
+    float eps_float = static_cast<float>(eps);
+
+    batchnorm_eval_launcher(
+        output.data_ptr<float>(),
+        input.data_ptr<float>(),
+        weight.data_ptr<float>(),
+        bias.data_ptr<float>(),
+        running_mean.data_ptr<float>(),
+        running_var.data_ptr<float>(),
+        eps_float,
+        input.numel(),
+        C,
+        HW,
+        getCurrentCUDAStream()
+    );
+
+    return output;
+}
+
+// BMM forward wrapper
+torch::Tensor bmm_forward(torch::Tensor mat1, torch::Tensor mat2) {
+    TORCH_CHECK(mat1.is_cuda() && mat1.is_contiguous() && mat1.dtype() == torch::kFloat32,
+                "mat1 must be a contiguous float32 CUDA tensor");
+    TORCH_CHECK(mat2.is_cuda() && mat2.is_contiguous() && mat2.dtype() == torch::kFloat32,
+                "mat2 must be a contiguous float32 CUDA tensor");
+    TORCH_CHECK(mat1.dim() == 3, "mat1 must be 3D (batch, M, K)");
+    TORCH_CHECK(mat2.dim() == 3, "mat2 must be 3D (batch, K, N)");
+    TORCH_CHECK(mat1.size(0) == mat2.size(0), "batch sizes must match");
+    TORCH_CHECK(mat1.size(2) == mat2.size(1), "inner dimensions must match");
+
+    int batch = mat1.size(0);
+    int M = mat1.size(1);
+    int N = mat2.size(2);
+    int K = mat1.size(2);
+
+    auto output = torch::empty({batch, M, N}, mat1.options());
+
+    bmm_launcher(
+        output.data_ptr<float>(),
+        mat1.data_ptr<float>(),
+        mat2.data_ptr<float>(),
+        batch,
+        M,
+        N,
+        K,
+        getCurrentCUDAStream()
+    );
+
+    return output;
+}
+
+// ConvTranspose2d forward wrapper
+torch::Tensor conv_transpose2d_forward(
+    torch::Tensor input,
+    torch::Tensor weight,
+    torch::Tensor bias,
+    int64_t batch,
+    int64_t in_channels,
+    int64_t out_channels,
+    int64_t kernel_h,
+    int64_t kernel_w,
+    int64_t stride_h,
+    int64_t stride_w,
+    int64_t padding_h,
+    int64_t padding_w,
+    int64_t output_padding_h,
+    int64_t output_padding_w,
+    int64_t seq_len
+) {
+    TORCH_CHECK(input.is_cuda() && input.is_contiguous() && input.dtype() == torch::kFloat32,
+                "input must be a contiguous float32 CUDA tensor");
+    TORCH_CHECK(weight.is_cuda() && weight.is_contiguous() && weight.dtype() == torch::kFloat32,
+                "weight must be a contiguous float32 CUDA tensor");
+    TORCH_CHECK(bias.is_cuda() && bias.is_contiguous() && bias.dtype() == torch::kFloat32,
+                "bias must be a contiguous float32 CUDA tensor");
+
+    TORCH_CHECK(input.dim() == 3, "input must be 3D (batch, in_channels, seq_len) for this custom conv");
+
+    // The launcher expects input as (batch, in_channels, 1, seq_len)
+    int in_H = 1;
+    int in_W = seq_len;
+    int out_H = (in_H - 1) * stride_h - 2 * padding_h + kernel_h + output_padding_h;
+    int out_W = (in_W - 1) * stride_w - 2 * padding_w + kernel_w + output_padding_w;
+
+    auto output = torch::empty({batch, out_channels, out_H, out_W}, input.options());
+
+    conv_transpose2d_launcher(
+        output.data_ptr<float>(),
+        input.data_ptr<float>(),
+        weight.data_ptr<float>(),
+        bias.data_ptr<float>(),
+        static_cast<int>(batch),
+        static_cast<int>(in_channels),
+        static_cast<int>(out_channels),
+        static_cast<int>(kernel_h),
+        static_cast<int>(kernel_w),
+        static_cast<int>(stride_h),
+        static_cast<int>(stride_w),
+        static_cast<int>(padding_h),
+        static_cast<int>(padding_w),
+        static_cast<int>(output_padding_h),
+        static_cast<int>(output_padding_w),
+        static_cast<int>(seq_len),
+        getCurrentCUDAStream()
+    );
+
+    return output;
+}
+
+// Registration
+void register_custom_ops(pybind11::module& m) {
+    m.def("batchnorm_eval_forward", &batchnorm_eval_forward,
+          "Custom BatchNorm eval forward",
+          py::arg("input"), py::arg("weight"), py::arg("bias"),
+          py::arg("running_mean"), py::arg("running_var"), py::arg("eps"));
+
+    m.def("bmm_forward", &bmm_forward,
+          "Custom batch matmul forward",
+          py::arg("mat1"), py::arg("mat2"));
+
+    m.def("conv_transpose2d_forward", &conv_transpose2d_forward,
+          "Custom ConvTranspose2d forward",
+          py::arg("input"), py::arg("weight"), py::arg("bias"),
+          py::arg("batch"), py::arg("in_channels"), py::arg("out_channels"),
+          py::arg("kernel_h"), py::arg("kernel_w"), py::arg("stride_h"), py::arg("stride_w"),
+          py::arg("padding_h"), py::arg("padding_w"),
+          py::arg("output_padding_h"), py::arg("output_padding_w"),
+          py::arg("seq_len"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,103 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(
+        self,
+        num_features,
+        batch_size,
+        convTranspose_in_channels,
+        convTranspose_out_channels,
+        convTranspose_kernel_size,
+        convTranspose_stride,
+        convTranspose_padding,
+        convTranspose_output_padding,
+    ):
+        super().__init__()
+        # Use nn.SyncBatchNorm to preserve state_dict keys and running stats behavior.
+        # We do not call its forward; instead we use our custom op with its parameters.
+        self.sync_batchnorm = nn.SyncBatchNorm(num_features)
+        self.convTranspose = nn.ConvTranspose2d(
+            convTranspose_in_channels,
+            convTranspose_out_channels,
+            convTranspose_kernel_size,
+            stride=convTranspose_stride,
+            padding=convTranspose_padding,
+            output_padding=convTranspose_output_padding,
+        )
+        self.batch_size = batch_size
+        # Store configuration for custom conv op
+        self.convTranspose_in_channels = convTranspose_in_channels
+        self.convTranspose_out_channels = convTranspose_out_channels
+        self.convTranspose_kernel_size = convTranspose_kernel_size
+        self.convTranspose_stride = convTranspose_stride
+        self.convTranspose_padding = convTranspose_padding
+        self.convTranspose_output_padding = convTranspose_output_padding
+
+    def forward(self, x, mat1, mat2):
+        # Step 1: SyncBatchNorm eval mode
+        x = cuda_extension.batchnorm_eval_forward(
+            x,
+            self.sync_batchnorm.weight,
+            self.sync_batchnorm.bias,
+            self.sync_batchnorm.running_mean,
+            self.sync_batchnorm.running_var,
+            self.sync_batchnorm.eps,
+        )
+
+        # Step 2: batch matmul
+        bmm_result = cuda_extension.bmm_forward(mat1, mat2)
+
+        # Step 3: view and convTranspose
+        # bmm_result shape: [batch_size, seq_len, convTranspose_in_channels]
+        # view to [batch_size, convTranspose_in_channels, 1, seq_len]
+        # Note: seq_len = bmm_result.shape[1]
+        x = cuda_extension.conv_transpose2d_forward(
+            bmm_result,
+            self.convTranspose.weight,
+            self.convTranspose.bias,
+            self.batch_size,
+            self.convTranspose_in_channels,
+            self.convTranspose_out_channels,
+            self.convTranspose_kernel_size,
+            self.convTranspose_stride,
+            self.convTranspose_padding,
+            self.convTranspose_output_padding,
+        )
+        return x
+
+    def debug_forward(self, x, mat1, mat2):
+        # Step 1
+        x = cuda_extension.batchnorm_eval_forward(
+            x,
+            self.sync_batchnorm.weight,
+            self.sync_batchnorm.bias,
+            self.sync_batchnorm.running_mean,
+            self.sync_batchnorm.running_var,
+            self.sync_batchnorm.eps,
+        )
+        yield 'step_001', x
+
+        # Step 2
+        bmm_result = cuda_extension.bmm_forward(mat1, mat2)
+        yield 'step_002', bmm_result
+
+        # Step 3
+        x = cuda_extension.conv_transpose2d_forward(
+            bmm_result,
+            self.convTranspose.weight,
+            self.convTranspose.bias,
+            self.batch_size,
+            self.convTranspose_in_channels,
+            self.convTranspose_out_channels,
+            self.convTranspose_kernel_size,
+            self.convTranspose_stride,
+            self.convTranspose_padding,
+            self.convTranspose_output_padding,
+        )
+        yield 'step_003', x
+
+        # Step 4: final return
+        yield 'step_004', x
