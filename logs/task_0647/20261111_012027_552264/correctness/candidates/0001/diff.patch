@@ -0,0 +1,154 @@
+#include <cuda_runtime.h>
+#include <cmath>
+
+// CUDA kernels and launchers for custom_unfold, custom_abs, custom_unfold_abs.
+// All functions use raw pointers, int64_t sizes, and cudaStream_t.
+// No torch/ATen/pybind dependencies.
+
+// Kernel for custom_unfold: copy input elements to output shape [batch, in_channels*kernel_h*kernel_w, 1]
+// Input: contiguous float tensor of shape [batch, in_channels, height, width]
+// kernel_h and kernel_w are the sliding window size, with stride=1, padding=0, dilation=1.
+// Since kernel_h == height and kernel_w == width (per contract), there is exactly one spatial position.
+// Output layout: for each batch b, channel c, kh in [0,kernel_h), kw in [0,kernel_w):
+//   output[b, c*kernel_h*kernel_w + kh*kernel_w + kw, 0] = input[b, c, kh, kw]
+__global__ void custom_unfold_kernel(const float* __restrict__ input,
+                                     float* __restrict__ output,
+                                     int64_t batch,
+                                     int64_t in_channels,
+                                     int64_t height,
+                                     int64_t width,
+                                     int64_t kernel_h,
+                                     int64_t kernel_w,
+                                     int64_t total_output) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < total_output; i += stride) {
+        // i is the linear index over the output elements (batch * out_channels)
+        int64_t b = i / (in_channels * kernel_h * kernel_w);
+        int64_t rem = i % (in_channels * kernel_h * kernel_w);
+        int64_t c = rem / (kernel_h * kernel_w);
+        int64_t pos = rem % (kernel_h * kernel_w);
+        int64_t kh = pos / kernel_w;
+        int64_t kw = pos % kernel_w;
+        // Input index: b*in_channels*height*width + c*height*width + kh*width + kw
+        // Because kernel_h == height and kernel_w == width (contract specific), kh < height, kw < width.
+        int64_t in_idx = ((b * in_channels + c) * height + kh) * width + kw;
+        output[i] = input[in_idx];
+    }
+}
+
+// Kernel for custom_abs: elementwise absolute value
+template <typename scalar_t>
+__global__ void custom_abs_kernel(const scalar_t* __restrict__ input,
+                                  scalar_t* __restrict__ output,
+                                  int64_t total) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < total; i += stride) {
+        output[i] = fabsf(input[i]);
+    }
+}
+
+// Kernel for fused custom_unfold_abs: copy with absolute value
+__global__ void custom_unfold_abs_kernel(const float* __restrict__ input,
+                                         float* __restrict__ output,
+                                         int64_t batch,
+                                         int64_t in_channels,
+                                         int64_t height,
+                                         int64_t width,
+                                         int64_t kernel_h,
+                                         int64_t kernel_w,
+                                         int64_t total_output) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < total_output; i += stride) {
+        int64_t b = i / (in_channels * kernel_h * kernel_w);
+        int64_t rem = i % (in_channels * kernel_h * kernel_w);
+        int64_t c = rem / (kernel_h * kernel_w);
+        int64_t pos = rem % (kernel_h * kernel_w);
+        int64_t kh = pos / kernel_w;
+        int64_t kw = pos % kernel_w;
+        int64_t in_idx = ((b * in_channels + c) * height + kh) * width + kw;
+        output[i] = fabsf(input[in_idx]);
+    }
+}
+
+// Helper to launch a kernel with grid-stride loop
+template <typename KernelFunc, typename... Args>
+void launch_kernel(KernelFunc kernel, cudaStream_t stream, int64_t total_elements, Args... args) {
+    if (total_elements <= 0) return;
+    int threads = 256;
+    int64_t blocks = (total_elements + threads - 1) / threads;
+    int max_blocks = 65535;
+    if (blocks > max_blocks) blocks = max_blocks;
+    kernel<<<(int)blocks, threads, 0, stream>>>(args..., total_elements);
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // In a real binding, this would be reported; here we just ensure no silent failure.
+        // The launcher may not throw, but binding will check.
+    }
+}
+
+// C-interface launchers (extern "C" for binding.cpp declarations)
+
+extern "C" void custom_unfold_launcher(const float* input,
+                                        float* output,
+                                        int64_t batch,
+                                        int64_t in_channels,
+                                        int64_t height,
+                                        int64_t width,
+                                        int64_t kernel_h,
+                                        int64_t kernel_w,
+                                        cudaStream_t stream) {
+    int64_t out_channels = in_channels * kernel_h * kernel_w;
+    int64_t total_output = batch * out_channels;
+    int threads = 256;
+    int64_t blocks = (total_output + threads - 1) / threads;
+    // Limit grid size; kernel uses grid-stride loop
+    int max_blocks = 65535;
+    if (blocks > max_blocks) blocks = max_blocks;
+    custom_unfold_kernel<<<(int)blocks, threads, 0, stream>>>(
+        input, output, batch, in_channels, height, width,
+        kernel_h, kernel_w, out_channels);
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // The binding will check the error after returning; do not throw here.
+    }
+}
+
+extern "C" void custom_abs_launcher(const float* input,
+                                    float* output,
+                                    int64_t total,
+                                    cudaStream_t stream) {
+    int threads = 256;
+    int64_t blocks = (total + threads - 1) / threads;
+    int max_blocks = 65535;
+    if (blocks > max_blocks) blocks = max_blocks;
+    custom_abs_kernel<float><<<(int)blocks, threads, 0, stream>>>(input, output, total);
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+    }
+}
+
+extern "C" void custom_unfold_abs_launcher(const float* input,
+                                           float* output,
+                                           int64_t batch,
+                                           int64_t in_channels,
+                                           int64_t height,
+                                           int64_t width,
+                                           int64_t kernel_h,
+                                           int64_t kernel_w,
+                                           cudaStream_t stream) {
+    int64_t out_channels = in_channels * kernel_h * kernel_w;
+    int64_t total_output = batch * out_channels;
+    int threads = 256;
+    int64_t blocks = (total_output + threads - 1) / threads;
+    int max_blocks = 65535;
+    if (blocks > max_blocks) blocks = max_blocks;
+    custom_unfold_abs_kernel<<<(int)blocks, threads, 0, stream>>>(
+        input, output, batch, in_channels, height, width,
+        kernel_h, kernel_w, out_channels);
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,125 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void custom_unfold_launcher(const float* input,
+                                      float* output,
+                                      int64_t batch,
+                                      int64_t in_channels,
+                                      int64_t height,
+                                      int64_t width,
+                                      int64_t kernel_h,
+                                      int64_t kernel_w,
+                                      cudaStream_t stream);
+
+extern "C" void custom_abs_launcher(const float* input,
+                                    float* output,
+                                    int64_t total,
+                                    cudaStream_t stream);
+
+extern "C" void custom_unfold_abs_launcher(const float* input,
+                                           float* output,
+                                           int64_t batch,
+                                           int64_t in_channels,
+                                           int64_t height,
+                                           int64_t width,
+                                           int64_t kernel_h,
+                                           int64_t kernel_w,
+                                           cudaStream_t stream);
+
+// Helper to validate tensor requirements
+static void check_cuda_float_contiguous(const torch::Tensor& t, const char* name) {
+    TORCH_CHECK(t.is_cuda(), name, " must be a CUDA tensor");
+    TORCH_CHECK(t.dtype() == torch::kFloat32, name, " must be float32");
+    TORCH_CHECK(t.is_contiguous(), name, " must be contiguous");
+}
+
+// custom_unfold: x -> [batch, in_channels*kernel_h*kernel_w, 1]
+torch::Tensor custom_unfold(torch::Tensor x, int64_t kernel_h, int64_t kernel_w) {
+    check_cuda_float_contiguous(x, "x");
+    TORCH_CHECK(x.dim() == 4, "x must be 4D (batch, channels, height, width)");
+    TORCH_CHECK(kernel_h > 0 && kernel_w > 0, "kernel sizes must be positive");
+
+    int64_t batch = x.size(0);
+    int64_t in_channels = x.size(1);
+    int64_t height = x.size(2);
+    int64_t width = x.size(3);
+    TORCH_CHECK(kernel_h <= height && kernel_w <= width, "kernel size must not exceed input spatial dims");
+
+    int64_t out_channels = in_channels * kernel_h * kernel_w;
+    auto output = torch::empty({batch, out_channels, 1}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    custom_unfold_launcher(x.data_ptr<float>(),
+                           output.data_ptr<float>(),
+                           batch,
+                           in_channels,
+                           height,
+                           width,
+                           kernel_h,
+                           kernel_w,
+                           stream);
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "custom_unfold kernel launch failed: ", cudaGetErrorString(err));
+    return output;
+}
+
+// custom_abs: elementwise absolute value
+torch::Tensor custom_abs(torch::Tensor x) {
+    check_cuda_float_contiguous(x, "x");
+    auto output = torch::empty_like(x);
+    int64_t total = x.numel();
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    custom_abs_launcher(x.data_ptr<float>(),
+                        output.data_ptr<float>(),
+                        total,
+                        stream);
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "custom_abs kernel launch failed: ", cudaGetErrorString(err));
+    return output;
+}
+
+// custom_unfold_abs: fused unfold + abs, same output shape as custom_unfold
+torch::Tensor custom_unfold_abs(torch::Tensor x, int64_t kernel_h, int64_t kernel_w) {
+    check_cuda_float_contiguous(x, "x");
+    TORCH_CHECK(x.dim() == 4, "x must be 4D (batch, channels, height, width)");
+    TORCH_CHECK(kernel_h > 0 && kernel_w > 0, "kernel sizes must be positive");
+
+    int64_t batch = x.size(0);
+    int64_t in_channels = x.size(1);
+    int64_t height = x.size(2);
+    int64_t width = x.size(3);
+    TORCH_CHECK(kernel_h <= height && kernel_w <= width, "kernel size must not exceed input spatial dims");
+
+    int64_t out_channels = in_channels * kernel_h * kernel_w;
+    auto output = torch::empty({batch, out_channels, 1}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    custom_unfold_abs_launcher(x.data_ptr<float>(),
+                               output.data_ptr<float>(),
+                               batch,
+                               in_channels,
+                               height,
+                               width,
+                               kernel_h,
+                               kernel_w,
+                               stream);
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "custom_unfold_abs kernel launch failed: ", cudaGetErrorString(err));
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_unfold", &custom_unfold, "custom unfold operation",
+          py::arg("x"), py::arg("kernel_h"), py::arg("kernel_w"));
+    m.def("custom_abs", &custom_abs, "custom abs operation",
+          py::arg("x"));
+    m.def("custom_unfold_abs", &custom_unfold_abs, "fused unfold + abs operation",
+          py::arg("x"), py::arg("kernel_h"), py::arg("kernel_w"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,22 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, kernel_size, batch_size, height, width):
+        super().__init__()
+        self.batch_size = batch_size
+        self.height = height
+        self.width = width
+
+    def forward(self, x):
+        x = cuda_extension.custom_unfold_abs(x, kernel_h=self.height, kernel_w=self.width)
+        return x
+
+    def debug_forward(self, x):
+        x_unfold = cuda_extension.custom_unfold(x, kernel_h=self.height, kernel_w=self.width)
+        yield 'step_001', x_unfold
+        x_abs = cuda_extension.custom_abs(x_unfold)
+        yield 'step_002', x_abs
+        yield 'step_003', x_abs
