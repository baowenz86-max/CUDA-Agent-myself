{
  "operators": [
    {
      "name": "custom_max_dim1",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[16, 3, 4096, 1024]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tuple",
        "summary": "tuple of (torch.Tensor, torch.Tensor)",
        "tensors": [
          {
            "name": "values",
            "dtype": "torch.float32",
            "device": "cuda",
            "shape": "[16, 1, 4096, 1024]"
          },
          {
            "name": "indices",
            "dtype": "torch.int64",
            "device": "cuda",
            "shape": "[16, 1, 4096, 1024]"
          }
        ]
      },
      "semantics": [
        "对应 torch.max(x, dim=1, keepdim=True)，在第二维（通道维）上求最大值",
        "输入形状 [N, C, H, W]，输出 values 和 indices 形状均为 [N, 1, H, W]",
        "indices 为最大值的通道索引，dtype 为 torch.int64",
        "返回一个包含两个 tensor 的 tuple，顺序为 (values, indices)"
      ]
    },
    {
      "name": "custom_roll_dim2",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[16, 1, 4096, 1024]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[16, 1, 4096, 1024]"
      },
      "semantics": [
        "对应 torch.roll(x, shifts=1, dims=2)，在宽度维（第三维，索引2）上循环右移1位",
        "输入形状 [N, C, H, W]，输出形状相同",
        "每个 (n,c,h) 位置，输出 [n,c,h,(w+1)%W] = 输入 [n,c,h,w]",
        "保持 float32 dtype 和 CUDA device"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x, _ = torch.max(x, dim=1, keepdim=True)",
      "semantics": [
        "在维度1上取最大值，keepdim=True 保持维度数为4",
        "返回 tuple，第一个元素为 max values (float32)，第二个元素为 indices (int64)",
        "输入 x 形状 [16,3,4096,1024]，输出 values/indices 形状均为 [16,1,4096,1024]"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.roll(x, shifts=1, dims=2)",
      "semantics": [
        "对 step_001 得到的 values 在 dim=2（宽度维）上循环右移1位",
        "输入形状 [16,1,4096,1024]，输出形状相同",
        "输出张量 dtype float32，device cuda"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回 step_002 的结果，不做任何修改",
        "形状 [16,1,4096,1024]，dtype float32，device cuda:0"
      ]
    }
  ]
}