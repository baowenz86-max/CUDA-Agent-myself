--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,220 @@
+#include <cuda_runtime.h>
+#include <cmath>
+
+// ----------------------------------------------------------------------------
+// BatchNorm2d evaluation mode kernel
+// y = (x - running_mean[c]) / sqrt(running_var[c] + eps) * weight[c] + bias[c]
+// Input x is 4D (N, C, H, W) with arbitrary strides.
+// weight, bias, running_mean, running_var are contiguous 1D of length C.
+// ----------------------------------------------------------------------------
+__global__ void batch_norm_eval_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    const float* __restrict__ weight,
+    const float* __restrict__ bias,
+    const float* __restrict__ running_mean,
+    const float* __restrict__ running_var,
+    float eps,
+    int N, int C, int H, int W,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w)
+{
+    long long total = (long long)N * C * H * W;
+    long long idx = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+
+    for (; idx < total; idx += stride) {
+        int w = idx % W;
+        long long tmp = idx / W;
+        int h = tmp % H;
+        tmp /= H;
+        int c = tmp % C;
+        int n = tmp / C;
+
+        float x = input[n * in_stride_n + c * in_stride_c + h * in_stride_h + w * in_stride_w];
+        float mean = running_mean[c];
+        float var = running_var[c];
+        float inv_std = rsqrtf(var + eps);
+        float normalized = (x - mean) * inv_std;
+        float y = normalized * weight[c] + bias[c];
+
+        output[n * out_stride_n + c * out_stride_c + h * out_stride_h + w * out_stride_w] = y;
+    }
+}
+
+// ----------------------------------------------------------------------------
+// GroupNorm forward: computes mean and variance per (n, group), then normalizes.
+// Input x is 4D (N, C, H, W) with arbitrary strides.
+// weight, bias are contiguous 1D of length C.
+// num_groups divides C; channels_per_group = C / num_groups.
+// ----------------------------------------------------------------------------
+
+// Kernel to compute partial sums for mean and variance per (n, group).
+// Each block handles one (n, group) pair; blockDim.x threads process the group's
+// channels * H * W elements using grid-stride within the block (loop).
+// We use a two-pass approach: first kernel computes sum and sum of squares,
+// second kernel normalizes using global mean and variance.
+__global__ void group_norm_stats_kernel(
+    const float* __restrict__ input,
+    const float* __restrict__ weight,
+    const float* __restrict__ bias,
+    float eps,
+    int N, int C, int H, int W, int num_groups,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    float* __restrict__ mean_out,
+    float* __restrict__ var_out)
+{
+    extern __shared__ float smem[];
+    float* s_sum = smem;
+    float* s_sqsum = smem + blockDim.x;
+
+    int group = blockIdx.x;
+    int n = blockIdx.y; // gridDim.y = N
+    int channels_per_group = C / num_groups;
+    int group_start_c = group * channels_per_group;
+    int group_end_c = group_start_c + channels_per_group;
+    int count = channels_per_group * H * W;
+
+    // Initialize shared memory
+    s_sum[threadIdx.x] = 0.0f;
+    s_sqsum[threadIdx.x] = 0.0f;
+    __syncthreads();
+
+    // Grid-stride loop over group elements
+    for (int i = threadIdx.x; i < count; i += blockDim.x) {
+        int c_offset = i / (H * W);
+        int spatial = i % (H * W);
+        int h = spatial / W;
+        int w = spatial % W;
+        int c = group_start_c + c_offset;
+        long long idx = (long long)n * in_stride_n + c * in_stride_c + h * in_stride_h + w * in_stride_w;
+        float val = input[idx];
+        s_sum[threadIdx.x] += val;
+        s_sqsum[threadIdx.x] += val * val;
+    }
+    __syncthreads();
+
+    // Reduce within block using warp shuffle and shared memory
+    for (int offset = blockDim.x / 2; offset > 0; offset >>= 1) {
+        if (threadIdx.x < offset) {
+            s_sum[threadIdx.x] += s_sum[threadIdx.x + offset];
+            s_sqsum[threadIdx.x] += s_sqsum[threadIdx.x + offset];
+        }
+        __syncthreads();
+    }
+
+    if (threadIdx.x == 0) {
+        float sum = s_sum[0];
+        float sqsum = s_sqsum[0];
+        float mean = sum / count;
+        float var = sqsum / count - mean * mean;
+        // Use max(var, 0) to avoid negative due to floating point
+        var = fmaxf(var, 0.0f);
+        int index = n * num_groups + group;
+        mean_out[index] = mean;
+        var_out[index] = var;
+    }
+}
+
+// Kernel to normalize and apply affine transformation
+__global__ void group_norm_apply_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    const float* __restrict__ weight,
+    const float* __restrict__ bias,
+    const float* __restrict__ mean,
+    const float* __restrict__ var,
+    float eps,
+    int N, int C, int H, int W, int num_groups,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w)
+{
+    long long total = (long long)N * C * H * W;
+    long long idx = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+
+    for (; idx < total; idx += stride) {
+        int w = idx % W;
+        long long tmp = idx / W;
+        int h = tmp % H;
+        tmp /= H;
+        int c = tmp % C;
+        int n = tmp / C;
+
+        int channels_per_group = C / num_groups;
+        int group = c / channels_per_group;
+        int index = n * num_groups + group;
+        float m = mean[index];
+        float v = var[index];
+        float inv_std = rsqrtf(v + eps);
+        float normalized = (input[n * in_stride_n + c * in_stride_c + h * in_stride_h + w * in_stride_w] - m) * inv_std;
+        float y = normalized * weight[c] + bias[c];
+        output[n * out_stride_n + c * out_stride_c + h * out_stride_h + w * out_stride_w] = y;
+    }
+}
+
+// ----------------------------------------------------------------------------
+// Host launchers (C interface, no PyTorch dependencies)
+// These are called from the binding .cpp with raw pointers, dimensions, strides,
+// and cudaStream_t.
+// ----------------------------------------------------------------------------
+
+extern "C" void batch_norm_eval_launcher(
+    float* output,
+    const float* input,
+    const float* weight,
+    const float* bias,
+    const float* running_mean,
+    const float* running_var,
+    float eps,
+    int N, int C, int H, int W,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,
+    cudaStream_t stream)
+{
+    long long total = (long long)N * C * H * W;
+    int block = 256;
+    int grid = (int)min((total + block - 1) / block, (long long)2147483647);
+    if (grid == 0) grid = 1;
+    batch_norm_eval_kernel<<<grid, block, 0, stream>>>(
+        output, input, weight, bias, running_mean, running_var, eps,
+        N, C, H, W,
+        in_stride_n, in_stride_c, in_stride_h, in_stride_w,
+        out_stride_n, out_stride_c, out_stride_h, out_stride_w);
+}
+
+extern "C" void group_norm_launcher(
+    float* output,
+    const float* input,
+    const float* weight,
+    const float* bias,
+    float eps,
+    int N, int C, int H, int W, int num_groups,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,
+    float* mean_buffer,
+    float* var_buffer,
+    cudaStream_t stream)
+{
+    // Stats kernel: grid.y = N, grid.x = num_groups
+    dim3 grid_stats(num_groups, N);
+    int block_stats = 256;
+    // Shared memory for two float arrays of size block_stats
+    size_t shared_mem = 2 * block_stats * sizeof(float);
+    group_norm_stats_kernel<<<grid_stats, block_stats, shared_mem, stream>>>(
+        input, weight, bias, eps,
+        N, C, H, W, num_groups,
+        in_stride_n, in_stride_c, in_stride_h, in_stride_w,
+        mean_buffer, var_buffer);
+
+    // Apply kernel: 1D grid over all elements
+    long long total = (long long)N * C * H * W;
+    int block_apply = 256;
+    int grid_apply = (int)min((total + block_apply - 1) / block_apply, (long long)2147483647);
+    if (grid_apply == 0) grid_apply = 1;
+    group_norm_apply_kernel<<<grid_apply, block_apply, 0, stream>>>(
+        output, input, weight, bias, mean_buffer, var_buffer, eps,
+        N, C, H, W, num_groups,
+        in_stride_n, in_stride_c, in_stride_h, in_stride_w,
+        out_stride_n, out_stride_c, out_stride_h, out_stride_w);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,185 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Launcher declarations from custom_ops.cu
+extern "C" void batch_norm_eval_launcher(
+    float* output,
+    const float* input,
+    const float* weight,
+    const float* bias,
+    const float* running_mean,
+    const float* running_var,
+    float eps,
+    int N, int C, int H, int W,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,
+    cudaStream_t stream);
+
+extern "C" void group_norm_launcher(
+    float* output,
+    const float* input,
+    const float* weight,
+    const float* bias,
+    float eps,
+    int N, int C, int H, int W, int num_groups,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,
+    float* mean_buffer,
+    float* var_buffer,
+    cudaStream_t stream);
+
+// BatchNorm2d evaluation mode forward
+torch::Tensor batch_norm_eval_forward(
+    torch::Tensor input,
+    torch::Tensor weight,
+    torch::Tensor bias,
+    torch::Tensor running_mean,
+    torch::Tensor running_var,
+    double eps) {
+    // Input validation
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(input.dim() == 4, "input must be 4D (N, C, H, W)");
+    TORCH_CHECK(input.scalar_type() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(weight.is_cuda() && weight.is_contiguous() && weight.scalar_type() == torch::kFloat32 && weight.dim() == 1,
+                "weight must be a contiguous CUDA float32 1D tensor");
+    TORCH_CHECK(bias.is_cuda() && bias.is_contiguous() && bias.scalar_type() == torch::kFloat32 && bias.dim() == 1,
+                "bias must be a contiguous CUDA float32 1D tensor");
+    TORCH_CHECK(running_mean.is_cuda() && running_mean.is_contiguous() && running_mean.scalar_type() == torch::kFloat32 && running_mean.dim() == 1,
+                "running_mean must be a contiguous CUDA float32 1D tensor");
+    TORCH_CHECK(running_var.is_cuda() && running_var.is_contiguous() && running_var.scalar_type() == torch::kFloat32 && running_var.dim() == 1,
+                "running_var must be a contiguous CUDA float32 1D tensor");
+
+    int64_t N = input.size(0);
+    int64_t C = input.size(1);
+    int64_t H = input.size(2);
+    int64_t W = input.size(3);
+    TORCH_CHECK(weight.size(0) == C, "weight length must match C");
+    TORCH_CHECK(bias.size(0) == C, "bias length must match C");
+    TORCH_CHECK(running_mean.size(0) == C, "running_mean length must match C");
+    TORCH_CHECK(running_var.size(0) == C, "running_var length must match C");
+
+    // Output tensor with same shape and strides as input
+    auto output = torch::empty_strided(input.sizes(), input.strides(), input.options());
+
+    long long in_stride_n = input.stride(0);
+    long long in_stride_c = input.stride(1);
+    long long in_stride_h = input.stride(2);
+    long long in_stride_w = input.stride(3);
+    long long out_stride_n = output.stride(0);
+    long long out_stride_c = output.stride(1);
+    long long out_stride_h = output.stride(2);
+    long long out_stride_w = output.stride(3);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    batch_norm_eval_launcher(
+        output.data_ptr<float>(),
+        input.data_ptr<float>(),
+        weight.data_ptr<float>(),
+        bias.data_ptr<float>(),
+        running_mean.data_ptr<float>(),
+        running_var.data_ptr<float>(),
+        static_cast<float>(eps),
+        static_cast<int>(N), static_cast<int>(C), static_cast<int>(H), static_cast<int>(W),
+        in_stride_n, in_stride_c, in_stride_h, in_stride_w,
+        out_stride_n, out_stride_c, out_stride_h, out_stride_w,
+        stream);
+
+    // Check for kernel launch errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "batch_norm_eval_launcher failed: ", cudaGetErrorString(err));
+    return output;
+}
+
+// GroupNorm forward
+torch::Tensor group_norm_forward(
+    torch::Tensor input,
+    torch::Tensor weight,
+    torch::Tensor bias,
+    double eps,
+    int64_t num_groups,
+    int64_t num_channels) {
+    // Input validation
+    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
+    TORCH_CHECK(input.dim() == 4, "input must be 4D (N, C, H, W)");
+    TORCH_CHECK(input.scalar_type() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(weight.is_cuda() && weight.is_contiguous() && weight.scalar_type() == torch::kFloat32 && weight.dim() == 1,
+                "weight must be a contiguous CUDA float32 1D tensor");
+    TORCH_CHECK(bias.is_cuda() && bias.is_contiguous() && bias.scalar_type() == torch::kFloat32 && bias.dim() == 1,
+                "bias must be a contiguous CUDA float32 1D tensor");
+
+    int64_t N = input.size(0);
+    int64_t C = input.size(1);
+    int64_t H = input.size(2);
+    int64_t W = input.size(3);
+
+    // Set num_channels and num_groups defaults
+    if (num_channels == -1) {
+        num_channels = C;
+    }
+    TORCH_CHECK(num_channels == C, "num_channels must match input C");
+    if (num_groups == -1) {
+        num_groups = C;
+    }
+    TORCH_CHECK(num_groups > 0 && C % num_groups == 0, "num_groups must divide C");
+    TORCH_CHECK(weight.size(0) == C, "weight length must match C");
+    TORCH_CHECK(bias.size(0) == C, "bias length must match C");
+
+    // Temporary buffers for per-(n, group) mean and variance
+    auto mean_buffer = torch::empty({N * num_groups}, input.options());
+    auto var_buffer = torch::empty({N * num_groups}, input.options());
+
+    // Output tensor with same shape and strides as input
+    auto output = torch::empty_strided(input.sizes(), input.strides(), input.options());
+
+    long long in_stride_n = input.stride(0);
+    long long in_stride_c = input.stride(1);
+    long long in_stride_h = input.stride(2);
+    long long in_stride_w = input.stride(3);
+    long long out_stride_n = output.stride(0);
+    long long out_stride_c = output.stride(1);
+    long long out_stride_h = output.stride(2);
+    long long out_stride_w = output.stride(3);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    group_norm_launcher(
+        output.data_ptr<float>(),
+        input.data_ptr<float>(),
+        weight.data_ptr<float>(),
+        bias.data_ptr<float>(),
+        static_cast<float>(eps),
+        static_cast<int>(N), static_cast<int>(C), static_cast<int>(H), static_cast<int>(W),
+        static_cast<int>(num_groups),
+        in_stride_n, in_stride_c, in_stride_h, in_stride_w,
+        out_stride_n, out_stride_c, out_stride_h, out_stride_w,
+        mean_buffer.data_ptr<float>(),
+        var_buffer.data_ptr<float>(),
+        stream);
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "group_norm_launcher failed: ", cudaGetErrorString(err));
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("batch_norm_eval_forward", &batch_norm_eval_forward,
+          "BatchNorm2d evaluation mode forward",
+          py::arg("input"),
+          py::arg("weight"),
+          py::arg("bias"),
+          py::arg("running_mean"),
+          py::arg("running_var"),
+          py::arg("eps") = 1e-05);
+    m.def("group_norm_forward", &group_norm_forward,
+          "GroupNorm forward",
+          py::arg("input"),
+          py::arg("weight"),
+          py::arg("bias"),
+          py::arg("eps") = 1e-05,
+          py::arg("num_groups") = -1,
+          py::arg("num_channels") = -1);
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,64 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, num_features, num_channels, num_groups):
+        super().__init__()
+        # Preserve state_dict keys exactly as original BatchNorm2d and GroupNorm
+        self.batch_norm = nn.Module()
+        self.batch_norm.weight = nn.Parameter(torch.ones(num_features))
+        self.batch_norm.bias = nn.Parameter(torch.zeros(num_features))
+        self.register_buffer('batch_norm.running_mean', torch.zeros(num_features))
+        self.register_buffer('batch_norm.running_var', torch.ones(num_features))
+        self.register_buffer('batch_norm.num_batches_tracked', torch.tensor(0, dtype=torch.long))
+        self.batch_norm.eps = 1e-5
+        self.batch_norm.momentum = 0.1
+
+        self.group_norm = nn.Module()
+        self.group_norm.weight = nn.Parameter(torch.ones(num_channels))
+        self.group_norm.bias = nn.Parameter(torch.zeros(num_channels))
+        self.group_norm.eps = 1e-5
+        self.group_norm.num_groups = num_groups
+        self.num_channels = num_channels
+
+    def forward(self, x):
+        x = cuda_extension.batch_norm_eval_forward(
+            x,
+            self.batch_norm.weight,
+            self.batch_norm.bias,
+            self.batch_norm.running_mean,
+            self.batch_norm.running_var,
+            self.batch_norm.eps
+        )
+        x = cuda_extension.group_norm_forward(
+            x,
+            self.group_norm.weight,
+            self.group_norm.bias,
+            self.group_norm.eps,
+            self.group_norm.num_groups,
+            self.num_channels
+        )
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.batch_norm_eval_forward(
+            x,
+            self.batch_norm.weight,
+            self.batch_norm.bias,
+            self.batch_norm.running_mean,
+            self.batch_norm.running_var,
+            self.batch_norm.eps
+        )
+        yield 'step_001', x
+        x = cuda_extension.group_norm_forward(
+            x,
+            self.group_norm.weight,
+            self.group_norm.bias,
+            self.group_norm.eps,
+            self.group_norm.num_groups,
+            self.num_channels
+        )
+        yield 'step_002', x
+        yield 'step_003', x
