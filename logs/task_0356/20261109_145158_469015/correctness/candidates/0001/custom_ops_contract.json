{
  "operators": [
    {
      "name": "batch_norm_eval_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "default": 1e-05,
          "optional": true,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input [N, C, H, W]"
      },
      "semantics": [
        "Computes BatchNorm2d in evaluation mode: y = (x - running_mean[c]) / sqrt(running_var[c] + eps) * weight[c] + bias[c]",
        "The normalization applies per channel c across all spatial positions (N, H, W)",
        "Input must be 4D (N, C, H, W), weight/bias/running_mean/running_var are 1D of length C",
        "Output preserves input shape and strides",
        "Uses running statistics, not batch statistics, consistent with training=False"
      ]
    },
    {
      "name": "group_norm_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "default": 1e-05,
          "optional": true,
          "nullable": false
        },
        {
          "name": "num_groups",
          "kind": "int",
          "default": -1,
          "optional": true,
          "nullable": false
        },
        {
          "name": "num_channels",
          "kind": "int",
          "default": -1,
          "optional": true,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input [N, C, H, W]"
      },
      "semantics": [
        "Computes GroupNorm: divides channels into num_groups groups, each with C/num_groups channels",
        "For each sample and group, computes mean and variance over the group's channels and spatial dimensions (C/num_groups * H * W)",
        "y = (x - mean_group) / sqrt(var_group + eps) * weight[c] + bias[c]",
        "Affine parameters weight and bias are per-channel, indexed by channel c",
        "Output preserves input shape and strides"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.batch_norm(x)",
      "semantics": [
        "BatchNorm2d evaluation mode normalization with running statistics and affine transformation"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.group_norm(x)",
      "semantics": [
        "GroupNorm normalization across groups with per-channel affine transformation"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "Final normalized output tensor"
      ]
    }
  ]
}