    {
      "name": "softmax_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[1, 512, 512, 224]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "对应参考语句 x = nn.Softmax()(x)。",
        "nn.Softmax() 默认 dim=None，等价于 dim=-1，沿最后一个维度计算 softmax。",
        "输入为 CUDA float32 张量，形状 [1,512,512,224]，dim=-1 大小为 224。",
        "返回新张量，保留输入 shape、stride 和 dtype。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = torch.relu(x)",
      "semantics": [
        "逐元素 ReLU：output = max(input, 0)。",
        "输入和输出均为 CUDA float32 张量，shape [1,512,512,224]。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = nn.Softmax()(x)",
      "semantics": [
        "Softmax 沿最后一个维度（dim=-1，大小 224）计算。",
        "输入为 ReLU 输出，shape [1,512,512,224]，输出为概率分布，shape 相同。",
        "数值公式：output_i = exp(x_i - max(x)) / sum(exp(x_j - max(x)))。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回 softmax 后的张量，shape [1,512,512,224]，dtype float32，device cuda。"
      ]
    }
  ]
