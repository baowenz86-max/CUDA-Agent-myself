--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,125 @@
+#include <cuda_runtime.h>
+#include <float.h>
+
+// ReLU forward kernel: elementwise max(x, 0)
+__global__ void relu_forward_kernel(const float* __restrict__ input,
+                                   float* __restrict__ output,
+                                   int64_t total_elements) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx < total_elements) {
+        output[idx] = fmaxf(input[idx], 0.0f);
+    }
+}
+
+// Softmax forward kernel: softmax over last dimension
+// Each block handles one row (batch*channels*height rows)
+// blockDim.x should be >= last_dim (256 threads covers 224)
+__global__ void softmax_forward_kernel(const float* __restrict__ input,
+                                       float* __restrict__ output,
+                                       int64_t outer_size,
+                                       int64_t inner_size) {
+    // Each block processes one row of length inner_size
+    extern __shared__ float smem[];  // shared memory for the row
+    
+    int64_t row = blockIdx.x;
+    if (row >= outer_size) return;
+    
+    const float* row_input = input + row * inner_size;
+    float* row_output = output + row * inner_size;
+    
+    int tid = threadIdx.x;
+    
+    // Load row into shared memory, compute max and sum of exp
+    float max_val = -FLT_MAX;
+    for (int i = tid; i < inner_size; i += blockDim.x) {
+        float val = row_input[i];
+        smem[i] = val;
+        max_val = fmaxf(max_val, val);
+    }
+    
+    // Block reduction for max
+    // Use shared memory reduction manually (simpler: each thread has partial max, reduce via shared array)
+    __shared__ float max_shared[32];
+    int lane = threadIdx.x & 31;
+    int warp = threadIdx.x >> 5;
+    float thread_max = max_val;
+    // warp reduce
+    for (int offset = 16; offset > 0; offset >>= 1) {
+        thread_max = fmaxf(thread_max, __shfl_down_sync(0xffffffff, thread_max, offset));
+    }
+    if (lane == 0) max_shared[warp] = thread_max;
+    __syncthreads();
+    
+    int num_warps = blockDim.x / 32;
+    if (warp == 0) {
+        thread_max = (lane < num_warps) ? max_shared[lane] : -FLT_MAX;
+        for (int offset = num_warps / 2; offset > 0; offset >>= 1) {
+            thread_max = fmaxf(thread_max, __shfl_down_sync(0xffffffff, thread_max, offset));
+        }
+        if (lane == 0) max_val = thread_max;
+    }
+    __syncthreads();
+    // Now max_val is the row max (broadcast to all threads if we store in shared)
+    max_val = max_shared[0];
+    
+    // Compute sum of exp(x - max)
+    float sum = 0.0f;
+    for (int i = tid; i < inner_size; i += blockDim.x) {
+        float val = __expf(smem[i] - max_val);
+        sum += val;
+    }
+    
+    // Reduce sum similarly
+    __shared__ float sum_shared[32];
+    float thread_sum = sum;
+    for (int offset = 16; offset > 0; offset >>= 1) {
+        thread_sum += __shfl_down_sync(0xffffffff, thread_sum, offset);
+    }
+    if (lane == 0) sum_shared[warp] = thread_sum;
+    __syncthreads();
+    
+    if (warp == 0) {
+        thread_sum = (lane < num_warps) ? sum_shared[lane] : 0.0f;
+        for (int offset = num_warps / 2; offset > 0; offset >>= 1) {
+            thread_sum += __shfl_down_sync(0xffffffff, thread_sum, offset);
+        }
+        if (lane == 0) sum = thread_sum;
+    }
+    __syncthreads();
+    sum = sum_shared[0];
+    
+    // Normalize and write output
+    for (int i = tid; i < inner_size; i += blockDim.x) {
+        row_output[i] = __expf(smem[i] - max_val) / sum;
+    }
+}
+
+// Launcher for ReLU: output must be preallocated with same shape and stride, assumed contiguous
+// total_elements = number of elements
+// stream: CUDA stream
+extern "C" void relu_forward_launcher(const float* input,
+                                      float* output,
+                                      int64_t total_elements,
+                                      cudaStream_t stream) {
+    if (total_elements <= 0) return;
+    int threads = 256;
+    int blocks = (int)((total_elements + threads - 1) / threads);
+    relu_forward_kernel<<<blocks, threads, 0, stream>>>(input, output, total_elements);
+}
+
+// Launcher for Softmax: input tensor shape [outer_size, inner_size] (contiguous)
+// outer_size = product of all dims except last, inner_size = last dim
+extern "C" void softmax_forward_launcher(const float* input,
+                                         float* output,
+                                         int64_t outer_size,
+                                         int64_t inner_size,
+                                         cudaStream_t stream) {
+    if (outer_size <= 0 || inner_size <= 0) return;
+    int threads = 256;
+    // Ensure threads >= inner_size (usually 224, so 256 is fine)
+    // If inner_size can be larger, we might need more threads per block or adjust; for this contract it's 224.
+    int shared_mem_size = inner_size * sizeof(float);
+    // Limit grid to outer_size blocks
+    softmax_forward_kernel<<<(int)outer_size, threads, shared_mem_size, stream>>>(
+        input, output, outer_size, inner_size);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,80 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Forward declarations from custom_ops.cu
+extern "C" void relu_forward_launcher(const float* input,
+                                      float* output,
+                                      int64_t total_elements,
+                                      cudaStream_t stream);
+
+extern "C" void softmax_forward_launcher(const float* input,
+                                         float* output,
+                                         int64_t outer_size,
+                                         int64_t inner_size,
+                                         cudaStream_t stream);
+
+// PyTorch wrapper for ReLU
+torch::Tensor relu_forward(torch::Tensor x) {
+    // Input validation
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+
+    // Output tensor, same shape as input
+    auto output = torch::empty_like(x);
+
+    int64_t total_elements = x.numel();
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    relu_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        total_elements,
+        stream
+    );
+
+    return output;
+}
+
+// PyTorch wrapper for Softmax along last dimension
+torch::Tensor softmax_forward(torch::Tensor x) {
+    // Input validation
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+
+    // Output tensor, same shape as input
+    auto output = torch::empty_like(x);
+
+    // Softmax is over last dimension
+    int64_t outer_size = 1;
+    for (int64_t i = 0; i < x.dim() - 1; ++i) {
+        outer_size *= x.size(i);
+    }
+    int64_t inner_size = x.size(-1);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    softmax_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        outer_size,
+        inner_size,
+        stream
+    );
+
+    return output;
+}
+
+// Register both functions
+void register_custom_ops(pybind11::module& m) {
+    m.def("relu_forward", &relu_forward, "ReLU forward",
+          py::arg("x"));
+    m.def("softmax_forward", &softmax_forward, "Softmax forward along last dim",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,20 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x):
+        x = cuda_extension.relu_forward(x)
+        x = cuda_extension.softmax_forward(x)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.relu_forward(x)
+        yield 'step_001', x
+        x = cuda_extension.softmax_forward(x)
+        yield 'step_002', x
+        yield 'step_003', x
