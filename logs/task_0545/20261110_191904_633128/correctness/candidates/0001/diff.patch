--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,105 @@
+#include <cuda_runtime.h>
+
+// Custom CUDA kernels and launchers for the model.
+// No torch/ATen dependencies.
+
+// Copy kernel: copies numel float elements from host to device.
+__global__ void copy_to_cuda_kernel(float* __restrict__ d_out,
+                                    const float* __restrict__ h_in,
+                                    size_t numel) {
+    size_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    size_t stride = blockDim.x * gridDim.x;
+    for (size_t i = idx; i < numel; i += stride) {
+        d_out[i] = h_in[i];
+    }
+}
+
+// Max over dim=1 kernel.
+// Input layout: [N, 2, H, W, 2] (float)
+// Output values: [N, 1, H, W, 2] (float)
+// Output indices: [N, 1, H, W, 2] (int64_t)
+// Each thread handles one (n, h, w, last_dim) position.
+__global__ void max_step_kernel(const float* __restrict__ input,
+                                float* __restrict__ values,
+                                int64_t* __restrict__ indices,
+                                int N, int H, int W) {
+    // Total number of output elements per last_dim? We'll use flattened index.
+    // Output shape [N,1,H,W,2] -> total = N*H*W*2.
+    size_t out_idx = blockIdx.x * blockDim.x + threadIdx.x;
+    size_t out_stride = blockDim.x * gridDim.x;
+    size_t total_out = (size_t)N * H * W * 2;
+    for (size_t idx = out_idx; idx < total_out; idx += out_stride) {
+        // Decode idx: idx = (((n*H + h)*W + w)*2 + last)
+        int last = idx % 2;
+        size_t tmp = idx / 2;
+        int w = tmp % W;
+        tmp /= W;
+        int h = tmp % H;
+        int n = tmp / H;
+        // Base offset for channel 0 and channel 1.
+        size_t base0 = (((size_t)n * 2 + 0) * H + h) * W * 2 + (size_t)w * 2 + last;
+        size_t base1 = (((size_t)n * 2 + 1) * H + h) * W * 2 + (size_t)w * 2 + last;
+        float v0 = input[base0];
+        float v1 = input[base1];
+        // PyTorch max semantics: if equal, return first index (0).
+        float max_val = v0;
+        int64_t max_idx = 0;
+        if (v1 > v0) {
+            max_val = v1;
+            max_idx = 1;
+        }
+        values[idx] = max_val;
+        indices[idx] = max_idx;
+    }
+}
+
+// View as complex kernel: copies float2 pairs to complex64.
+// Input: [N, H, W, 2] float contiguous.
+// Output: [N, H, W] complex64 (cuComplex = float2).
+__global__ void view_as_complex_kernel(const float* __restrict__ input,
+                                       cuComplex* __restrict__ output,
+                                       int N, int H, int W) {
+    size_t out_idx = blockIdx.x * blockDim.x + threadIdx.x;
+    size_t out_stride = blockDim.x * gridDim.x;
+    size_t total_out = (size_t)N * H * W;
+    for (size_t idx = out_idx; idx < total_out; idx += out_stride) {
+        // input index = idx * 2
+        float real = input[idx * 2];
+        float imag = input[idx * 2 + 1];
+        output[idx] = make_cuComplex(real, imag);
+    }
+}
+
+// Launchers
+extern "C" void copy_to_cuda_launcher(float* d_out,
+                                      const float* h_in,
+                                      size_t numel,
+                                      cudaStream_t stream) {
+    int threads = 256;
+    int blocks = (int)((numel + threads - 1) / threads);
+    if (blocks > 65535) blocks = 65535;
+    copy_to_cuda_kernel<<<blocks, threads, 0, stream>>>(d_out, h_in, numel);
+}
+
+extern "C" void max_step_launcher(float* d_values,
+                                  int64_t* d_indices,
+                                  const float* d_input,
+                                  int N, int H, int W,
+                                  cudaStream_t stream) {
+    size_t total_out = (size_t)N * H * W * 2;
+    int threads = 256;
+    int blocks = (int)((total_out + threads - 1) / threads);
+    if (blocks > 65535) blocks = 65535;
+    max_step_kernel<<<blocks, threads, 0, stream>>>(d_input, d_values, d_indices, N, H, W);
+}
+
+extern "C" void view_as_complex_launcher(cuComplex* d_out,
+                                         const float* d_in,
+                                         int N, int H, int W,
+                                         cudaStream_t stream) {
+    size_t total_out = (size_t)N * H * W;
+    int threads = 256;
+    int blocks = (int)((total_out + threads - 1) / threads);
+    if (blocks > 65535) blocks = 65535;
+    view_as_complex_kernel<<<blocks, threads, 0, stream>>>(d_in, d_out, N, H, W);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,129 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void copy_to_cuda_launcher(float* d_out,
+                                      const float* h_in,
+                                      size_t numel,
+                                      cudaStream_t stream);
+
+extern "C" void max_step_launcher(float* d_values,
+                                  int64_t* d_indices,
+                                  const float* d_input,
+                                  int N, int H, int W,
+                                  cudaStream_t stream);
+
+extern "C" void view_as_complex_launcher(cuComplex* d_out,
+                                         const float* d_in,
+                                         int N, int H, int W,
+                                         cudaStream_t stream);
+
+// Helper to get current CUDA stream
+cudaStream_t get_current_stream() {
+    return c10::cuda::getCurrentCUDAStream().stream();
+}
+
+// copy_to_cuda: CPU -> CUDA copy
+torch::Tensor copy_to_cuda(torch::Tensor x) {
+    TORCH_CHECK(x.is_cpu(), "copy_to_cuda expects a CPU tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "copy_to_cuda expects float32 tensor");
+    TORCH_CHECK(x.is_contiguous(), "copy_to_cuda expects contiguous tensor");
+
+    auto out = torch::empty_like(x, x.options().device(torch::kCUDA));
+    size_t numel = x.numel();
+    cudaStream_t stream = get_current_stream();
+
+    copy_to_cuda_launcher(
+        out.data_ptr<float>(),
+        x.data_ptr<float>(),
+        numel,
+        stream
+    );
+
+    return out;
+}
+
+// max_step: torch.max(x, dim=1, keepdim=True)
+torch::return_types::max max_step(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "max_step expects a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "max_step expects float32 tensor");
+    TORCH_CHECK(x.is_contiguous(), "max_step expects contiguous tensor");
+    TORCH_CHECK(x.dim() == 5, "max_step expects 5D tensor");
+    TORCH_CHECK(x.size(1) == 2, "max_step expects dim 1 size to be 2");
+    TORCH_CHECK(x.size(4) == 2, "max_step expects last dim size to be 2");
+
+    int64_t N = x.size(0);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+
+    auto values = torch::empty({N, 1, H, W, 2}, x.options());
+    auto indices = torch::empty({N, 1, H, W, 2}, x.options().dtype(torch::kInt64));
+
+    cudaStream_t stream = get_current_stream();
+    max_step_launcher(
+        values.data_ptr<float>(),
+        indices.data_ptr<int64_t>(),
+        x.data_ptr<float>(),
+        static_cast<int>(N),
+        static_cast<int>(H),
+        static_cast<int>(W),
+        stream
+    );
+
+    return torch::return_types::max(values, indices);
+}
+
+// squeeze_step: x.squeeze(1), returns a tensor shape [N,H,W,2]
+torch::Tensor squeeze_step(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "squeeze_step expects a CUDA tensor");
+    TORCH_CHECK(x.dim() == 5, "squeeze_step expects 5D tensor");
+    TORCH_CHECK(x.size(1) == 1, "squeeze_step expects dim 1 size to be 1");
+
+    // Return a view; if not contiguous later, view_as_complex_step will handle
+    return x.squeeze(1);
+}
+
+// view_as_complex_step: torch.view_as_complex(x)
+torch::Tensor view_as_complex_step(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "view_as_complex_step expects a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "view_as_complex_step expects float32 tensor");
+    TORCH_CHECK(x.dim() == 4, "view_as_complex_step expects 4D tensor");
+    TORCH_CHECK(x.size(3) == 2, "view_as_complex_step expects last dim size 2");
+
+    // Ensure contiguous for the kernel's linear indexing
+    auto x_contig = x.contiguous();
+
+    int64_t N = x_contig.size(0);
+    int64_t H = x_contig.size(1);
+    int64_t W = x_contig.size(2);
+
+    auto out = torch::empty({N, H, W}, x_contig.options().dtype(torch::kComplexFloat));
+
+    cudaStream_t stream = get_current_stream();
+    view_as_complex_launcher(
+        reinterpret_cast<cuComplex*>(out.data_ptr<c10::complex<float>>()),
+        x_contig.data_ptr<float>(),
+        static_cast<int>(N),
+        static_cast<int>(H),
+        static_cast<int>(W),
+        stream
+    );
+
+    return out;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("copy_to_cuda", &copy_to_cuda, "Copy CPU tensor to CUDA",
+          py::arg("x"));
+    m.def("max_step", &max_step, "Max along dim 1, keepdim=True",
+          py::arg("x"));
+    m.def("squeeze_step", &squeeze_step, "Squeeze dim 1",
+          py::arg("x"));
+    m.def("view_as_complex_step", &view_as_complex_step, "View as complex",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,24 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, height, width):
+        super().__init__()
+
+    def forward(self, x):
+        x = cuda_extension.copy_to_cuda(x)
+        max_result = cuda_extension.max_step(x)
+        squeezed = cuda_extension.squeeze_step(max_result.values)
+        output = cuda_extension.view_as_complex_step(squeezed)
+        return output
+
+    def debug_forward(self, x):
+        x = cuda_extension.copy_to_cuda(x)
+        max_result = cuda_extension.max_step(x)
+        yield "step_001", max_result
+        squeezed = cuda_extension.squeeze_step(max_result.values)
+        yield "step_002", squeezed
+        output = cuda_extension.view_as_complex_step(squeezed)
+        yield "step_003", output
