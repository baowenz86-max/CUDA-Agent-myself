        "将输入张量复制到执行设备 CUDA 上。",
        "保留原始 shape、dtype 和数值。",
        "如果输入已经在 CUDA 上，则返回原张量（或副本），不改变数据。"
      ]
    },
    {
      "name": "max_step",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[128, 2, 512, 512, 2]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
