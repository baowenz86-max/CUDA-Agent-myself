--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,30 @@
+#include <cuda_runtime.h>
+
+// Element-wise multiplication kernel: out[i] = x[i] * y[i]
+__global__ void mul_tensor_kernel(float* __restrict__ out,
+                                  const float* __restrict__ x,
+                                  const float* __restrict__ y,
+                                  int64_t n) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < n; i += stride) {
+        out[i] = x[i] * y[i];
+    }
+}
+
+// Launcher: simple grid-stride loop over all elements.
+// The binding layer ensures tensors are contiguous, same shape, float32, and on CUDA.
+extern "C" void mul_tensor_launcher(float* out,
+                                    const float* x,
+                                    const float* y,
+                                    int64_t n,
+                                    cudaStream_t stream) {
+    if (n == 0) return;
+    const int block_size = 256;
+    // Approximately enough blocks to fill the GPU; the grid-stride loop handles the rest.
+    int64_t num_blocks = (n + block_size - 1) / block_size;
+    // Cap blocks to a reasonable maximum to avoid launch failure (e.g., 2^31-1 blocks).
+    const int64_t max_blocks = 65535 * 32;  // arbitrary large number, but safe
+    if (num_blocks > max_blocks) num_blocks = max_blocks;
+    mul_tensor_kernel<<<(int)num_blocks, block_size, 0, stream>>>(out, x, y, n);
+}
--- before/kernels/mul_tensor_binding.cpp
+++ after/kernels/mul_tensor_binding.cpp
@@ -0,0 +1,44 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_runtime.h>
+#include "../binding_registry.h"
+
+// Declaration from custom_ops.cu
+extern "C" void mul_tensor_launcher(float* out,
+                                    const float* x,
+                                    const float* y,
+                                    int64_t n,
+                                    cudaStream_t stream);
+
+torch::Tensor mul_tensor(torch::Tensor x, torch::Tensor y) {
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(y.is_cuda(), "y must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(y.dtype() == torch::kFloat32, "y must be float32");
+    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
+    TORCH_CHECK(y.is_contiguous(), "y must be contiguous");
+    TORCH_CHECK(x.sizes() == y.sizes(), "x and y must have the same shape");
+
+    auto out = torch::empty_like(x);
+    int64_t n = x.numel();
+    if (n == 0) {
+        return out;
+    }
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    mul_tensor_launcher(out.data_ptr<float>(),
+                        x.data_ptr<float>(),
+                        y.data_ptr<float>(),
+                        n,
+                        stream);
+    TORCH_CHECK(cudaGetLastError() == cudaSuccess, "mul_tensor_launcher failed");
+    return out;
+}
+
+void register_mul_tensor(pybind11::module& m) {
+    m.def("mul_tensor", &mul_tensor, "Element-wise multiplication",
+          pybind11::arg("x"), pybind11::arg("y"));
+}
+
+REGISTER_BINDING(mul_tensor, register_mul_tensor);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,18 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, input_shape, scaling_factor):
+        super().__init__()
+        self.scaling_factor = scaling_factor
+
+    def forward(self, x, y):
+        x = cuda_extension.mul_tensor(x, y)
+        return x
+
+    def debug_forward(self, x, y):
+        result = cuda_extension.mul_tensor(x, y)
+        yield ('step_001', result)
+        yield ('step_002', result)
