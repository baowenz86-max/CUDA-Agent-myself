{
  "operators": [
    {
      "name": "one_hot_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.int64",
          "device": "cuda",
          "shape": "[N, H, W]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "num_classes",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.int64",
        "device": "cuda",
        "shape": "[N, H, W, num_classes]"
      },
      "semantics": [
        "Maps input int64 tensor x to one-hot representation along new last dimension.",
        "Output has shape [N, H, W, num_classes] and dtype int64.",
        "Values are 1 at index equal to x[...] and 0 otherwise."
      ]
    },
    {
      "name": "float_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.int64",
          "device": "cuda",
          "shape": "[N, H, W, num_classes]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, H, W, num_classes]"
      },
      "semantics": [
        "Casts int64 tensor to float32, preserving shape and values."
      ]
    },
    {
      "name": "pad_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, H, W, C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "padding_size",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "padding_value",
          "kind": "float",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, H+2*padding_size, W+2*padding_size, C+2*padding_size]"
      },
      "semantics": [
        "Pads the last three dimensions symmetrically by padding_size.",
        "Padding is applied to dimensions: -1, -2, -3 (C, W, H).",
        "Padding value is padding_value (0.0 here)."
      ]
    },
    {
      "name": "softmax_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, H, W, C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, H, W, C]"
      },
      "semantics": [
        "Applies softmax along specified dimension dim (usually depth=1).",
        "The softmax is computed over the dimension specified by dim.",
        "Output has same shape and dtype."
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = F.one_hot(x.long(), num_classes=self.num_classes)",
      "semantics": [
        "Input x is moved to CUDA (from CPU) and converted to long (int64).",
        "one_hot encoding along new last dimension.",
        "Output shape [512,128,128,5], dtype int64, on cuda:0."
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = x.float()",
      "semantics": [
        "Cast int64 to float32.",
        "Output shape [512,128,128,5], dtype float32."
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = F.pad(x, (self.padding_size, self.padding_size, self.padding_size, self.padding_size), value=self.padding_value)",
      "semantics": [
        "Pad last three dimensions (C, W, H) by 2 on both sides.",
        "Output shape [512,128,132,9], dtype float32.",
        "Padding value 0.0."
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "x = F.softmax(x, dim=self.depth)",
      "semantics": [
        "Apply softmax over dimension depth=1 (second dimension, H=128).",
        "Output shape [512,128,132,9], dtype float32."
      ]
    },
    {
      "checkpoint": "step_005",
      "source": "return x",
      "semantics": [
        "Return final tensor."
      ]
    }
  ]
}