--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,163 @@
+#include <cuda_runtime.h>
+#include <stdint.h>
+
+// -----------------------------------------------------------------------------
+// One-hot kernel: input int64 [N,H,W], output int64 [N,H,W,C]
+// -----------------------------------------------------------------------------
+__global__ void one_hot_kernel(const int64_t* __restrict__ input,
+                               int64_t* __restrict__ output,
+                               int N, int H, int W, int C) {
+    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
+    int64_t total = (int64_t)N * H * W;
+    if (idx >= total) return;
+    int64_t value = input[idx];
+    // output flattened index: (n*H*W + h*W + w) * C + c
+    int64_t out_base = idx * C;
+    for (int c = 0; c < C; ++c) {
+        output[out_base + c] = (value == c) ? (int64_t)1 : (int64_t)0;
+    }
+}
+
+// -----------------------------------------------------------------------------
+// Cast kernel: int64 -> float32
+// -----------------------------------------------------------------------------
+__global__ void cast_int64_to_float_kernel(const int64_t* __restrict__ input,
+                                          float* __restrict__ output,
+                                          int64_t numel) {
+    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
+    if (idx >= numel) return;
+    output[idx] = (float)input[idx];
+}
+
+// -----------------------------------------------------------------------------
+// Pad kernel: input float32 [N,H,W,C], output [N,H+2*pad, W+2*pad, C+2*pad]
+// Pad last three dimensions symmetrically with given value.
+// -----------------------------------------------------------------------------
+__global__ void pad_kernel(const float* __restrict__ input,
+                           float* __restrict__ output,
+                           int N, int H, int W, int C,
+                           int pad,
+                           float pad_value) {
+    int out_H = H + 2 * pad;
+    int out_W = W + 2 * pad;
+    int out_C = C + 2 * pad;
+
+    int64_t out_idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
+    int64_t out_numel = (int64_t)N * out_H * out_W * out_C;
+    if (out_idx >= out_numel) return;
+
+    // Decompose linear index into (n, oh, ow, oc)
+    int oc = (int)(out_idx % out_C);
+    int64_t tmp = out_idx / out_C;
+    int ow = (int)(tmp % out_W);
+    tmp = tmp / out_W;
+    int oh = (int)(tmp % out_H);
+    int n = (int)(tmp / out_H);
+
+    // Determine if this output position is in padding region
+    bool in_pad = (oc < pad) || (oc >= C + pad) ||
+                  (ow < pad) || (ow >= W + pad) ||
+                  (oh < pad) || (oh >= H + pad);
+
+    if (in_pad) {
+        output[out_idx] = pad_value;
+    } else {
+        int c = oc - pad;
+        int w = ow - pad;
+        int h = oh - pad;
+        int64_t in_idx = ((int64_t)n * H + h) * W + w;
+        in_idx = in_idx * C + c;
+        output[out_idx] = input[in_idx];
+    }
+}
+
+// -----------------------------------------------------------------------------
+// Softmax kernel along dimension 1 (H dimension)
+// Input/output: float32 [N, H, W, C]
+// Each (n, :, w, c) column is normalized.
+// -----------------------------------------------------------------------------
+__global__ void softmax_dim1_kernel(const float* __restrict__ input,
+                                    float* __restrict__ output,
+                                    int N, int H, int W, int C) {
+    // One block per (n, w, c), threads iterate over H dimension
+    int64_t col_idx = blockIdx.x;  // column index = (n*W + w)*C + c
+    int64_t total_cols = (int64_t)N * W * C;
+    if (col_idx >= total_cols) return;
+
+    int c = (int)(col_idx % C);
+    int64_t tmp = col_idx / C;
+    int w = (int)(tmp % W);
+    int n = (int)(tmp / W);
+
+    // Compute max over H for numerical stability
+    float max_val = -1e30f;
+    for (int h = 0; h < H; ++h) {
+        int64_t idx = ((int64_t)n * H + h) * W + w;
+        idx = idx * C + c;
+        float v = input[idx];
+        if (v > max_val) max_val = v;
+    }
+
+    // Compute sum of exp(x - max)
+    float sum_exp = 0.0f;
+    for (int h = 0; h < H; ++h) {
+        int64_t idx = ((int64_t)n * H + h) * W + w;
+        idx = idx * C + c;
+        sum_exp += __expf(input[idx] - max_val);
+    }
+    float inv_sum = 1.0f / sum_exp;
+
+    // Write normalized values
+    for (int h = 0; h < H; ++h) {
+        int64_t idx = ((int64_t)n * H + h) * W + w;
+        idx = idx * C + c;
+        output[idx] = __expf(input[idx] - max_val) * inv_sum;
+    }
+}
+
+// -----------------------------------------------------------------------------
+// Launcher functions (extern "C" for stable linkage)
+// -----------------------------------------------------------------------------
+extern "C" void one_hot_launcher(const int64_t* input,
+                                 int64_t* output,
+                                 int N, int H, int W, int C,
+                                 cudaStream_t stream) {
+    int64_t total = (int64_t)N * H * W;
+    int threads = 256;
+    int64_t blocks = (total + threads - 1) / threads;
+    one_hot_kernel<<<(int)blocks, threads, 0, stream>>>(input, output, N, H, W, C);
+}
+
+extern "C" void float_launcher(const int64_t* input,
+                               float* output,
+                               int64_t numel,
+                               cudaStream_t stream) {
+    int threads = 256;
+    int64_t blocks = (numel + threads - 1) / threads;
+    cast_int64_to_float_kernel<<<(int)blocks, threads, 0, stream>>>(input, output, numel);
+}
+
+extern "C" void pad_launcher(const float* input,
+                             float* output,
+                             int N, int H, int W, int C,
+                             int pad,
+                             float pad_value,
+                             cudaStream_t stream) {
+    int out_H = H + 2 * pad;
+    int out_W = W + 2 * pad;
+    int out_C = C + 2 * pad;
+    int64_t out_numel = (int64_t)N * out_H * out_W * out_C;
+    int threads = 256;
+    int64_t blocks = (out_numel + threads - 1) / threads;
+    pad_kernel<<<(int)blocks, threads, 0, stream>>>(input, output, N, H, W, C, pad, pad_value);
+}
+
+extern "C" void softmax_launcher(const float* input,
+                                 float* output,
+                                 int N, int H, int W, int C,
+                                 cudaStream_t stream) {
+    int64_t total_cols = (int64_t)N * W * C;
+    int threads = 256;
+    int64_t blocks = (total_cols + threads - 1) / threads;
+    softmax_dim1_kernel<<<(int)blocks, threads, 0, stream>>>(input, output, N, H, W, C);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,146 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void one_hot_launcher(const int64_t* input,
+                                 int64_t* output,
+                                 int N, int H, int W, int C,
+                                 cudaStream_t stream);
+
+extern "C" void float_launcher(const int64_t* input,
+                               float* output,
+                               int64_t numel,
+                               cudaStream_t stream);
+
+extern "C" void pad_launcher(const float* input,
+                             float* output,
+                             int N, int H, int W, int C,
+                             int pad,
+                             float pad_value,
+                             cudaStream_t stream);
+
+extern "C" void softmax_launcher(const float* input,
+                                 float* output,
+                                 int N, int H, int W, int C,
+                                 cudaStream_t stream);
+
+torch::Tensor one_hot_forward(torch::Tensor x, int64_t num_classes) {
+    TORCH_CHECK(x.dtype() == torch::kInt64, "one_hot_forward: input must be int64");
+    TORCH_CHECK(x.dim() == 3, "one_hot_forward: input must be 3D [N,H,W]");
+
+    // Move to CUDA if necessary
+    if (!x.is_cuda()) {
+        x = x.to(torch::kCUDA);
+    }
+    TORCH_CHECK(x.is_cuda(), "one_hot_forward: input must be on CUDA");
+    TORCH_CHECK(x.is_contiguous(), "one_hot_forward: input must be contiguous");
+
+    auto sizes = x.sizes();
+    int N = static_cast<int>(sizes[0]);
+    int H = static_cast<int>(sizes[1]);
+    int W = static_cast<int>(sizes[2]);
+
+    auto output = torch::empty({N, H, W, num_classes}, x.options().dtype(torch::kInt64));
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    one_hot_launcher(x.data_ptr<int64_t>(),
+                     output.data_ptr<int64_t>(),
+                     N, H, W, static_cast<int>(num_classes),
+                     stream);
+
+    return output;
+}
+
+torch::Tensor float_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "float_forward: input must be CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kInt64, "float_forward: input must be int64");
+    TORCH_CHECK(x.is_contiguous(), "float_forward: input must be contiguous");
+
+    int64_t numel = x.numel();
+    auto output = torch::empty(x.sizes(), x.options().dtype(torch::kFloat32));
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    float_launcher(x.data_ptr<int64_t>(),
+                   output.data_ptr<float>(),
+                   numel,
+                   stream);
+
+    return output;
+}
+
+torch::Tensor pad_forward(torch::Tensor x, int64_t padding_size, double padding_value) {
+    TORCH_CHECK(x.is_cuda(), "pad_forward: input must be CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "pad_forward: input must be float32");
+    TORCH_CHECK(x.dim() == 4, "pad_forward: input must be 4D [N,H,W,C]");
+    TORCH_CHECK(x.is_contiguous(), "pad_forward: input must be contiguous");
+
+    auto sizes = x.sizes();
+    int N = static_cast<int>(sizes[0]);
+    int H = static_cast<int>(sizes[1]);
+    int W = static_cast<int>(sizes[2]);
+    int C = static_cast<int>(sizes[3]);
+    int pad = static_cast<int>(padding_size);
+
+    int out_H = H + 2 * pad;
+    int out_W = W + 2 * pad;
+    int out_C = C + 2 * pad;
+
+    auto output = torch::empty({N, out_H, out_W, out_C}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    pad_launcher(x.data_ptr<float>(),
+                 output.data_ptr<float>(),
+                 N, H, W, C,
+                 pad,
+                 static_cast<float>(padding_value),
+                 stream);
+
+    return output;
+}
+
+torch::Tensor softmax_forward(torch::Tensor x, int64_t dim) {
+    TORCH_CHECK(x.is_cuda(), "softmax_forward: input must be CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "softmax_forward: input must be float32");
+    TORCH_CHECK(x.dim() == 4, "softmax_forward: input must be 4D [N,H,W,C]");
+    TORCH_CHECK(x.is_contiguous(), "softmax_forward: input must be contiguous");
+    TORCH_CHECK(dim >= 0 && dim < x.dim(), "softmax_forward: dim out of range");
+
+    // The launcher only supports softmax along dimension 1 (H)
+    TORCH_CHECK(dim == 1, "softmax_forward: only dim=1 is supported by this launcher");
+
+    auto sizes = x.sizes();
+    int N = static_cast<int>(sizes[0]);
+    int H = static_cast<int>(sizes[1]);
+    int W = static_cast<int>(sizes[2]);
+    int C = static_cast<int>(sizes[3]);
+
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    softmax_launcher(x.data_ptr<float>(),
+                     output.data_ptr<float>(),
+                     N, H, W, C,
+                     stream);
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("one_hot_forward", &one_hot_forward,
+          "One-hot encode int64 input into int64 output",
+          pybind11::arg("x"), pybind11::arg("num_classes"));
+    m.def("float_forward", &float_forward,
+          "Cast int64 tensor to float32",
+          pybind11::arg("x"));
+    m.def("pad_forward", &pad_forward,
+          "Pad last three dimensions symmetrically",
+          pybind11::arg("x"), pybind11::arg("padding_size"), pybind11::arg("padding_value"));
+    m.def("softmax_forward", &softmax_forward,
+          "Softmax along dimension dim",
+          pybind11::arg("x"), pybind11::arg("dim"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,34 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+class ModelNew(nn.Module):
+    def __init__(self, num_classes, depth, padding_size, padding_value):
+        super().__init__()
+        self.num_classes = num_classes
+        self.depth = depth
+        self.padding_size = padding_size
+        self.padding_value = padding_value
+
+    def forward(self, x):
+        # Convert to one-hot encoding
+        x = cuda_extension.one_hot_forward(x, self.num_classes)
+        # Cast to float
+        x = cuda_extension.float_forward(x)
+        # Pad the tensor
+        x = cuda_extension.pad_forward(x, self.padding_size, self.padding_value)
+        # Apply softmax
+        x = cuda_extension.softmax_forward(x, self.depth)
+        return x
+
+    def debug_forward(self, x):
+        # Same as forward but yield checkpoints
+        x = cuda_extension.one_hot_forward(x, self.num_classes)
+        yield 'step_001', x
+        x = cuda_extension.float_forward(x)
+        yield 'step_002', x
+        x = cuda_extension.pad_forward(x, self.padding_size, self.padding_value)
+        yield 'step_003', x
+        x = cuda_extension.softmax_forward(x, self.depth)
+        yield 'step_004', x
+        yield 'step_005', x
