--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,40 @@
+#include <cuda_runtime.h>
+#include <math.h>
+
+__global__ void softplus_kernel(float* data, int64_t numel) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        float x = data[i];
+        if (x <= 20.0f) {
+            data[i] = log1pf(expf(x));
+        } else {
+            data[i] = x;
+        }
+    }
+}
+
+__global__ void relu_kernel(float* data, int64_t numel) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        float x = data[i];
+        data[i] = fmaxf(0.0f, x);
+    }
+}
+
+extern "C" void softplus_forward_launcher(float* data, int64_t numel, cudaStream_t stream) {
+    int threads = 256;
+    int blocks = (int)((numel + threads - 1) / threads);
+    if (blocks > 65535) blocks = 65535;
+    if (blocks == 0) return;
+    softplus_kernel<<<blocks, threads, 0, stream>>>(data, numel);
+}
+
+extern "C" void relu_forward_launcher(float* data, int64_t numel, cudaStream_t stream) {
+    int threads = 256;
+    int blocks = (int)((numel + threads - 1) / threads);
+    if (blocks > 65535) blocks = 65535;
+    if (blocks == 0) return;
+    relu_kernel<<<blocks, threads, 0, stream>>>(data, numel);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,62 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void softplus_forward_launcher(float* data, int64_t numel, cudaStream_t stream);
+extern "C" void relu_forward_launcher(float* data, int64_t numel, cudaStream_t stream);
+
+// Helper to check CUDA errors after launch
+static void check_cuda_error() {
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA kernel launch failed: ", cudaGetErrorString(err));
+}
+
+// Wrapper for softplus_forward
+torch::Tensor softplus_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+
+    auto output = torch::empty_like(x);
+    int64_t numel = x.numel();
+    if (numel == 0) {
+        return output;
+    }
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    softplus_forward_launcher(output.data_ptr<float>(), numel, stream);
+    check_cuda_error();
+    return output;
+}
+
+// Wrapper for relu_forward
+torch::Tensor relu_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+
+    auto output = torch::empty_like(x);
+    int64_t numel = x.numel();
+    if (numel == 0) {
+        return output;
+    }
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    relu_forward_launcher(output.data_ptr<float>(), numel, stream);
+    check_cuda_error();
+    return output;
+}
+
+// Register both functions with pybind11
+void register_custom_ops(pybind11::module& m) {
+    m.def("softplus_forward", &softplus_forward, "Softplus forward (CUDA)",
+          py::arg("x"));
+    m.def("relu_forward", &relu_forward, "ReLU forward (CUDA)",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,34 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        x = cuda_extension.softplus_forward(x)
+        x = cuda_extension.relu_forward(x)
+        return x
+
+    def debug_forward(self, x: torch.Tensor):
+        x = cuda_extension.softplus_forward(x)
+        yield 'step_001', x
+        x = cuda_extension.relu_forward(x)
+        yield 'step_002', x
+        yield 'step_003', x
+
+
+batch_size = 64
+height = 2048
+width = 2048
+
+
+def get_inputs():
+    x = torch.randn(batch_size, height, width)
+    return [x]
+
+
+def get_init_inputs():
+    return []
