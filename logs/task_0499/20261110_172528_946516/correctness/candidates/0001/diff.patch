--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,145 @@
+#include <cuda_runtime.h>
+#include <cstdint>
+
+#define CUDA_CHECK(err) do { \
+    cudaError_t err_ = (err); \
+    if (err_ != cudaSuccess) { \
+        printf("CUDA error %s at %s:%d\n", cudaGetErrorString(err_), __FILE__, __LINE__); \
+    } \
+} while (0)
+
+// 通用逐元素 clamp kernel，支持任意 stride 的非连续张量
+// 假设输入所有维度的大小存储在 sizes 中，步长存储在 strides 中，共 ndim 维
+// 线程索引对应线性输出索引，通过除法和取模计算多维坐标，再计算输入线性偏移
+__global__ void clamp_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    const int64_t* __restrict__ sizes,
+    const int64_t* __restrict__ strides,
+    int ndim,
+    int64_t numel,
+    float min_val,
+    float max_val
+) {
+    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
+    if (idx >= numel) return;
+
+    int64_t remaining = idx;
+    int64_t input_offset = 0;
+    // 计算多维索引并累加输入偏移
+    #pragma unroll
+    for (int d = ndim - 1; d >= 0; --d) {
+        int64_t dim_size = sizes[d];
+        int64_t coord = remaining % dim_size;
+        remaining /= dim_size;
+        input_offset += coord * strides[d];
+    }
+
+    float val = input[input_offset];
+    val = fminf(fmaxf(val, min_val), max_val);
+    output[input_offset] = val;
+}
+
+// argmin kernel: 沿 dim 维度求第一个最小值的索引
+// output 形状为原形状去掉 dim 维，用 output_sizes 和 output_strides 描述
+// 每个线程处理一个输出元素，遍历 dim 维度
+// 注意：输入 strides 和 sizes 为原始维度信息
+// output 为 int64_t 类型，输出填充索引值
+__global__ void argmin_kernel(
+    const float* __restrict__ input,
+    int64_t* __restrict__ output,
+    const int64_t* __restrict__ input_sizes,
+    const int64_t* __restrict__ input_strides,
+    const int64_t* __restrict__ output_sizes,
+    const int64_t* __restrict__ output_strides,
+    int ndim,
+    int dim,
+    int64_t output_numel
+) {
+    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
+    if (idx >= output_numel) return;
+
+    // 计算输出元素的多维坐标（不含 dim 维度）
+    int64_t remaining = idx;
+    int64_t out_coords[8]; // 最多支持 8 维，足够
+    int64_t out_offset = 0;
+    for (int d = ndim - 1, od = ndim - 2; d >= 0; --d) {
+        if (d == dim) continue;
+        int64_t dim_size = output_sizes[od];
+        int64_t coord = remaining % dim_size;
+        remaining /= dim_size;
+        out_coords[od] = coord;
+        out_offset += coord * output_strides[od];
+        --od;
+    }
+
+    // 计算输入基地址偏移（沿 dim 维度之前的坐标部分）
+    int64_t base_input_offset = 0;
+    int64_t out_coord_idx = 0;
+    for (int d = 0; d < ndim; ++d) {
+        if (d == dim) continue;
+        base_input_offset += out_coords[out_coord_idx] * input_strides[d];
+        ++out_coord_idx;
+    }
+
+    // 沿 dim 维度遍历，记录第一个最小值索引
+    int64_t dim_size = input_sizes[dim];
+    int64_t dim_stride = input_strides[dim];
+
+    float min_val = input[base_input_offset];
+    int64_t min_idx = 0;
+    for (int64_t i = 1; i < dim_size; ++i) {
+        float val = input[base_input_offset + i * dim_stride];
+        if (val < min_val) {
+            min_val = val;
+            min_idx = i;
+        }
+    }
+
+    output[out_offset] = min_idx;
+}
+
+// 获取当前 CUDA stream（binding.cpp 调用时传入即可，这里不需要）
+// 以下 launcher 供 binding.cpp 声明并调用
+
+extern "C" void clamp_forward_launcher(
+    float* output,
+    const float* input,
+    const int64_t* sizes,
+    const int64_t* strides,
+    int ndim,
+    int64_t numel,
+    float min_val,
+    float max_val,
+    cudaStream_t stream
+) {
+    if (numel == 0) return;
+    int threads = 256;
+    int blocks = (int)((numel + threads - 1) / threads);
+    clamp_kernel<<<blocks, threads, 0, stream>>>(
+        output, input, sizes, strides, ndim, numel, min_val, max_val
+    );
+    CUDA_CHECK(cudaGetLastError());
+}
+
+extern "C" void argmin_forward_launcher(
+    const float* input,
+    int64_t* output,
+    const int64_t* input_sizes,
+    const int64_t* input_strides,
+    const int64_t* output_sizes,
+    const int64_t* output_strides,
+    int ndim,
+    int dim,
+    int64_t output_numel,
+    cudaStream_t stream
+) {
+    if (output_numel == 0) return;
+    int threads = 256;
+    int blocks = (int)((output_numel + threads - 1) / threads);
+    argmin_kernel<<<blocks, threads, 0, stream>>>(
+        input, output, input_sizes, input_strides,
+        output_sizes, output_strides, ndim, dim, output_numel
+    );
+    CUDA_CHECK(cudaGetLastError());
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,143 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include <vector>
+#include <cstdint>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void clamp_forward_launcher(
+    float* output,
+    const float* input,
+    const int64_t* sizes,
+    const int64_t* strides,
+    int ndim,
+    int64_t numel,
+    float min_val,
+    float max_val,
+    cudaStream_t stream
+);
+
+extern "C" void argmin_forward_launcher(
+    const float* input,
+    int64_t* output,
+    const int64_t* input_sizes,
+    const int64_t* input_strides,
+    const int64_t* output_sizes,
+    const int64_t* output_strides,
+    int ndim,
+    int dim,
+    int64_t output_numel,
+    cudaStream_t stream
+);
+
+// Helper to convert tensor sizes/strides to int64_t vectors
+static std::vector<int64_t> get_int64_vector(torch::IntArrayRef arr) {
+    return std::vector<int64_t>(arr.begin(), arr.end());
+}
+
+// clamp_forward implementation
+torch::Tensor clamp_forward(torch::Tensor x, double min, double max) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    // x can be non-contiguous; launcher handles strides
+    auto output = torch::empty_like(x);
+
+    // Get sizes and strides as int64_t pointers
+    auto sizes_vec = get_int64_vector(x.sizes());
+    auto strides_vec = get_int64_vector(x.strides());
+    int ndim = static_cast<int>(x.dim());
+    int64_t numel = x.numel();
+
+    if (numel == 0) {
+        return output;
+    }
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    clamp_forward_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        sizes_vec.data(),
+        strides_vec.data(),
+        ndim,
+        numel,
+        static_cast<float>(min),
+        static_cast<float>(max),
+        stream
+    );
+
+    return output;
+}
+
+// argmin_forward implementation
+torch::Tensor argmin_forward(torch::Tensor x, int64_t dim) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+
+    int ndim = static_cast<int>(x.dim());
+    TORCH_CHECK(ndim > 0, "argmin requires at least 1 dimension");
+
+    // Normalize negative dim
+    if (dim < 0) {
+        dim += ndim;
+    }
+    TORCH_CHECK(dim >= 0 && dim < ndim, "Dimension out of range (expected to be in range of [-", ndim, ", ", ndim - 1, "], but got ", dim, ")");
+
+    // Compute output shape (remove dim)
+    std::vector<int64_t> output_shape;
+    for (int i = 0; i < ndim; ++i) {
+        if (i != dim) {
+            output_shape.push_back(x.size(i));
+        }
+    }
+
+    auto output = torch::empty(output_shape, x.options().dtype(torch::kInt64));
+
+    int64_t output_numel = output.numel();
+    if (output_numel == 0) {
+        return output;
+    }
+
+    // Prepare input sizes/strides as int64_t arrays
+    auto input_sizes = get_int64_vector(x.sizes());
+    auto input_strides = get_int64_vector(x.strides());
+
+    // Output sizes/strides: output is contiguous, strides computed from shape
+    auto output_sizes = get_int64_vector(output.sizes());
+    std::vector<int64_t> output_strides(output_sizes.size());
+    if (!output_sizes.empty()) {
+        output_strides.back() = 1;
+        for (int i = static_cast<int>(output_sizes.size()) - 2; i >= 0; --i) {
+            output_strides[i] = output_strides[i + 1] * output_sizes[i + 1];
+        }
+    }
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    argmin_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<int64_t>(),
+        input_sizes.data(),
+        input_strides.data(),
+        output_sizes.data(),
+        output_strides.data(),
+        ndim,
+        static_cast<int>(dim),
+        output_numel,
+        stream
+    );
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("clamp_forward", &clamp_forward,
+          py::arg("x"), py::arg("min"), py::arg("max"));
+    m.def("argmin_forward", &argmin_forward,
+          py::arg("x"), py::arg("dim"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,23 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, clamp_min, clamp_max, argmin_dim):
+        super().__init__()
+        self.clamp_min = clamp_min
+        self.clamp_max = clamp_max
+        self.argmin_dim = argmin_dim
+
+    def forward(self, x):
+        x_clamped = cuda_extension.clamp_forward(x, self.clamp_min, self.clamp_max)
+        x_argmin = cuda_extension.argmin_forward(x_clamped, self.argmin_dim)
+        return x_argmin
+
+    def debug_forward(self, x):
+        x_clamped = cuda_extension.clamp_forward(x, self.clamp_min, self.clamp_max)
+        yield "step_001", x_clamped
+        x_argmin = cuda_extension.argmin_forward(x_clamped, self.argmin_dim)
+        yield "step_002", x_argmin
+        yield "step_003", x_argmin
