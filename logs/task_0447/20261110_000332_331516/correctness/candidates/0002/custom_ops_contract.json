      "semantics": [
        "对应参考语句 x = self.pad(x)。",
        "padding 参数固定为 (1,2,1,2,1,2)，表示 (left, right, top, bottom, front, back)。",
        "对输入 5D 张量 (N,C,D,H,W) 进行常数填充，填充值为 0。",
        "输出形状为 [512, 3, 64+1+2, 64+1+2, 64+1+2] = [512, 3, 67, 67, 67]。",
        "不改变 dtype 和设备。",
        "输入支持任意 stride；输出 stride 应与参考一致。"
      ]
    },
    {
      "name": "bias_add",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference padded output",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[3, 1, 1, 1]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对应参考语句 x = x + self.bias。",
        "执行逐元素加法，bias 广播到输入形状 [512,3,67,67,67]。",
        "加法遵循 PyTorch 广播语义：bias 形状 [3,1,1,1] 与输入的最后四维对齐广播。",
        "不改变 dtype、设备、shape、stride。",
        "返回值是新的张量，不修改输入。"
      ]
    }
  ],
  "reference_steps": [
