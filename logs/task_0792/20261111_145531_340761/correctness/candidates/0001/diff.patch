--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,45 @@
+#include <cuda_runtime.h>
+
+__global__ void relu_forward_kernel(const float* __restrict__ input,
+                                   float* __restrict__ output,
+                                   int64_t numel) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        output[i] = input[i] > 0.0f ? input[i] : 0.0f;
+    }
+}
+
+__global__ void abs_forward_kernel(const float* __restrict__ input,
+                                   float* __restrict__ output,
+                                   int64_t numel) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        output[i] = fabsf(input[i]);
+    }
+}
+
+extern "C" void relu_forward_launcher(float* output,
+                                      const float* input,
+                                      int64_t numel,
+                                      cudaStream_t stream) {
+    const int64_t block_size = 256;
+    int64_t grid_size = (numel + block_size - 1) / block_size;
+    if (grid_size > 65535) {
+        grid_size = 65535;
+    }
+    relu_forward_kernel<<<grid_size, block_size, 0, stream>>>(input, output, numel);
+}
+
+extern "C" void abs_forward_launcher(float* output,
+                                     const float* input,
+                                     int64_t numel,
+                                     cudaStream_t stream) {
+    const int64_t block_size = 256;
+    int64_t grid_size = (numel + block_size - 1) / block_size;
+    if (grid_size > 65535) {
+        grid_size = 65535;
+    }
+    abs_forward_kernel<<<grid_size, block_size, 0, stream>>>(input, output, numel);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,61 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void relu_forward_launcher(float* output, const float* input, int64_t numel, cudaStream_t stream);
+extern "C" void abs_forward_launcher(float* output, const float* input, int64_t numel, cudaStream_t stream);
+
+// PyTorch wrapper for ReLU forward
+torch::Tensor relu_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+
+    auto output = torch::empty_like(x);
+    int64_t numel = x.numel();
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    relu_forward_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        numel,
+        stream
+    );
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "relu_forward_launcher failed: ", cudaGetErrorString(err));
+    return output;
+}
+
+// PyTorch wrapper for absolute value forward
+torch::Tensor abs_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+
+    auto output = torch::empty_like(x);
+    int64_t numel = x.numel();
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    abs_forward_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        numel,
+        stream
+    );
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "abs_forward_launcher failed: ", cudaGetErrorString(err));
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("relu_forward", &relu_forward, "ReLU forward",
+          py::arg("x"));
+    m.def("abs_forward", &abs_forward, "Absolute value forward",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,35 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.relu = nn.ReLU()
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        x = cuda_extension.relu_forward(x)
+        x = cuda_extension.abs_forward(x)
+        return x
+
+    def debug_forward(self, x: torch.Tensor):
+        x = cuda_extension.relu_forward(x)
+        yield 'step_001', x
+        x = cuda_extension.abs_forward(x)
+        yield 'step_002', x
+        yield 'step_003', x
+
+
+batch_size = 256
+width = 1024
+height = 1024
+
+
+def get_inputs():
+    x = torch.randn(batch_size, height, width)
+    return [x]
+
+
+def get_init_inputs():
+    return []
