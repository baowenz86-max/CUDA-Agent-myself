--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,51 @@
+#include <cuda_runtime.h>
+#include <math.h>
+
+// Kernel for mean_dim1_keepdim: given input shape [N, 1, H, W], dim=1 length is 1,
+// so the mean over dim 1 equals the input element itself. This kernel simply copies
+// the input to the output (elementwise).
+__global__ void mean_dim1_keepdim_kernel(const float* __restrict__ input,
+                                         float* __restrict__ output,
+                                         int64_t numel) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        output[i] = input[i];
+    }
+}
+
+// Kernel for floor: elementwise floorf
+template <typename scalar_t>
+__global__ void floor_kernel(const scalar_t* __restrict__ input,
+                             scalar_t* __restrict__ output,
+                             int64_t numel) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        output[i] = floorf((float)input[i]);
+    }
+}
+
+// Launcher for mean_dim1_keepdim
+extern "C" void mean_dim1_keepdim_launcher(const float* input,
+                                            float* output,
+                                            int64_t numel,
+                                            cudaStream_t stream) {
+    // Choose block size and grid size (grid-stride loop handles arbitrary numel)
+    const int block_size = 256;
+    int grid_size = (int)((numel + block_size - 1) / block_size);
+    // Cap grid size to avoid excessive blocks (grid-stride loop will handle the rest)
+    if (grid_size > 65535) grid_size = 65535;
+    mean_dim1_keepdim_kernel<<<grid_size, block_size, 0, stream>>>(input, output, numel);
+}
+
+// Launcher for floor
+extern "C" void floor_launcher(const float* input,
+                                float* output,
+                                int64_t numel,
+                                cudaStream_t stream) {
+    const int block_size = 256;
+    int grid_size = (int)((numel + block_size - 1) / block_size);
+    if (grid_size > 65535) grid_size = 65535;
+    floor_kernel<float><<<grid_size, block_size, 0, stream>>>(input, output, numel);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,62 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Launcher declarations from custom_ops.cu
+extern "C" void mean_dim1_keepdim_launcher(const float* input,
+                                            float* output,
+                                            int64_t numel,
+                                            cudaStream_t stream);
+
+extern "C" void floor_launcher(const float* input,
+                                float* output,
+                                int64_t numel,
+                                cudaStream_t stream);
+
+// PyTorch wrapper for mean_dim1_keepdim
+torch::Tensor mean_dim1_keepdim(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "mean_dim1_keepdim: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "mean_dim1_keepdim: input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "mean_dim1_keepdim: input must be contiguous");
+
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    mean_dim1_keepdim_launcher(x.data_ptr<float>(),
+                                output.data_ptr<float>(),
+                                x.numel(),
+                                stream);
+
+    return output;
+}
+
+// PyTorch wrapper for floor
+torch::Tensor floor(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "floor: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "floor: input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "floor: input must be contiguous");
+
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    floor_launcher(x.data_ptr<float>(),
+                   output.data_ptr<float>(),
+                   x.numel(),
+                   stream);
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("mean_dim1_keepdim", &mean_dim1_keepdim,
+          "Mean over dim 1 with keepdim=True (dim size is 1)",
+          py::arg("x"));
+    m.def("floor", &floor,
+          "Elementwise floor",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,21 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x):
+        x = cuda_extension.mean_dim1_keepdim(x)
+        x = cuda_extension.floor(x)
+        return x
+
+    def debug_forward(self, *inputs):
+        x = inputs[0]
+        x = cuda_extension.mean_dim1_keepdim(x)
+        yield 'step_001', x
+        x = cuda_extension.floor(x)
+        yield 'step_002', x
+        yield 'step_003', x
