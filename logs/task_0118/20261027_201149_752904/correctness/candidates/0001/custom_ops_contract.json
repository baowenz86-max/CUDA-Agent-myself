{
  "operators": [
    {
      "name": "batchnorm2d_eval_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[16, 3, 512, 512]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[3]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[3]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[3]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[3]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "default": 1e-05,
          "nullable": false,
          "optional": true
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[16, 3, 512, 512]"
      },
      "semantics": [
        "对应参考语句: x = self.batchnorm2d(x)（eval 模式）",
        "计算 y = (x - running_mean[c]) / sqrt(running_var[c] + eps) * weight[c] + bias[c]，其中 c 为通道索引",
        "输入 x 形状为 [N, C, H, W]，输出形状相同",
        "支持非连续输入，可通过步长访问",
        "eps, weight, bias, running_mean, running_var 均为标量或长度为 C 的一维张量"
      ]
    },
    {
      "name": "sum_dim_keepdim_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[16, 3, 512, 512]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "default": null,
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[16, 1, 512, 512]"
      },
      "semantics": [
        "对应参考语句: x = torch.sum(x, dim=1, keepdim=True)",
        "沿 dim=1 求和并保持维度（keepdim=True），输出形状为 [N, 1, H, W]",
        "dim 参数为整数，当前任务中固定为 1",
        "输入 x 支持任意步长，输出为连续张量"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.batchnorm2d(x)",
      "semantics": [
        "BatchNorm2d 在 eval 模式下使用 running_mean 和 running_var 进行归一化，应用 weight 和 bias"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.sum(x, dim=1, keepdim=True)",
      "semantics": [
        "沿通道维度（dim=1）求和并保持维度"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回求和后的张量"
      ]
    }
  ]
}