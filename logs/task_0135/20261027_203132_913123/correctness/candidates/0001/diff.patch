--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,108 @@
+// kernels/custom_ops.cu
+// CUDA implementations for trunc and 2x2 stride-2 max pool.
+// No PyTorch or C++ binding dependencies; only raw pointers, scalars, and cudaStream_t.
+
+#include <cuda_runtime.h>
+
+// -----------------------------------------------------------------------------
+// trunc kernel: y[i] = truncf(x[i])
+// Supports arbitrary strides via flattened linear index over numel.
+// -----------------------------------------------------------------------------
+__global__ void trunc_kernel(float* __restrict__ y,
+                             const float* __restrict__ x,
+                             int64_t numel) {
+    int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    const int64_t stride = static_cast<int64_t>(blockDim.x) * gridDim.x;
+    for (; idx < numel; idx += stride) {
+        y[idx] = truncf(x[idx]);
+    }
+}
+
+// -----------------------------------------------------------------------------
+// max_pool2d kernel for kernel_size=2, stride=2, padding=0, dilation=1.
+// Input: [N, C, H, W], output: [N, C, Ho, Wo] where Ho = H/2, Wo = W/2 (H,W even).
+// Assumes contiguous NCHW layout. The binding layer will make the input contiguous
+// before calling this launcher if necessary.
+// -----------------------------------------------------------------------------
+__global__ void max_pool2d_2x2_stride2_kernel(const float* __restrict__ input,
+                                              float* __restrict__ output,
+                                              int64_t N,
+                                              int64_t C,
+                                              int64_t H,
+                                              int64_t W,
+                                              int64_t Ho,
+                                              int64_t Wo) {
+    // Each thread computes one output element.
+    int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    const int64_t total = N * C * Ho * Wo;
+    const int64_t stride = static_cast<int64_t>(blockDim.x) * gridDim.x;
+
+    for (; idx < total; idx += stride) {
+        // decompose idx into n, c, ho, wo
+        int64_t tmp = idx;
+        int64_t wo = tmp % Wo;
+        tmp /= Wo;
+        int64_t ho = tmp % Ho;
+        tmp /= Ho;
+        int64_t c = tmp % C;
+        int64_t n = tmp / C;
+
+        // input coordinates for 2x2 window with stride 2
+        int64_t h_base = ho * 2;
+        int64_t w_base = wo * 2;
+
+        // load four values
+        float v0 = input[((n * C + c) * H + h_base) * W + w_base];
+        float v1 = input[((n * C + c) * H + h_base) * W + w_base + 1];
+        float v2 = input[((n * C + c) * H + (h_base + 1)) * W + w_base];
+        float v3 = input[((n * C + c) * H + (h_base + 1)) * W + w_base + 1];
+
+        // maximum
+        float m = v0;
+        m = (v1 > m) ? v1 : m;
+        m = (v2 > m) ? v2 : m;
+        m = (v3 > m) ? v3 : m;
+
+        output[idx] = m;
+    }
+}
+
+// -----------------------------------------------------------------------------
+// Host launchers (C linkage)
+// -----------------------------------------------------------------------------
+extern "C" void trunc_launcher(float* output,
+                               const float* input,
+                               int64_t numel,
+                               cudaStream_t stream) {
+    const int block_size = 256;
+    // Cap grid to avoid excessive blocks, use grid-stride loop.
+    int64_t blocks_64 = (numel + block_size - 1) / block_size;
+    const int64_t max_blocks = 65535;
+    if (blocks_64 > max_blocks) blocks_64 = max_blocks;
+    if (blocks_64 < 1) blocks_64 = 1;
+    int blocks = static_cast<int>(blocks_64);
+    trunc_kernel<<<blocks, block_size, 0, stream>>>(output, input, numel);
+}
+
+extern "C" void max_pool2d_launcher(const float* input,
+                                    float* output,
+                                    int64_t N,
+                                    int64_t C,
+                                    int64_t H,
+                                    int64_t W,
+                                    cudaStream_t stream) {
+    int64_t Ho = H / 2;
+    int64_t Wo = W / 2;
+    if (Ho <= 0 || Wo <= 0) return;
+
+    int64_t total = N * C * Ho * Wo;
+    const int block_size = 256;
+    int64_t blocks_64 = (total + block_size - 1) / block_size;
+    const int64_t max_blocks = 65535;
+    if (blocks_64 > max_blocks) blocks_64 = max_blocks;
+    if (blocks_64 < 1) blocks_64 = 1;
+    int blocks = static_cast<int>(blocks_64);
+
+    max_pool2d_2x2_stride2_kernel<<<blocks, block_size, 0, stream>>>(
+        input, output, N, C, H, W, Ho, Wo);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,80 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Launchers from custom_ops.cu
+extern "C" void trunc_launcher(float* output,
+                                const float* input,
+                                int64_t numel,
+                                cudaStream_t stream);
+
+extern "C" void max_pool2d_launcher(const float* input,
+                                     float* output,
+                                     int64_t N,
+                                     int64_t C,
+                                     int64_t H,
+                                     int64_t W,
+                                     cudaStream_t stream);
+
+// trunc_forward (torch.trunc)
+torch::Tensor trunc_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input tensor must be CUDA");
+    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "Input tensor must be float32");
+    TORCH_CHECK(x.numel() > 0, "Input tensor must have at least one element");
+    // Ensure contiguous for kernel indexing
+    auto x_contig = x.contiguous();
+    auto output = torch::empty_like(x_contig);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    trunc_launcher(
+        output.data_ptr<float>(),
+        x_contig.data_ptr<float>(),
+        x_contig.numel(),
+        stream
+    );
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "trunc_launcher failed with error: ", cudaGetErrorString(err));
+    return output;
+}
+
+// max_pool2d_forward (F.max_pool2d with kernel_size=2, stride=2)
+torch::Tensor max_pool2d_forward(torch::Tensor x, int64_t kernel_size, int64_t stride) {
+    TORCH_CHECK(x.is_cuda(), "Input tensor must be CUDA");
+    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "Input tensor must be float32");
+    TORCH_CHECK(kernel_size == 2, "Only kernel_size=2 is supported");
+    TORCH_CHECK(stride == 2, "Only stride=2 is supported");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D (N,C,H,W)");
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+    TORCH_CHECK(H % 2 == 0 && W % 2 == 0, "H and W must be even for kernel=2 stride=2 without padding");
+    // Ensure contiguous for kernel indexing
+    auto x_contig = x.contiguous();
+    int64_t N = x_contig.size(0);
+    int64_t C = x_contig.size(1);
+    int64_t Ho = H / 2;
+    int64_t Wo = W / 2;
+    auto output = torch::empty({N, C, Ho, Wo}, x_contig.options());
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    max_pool2d_launcher(
+        x_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N,
+        C,
+        H,
+        W,
+        stream
+    );
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "max_pool2d_launcher failed with error: ", cudaGetErrorString(err));
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("trunc_forward", &trunc_forward, "trunc_forward (CUDA)",
+          pybind11::arg("x"));
+    m.def("max_pool2d_forward", &max_pool2d_forward, "max_pool2d_forward (CUDA)",
+          pybind11::arg("x"), pybind11::arg("kernel_size"), pybind11::arg("stride"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,23 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, out_channels, kernel_size, stride, padding):
+        super().__init__()
+        # 保留 conv 模块以维持 state_dict 键与参考一致
+        self.conv = nn.Conv2d(in_channels, out_channels, kernel_size, stride=stride, padding=padding, bias=False)
+
+    def forward(self, x):
+        x = cuda_extension.trunc_forward(x)
+        x = cuda_extension.max_pool2d_forward(x, kernel_size=2, stride=2)
+        return x
+
+    def debug_forward(self, *inputs):
+        x = inputs[0]
+        x = cuda_extension.trunc_forward(x)
+        yield 'step_001', x
+        x = cuda_extension.max_pool2d_forward(x, kernel_size=2, stride=2)
+        yield 'step_002', x
+        yield 'step_003', x