+// kernels/custom_ops.cu
+// Elementwise kernels for clamp and add_scalar, float32 CUDA only.
+
+#include <cuda_runtime.h>
+
+namespace {
+
+// Helper to map linear index to 4D logical indices using strides.
+__device__ __forceinline__ void unravel_index(
+    int64_t linear,
+    int64_t dim0, int64_t dim1, int64_t dim2, int64_t dim3,
+    int64_t stride0, int64_t stride1, int64_t stride2, int64_t stride3,
+    int64_t &i0, int64_t &i1, int64_t &i2, int64_t &i3)
+{
+    i0 = linear / (dim1 * dim2 * dim3);
+    int64_t rem = linear - i0 * dim1 * dim2 * dim3;
+    i1 = rem / (dim2 * dim3);
+    rem -= i1 * dim2 * dim3;
+    i2 = rem / dim3;
+    i3 = rem - i2 * dim3;
+    // Stride mapping is handled by caller using these indices
+}
+
+// Clamp kernel: output = min(max(input, min_val), max_val), respecting strides.
+__global__ void clamp_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    float min_val,
+    float max_val,
+    int64_t dim0, int64_t dim1, int64_t dim2, int64_t dim3,
+    int64_t stride0, int64_t stride1, int64_t stride2, int64_t stride3,
+    int64_t numel)
+{
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t step = blockDim.x * gridDim.x;
+    for (; idx < numel; idx += step) {
+        // Compute logical indices
+        int64_t i0 = idx / (dim1 * dim2 * dim3);
+        int64_t rem = idx - i0 * dim1 * dim2 * dim3;
+        int64_t i1 = rem / (dim2 * dim3);
+        rem -= i1 * dim2 * dim3;
+        int64_t i2 = rem / dim3;
+        int64_t i3 = rem - i2 * dim3;
+
+        int64_t offset = i0 * stride0 + i1 * stride1 + i2 * stride2 + i3 * stride3;
+        float v = input[offset];
+        v = fminf(fmaxf(v, min_val), max_val);
+        output[offset] = v;
+    }
+}
+
+// Add scalar kernel: output = input + scalar, respecting strides.
+__global__ void add_scalar_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ input,
+    float scalar,
+    int64_t dim0, int64_t dim1, int64_t dim2, int64_t dim3,
+    int64_t stride0, int64_t stride1, int64_t stride2, int64_t stride3,
+    int64_t numel)
+{
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t step = blockDim.x * gridDim.x;
+    for (; idx < numel; idx += step) {
+        int64_t i0 = idx / (dim1 * dim2 * dim3);
+        int64_t rem = idx - i0 * dim1 * dim2 * dim3;
+        int64_t i1 = rem / (dim2 * dim3);
+        rem -= i1 * dim2 * dim3;
+        int64_t i2 = rem / dim3;
+        int64_t i3 = rem - i2 * dim3;
+
+        int64_t offset = i0 * stride0 + i1 * stride1 + i2 * stride2 + i3 * stride3;
+        output[offset] = input[offset] + scalar;
+    }
+}
+
+} // namespace
+
+// C-interface launchers for binding layer. No PyTorch dependencies.
+
+extern "C" void clamp_forward_launcher(
+    float* output,
+    const float* input,
+    float min_val,
+    float max_val,
+    int64_t dim0, int64_t dim1, int64_t dim2, int64_t dim3,
+    int64_t stride0, int64_t stride1, int64_t stride2, int64_t stride3,
+    int64_t numel,
+    cudaStream_t stream)
+{
+    const int block = 256;
+    int64_t blocks = (numel + block - 1) / block;
+    if (blocks > 0x7FFFFFFF) blocks = 0x7FFFFFFF; // grid cap
+    clamp_kernel<<<(unsigned int)blocks, block, 0, stream>>>(
+        output, input, min_val, max_val,
+        dim0, dim1, dim2, dim3,
+        stride0, stride1, stride2, stride3,
+        numel);
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // The binding layer will check and raise if needed.
+    }
+}
+
+extern "C" void add_scalar_forward_launcher(
+    float* output,
+    const float* input,
+    float scalar,
+    int64_t dim0, int64_t dim1, int64_t dim2, int64_t dim3,
+    int64_t stride0, int64_t stride1, int64_t stride2, int64_t stride3,
+    int64_t numel,
+    cudaStream_t stream)
+{
+    const int block = 256;
+    int64_t blocks = (numel + block - 1) / block;
+    if (blocks > 0x7FFFFFFF) blocks = 0x7FFFFFFF;
+    add_scalar_kernel<<<(unsigned int)blocks, block, 0, stream>>>(
+        output, input, scalar,
+        dim0, dim1, dim2, dim3,
+        stride0, stride1, stride2, stride3,
+        numel);
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // The binding layer will check and raise if needed.
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,108 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void clamp_forward_launcher(
+    float* output,
+    const float* input,
+    float min_val,
+    float max_val,
+    int64_t dim0, int64_t dim1, int64_t dim2, int64_t dim3,
+    int64_t stride0, int64_t stride1, int64_t stride2, int64_t stride3,
+    int64_t numel,
+    cudaStream_t stream);
+
+extern "C" void add_scalar_forward_launcher(
+    float* output,
+    const float* input,
+    float scalar,
+    int64_t dim0, int64_t dim1, int64_t dim2, int64_t dim3,
+    int64_t stride0, int64_t stride1, int64_t stride2, int64_t stride3,
+    int64_t numel,
+    cudaStream_t stream);
+
+// Helper function to extract strides and dimensions from a 4D tensor
+static void get_tensor_geometry(const torch::Tensor& t, int64_t& dim0, int64_t& dim1, int64_t& dim2, int64_t& dim3,
+                                int64_t& stride0, int64_t& stride1, int64_t& stride2, int64_t& stride3) {
+    TORCH_CHECK(t.dim() == 4, "Expected 4D tensor, got ", t.dim(), "D");
+    dim0 = t.size(0);
+    dim1 = t.size(1);
+    dim2 = t.size(2);
+    dim3 = t.size(3);
+    stride0 = t.stride(0);
+    stride1 = t.stride(1);
+    stride2 = t.stride(2);
+    stride3 = t.stride(3);
+}
+
+// Wrapper for clamp: output = clamp(x, min, max)
+torch::Tensor clamp_forward(const torch::Tensor& x, double min_val, double max_val) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D tensor");
+
+    auto output = torch::empty_like(x);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    int64_t dim0, dim1, dim2, dim3;
+    int64_t stride0, stride1, stride2, stride3;
+    get_tensor_geometry(x, dim0, dim1, dim2, dim3, stride0, stride1, stride2, stride3);
+    int64_t numel = x.numel();
+
+    clamp_forward_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        static_cast<float>(min_val),
+        static_cast<float>(max_val),
+        dim0, dim1, dim2, dim3,
+        stride0, stride1, stride2, stride3,
+        numel,
+        stream);
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "clamp_forward_launcher failed: ", cudaGetErrorString(err));
+    return output;
+}
+
+// Wrapper for add_scalar: output = x + scalar
+torch::Tensor add_scalar_forward(const torch::Tensor& x, double scalar) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D tensor");
+
+    auto output = torch::empty_like(x);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    int64_t dim0, dim1, dim2, dim3;
+    int64_t stride0, stride1, stride2, stride3;
+    get_tensor_geometry(x, dim0, dim1, dim2, dim3, stride0, stride1, stride2, stride3);
+    int64_t numel = x.numel();
+
+    add_scalar_forward_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        static_cast<float>(scalar),
+        dim0, dim1, dim2, dim3,
+        stride0, stride1, stride2, stride3,
+        numel,
+        stream);
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "add_scalar_forward_launcher failed: ", cudaGetErrorString(err));
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("clamp_forward", &clamp_forward,
+          "Clamp tensor values elementwise",
+          py::arg("x"), py::arg("min"), py::arg("max"));
+    m.def("add_scalar_forward", &add_scalar_forward,
+          "Add scalar to tensor elementwise",
+          py::arg("x"), py::arg("scalar"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
