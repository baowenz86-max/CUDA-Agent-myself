{
  "operators": [
    {
      "name": "conv2d_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N,C,H,W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels,in_channels,kH,kW]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "stride_h",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "stride_w",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "padding_h",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "padding_w",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dilation_h",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dilation_w",
          "kind": "int",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as reference conv output"
      },
      "semantics": [
        "对应 self.conv(x)，使用 cuDNN 实现 2D 卷积。",
        "具体参数：stride=(1,1), padding=(0,0), dilation=(1,1), groups=1。",
        "conv 模块有 bias，必须传入 bias。",
        "输出 shape 由输入 shape、权重 shape 和上述参数决定。"
      ]
    },
    {
      "name": "leaky_relu_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as conv output",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "negative_slope",
          "kind": "float",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对应 F.leaky_relu(x, negative_slope=0.01)。",
        "输出 = input > 0 ? input : input * negative_slope。",
        "保持 shape、dtype、device 不变。"
      ]
    },
    {
      "name": "add_bias_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N,C,H,W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C,1,1]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对应 x = x + self.bias。",
        "bias 形状为 (out_channels,1,1)，沿 channel 维度广播。",
        "输出 = input + bias。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.conv(x)",
      "semantics": [
        "执行 Conv2d 前向，使用 conv.weight 和 conv.bias，默认 stride=1, padding=0, dilation=1。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = F.leaky_relu(x, negative_slope=0.01)",
      "semantics": [
        "对 conv 输出逐元素执行 LeakyReLU，负斜率为 0.01。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = x + self.bias",
      "semantics": [
        "将额外 bias (shape [16,1,1]) 广播加到 leaky_relu 输出上。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return x",
      "semantics": [
        "返回最终结果，shape 为 [512,16,126,126]，float32 CUDA。"
      ]
    }
  ]
}