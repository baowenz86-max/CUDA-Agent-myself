      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "Matches reference x = x + self.bias where self.bias has shape [C, 1, 1] after conv output.",
