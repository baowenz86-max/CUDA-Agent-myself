      "semantics": [
        "Matches reference self.conv(x) where self.conv is nn.Conv2d(in_channels, out_channels, kernel_size, stride=1, padding=0, dilation=1, groups=1, bias=True).",
        "Computes 2D convolution using cuDNN with input, weight, bias, stride, padding, dilation, groups.",
