{
  "operators": [
    {
      "name": "custom_stack",
      "parameters": [
        {
          "name": "x1",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[8192, 128]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "x2",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[8192, 128]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[2, 8192, 128]"
      },
      "semantics": [
        "等价于 torch.stack([x1, x2], dim=0)",
        "输入 x1 和 x2 均为 CUDA float32，形状 [8192, 128]，连续存储",
        "输出形状 [2, 8192, 128]，第 0 维索引 0 对应 x1，索引 1 对应 x2",
        "不改变元素值，仅复制到新张量",
        "输出张量连续"
      ]
    },
    {
      "name": "custom_bmm_transpose",
      "parameters": [
        {
          "name": "stacked",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[2, 8192, 128]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[2, 8192, 8192]"
      },
      "semantics": [
        "等价于 torch.bmm(stacked, stacked.transpose(1, 2))",
        "输入 stacked 是 CUDA float32，形状 [2, 8192, 128]，连续存储",
        "内部先对 stacked 做转置得到形状 [2, 128, 8192] 的视图，再对每个 batch 执行矩阵乘法 [8192,128] x [128,8192]",
        "输出形状 [2, 8192, 8192]，每个 batch 输出为 8192x8192，元素值为对应行与列的点积",
        "输出张量连续",
        "不改变输入张量"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "stacked = torch.stack([x1, x2])",
      "semantics": [
        "沿新维度 0 堆叠 x1 和 x2，输出形状 [2, 8192, 128]",
        "元素复制顺序：先 x1 的所有行，再 x2 的所有行"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "result = torch.bmm(stacked, stacked.transpose(1, 2))",
      "semantics": [
        "对每个 batch 独立执行矩阵乘法 batch_i [8192,128] x (batch_i 转置 [128,8192])",
        "输出形状 [2, 8192, 8192]"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return result",
      "semantics": [
        "返回形状 [2, 8192, 8192] 的 CUDA float32 张量"
      ]
    }
  ]
}