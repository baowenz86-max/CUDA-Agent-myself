--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,84 @@
+#include <cuda_runtime.h>
+
+// -----------------------------------------------------------------------------
+// custom_stack: 等价于 torch.stack([x1, x2], dim=0)
+// 输入: x1, x2 均为 float32, 形状 [8192, 128], 连续
+// 输出: out 形状 [2, 8192, 128], 连续
+// -----------------------------------------------------------------------------
+__global__ void custom_stack_kernel(float* __restrict__ out,
+                                    const float* __restrict__ x1,
+                                    const float* __restrict__ x2,
+                                    int rows, int cols) {
+    // total elements = 2 * rows * cols
+    long long total = 2LL * rows * cols;
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+
+    for (long long i = idx; i < total; i += stride) {
+        int batch = i / (rows * cols);           // 0 or 1
+        int rem = i - batch * rows * cols;
+        int row = rem / cols;
+        int col = rem - row * cols;
+        const float* src = (batch == 0) ? x1 : x2;
+        out[i] = src[row * cols + col];
+    }
+}
+
+extern "C" void custom_stack_launcher(float* out,
+                                      const float* x1,
+                                      const float* x2,
+                                      int rows,
+                                      int cols,
+                                      cudaStream_t stream) {
+    long long total = 2LL * rows * cols;
+    int block = 256;
+    long long grid_ll = (total + block - 1) / block;
+    int grid = (int)grid_ll;
+    custom_stack_kernel<<<grid, block, 0, stream>>>(out, x1, x2, rows, cols);
+    cudaGetLastError();  // launcher 不抛出，错误由 binding 检查
+}
+
+// -----------------------------------------------------------------------------
+// custom_bmm_transpose: 等价于 torch.bmm(stacked, stacked.transpose(1, 2))
+// 输入: stacked 形状 [2, 8192, 128], 连续
+// 输出: out 形状 [2, 8192, 8192], 连续
+// 计算: out[b, i, j] = sum_k stacked[b, i, k] * stacked[b, j, k]
+// -----------------------------------------------------------------------------
+__global__ void custom_bmm_transpose_kernel(float* __restrict__ out,
+                                            const float* __restrict__ stacked,
+                                            int batch_size,
+                                            int rows,
+                                            int cols) {
+    long long total = (long long)batch_size * rows * rows;
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)blockDim.x * gridDim.x;
+
+    for (long long linear = idx; linear < total; linear += stride) {
+        int b = linear / (rows * rows);
+        long long rem = linear - b * rows * rows;
+        int i = rem / rows;
+        int j = rem - i * rows;
+
+        const float* base = stacked + b * rows * cols;
+        float sum = 0.0f;
+        // 小 K (128)，线程内串行点积，避免共享内存和数值顺序问题
+        for (int k = 0; k < cols; ++k) {
+            sum += base[i * cols + k] * base[j * cols + k];
+        }
+        out[linear] = sum;
+    }
+}
+
+extern "C" void custom_bmm_transpose_launcher(float* out,
+                                              const float* stacked,
+                                              int batch_size,
+                                              int rows,
+                                              int cols,
+                                              cudaStream_t stream) {
+    long long total = (long long)batch_size * rows * rows;
+    int block = 256;
+    long long grid_ll = (total + block - 1) / block;
+    int grid = (int)grid_ll;
+    custom_bmm_transpose_kernel<<<grid, block, 0, stream>>>(out, stacked, batch_size, rows, cols);
+    cudaGetLastError();
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,86 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+extern "C" void custom_stack_launcher(float* out,
+                                      const float* x1,
+                                      const float* x2,
+                                      int rows,
+                                      int cols,
+                                      cudaStream_t stream);
+
+extern "C" void custom_bmm_transpose_launcher(float* out,
+                                              const float* stacked,
+                                              int batch_size,
+                                              int rows,
+                                              int cols,
+                                              cudaStream_t stream);
+
+namespace {
+
+torch::Tensor custom_stack(torch::Tensor x1, torch::Tensor x2) {
+    TORCH_CHECK(x1.is_cuda(), "x1 must be a CUDA tensor");
+    TORCH_CHECK(x2.is_cuda(), "x2 must be a CUDA tensor");
+    TORCH_CHECK(x1.dtype() == torch::kFloat32, "x1 must be float32");
+    TORCH_CHECK(x2.dtype() == torch::kFloat32, "x2 must be float32");
+    TORCH_CHECK(x1.is_contiguous(), "x1 must be contiguous");
+    TORCH_CHECK(x2.is_contiguous(), "x2 must be contiguous");
+    TORCH_CHECK(x1.dim() == 2 && x2.dim() == 2, "inputs must be 2D");
+    TORCH_CHECK(x1.size(0) == 8192 && x1.size(1) == 128,
+                "x1 must have shape [8192, 128]");
+    TORCH_CHECK(x2.size(0) == 8192 && x2.size(1) == 128,
+                "x2 must have shape [8192, 128]");
+
+    const int rows = 8192;
+    const int cols = 128;
+    auto out = torch::empty({2, rows, cols}, x1.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    custom_stack_launcher(out.data_ptr<float>(),
+                          x1.data_ptr<float>(),
+                          x2.data_ptr<float>(),
+                          rows,
+                          cols,
+                          stream);
+    TORCH_CHECK(cudaGetLastError() == cudaSuccess,
+                "custom_stack kernel launch failed");
+    return out;
+}
+
+torch::Tensor custom_bmm_transpose(torch::Tensor stacked) {
+    TORCH_CHECK(stacked.is_cuda(), "stacked must be a CUDA tensor");
+    TORCH_CHECK(stacked.dtype() == torch::kFloat32, "stacked must be float32");
+    TORCH_CHECK(stacked.is_contiguous(), "stacked must be contiguous");
+    TORCH_CHECK(stacked.dim() == 3, "stacked must be 3D");
+    TORCH_CHECK(stacked.size(0) == 2 && stacked.size(1) == 8192 && stacked.size(2) == 128,
+                "stacked must have shape [2, 8192, 128]");
+
+    const int batch_size = 2;
+    const int rows = 8192;
+    const int cols = 128;
+    auto out = torch::empty({batch_size, rows, rows}, stacked.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    custom_bmm_transpose_launcher(out.data_ptr<float>(),
+                                  stacked.data_ptr<float>(),
+                                  batch_size,
+                                  rows,
+                                  cols,
+                                  stream);
+    TORCH_CHECK(cudaGetLastError() == cudaSuccess,
+                "custom_bmm_transpose kernel launch failed");
+    return out;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_stack", &custom_stack, "Stack two tensors along dim 0",
+          py::arg("x1"), py::arg("x2"));
+    m.def("custom_bmm_transpose", &custom_bmm_transpose, "Batch matmul with transpose",
+          py::arg("stacked"));
+}
+
+}  // namespace
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,21 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super(ModelNew, self).__init__()
+
+    def forward(self, x1: torch.Tensor, x2: torch.Tensor) -> torch.Tensor:
+        stacked = cuda_extension.custom_stack(x1, x2)
+        result = cuda_extension.custom_bmm_transpose(stacked)
+        return result
+
+    def debug_forward(self, *inputs):
+        x1, x2 = inputs
+        stacked = cuda_extension.custom_stack(x1, x2)
+        yield 'step_001', stacked
+        result = cuda_extension.custom_bmm_transpose(stacked)
+        yield 'step_002', result
+        yield 'step_003', result
