{
  "operators": [
    {
      "name": "custom_stft",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, length]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "n_fft",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "hop_length",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.complex64",
        "device": "cuda",
        "shape": "[batch, n_fft//2+1, frames]"
      },
      "semantics": [
        "Corresponds to torch.stft(x, n_fft, hop_length, return_complex=True) with default center=True, pad_mode='reflect', window=None, normalized=False, onesided=True.",
        "The output is complex64 with shape [batch, n_fft//2+1, frames] where frames = 1 + length // hop_length.",
        "The implementation must use cuFFT or equivalent CUDA FFT to compute STFT on GPU."
      ]
    },
    {
      "name": "custom_abs",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.complex64",
          "device": "cuda",
          "shape": "[batch, freq, frames]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "Corresponds to torch.abs(x) for complex tensor.",
        "Computes the magnitude (real^2 + imag^2)^0.5 for each element.",
        "The output is float32 with the same shape as input."
      ]
    },
    {
      "name": "custom_remainder",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, freq, frames]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "divisor",
          "kind": "float",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "Corresponds to torch.remainder(x, divisor).",
        "Computes element-wise remainder, following Python modulus semantics, i.e., result has same sign as divisor.",
        "The output is float32 with the same shape as input."
      ]
    },
    {
      "name": "custom_conv1d",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, in_channels, length_in]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels, in_channels, kernel_size]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels]",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        },
        {
          "name": "stride",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "padding",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, out_channels, length_out]"
      },
      "semantics": [
        "Corresponds to nn.Conv1d forward with given weight, bias, stride, padding, dilation=1, groups=1.",
        "The implementation must use cuDNN convolution.",
        "The output length is length_out = floor((length_in + 2*padding - kernel_size)/stride) + 1.",
        "The bias may be None, but in the reference model it is not None."
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = torch.stft(x, n_fft=self.n_fft, hop_length=self.hop_length, return_complex=True)",
      "semantics": [
        "Computes STFT with default window=None, center=True, pad_mode='reflect', normalized=False, onesided=True.",
        "Output shape [batch, n_fft//2+1, frames] with frames = 1 + length // hop_length.",
        "Output is complex64."
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.abs(x)",
      "semantics": [
        "Computes absolute value (magnitude) of complex tensor.",
        "Output is float32 with same shape."
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = torch.remainder(x, 1.0)",
      "semantics": [
        "Element-wise remainder with divisor 1.0.",
        "Result is float32 and has same shape."
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "x = self.conv1d(x)",
      "semantics": [
        "1D convolution with weight [128,257,5], bias [128], stride=1, padding=2.",
        "Output shape [batch, 128, 626]."
      ]
    },
    {
      "checkpoint": "step_005",
      "source": "return x",
      "semantics": [
        "Returns the result of conv1d."
      ]
    }
  ]
}