          "device": "cuda",
          "shape": "[out_channels]",
          "layout": "strided",
          "nullable": true,
          "optional": false
        },
        {
          "name": "stride",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "padding",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, out_channels, output_length]"
      },
      "semantics": [
        "对应参考 F.conv1d(y, self.conv1d_weight, self.conv1d_bias, stride=1, padding=0)。",
        "输入 shape [N, C_in, L_in]，权重 shape [C_out, C_in, K]。",
        "输出长度 L_out = floor((L_in - K) / stride) + 1，参考中 stride=1, padding=0 得到 L_out = L_in - K + 1。",
        "bias 若不为 None 则加到每个输出通道。",
        "输出 dtype/device 与输入一致。"
      ]
    }
