  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.conv_transpose(x)",
      "semantics": [
        "对输入 x 执行 ConvTranspose1d，权重来自 self.conv_transpose.weight。",
        "stride=2, padding=1, output_padding=0, kernel_size=4。",
        "输入 shape [512, 64, 1024] -> 输出 shape [512, 64, 2048]。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.add(x, self.bias)",
      "semantics": [
        "将 self.bias shape [64, 1] 广播加到 x 的每个空间位置。",
        "输出 shape 保持 [512, 64, 2048]。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "y = F.conv1d(y, self.conv1d_weight, self.conv1d_bias, stride=1, padding=0)",
      "semantics": [
        "对 y 执行 Conv1d，使用 self.conv1d_weight 和 self.conv1d_bias。",
        "stride=1, padding=0, kernel_size=3。",
        "输入 shape [512, 128, 2048] -> 输出 shape [512, 128, 2046]。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return (x, y)",
      "semantics": [
        "返回包含两个张量的 tuple，x shape [512, 64, 2048]，y shape [512, 128, 2046]。"
      ]
    }
  ]
