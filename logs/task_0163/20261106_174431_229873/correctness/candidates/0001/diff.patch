--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,28 @@
+#include <cuda_runtime.h>
+#include <cmath>
+
+__global__ void softplus_kernel(const float* __restrict__ input,
+                                float* __restrict__ output,
+                                long long numel) {
+    const long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    const long long stride = (long long)gridDim.x * blockDim.x;
+    for (long long i = idx; i < numel; i += stride) {
+        float x = input[i];
+        // PyTorch softplus: for x > threshold (20), output = x;
+        // otherwise log1p(exp(x)). Using float precision as input/output are float32.
+        output[i] = (x > 20.0f) ? x : log1pf(expf(x));
+    }
+}
+
+extern "C" void softplus_forward_launcher(const float* input,
+                                          float* output,
+                                          long long numel,
+                                          cudaStream_t stream) {
+    const int block_size = 256;
+    // Calculate grid size, capped at 65535 (max grid dimension in x).
+    // Grid-stride loop handles any larger sizes.
+    long long grid_size_ll = (numel + block_size - 1) / block_size;
+    int grid_size = (int)min(grid_size_ll, (long long)65535);
+    if (grid_size == 0) grid_size = 1; // at least one block, even if numel==0 (kernel will exit immediately)
+    softplus_kernel<<<grid_size, block_size, 0, stream>>>(input, output, numel);
+}
--- before/kernels/softplus_binding.cpp
+++ after/kernels/softplus_binding.cpp
@@ -0,0 +1,44 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Launcher declaration from custom_ops.cu
+extern "C" void softplus_forward_launcher(
+    const float* input,
+    float* output,
+    long long numel,
+    cudaStream_t stream);
+
+// PyTorch binding wrapper
+torch::Tensor softplus_forward(torch::Tensor x) {
+    // Validate input
+    TORCH_CHECK(x.is_cuda(), "softplus_forward: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "softplus_forward: input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "softplus_forward: input must be contiguous");
+
+    // Allocate output with same shape, dtype, device, and stride (contiguous input -> contiguous output)
+    auto output = torch::empty_like(x);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Launch kernel via launcher
+    softplus_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<long long>(x.numel()),
+        stream);
+
+    return output;
+}
+
+// Registration
+void register_softplus(pybind11::module& m) {
+    m.def("softplus_forward", &softplus_forward,
+          "Softplus forward",
+          pybind11::arg("x"));
+}
+
+REGISTER_BINDING(softplus, register_softplus);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,15 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x):
+        return cuda_extension.softplus_forward(x)
+
+    def debug_forward(self, x):
+        out = cuda_extension.softplus_forward(x)
+        yield 'step_001', out
