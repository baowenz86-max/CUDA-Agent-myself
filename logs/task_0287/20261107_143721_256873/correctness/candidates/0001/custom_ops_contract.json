{
  "operators": [
    {
      "name": "batch_norm_eval_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[32, 3, 512, 256]",
          "layout": "supports strides (contiguous or non-contiguous)",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[3]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[3]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[3]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[3]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "default": 1e-05,
          "nullable": false,
          "optional": true
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[32, 3, 512, 256]"
      },
      "semantics": [
        "对应参考语句 x = self.batch_norm(x)，在 eval 模式下使用 running_mean/running_var 和 eps 进行归一化：y = (x - running_mean[c]) / sqrt(running_var[c] + eps) * weight[c] + bias[c]，其中 c 为通道维度 (dim=1)",
        "weight 和 bias 可为 None，分别表示无缩放或无偏移；None 时对应项视为 1 或 0",
        "广播按 NCHW 布局沿通道维度处理，输出 shape 与输入相同",
        "输入支持任意 stride，但绑定层可将其连续化或按实际 stride 处理"
      ]
    },
    {
      "name": "tanh_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[32, 3, 512, 256]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[32, 3, 512, 256]"
      },
      "semantics": [
        "对应参考语句 x = self.tanh(x)，逐元素计算标准 tanh 函数",
        "输出 shape 和 dtype 与输入一致"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.batch_norm(x)",
      "semantics": [
        "eval 模式下 BatchNorm2d 对输入 x 进行逐通道归一化，使用 running_mean、running_var 和 eps，并应用 affine 参数 weight 和 bias",
        "输出 shape [32,3,512,256]，float32，cuda"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.tanh(x)",
      "semantics": [
        "对 batch_norm 输出逐元素应用 tanh 激活函数",
        "输出 shape [32,3,512,256]，float32，cuda"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回 tanh 输出，shape [32,3,512,256]，float32，cuda"
      ]
    }
  ]
}