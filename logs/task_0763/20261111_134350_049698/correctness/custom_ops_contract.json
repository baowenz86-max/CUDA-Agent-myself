        "输出为新的 CUDA tensor，与输入相同维度。"
      ]
    },
    {
      "name": "sum_dim_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference step",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "default": 1,
          "device": null,
          "shape": null,
          "layout": null,
          "nullable": false,
          "optional": true
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as reference torch.sum output"
      },
      "semantics": [
        "对应参考语句 x = torch.sum(x, dim=self.dim)，沿 dim=1 求和。",
        "输入 shape 为 [1024, 3, 512, 256]，输出 shape 为 [1024, 512, 256]。",
        "不保留被消去的维度，输出 stride 为 [131072, 256, 1]。",
        "返回新的 CUDA tensor，dtype float32。"
      ]
    }
