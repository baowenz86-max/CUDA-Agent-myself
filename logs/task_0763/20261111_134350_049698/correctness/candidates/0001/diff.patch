--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,67 @@
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// ReLU kernel: element-wise max(0, x)
+__global__ void relu_kernel(const float* __restrict__ input,
+                            float* __restrict__ output,
+                            int64_t numel) {
+    int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    int64_t stride = static_cast<int64_t>(blockDim.x) * gridDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        output[i] = fmaxf(input[i], 0.0f);
+    }
+}
+
+// Sum along dim=1 kernel for input shape [B, C, H, W], dim=1 has size C.
+// Each thread computes one output element (b, h, w) by summing across C channels.
+__global__ void sum_dim1_kernel(const float* __restrict__ input,
+                                 float* __restrict__ output,
+                                 int64_t B, int64_t C, int64_t H, int64_t W,
+                                 int64_t total_output_elements) {
+    int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    int64_t stride = static_cast<int64_t>(blockDim.x) * gridDim.x;
+    for (int64_t i = idx; i < total_output_elements; i += stride) {
+        // Decode output index i into (b, h, w)
+        int64_t w = i % W;
+        int64_t tmp = i / W;
+        int64_t h = tmp % H;
+        int64_t b = tmp / H;
+
+        float sum = 0.0f;
+        #pragma unroll
+        for (int64_t c = 0; c < C; ++c) {
+            int64_t in_idx = ((b * C + c) * H + h) * W + w;
+            sum += input[in_idx];
+        }
+        output[i] = sum;
+    }
+}
+
+// Relu launcher: C interface for binding.cpp
+extern "C" void relu_forward_launcher(const float* input,
+                                      float* output,
+                                      int64_t numel,
+                                      cudaStream_t stream) {
+    if (numel <= 0) return;
+    const int block_size = 256;
+    // Use grid-stride loop, grid can be smaller than numel/block_size to limit grid size.
+    int64_t max_blocks = (numel + block_size - 1) / block_size;
+    // Cap grid at a reasonable maximum to avoid excessive blocks; grid-stride loop handles rest.
+    int64_t grid_size = min(max_blocks, (int64_t)65535 * 32);
+    relu_kernel<<<(int)grid_size, block_size, 0, stream>>>(input, output, numel);
+}
+
+// Sum dim=1 launcher: C interface for binding.cpp
+// Input shape: [B, C, H, W], output shape: [B, H, W]
+extern "C" void sum_dim1_launcher(const float* input,
+                                  float* output,
+                                  int64_t B, int64_t C, int64_t H, int64_t W,
+                                  cudaStream_t stream) {
+    int64_t total_output = B * H * W;
+    if (total_output <= 0) return;
+    const int block_size = 256;
+    int64_t max_blocks = (total_output + block_size - 1) / block_size;
+    int64_t grid_size = min(max_blocks, (int64_t)65535 * 32);
+    sum_dim1_kernel<<<(int)grid_size, block_size, 0, stream>>>(
+        input, output, B, C, H, W, total_output);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,57 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void relu_forward_launcher(const float* input, float* output, int64_t numel, cudaStream_t stream);
+extern "C" void sum_dim1_launcher(const float* input, float* output, int64_t B, int64_t C, int64_t H, int64_t W, cudaStream_t stream);
+
+// ReLU forward binding
+torch::Tensor relu_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+
+    auto output = torch::empty_like(x);
+    int64_t numel = x.numel();
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    relu_forward_launcher(x.data_ptr<float>(), output.data_ptr<float>(), numel, stream);
+
+    return output;
+}
+
+// Sum along dim=1 binding
+// Input x shape [B, C, H, W], output shape [B, H, W]
+// dim must be 1, as per contract
+torch::Tensor sum_dim_forward(torch::Tensor x, int64_t dim) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dim() == 4, "sum_dim_forward expects 4D tensor [B, C, H, W]");
+    TORCH_CHECK(dim == 1, "sum_dim_forward only supports dim=1");
+
+    int64_t B = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+
+    auto output = torch::empty({B, H, W}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    sum_dim1_launcher(x.data_ptr<float>(), output.data_ptr<float>(), B, C, H, W, stream);
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("relu_forward", &relu_forward, "ReLU forward",
+          py::arg("x"));
+    m.def("sum_dim_forward", &sum_dim_forward, "Sum along dim=1",
+          py::arg("x"), py::arg("dim") = 1);
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,21 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, dim: int):
+        super().__init__()
+        self.dim = dim
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        x = cuda_extension.relu_forward(x)
+        x = cuda_extension.sum_dim_forward(x, self.dim)
+        return x
+
+    def debug_forward(self, x: torch.Tensor):
+        x = cuda_extension.relu_forward(x)
+        yield 'step_001', x
+        x = cuda_extension.sum_dim_forward(x, self.dim)
+        yield 'step_002', x
+        yield 'step_003', x
