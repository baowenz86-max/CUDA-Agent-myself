--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,139 @@
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// -----------------------------------------------------------------------------
+// copy_to_cuda_forward: 将 CPU 上的 float32 连续张量复制到当前 CUDA 设备。
+// 输入: src_cpu 指向 CPU 内存; numel 元素个数; stream 当前 CUDA stream。
+// 输出: dst_cuda 指向 GPU 内存（由 binding 层预先分配并传入）。
+// 该 launcher 不负责分配内存，只执行复制。
+// -----------------------------------------------------------------------------
+extern "C" void copy_to_cuda_launcher(
+    float* dst_cuda,
+    const float* src_cpu,
+    int64_t numel,
+    cudaStream_t stream)
+{
+    cudaError_t err = cudaMemcpyAsync(dst_cuda, src_cpu, numel * sizeof(float), cudaMemcpyHostToDevice, stream);
+    if (err != cudaSuccess) {
+        // 错误由调用者检查，这里不做处理
+    }
+}
+
+// -----------------------------------------------------------------------------
+// pad_forward: 对输入四维张量 [N, C, H, W] 在 H 和 W 维度各填充 pad 个零。
+// 输入: src 连续 GPU float32 张量, N C H W, pad 填充宽度(此处固定为2)。
+// 输出: dst 连续 GPU float32 张量，形状 [N, C, H+2*pad, W+2*pad]，已清零。
+// 使用 grid-stride loop，每个线程负责一个输出元素，直接复制或写零。
+// -----------------------------------------------------------------------------
+template <int BLOCK_SIZE>
+__global__ void pad_kernel(
+    const float* __restrict__ src,
+    float* __restrict__ dst,
+    int64_t N, int64_t C, int64_t H, int64_t W,
+    int64_t pad)
+{
+    int64_t out_H = H + 2 * pad;
+    int64_t out_W = W + 2 * pad;
+    int64_t total_out = N * C * out_H * out_W;
+
+    for (int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+         idx < total_out;
+         idx += gridDim.x * blockDim.x) {
+
+        // 将线性索引分解为输出坐标 (n, c, oh, ow)
+        int64_t ow = idx % out_W;
+        int64_t tmp = idx / out_W;
+        int64_t oh = tmp % out_H;
+        tmp /= out_H;
+        int64_t c = tmp % C;
+        int64_t n = tmp / C;
+
+        // 检查是否在填充区域内
+        if (oh >= pad && oh < H + pad && ow >= pad && ow < W + pad) {
+            // 有效数据区域，复制输入对应元素
+            int64_t ih = oh - pad;
+            int64_t iw = ow - pad;
+            int64_t src_idx = ((n * C + c) * H + ih) * W + iw;
+            dst[idx] = src[src_idx];
+        } else {
+            // 填充区域，置零
+            dst[idx] = 0.0f;
+        }
+    }
+}
+
+extern "C" void pad_launcher(
+    const float* src,
+    float* dst,
+    int64_t N, int64_t C, int64_t H, int64_t W,
+    int64_t pad,
+    cudaStream_t stream)
+{
+    const int block_size = 256;
+    int64_t out_H = H + 2 * pad;
+    int64_t out_W = W + 2 * pad;
+    int64_t total_out = N * C * out_H * out_W;
+    // 计算足够的 block 数量，限制最大 grid 维度
+    int64_t blocks64 = (total_out + block_size - 1) / block_size;
+    int blocks = static_cast<int>(min(blocks64, static_cast<int64_t>(INT32_MAX)));
+    if (blocks <= 0) blocks = 1;
+
+    pad_kernel<256><<<blocks, block_size, 0, stream>>>(
+        src, dst, N, C, H, W, pad);
+}
+
+// -----------------------------------------------------------------------------
+// sum_dim_forward: 沿指定维度 dim=2 (height) 求和。
+// 输入: src 连续 GPU float32 张量 [N, C, H, W]。
+// 输出: dst 连续 GPU float32 张量 [N, C, W]，初始化为零。
+// 为简单和正确，每个输出元素由一个线程累加整个 H 维度。
+// 使用 grid-stride 循环覆盖所有输出元素。
+// -----------------------------------------------------------------------------
+__global__ void sum_dim2_kernel(
+    const float* __restrict__ src,
+    float* __restrict__ dst,
+    int64_t N, int64_t C, int64_t H, int64_t W)
+{
+    int64_t total_out = N * C * W;
+
+    for (int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+         idx < total_out;
+         idx += gridDim.x * blockDim.x) {
+
+        // 分解输出索引 (n, c, w)
+        int64_t w = idx % W;
+        int64_t tmp = idx / W;
+        int64_t c = tmp % C;
+        int64_t n = tmp / C;
+
+        // 累加 H 维度
+        float sum = 0.0f;
+        for (int64_t h = 0; h < H; ++h) {
+            int64_t src_idx = ((n * C + c) * H + h) * W + w;
+            sum += src[src_idx];
+        }
+        dst[idx] = sum;
+    }
+}
+
+extern "C" void sum_dim_launcher(
+    const float* src,
+    float* dst,
+    int64_t N, int64_t C, int64_t H, int64_t W,
+    int64_t dim,
+    cudaStream_t stream)
+{
+    // 仅支持 dim=2，其他 dim 由绑定层拒绝或使用通用实现（此处未实现）
+    if (dim != 2) {
+        return;  // 调用者应处理错误
+    }
+
+    const int block_size = 256;
+    int64_t total_out = N * C * W;
+    int64_t blocks64 = (total_out + block_size - 1) / block_size;
+    int blocks = static_cast<int>(min(blocks64, static_cast<int64_t>(INT32_MAX)));
+    if (blocks <= 0) blocks = 1;
+
+    sum_dim2_kernel<<<blocks, block_size, 0, stream>>>(
+        src, dst, N, C, H, W);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,135 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// 声明 custom_ops.cu 中的 launcher
+extern "C" void copy_to_cuda_launcher(
+    float* dst_cuda,
+    const float* src_cpu,
+    int64_t numel,
+    cudaStream_t stream);
+
+extern "C" void pad_launcher(
+    const float* src,
+    float* dst,
+    int64_t N, int64_t C, int64_t H, int64_t W,
+    int64_t pad,
+    cudaStream_t stream);
+
+extern "C" void sum_dim_launcher(
+    const float* src,
+    float* dst,
+    int64_t N, int64_t C, int64_t H, int64_t W,
+    int64_t dim,
+    cudaStream_t stream);
+
+// -----------------------------------------------------------------------------
+// copy_to_cuda_forward: 将 CPU float32 连续张量复制到当前 CUDA 设备
+// -----------------------------------------------------------------------------
+torch::Tensor copy_to_cuda_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cpu(), "copy_to_cuda_forward: input must be a CPU tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "copy_to_cuda_forward: input dtype must be float32");
+    TORCH_CHECK(x.is_contiguous(), "copy_to_cuda_forward: input must be contiguous");
+
+    int64_t numel = x.numel();
+    auto output = torch::empty_like(x, x.options().device(torch::kCUDA));
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    copy_to_cuda_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        numel,
+        stream);
+
+    // 检查 CUDA 错误（launcher 内部已执行 memcpyAsync，但此处检查同步前的错误）
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "copy_to_cuda_forward: CUDA error: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// -----------------------------------------------------------------------------
+// pad_forward: 对输入四维张量 [N, C, H, W] 在 H 和 W 维度各填充 pad 个零
+// -----------------------------------------------------------------------------
+torch::Tensor pad_forward(torch::Tensor x, int64_t pad) {
+    TORCH_CHECK(x.is_cuda(), "pad_forward: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "pad_forward: input dtype must be float32");
+    TORCH_CHECK(x.is_contiguous(), "pad_forward: input must be contiguous");
+    TORCH_CHECK(x.dim() == 4, "pad_forward: input must be 4-dimensional");
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+    int64_t out_H = H + 2 * pad;
+    int64_t out_W = W + 2 * pad;
+
+    auto output = torch::zeros({N, C, out_H, out_W}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    pad_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C, H, W,
+        pad,
+        stream);
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "pad_forward: CUDA error: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// -----------------------------------------------------------------------------
+// sum_dim_forward: 沿指定维度 dim 求和
+// -----------------------------------------------------------------------------
+torch::Tensor sum_dim_forward(torch::Tensor x, int64_t dim) {
+    TORCH_CHECK(x.is_cuda(), "sum_dim_forward: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "sum_dim_forward: input dtype must be float32");
+    TORCH_CHECK(x.is_contiguous(), "sum_dim_forward: input must be contiguous");
+    TORCH_CHECK(x.dim() == 4, "sum_dim_forward: input must be 4-dimensional");
+    TORCH_CHECK(dim == 2, "sum_dim_forward: only dim=2 is supported");
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+
+    auto output = torch::zeros({N, C, W}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    sum_dim_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C, H, W,
+        dim,
+        stream);
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "sum_dim_forward: CUDA error: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// -----------------------------------------------------------------------------
+// 注册所有算子
+// -----------------------------------------------------------------------------
+void register_custom_ops(pybind11::module& m) {
+    m.def("copy_to_cuda_forward", &copy_to_cuda_forward,
+          "Copy a CPU float32 tensor to current CUDA device",
+          py::arg("x"));
+    m.def("pad_forward", &pad_forward,
+          "Pad a CUDA float32 tensor with zeros on H and W dimensions",
+          py::arg("x"), py::arg("pad"));
+    m.def("sum_dim_forward", &sum_dim_forward,
+          "Sum over a specified dimension of a CUDA float32 tensor",
+          py::arg("x"), py::arg("dim"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,29 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, dim):
+        super().__init__()
+        self.dim = dim
+
+    def forward(self, x):
+        # 将输入从 CPU 复制到 CUDA（参考执行设备为 cuda:0）
+        x = cuda_extension.copy_to_cuda_forward(x)
+        # F.pad(x, (2, 2, 2, 2))
+        x = cuda_extension.pad_forward(x, 2)
+        # torch.sum(x, dim=self.dim)
+        x = cuda_extension.sum_dim_forward(x, self.dim)
+        return x
+
+    def debug_forward(self, x):
+        x_cuda = cuda_extension.copy_to_cuda_forward(x)
+        # step_001: 填充后的张量
+        padded = cuda_extension.pad_forward(x_cuda, 2)
+        yield "step_001", padded
+        # step_002: 求和后的张量
+        summed = cuda_extension.sum_dim_forward(padded, self.dim)
+        yield "step_002", summed
+        # step_003: 最终返回
+        yield "step_003", summed
