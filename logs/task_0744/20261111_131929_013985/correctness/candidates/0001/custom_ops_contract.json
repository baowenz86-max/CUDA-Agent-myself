{
  "operators": [
    {
      "name": "mean_dim0_keepdim",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as input tensor, typically [64, 3, 2048, 1024]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[1, 3, 2048, 1024]"
      },
      "semantics": [
        "Computes mean over dimension 0 with keepdim=True, equivalent to torch.mean(x, dim=0, keepdim=True)",
        "Reduces batch dimension (size 64) element-wise, preserving channel, height, width dimensions",
        "Output shape is [1, num_features, height, width]"
      ]
    },
    {
      "name": "batchnorm2d_eval",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[1, num_features, height, width]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[num_features]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[num_features]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[num_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[num_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "Applies BatchNorm2d evaluation using running statistics, equivalent to self.bn2d(x) in eval mode",
        "Per-channel affine transformation: (input - running_mean) / sqrt(running_var + eps) * weight + bias",
        "If weight or bias is None, they are treated as 1 and 0 respectively",
        "Input is expected to be 4D (N, C, H, W) with N=1 from previous mean reduction, but implementation should support N>=1",
        "Output shape matches input"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = torch.mean(x, dim=0, keepdim=True)",
      "semantics": [
        "Compute mean over batch dimension (dim=0) with keepdim=True",
        "Input shape [64, 3, 2048, 1024] -> output shape [1, 3, 2048, 1024]"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.bn2d(x)",
      "semantics": [
        "Apply BatchNorm2d in eval mode using tracked running_mean and running_var",
        "Affine transform per channel: y = (x - mean) / sqrt(var + eps) * weight + bias"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "Return the normalized tensor of shape [1, 3, 2048, 1024]"
      ]
    }
  ]
