    "kernels/custom_ops.cu": "#include <cuda_runtime.h>\n#include <math.h>\n\n// -----------------------------------------------------------------------------\n// ConvTranspose1d forward (float32)\n// Input:  x: [N, C_in, L_in]\n// Weight: [C_in, C_out, K]\n// Bias:   [C_out] or nullptr\n// Output: [N, C_out, L_out]\n// L_out = (L_in-1)*stride - 2*padding + K + output_padding\n// -----------------------------------------------------------------------------\n__global__ void conv_transpose1d_kernel(\n    const float* __restrict__ input,\n    const float* __restrict__ weight,\n    const float* __restrict__ bias,\n    float* __restrict__ output,\n    int N, int C_in, int C_out, int L_in, int L_out,\n    int K, int stride, int padding, int output_padding)\n{\n    int tid = blockIdx.x * blockDim.x + threadIdx.x;\n    int total = N * C_out * L_out;\n    if (tid >= total) return;\n\n    int n = tid / (C_out * L_out);\n    int rem = tid - n * C_out * L_out;\n    int c_out = rem / L_out;\n    int l_out = rem - c_out * L_out;\n\n    float acc = (bias != nullptr) ? bias[c_out] : 0.0f;\n\n    for (int c_in = 0; c_in < C_in; ++c_in) {\n        const float* in_base = input + n * C_in * L_in + c_in * L_in;\n        const float* w_base = weight + c_in * C_out * K + c_out * K;\n        for (int k = 0; k < K; ++k) {\n            int l_in = l_out + padding - k;\n            if (l_in % stride != 0) continue;\n            l_in /= stride;\n            if (l_in >= 0 && l_in < L_in) {\n                acc += in_base[l_in] * w_base[k];\n            }\n        }\n    }\n\n    output[tid] = acc;\n}\n\nextern \"C\" void conv_transpose1d_launcher(\n    const float* input,\n    const float* weight,\n    const float* bias,\n    float* output,\n    int N, int C_in, int C_out, int L_in, int L_out,\n    int K, int stride, int padding, int output_padding,\n    cudaStream_t stream)\n{\n    int total = N * C_out * L_out;\n    int block = 256;\n    int grid = (total + block - 1) / block;\n    conv_transpose1d_kernel<<<grid, block, 0, stream>>>(\n        input, weight, bias, output,\n        N, C_in, C_out, L_in, L_out,\n        K, stride, padding, output_padding);\n}\n\n// -----------------------------------------------------------------------------\n// rsqrt(abs(x) + eps)\n// -----------------------------------------------------------------------------\n__global__ void rsqrt_abs_eps_kernel(\n    const float* __restrict__ input,\n    float* __restrict__ output,\n    int n, float eps)\n{\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    if (idx < n) {\n        float val = fabsf(input[idx]) + eps;\n        output[idx] = rsqrtf(val);\n    }\n}\n\nextern \"C\" void rsqrt_abs_eps_launcher(\n    const float* input,\n    float* output,\n    int n, float eps,\n    cudaStream_t stream)\n{\n    int block = 256;\n    int grid = (n + block - 1) / block;\n    rsqrt_abs_eps_kernel<<<grid, block, 0, stream>>>(input, output, n, eps);\n}\n\n// -----------------------------------------------------------------------------\n// Softmax over last dimension\n// Input/output: [rows, cols], row stride = cols (contiguous along last dim)\n// -----------------------------------------------------------------------------\n__global__ void softmax_lastdim_kernel(\n    const float* __restrict__ input,\n    float* __restrict__ output,\n    int rows, int cols)\n{\n    extern __shared__ float smem[];\n    float* s_max = smem;          // one float per block\n    float* s_sum = smem + 1;      // one float per block\n\n    int row = blockIdx.x;\n    if (row >= rows) return;\n\n    const float* in_row = input + row * cols;\n    float* out_row = output + row * cols;\n\n    int tid = threadIdx.x;\n    int blockDim = blockDim.x;\n\n    // Step 1: find max\n    float local_max = -INFINITY;\n    for (int i = tid; i < cols; i += blockDim) {\n        float v = in_row[i];\n        if (v > local_max) local_max = v;\n    }\n\n    // reduce max within block using shared memory\n    if (tid == 0) s_max[0] = -INFINITY;\n    __syncthreads();\n\n    // Use warp reduction + shared reduction\n    // Simple shared reduction:\n    for (int offset = blockDim / 2; offset > 0; offset >>= 1) {\n        if (tid < offset) {\n            float other = __shfl_down_sync(0xffffffff, local_max, offset);\n            if (other > local_max) local_max = other;\n        }\n    }\n    // alternative: use shared memory\n    __shared__ float block_max[256];\n    block_max[tid] = local_max;\n    __syncthreads();\n    for (int offset = blockDim / 2; offset > 0; offset >>= 1) {\n        if (tid < offset) {\n            if (block_max[tid + offset] > block_max[tid]) block_max[tid] = block_max[tid + offset];\n        }\n        __syncthreads();\n    }\n    float row_max = block_max[0];\n    __syncthreads();\n\n    // Step 2: compute sum of exp(x - max)\n    float local_sum = 0.0f;\n    for (int i = tid; i < cols; i += blockDim) {\n        local_sum += __expf(in_row[i] - row_max);\n    }\n\n    __shared__ float block_sum[256];\n    block_sum[tid] = local_sum;\n    __syncthreads();\n    for (int offset = blockDim / 2; offset > 0; offset >>= 1) {\n        if (tid < offset) {\n            block_sum[tid] += block_sum[tid + offset];\n        }\n        __syncthreads();\n    }\n    float row_sum = block_sum[0];\n    __syncthreads();\n\n    // Step 3: normalize\n    float inv_sum = 1.0f / row_sum;\n    for (int i = tid; i < cols; i += blockDim) {\n        out_row[i] = __expf(in_row[i] - row_max) * inv_sum;\n    }\n}\n\nextern \"C\" void softmax_lastdim_launcher(\n    const float* input,\n    float* output,\n    int rows, int cols,\n    cudaStream_t stream)\n{\n    int block = 256;\n    int grid = rows;\n    // shared memory size: nothing extra needed beyond static arrays? we use static shared arrays inside kernel, so 0 dynamic.\n    softmax_lastdim_kernel<<<grid, block, 0, stream>>>(input, output, rows, cols);\n}\n"
}
