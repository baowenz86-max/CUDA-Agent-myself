===== model.py =====
import torch
import torch.nn as nn
import torch.nn.functional as F


class Model(nn.Module):
    def __init__(self, in_channels, out_channels, kernel_size, stride, padding, output_padding, bias):
        super().__init__()
        self.conv_transpose1d = nn.ConvTranspose1d(
            in_channels,
            out_channels,
            kernel_size,
            stride=stride,
            padding=padding,
            output_padding=output_padding,
            bias=bias,
        )

    def forward(self, x):
        x = F.conv_transpose1d(
            x,
            self.conv_transpose1d.weight,
            self.conv_transpose1d.bias if self.conv_transpose1d.bias is not None else None,
            stride=self.conv_transpose1d.stride,
            padding=self.conv_transpose1d.padding,
            output_padding=self.conv_transpose1d.output_padding,
        )
        x = torch.rsqrt(torch.abs(x) + 1e-12)  # Adding a small value to prevent division by zero
        x = F.softmax(x, dim=-1)
        return x


batch_size = 128
in_channels = 3
out_channels = 16
length = 8192  # Increased from 512 to 8192 to increase computational load
kernel_size = 3
stride = 2
padding = 1
output_padding = 1
bias = True


def get_inputs():
    return [torch.randn(batch_size, in_channels, length)]


def get_init_inputs():
    return [in_channels, out_channels, kernel_size, stride, padding, output_padding, bias]

===== model_new.py =====
import torch
import torch.nn as nn

import cuda_extension


class ModelNew(nn.Module):
    def __init__(self, in_channels, out_channels, kernel_size, stride, padding, output_padding, bias):
        super().__init__()
        # Preserve original parameter structure and state_dict keys.
        self.conv_transpose1d = nn.ConvTranspose1d(
            in_channels,
            out_channels,
            kernel_size,
            stride=stride,
            padding=padding,
            output_padding=output_padding,
            bias=bias,
        )

    def forward(self, x):
        # Step 1: transposed convolution
        x = cuda_extension.conv_transpose1d_forward(
            x,
            self.conv_transpose1d.weight,
            self.conv_transpose1d.bias if self.conv_transpose1d.bias is not None else None,
            self.conv_transpose1d.stride[0],
            self.conv_transpose1d.padding[0],
            self.conv_transpose1d.output_padding[0],
        )
        # Step 2: rsqrt(abs(x) + 1e-12)
        x = cuda_extension.rsqrt_eps_forward(x)
        # Step 3: softmax along last dimension
        x = cuda_extension.softmax_dim_forward(x, dim=-1)
        return x

    def debug_forward(self, x):
        # Yield each checkpoint in the same order as the reference trace.
        # Checkpoint 1: conv_transpose1d
        x = cuda_extension.conv_transpose1d_forward(
            x,
            self.conv_transpose1d.weight,
            self.conv_transpose1d.bias if self.conv_transpose1d.bias is not None else None,
            self.conv_transpose1d.stride[0],
            self.conv_transpose1d.padding[0],
            self.conv_transpose1d.output_padding[0],
        )
        yield "step_001", x
        # Checkpoint 2: rsqrt(abs(x) + 1e-12)
        x = cuda_extension.rsqrt_eps_forward(x)
        yield "step_002", x
        # Checkpoint 3: softmax(dim=-1)
        x = cuda_extension.softmax_dim_forward(x, dim=-1)
        yield "step_003", x
        # Checkpoint 4: final return value
        yield "step_004", x


