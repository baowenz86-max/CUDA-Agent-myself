        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对应参考语句 x = self.group_norm(x)。",
        "输入形状 [N, C, H, W]，分组数 G=num_groups，每组通道数 C/G。",
        "对每个样本每个组计算均值 E[x] 和方差 Var[x]（有偏，除以组内元素数）。",
        "输出 y = (x - mean) / sqrt(var + eps) * weight_c + bias_c，其中 weight_c 和 bias_c 为对应通道的仿射参数。",
        "weight 或 bias 为 None 时分别省略对应仿射项。",
        "输入必须为 CUDA float32 连续张量。"
      ]
    },
    {
      "name": "gelu_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "any",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对应参考语句 x = F.gelu(x)，使用默认 approximate='none'。",
        "计算 y = x * 0.5 * (1 + erf(x / sqrt(2)))。",
        "输入必须为 CUDA float32 连续张量。"
      ]
    }
  ],
