          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        },
        {
          "name": "num_groups",
          "kind": "int",
          "shape": null,
