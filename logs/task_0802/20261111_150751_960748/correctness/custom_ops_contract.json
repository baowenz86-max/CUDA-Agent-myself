{
  "operators": [
    {
      "name": "custom_softmax_channel_only",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W] (N=512, C=20, H=W=128)",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "对输入张量 x 在维度 dim=1 上执行 softmax 运算。",
        "输入形状为 (N, C, H, W)，softmax 仅在 C 维上进行，对每个 (n, h, w) 位置独立计算。",
        "输出形状和 dtype 与输入完全相同。"
      ]
    },
    {
      "name": "custom_prelu",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W] (N=512, C=20, H=W=128)",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C] (C=20)",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "PReLU 激活：对每个通道 c，使用权重 weight[c] 计算输出。",
        "具体公式：if x > 0: output = x; else: output = weight[c] * x。",
        "weight 的形状为 (C,)，与输入通道数一致。",
        "输出形状和 dtype 与输入 x 相同。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.softmax(x, dim=1)",
      "semantics": [
        "调用 F.softmax(x, dim=1)，沿通道维 C 执行 softmax。",
        "输入 x 形状 [512, 20, 128, 128]，输出形状不变。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.prelu(x)",
      "semantics": [
        "调用 nn.PReLU(num_parameters=20)，使用 prelu.weight 对 softmax 输出逐通道应用 PReLU。",
        "输出形状不变。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回最终张量，形状 [512, 20, 128, 128]。"
      ]
    }
  ]
}