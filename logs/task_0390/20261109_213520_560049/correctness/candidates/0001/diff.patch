--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,66 @@
+#include <cuda_runtime.h>
+
+// channel_shuffle forward kernel
+// x: input tensor with arbitrary strides (float32)
+// output: output tensor contiguous, same shape as x
+// N, C, H, W: dimensions
+// groups: number of groups for channel shuffle
+// strides: input strides for [N, C, H, W] dimensions in elements
+__global__ void channel_shuffle_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ output,
+    int N, int C, int H, int W, int groups,
+    long long stride_n, long long stride_c, long long stride_h, long long stride_w)
+{
+    int channels_per_group = C / groups;
+
+    // Total number of elements
+    long long total = (long long)N * C * H * W;
+
+    // Grid-stride loop over flattened index
+    for (long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+         idx < total;
+         idx += (long long)gridDim.x * blockDim.x)
+    {
+        // Decompose idx into (n, c, h, w) in row-major order of output
+        int w = idx % W;
+        long long tmp = idx / W;
+        int h = tmp % H;
+        tmp /= H;
+        int out_c = tmp % C;
+        int n = tmp / C;
+
+        // Compute channel shuffle mapping
+        // out_c = out_g * channels_per_group + out_cg
+        int out_g = out_c / channels_per_group;
+        int out_cg = out_c - out_g * channels_per_group;
+        // input channel index c = out_cg * groups + out_g
+        int in_c = out_cg * groups + out_g;
+
+        // Input linear offset using input strides
+        long long in_offset = (long long)n * stride_n + (long long)in_c * stride_c + (long long)h * stride_h + (long long)w * stride_w;
+        // Output linear offset (output is contiguous, assumed standard shape stride)
+        long long out_offset = (long long)n * (C * H * W) + (long long)out_c * (H * W) + (long long)h * W + w;
+
+        output[out_offset] = x[in_offset];
+    }
+}
+
+extern "C" void channel_shuffle_forward_launcher(
+    const float* x,
+    float* output,
+    int N, int C, int H, int W, int groups,
+    long long stride_n, long long stride_c, long long stride_h, long long stride_w,
+    cudaStream_t stream)
+{
+    long long total = (long long)N * C * H * W;
+    int block_size = 256;
+    // Cap grid to reasonable size and use grid-stride loop
+    long long grid_size_ll = (total + block_size - 1) / block_size;
+    int max_grid = 65535; // safe for all GPUs, grid-stride loop handles the rest
+    int grid_size = (int)min(grid_size_ll, (long long)max_grid);
+
+    channel_shuffle_kernel<<<grid_size, block_size, 0, stream>>>(
+        x, output, N, C, H, W, groups,
+        stride_n, stride_c, stride_h, stride_w);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,72 @@
+#include <torch/types.h>
+#include <pybind11/pybind11.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+namespace py = pybind11;
+
+// Declare launcher from custom_ops.cu
+extern "C" void channel_shuffle_forward_launcher(
+    const float* x,
+    float* output,
+    int N, int C, int H, int W, int groups,
+    long long stride_n, long long stride_c, long long stride_h, long long stride_w,
+    cudaStream_t stream);
+
+// PyTorch wrapper
+torch::Tensor channel_shuffle_forward(torch::Tensor x, int64_t groups) {
+    // Input validation
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D (N, C, H, W)");
+    TORCH_CHECK(groups > 0, "groups must be positive");
+    int C = x.size(1);
+    TORCH_CHECK(C % groups == 0, "C must be divisible by groups");
+
+    // Retrieve dimensions
+    int N = x.size(0);
+    int H = x.size(2);
+    int W = x.size(3);
+
+    // Get input strides in elements (not bytes)
+    auto strides = x.strides(); // in elements
+    long long stride_n = strides[0];
+    long long stride_c = strides[1];
+    long long stride_h = strides[2];
+    long long stride_w = strides[3];
+
+    // Output tensor: same shape as input, contiguous
+    auto output = torch::empty_like(x); // empty_like preserves dtype, device, shape, and strides may be preserved
+    // Ensure output is contiguous as expected by kernel
+    output = output.contiguous();
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    channel_shuffle_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C, H, W, (int)groups,
+        stride_n, stride_c, stride_h, stride_w,
+        stream
+    );
+
+    // Check for kernel errors (optional but recommended)
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "Kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// Registration function
+void register_channel_shuffle(pybind11::module& m) {
+    m.def("channel_shuffle_forward", &channel_shuffle_forward,
+          "Channel shuffle forward",
+          py::arg("x"),
+          py::arg("groups"));
+}
+
+// Auto-register
+REGISTER_BINDING(channel_shuffle, register_channel_shuffle);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,19 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, num_channels, groups, block_size):
+        super().__init__()
+        self.num_channels = num_channels
+        self.groups = groups
+        self.block_size = block_size
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return cuda_extension.channel_shuffle_forward(x, self.groups)
+
+    def debug_forward(self, *inputs):
+        x = inputs[0]
+        output = cuda_extension.channel_shuffle_forward(x, self.groups)
+        yield 'step_001', output
