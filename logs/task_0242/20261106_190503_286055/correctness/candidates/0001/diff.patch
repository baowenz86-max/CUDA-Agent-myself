--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,122 @@
+#include <cuda_runtime.h>
+
+// ============================================================================
+// relu_transform: elementwise ReLU, output = max(input, 0)
+// Supports shape [512, 512, 512] float32 contiguous tensor.
+// ============================================================================
+__global__ void relu_kernel(const float* __restrict__ input,
+                            float* __restrict__ output,
+                            long long numel) {
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (long long i = idx; i < numel; i += stride) {
+        float val = input[i];
+        output[i] = val > 0.0f ? val : 0.0f;
+    }
+}
+
+// ============================================================================
+// smooth_l1_loss_mean_zero: computes mean over all elements of
+//   if |z| < 1: 0.5 * z^2
+//   else: |z| - 0.5
+// where z is input element, target is zero, beta=1.0, reduction=mean.
+// Output is scalar tensor (numel=1).
+// ============================================================================
+__global__ void smooth_l1_partial_sum_kernel(const float* __restrict__ input,
+                                             float* __restrict__ partial_sums,
+                                             long long numel) {
+    extern __shared__ float sdata[];
+    long long tid = threadIdx.x;
+    long long idx = blockIdx.x * (long long)blockDim.x + tid;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    float local_sum = 0.0f;
+    for (long long i = idx; i < numel; i += stride) {
+        float z = input[i];
+        float abs_z = fabsf(z);
+        float loss = (abs_z < 1.0f) ? 0.5f * z * z : abs_z - 0.5f;
+        local_sum += loss;
+    }
+
+    // Block-level reduction using shared memory
+    sdata[tid] = local_sum;
+    __syncthreads();
+    for (unsigned int s = blockDim.x / 2; s > 0; s >>= 1) {
+        if (tid < s) {
+            sdata[tid] += sdata[tid + s];
+        }
+        __syncthreads();
+    }
+
+    if (tid == 0) {
+        partial_sums[blockIdx.x] = sdata[0];
+    }
+}
+
+__global__ void final_reduce_mean_kernel(const float* __restrict__ partial_sums,
+                                         float* __restrict__ output,
+                                         int num_blocks,
+                                         long long total_elements) {
+    extern __shared__ float sdata[];
+    unsigned int tid = threadIdx.x;
+    float sum = 0.0f;
+    for (int i = tid; i < num_blocks; i += blockDim.x) {
+        sum += partial_sums[i];
+    }
+    sdata[tid] = sum;
+    __syncthreads();
+    for (unsigned int s = blockDim.x / 2; s > 0; s >>= 1) {
+        if (tid < s) {
+            sdata[tid] += sdata[tid + s];
+        }
+        __syncthreads();
+    }
+    if (tid == 0) {
+        output[0] = sdata[0] / static_cast<float>(total_elements);
+    }
+}
+
+// ============================================================================
+// Launchers with C-linkage
+// ============================================================================
+extern "C" void relu_transform_launcher(const float* input,
+                                         float* output,
+                                         long long numel,
+                                         cudaStream_t stream) {
+    const int block_size = 256;
+    long long grid_size = (numel + block_size - 1) / block_size;
+    if (grid_size > 2147483647LL) {
+        grid_size = 2147483647LL;
+    }
+    relu_kernel<<<(unsigned int)grid_size, block_size, 0, stream>>>(
+        input, output, numel);
+}
+
+extern "C" void smooth_l1_loss_mean_zero_launcher(const float* input,
+                                                  float* output,
+                                                  long long numel,
+                                                  cudaStream_t stream) {
+    // Configuration for partial sum kernel
+    const int block_size = 256;
+    int grid_size = (int)((numel + block_size - 1) / block_size);
+    if (grid_size > 65535) {
+        grid_size = 65535;  // cap grid size for manageable partial sum count
+    }
+
+    // Allocate partial sums on device
+    float* d_partial_sums = nullptr;
+    cudaMalloc(&d_partial_sums, grid_size * sizeof(float));
+
+    // Launch partial sum kernel with shared memory for block reduction
+    size_t shared_mem = block_size * sizeof(float);
+    smooth_l1_partial_sum_kernel<<<grid_size, block_size, shared_mem, stream>>>(
+        input, d_partial_sums, numel);
+
+    // Launch final reduction kernel to combine partial sums and compute mean
+    int final_block_size = 256;
+    size_t final_shared_mem = final_block_size * sizeof(float);
+    final_reduce_mean_kernel<<<1, final_block_size, final_shared_mem, stream>>>(
+        d_partial_sums, output, grid_size, numel);
+
+    // Free temporary buffer after kernel completion (stream ordered)
+    cudaFree(d_partial_sums);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,64 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void relu_transform_launcher(const float* input,
+                                         float* output,
+                                         long long numel,
+                                         cudaStream_t stream);
+
+extern "C" void smooth_l1_loss_mean_zero_launcher(const float* input,
+                                                   float* output,
+                                                   long long numel,
+                                                   cudaStream_t stream);
+
+// Helper to validate common requirements
+static void validate_input(const torch::Tensor& x, const char* op_name) {
+    TORCH_CHECK(x.is_cuda(), op_name, ": input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, op_name, ": input must be float32");
+    TORCH_CHECK(x.is_contiguous(), op_name, ": input must be contiguous");
+    TORCH_CHECK(x.dim() == 3 && x.size(0) == 512 && x.size(1) == 512 && x.size(2) == 512,
+                op_name, ": expected shape [512, 512, 512]");
+}
+
+// relu_transform: elementwise ReLU
+torch::Tensor relu_transform(torch::Tensor x) {
+    validate_input(x, "relu_transform");
+    auto output = torch::empty_like(x);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    relu_transform_launcher(x.data_ptr<float>(),
+                            output.data_ptr<float>(),
+                            static_cast<long long>(x.numel()),
+                            stream);
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "relu_transform kernel launch failed: ", cudaGetErrorString(err));
+    return output;
+}
+
+// smooth_l1_loss_mean_zero: mean smooth L1 loss vs zero targets
+torch::Tensor smooth_l1_loss_mean_zero(torch::Tensor x) {
+    validate_input(x, "smooth_l1_loss_mean_zero");
+    auto output = torch::empty({}, x.options());
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    smooth_l1_loss_mean_zero_launcher(x.data_ptr<float>(),
+                                      output.data_ptr<float>(),
+                                      static_cast<long long>(x.numel()),
+                                      stream);
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "smooth_l1_loss_mean_zero kernel launch failed: ", cudaGetErrorString(err));
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("relu_transform", &relu_transform,
+          "Elementwise ReLU (max(x, 0))",
+          pybind11::arg("x"));
+    m.def("smooth_l1_loss_mean_zero", &smooth_l1_loss_mean_zero,
+          "Mean smooth L1 loss between x and zero",
+          pybind11::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,20 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x):
+        x = cuda_extension.relu_transform(x)
+        x = cuda_extension.smooth_l1_loss_mean_zero(x)
+        return x
+
+    def debug_forward(self, x):
+        y = cuda_extension.relu_transform(x)
+        yield ('step_001', y)
+        loss = cuda_extension.smooth_l1_loss_mean_zero(y)
+        yield ('step_002', loss)
+        yield ('step_003', loss)
