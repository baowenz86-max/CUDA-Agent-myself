--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,55 @@
+// CUDA kernel and launcher for custom_stack_relu
+// Implements torch.stack([x] * num_repeats, dim=dim) followed by relu.
+// Input: float32 CUDA tensor (logically contiguous, handled by binding)
+// Output: float32 CUDA tensor with inserted dimension at dim.
+// No torch/ATen dependencies.
+
+#include <cuda_runtime.h>
+
+// Kernel: each thread computes one output element, grid-stride loop.
+// We flatten the output dimensions as: outer * num_repeats * inner,
+// where outer = product of dims before dim, inner = product of dims after dim.
+// For each output index, we map back to input index using the insertion rule.
+__global__ void stack_relu_kernel(const float* __restrict__ input,
+                                  float* __restrict__ output,
+                                  int64_t total_output,
+                                  int64_t outer,
+                                  int64_t inner,
+                                  int64_t num_repeats) {
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t idx = blockIdx.x * blockDim.x + threadIdx.x; idx < total_output; idx += stride) {
+        int64_t out_idx = idx;
+        int64_t outer_idx = out_idx / (num_repeats * inner);
+        int64_t rem = out_idx % (num_repeats * inner);
+        // repeat_idx not needed for input mapping, but can be used if needed
+        // int64_t repeat_idx = rem / inner;
+        int64_t inner_idx = rem % inner;
+        int64_t input_idx = outer_idx * inner + inner_idx;
+        float val = input[input_idx];
+        output[out_idx] = fmaxf(val, 0.0f);
+    }
+}
+
+// Launcher exposed to binding layer.
+// input and output must be valid CUDA pointers to float32 memory.
+// outer, inner, num_repeats are derived from input shape and dim.
+// total_output = outer * num_repeats * inner.
+// stream is the CUDA stream to launch on.
+extern "C" void custom_stack_relu_launcher(const float* input,
+                                          float* output,
+                                          int64_t outer,
+                                          int64_t inner,
+                                          int64_t num_repeats,
+                                          cudaStream_t stream) {
+    int64_t total_output = outer * num_repeats * inner;
+    if (total_output <= 0) return;
+
+    const int block_size = 256;
+    int64_t grid_size = (total_output + block_size - 1) / block_size;
+    // Limit grid size to avoid exceeding max grid dimension (2^31-1)
+    if (grid_size > 2147483647LL) {
+        grid_size = 2147483647LL;
+    }
+    stack_relu_kernel<<<(unsigned int)grid_size, block_size, 0, stream>>>(
+        input, output, total_output, outer, inner, num_repeats);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,73 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declaration of launcher from custom_ops.cu
+extern "C" void custom_stack_relu_launcher(
+    const float* input,
+    float* output,
+    int64_t outer,
+    int64_t inner,
+    int64_t num_repeats,
+    cudaStream_t stream);
+
+// Wrapper function: torch.stack along dim followed by relu
+torch::Tensor custom_stack_relu(torch::Tensor x, int64_t dim, int64_t num_repeats) {
+    TORCH_CHECK(x.is_cuda(), "Input tensor must be on CUDA");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input tensor must be float32");
+    TORCH_CHECK(x.dim() > 0, "Input tensor must have at least one dimension");
+
+    int64_t ndim = x.dim();
+    // Normalize dim to [0, ndim]
+    if (dim < 0) dim += ndim + 1;
+    TORCH_CHECK(dim >= 0 && dim <= ndim, "dim out of range for stacking");
+
+    // Calculate outer and inner sizes
+    int64_t outer = 1;
+    for (int64_t i = 0; i < dim; ++i) outer *= x.size(i);
+    int64_t inner = 1;
+    for (int64_t i = dim; i < ndim; ++i) inner *= x.size(i);
+
+    // Build output shape: insert num_repeats at dim
+    std::vector<int64_t> output_shape;
+    output_shape.reserve(ndim + 1);
+    for (int64_t i = 0; i < dim; ++i) output_shape.push_back(x.size(i));
+    output_shape.push_back(num_repeats);
+    for (int64_t i = dim; i < ndim; ++i) output_shape.push_back(x.size(i));
+
+    // Allocate output tensor (contiguous, float32, on same device)
+    auto output = torch::empty(output_shape, x.options());
+
+    // Ensure input is contiguous; if not, make it contiguous
+    auto x_contig = x.contiguous();
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    custom_stack_relu_launcher(
+        x_contig.data_ptr<float>(),
+        output.data_ptr<float>(),
+        outer,
+        inner,
+        num_repeats,
+        stream
+    );
+
+    // Check for CUDA errors after launch (optional but good practice)
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// Registration function
+void register_custom_stack_relu(pybind11::module& m) {
+    m.def("custom_stack_relu", &custom_stack_relu,
+          "Stack tensor along dim and apply ReLU",
+          py::arg("x"), py::arg("dim"), py::arg("num_repeats"));
+}
+
+REGISTER_BINDING(custom_stack_relu, register_custom_stack_relu);
