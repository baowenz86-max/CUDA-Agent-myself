    "model_new.py": "import torch\nimport torch.nn as nn\nimport cuda_extension\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, input_size, hidden_size, output_size, scale_factor):\n        super().__init__()\n        self.input_size = input_size\n        self.hidden_size = hidden_size\n        self.output_size = output_size\n        self.scale_factor = scale_factor\n        self.weight = nn.Parameter(torch.randn(hidden_size, input_size))\n        self.bias = nn.Parameter(torch.randn(hidden_size))\n\n    def forward(self, x):\n        # Step 1: x = torch.addmm(self.bias, x, self.weight.t())\n        # Custom op: addmm_forward(bias, mat1, mat2) -> output\n        #   bias: [hidden_size]\n        #   mat1: x [batch_size, input_size]\n        #   mat2: weight [hidden_size, input_size] (i.e., original weight, no transpose)\n        # The kernel computes A * B directly, equivalent to A * weight.t() when B=weight\n        x = cuda_extension.addmm_forward(self.bias, x, self.weight)\n\n        # Step 2: torch.unsqueeze(x, 0)\n        x = cuda_extension.unsqueeze_forward(x, 0)\n\n        # Step 3: F.interpolate(x, scale_factor=self.scale_factor, mode='linear', align_corners=False)\n        x = cuda_extension.interpolate_linear_forward(x, self.scale_factor)\n\n        return x\n\n    def debug_forward(self, x):\n        # Step 1\n        x = cuda_extension.addmm_forward(self.bias, x, self.weight)\n        yield 'step_001', x\n\n        # Step 2\n        x = cuda_extension.unsqueeze_forward(x, 0)\n        yield 'step_002', x\n\n        # Step 3\n        x = cuda_extension.interpolate_linear_forward(x, self.scale_factor)\n        yield 'step_003', x\n\n        # Final return checkpoint\n        yield 'step_004', x\n",
    "kernels/custom_ops.cu": "#include <cuda_runtime.h>\n#include <float.h>\n\n// -----------------------------------------------------------------------------\n// Kernel 1: AddMM forward\n// Computes C = bias + A * B\n// A is [M, K], B is [K, N] (i.e., self.weight with shape [hidden_size, input_size],\n// but for the multiplication we treat it as [K, N] where K=input_size, N=hidden_size).\n// Output C is [M, N]\n// bias is [N]\n// All tensors are float32, contiguous.\n// -----------------------------------------------------------------------------\n__global__ void addmm_kernel(const float* __restrict__ A,\n                             const float* __restrict__ B,\n                             const float* __restrict__ bias,\n                             float* __restrict__ C,\n                             int M, int N, int K) {\n    int total = M * N;\n    int tid = blockIdx.x * blockDim.x + threadIdx.x;\n    int stride = blockDim.x * gridDim.x;\n    for (int idx = tid; idx < total; idx += stride) {\n        int row = idx / N;\n        int col = idx % N;\n        float sum = bias[col];\n        for (int k = 0; k < K; ++k) {\n            // B is [K, N], so element B[k * N + col]\n            sum += A[row * K + k] * B[k * N + col];\n        }\n        C[idx] = sum;\n    }\n}\n\n// Launcher for addmm\n// Inputs: bias [N], A [M,K], B [K,N]; Output: C [M,N]\nextern \"C\" void addmm_forward_launcher(const float* bias,\n                                       const float* A,\n                                       const float* B,\n                                       float* C,\n                                       int M, int N, int K,\n                                       cudaStream_t stream) {\n    if (M <= 0 || N <= 0 || K <= 0) return;\n    int total = M * N;\n    const int threads = 256;\n    int blocks = (total + threads - 1) / threads;\n    if (blocks > 65535) blocks = 65535;\n    addmm_kernel<<<blocks, threads, 0, stream>>>(A, B, bias, C, M, N, K);\n}\n\n// -----------------------------------------------------------------------------\n// Kernel 2: Unsqueeze forward (adds a dimension at specified position, but here only dim=0 is used)\n// Input shape: [M, N], output shape: [1, M, N]. Data is copied.\n// -----------------------------------------------------------------------------\n__global__ void unsqueeze_copy_kernel(const float* __restrict__ input,\n                                      float* __restrict__ output,\n                                      int total_elements) {\n    int tid = blockIdx.x * blockDim.x + threadIdx.x;\n    int stride = blockDim.x * gridDim.x;\n    for (int i = tid; i < total_elements; i += stride) {\n        output[i] = input[i];\n    }\n}\n\nextern \"C\" void unsqueeze_forward_launcher(const float* input,\n                                           float* output,\n                                           int total_elements,\n                                           int dim,\n                                           cudaStream_t stream) {\n    if (total_elements <= 0) return;\n    const int threads = 256;\n    int blocks = (total_elements + threads - 1) / threads;\n    if (blocks > 65535) blocks = 65535;\n    unsqueeze_copy_kernel<<<blocks, threads, 0, stream>>>(input, output, total_elements);\n}\n\n// -----------------------------------------------------------------------------\n// Kernel 3: Linear interpolation for 3D input [1, M, N] with scale_factor=2\n// Output shape [1, M, 2*N]\n// Align_corners=False: out_x = (in_x + 0.5) * scale - 0.5; clamp to [0, N-1]\n// scale = input_width / output_width\n// -----------------------------------------------------------------------------\n__global__ void interpolate_linear_kernel(const float* __restrict__ input,\n                                          float* __restrict__ output,\n                                          int input_height,   // M\n                                          int input_width,    // N\n                                          int output_width,   // out_N\n                                          float scale) {\n    int total = input_height * output_width; // batch=1\n    int tid = blockIdx.x * blockDim.x + threadIdx.x;\n    int stride = blockDim.x * gridDim.x;\n    for (int idx = tid; idx < total; idx += stride) {\n        int m = idx / output_width;\n        int out_x = idx % output_width;\n        float src_x_f = (static_cast<float>(out_x) + 0.5f) * scale - 0.5f;\n        src_x_f = fmaxf(0.0f, fminf(src_x_f, static_cast<float>(input_width - 1)));\n        int x0 = static_cast<int>(floorf(src_x_f));\n        int x1 = min(x0 + 1, input_width - 1);\n        float dx = src_x_f - static_cast<float>(x0);\n        const float* row_ptr = input + m * input_width;\n        float val = row_ptr[x0] * (1.0f - dx) + row_ptr[x1] * dx;\n        output[idx] = val;\n    }\n}\n\nextern \"C\" void interpolate_linear_forward_launcher(const float* input,\n                                                    float* output,\n                                                    int input_height,\n                                                    int input_width,\n                                                    int output_width,\n                                                    float scale_factor,\n                                                    cudaStream_t stream) {\n    if (input_height <= 0 || input_width <= 0 || output_width <= 0) return;\n    int total = input_height * output_width;\n    const int threads = 256;\n    int blocks = (total + threads - 1) / threads;\n    if (blocks > 65535) blocks = 65535;\n    float scale = static_cast<float>(input_width) / static_cast<float>(output_width);\n    interpolate_linear_kernel<<<blocks, threads, 0, stream>>>(\n        input, output, input_height, input_width, output_width, scale);\n}\n",
    "kernels/custom_ops_binding.cpp": "#include <torch/types.h>\n#include <torch/csrc/utils/pybind.h>\n#include <cuda_runtime.h>\n#include <c10/cuda/CUDAStream.h>\n#include \"../binding_registry.h\"\n\nextern \"C\" void addmm_forward_launcher(const float* bias,\n                                       const float* A,\n                                       const float* B,\n                                       float* C,\n                                       int M, int N, int K,\n                                       cudaStream_t stream);\n\nextern \"C\" void unsqueeze_forward_launcher(const float* input,\n                                           float* output,\n                                           int total_elements,\n                                           int dim,\n                                           cudaStream_t stream);\n\nextern \"C\" void interpolate_linear_forward_launcher(const float* input,\n                                                    float* output,\n                                                    int input_height,\n                                                    int input_width,\n                                                    int output_width,\n                                                    float scale_factor,\n                                                    cudaStream_t stream);\n\ntorch::Tensor addmm_forward(torch::Tensor bias, torch::Tensor mat1, torch::Tensor mat2) {\n    TORCH_CHECK(bias.is_cuda(), \"bias must be a CUDA tensor\");\n    TORCH_CHECK(mat1.is_cuda(), \"mat1 must be a CUDA tensor\");\n    TORCH_CHECK(mat2.is_cuda(), \"mat2 must be a CUDA tensor\");\n    TORCH_CHECK(bias.is_contiguous(), \"bias must be contiguous\");\n    TORCH_CHECK(mat1.is_contiguous(), \"mat1 must be contiguous\");\n    TORCH_CHECK(mat2.is_contiguous(), \"mat2 must be contiguous\");\n    TORCH_CHECK(bias.dtype() == torch::kFloat32, \"bias must be float32\");\n    TORCH_CHECK(mat1.dtype() == torch::kFloat32, \"mat1 must be float32\");\n    TORCH_CHECK(mat2.dtype() == torch::kFloat32, \"mat2 must be float32\");\n    TORCH_CHECK(bias.dim() == 1, \"bias must be 1D\");\n    TORCH_CHECK(mat1.dim() == 2, \"mat1 must be 2D\");\n    TORCH_CHECK(mat2.dim() == 2, \"mat2 must be 2D\");\n    int N = bias.size(0);\n    int M = mat1.size(0);\n    int K = mat1.size(1);\n    // mat2 should be [K, N] now\n    TORCH_CHECK(mat2.size(0) == K && mat2.size(1) == N,\n                \"mat2 must have shape [K, N] = [input_size, hidden_size]\");\n    auto C = torch::empty({M, N}, mat1.options());\n    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n    addmm_forward_launcher(bias.data_ptr<float>(),\n                           mat1.data_ptr<float>(),\n                           mat2.data_ptr<float>(),\n                           C.data_ptr<float>(),\n                           M, N, K,\n                           stream);\n    return C;\n}\n\ntorch::Tensor unsqueeze_forward(torch::Tensor input, int64_t dim) {\n    TORCH_CHECK(input.is_cuda(), \"input must be a CUDA tensor\");\n    TORCH_CHECK(input.is_contiguous(), \"input must be contiguous\");\n    TORCH_CHECK(input.dtype() == torch::kFloat32, \"input must be float32\");\n    TORCH_CHECK(dim == 0, \"only dim=0 is supported\");\n    auto output = torch::empty_like(input);\n    int total_elements = input.numel();\n    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n    unsqueeze_forward_launcher(input.data_ptr<float>(),\n                               output.data_ptr<float>(),\n                               total_elements,\n                               static_cast<int>(dim),\n                               stream);\n    std::vector<int64_t> out_shape;\n    out_shape.push_back(1);\n    for (auto s : input.sizes()) out_shape.push_back(s);\n    return output.view(out_shape);\n}\n\ntorch::Tensor interpolate_linear_forward(torch::Tensor input, double scale_factor) {\n    TORCH_CHECK(input.is_cuda(), \"input must be a CUDA tensor\");\n    TORCH_CHECK(input.is_contiguous(), \"input must be contiguous\");\n    TORCH_CHECK(input.dtype() == torch::kFloat32, \"input must be float32\");\n    TORCH_CHECK(input.dim() == 3, \"input must be 3D [1, M, N]\");\n    TORCH_CHECK(input.size(0) == 1, \"batch dimension must be 1 for this task\");\n    int64_t M = input.size(1);\n    int64_t N = input.size(2);\n    int64_t out_N = static_cast<int64_t>(N * scale_factor);\n    TORCH_CHECK(out_N > 0, \"output width must be positive\");\n    auto output = torch::empty({1, M, out_N}, input.options());\n    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n    interpolate_linear_forward_launcher(input.data_ptr<float>(),\n                                        output.data_ptr<float>(),\n                                        static_cast<int>(M),\n                                        static_cast<int>(N),\n                                        static_cast<int>(out_N),\n                                        static_cast<float>(scale_factor),\n                                        stream);\n    return output;\n}\n\nvoid register_custom_ops(pybind11::module& m) {\n    m.def(\"addmm_forward\", &addmm_forward, \"AddMM forward\",\n          py::arg(\"bias\"), py::arg(\"mat1\"), py::arg(\"mat2\"));\n    m.def(\"unsqueeze_forward\", &unsqueeze_forward, \"Unsqueeze forward\",\n          py::arg(\"input\"), py::arg(\"dim\"));\n    m.def(\"interpolate_linear_forward\", &interpolate_linear_forward, \"Linear interpolation forward\",\n          py::arg(\"input\"), py::arg(\"scale_factor\"));\n}\n\nREGISTER_BINDING(custom_ops, register_custom_ops);\n"
