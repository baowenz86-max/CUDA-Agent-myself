{
  "operators": [
    {
      "name": "custom_hardtanh",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference step_001 output",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "min_val",
          "kind": "float",
          "optional": true,
          "default": -1.0,
          "nullable": false
        },
        {
          "name": "max_val",
          "kind": "float",
          "optional": true,
          "default": 1.0,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input x"
      },
      "semantics": [
        "对应参考 self.hardtanh(x)，默认 min_val=-1.0, max_val=1.0。",
        "对每个元素执行 clip：min(max(x, min_val), max_val)。",
        "输入和输出均为 CUDA float32 tensor，shape 不变。"
      ]
    },
    {
      "name": "custom_slice_last_dim",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, C, D, H, W, 1]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "index",
          "kind": "int",
          "optional": true,
          "default": 0,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[B, C, D, H, W]"
      },
      "semantics": [
        "对应参考 x[..., 0]，移除最后一个维度（大小为 1）。",
        "输出 shape 为 [B, C, D, H, W]，数据与输入在 index=0 的切片一致。",
        "输入必须为 CUDA float32 tensor，且最后一维大小为 1（本任务固定）。"
      ]
    },
    {
      "name": "custom_instance_norm_3d",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, C, D, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "optional": true,
          "default": 1e-05,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input x"
      },
      "semantics": [
        "对应参考 self.instance_norm(x)，其中 affine=False, track_running_stats=False。",
        "对每个样本和每个通道，在 D,H,W 三维上计算均值和方差，然后归一化。",
        "归一化公式：(x - mean) / sqrt(var + eps)。",
        "本任务中 C=1，因此对每个样本的整个空间维度进行归一化。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.hardtanh(x)",
      "semantics": [
        "对输入 x 应用 hardtanh 激活，即 clip 到 [-1, 1]。",
        "输入 shape [1,1,512,90,90,1]，输出 shape 相同。",
        "输出 device 为 cuda，dtype float32。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = x[..., 0]",
      "semantics": [
        "移除最后一个维度，输出 shape [1,1,512,90,90]。",
        "数据为原张量最后一维索引 0 的切片。",
        "输出 device 为 cuda，dtype float32。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = self.instance_norm(x)",
      "semantics": [
        "对 [1,1,512,90,90] 的输入应用 InstanceNorm3d。",
        "由于 affine=False，不学习仿射参数；track_running_stats=False，不使用运行统计量。",
        "对每个样本和通道计算空间维度的均值和方差，进行归一化。",
        "输出 shape 不变，device 为 cuda，dtype float32。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return x",
      "semantics": [
        "返回最终归一化结果。",
        "与 step_003 输出相同。"
      ]
    }
  ]
}