+// Launcher for view_as_complex
+extern "C" void view_as_complex_launcher(
+    const float* input,
+    float2* output,
+    long long total_complex,
+    cudaStream_t stream) {
+    int threads = 256;
+    int blocks = (int)((total_complex + threads - 1) / threads);
+    if (blocks == 0) return; // no elements
+    view_as_complex_kernel<<<blocks, threads, 0, stream>>>(input, output, total_complex);
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        printf("view_as_complex kernel launch failed: %s\n", cudaGetErrorString(err));
     }
 }
 
