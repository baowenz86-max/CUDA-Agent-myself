+#define CUBLAS_CHECK(call) do { \
+    cublasStatus_t status = call; \
+    if (status != CUBLAS_STATUS_SUCCESS) { \
+        printf("cuBLAS error at %s:%d\n", __FILE__, __LINE__); \
