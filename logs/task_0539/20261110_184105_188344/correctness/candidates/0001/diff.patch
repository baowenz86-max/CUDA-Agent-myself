--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,61 @@
+#include <cuda_runtime.h>
+
+// Kernel: sum over channel dimension (dim=1)
+// Input: x [N, C, H, W] contiguous float32
+// Output: out [N, H, W] float32
+__global__ void sum_dim1_kernel(const float* __restrict__ x,
+                                float* __restrict__ out,
+                                int N, int C, int H, int W) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = N * H * W;
+    int stride = blockDim.x * gridDim.x;
+    for (int i = idx; i < total; i += stride) {
+        int n = i / (H * W);
+        int rem = i % (H * W);
+        int h = rem / W;
+        int w = rem % W;
+        const float* base = x + n * C * H * W + h * W + w;
+        float sum = 0.0f;
+        #pragma unroll 4
+        for (int c = 0; c < C; ++c) {
+            sum += base[c * H * W];
+        }
+        out[i] = sum;
+    }
+}
+
+// Kernel: elementwise ReLU
+__global__ void relu_kernel(const float* __restrict__ x,
+                            float* __restrict__ out,
+                            int numel) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+    for (int i = idx; i < numel; i += stride) {
+        float val = x[i];
+        out[i] = val > 0.0f ? val : 0.0f;
+    }
+}
+
+// Launcher for sum_dim1_forward
+extern "C" void sum_dim1_launcher(const float* x,
+                                  float* out,
+                                  int N, int C, int H, int W,
+                                  cudaStream_t stream) {
+    int total = N * H * W;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    // Cap blocks to avoid exceeding grid limits; grid-stride loop handles rest
+    if (blocks > 65535) blocks = 65535;
+    sum_dim1_kernel<<<blocks, threads, 0, stream>>>(x, out, N, C, H, W);
+}
+
+// Launcher for relu_forward
+extern "C" void relu_launcher(const float* x,
+                               float* out,
+                               int numel,
+                               cudaStream_t stream) {
+    int threads = 256;
+    int blocks = (numel + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535;
+    relu_kernel<<<blocks, threads, 0, stream>>>(x, out, numel);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,73 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// 声明来自 custom_ops.cu 的 launcher
+extern "C" void sum_dim1_launcher(const float* x,
+                                  float* out,
+                                  int N, int C, int H, int W,
+                                  cudaStream_t stream);
+
+extern "C" void relu_launcher(const float* x,
+                               float* out,
+                               int numel,
+                               cudaStream_t stream);
+
+// sum_dim1_forward: 对输入 [N, C, H, W] 沿 dim=1 求和，输出 [N, H, W]
+torch::Tensor sum_dim1_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D [N, C, H, W]");
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+    TORCH_CHECK(N > 0 && C > 0 && H > 0 && W > 0, "All dimensions must be positive");
+
+    auto out = torch::empty({N, H, W}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    sum_dim1_launcher(x.data_ptr<float>(),
+                      out.data_ptr<float>(),
+                      static_cast<int>(N),
+                      static_cast<int>(C),
+                      static_cast<int>(H),
+                      static_cast<int>(W),
+                      stream);
+    TORCH_CHECK(cudaGetLastError() == cudaSuccess, "sum_dim1_launcher failed");
+
+    return out;
+}
+
+// relu_forward: 对输入逐元素应用 ReLU
+torch::Tensor relu_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+
+    auto out = torch::empty_like(x);
+    int64_t numel = x.numel();
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    relu_launcher(x.data_ptr<float>(),
+                  out.data_ptr<float>(),
+                  static_cast<int>(numel),
+                  stream);
+    TORCH_CHECK(cudaGetLastError() == cudaSuccess, "relu_launcher failed");
+
+    return out;
+}
+
+// 注册绑定
+void register_custom_ops(pybind11::module& m) {
+    m.def("sum_dim1_forward", &sum_dim1_forward, "Sum over dimension 1",
+          py::arg("x"));
+    m.def("relu_forward", &relu_forward, "ReLU activation",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,20 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x):
+        x = cuda_extension.sum_dim1_forward(x)
+        x = cuda_extension.relu_forward(x)
+        return x
+
+    def debug_forward(self, x):
+        x1 = cuda_extension.sum_dim1_forward(x)
+        yield 'step_001', x1
+        x2 = cuda_extension.relu_forward(x1)
+        yield 'step_002', x2
+        yield 'step_003', x2
