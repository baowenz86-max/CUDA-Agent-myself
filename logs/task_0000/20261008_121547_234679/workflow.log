#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>

#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

extern "C" void fused_bn_digamma_max_add_launcher(
    const float* x,
    const float* weight,
    const float* bias,
    const float* running_mean,
    const float* running_var,
    float eps,
    const float* parameter,
    int num_channels,
    int spatial_size,
    float* output,
    float* channel_max,
    float* global_max,
    cudaStream_t stream);

torch::Tensor fused_bn_digamma_max_add_forward(
    torch::Tensor x,
    torch::Tensor weight,
    torch::Tensor bias,
    torch::Tensor running_mean,
    torch::Tensor running_var,
    torch::Tensor parameter,
    double eps) {

    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
    TORCH_CHECK(weight.is_cuda() && weight.is_contiguous(), "weight must be contiguous CUDA tensor");
    TORCH_CHECK(bias.is_cuda() && bias.is_contiguous(), "bias must be contiguous CUDA tensor");
    TORCH_CHECK(running_mean.is_cuda() && running_mean.is_contiguous(), "running_mean must be contiguous CUDA tensor");
    TORCH_CHECK(running_var.is_cuda() && running_var.is_contiguous(), "running_var must be contiguous CUDA tensor");
    TORCH_CHECK(parameter.is_cuda() && parameter.is_contiguous(), "parameter must be contiguous CUDA tensor");

    const int num_channels = x.size(1);
    const int spatial_size = x.numel() / num_channels;

    auto output = torch::empty({num_channels}, x.options());
    auto channel_max = torch::empty({num_channels}, x.options());
    auto global_max = torch::empty({1}, x.options());

    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    fused_bn_digamma_max_add_launcher(
        x.data_ptr<float>(),
        weight.data_ptr<float>(),
        bias.data_ptr<float>(),
        running_mean.data_ptr<float>(),
        running_var.data_ptr<float>(),
        static_cast<float>(eps),
        parameter.data_ptr<float>(),
        num_channels,
        spatial_size,
        output.data_ptr<float>(),
        channel_max.data_ptr<float>(),
        global_max.data_ptr<float>(),
        stream);

    return output;
}

void register_fused_bn_digamma_max_add(pybind11::module& m) {
    m.def("fused_bn_digamma_max_add_forward", &fused_bn_digamma_max_add_forward,
          "Fused BatchNorm3d + digamma + max + parameter add",
          py::arg("x"),
          py::arg("weight"),
          py::arg("bias"),
          py::arg("running_mean"),
          py::arg("running_var"),
          py::arg("parameter"),
          py::arg("eps"));
}

REGISTER_BINDING(fused_bn_digamma_max_add, register_fused_bn_digamma_max_add);
