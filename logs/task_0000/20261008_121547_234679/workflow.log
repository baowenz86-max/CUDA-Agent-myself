===== kernels/fused_bn_digamma_max_add.cu =====
#include <cuda_runtime.h>
#include <cmath>

// Fused kernel for:
//   y = batch_norm(x)
//   y = digamma(y)
//   y = max(y) over all elements
//   y = y + parameter
//
// Input x: (N, C, D, H, W), float32, contiguous
// weight/bias/running_mean/running_var: (C,), float32
// parameter: (C,), float32
// Output: (C,), float32
//
// Strategy:
//   - One block per channel computes channel statistics and the channel max.
//   - Each block first reduces its channel slice to max of digamma(bn(x)).
//   - Block 0 then reduces per-channel maxima to a global scalar max.
//   - Finally one small kernel adds parameter to the global max.
//
// Numerical notes:
//   - BatchNorm inference uses running estimates: y = (x - mean) / sqrt(var + eps) * w + b
//   - digamma is computed with the standard asymptotic expansion for float.
//   - max over all elements is a scalar; output shape is (C,).

namespace {

__device__ __forceinline__ float digamma_float(float x) {
    // Use the asymptotic expansion for x >= 8, and recurrence for smaller x.
    // This is accurate enough for atol/rtol 1e-2.
    float result = 0.0f;
    while (x < 8.0f) {
        result -= 1.0f / x;
        x += 1.0f;
    }
    float inv = 1.0f / x;
    float inv2 = inv * inv;
    result += logf(x) - 0.5f * inv;
    result -= inv2 * (1.0f / 12.0f);
    result += inv2 * inv2 * (1.0f / 120.0f);
    result -= inv2 * inv2 * inv2 * (1.0f / 252.0f);
    return result;
}

__device__ __forceinline__ float warp_reduce_max(float val) {
    #pragma unroll
    for (int offset = 16; offset > 0; offset >>= 1) {
        val = fmaxf(val, __shfl_down_sync(0xffffffff, val, offset));
    }
    return val;
}

__global__ void channel_max_kernel(
    const float* __restrict__ x,
    const float* __restrict__ weight,
    const float* __restrict__ bias,
    const float* __restrict__ running_mean,
    const float* __restrict__ running_var,
    float eps,
    int spatial_size,
    float* __restrict__ channel_max_out) {

    const int c = blockIdx.x;
    const int tid = threadIdx.x;
    const int block_dim = blockDim.x;

    const float mean = running_mean[c];
    const float var = running_var[c];
    const float inv_std = rsqrtf(var + eps);
    const float w = weight[c];
    const float b = bias[c];

    const float* x_c = x + (size_t)c * spatial_size;

    float local_max = -CUDART_INF_F;

    for (int i = tid; i < spatial_size; i += block_dim) {
        float val = x_c[i];
        float bn = (val - mean) * inv_std * w + b;
        float dg = digamma_float(bn);
        local_max = fmaxf(local_max, dg);
    }

    // Block reduction
    __shared__ float smem[1024];
    smem[tid] = local_max;
    __syncthreads();

    for (int s = block_dim / 2; s > 32; s >>= 1) {
        if (tid < s) {
            smem[tid] = fmaxf(smem[tid], smem[tid + s]);
        }
        __syncthreads();
    }

    if (tid < 32) {
        float warp_val = smem[tid];
        warp_val = warp_reduce_max(warp_val);
        if (tid == 0) {
            channel_max_out[c] = warp_val;
        }
    }
}

__global__ void global_max_reduce_kernel(
    const float* __restrict__ channel_max,
    int num_channels,
    float* __restrict__ global_max_out) {

    __shared__ float smem[32];
    const int tid = threadIdx.x;

    float val = -CUDART_INF_F;
    for (int i = tid; i < num_channels; i += blockDim.x) {
        val = fmaxf(val, channel_max[i]);
    }

    smem[tid] = val;
    __syncthreads();

    if (tid < 32) {
        float warp_val = smem[tid];
        warp_val = warp_reduce_max(warp_val);
        if (tid == 0) {
            *global_max_out = warp_val;
        }
    }
}

__global__ void add_parameter_kernel(
    float global_max,
    const float* __restrict__ parameter,
    int num_channels,
    float* __restrict__ output) {

    const int i = blockIdx.x * blockDim.x + threadIdx.x;
    if (i < num_channels) {
        output[i] = global_max + parameter[i];
    }
}

} // namespace

extern "C" void fused_bn_digamma_max_add_launcher(
    const float* x,
    const float* weight,
    const float* bias,
    const float* running_mean,
    const float* running_var,
    float eps,
    const float* parameter,
    int num_channels,
    int spatial_size,
    float* output,
    float* channel_max,
    float* global_max,
    cudaStream_t stream) {

    const int block_size = 256;
    const int grid_size = num_channels;

    channel_max_kernel<<<grid_size, block_size, 0, stream>>>(
        x, weight, bias, running_mean, running_var, eps,
        spatial_size, channel_max);

    global_max_reduce_kernel<<<1, 32, 0, stream>>>(
        channel_max, num_channels, global_max);

    const int add_block = 32;
    const int add_grid = (num_channels + add_block - 1) / add_block;
    add_parameter_kernel<<<add_grid, add_block, 0, stream>>>(
        *global_max, parameter, num_channels, output);
}

===== kernels/fused_bn_digamma_max_add_binding.cpp =====
#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>

#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

// Launcher from .cu file
extern "C" void fused_bn_digamma_max_add_launcher(
    const float* x,
    const float* weight,
    const float* bias,
    const float* running_mean,
    const float* running_var,
    float eps,
    const float* parameter,
    int num_channels,
    int spatial_size,
    float* output,
    float* channel_max,
    float* global_max,
    cudaStream_t stream);

torch::Tensor fused_bn_digamma_max_add_forward(
    torch::Tensor x,
    torch::Tensor weight,
    torch::Tensor bias,
    torch::Tensor running_mean,
    torch::Tensor running_var,
    torch::Tensor parameter,
    double eps) {

    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
    TORCH_CHECK(weight.is_cuda() && weight.is_contiguous(), "weight must be contiguous CUDA tensor");
    TORCH_CHECK(bias.is_cuda() && bias.is_contiguous(), "bias must be contiguous CUDA tensor");
    TORCH_CHECK(running_mean.is_cuda() && running_mean.is_contiguous(), "running_mean must be contiguous CUDA tensor");
    TORCH_CHECK(running_var.is_cuda() && running_var.is_contiguous(), "running_var must be contiguous CUDA tensor");
    TORCH_CHECK(parameter.is_cuda() && parameter.is_contiguous(), "parameter must be contiguous CUDA tensor");

    const int num_channels = x.size(1);
    const int spatial_size = x.numel() / num_channels;

    auto output = torch::empty({num_channels}, x.options());
    auto channel_max = torch::empty({num_channels}, x.options());
    auto global_max = torch::empty({1}, x.options());

    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    fused_bn_digamma_max_add_launcher(
        x.data_ptr<float>(),
        weight.data_ptr<float>(),
        bias.data_ptr<float>(),
        running_mean.data_ptr<float>(),
        running_var.data_ptr<float>(),
        static_cast<float>(eps),
        parameter.data_ptr<float>(),
        num_channels,
        spatial_size,
        output.data_ptr<float>(),
        channel_max.data_ptr<float>(),
        global_max.data_ptr<float>(),
        stream);

    return output;
}

void register_fused_bn_digamma_max_add(pybind11::module& m) {
    m.def("fused_bn_digamma_max_add_forward", &fused_bn_digamma_max_add_forward,
          "Fused BatchNorm3d + digamma + max + parameter add",
          py::arg("x"),
          py::arg("weight"),
          py::arg("bias"),
          py::arg("running_mean"),
          py::arg("running_var"),
          py::arg("parameter"),
          py::arg("eps"));
}

REGISTER_BINDING(fused_bn_digamma_max_add, register_fused_bn_digamma_max_add);
