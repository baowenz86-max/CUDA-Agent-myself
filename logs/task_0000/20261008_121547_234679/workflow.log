import torch
import torch.nn as nn
import cuda_extension


class ModelNew(nn.Module):
    def __init__(self):
        super().__init__()
        self.batch_norm = nn.BatchNorm3d(10)
        self.parameter = nn.Parameter(torch.randn(10))

