===== 现有 CUDA/C++ kernel 文件 =====

===== kernels/fused_bn_digamma_max_add.cu =====
#include <cuda_runtime.h>
#include <cmath>
#include <limits>

namespace {

__device__ __forceinline__ float digamma_float(float x) {
    float result = 0.0f;
    while (x < 8.0f) {
        result -= 1.0f / x;
        x += 1.0f;
    }
    float inv = 1.0f / x;
    float inv2 = inv * inv;
    result += logf(x) - 0.5f * inv;
    result -= inv2 * (1.0f / 12.0f);
    result += inv2 * inv2 * (1.0f / 120.0f);
    result -= inv2 * inv2 * inv2 * (1.0f / 252.0f);
    return result;
}

__device__ __forceinline__ float warp_reduce_max(float val) {
    #pragma unroll
    for (int offset = 16; offset > 0; offset >>= 1) {
        val = fmaxf(val, __shfl_down_sync(0xffffffff, val, offset));
    }
    return val;
}

template <int BLOCK_SIZE>
__global__ void channel_max_kernel(
    const float* __restrict__ x,
    const float* __restrict__ weight,
    const float* __restrict__ bias,
    const float* __restrict__ running_mean,
    const float* __restrict__ running_var,
    float eps,
    int spatial_size,
    float* __restrict__ channel_max_out) {

    const int c = blockIdx.x;
    const int tid = threadIdx.x;

    const float mean = running_mean[c];
    const float var = running_var[c];
    const float inv_std = rsqrtf(var + eps);
    const float w = weight[c];
    const float b = bias[c];

    const float* x_c = x + (size_t)c * spatial_size;

    float local_max = -std::numeric_limits<float>::infinity();

    for (int i = tid; i < spatial_size; i += BLOCK_SIZE) {
        float val = x_c[i];
        float bn = (val - mean) * inv_std * w + b;
        float dg = digamma_float(bn);
        local_max = fmaxf(local_max, dg);
    }

    __shared__ float smem[BLOCK_SIZE];
    smem[tid] = local_max;
    __syncthreads();

    for (int s = BLOCK_SIZE / 2; s > 32; s >>= 1) {
        if (tid < s) {
            smem[tid] = fmaxf(smem[tid], smem[tid + s]);
        }
        __syncthreads();
    }

    if (tid < 32) {
        float warp_val = smem[tid];
        warp_val = warp_reduce_max(warp_val);
        if (tid == 0) {
            channel_max_out[c] = warp_val;
        }
    }
}

__global__ void global_max_reduce_kernel(
    const float* __restrict__ channel_max,
    int num_channels,
    float* __restrict__ global_max_out) {

    __shared__ float smem[32];
    const int tid = threadIdx.x;

    float val = -std::numeric_limits<float>::infinity();
    for (int i = tid; i < num_channels; i += blockDim.x) {
        val = fmaxf(val, channel_max[i]);
    }

    smem[tid] = val;
    __syncthreads();

    if (tid < 32) {
        float warp_val = smem[tid];
        warp_val = warp_reduce_max(warp_val);
        if (tid == 0) {
            *global_max_out = warp_val;
        }
    }
}

__global__ void add_parameter_kernel(
    float global_max,
    const float* __restrict__ parameter,
    int num_channels,
    float* __restrict__ output) {

    const int i = blockIdx.x * blockDim.x + threadIdx.x;
    if (i < num_channels) {
        output[i] = global_max + parameter[i];
    }
}

} // namespace

extern "C" void fused_bn_digamma_max_add_launcher(
    const float* x,
    const float* weight,
    const float* bias,
    const float* running_mean,
    const float* running_var,
    float eps,
    const float* parameter,
    int num_channels,
    int spatial_size,
    float* output,
    float* channel_max,
    float* global_max,
    cudaStream_t stream) {

    const int block_size = 256;
    const int grid_size = num_channels;

    channel_max_kernel<256><<<grid_size, block_size, 0, stream>>>(
        x, weight, bias, running_mean, running_var, eps,
        spatial_size, channel_max);

    global_max_reduce_kernel<<<1, 32, 0, stream>>>(
        channel_max, num_channels, global_max);

    const int add_block = 32;
    const int add_grid = (num_channels + add_block - 1) / add_block;
    add_parameter_kernel<<<add_grid, add_block, 0, stream>>>(
        *global_max, parameter, num_channels, output);
}

