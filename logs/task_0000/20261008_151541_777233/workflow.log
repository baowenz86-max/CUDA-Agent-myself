===== kernels/fused_bn_digamma_max.cu =====
#include <cuda_runtime.h>
#include <math_constants.h>
#include <cmath>

// Digamma function adapted from Cephes (float precision)
__device__ float digamma_impl(float x) {
    float p, q, nz, w, y;
    int negative = 0;

    if (x <= 0.0f) {
        negative = 1;
        p = floorf(x);
        if (p == x) {
            return CUDART_NAN_F;  // Modified: match PyTorch behavior of NaN for negative integers
        }
        float z = x - p;
        if (z != 0.5f) {
            float pi = 3.14159265358979323846f;
            y = pi / tanf(pi * z);
            x = 1.0f - x;
        } else {
            return 0.0f;
        }
    }

    nz = 0.0f;
    while (x < 6.0f) {
        nz -= 1.0f / x;
        x += 1.0f;
    }

    w = 1.0f / (x * x);
    p = (((((0.00008333333333333333f * w
             - 0.0001388888888888889f) * w
             + 0.00002143347050754458f) * w
             - 0.000003571428571428571f) * w
             + 0.0000011904761904761905f) * w
             - 0.000004761904761904762f) * w
             + 0.00002083333333333333f;
    p = (((p * w - 0.0007575757575757576f) * w
           + 0.008333333333333333f) * w
           - 0.08333333333333333f) * w;
    p = p + 0.5f * w;
    p = p - logf(x);
    p = -p;
    p = p + nz;
    if (negative) {
        p = p - y;
    }
    return p;
}

// Kernel 1: BatchNorm3d (eval mode) + digamma + block-level max reduction
__global__ void bn_digamma_block_max_kernel(
    const float* __restrict__ x,
    const float* __restrict__ weight,
    const float* __restrict__ bias,
    const float* __restrict__ running_mean,
    const float* __restrict__ running_var,
    float eps,
    float* __restrict__ block_max,
    int total_elems,
    int channels,
    int dhw)
{
    extern __shared__ float smem[];
    float* scale = smem;                 // channels floats
    float* shift = smem + channels;      // channels floats
    float* reduce = smem + 2 * channels; // blockDim.x floats for reduction

    int tid = threadIdx.x;
    int block_size = blockDim.x;

    // Compute per-channel scale and shift into shared memory
    for (int c = tid; c < channels; c += block_size) {
        float var = running_var[c] + eps;
        float inv_std = rsqrtf(var);
        float s = weight[c] * inv_std;
        scale[c] = s;
        shift[c] = bias[c] - running_mean[c] * s;
    }
    __syncthreads();

    float local_max = -CUDART_INF_F;

    int idx = blockIdx.x * block_size + tid;
    int stride = block_size * gridDim.x;

    for (int i = idx; i < total_elems; i += stride) {
        int c = (i / dhw) % channels;
        float val = x[i];
        float y = val * scale[c] + shift[c];
        float dig = digamma_impl(y);
        if (isnan(dig)) {
            local_max = CUDART_NAN_F;
            break;
        }
        if (dig > local_max) {
            local_max = dig;
        }
    }

    // Block-level reduction with NaN propagation
    reduce[tid] = local_max;
    __syncthreads();

    for (int s = block_size / 2; s > 0; s >>= 1) {
        if (tid < s) {
            float a = reduce[tid];
            float b = reduce[tid + s];
            if (isnan(a) || isnan(b)) {
                reduce[tid] = CUDART_NAN_F;
            } else if (b > a) {
                reduce[tid] = b;
            }
        }
        __syncthreads();
    }

    if (tid == 0) {
        block_max[blockIdx.x] = reduce[0];
    }
}

// Kernel 2: Final reduction of block maxima and addition of parameter
__global__ void final_reduce_add_kernel(
    const float* __restrict__ block_max,
    const float* __restrict__ parameter,
    float* __restrict__ output,
    int num_blocks,
    int out_size)
{
    extern __shared__ float smem[];
    float* reduce = smem;

    int tid = threadIdx.x;
    int block_size = blockDim.x;

    float local_max = -CUDART_INF_F;
    for (int i = tid; i < num_blocks; i += block_size) {
        float v = block_max[i];
        if (isnan(v)) {
            local_max = CUDART_NAN_F;
            break;
        }
        if (v > local_max) {
            local_max = v;
        }
    }
    reduce[tid] = local_max;
    __syncthreads();

    for (int s = block_size / 2; s > 0; s >>= 1) {
        if (tid < s) {
            float a = reduce[tid];
            float b = reduce[tid + s];
            if (isnan(a) || isnan(b)) {
                reduce[tid] = CUDART_NAN_F;
            } else if (b > a) {
                reduce[tid] = b;
            }
        }
        __syncthreads();
    }

    if (tid == 0) {
        float max_val = reduce[0];
        for (int i = 0; i < out_size; ++i) {
            output[i] = max_val + parameter[i];
        }
    }
}

extern "C" void fused_bn_digamma_max_launcher(
    const float* x,
    const float* weight,
    const float* bias,
    const float* running_mean,
    const float* running_var,
    float eps,
    const float* parameter,
    float* output,
    float* block_max,
    int total_elems,
    int channels,
    int dhw,
    int out_size,
    int num_blocks,
    cudaStream_t stream)
{
    const int block_size = 256;
    int smem_size1 = (2 * channels + block_size) * sizeof(float);
    bn_digamma_block_max_kernel<<<num_blocks, block_size, smem_size1, stream>>>(
        x, weight, bias, running_mean, running_var, eps, block_max,
        total_elems, channels, dhw);

    const int final_block_size = 256;
    int smem_size2 = final_block_size * sizeof(float);
    final_reduce_add_kernel<<<1, final_block_size, smem_size2, stream>>>(
        block_max, parameter, output, num_blocks, out_size);
}

