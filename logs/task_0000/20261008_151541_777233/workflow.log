extern "C" void fused_bn_digamma_max_launcher(
    const float* x,
    const float* weight,
    const float* bias,
    const float* running_mean,
    const float* running_var,
    float eps,
    const float* parameter,
    float* output,
    float* block_max,
    int total_elems,
    int channels,
    int dhw,
    int out_size,
    int num_blocks,
    cudaStream_t stream);

torch::Tensor fused_bn_digamma_max_forward(
    torch::Tensor x,
    torch::Tensor weight,
    torch::Tensor bias,
    torch::Tensor running_mean,
    torch::Tensor running_var,
    double eps,
    torch::Tensor parameter)
{
    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
    TORCH_CHECK(weight.is_cuda() && weight.is_contiguous() && weight.dtype() == torch::kFloat32,
                "weight must be contiguous float32 CUDA tensor");
    TORCH_CHECK(bias.is_cuda() && bias.is_contiguous() && bias.dtype() == torch::kFloat32,
                "bias must be contiguous float32 CUDA tensor");
    TORCH_CHECK(running_mean.is_cuda() && running_mean.is_contiguous() && running_mean.dtype() == torch::kFloat32,
                "running_mean must be contiguous float32 CUDA tensor");
    TORCH_CHECK(running_var.is_cuda() && running_var.is_contiguous() && running_var.dtype() == torch::kFloat32,
                "running_var must be contiguous float32 CUDA tensor");
    TORCH_CHECK(parameter.is_cuda() && parameter.is_contiguous() && parameter.dtype() == torch::kFloat32,
                "parameter must be contiguous float32 CUDA tensor");

    TORCH_CHECK(x.dim() == 5, "x must be 5D (N, C, D, H, W)");
    int N = x.size(0);
    int C = x.size(1);
    int D = x.size(2);
    int H = x.size(3);
    int W = x.size(4);
    int DHW = D * H * W;

    auto output = torch::empty_like(parameter);
    int total_elems = x.numel();
    int out_size = parameter.numel();

    const int block_size = 256;
    const int max_blocks = 2048;
    int needed_blocks = (total_elems + block_size - 1) / block_size;
    int num_blocks = std::min(needed_blocks, max_blocks);

    auto block_max = torch::empty({num_blocks}, x.options());
    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    fused_bn_digamma_max_launcher(
        x.data_ptr<float>(),
        weight.data_ptr<float>(),
        bias.data_ptr<float>(),
        running_mean.data_ptr<float>(),
        running_var.data_ptr<float>(),
        static_cast<float>(eps),
        parameter.data_ptr<float>(),
        output.data_ptr<float>(),
        block_max.data_ptr<float>(),
        total_elems,
        C,
        DHW,
        out_size,
        num_blocks,
        stream
    );

    return output;
}

void register_fused_bn_digamma_max(pybind11::module& m) {
    m.def("fused_bn_digamma_max", &fused_bn_digamma_max_forward,
          "Fused BatchNorm3d (eval) + digamma + max + add parameter");
}

