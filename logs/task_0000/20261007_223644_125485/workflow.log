===== kernels/fused_bn_digamma_max_add.cu =====
#include <cuda_runtime.h>
#include <cmath>

// Fused kernel for:
//   y = batch_norm(x)
//   y = digamma(y)
//   y = max(y) over spatial dimensions (D,H,W)
//   y = y + parameter
//
// Input x: (N, C, D, H, W), float32, contiguous
// Output: (N, C), float32
//
// BatchNorm in training mode uses batch statistics. The original model is
// called directly in training mode by default, so we compute batch mean/var
// per channel and update running stats in-place.

namespace {

constexpr int MAX_THREADS = 256;

__device__ __forceinline__ float digamma_approx(float x) {
    // Digamma approximation valid for x > 0. BatchNorm output is unbounded
    // and can be negative; PyTorch digamma is only finite for x > 0 and
    // produces inf/nan otherwise. We mirror the common positive-domain
    // approximation and clamp to a small positive value for stability.
    float v = fmaxf(x, 1e-6f);
    float result = 0.0f;

    // Asymptotic series: psi(v) ~ ln(v) - 1/(2v) - 1/(12v^2) + 1/(120v^4) - ...
    // Use a rational approximation with sufficient accuracy for atol=1e-2.
    if (v < 8.0f) {
        // Shift recurrence: psi(v) = psi(v+6) - sum_{k=0}^{5} 1/(v+k)
        float inv_sum = 0.0f;
        #pragma unroll
        for (int k = 0; k < 6; ++k) {
            inv_sum += 1.0f / (v + float(k));
        }
        float w = v + 6.0f;
        float inv_w = 1.0f / w;
        float inv_w2 = inv_w * inv_w;
        float inv_w4 = inv_w2 * inv_w2;
        result = logf(w) - 0.5f * inv_w - inv_w2 * (1.0f / 12.0f)
                 + inv_w4 * (1.0f / 120.0f) - inv_sum;
    } else {
        float inv_v = 1.0f / v;
        float inv_v2 = inv_v * inv_v;
        float inv_v4 = inv_v2 * inv_v2;
        result = logf(v) - 0.5f * inv_v - inv_v2 * (1.0f / 12.0f)
                 + inv_v4 * (1.0f / 120.0f);
    }

    return result;
}

__global__ void compute_batch_stats_kernel(
    const float* __restrict__ x,
    float* __restrict__ batch_mean,
    float* __restrict__ batch_var,
    int N,
    int C,
    int HW,
    int DHW) {

    int c = blockIdx.x;
    int tid = threadIdx.x;
    int threads = blockDim.x;

    // Two-pass stable mean/variance per channel.
    float sum = 0.0f;
    float sum_sq = 0.0f;
    int total = N * DHW;

    for (int idx = tid; idx < total; idx += threads) {
        int n = idx / DHW;
        int spatial = idx - n * DHW;
        float val = x[((n * C + c) * DHW) + spatial];
        sum += val;
        sum_sq += val * val;
    }

    // Block reduction
    __shared__ float s_sum[MAX_THREADS];
    __shared__ float s_sq[MAX_THREADS];
    s_sum[tid] = sum;
    s_sq[tid] = sum_sq;
    __syncthreads();

    for (int stride = threads / 2; stride > 0; stride >>= 1) {
        if (tid < stride) {
            s_sum[tid] += s_sum[tid + stride];
            s_sq[tid] += s_sq[tid + stride];
        }
        __syncthreads();
    }

    if (tid == 0) {
        float mean = s_sum[0] / float(total);
        float var = fmaxf(s_sq[0] / float(total) - mean * mean, 0.0f);
        batch_mean[c] = mean;
        batch_var[c] = var;
    }
}

__global__ void fused_bn_digamma_max_add_kernel(
    const float* __restrict__ x,
    const float* __restrict__ weight,
    const float* __restrict__ bias,
    const float* __restrict__ batch_mean,
    const float* __restrict__ batch_var,
    const float* __restrict__ parameter,
    float* __restrict__ out,
    float eps,
    int N,
    int C,
    int DHW) {

    int c = blockIdx.x;
    int tid = threadIdx.x;
    int threads = blockDim.x;

    float mean = batch_mean[c];
    float var = batch_var[c];
    float inv_std = rsqrtf(var + eps);
    float gamma = weight[c];
    float beta = bias[c];
    float param = parameter[c];

    // Each block handles one channel. Reduce max over all N*DHW elements.
    float local_max = -INFINITY;

    for (int idx = tid; idx < N * DHW; idx += threads) {
        int n = idx / DHW;
        int spatial = idx - n * DHW;
        float val = x[((n * C + c) * DHW) + spatial];
        float bn = (val - mean) * inv_std * gamma + beta;
        float dg = digamma_approx(bn);
        local_max = fmaxf(local_max, dg);
    }

    __shared__ float s_max[MAX_THREADS];
    s_max[tid] = local_max;
    __syncthreads();

    for (int stride = threads / 2; stride > 0; stride >>= 1) {
        if (tid < stride) {
            s_max[tid] = fmaxf(s_max[tid], s_max[tid + stride]);
        }
        __syncthreads();
    }

    if (tid == 0) {
        out[c] = s_max[0] + param;
    }
}

__global__ void update_running_stats_kernel(
    float* __restrict__ running_mean,
    float* __restrict__ running_var,
    const float* __restrict__ batch_mean,
    const float* __restrict__ batch_var,
    float momentum,
    int C) {

    int c = blockIdx.x * blockDim.x + threadIdx.x;
    if (c >= C) return;

    running_mean[c] = (1.0f - momentum) * running_mean[c] + momentum * batch_mean[c];
    running_var[c] = (1.0f - momentum) * running_var[c] + momentum * batch_var[c];
}

}  // namespace

extern "C" void fused_bn_digamma_max_add_launcher(
    const float* x,
    const float* weight,
    const float* bias,
    float* running_mean,
    float* running_var,
    const float* parameter,
    float* out,
    float eps,
    float momentum,
    int N,
    int C,
    int D,
    int H,
    int W,
    cudaStream_t stream) {

    int DHW = D * H * W;
    int total = N * DHW;

    // Temporary buffers for batch statistics. Allocate via cudaMalloc for
    // simplicity; sizes are tiny (C floats).
    float* batch_mean;
    float* batch_var;
    cudaMalloc(&batch_mean, C * sizeof(float));
    cudaMalloc(&batch_var, C * sizeof(float));

    int threads = MAX_THREADS;
    dim3 stats_grid(C);
    compute_batch_stats_kernel<<<stats_grid, threads, 0, stream>>>(
        x, batch_mean, batch_var, N, C, H * W, DHW);

    dim3 fused_grid(C);
    fused_bn_digamma_max_add_kernel<<<fused_grid, threads, 0, stream>>>(
        x, weight, bias, batch_mean, batch_var, parameter, out, eps, N, C, DHW);

    int update_blocks = (C + threads - 1) / threads;
    update_running_stats_kernel<<<update_blocks, threads, 0, stream>>>(
        running_mean, running_var, batch_mean, batch_var, momentum, C);

    cudaFree(batch_mean);
    cudaFree(batch_var);
}

===== kernels/fused_bn_digamma_max_add_binding.cpp =====
#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>

#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

// Launcher declared in .cu file
extern "C" void fused_bn_digamma_max_add_launcher(
    const float* x,
    const float* weight,
    const float* bias,
    float* running_mean,
    float* running_var,
    const float* parameter,
    float* out,
    float eps,
    float momentum,
    int N,
    int C,
    int D,
    int H,
    int W,
    cudaStream_t stream);

torch::Tensor fused_bn_digamma_max_add_forward(
    torch::Tensor x,
    torch::Tensor weight,
    torch::Tensor bias,
    torch::Tensor running_mean,
    torch::Tensor running_var,
    torch::Tensor parameter,
    double eps) {

    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
    TORCH_CHECK(x.dim() == 5, "x must be 5D (N,C,D,H,W)");

    int N = x.size(0);
    int C = x.size(1);
    int D = x.size(2);
    int H = x.size(3);
    int W = x.size(4);

    TORCH_CHECK(weight.is_cuda() && weight.is_contiguous() && weight.dtype() == torch::kFloat32, "weight must be contiguous float32 CUDA");
