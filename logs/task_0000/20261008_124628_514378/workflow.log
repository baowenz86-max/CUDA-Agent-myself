===== kernels/fused_bn_digamma_max.cu =====
#include <cuda_runtime.h>
#include <cfloat>
#include <math_constants.h>

#define BLOCK_SIZE 256
#define REDUCE_BLOCK_SIZE 256
#define FINAL_BLOCK_SIZE 1024
#define PI 3.14159265358979323846

__device__ float digammaf(float x) {
    double dx = (double)x;
    bool negative = false;
    double p, q, nz, y, w;

    if (dx <= 0.0) {
        negative = true;
        q = dx;
        p = floor(q);
        if (p == q) {
            if (dx == 0.0) {
                return -CUDART_INF_F;
            } else {
                return CUDART_NAN_F;
            }
        }
        nz = q - p;
        if (nz != 0.5) {
            if (nz > 0.5) {
                p += 1.0;
                nz = q - p;
            }
            nz = PI / tan(PI * nz);
        } else {
            nz = 0.0;
        }
        dx = 1.0 - dx;
    }

    y = 0.0;
    while (dx < 10.0) {
        y -= 1.0 / dx;
        dx += 1.0;
    }
    y += log(dx) - 0.5 / dx;
    w = 1.0 / (dx * dx);
    y += w * (1.0/12.0 - w * (1.0/120.0 - w * (1.0/252.0 - w * (1.0/240.0 - w * (1.0/132.0)))));

    if (negative) {
        y -= nz;
    }
    return (float)y;
}

__device__ float max_propagate_nan(float a, float b) {
    if (isnan(a) || isnan(b)) {
        return CUDART_NAN_F;
    }
    return fmaxf(a, b);
}

__global__ __launch_bounds__(BLOCK_SIZE)
void compute_channel_partial_sums_kernel(
    const float* __restrict__ input,
    double* __restrict__ partial_sums,
    double* __restrict__ partial_sumsq,
    int C,
    int slice_size,
    int blocks_per_slice,
    int total_blocks)
{
    int c = blockIdx.y;
    int n = blockIdx.z;
    int base = (n * C + c) * slice_size;

    double sum = 0.0;
    double sumsq = 0.0;

    for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < slice_size;
         i += blockDim.x * gridDim.x) {
        double val = (double)input[base + i];
        sum += val;
        sumsq += val * val;
    }

    __shared__ double s_sum[BLOCK_SIZE];
    __shared__ double s_sumsq[BLOCK_SIZE];
    s_sum[threadIdx.x] = sum;
    s_sumsq[threadIdx.x] = sumsq;
    __syncthreads();

    for (int stride = blockDim.x / 2; stride > 0; stride >>= 1) {
        if (threadIdx.x < stride) {
            s_sum[threadIdx.x] += s_sum[threadIdx.x + stride];
            s_sumsq[threadIdx.x] += s_sumsq[threadIdx.x + stride];
        }
        __syncthreads();
    }

    if (threadIdx.x == 0) {
        int block_lin = blockIdx.z * (gridDim.y * gridDim.x) +
                        blockIdx.y * gridDim.x + blockIdx.x;
        partial_sums[block_lin] = s_sum[0];
        partial_sumsq[block_lin] = s_sumsq[0];
    }
}

__global__ __launch_bounds__(REDUCE_BLOCK_SIZE)
void compute_stats_scale_shift_kernel(
    const double* partial_sums,
    const double* partial_sumsq,
    float* running_mean,
    float* running_var,
    float* scale,
    float* shift,
    const float* weight,
    const float* bias,
    int N,
    int C,
    int blocks_per_slice,
    int slice_size,
    float eps,
    float momentum)
{
    int c = blockIdx.x;
    if (c >= C) return;

    int groups = N * blocks_per_slice;
    __shared__ double s_sum[REDUCE_BLOCK_SIZE];
    __shared__ double s_sumsq[REDUCE_BLOCK_SIZE];

    double sum = 0.0;
    double sumsq = 0.0;

    for (int idx = threadIdx.x; idx < groups; idx += blockDim.x) {
        int n = idx / blocks_per_slice;
        int bx = idx - n * blocks_per_slice;
        int block_lin = n * (C * blocks_per_slice) + c * blocks_per_slice + bx;
        sum += partial_sums[block_lin];
        sumsq += partial_sumsq[block_lin];
    }

    s_sum[threadIdx.x] = sum;
    s_sumsq[threadIdx.x] = sumsq;
    __syncthreads();

    for (int stride = blockDim.x / 2; stride > 0; stride >>= 1) {
        if (threadIdx.x < stride) {
            s_sum[threadIdx.x] += s_sum[threadIdx.x + stride];
            s_sumsq[threadIdx.x] += s_sumsq[threadIdx.x + stride];
        }
        __syncthreads();
    }

    if (threadIdx.x == 0) {
        double count = (double)N * slice_size;
        double batch_mean = sum / count;
        double batch_var_biased = sumsq / count - batch_mean * batch_mean;
        if (batch_var_biased < 0.0) batch_var_biased = 0.0;
        double unbiased_var = batch_var_biased * count / (count - 1.0);

        running_mean[c] = (1.0 - momentum) * running_mean[c] + momentum * batch_mean;
        running_var[c] = (1.0 - momentum) * running_var[c] + momentum * unbiased_var;

        float invstd = rsqrtf((float)batch_var_biased + eps);
        scale[c] = weight[c] * invstd;
        shift[c] = bias[c] - (float)batch_mean * scale[c];
    }
}

__global__ void compute_scale_shift_from_running_stats_kernel(
    const float* running_mean,
    const float* running_var,
    const float* weight,
    const float* bias,
    float eps,
    int C,
    float* scale,
    float* shift)
{
    int c = blockIdx.x * blockDim.x + threadIdx.x;
    if (c < C) {
        float invstd = rsqrtf(running_var[c] + eps);
        scale[c] = weight[c] * invstd;
        shift[c] = bias[c] - running_mean[c] * scale[c];
    }
}

__global__ __launch_bounds__(BLOCK_SIZE)
void compute_partial_max_kernel(
    const float* __restrict__ input,
    const float* __restrict__ scale,
    const float* __restrict__ shift,
    float* __restrict__ partial_max,
    int C,
    int slice_size)
{
    int c = blockIdx.y;
    int n = blockIdx.z;
    int base = (n * C + c) * slice_size;

    float sc = scale[c];
    float sh = shift[c];
    float local_max = -FLT_MAX;

    for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < slice_size;
         i += blockDim.x * gridDim.x) {
        float val = input[base + i];
        float y = sc * val + sh;
        float d = digammaf(y);
        local_max = max_propagate_nan(local_max, d);
    }

    __shared__ float s_max[BLOCK_SIZE];
    s_max[threadIdx.x] = local_max;
    __syncthreads();

    for (int stride = blockDim.x / 2; stride > 0; stride >>= 1) {
        if (threadIdx.x < stride) {
            s_max[threadIdx.x] = max_propagate_nan(s_max[threadIdx.x], s_max[threadIdx.x + stride]);
        }
        __syncthreads();
    }

    if (threadIdx.x == 0) {
        int block_lin = blockIdx.z * (gridDim.y * gridDim.x) +
                        blockIdx.y * gridDim.x + blockIdx.x;
        partial_max[block_lin] = s_max[0];
    }
}

__global__ __launch_bounds__(FINAL_BLOCK_SIZE)
void final_reduce_add_param_kernel(
    const float* partial_max,
    float* output,
    const float* parameter,
    int total_blocks,
    int C)
{
    __shared__ float s_max[FINAL_BLOCK_SIZE];
    int tid = threadIdx.x;
    float local = -FLT_MAX;

    for (int i = tid; i < total_blocks; i += blockDim.x) {
        local = max_propagate_nan(local, partial_max[i]);
    }

    s_max[tid] = local;
    __syncthreads();

    for (int stride = blockDim.x / 2; stride > 0; stride >>= 1) {
        if (tid < stride) {
            s_max[tid] = max_propagate_nan(s_max[tid], s_max[tid + stride]);
        }
        __syncthreads();
    }

    if (tid == 0) {
        float global_max = s_max[0];
        for (int i = 0; i < C; ++i) {
            output[i] = global_max + parameter[i];
        }
    }
}

extern "C" void fused_bn_digamma_max_launcher(
    float* output,
    const float* input,
    int N,
    int C,
    int D,
    int H,
    int W,
    const float* weight,
    const float* bias,
    float* running_mean,
    float* running_var,
    const float* parameter,
    float eps,
    float momentum,
    int training,
    float* scale,
    float* shift,
    float* partial_max,
    double* partial_sums,
    double* partial_sumsq,
    int blocks_per_slice,
    int total_blocks,
    cudaStream_t stream)
{
    if (training) {
        dim3 grid_sum(blocks_per_slice, C, N);
        compute_channel_partial_sums_kernel<<<grid_sum, BLOCK_SIZE, 0, stream>>>(
            input,
            partial_sums,
            partial_sumsq,
            C,
            D * H * W,
            blocks_per_slice,
            total_blocks);

        compute_stats_scale_shift_kernel<<<C, REDUCE_BLOCK_SIZE, 0, stream>>>(
            partial_sums,
            partial_sumsq,
            running_mean,
            running_var,
            scale,
            shift,
            weight,
            bias,
            N,
            C,
            blocks_per_slice,
            D * H * W,
            eps,
            momentum);
    } else {
        int scale_blocks = (C + 255) / 256;
        compute_scale_shift_from_running_stats_kernel<<<scale_blocks, 256, 0, stream>>>(
            running_mean,
            running_var,
            weight,
            bias,
            eps,
            C,
            scale,
            shift);
    }

    dim3 grid_max(blocks_per_slice, C, N);
    compute_partial_max_kernel<<<grid_max, BLOCK_SIZE, 0, stream>>>(
        input,
        scale,
        shift,
        partial_max,
        C,
        D * H * W);

    final_reduce_add_param_kernel<<<1, FINAL_BLOCK_SIZE, 0, stream>>>(
        partial_max,
        output,
        parameter,
        total_blocks,
        C);
}

===== kernels/fused_bn_digamma_max_binding.cpp =====
#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>
#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

extern "C" void fused_bn_digamma_max_launcher(
    float* output,
    const float* input,
    int N,
    int C,
    int D,
    int H,
    int W,
    const float* weight,
    const float* bias,
    float* running_mean,
    float* running_var,
    const float* parameter,
    float eps,
    float momentum,
    int training,
    float* scale,
    float* shift,
    float* partial_max,
    double* partial_sums,
    double* partial_sumsq,
    int blocks_per_slice,
    int total_blocks,
    cudaStream_t stream);

torch::Tensor fused_bn_digamma_max_forward(
    torch::Tensor input,
    torch::Tensor weight,
    torch::Tensor bias,
    torch::Tensor running_mean,
    torch::Tensor running_var,
    torch::Tensor parameter,
    bool training,
    double momentum,
    double eps)
{
    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
    TORCH_CHECK(weight.is_cuda() && weight.dtype() == torch::kFloat32, "weight must be CUDA float32");
    TORCH_CHECK(bias.is_cuda() && bias.dtype() == torch::kFloat32, "bias must be CUDA float32");
    TORCH_CHECK(running_mean.is_cuda() && running_mean.dtype() == torch::kFloat32, "running_mean must be CUDA float32");
    TORCH_CHECK(running_var.is_cuda() && running_var.dtype() == torch::kFloat32, "running_var must be CUDA float32");
    TORCH_CHECK(parameter.is_cuda() && parameter.dtype() == torch::kFloat32, "parameter must be CUDA float32");

    auto input_contig = input.contiguous();
    auto weight_contig = weight.contiguous();
    auto bias_contig = bias.contiguous();
    auto running_mean_contig = running_mean.contiguous();
    auto running_var_contig = running_var.contiguous();
    auto parameter_contig = parameter.contiguous();

    int N = input_contig.size(0);
    int C = input_contig.size(1);
    int D = input_contig.size(2);
    int H = input_contig.size(3);
    int W = input_contig.size(4);

    auto output = torch::empty({C}, input_contig.options());
    auto scale = torch::empty({C}, input_contig.options());
    auto shift = torch::empty({C}, input_contig.options());

    int slice_size = D * H * W;
    int blocks_per_slice = (slice_size + 255) / 256;
    int total_blocks = N * C * blocks_per_slice;

    auto partial_max = torch::empty({total_blocks}, input_contig.options());

    torch::Tensor partial_sums, partial_sumsq;
    if (training) {
        partial_sums = torch::empty({total_blocks}, input_contig.options().dtype(torch::kFloat64));
        partial_sumsq = torch::empty({total_blocks}, input_contig.options().dtype(torch::kFloat64));
    }

    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    fused_bn_digamma_max_launcher(
        output.data_ptr<float>(),
        input_contig.data_ptr<float>(),
        N, C, D, H, W,
        weight_contig.data_ptr<float>(),
        bias_contig.data_ptr<float>(),
        running_mean_contig.data_ptr<float>(),
        running_var_contig.data_ptr<float>(),
        parameter_contig.data_ptr<float>(),
        (float)eps,
        (float)momentum,
        training ? 1 : 0,
        scale.data_ptr<float>(),
        shift.data_ptr<float>(),
        partial_max.data_ptr<float>(),
