+    // So we need two separate tensor descriptors: dy_desc and dx_desc.
+    // Let's create them instead of reusing input_desc/output_desc.
+    cudnnTensorDescriptor_t dy_desc, dx_desc;
+    CHECK_CUDNN(cudnnCreateTensorDescriptor(&dy_desc));
+    CHECK_CUDNN(cudnnCreateTensorDescriptor(&dx_desc));
+    CHECK_CUDNN(cudnnSetTensor4dDescriptor(dy_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT,
+                                           static_cast<int>(N), static_cast<int>(C_out), static_cast<int>(L_in), 1));
+    CHECK_CUDNN(cudnnSetTensor4dDescriptor(dx_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT,
+                                           static_cast<int>(N), static_cast<int>(C_in), static_cast<int>(L_out), 1));
+
+    // Now get workspace size
+    CHECK_CUDNN(cudnnGetConvolutionBackwardDataWorkspaceSize(
+        handle,
+        filter_desc,
+        dy_desc,
+        conv_desc,
+        dx_desc,
+        algo,
+        &workspace_size));
+
+    // Allocate workspace if needed
+    void* workspace = nullptr;
+    if (workspace_size > 0) {
+        cudaMalloc(&workspace, workspace_size);
+    }
+
+    // Perform backward data
+    float alpha = 1.0f, beta = 0.0f;
+    CHECK_CUDNN(cudnnConvolutionBackwardData(
+        handle,
+        &alpha,
+        filter_desc,
+        transposed_weight.data_ptr<float>(), // filter: transposed weight [C_out, C_in, K]
+        dy_desc,
+        input.data_ptr<float>(), // dy: conv_transpose input
+        conv_desc,
+        algo,
+        workspace,
+        workspace_size,
+        &beta,
+        dx_desc,
+        output.data_ptr<float>())); // dx: conv_transpose output
+
+    // Add bias
+    // Bias shape is [C_out], we need to add to each output channel across all N and L.
+    // We can use cudnnAddTensor with bias broadcast.
+    cudnnTensorDescriptor_t bias_desc;
+    CHECK_CUDNN(cudnnCreateTensorDescriptor(&bias_desc));
+    CHECK_CUDNN(cudnnSetTensor4dDescriptor(bias_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT,
+                                           1, static_cast<int>(C_out), 1, 1));
+    // bias is [C_out], but we need a 4D tensor of shape [1, C_out, 1, 1] for cudnnAddTensor.
+    // We can set bias_desc as a 4D tensor with N=1, C=C_out, H=1, W=1, and pass bias pointer.
+    // But bias pointer is [C_out] contiguous. It should work because the memory layout matches (C_out floats contiguous).
+    float beta_add = 1.0f;
+    CHECK_CUDNN(cudnnAddTensor(handle,
+                               &alpha,
+                               bias_desc,
+                               bias.data_ptr<float>(),
+                               &beta_add,
+                               dx_desc,
+                               output.data_ptr<float>()));
+
+    // Cleanup cuDNN descriptors and handle
+    CHECK_CUDNN(cudnnDestroyTensorDescriptor(dy_desc));
+    CHECK_CUDNN(cudnnDestroyTensorDescriptor(dx_desc));
+    CHECK_CUDNN(cudnnDestroyTensorDescriptor(bias_desc));
+    CHECK_CUDNN(cudnnDestroyFilterDescriptor(filter_desc));
+    CHECK_CUDNN(cudnnDestroyConvolutionDescriptor(conv_desc));
+    CHECK_CUDNN(cudnnDestroyTensorDescriptor(input_desc));
+    CHECK_CUDNN(cudnnDestroyTensorDescriptor(output_desc));
+    CHECK_CUDNN(cudnnDestroy(handle));
+    if (workspace) cudaFree(workspace);
+
+    // The transposed_weight tensor will be freed when it goes out of scope? Actually it's a torch::Tensor, so it will be freed after the function returns if not referenced elsewhere. That's fine.
+    // But we need to ensure there are no pending errors; we can check cudaGetLastError.
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA error: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// mul_bias_forward implementation
+torch::Tensor mul_bias_forward(torch::Tensor input, torch::Tensor bias) {
+    TORCH_CHECK(input.is_cuda(), "input must be CUDA tensor");
+    TORCH_CHECK(bias.is_cuda(), "bias must be CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "input must be float32");
+    TORCH_CHECK(bias.dtype() == torch::kFloat32, "bias must be float32");
+    TORCH_CHECK(input.is_contiguous(), "input must be contiguous");
+    TORCH_CHECK(bias.is_contiguous(), "bias must be contiguous");
+    TORCH_CHECK(input.dim() == 3, "input must be 3D [N, C, L]");
+    TORCH_CHECK(bias.dim() == 2 && bias.size(0) == input.size(1) && bias.size(1) == 1,
+                "bias must be [C, 1]");
+
+    auto output = torch::empty_like(input);
+    int64_t N = input.size(0);
+    int64_t C = input.size(1);
+    int64_t L = input.size(2);
+
+    cudaStream_t stream = getCurrentCUDAStream();
+    mul_bias_forward_launcher(
+        input.data_ptr<float>(),
+        bias.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int>(N),
+        static_cast<int>(C),
+        static_cast<int>(L),
+        stream);
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA error: ", cudaGetErrorString(err));
+    return output;
+}
+
+// Registration
+void register_custom_ops(pybind11::module& m) {
+    m.def("conv_transpose1d_forward", &conv_transpose1d_forward,
+          "ConvTranspose1d forward using cuDNN",
+          py::arg("input"), py::arg("weight"), py::arg("bias"),
+          py::arg("stride"), py::arg("padding"), py::arg("output_padding"));
+    m.def("mul_bias_forward", &mul_bias_forward,
+          "Elementwise multiply by bias [C,1] broadcast",
+          py::arg("input"), py::arg("bias"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
