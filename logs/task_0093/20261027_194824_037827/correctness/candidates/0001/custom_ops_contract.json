          "shape": "[128, 16, 20480]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[16, 1]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
