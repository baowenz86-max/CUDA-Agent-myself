      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[128, 16, 20480]"
      },
      "semantics": [
        "对应参考 torch.mul(x, self.bias)。",
        "self.bias 形状为 (16, 1)，广播到输入张量的 [128, 16, 20480]：对于每个 batch 和 height，对每个通道 c，输出 [b, c, h] = input[b, c, h] * bias[c, 0]。",
        "保持输入 shape 和 dtype。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.conv_transpose1d(x)",
      "semantics": [
        "对输入 x 应用 ConvTranspose1d，输出 shape [128, 16, 20480]。",
        "使用模块自身的 weight 和 bias。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.mul(x, self.bias)",
      "semantics": [
        "将 conv 输出与形状 (16,1) 的参数 bias 逐元素相乘，广播到每个 batch 和长度维度。",
        "输出 shape 不变。"
      ]
    },
