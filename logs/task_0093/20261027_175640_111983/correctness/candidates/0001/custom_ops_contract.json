          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_channels, 1]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch_size, out_channels, length_out]"
      },
      "semantics": [
        "对应参考语句 x = torch.mul(x, self.bias)。",
        "将输入与 bias 逐元素相乘，其中 bias 形状为 [out_channels, 1]，广播到输入的 [batch_size, out_channels, length_out]。",
        "乘法沿 channel 维度（axis=1）广播，batch 和 length 维度不变。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.conv_transpose1d(x)",
      "semantics": [
