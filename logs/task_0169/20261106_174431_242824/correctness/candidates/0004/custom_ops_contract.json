      },
      "semantics": [
        "Applies BatchNorm2d with affine transformation when weight and bias are provided; otherwise applies normalization only.",
        "Uses running_mean and running_var when training=False, computing (x - running_mean) / sqrt(running_var + eps) per channel.",
        "Broadcasts per-channel statistics along N,H,W.",
        "Preserves input shape, dtype, and device."
      ]
    },
    {
      "name": "hardsigmoid_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "any",
          "layout": "contiguous or supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "slope",
          "kind": "float",
          "optional": false,
          "nullable": false,
          "default": null
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "Computes element-wise hard sigmoid: clamp(x * slope + 0.5, min=0, max=1).",
        "Output shape, dtype, and device match input."
      ]
    },
    {
      "name": "add_bias_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "contiguous or supports strides",
