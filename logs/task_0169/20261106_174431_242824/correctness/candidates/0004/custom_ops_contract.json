          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[C, 1, 1]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "Performs element-wise addition of x and bias with broadcasting: bias shape [C,1,1] broadcasts to [N,C,H,W].",
        "Equivalent to x + self.bias in reference.",
        "Output shape, dtype, and device match x."
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.batch_norm2d(x)",
      "semantics": [
        "BatchNorm2d in eval mode uses running_mean and running_var.",
        "Applies affine transformation using batch_norm2d.weight and batch_norm2d.bias.",
        "Input and output are float32 CUDA tensors of shape [512,3,128,128]."
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = F.hardsigmoid(x, self.hardsigmoid_slope)",
      "semantics": [
        "Applies hardsigmoid with slope=0.2: clamp(x*0.2 + 0.5, 0, 1).",
        "Element-wise, output same shape as input."
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = x + self.bias",
      "semantics": [
        "Adds self.bias of shape [3,1,1] to x via broadcasting.",
        "Output same shape as x."
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return x",
      "semantics": [
        "Returns the final tensor after bias addition."
      ]
    }
  ]
