--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,89 @@
+#include <cuda_runtime.h>
+
+// Kernel: sum over dimension 1 (channels) with keepdim=True
+// Input: x shape [B, C, H, W], strides [sB, sC, sH, sW]
+// Output: out shape [B, 1, H, W] (contiguous)
+// We launch one thread per spatial position (B*H*W), each sums C channel values.
+__global__ void sum_dim1_keepdim_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ out,
+    int B, int C, int H, int W,
+    long long sB, long long sC, long long sH, long long sW) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total_spatial = B * H * W;
+    if (idx >= total_spatial) return;
+
+    // Decompose idx into (b, h, w)
+    int w = idx % W;
+    int tmp = idx / W;
+    int h = tmp % H;
+    int b = tmp / H;
+
+    const float* base = x + (long long)b * sB + (long long)h * sH + (long long)w * sW;
+    float sum = 0.0f;
+    for (int c = 0; c < C; ++c) {
+        sum += base[(long long)c * sC];
+    }
+    out[idx] = sum;
+}
+
+// Kernel: PReLU elementwise
+// out = max(0, x) + weight * min(0, x)
+__global__ void prelu_kernel(
+    const float* __restrict__ x,
+    float* __restrict__ out,
+    const float* __restrict__ weight,
+    int total) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= total) return;
+    float val = x[idx];
+    float w = weight[0];
+    out[idx] = (val > 0.0f) ? val : (val * w);
+}
+
+// Launcher for sum_dim1_keepdim
+// x: raw pointer to input (CUDA)
+// out: raw pointer to output (CUDA, allocated by caller)
+// B, C, H, W: dimensions
+// sB, sC, sH, sW: strides of input (in elements, can be long long)
+// stream: CUDA stream
+void sum_dim1_keepdim_launcher(
+    const float* x,
+    float* out,
+    int B, int C, int H, int W,
+    long long sB, long long sC, long long sH, long long sW,
+    cudaStream_t stream) {
+    int total_spatial = B * H * W;
+    if (total_spatial <= 0) return;
+    const int threads = 256;
+    int blocks = (total_spatial + threads - 1) / threads;
+    // Cap grid to avoid excessive blocks? No, grid-stride not needed here because total_spatial likely < max grid, but we can handle up to 2^31-1.
+    // For this task total_spatial = 16*2560*2560 = 104,857,600 > 2^31? No, 104,857,600 < 2,147,483,647, so fine with single launch.
+    sum_dim1_keepdim_kernel<<<blocks, threads, 0, stream>>>(
+        x, out, B, C, H, W, sB, sC, sH, sW);
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // Do not throw here; binding will check after launch
+    }
+}
+
+// Launcher for prelu
+// x: raw pointer to input
+// out: raw pointer to output
+// weight: raw pointer to weight (shape [1])
+// total: number of elements
+void prelu_launcher(
+    const float* x,
+    float* out,
+    const float* weight,
+    int total,
+    cudaStream_t stream) {
+    if (total <= 0) return;
+    const int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    prelu_kernel<<<blocks, threads, 0, stream>>>(x, out, weight, total);
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // Do not throw here; binding will check after launch
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,100 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAException.h>
+#include "../binding_registry.h"
+
+// Declare launchers exported by custom_ops.cu
+extern "C" {
+void sum_dim1_keepdim_launcher(
+    const float* x,
+    float* out,
+    int B,
+    int C,
+    int H,
+    int W,
+    long long sB,
+    long long sC,
+    long long sH,
+    long long sW,
+    cudaStream_t stream);
+
+void prelu_launcher(
+    const float* x,
+    float* out,
+    const float* weight,
+    int total,
+    cudaStream_t stream);
+}
+
+// Operator 1: sum_dim1_keepdim
+// Input: x [B, C, H, W] float32 CUDA, may be non-contiguous.
+// Output: [B, 1, H, W] float32 CUDA
+torch::Tensor sum_dim1_keepdim(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "sum_dim1_keepdim: input must be a CUDA tensor");
+    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "sum_dim1_keepdim: input must be float32");
+    TORCH_CHECK(x.dim() == 4, "sum_dim1_keepdim: input must be 4D [B, C, H, W]");
+
+    int B = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+
+    auto out = torch::empty({B, 1, H, W}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Use input strides converted to long long to match launcher signature.
+    long long sB = static_cast<long long>(x.stride(0));
+    long long sC = static_cast<long long>(x.stride(1));
+    long long sH = static_cast<long long>(x.stride(2));
+    long long sW = static_cast<long long>(x.stride(3));
+
+    sum_dim1_keepdim_launcher(
+        x.data_ptr<float>(),
+        out.data_ptr<float>(),
+        B, C, H, W,
+        sB, sC, sH, sW,
+        stream);
+
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+    return out;
+}
+
+// Operator 2: prelu
+// Input: x [B, 1, H, W] float32 CUDA, weight [1] float32 CUDA
+// Output: same shape as x, elementwise PReLU
+torch::Tensor prelu(torch::Tensor x, torch::Tensor weight) {
+    TORCH_CHECK(x.is_cuda(), "prelu: x must be a CUDA tensor");
+    TORCH_CHECK(weight.is_cuda(), "prelu: weight must be a CUDA tensor");
+    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "prelu: x must be float32");
+    TORCH_CHECK(weight.scalar_type() == torch::kFloat32, "prelu: weight must be float32");
+    TORCH_CHECK(x.dim() == 4, "prelu: x must be 4D");
+    TORCH_CHECK(weight.numel() == 1, "prelu: weight must have exactly one element");
+
+    auto out = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    int total = x.numel();
+    prelu_launcher(
+        x.data_ptr<float>(),
+        out.data_ptr<float>(),
+        weight.data_ptr<float>(),
+        total,
+        stream);
+
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+    return out;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    namespace py = pybind11;
+    m.def("sum_dim1_keepdim", &sum_dim1_keepdim,
+          py::arg("x"));
+    m.def("prelu", &prelu,
+          py::arg("x"), py::arg("weight"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,35 @@
+import torch
+import torch.nn as nn
+
+
+class ModelNew(nn.Module):
+    def __init__(self, channels, num_parameters):
+        super().__init__()
+        self.prelu = nn.PReLU(num_parameters=num_parameters)
+
+    def forward(self, x):
+        x = cuda_extension.sum_dim1_keepdim(x)
+        x = cuda_extension.prelu(x, self.prelu.weight)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.sum_dim1_keepdim(x)
+        yield 'step_001', x
+        x = cuda_extension.prelu(x, self.prelu.weight)
+        yield 'step_002', x
+        yield 'step_003', x
+
+
+def get_inputs():
+    batch_size = 16
+    channels = 3
+    height = 2560
+    width = 2560
+    x = torch.randn(batch_size, channels, height, width)
+    return [x]
+
+
+def get_init_inputs():
+    channels = 3
+    num_parameters = 1
+    return [channels, num_parameters]
