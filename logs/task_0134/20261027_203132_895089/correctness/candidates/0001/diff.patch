--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,32 @@
+#include <cuda_runtime.h>
+
+// Fused ReLU + clamp: out = min(max(x, 0.0f), 1.0f)
+__global__ void relu_clamp_kernel(const float* __restrict__ input,
+                                 float* __restrict__ output,
+                                 int64_t n) {
+    int64_t stride = static_cast<int64_t>(blockDim.x) * gridDim.x;
+    for (int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+         idx < n;
+         idx += stride) {
+        float v = input[idx];
+        v = fmaxf(v, 0.0f);
+        v = fminf(v, 1.0f);
+        output[idx] = v;
+    }
+}
+
+// C interface for binding layer
+extern "C" void relu_clamp_forward_launcher(const float* input,
+                                            float* output,
+                                            int64_t n,
+                                            cudaStream_t stream) {
+    if (n <= 0) return;
+    const int threads = 256;
+    const int64_t max_blocks_per_grid = 2147483647LL;
+    int64_t blocks_64 = (n + threads - 1) / threads;
+    if (blocks_64 > max_blocks_per_grid) {
+        blocks_64 = max_blocks_per_grid;
+    }
+    int blocks = static_cast<int>(blocks_64);
+    relu_clamp_kernel<<<blocks, threads, 0, stream>>>(input, output, n);
+}
--- before/kernels/relu_clamp_binding.cpp
+++ after/kernels/relu_clamp_binding.cpp
@@ -0,0 +1,42 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Launcher declaration from custom_ops.cu
+extern "C" void relu_clamp_forward_launcher(const float* input,
+                                            float* output,
+                                            int64_t n,
+                                            cudaStream_t stream);
+
+torch::Tensor relu_clamp_forward(torch::Tensor x) {
+    // Input validation
+    TORCH_CHECK(x.is_cuda(), "Input tensor must be on CUDA device");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input tensor must have dtype torch.float32");
+    TORCH_CHECK(x.numel() > 0, "Input tensor must not be empty");
+
+    // Allocate output with same shape and stride as input
+    auto output = torch::empty_like(x);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    relu_clamp_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        x.numel(),
+        stream
+    );
+
+    return output;
+}
+
+void register_relu_clamp(pybind11::module& m) {
+    m.def("relu_clamp_forward", &relu_clamp_forward,
+          "Fused ReLU + clamp(min=0, max=1) forward",
+          pybind11::arg("x"));
+}
+
+REGISTER_BINDING(relu_clamp, register_relu_clamp);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,35 @@
+import torch
+import torch.nn as nn
+
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x):
+        x = cuda_extension.relu_clamp_forward(x)
+        return x
+
+    def debug_forward(self, x):
+        relu_result = cuda_extension.relu_clamp_forward(x)
+        yield ("step_001", relu_result)
+        clamp_result = cuda_extension.relu_clamp_forward(x)
+        yield ("step_002", clamp_result)
+        result = cuda_extension.relu_clamp_forward(x)
+        yield ("step_003", result)
+
+
+batch_size = 1792
+height = 512
+width = 256
+
+
+def get_inputs():
+    x = torch.randn(batch_size, height, width)
+    return [x]
+
+
+def get_init_inputs():
+    return []
