{
  "operators": [
    {
      "name": "reflection_pad2d_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "contiguous or strided",
          "nullable": false,
          "optional": false
        },
        {
          "name": "pad",
          "kind": "int",
          "dtype": null,
          "device": null,
          "shape": null,
          "layout": null,
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C, H+2*pad, W+2*pad]"
      },
      "semantics": [
        "对输入的 4D 张量进行 ReflectionPad2d 填充，pad 为单边填充大小（左右上下相同）",
        "填充方式：对于输出坐标 (i,j)，原输入索引为 reflect(i-pad, H) 和 reflect(j-pad, W)，reflect(x, size) = x if 0<=x<size else -x-2 if x<0 else 2*size-x-2，越界时取镜像",
        "支持非连续输入，输出为连续张量"
      ]
    },
    {
      "name": "elementwise_max_forward",
      "parameters": [
        {
          "name": "a",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[...]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "b",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[...]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input (broadcasted if needed)"
      },
      "semantics": [
        "计算 a 和 b 的逐元素最大值，等价于 torch.max(a, b)，支持广播",
        "输入必须为 float32 CUDA tensor，输出为连续张量"
      ]
    },
    {
      "name": "elementwise_min_forward",
      "parameters": [
        {
          "name": "a",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[...]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "b",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[...]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input (broadcasted if needed)"
      },
      "semantics": [
        "计算 a 和 b 的逐元素最小值，等价于 torch.minimum(a, b)，支持广播",
        "输入必须为 float32 CUDA tensor，输出为连续张量"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x_padded = self.pad(x)",
      "semantics": [
        "使用 ReflectionPad2d 对输入 x 进行填充，pad 大小为 4，输出高度 512+2*4=520，宽度 512+2*4=520"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "y_padded = self.pad(y)",
      "semantics": [
        "使用相同的 ReflectionPad2d 对输入 y 进行填充，输出 shape 同 step_001"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "max_val = torch.max(x_padded, y_padded)",
      "semantics": [
        "计算两个张量的逐元素最大值，输出 shape [128,3,520,520]"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "min_val = torch.minimum(max_val, x_padded)",
      "semantics": [
        "计算 max_val 和 x_padded 的逐元素最小值，输出 shape [128,3,520,520]"
      ]
    },
    {
      "checkpoint": "step_005",
      "source": "return min_val",
      "semantics": [
        "返回 min_val，作为最终输出"
      ]
    }
  ]
}