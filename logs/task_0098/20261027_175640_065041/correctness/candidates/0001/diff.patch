--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,75 @@
+// CUDA kernels for reflection_pad2d, elementwise_max, elementwise_minimum
+#include <cuda_runtime.h>
+
+// Reflection padding indexing:
+// pad = pad_size
+// input index: i_in = i_out - pad
+// if i_in < 0: i_in = -i_in
+// if i_in >= in_size: i_in = 2 * (in_size - 1) - i_in
+__device__ __forceinline__ int reflect_index(int idx, int pad, int in_size) {
+    int i = idx - pad;
+    if (i < 0) {
+        i = -i;
+    } else if (i >= in_size) {
+        i = 2 * (in_size - 1) - i;
+    }
+    return i;
+}
+
+// ReflectionPad2d kernel
+// input: (N, C, H_in, W_in) with strides sn, sc, sh, sw
+// output: (N, C, H_out, W_out) with H_out = H_in + 2*pad, W_out = W_in + 2*pad
+// output is contiguous, with row-major strides: C*H_out*W_out, H_out*W_out, W_out, 1
+template <typename T>
+__global__ void reflection_pad2d_kernel(
+    const T* __restrict__ input,
+    T* __restrict__ output,
+    int N, int C, int H_in, int W_in,
+    int H_out, int W_out, int pad,
+    long long sn, long long sc, long long sh, long long sw) {
+
+    int out_idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = N * C * H_out * W_out;
+    if (out_idx >= total) return;
+
+    // Decompose linear index
+    int w_out = out_idx % W_out;
+    int tmp = out_idx / W_out;
+    int h_out = tmp % H_out;
+    tmp /= H_out;
+    int c = tmp % C;
+    int n = tmp / C;
+
+    int h_in = reflect_index(h_out, pad, H_in);
+    int w_in = reflect_index(w_out, pad, W_in);
+
+    // Compute input linear index using strides
+    long long in_linear = (long long)n * sn + (long long)c * sc + (long long)h_in * sh + (long long)w_in * sw;
+
+    output[out_idx] = input[in_linear];
+}
+
+// Elementwise max kernel (supports arbitrary strides for both inputs, same shape)
+template <typename T>
+__global__ void elementwise_max_kernel(
+    const T* __restrict__ a,
+    const T* __restrict__ b,
+    T* __restrict__ out,
+    int total,
+    int ndim,
+    const long long* __restrict__ strides_a,
+    const long long* __restrict__ strides_b) {
+
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= total) return;
+
+    // Compute multi-dimensional index from linear idx (row-major)
+    int coords[8]; // max dims supported 8, we assume 4
+    int rem = idx;
+    for (int d = ndim - 1; d >= 0; --d) {
+        coords[d] = rem % shapes[d]; // shapes not passed; need shape parameter
+        rem /= shapes[d];
+    }
+    // This kernel needs shape array; to avoid dynamic allocation, use fixed max dims and pass shape separately.
+    // However, for our known shape [N,C,H,W], we can just pass N,C,H,W and use direct decomposition.
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,111 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// 声明 .cu 导出的 launcher
+extern "C" void reflection_pad2d_launcher(
+    const float* input, float* output,
+    int N, int C, int H_in, int W_in,
+    int H_out, int W_out, int pad,
+    long long sn, long long sc, long long sh, long long sw,
+    cudaStream_t stream);
+
+extern "C" void elementwise_max_launcher(
+    const float* a, const float* b, float* out,
+    int total,
+    cudaStream_t stream);
+
+extern "C" void elementwise_minimum_launcher(
+    const float* a, const float* b, float* out,
+    int total,
+    cudaStream_t stream);
+
+// 包装函数：reflection_pad2d
+torch::Tensor reflection_pad2d(torch::Tensor input, int64_t pad_size) {
+    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(input.dim() == 4, "Input must be 4D (N, C, H, W)");
+    TORCH_CHECK(pad_size >= 0, "pad_size must be non-negative");
+
+    int N = input.size(0);
+    int C = input.size(1);
+    int H_in = input.size(2);
+    int W_in = input.size(3);
+    int H_out = H_in + 2 * pad_size;
+    int W_out = W_in + 2 * pad_size;
+
+    auto output = torch::empty({N, C, H_out, W_out}, input.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    reflection_pad2d_launcher(
+        input.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C, H_in, W_in,
+        H_out, W_out, static_cast<int>(pad_size),
+        input.stride(0), input.stride(1), input.stride(2), input.stride(3),
+        stream);
+
+    return output;
+}
+
+// 包装函数：elementwise_max
+torch::Tensor elementwise_max(torch::Tensor a, torch::Tensor b) {
+    TORCH_CHECK(a.is_cuda(), "a must be a CUDA tensor");
+    TORCH_CHECK(b.is_cuda(), "b must be a CUDA tensor");
+    TORCH_CHECK(a.dtype() == torch::kFloat32, "a must be float32");
+    TORCH_CHECK(b.dtype() == torch::kFloat32, "b must be float32");
+    TORCH_CHECK(a.sizes() == b.sizes(), "a and b must have the same shape");
+
+    auto output = torch::empty_like(a);
+    int total = a.numel();
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    elementwise_max_launcher(
+        a.data_ptr<float>(),
+        b.data_ptr<float>(),
+        output.data_ptr<float>(),
+        total,
+        stream);
+
+    return output;
+}
+
+// 包装函数：elementwise_minimum
+torch::Tensor elementwise_minimum(torch::Tensor a, torch::Tensor b) {
+    TORCH_CHECK(a.is_cuda(), "a must be a CUDA tensor");
+    TORCH_CHECK(b.is_cuda(), "b must be a CUDA tensor");
+    TORCH_CHECK(a.dtype() == torch::kFloat32, "a must be float32");
+    TORCH_CHECK(b.dtype() == torch::kFloat32, "b must be float32");
+    TORCH_CHECK(a.sizes() == b.sizes(), "a and b must have the same shape");
+
+    auto output = torch::empty_like(a);
+    int total = a.numel();
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    elementwise_minimum_launcher(
+        a.data_ptr<float>(),
+        b.data_ptr<float>(),
+        output.data_ptr<float>(),
+        total,
+        stream);
+
+    return output;
+}
+
+// 注册函数
+void register_custom_ops(pybind11::module& m) {
+    m.def("reflection_pad2d", &reflection_pad2d,
+          "ReflectionPad2d forward",
+          py::arg("input"), py::arg("pad_size"));
+    m.def("elementwise_max", &elementwise_max,
+          "Elementwise maximum",
+          py::arg("a"), py::arg("b"));
+    m.def("elementwise_minimum", &elementwise_minimum,
+          "Elementwise minimum",
+          py::arg("a"), py::arg("b"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,30 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, pad_size, input_channels, input_height, input_width):
+        super().__init__()
+        self.pad_size = pad_size
+        self.input_channels = input_channels
+        self.input_height = input_height
+        self.input_width = input_width
+
+    def forward(self, x, y):
+        x_padded = cuda_extension.reflection_pad2d(x, self.pad_size)
+        y_padded = cuda_extension.reflection_pad2d(y, self.pad_size)
+        max_val = cuda_extension.elementwise_max(x_padded, y_padded)
+        min_val = cuda_extension.elementwise_minimum(max_val, x_padded)
+        return min_val
+
+    def debug_forward(self, x, y):
+        x_padded = cuda_extension.reflection_pad2d(x, self.pad_size)
+        yield "step_001", x_padded
+        y_padded = cuda_extension.reflection_pad2d(y, self.pad_size)
+        yield "step_002", y_padded
+        max_val = cuda_extension.elementwise_max(x_padded, y_padded)
+        yield "step_003", max_val
+        min_val = cuda_extension.elementwise_minimum(max_val, x_padded)
+        yield "step_004", min_val
+        yield "step_005", min_val
