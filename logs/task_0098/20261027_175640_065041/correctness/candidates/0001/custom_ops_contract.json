{
  "operators": [
    {
      "name": "reflection_pad2d",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[128, 3, 512, 512]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "pad_size",
          "kind": "int",
          "dtype": null,
          "device": null,
          "shape": null,
          "layout": null,
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[128, 3, 520, 520]"
      },
      "semantics": [
        "对应于 self.pad(x) 和 self.pad(y)，nn.ReflectionPad2d(4) 沿高度和宽度各填充 4 个像素。",
        "输出高度 = 512 + 2 * 4 = 520，宽度 = 512 + 2 * 4 = 520。",
        "反射填充规则：对于索引 i 在 [0, 520) 内，若 i < 4 则映射到 8 - i，若 i >= 516 则映射到 1032 - i，否则映射到 i - 4（0-based）。"
      ]
    },
    {
      "name": "elementwise_max",
      "parameters": [
        {
          "name": "a",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[128, 3, 520, 520]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "b",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[128, 3, 520, 520]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[128, 3, 520, 520]"
      },
      "semantics": [
        "对应于 torch.max(x_padded, y_padded)，逐元素比较两个张量并返回较大值。",
        "支持广播，如果形状不同则广播至共同形状；当前输入形状相同。",
        "返回形状与广播结果一致。"
      ]
    },
    {
      "name": "elementwise_minimum",
      "parameters": [
        {
          "name": "a",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[128, 3, 520, 520]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "b",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[128, 3, 520, 520]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[128, 3, 520, 520]"
      },
      "semantics": [
        "对应于 torch.minimum(max_val, x_padded)，逐元素比较两个张量并返回较小值。",
        "支持广播，如果形状不同则广播至共同形状；当前输入形状相同。",
        "返回形状与广播结果一致。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x_padded = self.pad(x)",
      "semantics": [
        "对 x 应用 nn.ReflectionPad2d(4)，输出形状为 [128, 3, 520, 520]。",
        "反射填充，输入形状 [128, 3, 512, 512]。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "y_padded = self.pad(y)",
      "semantics": [
        "对 y 应用 nn.ReflectionPad2d(4)，输出形状为 [128, 3, 520, 520]。",
        "反射填充，输入形状 [128, 3, 512, 512]。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "max_val = torch.max(x_padded, y_padded)",
      "semantics": [
        "逐元素比较 x_padded 和 y_padded，返回两者较大值，形状 [128, 3, 520, 520]。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "min_val = torch.minimum(max_val, x_padded)",
      "semantics": [
        "逐元素比较 max_val 和 x_padded，返回两者较小值，形状 [128, 3, 520, 520]。"
      ]
    },
    {
      "checkpoint": "step_005",
      "source": "return min_val",
      "semantics": [
        "返回最终的 min_val 张量，形状 [128, 3, 520, 520]，与参考输出一致。"
      ]
    }
  ]
}