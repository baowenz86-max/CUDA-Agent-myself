--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,124 @@
+#include <cuda_runtime.h>
+#include <cuda_fp16.h>
+
+// Kernel: log_softmax along dim=1 for float32, shape [B, H, W]
+// Each thread handles one (b, w) slice, reducing over H.
+// Supports arbitrary strides via input stride parameters.
+__global__ void log_softmax_dim1_kernel(
+    float* __restrict__ out,
+    const float* __restrict__ in,
+    int B, int H, int W,
+    long long in_stride_b, long long in_stride_h, long long in_stride_w,
+    long long out_stride_b, long long out_stride_h, long long out_stride_w)
+{
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = B * W;
+    if (idx >= total) return;
+
+    int b = idx / W;
+    int w = idx % W;
+
+    const float* base = in + b * in_stride_b + w * in_stride_w;
+    float* out_base = out + b * out_stride_b + w * out_stride_w;
+
+    // Step 1: find max over H
+    float max_val = -CUDART_INF_F;
+    for (int h = 0; h < H; ++h) {
+        float val = base[h * in_stride_h];
+        if (val > max_val) max_val = val;
+    }
+
+    // Step 2: compute sum of exp(x - max)
+    float sum_exp = 0.0f;
+    for (int h = 0; h < H; ++h) {
+        float val = base[h * in_stride_h];
+        sum_exp += __expf(val - max_val);
+    }
+
+    // Step 3: logsumexp = max + log(sum_exp)
+    float logsumexp = max_val + __logf(sum_exp);
+
+    // Step 4: write output = x - logsumexp for each h
+    for (int h = 0; h < H; ++h) {
+        float val = base[h * in_stride_h];
+        out_base[h * out_stride_h] = val - logsumexp;
+    }
+}
+
+// Kernel: min along dim=1 for float32, shape [B, H, W]
+__global__ void min_dim1_kernel(
+    float* __restrict__ out,
+    const float* __restrict__ in,
+    int B, int H, int W,
+    long long in_stride_b, long long in_stride_h, long long in_stride_w,
+    long long out_stride_b, long long out_stride_w)
+{
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = B * W;
+    if (idx >= total) return;
+
+    int b = idx / W;
+    int w = idx % W;
+
+    const float* base = in + b * in_stride_b + w * in_stride_w;
+    float min_val = CUDART_INF_F;
+    for (int h = 0; h < H; ++h) {
+        float val = base[h * in_stride_h];
+        if (val < min_val) min_val = val;
+    }
+
+    out[b * out_stride_b + w * out_stride_w] = min_val;
+}
+
+// Host launcher for log_softmax_dim1
+// Signature expected by binding.cpp (will be implemented later):
+//   void log_softmax_dim1_launcher(float* out, const float* in,
+//                                   int B, int H, int W,
+//                                   long long in_stride_b, long long in_stride_h, long long in_stride_w,
+//                                   long long out_stride_b, long long out_stride_h, long long out_stride_w,
+//                                   cudaStream_t stream)
+extern "C" void log_softmax_dim1_launcher(
+    float* out,
+    const float* in,
+    int B,
+    int H,
+    int W,
+    long long in_stride_b,
+    long long in_stride_h,
+    long long in_stride_w,
+    long long out_stride_b,
+    long long out_stride_h,
+    long long out_stride_w,
+    cudaStream_t stream)
+{
+    int total = B * W;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    log_softmax_dim1_kernel<<<blocks, threads, 0, stream>>>(
+        out, in, B, H, W,
+        in_stride_b, in_stride_h, in_stride_w,
+        out_stride_b, out_stride_h, out_stride_w);
+}
+
+// Host launcher for min_dim1
+extern "C" void min_dim1_launcher(
+    float* out,
+    const float* in,
+    int B,
+    int H,
+    int W,
+    long long in_stride_b,
+    long long in_stride_h,
+    long long in_stride_w,
+    long long out_stride_b,
+    long long out_stride_w,
+    cudaStream_t stream)
+{
+    int total = B * W;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    min_dim1_kernel<<<blocks, threads, 0, stream>>>(
+        out, in, B, H, W,
+        in_stride_b, in_stride_h, in_stride_w,
+        out_stride_b, out_stride_w);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,108 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void log_softmax_dim1_launcher(
+    float* out,
+    const float* in,
+    int B,
+    int H,
+    int W,
+    long long in_stride_b,
+    long long in_stride_h,
+    long long in_stride_w,
+    long long out_stride_b,
+    long long out_stride_h,
+    long long out_stride_w,
+    cudaStream_t stream);
+
+extern "C" void min_dim1_launcher(
+    float* out,
+    const float* in,
+    int B,
+    int H,
+    int W,
+    long long in_stride_b,
+    long long in_stride_h,
+    long long in_stride_w,
+    long long out_stride_b,
+    long long out_stride_w,
+    cudaStream_t stream);
+
+// log_softmax along dim=1
+torch::Tensor log_softmax_dim1(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 3, "Input must be 3D (B, H, W)");
+
+    int64_t B = x.size(0);
+    int64_t H = x.size(1);
+    int64_t W = x.size(2);
+
+    auto out = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Strides as long long to match launcher signature
+    long long in_stride_b = static_cast<long long>(x.stride(0));
+    long long in_stride_h = static_cast<long long>(x.stride(1));
+    long long in_stride_w = static_cast<long long>(x.stride(2));
+    long long out_stride_b = static_cast<long long>(out.stride(0));
+    long long out_stride_h = static_cast<long long>(out.stride(1));
+    long long out_stride_w = static_cast<long long>(out.stride(2));
+
+    log_softmax_dim1_launcher(
+        out.data_ptr<float>(),
+        x.data_ptr<float>(),
+        static_cast<int>(B),
+        static_cast<int>(H),
+        static_cast<int>(W),
+        in_stride_b, in_stride_h, in_stride_w,
+        out_stride_b, out_stride_h, out_stride_w,
+        stream);
+
+    return out;
+}
+
+// min along dim=1
+torch::Tensor min_dim1(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 3, "Input must be 3D (B, H, W)");
+
+    int64_t B = x.size(0);
+    int64_t H = x.size(1);
+    int64_t W = x.size(2);
+
+    auto out = torch::empty({B, W}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    long long in_stride_b = static_cast<long long>(x.stride(0));
+    long long in_stride_h = static_cast<long long>(x.stride(1));
+    long long in_stride_w = static_cast<long long>(x.stride(2));
+    long long out_stride_b = static_cast<long long>(out.stride(0));
+    long long out_stride_w = static_cast<long long>(out.stride(1));
+
+    min_dim1_launcher(
+        out.data_ptr<float>(),
+        x.data_ptr<float>(),
+        static_cast<int>(B),
+        static_cast<int>(H),
+        static_cast<int>(W),
+        in_stride_b, in_stride_h, in_stride_w,
+        out_stride_b, out_stride_w,
+        stream);
+
+    return out;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("log_softmax_dim1", &log_softmax_dim1, "log_softmax along dim=1", pybind11::arg("x"));
+    m.def("min_dim1", &min_dim1, "min along dim=1", pybind11::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
