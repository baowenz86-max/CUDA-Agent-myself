+++ after/model_new.py
@@ -0,0 +1,20 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x):
+        x = cuda_extension.log_softmax_dim1(x)
+        x = cuda_extension.min_dim1(x)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.log_softmax_dim1(x)
+        yield 'step_001', x
+        x = cuda_extension.min_dim1(x)
+        yield 'step_002', x
+        yield 'step_003', x
