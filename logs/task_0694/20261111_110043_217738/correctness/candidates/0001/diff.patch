+// custom_ops.cu
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// Define a helper for sigmoid
+__device__ __forceinline__ float sigmoidf(float x) {
+    return 1.0f / (1.0f + expf(-x));
+}
+
+// Fused sum along dimension 1 and sigmoid kernel.
+// Input: x with shape [N, C, H, W] and strides sxN, sxC, sxH, sxW.
+// Output: y with shape [N, H, W] and strides syN, syH, syW, contiguous (syN=H*W, syH=W, syW=1).
+// We assume num_axes is 1 (the second dimension) as per contract, but handle general dim for flexibility?
+// To keep simple, we assume dim is the axis to reduce, and we reduce over that axis.
+// Since C is small (3), each thread computes one output element by looping over C.
+__global__ void sum_and_sigmoid_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int N, int C, int H, int W,
+    long long input_stride_N, long long input_stride_C, long long input_stride_H, long long input_stride_W,
+    long long output_stride_N, long long output_stride_H, long long output_stride_W,
+    int64_t total_output_elements)
+{
+    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)gridDim.x * blockDim.x;
+
+    for (int64_t i = idx; i < total_output_elements; i += stride) {
+        // Convert linear index to (n, h, w) coordinates for output (dim reduction removed)
+        int64_t n = i / ((int64_t)H * W);
+        int64_t rem = i - n * ((int64_t)H * W);
+        int h = (int)(rem / W);
+        int w = (int)(rem - (int64_t)h * W);
+
+        float sum = 0.0f;
+        for (int c = 0; c < C; ++c) {
+            // Input offset using original strides
+            const float* in_ptr = input + n * input_stride_N + c * input_stride_C + h * input_stride_H + w * input_stride_W;
+            sum += *in_ptr;
+        }
+        // Compute output offset (assuming output is contiguous: syN=H*W, syH=W, syW=1)
+        float* out_ptr = output + n * output_stride_N + h * output_stride_H + w * output_stride_W;
+        *out_ptr = sigmoidf(sum);
+    }
+}
+
+// Separate sum kernel (no sigmoid) for debug
+__global__ void sum_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int N, int C, int H, int W,
+    long long input_stride_N, long long input_stride_C, long long input_stride_H, long long input_stride_W,
+    long long output_stride_N, long long output_stride_H, long long output_stride_W,
+    int64_t total_output_elements)
+{
+    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)gridDim.x * blockDim.x;
+
+    for (int64_t i = idx; i < total_output_elements; i += stride) {
+        int64_t n = i / ((int64_t)H * W);
+        int64_t rem = i - n * ((int64_t)H * W);
+        int h = (int)(rem / W);
+        int w = (int)(rem - (int64_t)h * W);
+
+        float sum = 0.0f;
+        for (int c = 0; c < C; ++c) {
+            const float* in_ptr = input + n * input_stride_N + c * input_stride_C + h * input_stride_H + w * input_stride_W;
+            sum += *in_ptr;
+        }
+        float* out_ptr = output + n * output_stride_N + h * output_stride_H + w * output_stride_W;
+        *out_ptr = sum;
+    }
+}
+
+// Elementwise sigmoid kernel
+__global__ void sigmoid_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int64_t total_elements)
+{
+    int64_t idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)gridDim.x * blockDim.x;
+
+    for (int64_t i = idx; i < total_elements; i += stride) {
+        output[i] = sigmoidf(input[i]);
+    }
+}
+
+// Launcher for fused sum_and_sigmoid
+extern "C" void custom_sum_and_sigmoid_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    long long input_stride_N, long long input_stride_C, long long input_stride_H, long long input_stride_W,
+    long long output_stride_N, long long output_stride_H, long long output_stride_W,
+    int64_t total_output_elements,
+    cudaStream_t stream)
+{
+    int block_size = 256;
+    int64_t blocks_needed = (total_output_elements + block_size - 1) / block_size;
+    int grid_size = (int)min((int64_t)blocks_needed, (int64_t)65535); // grid max for x dimension; adjust if needed
+    if (total_output_elements > (int64_t)65535 * block_size) {
+        // Use grid-stride loop with 512 blocks (could be larger if needed, but 512 is fine)
+        grid_size = 512;
+    }
+    sum_and_sigmoid_kernel<<<grid_size, block_size, 0, stream>>>(
+        input, output, N, C, H, W,
+        input_stride_N, input_stride_C, input_stride_H, input_stride_W,
+        output_stride_N, output_stride_H, output_stride_W,
+        total_output_elements);
+}
+
+// Launcher for sum only
+extern "C" void custom_sum_only_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    long long input_stride_N, long long input_stride_C, long long input_stride_H, long long input_stride_W,
+    long long output_stride_N, long long output_stride_H, long long output_stride_W,
+    int64_t total_output_elements,
+    cudaStream_t stream)
+{
+    int block_size = 256;
+    int64_t blocks_needed = (total_output_elements + block_size - 1) / block_size;
+    int grid_size = (int)min((int64_t)blocks_needed, (int64_t)65535);
+    if (total_output_elements > (int64_t)65535 * block_size) {
+        grid_size = 512;
+    }
+    sum_kernel<<<grid_size, block_size, 0, stream>>>(
+        input, output, N, C, H, W,
+        input_stride_N, input_stride_C, input_stride_H, input_stride_W,
+        output_stride_N, output_stride_H, output_stride_W,
+        total_output_elements);
+}
+
+// Launcher for sigmoid only
+extern "C" void custom_sigmoid_only_launcher(
+    const float* input,
+    float* output,
+    int64_t total_elements,
+    cudaStream_t stream)
+{
+    int block_size = 256;
+    int64_t blocks_needed = (total_elements + block_size - 1) / block_size;
+    int grid_size = (int)min((int64_t)blocks_needed, (int64_t)65535);
+    if (total_elements > (int64_t)65535 * block_size) {
+        grid_size = 512;
+    }
+    sigmoid_kernel<<<grid_size, block_size, 0, stream>>>(input, output, total_elements);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,158 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launcher functions from custom_ops.cu
+extern "C" void custom_sum_and_sigmoid_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    long long input_stride_N, long long input_stride_C, long long input_stride_H, long long input_stride_W,
+    long long output_stride_N, long long output_stride_H, long long output_stride_W,
+    int64_t total_output_elements,
+    cudaStream_t stream);
+
+extern "C" void custom_sum_only_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    long long input_stride_N, long long input_stride_C, long long input_stride_H, long long input_stride_W,
+    long long output_stride_N, long long output_stride_H, long long output_stride_W,
+    int64_t total_output_elements,
+    cudaStream_t stream);
+
+extern "C" void custom_sigmoid_only_launcher(
+    const float* input,
+    float* output,
+    int64_t total_elements,
+    cudaStream_t stream);
+
+// Helper to get contiguous output tensor [N, H, W] for sum operations
+torch::Tensor allocate_sum_output(const torch::Tensor& x) {
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D for sum reduction");
+    int64_t N = x.size(0);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+    return torch::empty({N, H, W}, x.options().dtype(torch::kFloat32));
+}
+
+// Wrapper for fused sum and sigmoid
+torch::Tensor custom_sum_and_sigmoid(torch::Tensor x, int64_t dim) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(dim == 1, "Only dim=1 is supported");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D");
+
+    auto output = allocate_sum_output(x);
+    int N = static_cast<int>(x.size(0));
+    int C = static_cast<int>(x.size(1));
+    int H = static_cast<int>(x.size(2));
+    int W = static_cast<int>(x.size(3));
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Compute strides (note: input may be non-contiguous, so use .stride())
+    long long input_stride_N = x.stride(0);
+    long long input_stride_C = x.stride(1);
+    long long input_stride_H = x.stride(2);
+    long long input_stride_W = x.stride(3);
+
+    // Output is contiguous: [N,H,W] -> strides [H*W, W, 1]
+    long long output_stride_N = static_cast<long long>(H) * W;
+    long long output_stride_H = W;
+    long long output_stride_W = 1;
+
+    int64_t total_output_elements = static_cast<int64_t>(N) * H * W;
+
+    custom_sum_and_sigmoid_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C, H, W,
+        input_stride_N, input_stride_C, input_stride_H, input_stride_W,
+        output_stride_N, output_stride_H, output_stride_W,
+        total_output_elements,
+        stream
+    );
+
+    return output;
+}
+
+// Wrapper for sum only
+torch::Tensor custom_sum_only(torch::Tensor x, int64_t dim) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(dim == 1, "Only dim=1 is supported");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D");
+
+    auto output = allocate_sum_output(x);
+    int N = static_cast<int>(x.size(0));
+    int C = static_cast<int>(x.size(1));
+    int H = static_cast<int>(x.size(2));
+    int W = static_cast<int>(x.size(3));
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    long long input_stride_N = x.stride(0);
+    long long input_stride_C = x.stride(1);
+    long long input_stride_H = x.stride(2);
+    long long input_stride_W = x.stride(3);
+
+    long long output_stride_N = static_cast<long long>(H) * W;
+    long long output_stride_H = W;
+    long long output_stride_W = 1;
+
+    int64_t total_output_elements = static_cast<int64_t>(N) * H * W;
+
+    custom_sum_only_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C, H, W,
+        input_stride_N, input_stride_C, input_stride_H, input_stride_W,
+        output_stride_N, output_stride_H, output_stride_W,
+        total_output_elements,
+        stream
+    );
+
+    return output;
+}
+
+// Wrapper for sigmoid only
+torch::Tensor custom_sigmoid_only(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 3, "Input must be 3D for sigmoid only");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous for sigmoid only");
+
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    int64_t total_elements = x.numel();
+
+    custom_sigmoid_only_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        total_elements,
+        stream
+    );
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_sum_and_sigmoid", &custom_sum_and_sigmoid,
+          "Fused sum along dimension 1 and sigmoid",
+          pybind11::arg("x"), pybind11::arg("dim"));
+    m.def("custom_sum_only", &custom_sum_only,
+          "Sum along dimension 1 only",
+          pybind11::arg("x"), pybind11::arg("dim"));
+    m.def("custom_sigmoid_only", &custom_sigmoid_only,
+          "Elementwise sigmoid",
+          pybind11::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,20 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, num_axes):
+        super().__init__()
+        self.num_axes = num_axes
+
+    def forward(self, x):
+        x = cuda_extension.custom_sum_and_sigmoid(x, self.num_axes)
+        return x
+
+    def debug_forward(self, x):
+        sum_result = cuda_extension.custom_sum_only(x, self.num_axes)
+        yield ('step_001', sum_result)
+        sigmoid_result = cuda_extension.custom_sigmoid_only(sum_result)
+        yield ('step_002', sigmoid_result)
+        yield ('step_003', sigmoid_result)
