{
  "operators": [
    {
      "name": "embedding_lookup_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.int64",
          "device": "cuda",
          "shape": "[B, L]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[num_embeddings, embedding_dim]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[B, L, embedding_dim]"
      },
      "semantics": [
        "对应 nn.Embedding 前向：output[i, j, k] = weight[input[i, j], k]",
        "输入索引必须非负，否则行为未定义（参考 PyTorch 允许负索引但本任务输入非负）",
        "输出形状 [B, L, embedding_dim]，dtype float32"
      ]
    },
    {
      "name": "linear_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, L, in_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_features, in_features]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[out_features]",
          "layout": "contiguous",
          "nullable": true,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[B, L, out_features]"
      },
      "semantics": [
        "对应 nn.Linear 前向：output = input @ weight.T + bias",
        "输入形状 [B, L, in_features] 被视为 [B*L, in_features] 矩阵，输出 [B*L, out_features] 再 reshape 为 [B, L, out_features]",
        "bias 可以为 None，此时不加偏置；本模型 classifier 有 bias"
      ]
    },
    {
      "name": "cross_entropy_loss_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, L, C]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "target",
          "kind": "tensor",
          "dtype": "torch.int64",
          "device": "cuda",
          "shape": "[B, L]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "scalar"
      },
      "semantics": [
        "对应 nn.CrossEntropyLoss 默认设置 (reduction='mean')",
        "对每个位置计算 -log(softmax(input[i, j, :]))[target[i, j]]",
        "所有位置取平均，返回标量损失 Tensor"
      ]
    }
  ],
  "reference_steps": []
}