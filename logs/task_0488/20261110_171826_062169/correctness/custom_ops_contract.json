      },
      "semantics": [
        "对应参考语句 torch.softmax(x, dim=1)",
        "沿指定 dim 归一化，保持输入 shape、stride 和 dtype",
        "输出与输入完全相同 shape，device 一致",
        "在 CUDA 上使用数值稳定的 softmax（减去最大值）"
      ]
    },
    {
      "name": "custom_kl_div_batchmean",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference step (N, H, W)",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "target",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as input",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "scalar []"
      },
      "semantics": [
        "对应参考语句 F.kl_div(x, x, reduction='batchmean')",
        "计算 KL divergence: sum(target * (log(target) - input)) / batch_size",
        "batchmean 模式下分母为批量大小 N（输入 shape 第一维）",
        "返回 0-dim tensor，dtype float32，device cuda"
      ]
    }
  ],
  "reference_steps": [
