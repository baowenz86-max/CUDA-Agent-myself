+++ after/model_new.py
@@ -0,0 +1,20 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x):
+        x = cuda_extension.custom_softmax_kv_cache(x, dim=1)
+        x = cuda_extension.custom_kl_div_batchmean(x, x)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.custom_softmax_kv_cache(x, dim=1)
+        yield ('step_001', x)
+        x = cuda_extension.custom_kl_div_batchmean(x, x)
+        yield ('step_002', x)
+        yield ('step_003', x)
