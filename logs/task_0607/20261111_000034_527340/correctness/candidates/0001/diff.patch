--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,78 @@
+#include <cuda_runtime.h>
+
+// CUDA kernel for unfold + abs
+// Each thread processes one output element.
+__global__ void unfold_abs_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int N, int C, int H, int W,
+    int kernel_h, int kernel_w,
+    int dilation,
+    int padding_h, int padding_w,
+    int stride_h, int stride_w)
+{
+    // Compute output dimensions
+    int out_h = (H + 2 * padding_h - dilation * (kernel_h - 1) - 1) / stride_h + 1;
+    int out_w = (W + 2 * padding_w - dilation * (kernel_w - 1) - 1) / stride_w + 1;
+    int out_spatial = out_h * out_w;
+    int CK = C * kernel_h * kernel_w;
+    int total = N * CK * out_spatial;
+
+    for (int idx = blockIdx.x * blockDim.x + threadIdx.x; idx < total; idx += blockDim.x * gridDim.x) {
+        int l = idx % out_spatial;
+        int tmp = idx / out_spatial;
+        int ck = tmp % CK;
+        int n = tmp / CK;
+
+        // Decode ck into c, kh_idx, kw_idx
+        int c = ck / (kernel_h * kernel_w);
+        int khw = ck % (kernel_h * kernel_w);
+        int kh = khw / kernel_w;
+        int kw = khw % kernel_w;
+
+        // Compute spatial position from l
+        int h_idx = l / out_w;
+        int w_idx = l % out_w;
+
+        // Input coordinates
+        int h_in = h_idx * stride_h - padding_h + kh * dilation;
+        int w_in = w_idx * stride_w - padding_w + kw * dilation;
+
+        float val = 0.0f;
+        if (h_in >= 0 && h_in < H && w_in >= 0 && w_in < W) {
+            val = input[((n * C + c) * H + h_in) * W + w_in];
+        }
+        // abs
+        output[idx] = fabsf(val);
+    }
+}
+
+// Launcher function (C interface)
+extern "C" void launch_custom_unfold_abs(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    int kernel_h, int kernel_w,
+    int dilation,
+    int padding_h, int padding_w,
+    int stride_h, int stride_w,
+    cudaStream_t stream)
+{
+    int out_h = (H + 2 * padding_h - dilation * (kernel_h - 1) - 1) / stride_h + 1;
+    int out_w = (W + 2 * padding_w - dilation * (kernel_w - 1) - 1) / stride_w + 1;
+    int out_spatial = out_h * out_w;
+    int CK = C * kernel_h * kernel_w;
+    int total = N * CK * out_spatial;
+
+    const int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535; // grid cap; kernel uses grid-stride loop
+
+    unfold_abs_kernel<<<blocks, threads, 0, stream>>>(
+        input, output,
+        N, C, H, W,
+        kernel_h, kernel_w,
+        dilation,
+        padding_h, padding_w,
+        stride_h, stride_w);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,82 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+extern "C" void launch_custom_unfold_abs(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    int kernel_h, int kernel_w,
+    int dilation,
+    int padding_h, int padding_w,
+    int stride_h, int stride_w,
+    cudaStream_t stream);
+
+torch::Tensor custom_unfold_abs(
+    torch::Tensor x,
+    int64_t kernel_h,
+    int64_t kernel_w,
+    int64_t dilation,
+    int64_t padding_h,
+    int64_t padding_w,
+    int64_t stride_h,
+    int64_t stride_w) {
+
+    // 输入检查
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4-dimensional [N, C, H, W]");
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+
+    // 计算输出空间维度 L
+    int64_t out_h = (H + 2 * padding_h - dilation * (kernel_h - 1) - 1) / stride_h + 1;
+    int64_t out_w = (W + 2 * padding_w - dilation * (kernel_w - 1) - 1) / stride_w + 1;
+    TORCH_CHECK(out_h > 0 && out_w > 0, "Invalid output dimensions");
+    int64_t out_spatial = out_h * out_w;
+    int64_t CK = C * kernel_h * kernel_w;
+
+    auto output = torch::empty({N, CK, out_spatial}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    launch_custom_unfold_abs(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C, H, W,
+        static_cast<int>(kernel_h),
+        static_cast<int>(kernel_w),
+        static_cast<int>(dilation),
+        static_cast<int>(padding_h),
+        static_cast<int>(padding_w),
+        static_cast<int>(stride_h),
+        static_cast<int>(stride_w),
+        stream);
+
+    // 检查 kernel 启动错误（可选）
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+void register_custom_unfold_abs(pybind11::module& m) {
+    m.def("custom_unfold_abs", &custom_unfold_abs,
+          "Custom unfold + abs operation",
+          py::arg("x"),
+          py::arg("kernel_h"),
+          py::arg("kernel_w"),
+          py::arg("dilation"),
+          py::arg("padding_h"),
+          py::arg("padding_w"),
+          py::arg("stride_h"),
+          py::arg("stride_w"));
+}
+
+REGISTER_BINDING(custom_unfold_abs, register_custom_unfold_abs);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,42 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+class ModelNew(nn.Module):
+    def __init__(self, channels, kernel_size, dilation, input_shape):
+        super().__init__()
+        self.unfold = nn.Unfold(kernel_size=kernel_size, dilation=dilation)
+        self.channels = channels
+        self.input_shape = input_shape
+        self.kernel_size = kernel_size
+        self.dilation = dilation
+
+    def forward(self, x):
+        unfold_abs = cuda_extension.custom_unfold_abs(
+            x,
+            self.kernel_size[0], self.kernel_size[1],
+            self.dilation,
+            0, 0,  # padding_h, padding_w
+            1, 1   # stride_h, stride_w
+        )
+        return unfold_abs
+
+    def debug_forward(self, *inputs):
+        x = inputs[0]
+        unfold_out = cuda_extension.custom_unfold_abs(
+            x,
+            self.kernel_size[0], self.kernel_size[1],
+            self.dilation,
+            0, 0,  # padding_h, padding_w
+            1, 1   # stride_h, stride_w
+        )
+        yield 'step_001', unfold_out
+        abs_out = cuda_extension.custom_unfold_abs(
+            x,
+            self.kernel_size[0], self.kernel_size[1],
+            self.dilation,
+            0, 0,  # padding_h, padding_w
+            1, 1   # stride_h, stride_w
+        )
+        yield 'step_002', abs_out
+        yield 'step_003', abs_out
