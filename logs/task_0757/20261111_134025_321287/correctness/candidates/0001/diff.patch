--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,112 @@
+#include <cuda_runtime.h>
+
+// -----------------------------------------------------------------------------
+// custom_cat: concatenate two float32 tensors along dimension 1 (dim=1).
+// Input tensors may be non-contiguous; use their strides to index.
+// Output tensor is contiguous with merged shape.
+// -----------------------------------------------------------------------------
+__global__ void custom_cat_kernel(
+    float* __restrict__ output,
+    const float* __restrict__ x1,
+    const float* __restrict__ x2,
+    int64_t out_numel,
+    int N,      // batch
+    int C1,     // channels of x1
+    int C2,     // channels of x2
+    int H,
+    int W,
+    // strides for x1 (4 dims)
+    int64_t s1_N, int64_t s1_C, int64_t s1_H, int64_t s1_W,
+    // strides for x2 (4 dims)
+    int64_t s2_N, int64_t s2_C, int64_t s2_H, int64_t s2_W
+) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+
+    for (int64_t i = idx; i < out_numel; i += stride) {
+        // output has shape [N, C1+C2, H, W], contiguous
+        int64_t w = i % W;
+        int64_t tmp = i / W;
+        int64_t h = tmp % H;
+        tmp /= H;
+        int64_t c = tmp % (C1 + C2);
+        int64_t n = tmp / (C1 + C2);
+
+        const float* src;
+        int64_t src_index;
+        if (c < C1) {
+            src = x1;
+            src_index = n * s1_N + c * s1_C + h * s1_H + w * s1_W;
+        } else {
+            src = x2;
+            int64_t c2 = c - C1;
+            src_index = n * s2_N + c2 * s2_C + h * s2_H + w * s2_W;
+        }
+        output[i] = src[src_index];
+    }
+}
+
+extern "C" void custom_cat_launcher(
+    float* output,
+    const float* x1,
+    const float* x2,
+    int64_t out_numel,
+    int N,
+    int C1,
+    int C2,
+    int H,
+    int W,
+    int64_t s1_N, int64_t s1_C, int64_t s1_H, int64_t s1_W,
+    int64_t s2_N, int64_t s2_C, int64_t s2_H, int64_t s2_W,
+    cudaStream_t stream
+) {
+    const int threads = 256;
+    int blocks = (int)((out_numel + threads - 1) / threads);
+    // Cap blocks to avoid excessive grid size; grid-stride loop handles rest
+    if (blocks > 65535) blocks = 65535;
+    if (blocks == 0) return;
+
+    custom_cat_kernel<<<blocks, threads, 0, stream>>>(
+        output, x1, x2, out_numel,
+        N, C1, C2, H, W,
+        s1_N, s1_C, s1_H, s1_W,
+        s2_N, s2_C, s2_H, s2_W
+    );
+    cudaGetLastError();
+}
+
+// -----------------------------------------------------------------------------
+// custom_ne: element-wise not-equal to scalar, output is bool.
+// Input float32, output bool (C++ bool), output is contiguous.
+// -----------------------------------------------------------------------------
+__global__ void custom_ne_kernel(
+    const float* __restrict__ input,
+    bool* __restrict__ output,
+    int64_t numel,
+    float other
+) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+
+    for (int64_t i = idx; i < numel; i += stride) {
+        output[i] = (input[i] != other);
+    }
+}
+
+extern "C" void custom_ne_launcher(
+    const float* input,
+    bool* output,
+    int64_t numel,
+    float other,
+    cudaStream_t stream
+) {
+    const int threads = 256;
+    int blocks = (int)((numel + threads - 1) / threads);
+    if (blocks > 65535) blocks = 65535;
+    if (blocks == 0) return;
+
+    custom_ne_kernel<<<blocks, threads, 0, stream>>>(
+        input, output, numel, other
+    );
+    cudaGetLastError();
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,108 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void custom_cat_launcher(
+    float* output,
+    const float* x1,
+    const float* x2,
+    int64_t out_numel,
+    int N,
+    int C1,
+    int C2,
+    int H,
+    int W,
+    int64_t s1_N, int64_t s1_C, int64_t s1_H, int64_t s1_W,
+    int64_t s2_N, int64_t s2_C, int64_t s2_H, int64_t s2_W,
+    cudaStream_t stream
+);
+
+extern "C" void custom_ne_launcher(
+    const float* input,
+    bool* output,
+    int64_t numel,
+    float other,
+    cudaStream_t stream
+);
+
+// Wrapper for torch.cat equivalent
+torch::Tensor custom_cat(torch::Tensor x1, torch::Tensor x2, int64_t dim) {
+    // Input validation
+    TORCH_CHECK(x1.is_cuda(), "x1 must be a CUDA tensor");
+    TORCH_CHECK(x2.is_cuda(), "x2 must be a CUDA tensor");
+    TORCH_CHECK(x1.dtype() == torch::kFloat32, "x1 must be float32");
+    TORCH_CHECK(x2.dtype() == torch::kFloat32, "x2 must be float32");
+    TORCH_CHECK(x1.dim() == 4 && x2.dim() == 4, "Expected 4D tensors");
+    TORCH_CHECK(dim == 1, "Only dim=1 is supported");
+
+    // Assume x1 and x2 have same sizes except on dim=1
+    TORCH_CHECK(x1.size(0) == x2.size(0) && x1.size(2) == x2.size(2) && x1.size(3) == x2.size(3),
+                "Non-cat dimensions must match");
+
+    int N = x1.size(0);
+    int C1 = x1.size(1);
+    int C2 = x2.size(1);
+    int H = x1.size(2);
+    int W = x1.size(3);
+    int C_out = C1 + C2;
+    int64_t out_numel = static_cast<int64_t>(N) * C_out * H * W;
+
+    // Allocate contiguous output
+    auto output = torch::empty({N, C_out, H, W}, x1.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher with strides from input tensors
+    custom_cat_launcher(
+        output.data_ptr<float>(),
+        x1.data_ptr<float>(),
+        x2.data_ptr<float>(),
+        out_numel,
+        N, C1, C2, H, W,
+        x1.stride(0), x1.stride(1), x1.stride(2), x1.stride(3),
+        x2.stride(0), x2.stride(1), x2.stride(2), x2.stride(3),
+        stream
+    );
+
+    // Check for kernel launch errors (cudaGetLastError is already called in launcher,
+    // but we can sync here for debugging; not required for production)
+    // cudaDeviceSynchronize(); // Optional
+
+    return output;
+}
+
+// Wrapper for torch.ne equivalent
+torch::Tensor custom_ne(torch::Tensor x, double other) {
+    TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "x must be float32");
+    TORCH_CHECK(x.is_contiguous(), "x must be contiguous for custom_ne");
+
+    auto output = torch::empty_like(x, x.options().dtype(torch::kBool));
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_ne_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<bool>(),
+        x.numel(),
+        static_cast<float>(other),
+        stream
+    );
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_cat", &custom_cat,
+          "Concatenate two float32 tensors along dim=1",
+          py::arg("x1"), py::arg("x2"), py::arg("dim"));
+    m.def("custom_ne", &custom_ne,
+          "Element-wise not equal to scalar (float32 -> bool)",
+          py::arg("x"), py::arg("other"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,19 @@
+import torch
+import cuda_extension
+
+
+class ModelNew(torch.nn.Module):
+    def __init__(self, num_inputs, num_classes):
+        super(ModelNew, self).__init__()
+
+    def forward(self, x1, x2):
+        x = cuda_extension.custom_cat(x1, x2, 1)
+        x = cuda_extension.custom_ne(x, 0.0)
+        return x
+
+    def debug_forward(self, x1, x2):
+        x = cuda_extension.custom_cat(x1, x2, 1)
+        yield 'step_001', x
+        x = cuda_extension.custom_ne(x, 0.0)
+        yield 'step_002', x
+        yield 'step_003', x
