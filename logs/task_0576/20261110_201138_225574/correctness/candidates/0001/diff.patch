--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,100 @@
+#include <cuda_runtime.h>
+#include <cstdint>
+#include <climits>
+
+// 自定义算子：绝对值与最大池化
+
+// 逐元素绝对值 kernel
+__global__ void abs_kernel(const float* __restrict__ input, float* __restrict__ output, int64_t total_elements) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx < total_elements) {
+        output[idx] = fabsf(input[idx]);
+    }
+}
+
+// 最大池化 kernel: 每个输出元素一个线程
+__global__ void max_pool2d_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int64_t N,
+    int64_t C,
+    int64_t H,
+    int64_t W,
+    int64_t kernel_h,
+    int64_t kernel_w,
+    int64_t stride,
+    int64_t pad_h,
+    int64_t pad_w,
+    int64_t dilation) {
+    
+    int64_t out_h_total = (H + 2 * pad_h - dilation * (kernel_h - 1) - 1) / stride + 1;
+    int64_t out_w_total = (W + 2 * pad_w - dilation * (kernel_w - 1) - 1) / stride + 1;
+    int64_t total_outputs = N * C * out_h_total * out_w_total;
+    
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= total_outputs) return;
+    
+    // 从线性索引恢复 n,c,oh,ow
+    int64_t ow = idx % out_w_total;
+    int64_t oh = (idx / out_w_total) % out_h_total;
+    int64_t c = (idx / (out_w_total * out_h_total)) % C;
+    int64_t n = idx / (out_w_total * out_h_total * C);
+    
+    float max_val = -FLT_MAX;
+    bool found = false;
+    
+    for (int64_t kh = 0; kh < kernel_h; ++kh) {
+        int64_t ih = oh * stride - pad_h + kh * dilation;
+        if (ih < 0 || ih >= H) continue;
+        for (int64_t kw = 0; kw < kernel_w; ++kw) {
+            int64_t iw = ow * stride - pad_w + kw * dilation;
+            if (iw < 0 || iw >= W) continue;
+            float val = input[((n * C + c) * H + ih) * W + iw];
+            if (!found || val > max_val) {
+                max_val = val;
+                found = true;
+            }
+        }
+    }
+    
+    // 如果没有有效元素，用 -inf (但我们的参数下不会发生)
+    output[idx] = found ? max_val : -FLT_MAX;
+}
+
+// 绝对值 launcher
+extern "C" void custom_abs_launcher(
+    float* output,
+    const float* input,
+    int64_t total_elements,
+    cudaStream_t stream) {
+    
+    int threads = 256;
+    int blocks = (int)((total_elements + threads - 1) / threads);
+    abs_kernel<<<blocks, threads, 0, stream>>>(input, output, total_elements);
+}
+
+// 最大池化 launcher
+extern "C" void custom_max_pool2d_launcher(
+    float* output,
+    const float* input,
+    int64_t N,
+    int64_t C,
+    int64_t H,
+    int64_t W,
+    int64_t kernel_h,
+    int64_t kernel_w,
+    int64_t stride,
+    int64_t pad_h,
+    int64_t pad_w,
+    int64_t dilation,
+    cudaStream_t stream) {
+    
+    int64_t out_h = (H + 2 * pad_h - dilation * (kernel_h - 1) - 1) / stride + 1;
+    int64_t out_w = (W + 2 * pad_w - dilation * (kernel_w - 1) - 1) / stride + 1;
+    int64_t total_outputs = N * C * out_h * out_w;
+    
+    int threads = 256;
+    int blocks = (int)((total_outputs + threads - 1) / threads);
+    max_pool2d_kernel<<<blocks, threads, 0, stream>>>(
+        input, output, N, C, H, W, kernel_h, kernel_w, stride, pad_h, pad_w, dilation);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,118 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// 声明来自 custom_ops.cu 的 launcher 函数
+extern "C" void custom_abs_launcher(
+    float* output,
+    const float* input,
+    int64_t total_elements,
+    cudaStream_t stream);
+
+extern "C" void custom_max_pool2d_launcher(
+    float* output,
+    const float* input,
+    int64_t N,
+    int64_t C,
+    int64_t H,
+    int64_t W,
+    int64_t kernel_h,
+    int64_t kernel_w,
+    int64_t stride,
+    int64_t pad_h,
+    int64_t pad_w,
+    int64_t dilation,
+    cudaStream_t stream);
+
+// 自定义绝对值算子
+torch::Tensor custom_abs(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // 调用 launcher，handle 错误
+    custom_abs_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        x.numel(),
+        stream
+    );
+
+    // 检查 launch 错误（cudaPeekAtLastError）
+    cudaError_t err = cudaPeekAtLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// 自定义最大池化算子
+torch::Tensor custom_max_pool2d(
+    torch::Tensor x,
+    int64_t kernel_size,
+    int64_t stride,
+    int64_t padding,
+    int64_t dilation,
+    bool ceil_mode) {
+
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D (N,C,H,W)");
+
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+
+    // 根据 PyTorch 的 MaxPool2d 计算输出尺寸（floor 模式）
+    int64_t out_h = (H + 2 * padding - dilation * (kernel_size - 1) - 1) / stride + 1;
+    int64_t out_w = (W + 2 * padding - dilation * (kernel_size - 1) - 1) / stride + 1;
+
+    auto output = torch::empty({N, C, out_h, out_w}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_max_pool2d_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        N,
+        C,
+        H,
+        W,
+        kernel_size,
+        kernel_size,  // kernel_h, kernel_w 相同
+        stride,
+        padding,
+        padding,     // pad_h, pad_w 相同（但契约中 padding 是两个元素的元组，这里暂时假设对称）
+        dilation,
+        stream
+    );
+
+    cudaError_t err = cudaPeekAtLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// 注册到 pybind
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_abs", &custom_abs, "Custom absolute value",
+          py::arg("x"));
+
+    m.def("custom_max_pool2d", &custom_max_pool2d, "Custom max pooling 2D",
+          py::arg("x"),
+          py::arg("kernel_size"),
+          py::arg("stride"),
+          py::arg("padding"),
+          py::arg("dilation"),
+          py::arg("ceil_mode"));
+}
+
+// 自动注册
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,36 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, out_channels, kernel_size, stride, padding):
+        super().__init__()
+        # 保留原结构以维持接口一致；forward 中不调用该模块，实际池化由自定义算子完成
+        self.max_pool = nn.MaxPool2d(kernel_size, stride=stride, padding=padding)
+
+    def forward(self, x):
+        x = cuda_extension.custom_abs(x)
+        x = cuda_extension.custom_max_pool2d(
+            x,
+            kernel_size=(3, 5),
+            stride=1,
+            padding=(1, 2),
+            dilation=1,
+            ceil_mode=False
+        )
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.custom_abs(x)
+        yield 'step_001', x
+        x = cuda_extension.custom_max_pool2d(
+            x,
+            kernel_size=(3, 5),
+            stride=1,
+            padding=(1, 2),
+            dilation=1,
+            ceil_mode=False
+        )
+        yield 'step_002', x
+        yield 'step_003', x
