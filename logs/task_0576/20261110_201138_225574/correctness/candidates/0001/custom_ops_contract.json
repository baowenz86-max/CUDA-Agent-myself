{
  "operators": [
    {
      "name": "custom_abs",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[16, 3, 2048, 1024]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "将输入张量的每个元素替换为其绝对值，等价于 torch.abs(x)。",
        "保持输入 shape、stride、dtype 和 device 不变。",
        "支持任意连续布局的 CUDA tensor。"
      ]
    },
    {
      "name": "custom_max_pool2d",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[16, 3, 2048, 1024]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "kernel_size",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "stride",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "padding",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "dilation",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "ceil_mode",
          "kind": "bool",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[16, 3, 2048, 1024]"
      },
      "semantics": [
        "对应 nn.MaxPool2d(kernel_size=(3,5), stride=1, padding=(1,2), dilation=1, ceil_mode=False)。",
        "输出尺寸根据 floor((H + 2*pad_h - dilation*(kernel_h-1) - 1)/stride + 1) = 2048，W 同理为 1024。",
        "在每个 (3,5) 滑动窗口内取最大值，忽略 padding 区域。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = torch.abs(x)",
      "semantics": [
        "对输入 x 进行逐元素绝对值运算，输出与输入相同 shape/dtype/device。",
        "对应模型中的第一步计算。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.max_pool(x)",
      "semantics": [
        "对绝对值结果执行最大池化，kernel_size=(3,5), stride=1, padding=(1,2), dilation=1, ceil_mode=False。",
        "输出 shape 仍为 [16,3,2048,1024]，与输入相同。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回池化后的张量，即最终输出。"
      ]
    }
  ]
}