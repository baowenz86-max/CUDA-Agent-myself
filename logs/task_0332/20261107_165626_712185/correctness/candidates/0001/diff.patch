+// -----------------------------------------------------------------------------
+// LSTM forward kernel (two layers, unidirectional)
+// Input: x [batch, seq_len, input_size]
+// Weights and biases for layer 0 and layer 1
+// Output: y [batch, seq_len, hidden_size]
+// Also writes h_n [2, batch, hidden_size], c_n [2, batch, hidden_size]
+// -----------------------------------------------------------------------------
+// Helper: sigmoid function
+__device__ __forceinline__ float sigmoidf(float x) {
+  return 1.0f / (1.0f + expf(-x));
+}
+
+// Kernel: each block processes one (batch, layer) pair for all time steps.
+// Shared memory stores h_prev and c_prev for that (batch, layer).
+// Grid: (batch, num_layers) blocks.
+__global__ void lstm_forward_kernel(
+    const float* __restrict__ x,        // layer0 input: [batch, seq, input_size]
+    const float* __restrict__ weight_ih_l0, // [4*hidden, input_size]
+    const float* __restrict__ weight_hh_l0, // [4*hidden, hidden]
+    const float* __restrict__ bias_l0,      // [4*hidden] combined bias
+    const float* __restrict__ weight_ih_l1, // [4*hidden, hidden]
+    const float* __restrict__ weight_hh_l1, // [4*hidden, hidden]
+    const float* __restrict__ bias_l1,      // [4*hidden] combined bias
+    float* __restrict__ y,             // output [batch, seq, hidden]
+    float* __restrict__ h_n,           // [2, batch, hidden]
+    float* __restrict__ c_n,           // [2, batch, hidden]
+    int batch,
+    int seq_len,
+    int input_size,
+    int hidden_size) {
+
+  extern __shared__ float smem[];
+  // Layout: h[hidden_size], c[hidden_size], then gates[HIDDEN]
+  int bid = blockIdx.x;   // batch index
+  int layer = blockIdx.y; // layer index (0 or 1)
+
+  // For layer 0, input feature dim = input_size; for layer 1, = hidden_size
+  int in_dim = (layer == 0) ? input_size : hidden_size;
+
+  // Determine weights and bias for this layer
+  const float* W_ih = (layer == 0) ? weight_ih_l0 : weight_ih_l1;
+  const float* W_hh = (layer == 0) ? weight_hh_l0 : weight_hh_l1;
+  const float* bias = (layer == 0) ? bias_l0 : bias_l1;
+
+  // Input pointer: for layer 0 use x[bid]; for layer 1 use y[bid] already computed? 
+  // Since layers are processed sequentially, we launch kernel with same grid, but 
+  // layer1 depends on layer0 output. We assume layer0 is computed first and __syncthreads 
+  // across blocks is not possible. Instead, we organize a single kernel with two phases, 
+  // or call kernel twice.
+  // Here we implement a single kernel that loops over layers internally, using global sync? 
+  // Too complex. Simpler: launch kernel once with gridDim.y = batch, and inside loop over time, 
+  // after each time step for layer0, we need to store output, then layer1 can read it.
+  // However, different blocks handle different batch, so no dependency across blocks.
+  // For a given batch, layer0 and layer1 of same time step can be computed sequentially within 
+  // the same block if we allocate separate shared memory? But hidden states for both layers needed.
+  // We can compute both layers within one block: process time step t: compute layer0 gates using x[t], 
+  // update h0,c0, write y0[t]; then compute layer1 gates using y0[t], update h1,c1, write y[t].
+  // This requires h0,c0 and h1,c1 stored in shared memory. We'll do that.
+  // Therefore gridDim = (batch) only, and we compute both layers per block.
+  // However, the kernel below currently assumes gridDim.y = num_layers; adjust to one block per batch.
+  // We'll rewrite appropriately.
+}
+
+// Launcher will call a kernel that processes both layers per batch block.
+extern "C" void lstm_forward_launcher(
