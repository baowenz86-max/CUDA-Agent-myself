+    const float* weight_ih_l1,
+    const float* weight_hh_l1,
+    const float* bias_ih_l1,
+    const float* bias_hh_l1,
+    float* y,
+    float* h_n,
+    float* c_n,
+    int batch,
+    int seq_len,
+    int input_size,
+    int hidden_size,
+    cudaStream_t stream) {
+  // Placeholder: not used, actual implementation below in separate kernel.
+}
+
+// Actual LSTM kernel: one block per batch, processes both layers.
+__global__ void lstm_forward_combined_kernel(
+    const float* __restrict__ x,
+    const float* __restrict__ weight_ih_l0, // [4H, input_size]
+    const float* __restrict__ weight_hh_l0, // [4H, H]
+    const float* __restrict__ bias_l0,      // [4H]
+    const float* __restrict__ weight_ih_l1, // [4H, H]
+    const float* __restrict__ weight_hh_l1, // [4H, H]
+    const float* __restrict__ bias_l1,      // [4H]
+    float* __restrict__ y,                  // [batch, seq, H]
+    float* __restrict__ h_n,                // [2, batch, H]
+    float* __restrict__ c_n,                // [2, batch, H]
+    int batch,
+    int seq_len,
+    int input_size,
+    int hidden_size) {
+
+  int bid = blockIdx.x;
+  if (bid >= batch) return;
+
+  const int H = hidden_size;
+  const int I = input_size;
+
+  // Shared memory: h0[H], c0[H], h1[H], c1[H]
+  extern __shared__ float smem[];
+  float* h0 = smem;
+  float* c0 = smem + H;
+  float* h1 = smem + 2 * H;
+  float* c1 = smem + 3 * H;
+
+  // Initialize hidden and cell states to zero
+  int tid = threadIdx.x;
+  int threads = blockDim.x;
+  for (int i = tid; i < H; i += threads) {
+    h0[i] = 0.0f;
+    c0[i] = 0.0f;
+    h1[i] = 0.0f;
+    c1[i] = 0.0f;
+  }
+  __syncthreads();
+
+  // Base pointers for this batch
+  const float* x_b = x + (int64_t)bid * seq_len * I;
+  float* y_b = y + (int64_t)bid * seq_len * H;
+
+  // Gate computation helpers (assume H threads to cover H, if blockDim < H, loop)
+  // We use blockDim threads, typically 256, and H=256, so one thread per hidden unit.
+
+  for (int t = 0; t < seq_len; ++t) {
+    // ----- Layer 0 -----
+    const float* x_t = x_b + t * I;
+    // gate arrays in shared memory: i, f, g, o (each size H)
+    // Reuse additional shared memory beyond h/c, need allocation in launcher
+    // For simplicity, compute each gate one by one using temporary thread-local registers? 
+    // Better: allocate gates in shared memory: i0,f0,g0,o0,i1,f1,g1,o1 => 8*H floats
+    // We'll declare shmem size accordingly in launcher.
+
+    // Since we already defined only 4 arrays for states, we'll place gates after.
+    // In this kernel, we assume shared memory size = (4 + 8) * H * sizeof(float).
+    float* i0 = smem + 4 * H;
+    float* f0 = smem + 5 * H;
+    float* g0 = smem + 6 * H;
+    float* o0 = smem + 7 * H;
+    float* i1 = smem + 8 * H;
+    float* f1 = smem + 9 * H;
+    float* g1 = smem + 10 * H;
+    float* o1 = smem + 11 * H;
+
+    // Compute gates for layer0: for each hidden index j (0..H-1)
+    for (int j = tid; j < H; j += threads) {
+      float pre_i = bias_l0[j];
+      float pre_f = bias_l0[H + j];
+      float pre_g = bias_l0[2 * H + j];
+      float pre_o = bias_l0[3 * H + j];
+
+      // Input contribution: sum over k
+      for (int k = 0; k < I; ++k) {
+        float x_val = x_t[k];
+        pre_i += weight_ih_l0[j * I + k] * x_val;
+        pre_f += weight_ih_l0[(H + j) * I + k] * x_val;
+        pre_g += weight_ih_l0[(2 * H + j) * I + k] * x_val;
+        pre_o += weight_ih_l0[(3 * H + j) * I + k] * x_val;
+      }
+      // Hidden contribution
+      for (int k = 0; k < H; ++k) {
+        float h_val = h0[k];
+        pre_i += weight_hh_l0[j * H + k] * h_val;
+        pre_f += weight_hh_l0[(H + j) * H + k] * h_val;
+        pre_g += weight_hh_l0[(2 * H + j) * H + k] * h_val;
+        pre_o += weight_hh_l0[(3 * H + j) * H + k] * h_val;
+      }
+
+      i0[j] = sigmoidf(pre_i);
+      f0[j] = sigmoidf(pre_f);
+      g0[j] = tanhf(pre_g);
+      o0[j] = sigmoidf(pre_o);
+    }
+    __syncthreads();
+
+    // Update c0 and h0 for layer0
+    for (int j = tid; j < H; j += threads) {
+      c0[j] = f0[j] * c0[j] + i0[j] * g0[j];
+      h0[j] = o0[j] * tanhf(c0[j]);
+      // Store layer0 output to y_b (this will be input to layer1)
+      y_b[t * H + j] = h0[j];
+    }
+    __syncthreads();
+
+    // ----- Layer 1 -----
+    // Input for layer1 is y_b[t * H + ...] which is h0
+    // We can read from shared h0 (already synchronized)
+    const float* in1 = h0; // alias to h0 (layer0 output at current time)
+
+    for (int j = tid; j < H; j += threads) {
+      float pre_i = bias_l1[j];
+      float pre_f = bias_l1[H + j];
+      float pre_g = bias_l1[2 * H + j];
+      float pre_o = bias_l1[3 * H + j];
+
+      for (int k = 0; k < H; ++k) {
+        float val = in1[k]; // h0[k]
+        pre_i += weight_ih_l1[j * H + k] * val;
+        pre_f += weight_ih_l1[(H + j) * H + k] * val;
+        pre_g += weight_ih_l1[(2 * H + j) * H + k] * val;
+        pre_o += weight_ih_l1[(3 * H + j) * H + k] * val;
+      }
+      for (int k = 0; k < H; ++k) {
+        float h_val = h1[k];
+        pre_i += weight_hh_l1[j * H + k] * h_val;
+        pre_f += weight_hh_l1[(H + j) * H + k] * h_val;
+        pre_g += weight_hh_l1[(2 * H + j) * H + k] * h_val;
+        pre_o += weight_hh_l1[(3 * H + j) * H + k] * h_val;
+      }
+
+      i1[j] = sigmoidf(pre_i);
+      f1[j] = sigmoidf(pre_f);
+      g1[j] = tanhf(pre_g);
+      o1[j] = sigmoidf(pre_o);
+    }
+    __syncthreads();
+
+    // Update c1 and h1 for layer1
+    for (int j = tid; j < H; j += threads) {
+      c1[j] = f1[j] * c1[j] + i1[j] * g1[j];
+      h1[j] = o1[j] * tanhf(c1[j]);
+      // Store final output y_b[t * H + j]
+      y_b[t * H + j] = h1[j];
+    }
+    __syncthreads();
+  }
+
+  // After all time steps, write final h_n and c_n for this batch (layer 0 and 1)
+  for (int j = tid; j < H; j += threads) {
+    h_n[0 * batch * H + bid * H + j] = h0[j];  // layer 0 h_n
+    c_n[0 * batch * H + bid * H + j] = c0[j];
+    h_n[1 * batch * H + bid * H + j] = h1[j];  // layer 1 h_n
+    c_n[1 * batch * H + bid * H + j] = c1[j];
+  }
+}
