--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,108 @@
+#include <cuda_runtime.h>
+
+// Elementwise clamp kernel: y = min(max(x, min_val), max_val)
+// Supports arbitrary strides via flat indexing and loop over elements.
+__global__ void clamp_kernel(const float* __restrict__ input,
+                             float* __restrict__ output,
+                             float min_val,
+                             float max_val,
+                             long long numel) {
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long stride = (long long)gridDim.x * blockDim.x;
+    for (long long i = idx; i < numel; i += stride) {
+        float val = input[i];
+        val = val < min_val ? min_val : val;
+        val = val > max_val ? max_val : val;
+        output[i] = val;
+    }
+}
+
+// Adaptive average pooling kernel for 4D input (N, C, H, W).
+// The input may be non-contiguous; we pass strides (in elements) for each dimension.
+// output_size is (H_out, W_out).
+// Each thread computes one output element (n, c, oh, ow).
+__global__ void adaptive_avg_pool2d_kernel(const float* __restrict__ input,
+                                           float* __restrict__ output,
+                                           int N, int C, int H_in, int W_in,
+                                           int H_out, int W_out,
+                                           long long stride_N, long long stride_C,
+                                           long long stride_H, long long stride_W,
+                                           long long out_stride_N, long long out_stride_C,
+                                           long long out_stride_H, long long out_stride_W) {
+    long long total_output = (long long)N * C * H_out * W_out;
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long grid_stride = (long long)gridDim.x * blockDim.x;
+
+    for (long long out_linear = idx; out_linear < total_output; out_linear += grid_stride) {
+        // Decode output indices (n, c, oh, ow)
+        int ow = out_linear % W_out;
+        long long tmp = out_linear / W_out;
+        int oh = tmp % H_out;
+        tmp /= H_out;
+        int c = tmp % C;
+        tmp /= C;
+        int n = tmp; // tmp < N
+
+        // Adaptive window boundaries
+        int h_start = (int)floorf((float)oh * H_in / H_out);
+        int h_end   = (int)ceilf((float)(oh + 1) * H_in / H_out);
+        int w_start = (int)floorf((float)ow * W_in / W_out);
+        int w_end   = (int)ceilf((float)(ow + 1) * W_in / W_out);
+
+        // Ensure at least one element
+        if (h_end <= h_start) h_end = h_start + 1;
+        if (w_end <= w_start) w_end = w_start + 1;
+
+        float sum = 0.0f;
+        for (int h = h_start; h < h_end; ++h) {
+            for (int w = w_start; w < w_end; ++w) {
+                long long input_offset = (long long)n * stride_N
+                                        + (long long)c * stride_C
+                                        + (long long)h * stride_H
+                                        + (long long)w * stride_W;
+                sum += input[input_offset];
+            }
+        }
+        float count = (float)((h_end - h_start) * (w_end - w_start));
+
+        long long output_offset = (long long)n * out_stride_N
+                                 + (long long)c * out_stride_C
+                                 + (long long)oh * out_stride_H
+                                 + (long long)ow * out_stride_W;
+        output[output_offset] = sum / count;
+    }
+}
+
+extern "C" void clamp_forward_launcher(const float* input,
+                                       float* output,
+                                       float min_val,
+                                       float max_val,
+                                       long long numel,
+                                       cudaStream_t stream) {
+    if (numel <= 0) return;
+    int block_size = 256;
+    long long grid_size = (numel + block_size - 1) / block_size;
+    // Limit grid to avoid excessive launches
+    if (grid_size > 65535) grid_size = 65535;
+    clamp_kernel<<<(int)grid_size, block_size, 0, stream>>>(
+        input, output, min_val, max_val, numel);
+}
+
+extern "C" void adaptive_avg_pool2d_forward_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H_in, int W_in,
+    int H_out, int W_out,
+    long long stride_N, long long stride_C, long long stride_H, long long stride_W,
+    long long out_stride_N, long long out_stride_C, long long out_stride_H, long long out_stride_W,
+    cudaStream_t stream) {
+    long long total_output = (long long)N * C * H_out * W_out;
+    if (total_output <= 0) return;
+    int block_size = 256;
+    long long grid_size = (total_output + block_size - 1) / block_size;
+    if (grid_size > 65535) grid_size = 65535;
+    adaptive_avg_pool2d_kernel<<<(int)grid_size, block_size, 0, stream>>>(
+        input, output, N, C, H_in, W_in, H_out, W_out,
+        stride_N, stride_C, stride_H, stride_W,
+        out_stride_N, out_stride_C, out_stride_H, out_stride_W);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,102 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void clamp_forward_launcher(
+    const float* input,
+    float* output,
+    float min_val,
+    float max_val,
+    long long numel,
+    cudaStream_t stream);
+
+extern "C" void adaptive_avg_pool2d_forward_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H_in, int W_in,
+    int H_out, int W_out,
+    long long stride_N, long long stride_C, long long stride_H, long long stride_W,
+    long long out_stride_N, long long out_stride_C, long long out_stride_H, long long out_stride_W,
+    cudaStream_t stream);
+
+// Wrapper for clamp
+torch::Tensor clamp_forward(torch::Tensor x, double min_val, double max_val) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "Input must be float32");
+    // clamps supports any strides; no contiguous requirement
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    clamp_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<float>(min_val),
+        static_cast<float>(max_val),
+        x.numel(),
+        stream);
+
+    return output;
+}
+
+// Wrapper for adaptive average pooling
+// output_size is a tuple of two ints; we use py::tuple to accept it and extract ints.
+torch::Tensor adaptive_avg_pool2d_forward(torch::Tensor x, py::tuple output_size) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 4, "adaptive_avg_pool2d expects 4D input (N,C,H,W)");
+
+    // Extract output sizes
+    if (py::len(output_size) != 2) {
+        throw std::invalid_argument("output_size must be a tuple of two ints");
+    }
+    int H_out = output_size[0].cast<int>();
+    int W_out = output_size[1].cast<int>();
+    TORCH_CHECK(H_out > 0 && W_out > 0, "output_size values must be positive");
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H_in = x.size(2);
+    int W_in = x.size(3);
+
+    // Prepare output tensor with shape (N, C, H_out, W_out) and float32
+    auto output = torch::empty({N, C, H_out, W_out}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Compute input strides (in elements); x may be non-contiguous
+    long long stride_N = x.stride(0);
+    long long stride_C = x.stride(1);
+    long long stride_H = x.stride(2);
+    long long stride_W = x.stride(3);
+
+    // Output is contiguous, so strides are in standard order
+    long long out_stride_N = output.stride(0);
+    long long out_stride_C = output.stride(1);
+    long long out_stride_H = output.stride(2);
+    long long out_stride_W = output.stride(3);
+
+    adaptive_avg_pool2d_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        N, C, H_in, W_in,
+        H_out, W_out,
+        stride_N, stride_C, stride_H, stride_W,
+        out_stride_N, out_stride_C, out_stride_H, out_stride_W,
+        stream);
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("clamp_forward", &clamp_forward,
+          "Clamp tensor to [min_val, max_val]",
+          py::arg("x"), py::arg("min_val"), py::arg("max_val"));
+    m.def("adaptive_avg_pool2d_forward", &adaptive_avg_pool2d_forward,
+          "Adaptive average pooling 2D",
+          py::arg("x"), py::arg("output_size"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,21 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, pooling_size):
+        super().__init__()
+        self.pooling_size = pooling_size
+
+    def forward(self, x):
+        x = cuda_extension.clamp_forward(x, 0.0, 1.0)
+        x = cuda_extension.adaptive_avg_pool2d_forward(x, self.pooling_size)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.clamp_forward(x, 0.0, 1.0)
+        yield 'step_001', x
+        x = cuda_extension.adaptive_avg_pool2d_forward(x, self.pooling_size)
+        yield 'step_002', x
+        yield 'step_003', x
