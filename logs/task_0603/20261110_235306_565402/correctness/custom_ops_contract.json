{
  "operators": [
    {
      "name": "custom_gelu",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as reference step",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "对应参考语句 x = F.gelu(x)，使用默认近似 tanh 公式。",
        "输入形状 [512, 64, 64, 128]，输出逐元素应用 GELU。",
        "根据参考 F.gelu 默认 approximate='none'，公式为 x * 0.5 * (1 + erf(x / sqrt(2)))。",
        "输出 dtype 与输入相同 float32，device 为 cuda，shape 与输入相同。"
      ]
    },
    {
      "name": "custom_mean_dim1",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, H, W]"
      },
      "semantics": [
        "对应参考语句 x = torch.mean(x, dim=1)，沿 dim=1 求均值。",
        "输入形状 [512, 64, 64, 128]，输出形状 [512, 64, 128]。",
        "输出元素为输入在 dim=1 上所有元素的算术平均值。",
        "输出 dtype 与输入相同 float32，device 为 cuda。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = F.gelu(x)",
      "semantics": [
        "对输入 x 逐元素应用 GELU 激活函数，默认 approximate='none'。",
        "输入形状 [512, 64, 64, 128]，输出形状相同，dtype float32，device cuda。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.mean(x, dim=1)",
      "semantics": [
        "沿 dim=1 对张量求均值，保持其他维度不变。",
        "输入形状 [512, 64, 64, 128]，输出形状 [512, 64, 128]，dtype float32，device cuda。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回上一步计算得到的均值张量，形状 [512, 64, 128]，dtype float32，device cuda。"
      ]
    }
  ]
}