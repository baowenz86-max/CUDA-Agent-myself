{
  "operators": [
    {
      "name": "cat_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, seq, input_size]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "half_size",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "cat_dim",
          "kind": "int",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[batch, 2*seq, half_size] when cat_dim=1, otherwise adjusted"
      },
      "semantics": [
        "Splits input x into x1 = x[:, :, :half_size] and x2 = x[:, :, half_size:].",
        "Concatenates x1 and x2 along cat_dim which is 1 in this task.",
        "The output shape is [128, 4000, 256] for given inputs.",
        "Returned tensor is a new contiguous tensor on CUDA."
      ]
    },
    {
      "name": "argmax_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[batch, seq, input_size]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.int64",
        "device": "cuda",
        "shape": "[batch, seq]"
      },
      "semantics": [
        "Computes argmax of x along dimension dim, which is 2 in this task.",
        "Returns int64 indices on CUDA.",
        "The output shape is [128, 2000] for given inputs."
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "half_size = self.input_size // 2",
      "semantics": [
        "Integer division by 2; for input_size=512, half_size=256."
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x1, x2 = (x[:, :, :half_size], x[:, :, half_size:])",
      "semantics": [
        "x1 is the first half along last dimension: shape [128, 2000, 256].",
        "x2 is the second half along last dimension: shape [128, 2000, 256].",
        "Both tensors are views sharing storage with x, but in debug_forward we return tensors with same values."
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "cat_result = torch.cat((x1, x2), dim=self.cat_dim)",
      "semantics": [
        "Concatenate along cat_dim=1; output shape [128, 4000, 256]."
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "argmax_result = torch.argmax(x, dim=self.argmax_dim)",
      "semantics": [
        "Compute argmax along last dimension; output shape [128, 2000], dtype int64."
      ]
    },
    {
      "checkpoint": "step_005",
      "source": "return (cat_result, argmax_result)",
      "semantics": [
        "Return tuple of cat_result and argmax_result."
      ]
    }
  ]
}