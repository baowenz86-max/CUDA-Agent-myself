--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,76 @@
+#include <cuda_runtime.h>
+
+// CUDA kernel for pixel_unshuffle
+// Input: float* input, arbitrary strides
+// Output: float* output, contiguous
+// The operation: output[b, c*r*r + i*r + j, h, w] = input[b, c, h*r + i, w*r + j]
+// where r = downscale_factor
+__global__ void pixel_unshuffle_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int N, int C, int H, int W, int r,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,
+    long long total_elements)
+{
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = blockDim.x * gridDim.x;
+    for (long long linear_idx = idx; linear_idx < total_elements; linear_idx += stride) {
+        // Decode linear index into output coordinates: (n, oc, oh, ow)
+        int ow = linear_idx % W;
+        long long tmp = linear_idx / W;
+        int oh = tmp % H;
+        tmp /= H;
+        int oc = tmp % (C * r * r);
+        int n = tmp / (C * r * r);
+
+        // From oc, derive c and (i,j)
+        int c = oc / (r * r);
+        int rem = oc % (r * r);
+        int i = rem / r;
+        int j = rem % r;
+
+        // Input coordinates
+        int iw = ow * r + j;
+        int ih = oh * r + i;
+
+        // Input offset using strides
+        long long in_offset = (long long)n * in_stride_n + (long long)c * in_stride_c
+                            + (long long)ih * in_stride_h + (long long)iw * in_stride_w;
+        long long out_offset = (long long)n * out_stride_n + (long long)oc * out_stride_c
+                             + (long long)oh * out_stride_h + (long long)ow * out_stride_w;
+
+        output[out_offset] = input[in_offset];
+    }
+}
+
+// Launcher function (extern "C" for easy binding)
+extern "C" void pixel_unshuffle_custom_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W, int r,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,
+    cudaStream_t stream)
+{
+    int out_H = H / r;
+    int out_W = W / r;
+    int out_C = C * r * r;
+    long long total_elements = (long long)N * out_C * out_H * out_W;
+
+    if (total_elements == 0) return;
+
+    // Configure grid and block
+    int block_size = 256;
+    // Grid-stride: use enough blocks to cover but not excessive; cap at some reasonable number
+    long long blocks_needed = (total_elements + block_size - 1) / block_size;
+    // Limit grid to avoid excessive launch for small tensors
+    int grid_size = (int)min(blocks_needed, (long long)65535);
+    // But for very large tensors grid_size can be up to 65535 as well (max grid dim in x for CUDA)
+    pixel_unshuffle_kernel<<<grid_size, block_size, 0, stream>>>(
+        input, output,
+        N, C, H, W, r,
+        in_stride_n, in_stride_c, in_stride_h, in_stride_w,
+        out_stride_n, out_stride_c, out_stride_h, out_stride_w,
+        total_elements);
+}
--- before/kernels/pixel_unshuffle_binding.cpp
+++ after/kernels/pixel_unshuffle_binding.cpp
@@ -0,0 +1,76 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launcher from custom_ops.cu
+extern "C" void pixel_unshuffle_custom_launcher(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W, int r,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,
+    cudaStream_t stream);
+
+torch::Tensor pixel_unshuffle_custom(torch::Tensor x, int64_t downscale_factor) {
+    // Validate input
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D (N, C, H, W)");
+    int r = static_cast<int>(downscale_factor);
+    TORCH_CHECK(r > 0, "downscale_factor must be positive");
+    int64_t N = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+    TORCH_CHECK(H % r == 0 && W % r == 0, "H and W must be divisible by downscale_factor");
+
+    int64_t out_H = H / r;
+    int64_t out_W = W / r;
+    int64_t out_C = C * r * r;
+
+    // Allocate output tensor (contiguous)
+    auto output = torch::empty({N, out_C, out_H, out_W}, x.options());
+
+    // Get strides
+    auto in_strides = x.strides();
+    auto out_strides = output.strides();
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher; note launcher expects int sizes but input may exceed int range? For safety use int64_t passing as int is okay as long as dimensions fit in int (which they do here)
+    pixel_unshuffle_custom_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        static_cast<int>(N),
+        static_cast<int>(C),
+        static_cast<int>(H),
+        static_cast<int>(W),
+        r,
+        static_cast<long long>(in_strides[0]),
+        static_cast<long long>(in_strides[1]),
+        static_cast<long long>(in_strides[2]),
+        static_cast<long long>(in_strides[3]),
+        static_cast<long long>(out_strides[0]),
+        static_cast<long long>(out_strides[1]),
+        static_cast<long long>(out_strides[2]),
+        static_cast<long long>(out_strides[3]),
+        stream
+    );
+
+    // Check for CUDA errors after launch
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+void register_pixel_unshuffle(pybind11::module& m) {
+    m.def("pixel_unshuffle_custom", &pixel_unshuffle_custom,
+          "Pixel unshuffle custom op",
+          pybind11::arg("x"), pybind11::arg("downscale_factor"));
+}
+
+REGISTER_BINDING(pixel_unshuffle, register_pixel_unshuffle);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,22 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, upscale_factor):
+        super().__init__()
+        self.upscale_factor = upscale_factor
+
+    def forward(self, x):
+        # x is assumed to be on the correct device; if not, move it
+        if not x.is_cuda:
+            x = x.cuda()
+        return cuda_extension.pixel_unshuffle_custom(x, self.upscale_factor)
+
+    def debug_forward(self, x):
+        # Same computation as forward but yield intermediate checkpoints
+        if not x.is_cuda:
+            x = x.cuda()
+        out = cuda_extension.pixel_unshuffle_custom(x, self.upscale_factor)
+        yield "step_001", out
