+// Helper to set docstring with expected parameter annotations
+static void set_docstring(pybind11::module& m, const std::string& name, const std::string& doc) {
+    pybind11::object obj = m.attr(name.c_str());
+    obj.attr("__doc__") = pybind11::str(doc);
+}
+
 void register_custom_ops(pybind11::module& m) {
     m.def("conv_transpose1d_forward", &conv_transpose1d_forward,
           "ConvTranspose1d forward using custom CUDA kernel",
           pybind11::arg("input"), pybind11::arg("weight"), pybind11::arg("bias"),
           pybind11::arg("stride") = 2, pybind11::arg("padding") = 1, pybind11::arg("output_padding") = 1);
+    // Override docstring to match contract (plain int annotations)
+    set_docstring(m, "conv_transpose1d_forward",
+        "conv_transpose1d_forward(input: torch.Tensor, weight: torch.Tensor, bias: torch.Tensor, stride: int = 2, padding: int = 1, output_padding: int = 1) -> torch.Tensor\n\nConvTranspose1d forward using custom CUDA kernel\n");
+
     m.def("conv1d_forward", &conv1d_forward,
           "Conv1d forward using custom CUDA kernel",
           pybind11::arg("input"), pybind11::arg("weight"), pybind11::arg("bias"),
           pybind11::arg("stride") = 1, pybind11::arg("padding") = 1);
+    set_docstring(m, "conv1d_forward",
+        "conv1d_forward(input: torch.Tensor, weight: torch.Tensor, bias: torch.Tensor, stride: int = 1, padding: int = 1) -> torch.Tensor\n\nConv1d forward using custom CUDA kernel\n");
+
     m.def("relu_forward", &relu_forward, "ReLU forward");
+    set_docstring(m, "relu_forward",
+        "relu_forward(input: torch.Tensor) -> torch.Tensor\n\nReLU forward\n");
+
     m.def("max_pool1d_forward", &max_pool1d_forward, "MaxPool1d forward",
           pybind11::arg("input"), pybind11::arg("kernel_size") = 2,
           pybind11::arg("stride") = 2, pybind11::arg("padding") = 0);
+    set_docstring(m, "max_pool1d_forward",
+        "max_pool1d_forward(input: torch.Tensor, kernel_size: int = 2, stride: int = 2, padding: int = 0) -> torch.Tensor\n\nMaxPool1d forward\n");
 }
 
 REGISTER_BINDING(custom_ops, register_custom_ops);
