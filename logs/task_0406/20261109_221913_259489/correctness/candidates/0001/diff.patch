--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,184 @@
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// Kernel for max reduction over dimension 1 (channels) with keepdim semantics.
+// Input tensor shape: [batch, C, H, W]
+// Output values shape: [batch, 1, H, W]
+// Output indices shape: [batch, 1, H, W] (int64)
+// Supports arbitrary strides for input, values, and indices.
+__global__ void max_dim1_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ values,
+    int64_t* __restrict__ indices,
+    int batch,
+    int C,
+    int H,
+    int W,
+    long long input_stride_b,
+    long long input_stride_c,
+    long long input_stride_h,
+    long long input_stride_w,
+    long long out_stride_b,
+    long long out_stride_h,
+    long long out_stride_w)
+{
+    int64_t total = (int64_t)batch * H * W;
+    int64_t idx = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)gridDim.x * blockDim.x;
+
+    for (int64_t linear = idx; linear < total; linear += stride) {
+        int b = linear / (H * W);
+        int rem = linear % (H * W);
+        int h = rem / W;
+        int w = rem % W;
+
+        const float* in_base = input + b * input_stride_b + h * input_stride_h + w * input_stride_w;
+        float max_val = in_base[0];
+        int64_t max_idx = 0;
+
+        for (int c = 1; c < C; ++c) {
+            float val = in_base[c * input_stride_c];
+            if (val > max_val) {
+                max_val = val;
+                max_idx = c;
+            }
+        }
+
+        float* out_val = values + b * out_stride_b + h * out_stride_h + w * out_stride_w;
+        int64_t* out_idx = indices + b * out_stride_b + h * out_stride_h + w * out_stride_w;
+        *out_val = max_val;
+        *out_idx = max_idx;
+    }
+}
+
+// Kernel for ReLU elementwise: output = max(input, 0)
+// Handles arbitrary strides.
+__global__ void relu_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int64_t total,
+    const int64_t* __restrict__ input_strides,  // array of strides for each dimension (ndim)
+    const int64_t* __restrict__ output_strides,
+    int ndim)
+{
+    int64_t idx = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)gridDim.x * blockDim.x;
+
+    for (int64_t linear = idx; linear < total; linear += stride) {
+        int64_t remaining = linear;
+        int64_t in_offset = 0;
+        int64_t out_offset = 0;
+        // Compute multidimensional indices from linear index using output shape
+        // We assume shapes for input and output are identical.
+        // Since we don't have shapes here, we use strides and total numel.
+        // This trick works only if we assume the tensor has no zero dimensions
+        // and is contiguous in the sense that linear index maps to offset via strides.
+        // To be fully general, we would need shape information; however, the launcher
+        // will pass pointer to shape and we can use the same approach as max kernel.
+        // But to keep simple and correct for the given task, we will use a different approach:
+        // For ReLU, we can treat input and output as 4D tensors of shape [batch, 1, H, W]
+        // because in this specific usage, the input to relu is the values from max_dim1,
+        // which has shape [batch, 1, H, W] and is contiguous (as created by torch.empty_like).
+        // We will implement a specialized 4D ReLU kernel for this case.
+        // However, to maintain generality, we could write a generic ndim kernel with shape.
+        // Given the contract, only this specific shape is used, so we implement a 4D version.
+        // Thus, we remove the generic version and use a specialized one below.
+    }
+}
+
+// Specialized ReLU kernel for 4D tensors of shape [batch, 1, H, W] with arbitrary strides.
+__global__ void relu_4d_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int batch,
+    int H,
+    int W,
+    long long input_stride_b,
+    long long input_stride_c,  // unused but for completeness
+    long long input_stride_h,
+    long long input_stride_w,
+    long long output_stride_b,
+    long long output_stride_c,
+    long long output_stride_h,
+    long long output_stride_w)
+{
+    int64_t total = (int64_t)batch * H * W;
+    int64_t idx = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)gridDim.x * blockDim.x;
+
+    for (int64_t linear = idx; linear < total; linear += stride) {
+        int b = linear / (H * W);
+        int rem = linear % (H * W);
+        int h = rem / W;
+        int w = rem % W;
+
+        const float* in_ptr = input + b * input_stride_b + h * input_stride_h + w * input_stride_w;
+        float* out_ptr = output + b * output_stride_b + h * output_stride_h + w * output_stride_w;
+        float val = *in_ptr;
+        *out_ptr = val > 0.0f ? val : 0.0f;
+    }
+}
+
+// Launcher for custom_max_dim1.
+// Input: x (float32 tensor, CUDA) shape [batch, C, H, W], arbitrary strides.
+// Output: values (float32) and indices (int64) shape [batch, 1, H, W], contiguous.
+// This launcher is called from the binding wrapper (to be implemented in C++).
+extern "C" void custom_max_dim1_launcher(
+    const float* x,
+    float* values,
+    int64_t* indices,
+    int batch,
+    int C,
+    int H,
+    int W,
+    long long x_stride_b,
+    long long x_stride_c,
+    long long x_stride_h,
+    long long x_stride_w,
+    long long out_stride_b,
+    long long out_stride_h,
+    long long out_stride_w,
+    cudaStream_t stream)
+{
+    int64_t total_elements = (int64_t)batch * H * W;
+    int block_size = 256;
+    int grid_size = (int)((total_elements + block_size - 1) / block_size);
+    if (grid_size > 65535) grid_size = 65535; // grid-stride loop handles rest
+
+    max_dim1_kernel<<<grid_size, block_size, 0, stream>>>(
+        x, values, indices,
+        batch, C, H, W,
+        x_stride_b, x_stride_c, x_stride_h, x_stride_w,
+        out_stride_b, out_stride_h, out_stride_w);
+}
+
+// Launcher for custom_relu.
+// Input: x (float32 tensor, CUDA) shape [batch, 1, H, W], arbitrary strides.
+// Output: float32 tensor same shape, contiguous.
+extern "C" void custom_relu_launcher(
+    const float* x,
+    float* output,
+    int batch,
+    int H,
+    int W,
+    long long x_stride_b,
+    long long x_stride_c,
+    long long x_stride_h,
+    long long x_stride_w,
+    long long out_stride_b,
+    long long out_stride_c,
+    long long out_stride_h,
+    long long out_stride_w,
+    cudaStream_t stream)
+{
+    int64_t total_elements = (int64_t)batch * H * W;
+    int block_size = 256;
+    int grid_size = (int)((total_elements + block_size - 1) / block_size);
+    if (grid_size > 65535) grid_size = 65535;
+
+    relu_4d_kernel<<<grid_size, block_size, 0, stream>>>(
+        x, output,
+        batch, H, W,
+        x_stride_b, x_stride_c, x_stride_h, x_stride_w,
+        out_stride_b, out_stride_c, out_stride_h, out_stride_w);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,146 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void custom_max_dim1_launcher(
+    const float* x,
+    float* values,
+    int64_t* indices,
+    int batch,
+    int C,
+    int H,
+    int W,
+    long long x_stride_b,
+    long long x_stride_c,
+    long long x_stride_h,
+    long long x_stride_w,
+    long long out_stride_b,
+    long long out_stride_h,
+    long long out_stride_w,
+    cudaStream_t stream);
+
+extern "C" void custom_relu_launcher(
+    const float* x,
+    float* output,
+    int batch,
+    int H,
+    int W,
+    long long x_stride_b,
+    long long x_stride_c,
+    long long x_stride_h,
+    long long x_stride_w,
+    long long out_stride_b,
+    long long out_stride_c,
+    long long out_stride_h,
+    long long out_stride_w,
+    cudaStream_t stream);
+
+// Helper to get current CUDA stream
+static cudaStream_t getCurrentStream() {
+    return c10::cuda::getCurrentCUDAStream().stream();
+}
+
+// Implementation of custom_max_dim1
+// Returns torch.return_types.max with values and indices
+py::object custom_max_dim1(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input tensor must be a CUDA tensor");
+    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "Input tensor must have dtype torch.float32");
+    TORCH_CHECK(x.dim() == 4, "Input tensor must be 4D (batch, C, H, W)");
+
+    int batch = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+
+    // Allocate output tensors: values float32, indices int64, shape [batch, 1, H, W], contiguous
+    auto values = torch::empty({batch, 1, H, W}, x.options());
+    auto indices = torch::empty({batch, 1, H, W}, x.options().dtype(torch::kInt64));
+
+    // Get strides (input may be non-contiguous)
+    long long x_stride_b = x.stride(0);
+    long long x_stride_c = x.stride(1);
+    long long x_stride_h = x.stride(2);
+    long long x_stride_w = x.stride(3);
+    long long out_stride_b = values.stride(0);
+    long long out_stride_h = values.stride(2);  // stride for dimension 1 is not used in kernel, but we still pass
+    long long out_stride_w = values.stride(3);
+    // The launcher expects out_stride_b, out_stride_h, out_stride_w (it ignores the channel dimension)
+    // Since output shape is [batch, 1, H, W], stride for dimension 0 and 2 are the same as values tensor's stride.
+    // But note: values.stride(1) is also out_stride_h? Actually for contiguous [batch,1,H,W], stride: (H*W, H*W, W, 1)
+    // The launcher uses out_stride_b, out_stride_h, out_stride_w; we should pass values.stride(0), values.stride(2), values.stride(3).
+    out_stride_b = values.stride(0);
+    out_stride_h = values.stride(2);
+    out_stride_w = values.stride(3);
+
+    cudaStream_t stream = getCurrentStream();
+
+    custom_max_dim1_launcher(
+        x.data_ptr<float>(),
+        values.data_ptr<float>(),
+        indices.data_ptr<int64_t>(),
+        batch, C, H, W,
+        x_stride_b, x_stride_c, x_stride_h, x_stride_w,
+        out_stride_b, out_stride_h, out_stride_w,
+        stream);
+
+    // Check for kernel launch errors
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "custom_max_dim1 kernel launch failed: ", cudaGetErrorString(err));
+
+    // Construct torch.return_types.max object
+    return py::module::import("torch").attr("return_types").attr("max")(values, indices);
+}
+
+// Implementation of custom_relu
+// Returns a tensor
+py::object custom_relu(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input tensor must be a CUDA tensor");
+    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "Input tensor must have dtype torch.float32");
+    TORCH_CHECK(x.dim() == 4, "Input tensor must be 4D (batch, 1, H, W)");
+
+    int batch = x.size(0);
+    // Channel dimension is expected to be 1 based on contract, but we don't explicitly check; kernel ignores it.
+    int H = x.size(2);
+    int W = x.size(3);
+
+    // Allocate output tensor with same shape as input, contiguous
+    auto output = torch::empty_like(x, x.options().memory_format(torch::MemoryFormat::Contiguous));
+
+    long long x_stride_b = x.stride(0);
+    long long x_stride_c = x.stride(1);
+    long long x_stride_h = x.stride(2);
+    long long x_stride_w = x.stride(3);
+    long long out_stride_b = output.stride(0);
+    long long out_stride_c = output.stride(1);
+    long long out_stride_h = output.stride(2);
+    long long out_stride_w = output.stride(3);
+
+    cudaStream_t stream = getCurrentStream();
+
+    custom_relu_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        batch, H, W,
+        x_stride_b, x_stride_c, x_stride_h, x_stride_w,
+        out_stride_b, out_stride_c, out_stride_h, out_stride_w,
+        stream);
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "custom_relu kernel launch failed: ", cudaGetErrorString(err));
+
+    return output;
+}
+
+// Registration function
+void register_custom_ops(pybind11::module& m) {
+    m.def("custom_max_dim1", &custom_max_dim1, "Custom max over dim=1 (keepdim=True) returning max values and indices",
+          py::arg("x"));
+    m.def("custom_relu", &custom_relu, "Custom ReLU activation",
+          py::arg("x"));
+}
+
+// Auto-register binding
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,27 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        # Step 1: max over channels, keepdim=True
+        max_result = cuda_extension.custom_max_dim1(x)  # returns torch.return_types.max
+        x = max_result.values
+        # Step 2: ReLU
+        x = cuda_extension.custom_relu(x)
+        return x
+
+    def debug_forward(self, x: torch.Tensor):
+        # Must yield (checkpoint_id, value) for each checkpoint in order
+        # Step 001: torch.max returns tuple (values, indices)
+        max_result = cuda_extension.custom_max_dim1(x)
+        yield ('step_001', (max_result.values, max_result.indices))
+        # Step 002: ReLU on values
+        x = cuda_extension.custom_relu(max_result.values)
+        yield ('step_002', x)
+        # Step 003: final return
+        yield ('step_003', x)
