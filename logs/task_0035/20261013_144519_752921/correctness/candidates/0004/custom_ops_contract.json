{
  "operators": [
    {
      "name": "upsample_bilinear2d",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "scale_factor",
          "kind": "float",
          "dtype": null,
          "device": null,
          "shape": null,
          "layout": null,
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C, H*scale_factor, W*scale_factor]"
      },
      "semantics": [
        "对应参考语句 self.upsample(x)，mode='bilinear', align_corners=False（PyTorch 默认）。",
        "scale_factor 为标量浮点数，输出尺寸为 floor(H*scale_factor) 和 floor(W*scale_factor)。",
        "输入为 float32 CUDA 张量，支持任意 stride。",
        "仅对最后两维进行双线性插值，batch 和 channel 保持不变。"
      ]
    },
    {
      "name": "logical_and_positive_less_than_one",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "same as input tensor",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.bool",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "对应参考语句 torch.logical_and(x > 0, x < 1)。",
        "逐元素计算 (x > 0) 和 (x < 1) 的逻辑与，输出 bool 张量。",
        "输入可能非连续但输出为连续标准 stride。",
        "不改变 shape 和 device。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.upsample(x)",
      "semantics": [
        "实际调用 nn.Upsample(scale_factor=2.0, mode='bilinear')，align_corners=False。",
        "输出 float32 [16,3,1024,2048]，stride 连续。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.logical_and(x > 0, x < 1)",
      "semantics": [
        "先计算 x > 0 和 x < 1 两个 bool 张量（可能为临时张量），再逐元素逻辑与。",
        "输出 bool [16,3,1024,2048]。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回 step_002 的结果，bool [16,3,1024,2048]。"
      ]
    }
  ]
}