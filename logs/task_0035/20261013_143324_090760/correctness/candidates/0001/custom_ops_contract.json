      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.upsample(x)",
      "semantics": [
        "输入张量 x 经 nn.Upsample(scale_factor=2.0, mode='bilinear') 上采样",
        "输出 shape [16, 3, 1024, 2048]，dtype float32，device cuda:0"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.logical_and(x > 0, x < 1)",
