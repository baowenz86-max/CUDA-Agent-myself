          "shape": "same as reference step_001 output",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.bool",
        "device": "cuda",
        "shape": "same as reference step_002 output"
      },
      "semantics": [
        "执行参考语句 torch.logical_and(x > 0, x < 1)",
