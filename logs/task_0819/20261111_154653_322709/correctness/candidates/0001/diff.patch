+extern "C" void absolute_launcher(const float* input, float* output, int n, cudaStream_t stream) {
+    int threads = 256;
+    int blocks = (n + threads - 1) / threads;
+    absolute_kernel<<<blocks, threads, 0, stream>>>(input, output, n);
+}
