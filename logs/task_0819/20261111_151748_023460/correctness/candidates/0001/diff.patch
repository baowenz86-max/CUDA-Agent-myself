+    torch::Tensor log_prob_output = torch::empty({batch_size, static_cast<int64_t>(n_classes)}, options);
+    torch::Tensor loss_output = torch::empty({batch_size}, options);
+    torch::Tensor mean_loss_output = torch::empty({}, options);
