--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,44 @@
+#include <cuda_runtime.h>
+
+// Kernel for concatenating two tensors of shape [N, C, H, W] along channel dimension (dim=1)
+// x1 and x2 have same shape [N, C1, H, W] and [N, C2, H, W], output shape [N, C1+C2, H, W]
+// All tensors are contiguous float32 arrays.
+__global__ void cat_dim1_kernel(float* __restrict__ out, const float* __restrict__ x1, const float* __restrict__ x2, long long C1, long long C2, long long H, long long W, long long total_elements) {
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = blockDim.x * gridDim.x;
+    for (long long i = idx; i < total_elements; i += stride) {
+        long long c = i / (H * W);
+        long long hw = i % (H * W);
+        if (c < C1) {
+            out[i] = x1[c * (H * W) + hw];
+        } else {
+            long long c2 = c - C1;
+            out[i] = x2[c2 * (H * W) + hw];
+        }
+    }
+}
+
+// Kernel for element-wise sigmoid: 1/(1+exp(-x))
+__global__ void sigmoid_kernel(const float* __restrict__ x, float* __restrict__ y, long long total_elements) {
+    long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    long long stride = blockDim.x * gridDim.x;
+    for (long long i = idx; i < total_elements; i += stride) {
+        y[i] = 1.0f / (1.0f + __expf(-x[i]));
+    }
+}
+
+extern "C" void cat_launcher(float* output, const float* x1, const float* x2, long long N, long long C1, long long C2, long long H, long long W, cudaStream_t stream) {
+    long long total_elements = N * (C1 + C2) * H * W;
+    const int block_size = 256;
+    // Calculate grid size capped at 65535, use grid-stride loop inside kernel.
+    int grid_size = (int)std::min((long long)65535, (total_elements + block_size - 1) / block_size);
+    if (grid_size == 0) grid_size = 1;
+    cat_dim1_kernel<<<grid_size, block_size, 0, stream>>>(output, x1, x2, C1, C2, H, W, total_elements);
+}
+
+extern "C" void sigmoid_launcher(const float* input, float* output, long long total_elements, cudaStream_t stream) {
+    const int block_size = 256;
+    int grid_size = (int)std::min((long long)65535, (total_elements + block_size - 1) / block_size);
+    if (grid_size == 0) grid_size = 1;
+    sigmoid_kernel<<<grid_size, block_size, 0, stream>>>(input, output, total_elements);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,92 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_runtime.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void cat_launcher(float* output, const float* x1, const float* x2, long long N, long long C1, long long C2, long long H, long long W, cudaStream_t stream);
+extern "C" void sigmoid_launcher(const float* input, float* output, long long total_elements, cudaStream_t stream);
+
+// Helper to check CUDA errors after kernel launches
+static void check_cuda_error() {
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "CUDA kernel launch failed: ", cudaGetErrorString(err));
+}
+
+// PyTorch wrapper for cat_forward
+torch::Tensor cat_forward(torch::Tensor x1, torch::Tensor x2, int64_t dim) {
+    // Validate inputs
+    TORCH_CHECK(x1.is_cuda(), "x1 must be a CUDA tensor");
+    TORCH_CHECK(x2.is_cuda(), "x2 must be a CUDA tensor");
+    TORCH_CHECK(x1.dtype() == torch::kFloat32, "x1 must be float32");
+    TORCH_CHECK(x2.dtype() == torch::kFloat32, "x2 must be float32");
+    TORCH_CHECK(x1.is_contiguous(), "x1 must be contiguous");
+    TORCH_CHECK(x2.is_contiguous(), "x2 must be contiguous");
+    TORCH_CHECK(dim == 1, "Only dim=1 is supported");
+    TORCH_CHECK(x1.dim() == 4 && x2.dim() == 4, "Inputs must be 4D tensors");
+    TORCH_CHECK(x1.size(0) == x2.size(0), "Batch dimension mismatch");
+    TORCH_CHECK(x1.size(2) == x2.size(2) && x1.size(3) == x2.size(3), "Spatial dimensions mismatch");
+
+    // Extract dimensions
+    long long N = x1.size(0);
+    long long C1 = x1.size(1);
+    long long C2 = x2.size(1);
+    long long H = x1.size(2);
+    long long W = x1.size(3);
+
+    // Allocate output tensor: shape [N, C1+C2, H, W]
+    auto output = torch::empty({N, C1 + C2, H, W}, x1.options());
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    cat_launcher(
+        output.data_ptr<float>(),
+        x1.data_ptr<float>(),
+        x2.data_ptr<float>(),
+        N, C1, C2, H, W,
+        stream
+    );
+    check_cuda_error();
+
+    return output;
+}
+
+// PyTorch wrapper for sigmoid_forward
+torch::Tensor sigmoid_forward(torch::Tensor x) {
+    // Validate input
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+
+    // Allocate output tensor
+    auto output = torch::empty_like(x);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Call launcher
+    sigmoid_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        x.numel(),
+        stream
+    );
+    check_cuda_error();
+
+    return output;
+}
+
+// Register bindings
+void register_custom_ops(pybind11::module& m) {
+    m.def("cat_forward", &cat_forward,
+          "Concatenate two tensors along dim=1",
+          py::arg("x1"), py::arg("x2"), py::arg("dim"));
+    m.def("sigmoid_forward", &sigmoid_forward,
+          "Apply sigmoid elementwise",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,21 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, out_channels):
+        super().__init__()
+        self.sigmoid = nn.Sigmoid()
+
+    def forward(self, x1, x2):
+        x = cuda_extension.cat_forward(x1, x2, dim=1)
+        x = cuda_extension.sigmoid_forward(x)
+        return x
+
+    def debug_forward(self, x1, x2):
+        x = cuda_extension.cat_forward(x1, x2, dim=1)
+        yield "step_001", x
+        x = cuda_extension.sigmoid_forward(x)
+        yield "step_002", x
+        yield "step_003", x
