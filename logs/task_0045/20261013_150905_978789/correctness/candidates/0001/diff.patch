--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,25 @@
+#include <cuda_runtime.h>
+
+__global__ void sigmoid_forward_kernel(const float* __restrict__ input,
+                                      float* __restrict__ output,
+                                      int64_t numel) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        float val = input[i];
+        output[i] = 1.0f / (1.0f + expf(-val));
+    }
+}
+
+extern "C" void sigmoid_forward_launcher(const float* input,
+                                         float* output,
+                                         int64_t numel,
+                                         cudaStream_t stream) {
+    const int block_size = 256;
+    int64_t grid_size = (numel + block_size - 1) / block_size;
+    if (grid_size > 2147483647) {
+        grid_size = 2147483647;
+    }
+    sigmoid_forward_kernel<<<(unsigned int)grid_size, block_size, 0, stream>>>(
+        input, output, numel);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,47 @@
+// PyTorch binding for sigmoid forward CUDA kernel
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Launcher declared in custom_ops.cu
+extern "C" void sigmoid_forward_launcher(const float* input,
+                                         float* output,
+                                         int64_t numel,
+                                         cudaStream_t stream);
+
+// PyTorch tensor wrapper
+torch::Tensor sigmoid_forward(torch::Tensor x) {
+    // Input validation
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+
+    // Allocate output same shape
+    auto output = torch::empty_like(x);
+
+    // Get current CUDA stream
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    // Launch kernel
+    sigmoid_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        x.numel(),
+        stream
+    );
+
+    // Optional: check for kernel errors (async errors are not caught here,
+    // but sync check can be done with cudaGetLastError if needed)
+    return output;
+}
+
+// Register with pybind
+void register_sigmoid_forward(pybind11::module& m) {
+    m.def("sigmoid_forward", &sigmoid_forward,
+          "Elementwise sigmoid forward",
+          pybind11::arg("x"));
+}
+
+REGISTER_BINDING(sigmoid_forward, register_sigmoid_forward);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,17 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x):
+        x = cuda_extension.sigmoid_forward(x)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.sigmoid_forward(x)
+        yield 'step_001', x
+        yield 'step_002', x
