    "kernels/custom_ops.cu": "// CUDA kernels for reflection_pad2d, ge_scalar, remainder_scalar\n#include <cuda_runtime.h>\n\n// Helper to reflect index in [0, dim-1]\n__device__ __forceinline__ int reflect_index(int idx, int dim) {\n    if (idx < 0) return -idx;\n    if (idx >= dim) return 2 * dim - idx - 2;\n    return idx;\n}\n\n// Kernel for reflection padding 2D with arbitrary padding sizes and strides\n__global__ void reflection_pad2d_kernel(\n    const float* __restrict__ input,\n    float* __restrict__ output,\n    int N, int C, int H, int W,\n    int pad_left, int pad_right, int pad_top, int pad_bottom,\n    int in_stride_n, int in_stride_c, int in_stride_h, int in_stride_w,\n    int out_stride_n, int out_stride_c, int out_stride_h, int out_stride_w,\n    int out_height, int out_width) {\n\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int total = N * C * out_height * out_width;\n    int stride = blockDim.x * gridDim.x;\n\n    for (int i = idx; i < total; i += stride) {\n        // Decode output index\n        int w = i % out_width;\n        int tmp = i / out_width;\n        int h = tmp % out_height;\n        tmp /= out_height;\n        int c = tmp % C;\n        int n = tmp / C;\n\n        // Compute corresponding input coordinates with reflection\n        int in_h = h - pad_top;\n        int in_w = w - pad_left;\n        in_h = reflect_index(in_h, H);\n        in_w = reflect_index(in_w, W);\n\n        // Read input value using strides\n        const float* in_ptr = input + n * in_stride_n + c * in_stride_c + in_h * in_stride_h + in_w * in_stride_w;\n        float val = *in_ptr;\n\n        // Write output\n        float* out_ptr = output + n * out_stride_n + c * out_stride_c + h * out_stride_h + w * out_stride_w;\n        *out_ptr = val;\n    }\n}\n\n// Kernel for ge_scalar: input >= scalar, output bool (as unsigned char)\n__global__ void ge_scalar_kernel(\n    const float* __restrict__ input,\n    unsigned char* __restrict__ output,\n    float scalar,\n    int total_elements,\n    int in_stride_n, int in_stride_c, int in_stride_h, int in_stride_w,\n    int H, int W, int C) {\n\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int stride = blockDim.x * gridDim.x;\n\n    for (int i = idx; i < total_elements; i += stride) {\n        // Decode index assuming contiguous output? But input may be non-contiguous.\n        // However, ge_scalar is applied on the padded tensor which is contiguous from our launcher.\n        // For generality, we handle non-contiguous by using strides.\n        // We assume output is contiguous with same shape. We need shape info: but total_elements suffices for flat index.\n        int w = i % W;\n        int tmp = i / W;\n        int h = tmp % H;\n        tmp /= H;\n        int c = tmp % C;\n        int n = tmp / C;\n\n        // Here we need shapes and strides. We'll pass them.\n        const float* in_ptr = input + n * in_stride_n + c * in_stride_c + h * in_stride_h + w * in_stride_w;\n        float val = *in_ptr;\n        unsigned char result = (val >= scalar) ? 1 : 0;\n        output[i] = result;\n    }\n}\n\n// Kernel for remainder_scalar: input (bool or int) % scalar, output int64.\n// We operate on bool input (as unsigned char) and output int64 (long long).\n__global__ void remainder_scalar_kernel(\n    const unsigned char* __restrict__ input,\n    long long* __restrict__ output,\n    double scalar,\n    int total_elements) {\n\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int stride = blockDim.x * gridDim.x;\n\n    for (int i = idx; i < total_elements; i += stride) {\n        // input is bool (0 or 1), scalar is 2.0 -> result 0 or 1 (as int64)\n        unsigned char val = input[i];\n        // Use Python-like modulo: result = val - floor(val/scalar)*scalar\n        // For val in {0,1}, scalar=2, result is 0 or 1.\n        double dval = (double)val;\n        double rem = dval - floor(dval / scalar) * scalar;\n        output[i] = (long long)rem;\n    }\n}\n\n// Launchers (extern \"C\")\n\nextern \"C\" void reflection_pad2d_forward(\n    const float* input,\n    float* output,\n    int N, int C, int H, int W,\n    int pad_left, int pad_right, int pad_top, int pad_bottom,\n    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,\n    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,\n    int out_height, int out_width,\n    cudaStream_t stream) {\n\n    int total = N * C * out_height * out_width;\n    int threads = 256;\n    int blocks = (total + threads - 1) / threads;\n    // Cap blocks to avoid excessive grid launch; use at most 65535 blocks for older GPUs\n    if (blocks > 65535) blocks = 65535;\n    reflection_pad2d_kernel<<<blocks, threads, 0, stream>>>(\n        input, output, N, C, H, W,\n        pad_left, pad_right, pad_top, pad_bottom,\n        (int)in_stride_n, (int)in_stride_c, (int)in_stride_h, (int)in_stride_w,\n        (int)out_stride_n, (int)out_stride_c, (int)out_stride_h, (int)out_stride_w,\n        out_height, out_width);\n}\n\nextern \"C\" void ge_scalar_forward(\n    const float* input,\n    unsigned char* output,\n    float scalar,\n    int total_elements,\n    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,\n    int H, int W, int C,\n    cudaStream_t stream) {\n\n    int threads = 256;\n    int blocks = (total_elements + threads - 1) / threads;\n    if (blocks > 65535) blocks = 65535;\n    ge_scalar_kernel<<<blocks, threads, 0, stream>>>(\n        input, output, scalar, total_elements,\n        (int)in_stride_n, (int)in_stride_c, (int)in_stride_h, (int)in_stride_w,\n        H, W, C);\n}\n\nextern \"C\" void remainder_scalar_forward(\n    const unsigned char* input,\n    long long* output,\n    double scalar,\n    int total_elements,\n    cudaStream_t stream) {\n\n    int threads = 256;\n    int blocks = (total_elements + threads - 1) / threads;\n    if (blocks > 65535) blocks = 65535;\n    remainder_scalar_kernel<<<blocks, threads, 0, stream>>>(\n        input, output, scalar, total_elements);\n}\n",
    "kernels/custom_ops_binding.cpp": "// Binding for custom reflection_pad2d, ge_scalar, remainder_scalar kernels\n#include <torch/types.h>\n#include <torch/csrc/utils/pybind.h>\n#include <cuda_runtime.h>\n#include <c10/cuda/CUDAStream.h>\n#include \"../binding_registry.h\"\n\n// Declare launchers from custom_ops.cu\nextern \"C\" void reflection_pad2d_forward(\n    const float* input,\n    float* output,\n    int N, int C, int H, int W,\n    int pad_left, int pad_right, int pad_top, int pad_bottom,\n    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,\n    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,\n    int out_height, int out_width,\n    cudaStream_t stream);\n\nextern \"C\" void ge_scalar_forward(\n    const float* input,\n    unsigned char* output,\n    float scalar,\n    int total_elements,\n    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,\n    int H, int W, int C,\n    cudaStream_t stream);\n\nextern \"C\" void remainder_scalar_forward(\n    const unsigned char* input,\n    long long* output,\n    double scalar,\n    int total_elements,\n    cudaStream_t stream);\n\n// Wrapper for reflection_pad2d\nstatic torch::Tensor reflection_pad2d_forward_wrapper(torch::Tensor input, std::vector<int64_t> padding) {\n    TORCH_CHECK(input.is_cuda(), \"Input must be a CUDA tensor\");\n    TORCH_CHECK(input.is_contiguous(), \"Input must be contiguous\");\n    TORCH_CHECK(input.dtype() == torch::kFloat32, \"Input must be float32\");\n    TORCH_CHECK(input.dim() == 4, \"Input must be 4D (N, C, H, W)\");\n    TORCH_CHECK(padding.size() == 4, \"padding must have 4 elements\");\n\n    int64_t N = input.size(0);\n    int64_t C = input.size(1);\n    int64_t H = input.size(2);\n    int64_t W = input.size(3);\n    int64_t pad_left = padding[0];\n    int64_t pad_right = padding[1];\n    int64_t pad_top = padding[2];\n    int64_t pad_bottom = padding[3];\n\n    int64_t out_H = H + pad_top + pad_bottom;\n    int64_t out_W = W + pad_left + pad_right;\n    TORCH_CHECK(out_H > 0 && out_W > 0, \"Output dimensions must be positive\");\n\n    auto output = torch::empty({N, C, out_H, out_W}, input.options());\n\n    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n\n    reflection_pad2d_forward(\n        input.data_ptr<float>(),\n        output.data_ptr<float>(),\n        (int)N, (int)C, (int)H, (int)W,\n        (int)pad_left, (int)pad_right, (int)pad_top, (int)pad_bottom,\n        input.stride(0), input.stride(1), input.stride(2), input.stride(3),\n        output.stride(0), output.stride(1), output.stride(2), output.stride(3),\n        (int)out_H, (int)out_W,\n        stream);\n\n    return output;\n}\n\n// Wrapper for ge_scalar (input >= scalar)\nstatic torch::Tensor ge_scalar_forward_wrapper(torch::Tensor input, double scalar) {\n    TORCH_CHECK(input.is_cuda(), \"Input must be a CUDA tensor\");\n    TORCH_CHECK(input.is_contiguous(), \"Input must be contiguous\");\n    TORCH_CHECK(input.dtype() == torch::kFloat32, \"Input must be float32\");\n    TORCH_CHECK(input.dim() == 4, \"Input must be 4D (N, C, H, W)\");\n\n    int64_t N = input.size(0);\n    int64_t C = input.size(1);\n    int64_t H = input.size(2);\n    int64_t W = input.size(3);\n    int64_t total_elements = N * C * H * W;\n\n    auto output = torch::empty({N, C, H, W}, input.options().dtype(torch::kBool));\n\n    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n\n    ge_scalar_forward(\n        input.data_ptr<float>(),\n        reinterpret_cast<unsigned char*>(output.data_ptr<bool>()),\n        (float)scalar,\n        (int)total_elements,\n        input.stride(0), input.stride(1), input.stride(2), input.stride(3),\n        (int)H, (int)W, (int)C,\n        stream);\n\n    return output;\n}\n\n// Wrapper for remainder_scalar (input % scalar)\nstatic torch::Tensor remainder_scalar_forward_wrapper(torch::Tensor input, double scalar) {\n    TORCH_CHECK(input.is_cuda(), \"Input must be a CUDA tensor\");\n    TORCH_CHECK(input.is_contiguous(), \"Input must be contiguous\");\n    TORCH_CHECK(input.dtype() == torch::kBool, \"Input must be bool\");\n    TORCH_CHECK(input.dim() == 4, \"Input must be 4D (N, C, H, W)\");\n\n    int64_t N = input.size(0);\n    int64_t C = input.size(1);\n    int64_t H = input.size(2);\n    int64_t W = input.size(3);\n    int64_t total_elements = N * C * H * W;\n\n    auto output = torch::empty({N, C, H, W}, input.options().dtype(torch::kInt64));\n\n    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n\n    remainder_scalar_forward(\n        reinterpret_cast<const unsigned char*>(input.data_ptr<bool>()),\n        reinterpret_cast<long long*>(output.data_ptr<int64_t>()),\n        scalar,\n        (int)total_elements,\n        stream);\n\n    return output;\n}\n\n// Register bindings\nvoid register_custom_ops(pybind11::module& m) {\n    m.def(\"reflection_pad2d_forward\", &reflection_pad2d_forward_wrapper, \"ReflectionPad2d forward\",\n          pybind11::arg(\"input\"), pybind11::arg(\"padding\"));\n    m.def(\"ge_scalar_forward\", &ge_scalar_forward_wrapper, \"GreaterEqual scalar forward\",\n          pybind11::arg(\"input\"), pybind11::arg(\"scalar\"));\n    m.def(\"remainder_scalar_forward\", &remainder_scalar_forward_wrapper, \"Remainder scalar forward\",\n          pybind11::arg(\"input\"), pybind11::arg(\"scalar\"));\n}\n\nREGISTER_BINDING(custom_ops, register_custom_ops);\n"
