+// CUDA kernels for reflection_pad2d, ge_scalar, remainder_scalar
+#include <cuda_runtime.h>
+
+// Helper to reflect index in [0, dim-1]
+__device__ __forceinline__ int reflect_index(int idx, int dim) {
+    if (idx < 0) return -idx;
+    if (idx >= dim) return 2 * dim - idx - 2;
+    return idx;
+}
+
+// Kernel for reflection padding 2D with arbitrary padding sizes and strides
+__global__ void reflection_pad2d_kernel(
+    const float* __restrict__ input,
+    float* __restrict__ output,
+    int N, int C, int H, int W,
+    int pad_left, int pad_right, int pad_top, int pad_bottom,
+    int in_stride_n, int in_stride_c, int in_stride_h, int in_stride_w,
+    int out_stride_n, int out_stride_c, int out_stride_h, int out_stride_w,
+    int out_height, int out_width) {
+
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = N * C * out_height * out_width;
+    int stride = blockDim.x * gridDim.x;
+
+    for (int i = idx; i < total; i += stride) {
+        // Decode output index
+        int w = i % out_width;
+        int tmp = i / out_width;
+        int h = tmp % out_height;
+        tmp /= out_height;
+        int c = tmp % C;
+        int n = tmp / C;
+
+        // Compute corresponding input coordinates with reflection
+        int in_h = h - pad_top;
+        int in_w = w - pad_left;
+        in_h = reflect_index(in_h, H);
+        in_w = reflect_index(in_w, W);
+
+        // Read input value using strides
+        const float* in_ptr = input + n * in_stride_n + c * in_stride_c + in_h * in_stride_h + in_w * in_stride_w;
+        float val = *in_ptr;
+
+        // Write output
+        float* out_ptr = output + n * out_stride_n + c * out_stride_c + h * out_stride_h + w * out_stride_w;
+        *out_ptr = val;
+    }
+}
+
+// Kernel for ge_scalar: input >= scalar, output bool (as unsigned char)
+__global__ void ge_scalar_kernel(
+    const float* __restrict__ input,
+    unsigned char* __restrict__ output,
+    float scalar,
+    int total_elements,
+    int in_stride_n, int in_stride_c, int in_stride_h, int in_stride_w) {
+
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+
+    for (int i = idx; i < total_elements; i += stride) {
+        // Decode index assuming contiguous output? But input may be non-contiguous.
+        // However, ge_scalar is applied on the padded tensor which is contiguous from our launcher.
+        // For generality, we handle non-contiguous by using strides.
+        // We assume output is contiguous with same shape. We need shape info: but total_elements suffices for flat index.
+        int w = i % W;
+        int tmp = i / W;
+        int h = tmp % H;
+        tmp /= H;
+        int c = tmp % C;
+        int n = tmp / C;
+
+        // Here we need shapes and strides. We'll pass them.
+        const float* in_ptr = input + n * in_stride_n + c * in_stride_c + h * in_stride_h + w * in_stride_w;
+        float val = *in_ptr;
+        unsigned char result = (val >= scalar) ? 1 : 0;
+        output[i] = result;
+    }
+}
+
+// Kernel for remainder_scalar: input (bool or int) % scalar, output int64.
+// We operate on bool input (as unsigned char) and output int64 (long long).
+__global__ void remainder_scalar_kernel(
+    const unsigned char* __restrict__ input,
+    long long* __restrict__ output,
+    double scalar,
+    int total_elements) {
+
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int stride = blockDim.x * gridDim.x;
+
+    for (int i = idx; i < total_elements; i += stride) {
+        // input is bool (0 or 1), scalar is 2.0 -> result 0 or 1 (as int64)
+        unsigned char val = input[i];
+        // Use Python-like modulo: result = val - floor(val/scalar)*scalar
+        // For val in {0,1}, scalar=2, result is 0 or 1.
+        double dval = (double)val;
+        double rem = dval - floor(dval / scalar) * scalar;
+        output[i] = (long long)rem;
+    }
+}
+
+// Launchers (extern "C")
+
+extern "C" void reflection_pad2d_forward(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    int pad_left, int pad_right, int pad_top, int pad_bottom,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,
+    int out_height, int out_width,
+    cudaStream_t stream) {
+
+    int total = N * C * out_height * out_width;
+    int threads = 256;
+    int blocks = (total + threads - 1) / threads;
+    // Cap blocks to avoid excessive grid launch; use at most 65535 blocks for older GPUs
+    if (blocks > 65535) blocks = 65535;
+    reflection_pad2d_kernel<<<blocks, threads, 0, stream>>>(
+        input, output, N, C, H, W,
+        pad_left, pad_right, pad_top, pad_bottom,
+        (int)in_stride_n, (int)in_stride_c, (int)in_stride_h, (int)in_stride_w,
+        (int)out_stride_n, (int)out_stride_c, (int)out_stride_h, (int)out_stride_w,
+        out_height, out_width);
+}
+
+extern "C" void ge_scalar_forward(
+    const float* input,
+    unsigned char* output,
+    float scalar,
+    int total_elements,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    int H, int W, int C,
+    cudaStream_t stream) {
+
+    int threads = 256;
+    int blocks = (total_elements + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535;
+    ge_scalar_kernel<<<blocks, threads, 0, stream>>>(
+        input, output, scalar, total_elements,
+        (int)in_stride_n, (int)in_stride_c, (int)in_stride_h, (int)in_stride_w,
+        H, W, C);
+}
+
+extern "C" void remainder_scalar_forward(
+    const unsigned char* input,
+    long long* output,
+    double scalar,
+    int total_elements,
+    cudaStream_t stream) {
+
+    int threads = 256;
+    int blocks = (total_elements + threads - 1) / threads;
+    if (blocks > 65535) blocks = 65535;
+    remainder_scalar_kernel<<<blocks, threads, 0, stream>>>(
+        input, output, scalar, total_elements);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,139 @@
+// Binding for custom reflection_pad2d, ge_scalar, remainder_scalar kernels
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void reflection_pad2d_forward(
+    const float* input,
+    float* output,
+    int N, int C, int H, int W,
+    int pad_left, int pad_right, int pad_top, int pad_bottom,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,
+    int out_height, int out_width,
+    cudaStream_t stream);
+
+extern "C" void ge_scalar_forward(
+    const float* input,
+    unsigned char* output,
+    float scalar,
+    int total_elements,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    int H, int W, int C,
+    cudaStream_t stream);
+
+extern "C" void remainder_scalar_forward(
+    const unsigned char* input,
+    long long* output,
+    double scalar,
+    int total_elements,
+    cudaStream_t stream);
+
+// Wrapper for reflection_pad2d
+static torch::Tensor reflection_pad2d_forward_wrapper(torch::Tensor input, std::vector<int64_t> padding) {
+    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(input.dim() == 4, "Input must be 4D (N, C, H, W)");
+    TORCH_CHECK(padding.size() == 4, "padding must have 4 elements");
+
+    int64_t N = input.size(0);
+    int64_t C = input.size(1);
+    int64_t H = input.size(2);
+    int64_t W = input.size(3);
+    int64_t pad_left = padding[0];
+    int64_t pad_right = padding[1];
+    int64_t pad_top = padding[2];
+    int64_t pad_bottom = padding[3];
+
+    int64_t out_H = H + pad_top + pad_bottom;
+    int64_t out_W = W + pad_left + pad_right;
+    TORCH_CHECK(out_H > 0 && out_W > 0, "Output dimensions must be positive");
+
+    auto output = torch::empty({N, C, out_H, out_W}, input.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    reflection_pad2d_forward(
+        input.data_ptr<float>(),
+        output.data_ptr<float>(),
+        (int)N, (int)C, (int)H, (int)W,
+        (int)pad_left, (int)pad_right, (int)pad_top, (int)pad_bottom,
+        input.stride(0), input.stride(1), input.stride(2), input.stride(3),
+        output.stride(0), output.stride(1), output.stride(2), output.stride(3),
+        (int)out_H, (int)out_W,
+        stream);
+
+    return output;
+}
+
+// Wrapper for ge_scalar (input >= scalar)
+static torch::Tensor ge_scalar_forward_wrapper(torch::Tensor input, double scalar) {
+    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(input.dim() == 4, "Input must be 4D (N, C, H, W)");
+
+    int64_t N = input.size(0);
+    int64_t C = input.size(1);
+    int64_t H = input.size(2);
+    int64_t W = input.size(3);
+    int64_t total_elements = N * C * H * W;
+
+    auto output = torch::empty({N, C, H, W}, input.options().dtype(torch::kBool));
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    ge_scalar_forward(
+        input.data_ptr<float>(),
+        reinterpret_cast<unsigned char*>(output.data_ptr<bool>()),
+        (float)scalar,
+        (int)total_elements,
+        input.stride(0), input.stride(1), input.stride(2), input.stride(3),
+        (int)H, (int)W, (int)C,
+        stream);
+
+    return output;
+}
+
+// Wrapper for remainder_scalar (input % scalar)
+static torch::Tensor remainder_scalar_forward_wrapper(torch::Tensor input, double scalar) {
+    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(input.dtype() == torch::kBool, "Input must be bool");
+    TORCH_CHECK(input.dim() == 4, "Input must be 4D (N, C, H, W)");
+
+    int64_t N = input.size(0);
+    int64_t C = input.size(1);
+    int64_t H = input.size(2);
+    int64_t W = input.size(3);
+    int64_t total_elements = N * C * H * W;
+
+    auto output = torch::empty({N, C, H, W}, input.options().dtype(torch::kInt64));
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    remainder_scalar_forward(
+        reinterpret_cast<const unsigned char*>(input.data_ptr<bool>()),
+        output.data_ptr<int64_t>(),
+        scalar,
+        (int)total_elements,
+        stream);
+
+    return output;
+}
+
+// Register bindings
+void register_custom_ops(pybind11::module& m) {
+    m.def("reflection_pad2d_forward", &reflection_pad2d_forward_wrapper, "ReflectionPad2d forward",
+          pybind11::arg("input"), pybind11::arg("padding"));
+    m.def("ge_scalar_forward", &ge_scalar_forward_wrapper, "GreaterEqual scalar forward",
+          pybind11::arg("input"), pybind11::arg("scalar"));
+    m.def("remainder_scalar_forward", &remainder_scalar_forward_wrapper, "Remainder scalar forward",
+          pybind11::arg("input"), pybind11::arg("scalar"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
