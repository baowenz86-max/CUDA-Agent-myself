in_channels = 32  # Increased from 1 to 32 to increase computation
height, width = 512, 256
kernel_size = 3
padding_size = (2, 3, 1, 1)


def get_inputs():
    return [torch.randn(batch_size, in_channels, height, width)]


def get_init_inputs():
    return [in_channels, kernel_size, padding_size]

