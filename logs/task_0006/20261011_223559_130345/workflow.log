    "kernels/reflect_pad_geq_remainder.cu": "#include <cuda_runtime.h>\n#include <cstdint>\n\n// Kernel: apply reflection padding, then ge>=0, then remainder with 2.\n// Input tensor: N, C, H, W, contiguous fp32.\n// Padding: left_pad, right_pad, top_pad, bottom_pad (as passed from model_new.py: padding_size[0], [1], [2], [3]).\n// In PyTorch ReflectionPad2d((left, right, top, bottom)).\n// Output shape: N, C, H_new, W_new where H_new = H + top_pad + bottom_pad, W_new = W + left_pad + right_pad.\n// Reflection rule: mirror without repeating the edge. For an input coordinate i, output coordinate j (after subtracting pad) maps to input index:\n// if i < 0: i = -i;          // reflect across edge\n// if i >= H: i = 2*H - 2 - i; // reflect across opposite edge\n// For valid range 0 <= i < H.\n// Similar for width.\n// The output value = (input[reflected] >= 0) ? 1 : 0, then remainder with 2 (which leaves 0/1 unchanged, but we compute as 0/1).\n// Actually torch.remainder(x, 2) of 0/1 is still 0/1, so final output is 0 or 1.\n// We can simplify: output = (input_value >= 0) ? 1.0f : 0.0f (since remainder with 2 of 0 or 1 is same).\n// But to be exactly equivalent, if input_value is NaN, ge returns False (0) and remainder(0,2)=0.\n// That's fine.\n\n__global__ void reflect_pad_geq_remainder_kernel(\n    const float* __restrict__ input,\n    float* __restrict__ output,\n    int N, int C, int H, int W,\n    int H_new, int W_new,\n    int top_pad, int left_pad\n) {\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int total = N * C * H_new * W_new;\n    if (idx >= total) return;\n\n    // Decode indices: output layout is N, C, H_new, W_new contiguous.\n    int w_out = idx % W_new;\n    int h_out = (idx / W_new) % H_new;\n    int c = (idx / (W_new * H_new)) % C;\n    int n = idx / (W_new * H_new * C);\n\n    // Compute source coordinates after removing padding.\n    int h_in = h_out - top_pad;\n    int w_in = w_out - left_pad;\n\n    // Reflect coordinates.\n    if (h_in < 0) h_in = -h_in;\n    else if (h_in >= H) h_in = 2 * H - 2 - h_in;\n    // Similarly for width.\n    if (w_in < 0) w_in = -w_in;\n    else if (w_in >= W) w_in = 2 * W - 2 - w_in;\n\n    // Compute input offset.\n    long long input_idx = ((long long)n * C + c) * H * W + (long long)h_in * W + w_in;\n    float val = input[input_idx];\n\n    // Apply ge and remainder (ge>=0 -> 1.0, else 0.0; remainder with 2 is identity for 0 and 1).\n    float out_val = (val >= 0.0f) ? 1.0f : 0.0f;\n    output[idx] = out_val;\n}\n\nextern \"C\" void reflect_pad_geq_remainder_launcher(\n    const float* input,\n    float* output,\n    int N, int C, int H, int W,\n    int H_new, int W_new,\n    int top_pad, int left_pad,\n    cudaStream_t stream\n) {\n    int total = N * C * H_new * W_new;\n    int block_size = 256;\n    int grid_size = (total + block_size - 1) / block_size;\n    reflect_pad_geq_remainder_kernel<<<grid_size, block_size, 0, stream>>>(\n        input, output, N, C, H, W, H_new, W_new, top_pad, left_pad);\n}\n"
