===== 现有 CUDA/C++ kernel 文件 =====

===== kernels/reflect_pad_geq_remainder.cu =====
#include <cuda_runtime.h>
#include <cstdint>

// Kernel: apply reflection padding, then ge>=0, then remainder with 2.
// Input tensor: N, C, H, W, contiguous fp32.
// Padding: left_pad, right_pad, top_pad, bottom_pad.
// Output shape: N, C, H_new, W_new where H_new = H + top_pad + bottom_pad, W_new = W + left_pad + right_pad.
// Output dtype: int64 (torch::kLong).

__global__ void reflect_pad_geq_remainder_kernel(
    const float* __restrict__ input,
    long long* __restrict__ output,
    int N, int C, int H, int W,
    int H_new, int W_new,
    int top_pad, int left_pad
) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int total = N * C * H_new * W_new;
    if (idx >= total) return;

    // Decode indices: output layout is N, C, H_new, W_new contiguous.
    int w_out = idx % W_new;
    int h_out = (idx / W_new) % H_new;
    int c = (idx / (W_new * H_new)) % C;
    int n = idx / (W_new * H_new * C);

    // Compute source coordinates after removing padding.
    int h_in = h_out - top_pad;
    int w_in = w_out - left_pad;

    // Reflect coordinates.
    if (h_in < 0) h_in = -h_in;
    else if (h_in >= H) h_in = 2 * H - 2 - h_in;
    if (w_in < 0) w_in = -w_in;
    else if (w_in >= W) w_in = 2 * W - 2 - w_in;

    // Compute input offset.
    long long input_idx = ((long long)n * C + c) * H * W + (long long)h_in * W + w_in;
    float val = input[input_idx];

    // Apply ge and remainder (ge>=0 -> 1, else 0; remainder with 2 is identity for 0/1).
    long long out_val = (val >= 0.0f) ? 1LL : 0LL;
    output[idx] = out_val;
}

extern "C" void reflect_pad_geq_remainder_launcher(
    const float* input,
    long long* output,
    int N, int C, int H, int W,
    int H_new, int W_new,
    int top_pad, int left_pad,
    cudaStream_t stream
) {
    int total = N * C * H_new * W_new;
    int block_size = 256;
    int grid_size = (total + block_size - 1) / block_size;
    reflect_pad_geq_remainder_kernel<<<grid_size, block_size, 0, stream>>>(
        input, output, N, C, H, W, H_new, W_new, top_pad, left_pad);
}

===== kernels/reflect_pad_geq_remainder_binding.cpp =====
#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>

#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include "../binding_registry.h"

// Declare launcher from .cu file
extern "C" void reflect_pad_geq_remainder_launcher(
    const float* input,
    long long* output,
    int N, int C, int H, int W,
    int H_new, int W_new,
    int top_pad, int left_pad,
    cudaStream_t stream
);

// PyTorch wrapper
torch::Tensor reflect_pad_geq_remainder_forward(
    torch::Tensor input,
    int left_pad,
    int right_pad,
    int top_pad,
    int bottom_pad
) {
    // Input validation
    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
    TORCH_CHECK(input.dim() == 4, "Input must be 4D (N, C, H, W)");
    TORCH_CHECK(left_pad >= 0 && right_pad >= 0 && top_pad >= 0 && bottom_pad >= 0,
                "Padding values must be non-negative");

    int N = input.size(0);
    int C = input.size(1);
    int H = input.size(2);
    int W = input.size(3);

    // Check that padding is valid for reflection: pad size must be less than dim size
    TORCH_CHECK(left_pad < W && right_pad < W, "Padding must be less than input width");
    TORCH_CHECK(top_pad < H && bottom_pad < H, "Padding must be less than input height");

    int H_new = H + top_pad + bottom_pad;
    int W_new = W + left_pad + right_pad;

    // Allocate output tensor with int64 dtype, matching torch.ge(...).remainder(2) result.
    auto output = torch::empty({N, C, H_new, W_new},
                               torch::dtype(torch::kLong).device(input.device()));

    // Get current CUDA stream
    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    // Call CUDA launcher
    reflect_pad_geq_remainder_launcher(
        input.data_ptr<float>(),
        output.data_ptr<long long>(),
        N, C, H, W,
        H_new, W_new,
        top_pad, left_pad,
        stream
    );

    return output;
}

// Registration function
void register_reflect_pad_geq_remainder(pybind11::module& m) {
    m.def("reflect_pad_geq_remainder_forward", &reflect_pad_geq_remainder_forward,
          "Reflection pad, then ge>=0 and remainder(2)",
          py::arg("input"),
          py::arg("left_pad"),
          py::arg("right_pad"),
          py::arg("top_pad"),
          py::arg("bottom_pad"));
}

// Auto-register
REGISTER_BINDING(reflect_pad_geq_remainder, register_reflect_pad_geq_remainder);
