// PyTorch wrapper
torch::Tensor reflect_pad_geq_remainder_forward(
    torch::Tensor input,
    int left_pad,
    int right_pad,
    int top_pad,
    int bottom_pad
) {
    // Input validation
    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
    TORCH_CHECK(input.dim() == 4, "Input must be 4D (N, C, H, W)");
    TORCH_CHECK(left_pad >= 0 && right_pad >= 0 && top_pad >= 0 && bottom_pad >= 0,
                "Padding values must be non-negative");

    int N = input.size(0);
    int C = input.size(1);
    int H = input.size(2);
    int W = input.size(3);

    // Check that padding is valid for reflection: pad size must be less than dim size
    TORCH_CHECK(left_pad < W && right_pad < W, "Padding must be less than input width");
    TORCH_CHECK(top_pad < H && bottom_pad < H, "Padding must be less than input height");

    int H_new = H + top_pad + bottom_pad;
    int W_new = W + left_pad + right_pad;

    // Allocate output tensor with same dtype as input, but integer type for comparison result.
    // torch.ge returns bool tensor, but here we need to match model.py output dtype.
    // In model.py, torch.ge(x, 0) returns bool, then remainder with 2 returns int64.
    // So output should be int64 tensor.
    auto output = torch::empty({N, C, H_new, W_new}, torch::dtype(torch::kLong).device(input.device()));

    // Get current CUDA stream
    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    // Call CUDA launcher
    // The kernel writes float values (0.0 or 1.0) but we need int64 output.
    // We'll handle this by launching kernel that writes to intermediate float buffer and then cast, or modify kernel to write int64 directly.
    // Simpler: allocate float output, then cast to long after kernel? But that requires torch operations in model_new.py (forbidden).
    // So we need to either modify kernel to write int64, or allocate a temporary float tensor and cast in binding (using torch operations in binding is allowed? The restriction says no torch::* in binding.cpp .cu files, but tensor operations might be allowed? Actually binding.cpp can use torch:: functions for tensor manipulation, but model_new.py cannot use torch ops. Since we are in binding, we can use torch::empty, torch::zeros, etc. But to cast we would need output.to(torch::kLong) which is a torch operation and might be disallowed. Better to modify the kernel to write int64 directly.
    // Also need to adjust launcher signature for int64 output.
    // Let's modify the .cu file as well.
    TORCH_CHECK(false, "Temporary: need to fix output dtype");

    return output;
}

// Registration function
void register_reflect_pad_geq_remainder(pybind11::module& m) {
    m.def("reflect_pad_geq_remainder_forward", &reflect_pad_geq_remainder_forward,
          "Reflection pad, then ge>=0 and remainder(2)",
          py::arg("input"),
          py::arg("left_pad"),
          py::arg("right_pad"),
          py::arg("top_pad"),
          py::arg("bottom_pad"));
}

// Auto-register
REGISTER_BINDING(reflect_pad_geq_remainder, register_reflect_pad_geq_remainder);
