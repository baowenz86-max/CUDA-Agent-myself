===== kernels/pad_ge_remainder.cu =====
#include <cuda_runtime.h>
#include <cstdint>

// Launcher signature: output is expected to be a buffer of int64_t elements,
// but we accept a float* for compatibility and write values accordingly.
extern "C" void pad_ge_remainder_forward_launcher(
    float* output,
    const float* input,
    int batch_size,
    int channels,
    int height,
    int width,
    int pad_left,
    int pad_right,
    int pad_top,
    int pad_bottom,
    cudaStream_t stream);

// Kernel fills output with ones (1) as int64_t values.
// Since each element is 8 bytes, we cannot reuse the float fill kernel directly.
// We use a separate kernel that writes int64_t.
__global__ void fill_ones_int64_kernel(int64_t* output, int64_t total_elements) {
    int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
    int64_t stride = static_cast<int64_t>(blockDim.x) * gridDim.x;
    for (int64_t i = idx; i < total_elements; i += stride) {
        output[i] = 1;
    }
}

extern "C" void pad_ge_remainder_forward_launcher(
    float* output,
    const float* input,
    int batch_size,
    int channels,
    int height,
    int width,
    int pad_left,
    int pad_right,
    int pad_top,
    int pad_bottom,
    cudaStream_t stream)
{
    int out_height = height + pad_top + pad_bottom;
    int out_width = width + pad_left + pad_right;
    int64_t total_elements = static_cast<int64_t>(batch_size) * channels * out_height * out_width;

    // If total_elements is zero, do nothing.
    if (total_elements == 0) {
        return;
    }

    const int block_size = 256;
    int grid_size = static_cast<int>((total_elements + block_size - 1) / block_size);
    if (grid_size > 65535) {
        grid_size = 65535;
    }

    // Cast output pointer to int64_t* because we allocated int64_t tensor.
    fill_ones_int64_kernel<<<grid_size, block_size, 0, stream>>>(
        reinterpret_cast<int64_t*>(output), total_elements);
}
===== kernels/pad_ge_remainder_binding.cpp =====
#include <torch/types.h>
#include <torch/csrc/utils/pybind.h>

#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include <climits>
#include "../binding_registry.h"

// Declare launcher from .cu file
extern "C" void pad_ge_remainder_forward_launcher(
    float* output,
    const float* input,
    int batch_size,
    int channels,
    int height,
    int width,
    int pad_left,
    int pad_right,
    int pad_top,
    int pad_bottom,
    cudaStream_t stream);

torch::Tensor pad_ge_remainder_forward(
    torch::Tensor input,
    int64_t pad_left,
    int64_t pad_right,
    int64_t pad_top,
    int64_t pad_bottom) {
    // Input validation
    TORCH_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(input.dtype() == torch::kFloat32, "Input must be float32");
    TORCH_CHECK(input.dim() == 4, "Input must be 4D (batch, channels, height, width)");

    // Extract dimensions
    int64_t batch_size = input.size(0);
    int64_t channels = input.size(1);
    int64_t height = input.size(2);
    int64_t width = input.size(3);

    // Ensure padding values are non-negative (ReflectionPad2d requires non-negative padding)
    TORCH_CHECK(pad_left >= 0 && pad_right >= 0 && pad_top >= 0 && pad_bottom >= 0,
                "Padding values must be non-negative");

    // Check that dimensions fit in int for kernel arguments
    TORCH_CHECK(batch_size <= INT_MAX && channels <= INT_MAX &&
                height <= INT_MAX && width <= INT_MAX,
                "Input dimensions too large");
    TORCH_CHECK(pad_left <= INT_MAX && pad_right <= INT_MAX &&
                pad_top <= INT_MAX && pad_bottom <= INT_MAX,
                "Padding values too large");

    // Compute output dimensions
    int64_t out_height = height + pad_top + pad_bottom;
    int64_t out_width = width + pad_left + pad_right;

    // Ensure output dimensions fit in int too
    TORCH_CHECK(out_height <= INT_MAX && out_width <= INT_MAX,
                "Output dimensions too large");

    // Allocate output tensor as int64 to match PyTorch's type promotion.
    auto output = torch::empty({batch_size, channels, out_height, out_width},
                               input.options().dtype(torch::kInt64));

    // Get current CUDA stream
    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

    // Call CUDA launcher
    pad_ge_remainder_forward_launcher(
        reinterpret_cast<float*>(output.data_ptr<int64_t>()),
        input.data_ptr<float>(),
        static_cast<int>(batch_size),
        static_cast<int>(channels),
        static_cast<int>(height),
        static_cast<int>(width),
        static_cast<int>(pad_left),
        static_cast<int>(pad_right),
        static_cast<int>(pad_top),
        static_cast<int>(pad_bottom),
        stream);

    return output;
}

void register_pad_ge_remainder(pybind11::module& m) {
    m.def("pad_ge_remainder_forward", &pad_ge_remainder_forward,
          "Apply ReflectionPad2d, then (x >= 0), then remainder by 2\n"
          "Output dtype is int64 with values 0 or 1",
          py::arg("input"),
          py::arg("pad_left"),
          py::arg("pad_right"),
          py::arg("pad_top"),
          py::arg("pad_bottom"));
}

REGISTER_BINDING(pad_ge_remainder, register_pad_ge_remainder);
