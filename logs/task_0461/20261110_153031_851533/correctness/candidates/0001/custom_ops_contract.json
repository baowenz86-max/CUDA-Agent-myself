{
  "operators": [
    {
      "name": "custom_pad",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "pad_left",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "pad_right",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "pad_top",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "pad_bottom",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C, H + pad_top + pad_bottom, W + pad_left + pad_right]"
      },
      "semantics": [
        "对输入 x 执行 ZeroPad2d(padding=(left, right, top, bottom))，在 W 维两侧填充 left/right 个零，在 H 维两侧填充 top/bottom 个零。",
        "输出元素：output[n,c,i,j] = x[n,c,i-pad_top,j-pad_left] 当索引有效，否则为 0。",
        "输出 shape 为 [N, C, H + pad_top + pad_bottom, W + pad_left + pad_right]。",
        "支持任意 stride 的输入，kernel 内部按照有效坐标索引原数据。"
      ]
    },
    {
      "name": "custom_max_dim",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dim",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, H, W]"
      },
      "semantics": [
        "沿指定 dim 维度求最大值，只返回 values，不返回 indices。",
        "当 dim=1 时，输出 shape 为 [N, H, W]，output[n,h,w] = max_{c} x[n,c,h,w]。",
        "支持任意 stride 的输入，采用每输出元素一个线程归约的方式保证稳定性。",
        "空维度时行为与参考 torch.max 一致（不适用本任务，输入 C>0）。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.pad(x)",
      "semantics": [
        "使用 ZeroPad2d(padding=(2,3,2,3)) 对输入 [512,32,256,256] 进行零填充。",
        "left=2, right=3, top=2, bottom=3。",
        "输出 shape [512, 32, 256+2+3=261, 256+2+3=261]。",
        "输出 dtype float32，device cuda。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "return torch.max(x, dim=1)[0]",
      "semantics": [
        "对 padding 后的张量沿维度 1（通道）取最大值。",
        "只取 [0] 索引得到 values，shape [512, 261, 261]。",
        "输出 dtype float32，device cuda。"
      ]
    }
  ]
}