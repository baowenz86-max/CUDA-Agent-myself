          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.int64",
        "device": "cuda",
        "shape": "[-1, -1, -1, num_classes]"
      },
      "semantics": [
        "在输入 x 的 dim=1 维度上求 argmax，得到形状 [batch, height, width] 的索引张量",
        "使用 F.one_hot(indices, num_classes=num_classes) 生成形状 [batch, height, width, num_classes] 的 one-hot 张量",
