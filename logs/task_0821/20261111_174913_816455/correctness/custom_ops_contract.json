{
  "operators": [
    {
      "name": "reflection_pad2d_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        },
        {
          "name": "pad_left",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "pad_right",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "pad_top",
          "kind": "int",
          "optional": false,
          "nullable": false
        },
        {
          "name": "pad_bottom",
          "kind": "int",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[N, C, H + pad_top + pad_bottom, W + pad_left + pad_right]"
      },
      "semantics": [
        "对应 self.pad(x)，即 nn.ReflectionPad2d((1,2,1,2)) 的 forward。",
        "pad_left=1, pad_right=2, pad_top=1, pad_bottom=2。",
        "对宽度维：输出列索引 j_out，源索引 j = reflect(j_out - pad_left, W)，其中 reflect 保证 0 <= j < W。",
        "对高度维：输出行索引 i_out，源索引 i = reflect(i_out - pad_top, H)。",
        "不包含边界重复：例如 W=64 时索引 -1 -> 1，64 -> 62，65 -> 61，-2 -> 2。",
        "输出 dtype 与输入相同，device 与输入相同。"
      ]
    },
    {
      "name": "argsort_dim1_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[N, C, H, W]",
          "layout": "contiguous",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.int64",
        "device": "cuda",
        "shape": "[N, C, H, W]"
      },
      "semantics": [
        "对应 torch.argsort(x, dim=1)，沿通道维 C 升序排序。",
        "对每个 (n, h, w) 位置，对 C 个元素排序，返回索引。",
        "输出 shape 与输入相同，dtype 为 torch.int64，device 相同。",
        "需保持 PyTorch 默认的非稳定排序行为；当值相等时索引顺序可能不一定遵循原顺序，但验证容差内允许。",
        "输入为 CUDA tensor，输出为 CUDA tensor。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.pad(x)",
      "semantics": [
        "对输入 [512,3,64,64] 进行反射填充 (1,2,1,2)，输出 [512,3,67,67]。",
        "输出 dtype float32，device cuda，stride 连续。",
        "反射规则：不重复边界元素。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = torch.argsort(x, dim=1)",
      "semantics": [
        "对填充后的张量沿 dim=1 升序排序，输出索引 int64，shape [512,3,67,67]。",
        "device cuda，stride 连续。",
        "排序为升序。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "return x",
      "semantics": [
        "返回 argsort 结果。"
      ]
    }
  ]
}