{
  "operators": [
    {
      "name": "conv2d_no_bias",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[512, 3, 64, 64]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[16, 3, 3, 3]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[512, 16, 64, 64]"
      },
      "semantics": [
        "对应 conv(x) 参考 step_001。Conv2d bias=False，因此不添加 bias。",
        "使用 cuDNN 实现，stride=(1,1), padding=(1,1), dilation=(1,1), groups=1。",
        "输入 x 形状 [N,C,H,W]=[512,3,64,64]，weight 形状 [16,3,3,3]，输出 [512,16,64,64]。",
        "输出尺寸：H_out=(64+2*1-3)/1+1=64, W_out=64。",
        "输入和权重必须位于 CUDA，float32；支持任意 stride，内部按需显式连续化。"
      ]
    },
    {
      "name": "batch_norm2d_inference",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[512, 16, 64, 64]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "weight",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[16]",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[16]",
          "layout": "supports strides",
          "nullable": true,
          "optional": false
        },
        {
          "name": "running_mean",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[16]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "running_var",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[16]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "eps",
          "kind": "float",
          "default": 1e-05,
          "optional": true,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[512, 16, 64, 64]"
      },
      "semantics": [
        "对应 bn(x) 参考 step_002。模型处于 eval/training=False，使用 running_mean 和 running_var 进行归一化。",
        "对每个通道 c：y = (x - running_mean[c]) / sqrt(running_var[c] + eps) * weight[c] + bias[c]。",
        "weight 和 bias 可能为 None（模块有 affine=True，此处非 None），按 None 处理为 1/0。",
        "输入形状 [N,C,H,W]，对每个样本的 C 维逐元素应用相同的 scale/shift，广播到 H,W。",
        "所有参数位于 CUDA，float32；输出与输入同形状同 dtype。"
      ]
    },
    {
      "name": "leaky_relu",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[512, 16, 64, 64]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "negative_slope",
          "kind": "float",
          "default": 0.1,
          "optional": true,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[512, 16, 64, 64]"
      },
      "semantics": [
        "对应 leakyrelu(x) 参考 step_003。y = x if x >= 0 else negative_slope * x。",
        "逐元素操作，无广播，输出形状与输入一致。",
        "negative_slope 默认 0.1；输入 float32 CUDA，输出同 dtype/device。"
      ]
    },
    {
      "name": "add_bias_broadcast",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[512, 16, 64, 64]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "bias",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[16, 1, 1]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[512, 16, 64, 64]"
      },
      "semantics": [
        "对应 x + self.bias 参考 step_004。bias 形状 [16,1,1] 广播到 [N,16,H,W]。",
        "对每个元素 y[n,c,h,w] = x[n,c,h,w] + bias[c,0,0]。",
        "输入和 bias 均 float32 CUDA，输出同形状。"
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.conv(x)",
      "semantics": [
        "Conv2d 2D 卷积，bias=False，stride=1，padding=1，dilation=1，groups=1。",
        "输入 [512,3,64,64]，权重 [16,3,3,3]，输出 [512,16,64,64]。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = self.bn(x)",
      "semantics": [
        "BatchNorm2d 在 eval 模式下使用 running_mean/running_var 归一化，并应用 affine weight/bias。",
        "通道独立，广播到空间维度。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = self.leakyrelu(x)",
      "semantics": [
        "LeakyReLU 负斜率 0.1，逐元素。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "x = x + self.bias",
      "semantics": [
        "张量加 bias，bias 形状 [16,1,1] 广播到 [512,16,64,64]。"
      ]
    },
    {
      "checkpoint": "step_005",
      "source": "return x",
      "semantics": [
        "返回最终张量，形状 [512,16,64,64]，float32 CUDA。"
      ]
    }
  ]
}