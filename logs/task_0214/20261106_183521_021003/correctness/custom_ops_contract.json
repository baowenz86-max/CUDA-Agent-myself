      "semantics": [
        "2D convolution with cuDNN, matching nn.Conv2d(in_channels=3, out_channels=16, kernel_size=3, stride=1, padding=0, dilation=1, groups=1, bias=True).",
        "Bias tensor is added as part of the conv operation.",
        "Input is already padded by reflection, so conv padding is 0."
      ]
    },
    {
      "name": "add_bias_forward",
      "parameters": [
        {
          "name": "input",
          "kind": "tensor",
          "dtype": "torch.float32",
