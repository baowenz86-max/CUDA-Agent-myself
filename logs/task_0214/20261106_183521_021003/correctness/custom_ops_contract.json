        "Input is [128,3,514,66], output is [128,16,512,64]."
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "x = x + self.bias",
      "semantics": [
        "Add bias [16,1,1] broadcasting across batch and spatial dims."
      ]
    },
