      "semantics": [
        "Mirror reference nn.ReflectionPad2d(padding_size). Input padding is scalar int 1, so pad all sides by 1.",
        "Output spatial shape: input_height + 2*padding, input_width + 2*padding.",
        "Reflection padding without repeating the edge pixel."
      ]
    },
