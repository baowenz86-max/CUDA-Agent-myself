          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[128, 16, 512, 64]"
      },
      "semantics": [
        "Element-wise add input + bias. Bias shape [16,1,1] broadcasts across batch, height, width."
      ]
    }
  ],
  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "x = self.pad(x)",
      "semantics": [
        "Apply ReflectionPad2d with padding=1 to input [128,3,512,64] -> [128,3,514,66]."
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "x = F.sigmoid(x)",
      "semantics": [
        "Apply element-wise sigmoid to padded tensor."
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "x = self.conv(x)",
      "semantics": [
