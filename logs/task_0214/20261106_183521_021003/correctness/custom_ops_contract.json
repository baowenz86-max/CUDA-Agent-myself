        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[128, 3, 514, 66]"
      },
      "semantics": [
        "Element-wise sigmoid: 1 / (1 + exp(-x))."
      ]
    },
    {
      "name": "conv2d_forward",
      "parameters": [
