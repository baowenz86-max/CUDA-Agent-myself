--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,65 @@
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// Compute isnan for each element, output bool (as uint8_t in memory)
+__global__ void isnan_kernel(const float* __restrict__ input, uint8_t* __restrict__ output, int64_t numel) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < numel; i += stride) {
+        output[i] = (input[i] != input[i]) ? 1 : 0;
+    }
+}
+
+// Gather along dimension dim (int64_t indices)
+__global__ void gather_kernel(
+    const float* __restrict__ input,
+    const int64_t* __restrict__ index,
+    float* __restrict__ output,
+    int64_t outer_size,   // product of dims before dim
+    int64_t dim_size,     // size of gather dimension
+    int64_t inner_size,   // product of dims after dim
+    int64_t total_output  // outer_size * inner_size (index shape numel)
+) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    for (int64_t i = idx; i < total_output; i += stride) {
+        int64_t inner = i % inner_size;
+        int64_t outer = i / inner_size;
+        int64_t index_val = index[i];
+        // torch.gather uses wrap-around for out-of-bounds indices, but contract says indices are valid
+        // For safety, clamp to [0, dim_size-1] in debug? No, torch.gather allows negative indices with wrap.
+        // Here we follow torch semantics: if idx < 0, idx += dim_size; if still out of range, undefined? Actually torch.gather requires in range.
+        // Index provided by torch.randint(0, dim_size) so always valid.
+        if (index_val < 0) index_val += dim_size; // not needed but safe
+        if (index_val >= dim_size) index_val %= dim_size; // not needed
+        int64_t input_offset = outer * dim_size * inner_size + index_val * inner_size + inner;
+        output[i] = input[input_offset];
+    }
+}
+
+extern "C" void isnan_forward_launcher(const float* input, uint8_t* output, int64_t numel, cudaStream_t stream) {
+    int threads = 256;
+    int blocks = (int)((numel + threads - 1) / threads);
+    if (blocks > 65535) blocks = 65535;
+    if (blocks == 0 && numel > 0) blocks = 1;
+    if (numel == 0) return;
+    isnan_kernel<<<blocks, threads, 0, stream>>>(input, output, numel);
+}
+
+extern "C" void gather_forward_launcher(
+    const float* input,
+    const int64_t* index,
+    float* output,
+    int64_t outer_size,
+    int64_t dim_size,
+    int64_t inner_size,
+    cudaStream_t stream
+) {
+    int64_t total_output = outer_size * inner_size;
+    if (total_output == 0) return;
+    int threads = 256;
+    int blocks = (int)((total_output + threads - 1) / threads);
+    if (blocks > 65535) blocks = 65535;
+    if (blocks == 0) blocks = 1;
+    gather_kernel<<<blocks, threads, 0, stream>>>(input, index, output, outer_size, dim_size, inner_size, total_output);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,94 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void isnan_forward_launcher(const float* input, uint8_t* output, int64_t numel, cudaStream_t stream);
+extern "C" void gather_forward_launcher(
+    const float* input,
+    const int64_t* index,
+    float* output,
+    int64_t outer_size,
+    int64_t dim_size,
+    int64_t inner_size,
+    cudaStream_t stream
+);
+
+// PyTorch binding for isnan_forward
+torch::Tensor isnan_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    // Ensure contiguous (launcher assumes contiguous)
+    if (!x.is_contiguous()) {
+        x = x.contiguous();
+    }
+
+    auto output = torch::empty_like(x, x.options().dtype(torch::kBool));
+    int64_t numel = x.numel();
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    // bool tensor storage is 1 byte per element; use uint8_t* for launcher
+    isnan_forward_launcher(x.data_ptr<float>(),
+                           reinterpret_cast<uint8_t*>(output.data_ptr<bool>()),
+                           numel,
+                           stream);
+
+    return output;
+}
+
+// PyTorch binding for gather_forward
+torch::Tensor gather_forward(torch::Tensor x, int64_t dim, torch::Tensor index) {
+    TORCH_CHECK(x.is_cuda(), "Input x must be a CUDA tensor");
+    TORCH_CHECK(index.is_cuda(), "Index must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input x must be float32");
+    TORCH_CHECK(index.dtype() == torch::kInt64, "Index must be int64");
+
+    // Normalize dim to non-negative
+    int64_t ndim = x.dim();
+    TORCH_CHECK(ndim == index.dim(), "x and index must have same number of dimensions");
+    if (dim < 0) dim += ndim;
+    TORCH_CHECK(dim >= 0 && dim < ndim, "dim out of range");
+
+    // Ensure contiguous (launcher assumes contiguous)
+    if (!x.is_contiguous()) x = x.contiguous();
+    if (!index.is_contiguous()) index = index.contiguous();
+
+    // Compute sizes for gather launcher
+    int64_t outer_size = 1;
+    for (int64_t i = 0; i < dim; ++i) {
+        outer_size *= x.size(i);
+    }
+    int64_t dim_size = x.size(dim);
+    int64_t inner_size = 1;
+    for (int64_t i = dim + 1; i < ndim; ++i) {
+        inner_size *= index.size(i);
+    }
+    // Note: torch.gather requires index.size(i) <= x.size(i) for i != dim.
+
+    // Output shape = index shape, dtype float32, device CUDA
+    auto output = torch::empty_like(index, x.options().dtype(torch::kFloat32));
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    gather_forward_launcher(
+        x.data_ptr<float>(),
+        index.data_ptr<int64_t>(),
+        output.data_ptr<float>(),
+        outer_size,
+        dim_size,
+        inner_size,
+        stream
+    );
+
+    return output;
+}
+
+void register_custom_ops(pybind11::module& m) {
+    m.def("isnan_forward", &isnan_forward, "Check for NaN values element-wise",
+          py::arg("x"));
+    m.def("gather_forward", &gather_forward, "Gather values along a dimension",
+          py::arg("x"), py::arg("dim"), py::arg("index"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,21 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self, input_shape, index_shape, dim):
+        super().__init__()
+        self.dim = dim
+
+    def forward(self, x, index):
+        mask = cuda_extension.isnan_forward(x)
+        x_gathered = cuda_extension.gather_forward(x, self.dim, index)
+        return mask, x_gathered
+
+    def debug_forward(self, x, index):
+        mask = cuda_extension.isnan_forward(x)
+        yield 'step_001', mask
+        x_gathered = cuda_extension.gather_forward(x, self.dim, index)
+        yield 'step_002', x_gathered
+        yield 'step_003', (mask, x_gathered)
