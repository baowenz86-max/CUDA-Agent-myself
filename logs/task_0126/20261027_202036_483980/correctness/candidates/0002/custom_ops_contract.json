        "shape": "same as x"
      },
      "semantics": [
        "Computes GELU exact: x * 0.5 * (1 + erf(x / sqrt(2))) elementwise.",
        "No bias, no broadcasting; output has same shape and strides as input if contiguous."
      ]
    },
    {
      "name": "maxpool1d_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, C, L]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
        },
        {
          "name": "kernel_size",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "stride",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "padding",
          "kind": "int",
          "nullable": false,
          "optional": false
        },
        {
          "name": "dilation",
          "kind": "int",
          "nullable": false,
          "optional": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "[B, C, floor((L + 2*padding - dilation*(kernel_size-1) - 1)/stride + 1)]"
      },
      "semantics": [
        "Performs 1D max pooling over last dimension for each batch and channel.",
        "Padding applied to both ends; dilation spacing between kernel elements; ceil_mode false.",
        "Output length as in shape; for L divisible by stride and padding=0, output length = L / stride."
      ]
    }
  ],
