{
  "operators": [
    {
      "name": "gelu_forward",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[B, C, L]",
          "layout": "supports strides",
