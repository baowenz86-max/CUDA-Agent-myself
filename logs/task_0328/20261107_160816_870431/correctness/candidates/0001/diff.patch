--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,215 @@
+// custom_ops.cu
+// CUDA kernels for ReLU and MaxPool2d operations.
+#include <cuda_runtime.h>
+#include <limits>
+
+// -----------------------------------------------------------------------------
+// ReLU kernel: element-wise max(0, x)
+// Supports arbitrary strides via linear index and manual offset calculation.
+// Each thread handles multiple elements using a grid-stride loop.
+// -----------------------------------------------------------------------------
+__global__ void relu_forward_kernel(
+    float* __restrict__ out,
+    const float* __restrict__ in,
+    long long total_elements) {
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long grid_stride = (long long)blockDim.x * gridDim.x;
+    for (; idx < total_elements; idx += grid_stride) {
+        float v = in[idx];
+        out[idx] = (v > 0.0f) ? v : 0.0f;
+    }
+}
+
+// -----------------------------------------------------------------------------
+// MaxPool2d kernel: general N-dimensional indexing for input with arbitrary strides.
+// This kernel is optimized for the common 2x2/stride2 case but supports general
+// parameters via a loop over the pooling window.
+// grid: number of output elements (N*C*outH*outW)
+// block: 256 threads
+// -----------------------------------------------------------------------------
+template <int KERNEL_H, int KERNEL_W, int STRIDE_H, int STRIDE_W, int PAD_H, int PAD_W, int DILATION_H, int DILATION_W>
+__global__ void max_pool2d_kernel_specialized(
+    float* __restrict__ out,
+    const float* __restrict__ in,
+    int N, int C, int H, int W,
+    int outH, int outW,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w) {
+
+    long long total_out = (long long)N * C * outH * outW;
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long grid_stride = (long long)blockDim.x * gridDim.x;
+
+    for (; idx < total_out; idx += grid_stride) {
+        // Decompose linear index into 4D coordinates
+        int w = idx % outW;
+        long long tmp = idx / outW;
+        int h = tmp % outH;
+        tmp /= outH;
+        int c = tmp % C;
+        int n = tmp / C;
+
+        // Compute input window start in input coordinates
+        int h_in_start = h * STRIDE_H - PAD_H;
+        int w_in_start = w * STRIDE_W - PAD_W;
+
+        float max_val = -std::numeric_limits<float>::infinity();
+        bool has_value = false;
+
+        // Loop over kernel positions
+        #pragma unroll
+        for (int kh = 0; kh < KERNEL_H; ++kh) {
+            int h_in = h_in_start + kh * DILATION_H;
+            if (h_in < 0 || h_in >= H) continue;
+            #pragma unroll
+            for (int kw = 0; kw < KERNEL_W; ++kw) {
+                int w_in = w_in_start + kw * DILATION_W;
+                if (w_in < 0 || w_in >= W) continue;
+                long long in_offset = (long long)n * in_stride_n +
+                                      (long long)c * in_stride_c +
+                                      (long long)h_in * in_stride_h +
+                                      (long long)w_in * in_stride_w;
+                float v = in[in_offset];
+                if (v > max_val) max_val = v;
+                has_value = true;
+            }
+        }
+
+        // If no valid input (should not happen with proper ceil_mode), write -inf
+        // but PyTorch semantics would leave it undefined; for safety set 0.
+        if (!has_value) max_val = -std::numeric_limits<float>::infinity();
+
+        long long out_offset = (long long)n * out_stride_n +
+                               (long long)c * out_stride_c +
+                               (long long)h * out_stride_h +
+                               (long long)w * out_stride_w;
+        out[out_offset] = max_val;
+    }
+}
+
+// Generic max pool kernel for arbitrary kernel/stride/pad/dilation (runtime values)
+// This is less optimized but handles any parameters.
+__global__ void max_pool2d_kernel_generic(
+    float* __restrict__ out,
+    const float* __restrict__ in,
+    int N, int C, int H, int W,
+    int outH, int outW,
+    int kernel_h, int kernel_w,
+    int stride_h, int stride_w,
+    int pad_h, int pad_w,
+    int dilation_h, int dilation_w,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w) {
+
+    long long total_out = (long long)N * C * outH * outW;
+    long long idx = blockIdx.x * (long long)blockDim.x + threadIdx.x;
+    long long grid_stride = (long long)blockDim.x * gridDim.x;
+
+    for (; idx < total_out; idx += grid_stride) {
+        int w = idx % outW;
+        long long tmp = idx / outW;
+        int h = tmp % outH;
+        tmp /= outH;
+        int c = tmp % C;
+        int n = tmp / C;
+
+        int h_in_start = h * stride_h - pad_h;
+        int w_in_start = w * stride_w - pad_w;
+
+        float max_val = -std::numeric_limits<float>::infinity();
+        bool has_value = false;
+
+        for (int kh = 0; kh < kernel_h; ++kh) {
+            int h_in = h_in_start + kh * dilation_h;
+            if (h_in < 0 || h_in >= H) continue;
+            for (int kw = 0; kw < kernel_w; ++kw) {
+                int w_in = w_in_start + kw * dilation_w;
+                if (w_in < 0 || w_in >= W) continue;
+                long long in_offset = (long long)n * in_stride_n +
+                                      (long long)c * in_stride_c +
+                                      (long long)h_in * in_stride_h +
+                                      (long long)w_in * in_stride_w;
+                float v = in[in_offset];
+                if (v > max_val) max_val = v;
+                has_value = true;
+            }
+        }
+
+        if (!has_value) max_val = -std::numeric_limits<float>::infinity();
+
+        long long out_offset = (long long)n * out_stride_n +
+                               (long long)c * out_stride_c +
+                               (long long)h * out_stride_h +
+                               (long long)w * out_stride_w;
+        out[out_offset] = max_val;
+    }
+}
+
+// -----------------------------------------------------------------------------
+// Host launchers (extern "C" to be called from binding.cpp)
+// -----------------------------------------------------------------------------
+
+// ReLU launcher: takes raw pointer, total elements, stream
+extern "C" void relu_forward_launcher(
+    float* output,
+    const float* input,
+    long long total_elements,
+    cudaStream_t stream) {
+
+    const int block_size = 256;
+    // grid size: enough blocks to cover all elements, but not too high (grid-stride loop handles rest)
+    long long num_blocks_ll = (total_elements + block_size - 1) / block_size;
+    // Cap grid at 65535 blocks per dimension (CUDA limit for 1D grid in older archs), but modern GPUs support more.
+    // Use smaller cap to avoid excessive grid launch overhead. We'll cap at 1048576 (2^20) blocks.
+    int grid_size = (int)std::min(num_blocks_ll, 1048576LL);
+    relu_forward_kernel<<<grid_size, block_size, 0, stream>>>(
+        output, input, total_elements);
+}
+
+// MaxPool2d launcher: specialized for common 2x2/2 case and generic fallback.
+// Inputs: output and input raw pointers, dimensions, strides (as long long),
+// kernel/stride/pad/dilation values, stream.
+extern "C" void max_pool2d_forward_launcher(
+    float* output,
+    const float* input,
+    int N, int C, int H, int W,
+    int outH, int outW,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,
+    int kernel_h, int kernel_w,
+    int stride_h, int stride_w,
+    int pad_h, int pad_w,
+    int dilation_h, int dilation_w,
+    cudaStream_t stream) {
+
+    long long total_out = (long long)N * C * outH * outW;
+    const int block_size = 256;
+    long long num_blocks_ll = (total_out + block_size - 1) / block_size;
+    int grid_size = (int)std::min(num_blocks_ll, 1048576LL);
+
+    // Dispatch to specialized kernels for common cases to improve performance.
+    // We only use specialized if parameters exactly match certain patterns.
+    // Otherwise use generic kernel.
+    if (kernel_h == 2 && kernel_w == 2 &&
+        stride_h == 2 && stride_w == 2 &&
+        pad_h == 0 && pad_w == 0 &&
+        dilation_h == 1 && dilation_w == 1) {
+        max_pool2d_kernel_specialized<2, 2, 2, 2, 0, 0, 1, 1><<<grid_size, block_size, 0, stream>>>(
+            output, input,
+            N, C, H, W,
+            outH, outW,
+            in_stride_n, in_stride_c, in_stride_h, in_stride_w,
+            out_stride_n, out_stride_c, out_stride_h, out_stride_w);
+    } else {
+        max_pool2d_kernel_generic<<<grid_size, block_size, 0, stream>>>(
+            output, input,
+            N, C, H, W,
+            outH, outW,
+            kernel_h, kernel_w,
+            stride_h, stride_w,
+            pad_h, pad_w,
+            dilation_h, dilation_w,
+            in_stride_n, in_stride_c, in_stride_h, in_stride_w,
+            out_stride_n, out_stride_c, out_stride_h, out_stride_w);
+    }
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,134 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void relu_forward_launcher(
+    float* output,
+    const float* input,
+    long long total_elements,
+    cudaStream_t stream);
+
+extern "C" void max_pool2d_forward_launcher(
+    float* output,
+    const float* input,
+    int N, int C, int H, int W,
+    int outH, int outW,
+    long long in_stride_n, long long in_stride_c, long long in_stride_h, long long in_stride_w,
+    long long out_stride_n, long long out_stride_c, long long out_stride_h, long long out_stride_w,
+    int kernel_h, int kernel_w,
+    int stride_h, int stride_w,
+    int pad_h, int pad_w,
+    int dilation_h, int dilation_w,
+    cudaStream_t stream);
+
+// ReLU forward wrapper
+torch::Tensor relu_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "relu_forward: input must be a CUDA tensor");
+    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "relu_forward: input must be float32");
+    // No contiguity requirement; kernel uses linear index and works with arbitrary strides (input is contiguous in our case but we support general)
+    auto output = torch::empty_like(x);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    relu_forward_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        (long long)x.numel(),
+        stream);
+
+    TORCH_CHECK(cudaGetLastError() == cudaSuccess, "relu_forward: CUDA kernel launch failed");
+    return output;
+}
+
+// MaxPool2d forward wrapper
+torch::Tensor max_pool2d_forward(
+    torch::Tensor x,
+    int64_t kernel_size,
+    int64_t stride,
+    int64_t padding,
+    int64_t dilation,
+    bool ceil_mode) {
+
+    TORCH_CHECK(x.is_cuda(), "max_pool2d_forward: input must be a CUDA tensor");
+    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "max_pool2d_forward: input must be float32");
+    TORCH_CHECK(x.dim() == 4, "max_pool2d_forward: input must be 4D (N, C, H, W)");
+
+    int N = x.size(0);
+    int C = x.size(1);
+    int H = x.size(2);
+    int W = x.size(3);
+
+    // Convert parameters to int (check reasonable ranges)
+    TORCH_CHECK(kernel_size > 0 && stride > 0 && padding >= 0 && dilation > 0,
+        "max_pool2d_forward: invalid kernel/stride/padding/dilation values");
+    int kH = static_cast<int>(kernel_size);
+    int kW = static_cast<int>(kernel_size);
+    int sH = static_cast<int>(stride);
+    int sW = static_cast<int>(stride);
+    int pH = static_cast<int>(padding);
+    int pW = static_cast<int>(padding);
+    int dH = static_cast<int>(dilation);
+    int dW = static_cast<int>(dilation);
+
+    // Compute output spatial dimensions (PyTorch MaxPool2d formula)
+    int64_t outH_ll, outW_ll;
+    if (ceil_mode) {
+        outH_ll = (H + 2 * pH - dH * (kH - 1) - 1 + sH - 1) / sH + 1;
+        outW_ll = (W + 2 * pW - dW * (kW - 1) - 1 + sW - 1) / sW + 1;
+    } else {
+        outH_ll = (H + 2 * pH - dH * (kH - 1) - 1) / sH + 1;
+        outW_ll = (W + 2 * pW - dW * (kW - 1) - 1) / sW + 1;
+    }
+    TORCH_CHECK(outH_ll > 0 && outW_ll > 0, "max_pool2d_forward: computed output size is non-positive");
+    int outH = static_cast<int>(outH_ll);
+    int outW = static_cast<int>(outW_ll);
+
+    // Allocate output tensor with same options as input
+    auto output = torch::empty({N, C, outH, outW}, x.options());
+
+    // Get strides as long long
+    long long in_stride_n = x.stride(0);
+    long long in_stride_c = x.stride(1);
+    long long in_stride_h = x.stride(2);
+    long long in_stride_w = x.stride(3);
+    long long out_stride_n = output.stride(0);
+    long long out_stride_c = output.stride(1);
+    long long out_stride_h = output.stride(2);
+    long long out_stride_w = output.stride(3);
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    max_pool2d_forward_launcher(
+        output.data_ptr<float>(),
+        x.data_ptr<float>(),
+        N, C, H, W,
+        outH, outW,
+        in_stride_n, in_stride_c, in_stride_h, in_stride_w,
+        out_stride_n, out_stride_c, out_stride_h, out_stride_w,
+        kH, kW,
+        sH, sW,
+        pH, pW,
+        dH, dW,
+        stream);
+
+    TORCH_CHECK(cudaGetLastError() == cudaSuccess, "max_pool2d_forward: CUDA kernel launch failed");
+    return output;
+}
+
+// Registration
+void register_custom_ops(pybind11::module& m) {
+    m.def("relu_forward", &relu_forward,
+          "ReLU forward (max(x, 0))",
+          pybind11::arg("x"));
+    m.def("max_pool2d_forward", &max_pool2d_forward,
+          "MaxPool2d forward",
+          pybind11::arg("x"),
+          pybind11::arg("kernel_size"),
+          pybind11::arg("stride"),
+          pybind11::arg("padding"),
+          pybind11::arg("dilation"),
+          pybind11::arg("ceil_mode"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,33 @@
+import torch
+import torch.nn as nn
+
+
+class ModelNew(nn.Module):
+    def __init__(self, in_channels, kernel_size, pool_kernel_size, pool_stride):
+        super(ModelNew, self).__init__()
+        self.pool_kernel_size = pool_kernel_size
+        self.pool_stride = pool_stride
+
+    def forward(self, x):
+        x = cuda_extension.relu_forward(x)
+        x = cuda_extension.max_pool2d_forward(
+            x,
+            kernel_size=self.pool_kernel_size,
+            stride=self.pool_stride,
+            padding=0,
+            dilation=1,
+            ceil_mode=False)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.relu_forward(x)
+        yield "step_001", x
+        x = cuda_extension.max_pool2d_forward(
+            x,
+            kernel_size=self.pool_kernel_size,
+            stride=self.pool_stride,
+            padding=0,
+            dilation=1,
+            ceil_mode=False)
+        yield "step_002", x
+        yield "step_003", x