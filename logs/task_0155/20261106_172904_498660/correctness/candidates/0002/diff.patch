+                                        int D_out, int H_out, int W_out,
+                                        bool has_bias,
+                                        cudaStream_t stream) {
+    int total = N * C_out * D_out * H_out * W_out;
+    if (total <= 0) return;
+    const int block_size = 256;
+    int grid_size = (total + block_size - 1) / block_size;
