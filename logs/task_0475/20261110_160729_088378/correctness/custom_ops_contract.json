        {
          "name": "alpha",
          "kind": "float",
          "default": 1.0,
          "optional": true,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as x"
      },
      "semantics": [
        "对应参考语句 x = F.elu(x)，使用默认 alpha=1.0。",
        "逐元素计算：if x > 0: y = x; else: y = alpha * (exp(x) - 1)。",
        "输入输出均为 float32 CUDA tensor，支持任意 stride。",
        "不执行 inplace 操作，返回新张量。"
      ]
    }
