        "对应参考语句 x = torch.einsum('ijk->ijk', x)，是 identity 操作。",
        "输出必须与输入完全一致，包括 shape、dtype、device、数值和 stride。",
        "不接受任何 bias、归一化或其他修改。"
      ]
    },
    {
      "name": "custom_elu",
      "parameters": [
        {
          "name": "x",
          "kind": "tensor",
          "dtype": "torch.float32",
          "device": "cuda",
          "shape": "[512, 1024, 1024]",
          "layout": "supports strides",
          "nullable": false,
          "optional": false
