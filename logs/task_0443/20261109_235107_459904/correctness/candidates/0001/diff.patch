--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,67 @@
+#include <cuda_runtime.h>
+#include <cmath>
+
+// GELU tanh approximation kernel
+__global__ void gelu_kernel(const float* __restrict__ input,
+                            float* __restrict__ output,
+                            int64_t numel) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    const float c1 = 0.7978845608028654f;  // sqrt(2/pi)
+    const float c2 = 0.044715f;
+    for (int64_t i = idx; i < numel; i += stride) {
+        float x = input[i];
+        float x3 = x * x * x;
+        float inner = c1 * (x + c2 * x3);
+        float tanh_val = tanhf(inner);
+        output[i] = 0.5f * x * (1.0f + tanh_val);
+    }
+}
+
+// Cumulative sum along dim=1
+// Assumes x is 4D: [B, C, H, W]
+// Each thread handles one (b, h, w) position and accumulates over C
+__global__ void cumsum_dim1_kernel(const float* __restrict__ input,
+                                   float* __restrict__ output,
+                                   int64_t B, int64_t C, int64_t H, int64_t W) {
+    int64_t total_threads = B * H * W;
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+
+    for (int64_t pos = idx; pos < total_threads; pos += stride) {
+        int64_t w = pos % W;
+        int64_t tmp = pos / W;
+        int64_t h = tmp % H;
+        int64_t b = tmp / H;
+
+        float accum = 0.0f;
+        int64_t base = (b * C + 0) * H * W + h * W + w;
+        for (int64_t c = 0; c < C; ++c) {
+            accum += input[base + c * H * W];
+            output[base + c * H * W] = accum;
+        }
+    }
+}
+
+// Launchers (no PyTorch dependencies)
+extern "C" void gelu_forward_launcher(const float* input,
+                                      float* output,
+                                      int64_t numel,
+                                      cudaStream_t stream) {
+    const int threads = 256;
+    // Grid-stride loop, limit to reasonable grid size for large numel
+    int64_t blocks_64 = (numel + threads - 1) / threads;
+    int blocks = static_cast<int>(min(blocks_64, static_cast<int64_t>(65535)));
+    gelu_kernel<<<blocks, threads, 0, stream>>>(input, output, numel);
+}
+
+extern "C" void cumsum_dim1_forward_launcher(const float* input,
+                                              float* output,
+                                              int64_t B, int64_t C, int64_t H, int64_t W,
+                                              cudaStream_t stream) {
+    int64_t total_positions = B * H * W;
+    const int threads = 256;
+    int64_t blocks_64 = (total_positions + threads - 1) / threads;
+    int blocks = static_cast<int>(min(blocks_64, static_cast<int64_t>(65535)));
+    cumsum_dim1_kernel<<<blocks, threads, 0, stream>>>(input, output, B, C, H, W);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,70 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void gelu_forward_launcher(const float* input,
+                                      float* output,
+                                      int64_t numel,
+                                      cudaStream_t stream);
+
+extern "C" void cumsum_dim1_forward_launcher(const float* input,
+                                              float* output,
+                                              int64_t B, int64_t C, int64_t H, int64_t W,
+                                              cudaStream_t stream);
+
+// Wrapper for gelu_forward
+torch::Tensor gelu_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "gelu_forward: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "gelu_forward: input must be float32");
+
+    auto output = torch::empty_like(x);
+    int64_t numel = x.numel();
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    gelu_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        numel,
+        stream
+    );
+
+    return output;
+}
+
+// Wrapper for cumsum_dim1_forward
+torch::Tensor cumsum_dim1_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "cumsum_dim1_forward: input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "cumsum_dim1_forward: input must be float32");
+    TORCH_CHECK(x.dim() == 4, "cumsum_dim1_forward: input must be 4D (B, C, H, W)");
+
+    auto output = torch::empty_like(x);
+    int64_t B = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    cumsum_dim1_forward_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        B, C, H, W,
+        stream
+    );
+
+    return output;
+}
+
+// Registration
+void register_custom_ops(pybind11::module& m) {
+    m.def("gelu_forward", &gelu_forward,
+          "GELU activation forward (tanh approximation)",
+          py::arg("x"));
+    m.def("cumsum_dim1_forward", &cumsum_dim1_forward,
+          "Cumulative sum along dimension 1",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,20 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x):
+        x = cuda_extension.gelu_forward(x)
+        x = cuda_extension.cumsum_dim1_forward(x)
+        return x
+
+    def debug_forward(self, x):
+        x = cuda_extension.gelu_forward(x)
+        yield 'step_001', x
+        x = cuda_extension.cumsum_dim1_forward(x)
+        yield 'step_002', x
+        yield 'step_003', x
