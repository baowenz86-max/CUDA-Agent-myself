          "nullable": false,
          "optional": false
        },
        {
          "name": "min_value",
          "kind": "float",
          "optional": false,
          "nullable": false
        }
      ],
      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对应参考语句 return torch.minimum(x, self.min_value)。",
        "逐元素计算 max(input, min_value)，与 torch.minimum 在 NaN 传播上的行为保持一致，仅对 float32 CUDA 张量。",
        "不广播，输出形状与输入相同。"
      ]
    }
  ],
  "reference_steps": [
