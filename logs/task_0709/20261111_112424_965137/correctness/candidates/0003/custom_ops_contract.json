  "reference_steps": [
    {
      "checkpoint": "step_001",
      "source": "xs = torch.chunk(x, chunks=self.num_images, dim=0)",
      "semantics": [
        "将输入张量 x 在 dim=0 上均匀分割成 self.num_images 个 chunk，返回元组。",
        "每个 chunk 形状为 [batch_size / num_images, channels, height, width]，即 [256, 3, 128, 128]。",
        "保留原始 stride [49152, 16384, 128, 1]（chunk 是视图）。"
      ]
    },
    {
      "checkpoint": "step_002",
      "source": "ys = [torch.histc(chunk, bins=num_bins, min=bins_range[0], max=bins_range[1]) for chunk in xs]",
      "semantics": [
        "对每个 chunk 计算直方图，参数为 bins=num_bins, min=0, max=255。",
        "结果 ys 是一个列表，包含 num_images 个形状 [num_bins] 的 float32 CUDA 张量。",
        "每个直方图独立计算，与 torch.histc 的数值语义一致。"
      ]
    },
    {
      "checkpoint": "step_003",
      "source": "y = torch.cat(ys, dim=0)",
      "semantics": [
        "将 ys 列表中的张量在 dim=0 上拼接，得到形状 [num_images * num_bins] = [20] 的张量。",
        "拼接顺序与 list 顺序一致。"
      ]
    },
    {
      "checkpoint": "step_004",
      "source": "return y",
      "semantics": [
        "返回最终结果张量 y，形状 [20]，float32，CUDA。"
      ]
    }
  ]
