--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,52 @@
+#include <cuda_runtime.h>
+
+// rot90_clone_forward: out[b,w,c,h] = in[b,c,h,w]
+// Input:  x shape [B, C, H, W] contiguous
+// Output: y shape [B, W, C, H] contiguous
+__global__ void rot90_clone_kernel(const float* __restrict__ input,
+                                   float* __restrict__ output,
+                                   int batch,
+                                   int channels,
+                                   int height,
+                                   int width) {
+    int64_t total = (int64_t)batch * width * channels * height;
+    int64_t idx = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = (int64_t)blockDim.x * gridDim.x;
+
+    for (int64_t i = idx; i < total; i += stride) {
+        // Output linear index: i = ((b * W + w) * C + c) * H + h
+        int h = (int)(i % height);
+        int64_t tmp = i / height;
+        int c = (int)(tmp % channels);
+        tmp /= channels;
+        int w = (int)(tmp % width);
+        int b = (int)(tmp / width);
+
+        // Input linear index: ((b * C + c) * H + h) * W + w
+        int64_t in_idx = (((int64_t)b * channels + c) * height + h) * width + w;
+        output[i] = input[in_idx];
+    }
+}
+
+extern "C" void rot90_clone_launcher(const float* input,
+                                       float* output,
+                                       int batch,
+                                       int channels,
+                                       int height,
+                                       int width,
+                                       cudaStream_t stream) {
+    int64_t total = (int64_t)batch * width * channels * height;
+    if (total <= 0) return;
+
+    int block_size = 256;
+    int sm_count = 0;
+    cudaDeviceGetAttribute(&sm_count, cudaDevAttrMultiProcessorCount, 0);
+    int max_blocks = (int)((total + block_size - 1) / block_size);
+    // 使用足够的 blocks 以利用 SM，但不要超过需求
+    int grid_size = sm_count * 8;
+    if (grid_size > max_blocks) grid_size = max_blocks;
+    if (grid_size < 1) grid_size = 1;
+
+    rot90_clone_kernel<<<grid_size, block_size, 0, stream>>>(
+        input, output, batch, channels, height, width);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,52 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declaration of launcher from custom_ops.cu
+extern "C" void rot90_clone_launcher(
+    const float* input,
+    float* output,
+    int batch,
+    int channels,
+    int height,
+    int width,
+    cudaStream_t stream);
+
+torch::Tensor rot90_clone_forward(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "Input must be float32");
+    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
+    TORCH_CHECK(x.dim() == 4, "Input must be 4D [batch, channels, height, width]");
+
+    int batch = x.size(0);
+    int channels = x.size(1);
+    int height = x.size(2);
+    int width = x.size(3);
+
+    // Output shape: [batch, width, channels, height]
+    auto output = torch::empty({batch, width, channels, height}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    rot90_clone_launcher(
+        x.data_ptr<float>(),
+        output.data_ptr<float>(),
+        batch,
+        channels,
+        height,
+        width,
+        stream
+    );
+
+    return output;
+}
+
+void register_rot90_clone(pybind11::module& m) {
+    m.def("rot90_clone_forward", &rot90_clone_forward,
+          "Clone and rotate 90 degrees (k=1, dims=(1,2))",
+          py::arg("x"));
+}
+
+REGISTER_BINDING(rot90_clone, register_rot90_clone);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,18 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return cuda_extension.rot90_clone_forward(x)
+
+    def debug_forward(self, x: torch.Tensor):
+        x_clone = cuda_extension.rot90_clone_forward(x)
+        yield 'step_001', x_clone
+        x_rotated = cuda_extension.rot90_clone_forward(x_clone)
+        yield 'step_002', x_rotated
+        yield 'step_003', x_rotated
