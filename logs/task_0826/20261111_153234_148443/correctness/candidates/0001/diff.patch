--- before/kernels/custom_ops.cu
+++ after/kernels/custom_ops.cu
@@ -0,0 +1,61 @@
+// custom_ops.cu - CUDA kernels and launchers for clone_to_cuda and rot90_1_2
+// This file contains only raw CUDA kernels and C-style launchers.
+// No torch/ATen/c10/pybind dependencies.
+
+#include <cuda_runtime.h>
+#include <cstdint>
+
+// Kernel: clone (device-to-device copy, used only if both input and output are on GPU)
+// The binding layer may choose to use cudaMemcpy instead, but this kernel is provided for completeness.
+__global__ void clone_kernel(const float* __restrict__ input, float* __restrict__ output, int64_t total) {
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx < total) {
+        output[idx] = input[idx];
+    }
+}
+
+// Kernel: rot90 with k=1, dims=(1,2)
+// Input shape: [B, C, H, W]
+// Output shape: [B, W, C, H]
+// Mapping: out[b, w, c, h] = in[b, c, H - 1 - h, w]
+__global__ void rot90_1_2_kernel(const float* __restrict__ input, float* __restrict__ output,
+                                 int64_t B, int64_t C, int64_t H, int64_t W) {
+    int64_t total = B * W * C * H;
+    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
+    int64_t stride = blockDim.x * gridDim.x;
+    
+    for (int64_t i = idx; i < total; i += stride) {
+        // Decompose output linear index [B, W, C, H] (contiguous in output)
+        int64_t h = i % H;
+        int64_t tmp = i / H;
+        int64_t c = tmp % C;
+        tmp /= C;
+        int64_t w = tmp % W;
+        int64_t b = tmp / W;
+        
+        // Input linear index [B, C, H, W] (contiguous in input)
+        int64_t in_idx = ((b * C + c) * H + (H - 1 - h)) * W + w;
+        output[i] = input[in_idx];
+    }
+}
+
+// Launcher for clone (device-to-device). Assumes input and output are both on current device.
+extern "C" void clone_to_cuda_launcher(const float* input, float* output, int64_t total, cudaStream_t stream) {
+    if (total <= 0) return;
+    int threads = 256;
+    int blocks = (int)((total + threads - 1) / threads);
+    // Cap blocks to a reasonable max and use grid-stride loop if needed
+    if (blocks > 65535) blocks = 65535;
+    clone_kernel<<<blocks, threads, 0, stream>>>(input, output, total);
+}
+
+// Launcher for rot90_1_2. Assumes input and output are both on current device and contiguous.
+extern "C" void rot90_1_2_launcher(const float* input, float* output,
+                                   int64_t B, int64_t C, int64_t H, int64_t W, cudaStream_t stream) {
+    int64_t total = B * W * C * H;
+    if (total <= 0) return;
+    int threads = 256;
+    int64_t blocks64 = (total + threads - 1) / threads;
+    int blocks = (blocks64 > 65535) ? 65535 : (int)blocks64;
+    rot90_1_2_kernel<<<blocks, threads, 0, stream>>>(input, output, B, C, H, W);
+}
--- before/kernels/custom_ops_binding.cpp
+++ after/kernels/custom_ops_binding.cpp
@@ -0,0 +1,54 @@
+#include <torch/types.h>
+#include <torch/csrc/utils/pybind.h>
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAStream.h>
+#include "../binding_registry.h"
+
+// Declare launchers from custom_ops.cu
+extern "C" void clone_to_cuda_launcher(const float* input, float* output, int64_t total, cudaStream_t stream);
+extern "C" void rot90_1_2_launcher(const float* input, float* output,
+                                   int64_t B, int64_t C, int64_t H, int64_t W, cudaStream_t stream);
+
+static torch::Tensor clone_to_cuda(torch::Tensor x) {
+    TORCH_CHECK(x.is_cpu(), "clone_to_cuda expects a CPU tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "clone_to_cuda expects float32 tensor");
+    TORCH_CHECK(x.is_contiguous(), "clone_to_cuda expects contiguous input");
+
+    auto output = torch::empty(x.sizes(), x.options().device(torch::kCUDA));
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    cudaMemcpyAsync(output.data_ptr<float>(), x.data_ptr<float>(),
+                    x.numel() * sizeof(float), cudaMemcpyHostToDevice, stream);
+    TORCH_CHECK(cudaGetLastError() == cudaSuccess, "cudaMemcpyAsync failed");
+
+    return output;
+}
+
+static torch::Tensor rot90_1_2(torch::Tensor x) {
+    TORCH_CHECK(x.is_cuda(), "rot90_1_2 expects a CUDA tensor");
+    TORCH_CHECK(x.dtype() == torch::kFloat32, "rot90_1_2 expects float32 tensor");
+    TORCH_CHECK(x.dim() == 4, "rot90_1_2 expects 4D tensor");
+    TORCH_CHECK(x.is_contiguous(), "rot90_1_2 expects contiguous input");
+
+    int64_t B = x.size(0);
+    int64_t C = x.size(1);
+    int64_t H = x.size(2);
+    int64_t W = x.size(3);
+
+    // Output shape [B, W, C, H]
+    auto output = torch::empty({B, W, C, H}, x.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+    rot90_1_2_launcher(x.data_ptr<float>(), output.data_ptr<float>(),
+                       B, C, H, W, stream);
+    TORCH_CHECK(cudaGetLastError() == cudaSuccess, "rot90_1_2 kernel launch failed");
+
+    return output;
+}
+
+static void register_custom_ops(pybind11::module& m) {
+    m.def("clone_to_cuda", &clone_to_cuda, "Clone CPU tensor to CUDA", py::arg("x"));
+    m.def("rot90_1_2", &rot90_1_2, "Rotate tensor 90 degrees in dims (1,2)", py::arg("x"));
+}
+
+REGISTER_BINDING(custom_ops, register_custom_ops);
--- before/model_new.py
+++ after/model_new.py
@@ -0,0 +1,21 @@
+import torch
+import torch.nn as nn
+import cuda_extension
+
+
+class ModelNew(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        x_clone = cuda_extension.clone_to_cuda(x)
+        x_rotated = cuda_extension.rot90_1_2(x_clone)
+        return x_rotated
+
+    def debug_forward(self, *inputs):
+        x = inputs[0]
+        x_clone = cuda_extension.clone_to_cuda(x)
+        yield 'step_001', x_clone
+        x_rotated = cuda_extension.rot90_1_2(x_clone)
+        yield 'step_002', x_rotated
+        yield 'step_003', x_rotated
