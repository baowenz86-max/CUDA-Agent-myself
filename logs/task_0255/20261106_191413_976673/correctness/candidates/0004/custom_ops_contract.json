      "returns": {
        "type": "tensor",
        "dtype": "torch.float32",
        "device": "cuda",
        "shape": "same as input"
      },
      "semantics": [
        "对应 reference_steps step_003: x = x + self.bias",
        "将 bias 张量沿通道维广播加到 input 上",
        "bias 形状 [16,1,1]，广播后与 input 形状相同",
        "输出与 input 具有相同的 shape、stride、dtype、device"
      ]
    }
