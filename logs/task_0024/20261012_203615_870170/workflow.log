Pseudo:
__global__ void histogram_kernel(const float* data, int N, uint32_t prefix, int prefix_len, int* hist) {
    extern __shared__ int shist[]; // size 256
    for (int i=threadIdx.x; i<256; i+=blockDim.x) shist[i]=0;
    __syncthreads();
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int stride = blockDim.x * gridDim.x;
    int byte_pos = 3 - prefix_len;
    for (int i=idx; i<N; i+=stride) {
        uint32_t key = float_to_sortable(data[i]);
        if (prefix_len == 0 || ((key >> (8*(4-prefix_len))) == (prefix >> (8*(4-prefix_len))))) {
            int b = (key >> (8*byte_pos)) & 0xFF;
            atomicAdd(&shist[b], 1);
        }
    }
    __syncthreads();
    for (int i=threadIdx.x; i<256; i+=blockDim.x) {
        if (shist[i] != 0) atomicAdd(&hist[i], shist[i]);
    }
}

