    "kernels/custom_ops.cu": "// custom_ops.cu - optimized CUDA kernels for conv_transpose1d, median, and ne\n#include <cuda_runtime.h>\n#include <cstdint>\n\n// -----------------------------------------------------------------------------\n// ConvTranspose1d forward kernel\n// Input: x shape (N, C_in, L_in)\n// Weight: w shape (C_in, C_out, K)\n// Bias: b shape (C_out)\n// Output: y shape (N, C_out, L_out)\n// L_out = (L_in - 1) * stride - 2 * padding + kernel_size + output_padding\n// General algorithm with modulo; specialized version below for stride=2, padding=1, K=3\n__global__ void conv_transpose1d_forward_general_kernel(\n    const float* __restrict__ x,\n    const float* __restrict__ weight,\n    const float* __restrict__ bias,\n    float* __restrict__ y,\n    int N, int C_in, int C_out, int L_in, int L_out,\n    int kernel_size, int stride, int padding, int output_padding)\n{\n    int total_elements = N * C_out * L_out;\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int grid_size = blockDim.x * gridDim.x;\n    for (int i = idx; i < total_elements; i += grid_size) {\n        int lout = i % L_out;\n        int tmp = i / L_out;\n        int co = tmp % C_out;\n        int n = tmp / C_out;\n        float acc = bias[co];\n        for (int ci = 0; ci < C_in; ++ci) {\n            const float* x_slice = x + (n * C_in + ci) * L_in;\n            const float* w_slice = weight + (ci * C_out + co) * kernel_size;\n            for (int k = 0; k < kernel_size; ++k) {\n                int lin_times_stride = lout + padding - k;\n                if (lin_times_stride >= 0 && lin_times_stride % stride == 0) {\n                    int lin = lin_times_stride / stride;\n                    if (lin < L_in) {\n                        acc += x_slice[lin] * w_slice[k];\n                    }\n                }\n            }\n        }\n        y[i] = acc;\n    }\n}\n\n// Specialized kernel for stride=2, padding=1, kernel_size=3, output_padding=1\n// This is the case in the reference model.\n__global__ void conv_transpose1d_forward_specialized_kernel(\n    const float* __restrict__ x,\n    const float* __restrict__ weight,\n    const float* __restrict__ bias,\n    float* __restrict__ y,\n    int N, int C_in, int C_out, int L_in, int L_out)\n{\n    int total = N * C_out * L_out;\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int stride = blockDim.x * gridDim.x;\n    for (int i = idx; i < total; i += stride) {\n        int lout = i % L_out;\n        int tmp = i / L_out;\n        int co = tmp % C_out;\n        int n = tmp / C_out;\n        float acc = bias[co];\n        if (lout % 2 == 0) {\n            // even lout: only k=1 contributes, lin = lout/2\n            int lin = lout / 2;\n            if (lin < L_in) {\n                for (int ci = 0; ci < C_in; ++ci) {\n                    acc += x[(n * C_in + ci) * L_in + lin] * weight[(ci * C_out + co) * 3 + 1];\n                }\n            }\n        } else {\n            // odd lout: k=0 with lin=(lout+1)/2, k=2 with lin=(lout-1)/2\n            int lin0 = (lout + 1) / 2;\n            if (lin0 < L_in) {\n                for (int ci = 0; ci < C_in; ++ci) {\n                    acc += x[(n * C_in + ci) * L_in + lin0] * weight[(ci * C_out + co) * 3 + 0];\n                }\n            }\n            int lin2 = (lout - 1) / 2;\n            if (lin2 >= 0 && lin2 < L_in) {\n                for (int ci = 0; ci < C_in; ++ci) {\n                    acc += x[(n * C_in + ci) * L_in + lin2] * weight[(ci * C_out + co) * 3 + 2];\n                }\n            }\n        }\n        y[i] = acc;\n    }\n}\n\nextern \"C\" void conv_transpose1d_forward_launcher(\n    const float* x,\n    const float* weight,\n    const float* bias,\n    float* y,\n    int N, int C_in, int C_out, int L_in, int L_out,\n    int kernel_size, int stride, int padding, int output_padding,\n    cudaStream_t stream)\n{\n    int total_elements = N * C_out * L_out;\n    int threads = 256;\n    int blocks = (total_elements + threads - 1) / threads;\n    if (blocks > 65535) blocks = 65535; // grid-stride loop handles rest\n    if (stride == 2 && padding == 1 && kernel_size == 3 && output_padding == 1) {\n        conv_transpose1d_forward_specialized_kernel<<<blocks, threads, 0, stream>>>(\n            x, weight, bias, y, N, C_in, C_out, L_in, L_out);\n    } else {\n        conv_transpose1d_forward_general_kernel<<<blocks, threads, 0, stream>>>(\n            x, weight, bias, y, N, C_in, C_out, L_in, L_out,\n            kernel_size, stride, padding, output_padding);\n    }\n}\n\n// -----------------------------------------------------------------------------\n// Median computation (exact, using radix select on sortable uint32 keys)\n// Transform float to sortable uint32: if x>=0, bits | 0x80000000; else ~bits.\n__device__ uint32_t float_to_sortable(float x) {\n    uint32_t bits = __float_as_uint(x);\n    return (x >= 0.0f) ? (bits ^ 0x80000000) : (~bits);\n}\n\n__device__ float sortable_to_float(uint32_t key) {\n    uint32_t bits;\n    if (key & 0x80000000) {\n        bits = key ^ 0x80000000;\n    } else {\n        bits = ~key;\n    }\n    return __uint_as_float(bits);\n}\n\n// Histogram kernel for one byte position, filtering by prefix\n// prefix_len is number of high bytes already fixed (0..3).\n// We build histogram of byte at position (3 - prefix_len).\n// Elements are considered only if their high prefix matches `prefix`.\n__global__ void median_histogram_kernel(\n    const float* __restrict__ input,\n    int N,\n    uint32_t prefix,\n    int prefix_len,\n    int* __restrict__ hist)\n{\n    extern __shared__ int shist[]; // size 256 ints\n    for (int i = threadIdx.x; i < 256; i += blockDim.x) {\n        shist[i] = 0;\n    }\n    __syncthreads();\n\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int stride = blockDim.x * gridDim.x;\n    int byte_pos = 3 - prefix_len;\n    uint32_t shift_high = 8 * (4 - prefix_len);\n    uint32_t prefix_shifted = (prefix_len == 0) ? 0 : (prefix >> shift_high);\n\n    for (int i = idx; i < N; i += stride) {\n        uint32_t key = float_to_sortable(input[i]);\n        bool match = true;\n        if (prefix_len > 0) {\n            uint32_t key_high = key >> shift_high;\n            match = (key_high == prefix_shifted);\n        }\n        if (match) {\n            int b = (key >> (8 * byte_pos)) & 0xFF;\n            atomicAdd(&shist[b], 1);\n        }\n    }\n    __syncthreads();\n    for (int i = threadIdx.x; i < 256; i += blockDim.x) {\n        if (shist[i] != 0) {\n            atomicAdd(&hist[i], shist[i]);\n        }\n    }\n}\n\nextern \"C\" void median_launcher(const float* input, int numel, float* output, cudaStream_t stream)\n{\n    if (numel <= 0) {\n        // Should not happen; output NaN? We'll write 0.0f\n        float zero = 0.0f;\n        cudaMemcpyAsync(output, &zero, sizeof(float), cudaMemcpyHostToDevice, stream);\n        return;\n    }\n\n    int k = (numel - 1) / 2; // 0-based index of lower median\n    uint32_t prefix = 0;\n    int prefix_len = 0;\n    int* d_hist;\n    cudaMalloc(&d_hist, 256 * sizeof(int));\n\n    // Allocate host copy for histogram\n    int h_hist[256];\n\n    int threads = 256;\n    int blocks = (numel + threads - 1) / threads;\n    if (blocks > 65535) blocks = 65535; // grid-stride loop handles rest\n    int shmem_size = 256 * sizeof(int);\n\n    for (int iter = 0; iter < 4; ++iter) {\n        // Reset histogram device memory to zero\n        cudaMemsetAsync(d_hist, 0, 256 * sizeof(int), stream);\n        // Launch histogram kernel\n        median_histogram_kernel<<<blocks, threads, shmem_size, stream>>>(\n            input, numel, prefix, prefix_len, d_hist);\n        // Synchronize to get histogram to host\n        cudaStreamSynchronize(stream);\n        cudaMemcpy(h_hist, d_hist, 256 * sizeof(int), cudaMemcpyDeviceToHost);\n\n        // Prefix sum and find byte value\n        int cumulative = 0;\n        int chosen_byte = 0;\n        for (int b = 0; b < 256; ++b) {\n            int count = h_hist[b];\n            if (k < cumulative + count) {\n                chosen_byte = b;\n                break;\n            }\n            cumulative += count;\n        }\n        // Update k to index within chosen byte\n        k = k - cumulative;\n        // Update prefix\n        prefix = (prefix << 8) | chosen_byte;\n        prefix_len++;\n    }\n\n    // Now prefix holds the exact key of the k-th element\n    uint32_t median_key = prefix;\n    float median_val = sortable_to_float(median_key);\n\n    cudaFree(d_hist);\n\n    // Copy median value to output (device pointer)\n    cudaMemcpyAsync(output, &median_val, sizeof(float), cudaMemcpyHostToDevice, stream);\n}\n\n// -----------------------------------------------------------------------------\n// Element-wise not-equal kernel: output[i] = (input[i] != scalar)\n__global__ void ne_float_scalar_kernel(\n    const float* __restrict__ input,\n    float scalar,\n    uint8_t* __restrict__ output,\n    int N)\n{\n    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n    int stride = blockDim.x * gridDim.x;\n    for (int i = idx; i < N; i += stride) {\n        output[i] = (input[i] != scalar) ? 1 : 0;\n    }\n}\n\nextern \"C\" void ne_float_scalar_launcher(\n    const float* input,\n    float scalar,\n    uint8_t* output,\n    int numel,\n    cudaStream_t stream)\n{\n    int threads = 256;\n    int blocks = (numel + threads - 1) / threads;\n    if (blocks > 65535) blocks = 65535;\n    ne_float_scalar_kernel<<<blocks, threads, 0, stream>>>(input, scalar, output, numel);\n}\n"
