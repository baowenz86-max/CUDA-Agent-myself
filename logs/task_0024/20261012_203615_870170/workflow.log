        )
        yield "step_001", x

        median_value = cuda_extension.median_forward(x)
        yield "step_002", median_value

        x = cuda_extension.ne_forward(x, median_value)
        yield "step_003", x

        z = cuda_extension.ne_forward(z, self.threshold)
