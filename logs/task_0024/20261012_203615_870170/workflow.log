Specialized kernel:
__global__ void conv_transpose1d_forward_specialized_kernel(
    const float* __restrict__ x, const float* __restrict__ weight, const float* __restrict__ bias,
    float* __restrict__ y, int N, int C_in, int C_out, int L_in, int L_out)
{
    int total = N * C_out * L_out;
    for (int i = blockIdx.x*blockDim.x+threadIdx.x; i < total; i += blockDim.x*gridDim.x) {
        int lout = i % L_out;
        int tmp = i / L_out;
        int co = tmp % C_out;
        int n = tmp / C_out;
        float acc = bias[co];
        if (lout % 2 == 0) {
            int lin = lout / 2;
            if (lin < L_in) {
                // k = 1
                for (int ci = 0; ci < C_in; ++ci) {
                    acc += x[(n*C_in+ci)*L_in + lin] * weight[(ci*C_out+co)*3 + 1];
                }
            }
        } else {
            // lout odd: k=0, lin=(lout+1)/2, and k=2, lin=(lout-1)/2
            int lin0 = (lout + 1) / 2;
            if (lin0 < L_in) {
                for (int ci = 0; ci < C_in; ++ci) {
                    acc += x[(n*C_in+ci)*L_in + lin0] * weight[(ci*C_out+co)*3 + 0];
                }
            }
            int lin2 = (lout - 1) / 2;
            if (lin2 >= 0 && lin2 < L_in) {
                for (int ci = 0; ci < C_in; ++ci) {
                    acc += x[(n*C_in+ci)*L_in + lin2] * weight[(ci*C_out+co)*3 + 2];
                }
            }
        }
        y[i] = acc;
    }
}

