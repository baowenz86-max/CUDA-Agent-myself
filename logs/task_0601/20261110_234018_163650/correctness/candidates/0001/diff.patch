+// -----------------------------------------------------------------------------
+// custom_cat: concatenates two tensors along a given dimension
+// -----------------------------------------------------------------------------
+torch::Tensor custom_cat_forward(torch::Tensor x1, torch::Tensor x2, int64_t dim) {
+    TORCH_CHECK(x1.is_cuda(), "custom_cat: x1 must be a CUDA tensor");
+    TORCH_CHECK(x2.is_cuda(), "custom_cat: x2 must be a CUDA tensor");
+    TORCH_CHECK(x1.dtype() == torch::kFloat32, "custom_cat: x1 must be float32");
+    TORCH_CHECK(x2.dtype() == torch::kFloat32, "custom_cat: x2 must be float32");
+    TORCH_CHECK(x1.dim() == x2.dim(), "custom_cat: input tensors must have same number of dimensions");
+
+    int64_t ndim = x1.dim();
+    TORCH_CHECK(dim >= -ndim && dim < ndim, "custom_cat: dim out of range");
+    if (dim < 0) dim += ndim;
+
+    for (int64_t i = 0; i < ndim; ++i) {
+        if (i != dim) {
+            TORCH_CHECK(x1.size(i) == x2.size(i), "custom_cat: sizes must match along non-concatenated dimensions");
+        }
+    }
+
+    // Ensure contiguous inputs for efficient pointer-based copy
+    auto x1_contig = x1.contiguous();
+    auto x2_contig = x2.contiguous();
+
+    // Compute sizes for launcher
+    int64_t inner_size = 1;
+    for (int64_t i = dim + 1; i < ndim; ++i) {
+        inner_size *= x1_contig.size(i);
+    }
+    int64_t outer_size = 1;
+    for (int64_t i = 0; i < dim; ++i) {
+        outer_size *= x1_contig.size(i);
+    }
+    int64_t x1_size = x1_contig.size(dim);
+    int64_t x2_size = x2_contig.size(dim);
+    int64_t dim_size = x1_size + x2_size;
+
+    // Allocate output tensor (contiguous)
+    std::vector<int64_t> out_shape = x1_contig.sizes().vec();
+    out_shape[dim] = dim_size;
+    auto out = torch::empty(out_shape, x1_contig.options());
+
+    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
+
+    custom_cat_launcher(
+        x1_contig.data_ptr<float>(),
+        x2_contig.data_ptr<float>(),
+        out.data_ptr<float>(),
+        x1_size,
+        x2_size,
+        dim_size,
+        inner_size,
+        outer_size,
+        stream);
+
+    cudaError_t err = cudaGetLastError();
+    TORCH_CHECK(err == cudaSuccess, "custom_cat launcher failed: ", cudaGetErrorString(err));
+
+    return out;
+}
+
