ninja_required_version = 1.3
cxx = g++-13
nvcc = /usr/local/cuda/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=cuda_extension -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1011\" -isystem /home/stella/learn/URP/CUDA-Agent/agent_workdir/.venv/lib/python3.12/site-packages/torch/include -isystem /home/stella/learn/URP/CUDA-Agent/agent_workdir/.venv/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /home/stella/learn/URP/CUDA-Agent/agent_workdir/.venv/lib/python3.12/site-packages/torch/include/TH -isystem /home/stella/learn/URP/CUDA-Agent/agent_workdir/.venv/lib/python3.12/site-packages/torch/include/THC -isystem /usr/local/cuda/include -isystem /home/stella/.local/share/uv/python/cpython-3.12.13-linux-x86_64-gnu/include/python3.12 -D_GLIBCXX_USE_CXX11_ABI=0 -fPIC -std=c++17 -O3 -std=c++17
post_cflags = 
cuda_cflags = -ccbin gcc-13 -DTORCH_EXTENSION_NAME=cuda_extension -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1011\" -isystem /home/stella/learn/URP/CUDA-Agent/agent_workdir/.venv/lib/python3.12/site-packages/torch/include -isystem /home/stella/learn/URP/CUDA-Agent/agent_workdir/.venv/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /home/stella/learn/URP/CUDA-Agent/agent_workdir/.venv/lib/python3.12/site-packages/torch/include/TH -isystem /home/stella/learn/URP/CUDA-Agent/agent_workdir/.venv/lib/python3.12/site-packages/torch/include/THC -isystem /usr/local/cuda/include -isystem /home/stella/.local/share/uv/python/cpython-3.12.13-linux-x86_64-gnu/include/python3.12 -D_GLIBCXX_USE_CXX11_ABI=0 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_89,code=compute_89 -gencode=arch=compute_89,code=sm_89 --compiler-options '-fPIC' -O3 --use_fast_math -std=c++17
cuda_post_cflags = 
cuda_dlink_post_cflags = 
ldflags = -shared -L/home/stella/learn/URP/CUDA-Agent/agent_workdir/.venv/lib/python3.12/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/usr/local/cuda/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags



rule link
  command = $cxx $in $ldflags -o $out

build binding.o: compile /home/stella/learn/URP/CUDA-Agent/agent_workdir/binding.cpp
build ceil_transpose_group_norm.cuda.o: cuda_compile /home/stella/learn/URP/CUDA-Agent/agent_workdir/kernels/ceil_transpose_group_norm.cu
build ceil_transpose_group_norm_binding.o: compile /home/stella/learn/URP/CUDA-Agent/agent_workdir/kernels/ceil_transpose_group_norm_binding.cpp



build cuda_extension.so: link binding.o ceil_transpose_group_norm.cuda.o ceil_transpose_group_norm_binding.o

default cuda_extension.so
