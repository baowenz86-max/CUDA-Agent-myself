ninja_required_version = 1.3
cxx = /usr/bin/g++
nvcc = /public/app/cuda/12.6/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=cuda_extension -DTORCH_API_INCLUDE_EXTENSION_H -isystem /home/scc/pb24111609/projects/CUDA-Agent/.venv/lib/python3.12/site-packages/torch/include -isystem /home/scc/pb24111609/projects/CUDA-Agent/.venv/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /public/app/cuda/12.6/include -isystem /home/scc/pb24111609/.local/share/uv/python/cpython-3.12.13-linux-x86_64-gnu/include/python3.12 -fPIC -std=c++20 -O3 -std=c++20
post_cflags = 
cuda_cflags = -ccbin /usr/bin/gcc -DTORCH_EXTENSION_NAME=cuda_extension -DTORCH_API_INCLUDE_EXTENSION_H -isystem /home/scc/pb24111609/projects/CUDA-Agent/.venv/lib/python3.12/site-packages/torch/include -isystem /home/scc/pb24111609/projects/CUDA-Agent/.venv/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /public/app/cuda/12.6/include -isystem /home/scc/pb24111609/.local/share/uv/python/cpython-3.12.13-linux-x86_64-gnu/include/python3.12 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_80,code=compute_80 -gencode=arch=compute_80,code=sm_80 --compiler-options '-fPIC' -O3 --use_fast_math -ccbin=/usr/bin/g++ -std=c++20
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/home/scc/pb24111609/projects/CUDA-Agent/.venv/lib/python3.12/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/public/app/cuda/12.6/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc -MD -MF $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build binding.o: compile /home/scc/pb24111609/projects/CUDA-Agent/agent_workdir/binding.cpp
build custom_ops.cuda.o: cuda_compile /home/scc/pb24111609/projects/CUDA-Agent/agent_workdir/kernels/custom_ops.cu
build custom_ops_binding.o: compile /home/scc/pb24111609/projects/CUDA-Agent/agent_workdir/kernels/custom_ops_binding.cpp





build cuda_extension.so: link binding.o custom_ops.cuda.o custom_ops_binding.o

default cuda_extension.so
