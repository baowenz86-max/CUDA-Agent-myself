# School-provided OpenAI-compatible API
CUDA_AGENT_API_KEY=replace-with-your-key
CUDA_AGENT_BASE_URL=https://school-api.example.edu/v1
CUDA_AGENT_MODEL=replace-with-model-name
CUDA_AGENT_API_TIMEOUT=300
CUDA_AGENT_MAX_TOKENS=32768
# DeepSeek code-generation requests: disabled avoids reasoning tokens exhausting
# the completion budget before the final JSON/files are returned.
CUDA_AGENT_THINKING_MODE=disabled

# Optional toolchain overrides
CUDA_HOME=/public/app/cuda/12.6
CC=/usr/bin/gcc-13
CXX=/usr/bin/g++-13
CUDA_ARCH=sm_89
