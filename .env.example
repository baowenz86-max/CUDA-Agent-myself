# DeepSeek OpenAI-compatible API
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
CUDA_AGENT_MODEL=deepseek-v4-pro
CUDA_AGENT_API_TIMEOUT=300
CUDA_AGENT_MAX_TOKENS=32768
CUDA_AGENT_THINKING_MODE=enabled
CUDA_AGENT_REASONING_EFFORT=low

# Optional toolchain overrides
CUDA_HOME=/public/app/cuda/12.6
CC=/usr/bin/gcc-13
CXX=/usr/bin/g++-13
CUDA_ARCH=sm_89
