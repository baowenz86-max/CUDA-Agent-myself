# OpenAI API
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
CUDA_AGENT_MODEL=gpt-5.6
CUDA_AGENT_API_TIMEOUT=300
CUDA_AGENT_MAX_TOKENS=32768
CUDA_AGENT_REASONING_EFFORT=medium

# Optional toolchain overrides
CUDA_HOME=/public/app/cuda/12.6
CC=/usr/bin/gcc-13
CXX=/usr/bin/g++-13
CUDA_ARCH=sm_89
